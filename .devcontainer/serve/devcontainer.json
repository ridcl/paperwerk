{
	"name": "Serving (vLLM / PyTorch)",
	"build": {
		"context": "../..",
		"dockerfile": "../../Dockerfile.serve",
		"target": "build-dev"
	},

	"mounts": [
		"source=${localEnv:HOME}/.cache/,target=/home/devpod/.cache/,type=bind,consistency=cached",
		"source=${localEnv:HOME}/data/,target=/data/,type=bind,consistency=cached"
	],

	"containerEnv": {
		"PYTHONPATH": "src",
		"HF_TOKEN": "${localEnv:HF_TOKEN_PERSONAL}",
		"VLLM_PLATFORM": "cuda"
	},

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-python.black-formatter"
			],
			"settings": {
				"editor.formatOnSave": true,
				"[python]": {
					"editor.defaultFormatter": "ms-python.black-formatter"
				},
				"python.defaultInterpreterPath": "/venv/bin/python"
			}
		}
	},

	"postCreateCommand": "bash .devcontainer/init.sh",

	"runArgs": ["--gpus", "all", "--shm-size", "16g"]
}
