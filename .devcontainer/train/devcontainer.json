{
	"name": "Training (JAX)",
	"build": {
		"context": "../..",
		"dockerfile": "../../Dockerfile.train",
		"target": "build-dev"
	},
	"mounts": [
		"source=${localEnv:HOME}/.cache/,target=/home/devpod/.cache/,type=bind,consistency=cached",
		"source=${localEnv:HOME}/data/,target=/data/,type=bind,consistency=cached"
	],
	"containerEnv": {
		"PYTHONPATH": "src:lib/tunix",
		"HF_TOKEN": "${localEnv:HF_TOKEN_PERSONAL}",
		"ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY_WK}",
		// JAX-specific: compilation cache and memory/allocator tuning
		"JAX_COMPILATION_CACHE_DIR": "/tmp/jax_cache",
		"XLA_PYTHON_CLIENT_MEM_FRACTION": ".99",
		"TF_GPU_ALLOCATOR": "cuda_malloc_async",
		"XLA_FLAGS": "--xla_gpu_enable_command_buffer="
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-python.black-formatter"
			],
			"settings": {
				"editor.formatOnSave": true,
				"[python]": {
					"editor.defaultFormatter": "ms-python.black-formatter"
				},
				"python.defaultInterpreterPath": "/venv/bin/python"
			}
		}
	},
	"postCreateCommand": "bash .devcontainer/init.sh",
	"runArgs": [
		"--gpus",
		"all",
		"--shm-size",
		"2g"
	]
}