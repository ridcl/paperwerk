<!DOCTYPE html>
<html>
<head>
<title>Policy Manual</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 {
    font-weight: bold;
    margin-top: 0;
  }
  .header-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  .header-table td {
    padding: 5px 0;
  }
  .logo-container {
    float: left;
    width: 150px;
    margin-right: 40px;
  }
  .logo-text {
    font-size: 14pt;
    font-weight: bold;
  }
  .title-block {
    margin-left: 200px;
  }
  .section-heading {
    font-size: 14pt;
    font-weight: bold;
    text-transform: uppercase;
    margin-bottom: 15px;
  }
  .subsection-heading {
    font-size: 12pt;
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
  }
  .content-paragraph {
    text-align: justify;
    line-height: 1.5;
    margin-bottom: 15px;
  }
  .list-item {
    margin-bottom: 10px;
  }
</style>
</head>
<body>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div class="logo-container">
      <div style="font-size: 30pt; font-weight: bold;">[Logo Placeholder]</div>
      <div class="logo-text">SOUTHEAST MISSOURI STATE UNIVERSITY · 1873®</div>
    </div>
    <div class="title-block">
      <h1 style="font-size: 24pt; margin-bottom: 10px;">BUSINESS POLICY AND PROCEDURE MANUAL</h1>
      <table class="header-table">
        <tr>
          <td style="width: 25%;">Date Issued: <span data-field="date_issued">{{ date_issued }}</span></td>
          <td style="width: 25%;">Revision Date: <span data-field="revision_date">{{ revision_date }}</span></td>
          <td style="width: 25%;">Page: <span data-field="page_number">{{ page_number }}</span></td>
          <td style="width: 25%;">Classification Code: <span data-field="classification_code">{{ classification_code }}</span></td>
        </tr>
        <tr>
          <td>Section: <span data-field="section_name">{{ section_name }}</span></td>
          <td>Subject: <span data-field="subject">{{ subject }}</span></td>
        </tr>
      </table>
    </div>
  </div>

  <h2 style="font-size: 16pt; margin-top: 30px; margin-bottom: 15px;">GENERAL STATEMENT OF POLICY</h2>

  <div class="content-paragraph">
    <span data-field="policy_statement_1">{{ policy_statement_1 }}</span>
  </div>

  <div class="content-paragraph">
    <span data-field="policy_statement_2">{{ policy_statement_2 }}</span>
  </div>

  <div class="content-paragraph">
    <span data-field="policy_statement_3">{{ policy_statement_3 }}</span>
  </div>

  <div class="content-paragraph">
    <span data-field="policy_statement_4">{{ policy_statement_4 }}</span>
  </div>

  <div class="content-paragraph">
    <span data-field="policy_statement_5">{{ policy_statement_5 }}</span>
  </div>
</div>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div class="logo-container">
      <div style="font-size: 30pt; font-weight: bold;">[Logo Placeholder]</div>
      <div class="logo-text">SOUTHEAST MISSOURI STATE UNIVERSITY · 1873®</div>
    </div>
    <div class="title-block">
      <h1 style="font-size: 24pt; margin-bottom: 10px;">BUSINESS POLICY AND PROCEDURE MANUAL</h1>
      <table class="header-table">
        <tr>
          <td style="width: 25%;">Date Issued: <span data-field="date_issued">{{ date_issued }}</span></td>
          <td style="width: 25%;">Revision Date: <span data-field="revision_date">{{ revision_date }}</span></td>
          <td style="width: 25%;">Page: <span data-field="page_number">{{ page_number }}</span></td>
          <td style="width: 25%;">Classification Code: <span data-field="classification_code">{{ classification_code }}</span></td>
        </tr>
        <tr>
          <td>Section: <span data-field="section_name">{{ section_name }}</span></td>
          <td>Subject: <span data-field="subject">{{ subject }}</span></td>
        </tr>
      </table>
    </div>
  </div>

  <h2 class="section-heading">1. Discrimination or Discriminatory Harassment</h2>

  <div class="content-paragraph">
    <span data-field="discrimination_definition">{{ discrimination_definition }}</span>
  </div>

  <h3 class="subsection-heading">A. Equal Employment Opportunities</h3>
  <div class="content-paragraph">
    <span data-field="eoo_statement">{{ eoo_statement }}</span>
  </div>

  <h3 class="subsection-heading">B. Access to Educational Opportunities</h3>
  <div class="content-paragraph">
    <span data-field="education_access_statement">{{ education_access_statement }}</span>
  </div>

  <h2 class="section-heading">2. Harassment</h2>

  <div class="content-paragraph">
    <span data-field="harassment_definition">{{ harassment_definition }}</span>
  </div>

  <h2 class="section-heading">3. Sexual Harassment</h2>

  <div class="content-paragraph">
    <span data-field="sexual_harassment_definition">{{ sexual_harassment_definition }}</span>
  </div>

  <div class="content-paragraph">
    <span data-field="sexual_harassment_scope">{{ sexual_harassment_scope }}</span>
  </div>
</div>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div class="logo-container">
      <div style="font-size: 30pt; font-weight: bold;">[Logo Placeholder]</div>
      <div class="logo-text">SOUTHEAST MISSOURI STATE UNIVERSITY · 1873®</div>
    </div>
    <div class="title-block">
      <h1 style="font-size: 24pt; margin-bottom: 10px;">BUSINESS POLICY AND PROCEDURE MANUAL</h1>
      <table class="header-table">
        <tr>
          <td style="width: 25%;">Date Issued: <span data-field="date_issued">{{ date_issued }}</span></td>
          <td style="width: 25%;">Revision Date: <span data-field="revision_date">{{ revision_date }}</span></td>
          <td style="width: 25%;">Page: <span data-field="page_number">{{ page_number }}</span></td>
          <td style="width: 25%;">Classification Code: <span data-field="classification_code">{{ classification_code }}</span></td>
        </tr>
        <tr>
          <td>Section: <span data-field="section_name">{{ section_name }}</span></td>
          <td>Subject: <span data-field="subject">{{ subject }}</span></td>
        </tr>
      </table>
    </div>
  </div>

  <div class="content-paragraph" style="margin-top: 20px;">
    <span data-field="title_ix_definition">{{ title_ix_definition }}</span>
  </div>

  <div class="content-paragraph">
    <span data-field="policy_intent">{{ policy_intent }}</span>
  </div>

  <div class="content-paragraph">
    <span data-field="student_information">{{ student_information }}</span>
  </div>

  <div class="content-paragraph">
    <span data-field="complaint_process_summary">{{ complaint_process_summary }}</span>
  </div>

  <div class="content-paragraph">
    <span data-field="university_channels">{{ university_channels }}</span>
  </div>

  <h2 class="section-heading">4. Filing A Complaint</h2>

  <div class="subsection-heading">For complaints against faculty, staff or third-party affiliates:</div>
  <div class="list-item">
    <strong>Dean Trae Mitten</strong><br>
    Dean of Students and Interim Title IX Coordinator<br>
    <span data-field="address_line_1">{{ address_line_1 }}</span><br>
    <span data-field="address_line_2">{{ address_line_2 }}</span><br>
    Office: <span data-field="office_phone">{{ office_phone }}</span><br>
    Email: <span data-field="email_address">{{ email_address }}</span>
  </div>

  <div class="list-item">
    <strong>Will Atkins</strong><br>
    Training Manager and Interim Title IX Investigator<br>
    <span data-field="address_line_1">{{ address_line_1 }}</span><br>
    <span data-field="address_line_2">{{ address_line_2 }}</span><br>
    Office: <span data-field="office_phone">{{ office_phone }}</span><br>
    Email: <span data-field="email_address">{{ email_address }}</span>
  </div>
</div>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div class="logo-container">
      <div style="font-size: 30pt; font-weight: bold;">[Logo Placeholder]</div>
      <div class="logo-text">SOUTHEAST MISSOURI STATE UNIVERSITY · 1873®</div>
    </div>
    <div class="title-block">
      <h1 style="font-size: 24pt; margin-bottom: 10px;">BUSINESS POLICY AND PROCEDURE MANUAL</h1>
      <table class="header-table">
        <tr>
          <td style="width: 25%;">Date Issued: <span data-field="date_issued">{{ date_issued }}</span></td>
          <td style="width: 25%;">Revision Date: <span data-field="revision_date">{{ revision_date }}</span></td>
          <td style="width: 25%;">Page: <span data-field="page_number">{{ page_number }}</span></td>
          <td style="width: 25%;">Classification Code: <span data-field="classification_code">{{ classification_code }}</span></td>
        </tr>
        <tr>
          <td>Section: <span data-field="section_name">{{ section_name }}</span></td>
          <td>Subject: <span data-field="subject">{{ subject }}</span></td>
        </tr>
      </table>
    </div>
  </div>

  <div class="content-paragraph" style="margin-top: 30px;">
    <span data-field="external_resource_info">{{ external_resource_info }}</span>
  </div>

  <div class="list-item" style="margin-top: 20px;">
    <strong>Office for Civil Rights</strong><br>
    U.S. Department of Education<br>
    <span data-field="address_line_1">{{ address_line_1 }}</span><br>
    <span data-field="address_line_2">{{ address_line_2 }}</span><br>
    Telephone: <span data-field="phone_number">{{ phone_number }}</span><br>
    FAX: <span data-field="fax_number">{{ fax_number }}</span><br>
    TDD: <span data-field="tdd_number">{{ tdd_number }}</span><br>
    Email: <span data-field="email_address">{{ email_address }}</span>
  </div>
</div>

</body>
</html>