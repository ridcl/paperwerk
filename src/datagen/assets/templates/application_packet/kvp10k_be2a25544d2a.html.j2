  <div style="margin-bottom: 30px;">
    Home Phone: (<span data-field="home_phone_area_code">{{ home_phone_area_code }}</span>) <span data-field="home_phone_prefix">{{ home_phone_prefix }}</span>-<span data-field="home_phone_line">{{ home_phone_line }}</span>
