        <th style="width: 20%;">$/</th>
        <th style="width: 20%;">Spouse/Partner or Parent</th>
        <th style="width: 20%;">$/</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Public Assistance/TANF</td>
        <td>$<span data-field="income_public_assistance">{{ income_public_assistance }}</span></td>
        <td>Social Security Income</td>
        <td>$<span data-field="income_ssi">{{ income_ssi }}</span></td>
      </tr>
      <tr>
        <td>Unemployment Insurance</td>
        <td>$<span data-field="income_unemployment">{{ income_unemployment }}</span></td>
