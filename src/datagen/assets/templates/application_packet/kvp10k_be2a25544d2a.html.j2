      <p style="font-size: 10pt; margin: 0;">UPWARD BOUND</p>
    </div>
    <div style="text-align: right;">
      <img src="" alt="Logo" style="width: 150px; height: auto;">
      <p style="font-size: 12pt; font-weight: bold; margin: 0;">UPWARD BOUND</p>
      <p style="font-size: 10pt; margin: 0;">COLORADO STATE UNIVERSITY</p>
    </div>
  </div>

  <h2 style="font-size: 16pt; margin-top: 30px; margin-bottom: 10px;">APPLICATION PACKET</h2>
  <p style="font-size: 10pt; margin-bottom: 20px;">Sponsored by <span data-field="sponsoring_entity">{{ sponsoring_entity }}</span></p>
  <p style="font-size: 10pt; margin-bottom: 30px;">With major funding provided by U.S. Department of Education</p>

  <div class="section-title">STUDENT INFORMATION</div>

  <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
    <div style="width: 45%;">
      Date: <span data-field="date_of_application">{{ date_of_application }}</span>
    </div>
    <div style="width: 45%;">
      School ID #: <span data-field="school_id">{{ school_id }}</span>
    </div>
  </div>

  <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
    <div style="width: 30%;">Name:</div>
    <div style="width: 20%; text-align: center;">First: <span data-field="full_name_first">{{ full_name_first }}</span></div>
    <div style="width: 20%; text-align: center;">Middle: <span data-field="full_name_middle">{{ full_name_middle }}</span></div>
    <div style="width: 30%; text-align: right;">Last: <span data-field="full_name_last">{{ full_name_last }}</span></div>
  </div>

  <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
    <div style="width: 30%;">High School: <span data-field="high_school_name">{{ high_school_name }}</span></div>
    <div style="width: 20%; text-align: center;">Current Grade: <span data-field="current_grade">{{ current_grade }}</span></div>
    <div style="width: 20%; text-align: center;">9</div>
    <div style="width: 20%; text-align: center;">10</div>
    <div style="width: 20%; text-align: center;">11</div>
    <div style="width: 30%;">Graduation Year: <span data-field="graduation_year">{{ graduation_year }}</span></div>
  </div>

  <div style="margin-bottom: 30px;">
    Address: <span data-field="street_address">{{ street_address }}</span>, <span data-field="city">{{ city }}</span>, <span data-field="state">{{ state }}</span> <span data-field="zip_code">{{ zip_code }}</span>
