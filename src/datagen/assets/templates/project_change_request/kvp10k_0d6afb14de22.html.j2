<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1, h2 { font-weight: bold; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 20px; }
  .form-group { width: 48%; }
  .full-width-field { width: 100%; height: 150px; border-bottom: 1px solid #ccc; margin-top: 10px; }
  .signature-line { border-bottom: 1px solid #000; margin-top: 50px; width: 50%; }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px;">
    <div>
      <h1 style="font-size: 24pt; margin: 0;">O</h1>
      <h2 style="font-size: 14pt; margin-top: 5px;">BIOMECHANICS RESEARCH BUILDING</h2>
      <h2 style="font-size: 14pt; margin-top: 2px;">MACHINING & PROTOTYPING CORE</h2>
    </div>
    <div style="text-align: right;">
      <h3 style="font-size: 12pt; margin: 0;">UNO Biomechanics Research Building</h3>
      <p style="margin: 2px 0;">{{ employer.address_line_1 }}</p>
      <p style="margin: 2px 0;">{{ employer.city_state_zip }}</p>
    </div>
  </div>

  <p style="font-size: 10pt; margin-bottom: 20px;">
    This form represents a request to modify the existing parameters of a project but is not financially or contractually binding.
    Please complete all indicated fields and send a copy to <span data-field="contact_email">{{ contact_email }}</span> with any and all supporting documentation, research, drawings, pictures, and models that could assist in accurately modifying existing plans. The
    Biomechanics Machining & Prototyping Core will provide an assessment and e-mail response within 3-5 business days.
  </p>

  <h2 style="font-size: 16pt; margin-top: 30px; margin-bottom: 20px;">Project Change</h2>

  <div class="form-row">
    <div class="form-group">
      <label style="display: block; margin-bottom: 5px;">Name</label>
      <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
        <span data-field="full_name">{{ full_name }}</span>
      </div>
    </div>
    <div class="form-group">
      <label style="display: block; margin-bottom: 5px;">Date</label>
      <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
        <span data-field="request_date">{{ request_date }}</span>
      </div>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label style="display: block; margin-bottom: 5px;">Street Address</label>
      <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
        <span data-field="address.street">{{ address.street }}</span>
      </div>
    </div>
    <div class="form-group">
      <label style="display: block; margin-bottom: 5px;">Company/Institution</label>
      <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
        <span data-field="employer.name">{{ employer.name }}</span>
      </div>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label style="display: block; margin-bottom: 5px;">Email Address</label>
      <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
        <span data-field="contact_email">{{ contact_email }}</span>
      </div>
    </div>
    <div class="form-group">
      <label style="display: block; margin-bottom: 5px;">Primary Phone Number</label>
      <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
        <span data-field="contact_phone">{{ contact_phone }}</span>
      </div>
    </div>
  </div>

  <div style="margin-top: 30px;">
    <label style="display: block; margin-bottom: 5px;">Type of Changes Requested:</label>
    <p style="border-bottom: 1px solid #000; padding-bottom: 5px;">
      Please describe the nature of your project changes below in detail.
    </p>
    <div class="full-width-field">
      <!-- Placeholder for detailed description -->
    </div>
  </div>

  <div style="margin-top: 60px;">
    <h3 style="font-size: 12pt; margin-bottom: 15px;">For Administrative Use Only:</h3>

    <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
      <div style="width: 45%;">
        <label style="display: block; margin-bottom: 5px;">Action Taken</label>
        <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
          <span data-field="admin_action_taken_1">{{ admin_action_taken_1 }}</span>
        </div>
      </div>
      <div style="width: 45%;">
        <label style="display: block; margin-bottom: 5px;">Date</label>
        <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
          <span data-field="admin_date_1">{{ admin_date_1 }}</span>
        </div>
      </div>
    </div>

    <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
      <div style="width: 45%;">
        <label style="display: block; margin-bottom: 5px;">Action Taken</label>
        <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
          <span data-field="admin_action_taken_2">{{ admin_action_taken_2 }}</span>
        </div>
      </div>
      <div style="width: 45%;">
        <label style="display: block; margin-bottom: 5px;">Date</label>
        <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
          <span data-field="admin_date_2">{{ admin_date_2 }}</span>
        </div>
      </div>
    </div>

    <div style="display: flex; justify-content: space-between; margin-bottom: 30px;">
      <div style="width: 45%;">
        <label style="display: block; margin-bottom: 5px;">Action Taken</label>
        <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
          <span data-field="admin_action_taken_3">{{ admin_action_taken_3 }}</span>
        </div>
      </div>
      <div style="width: 45%;">
        <label style="display: block; margin-bottom: 5px;">Date</label>
        <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
          <span data-field="admin_date_3">{{ admin_date_3 }}</span>
        </div>
      </div>
    </div>

    <div style="margin-top: 80px;">
      <div style="display: flex; justify-content: space-between;">
        <div style="width: 50%;">
          <label style="display: block; margin-bottom: 5px;">Machining & Prototyping Core Director Signature</label>
          <div class="signature-line" data-field="machining_prototyping_core_director_sign">{{ machining_prototyping_core_director_sign }}</div>
        </div>
        <div style="width: 50%;">
          <label style="display: block; margin-bottom: 5px;">Date</label>
          <div class="signature-line" data-field="date">{{ date }}</div>
        </div>
      </div>
    </div>
  </div>

  <div style="text-align: center; margin-top: 50px;">
    <h2 style="font-size: 14pt;">Project Change Request</h2>
  </div>
</div>