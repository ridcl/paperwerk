<!DOCTYPE html>
<html>
<head>
<title>Catering Order Form</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; /* System font stack */
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; } /* System font stack for headings */
  table { width: 100%; border-collapse: collapse; margin-top: 10px; margin-bottom: 10px; }
  th, td { border: 1px solid #ccc; padding: 8px; text-align: left; }
  .header-section { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px; }
  .logo-area { display: flex; align-items: center; }
  .logo-img { height: 60px; margin-right: 20px; }
  .title-area { flex-grow: 1; }
  .title-area h1 { font-size: 36pt; margin: 0; }
  .title-area h2 { font-size: 18pt; margin: 2px 0 0 0; font-weight: normal; }
  .info-block { display: flex; justify-content: space-between; margin-bottom: 20px; font-size: 11pt; }
  .info-block div { width: 48%; }
  .form-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-bottom: 30px; font-size: 11pt; }
  .form-item label { display: block; margin-bottom: 5px; font-weight: bold; }
  .form-item span { border-bottom: 1px solid #000; padding-bottom: 2px; }
  .section-title { font-size: 14pt; font-weight: bold; margin-top: 25px; margin-bottom: 15px; border-bottom: 2px solid #000; padding-bottom: 5px; }
  .note { font-size: 10pt; margin-top: 15px; padding: 10px; border: 1px dashed #000; }
</style>
</head>
<body>

<div class="page">
  <div class="header-section">
    <div class="logo-area">
