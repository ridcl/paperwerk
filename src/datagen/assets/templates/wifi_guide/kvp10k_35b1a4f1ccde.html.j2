  .step-instruction { margin-bottom: 20px; line-height: 1.5; }
  .step-number { font-weight: bold; margin-right: 10px; }
  .screenshot-container { text-align: center; margin: 20px 0; }
  .screenshot-img { max-width: 100%; height: auto; border: 1px solid #ccc; }
