<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  .form-row { display: flex; margin-bottom: 15px; }
  .form-row > div { flex: 1; }
  .full-width { width: 100%; margin-bottom: 15px; }
  .label-col { width: 20%; }
  .input-col { width: 80%; }
  .section-title { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
  .divider { border-top: 1px solid #000; margin-top: 10px; margin-bottom: 10px; }
  table { width: 100%; border-collapse: collapse; margin-top: 10px; }
  td { padding: 8px 0; border-bottom: 1px solid #000; }
  .signature-line { border-bottom: 1px solid #000; width: 300px; margin-top: 50px; }
</style>

<div class="page">
  <div style="text-align: center;">
    <h1 style="font-size: 18pt; margin-bottom: 5px;">Application for Employment</h1>
    <h2 style="font-size: 14pt; margin-top: 0;">@ The Centers</h2>
  </div>

  <div class="divider"></div>

  <div class="form-row">
    <div class="label-col">Name:</div>
    <div class="input-col">
      <span data-field="full_name_last">{{ full_name_last }}</span>
      <span data-field="full_name_first">{{ full_name_first }}</span>
      <span data-field="full_name_middle">{{ full_name_middle }}</span>
    </div>
  </div>

  <div class="form-row">
    <div class="label-col">Campus Address:</div>
    <div class="input-col">
      <span data-field="campus_address">{{ campus_address }}</span>
    </div>
  </div>

  <div class="form-row">
    <div class="label-col">Star ID:</div>
    <div class="input-col">
      <span data-field="star_id">{{ star_id }}</span>
    </div>
  </div>

  <div class="form-row">
    <div class="label-col">Permanent Address:</div>
    <div class="input-col">
      <span data-field="permanent_address">{{ permanent_address }}</span>
    </div>
  </div>

  <div class="form-row">
    <div class="label-col">Mustang ID:</div>
    <div class="input-col">
      <span data-field="mustang_id">{{ mustang_id }}</span>
    </div>
  </div>

  <div class="form-row">
    <div class="label-col">Phone Number:</div>
    <div class="input-col">
      <span data-field="phone_number">{{ phone_number }}</span>
    </div>
  </div>

  <div class="form-row">
    <div class="label-col">E-mail Address:</div>
    <div class="input-col">
      <span data-field="email_address">{{ email_address }}</span>
    </div>
  </div>

  <div class="section-title">ACADEMICS</div>

  <div class="form-row">
    <div class="label-col">Major:</div>
    <div class="input-col">
      <span data-field="major">{{ major }}</span>
    </div>
  </div>

  <div class="form-row">
    <div class="label-col">Minor:</div>
    <div class="input-col">
      <span data-field="minor">{{ minor }}</span>
    </div>
  </div>

  <div class="form-row">
    <div class="label-col">Current Classification:</div>
    <div class="input-col" style="display: flex; gap: 20px;">
      <label><input type="radio" name="classification" value="freshman"> Freshman</label>
      <label><input type="radio" name="classification" value="sophomore"> Sophomore</label>
      <label><input type="radio" name="classification" value="junior"> Junior</label>
      <label><input type="radio" name="classification" value="senior"> Senior</label>
    </div>
  </div>

  <div class="form-row">
    <div class="label-col">Anticipated Graduation Date:</div>
    <div class="input-col">
      <span data-field="anticipated_graduation_date">{{ anticipated_graduation_date }}</span>
    </div>
  </div>

  <div class="form-row">
    <div class="label-col">Cumulative GPA:</div>
    <div class="input-col">
      <span data-field="cumulative_gpa">{{ cumulative_gpa }}</span>
    </div>
  </div>

  <div class="full-width" style="margin-top: 20px;">
    Do you have any work experience that relates to the positions you are applying for? If so, please describe:
    <div style="border: 1px solid #000; height: 100px; margin-top: 5px; padding: 5px;">
      <span data-field="work_experience_description">{{ work_experience_description }}</span>
    </div>
  </div>

  <div class="full-width" style="margin-top: 30px;">
    Will you have any commitments that might take you away from campus and your responsibilities as a staff member during the Fall or Spring semesters (i.e. student teaching, course projects, or internship)?
    <div style="border: 1px solid #000; height: 50px; margin-top: 5px; padding: 5px;">
      <span data-field="commitment_description">{{ commitment_description }}</span>
    </div>
  </div>
</div>

<div class="page">
  <div class="section-title">PREVIOUS WORK EXPERIENCE</div>
  <table>
    <thead>
      <tr>
        <td style="width: 33%;">Employer</td>
        <td style="width: 33%;">Type of Work/ Position</td>
        <td style="width: 33%;">Dates of Employment</td>
      </tr>
    </thead>
    <tbody>
      {% for job in previous_work_experience %}
      <tr>
        <td><span data-field="previous_work_experience[{{ loop.index0 }}].employer">{{ job.employer }}</span></td>
        <td><span data-field="previous_work_experience[{{ loop.index0 }}].position">{{ job.position }}</span></td>
        <td><span data-field="previous_work_experience[{{ loop.index0 }}].dates">{{ job.dates }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="section-title" style="margin-top: 40px;">EXTRACURRICULAR ACTIVITIES / INTERESTS</div>
  <div class="full-width">
    Please identify any extracurricular activities including any leadership positions you have held:
    <div style="border: 1px solid #000; height: 100px; margin-top: 5px; padding: 5px;">
      <span data-field="extracurricular_activities">{{ extracurricular_activities }}</span>
    </div>
  </div>

  <div class="section-title" style="margin-top: 40px;">REFERENCES</div>
  <p>Please identify three people we may call on for a personal or work reference. It is suggested that at least one recommendation comes from a member of the University community if possible.</p>

  {% for ref in references %}
  <div style="margin-bottom: 20px; border: 1px solid #000; padding: 10px;">
    <div class="form-row">
      <div class="label-col">Name:</div>
      <div class="input-col"><span data-field="references[{{ loop.index0 }}].name">{{ ref.name }}</span></div>
    </div>
    <div class="form-row">
      <div class="label-col">Employer:</div>
      <div class="input-col"><span data-field="references[{{ loop.index0 }}].employer">{{ ref.employer }}</span></div>
    </div>
    <div class="form-row">
      <div class="label-col">Email Address:</div>
      <div class="input-col"><span data-field="references[{{ loop.index0 }}].email">{{ ref.email }}</span></div>
    </div>
    <div class="form-row">
      <div class="label-col">Position:</div>
      <div class="input-col"><span data-field="references[{{ loop.index0 }}].position">{{ ref.position }}</span></div>
    </div>
    <div class="form-row">
      <div class="label-col">Phone:</div>
      <div class="input-col"><span data-field="references[{{ loop.index0 }}].phone">{{ ref.phone }}</span></div>
    </div>
  </div>
  {% endfor %}

  <div class="section-title" style="margin-top: 40px;">BACKGROUND CHECK</div>
  <p>The selection process for this position may include a review of your criminal history and finger printing. A criminal conviction will not necessarily disqualify an applicant from employment. Each case will be independently evaluated to determine the nature of the criminal offense and the applicant's fitness for the position.</p>

  <div class="form-row">
    <div class="label-col">Your Name:</div>
    <div class="input-col">
      <span data-field="bg_full_name_last">{{ bg_full_name_last }}</span>
      <span data-field="bg_full_name_first">{{ bg_full_name_first }}</span>
      <span data-field="bg_full_name_middle">{{ bg_full_name_middle }}</span>
    </div>
  </div>

  <div class="form-row">
    <div class="label-col">Birth date:</div>
    <div class="input-col">
      <span data-field="bg_birth_date">{{ bg_birth_date }}</span>
    </div>
  </div>

  <div class="form-row">
    <div class="label-col">Gender:</div>
    <div class="input-col" style="display: flex; gap: 20px;">
      <label><input type="radio" name="gender" value="male"> Male</label>
      <label><input type="radio" name="gender" value="female"> Female</label>
    </div>
  </div>

  <div class="form-row">
    <div class="label-col">Mustang ID:</div>
    <div class="input-col">
      <span data-field="bg_mustang_id">{{ bg_mustang_id }}</span>
    </div>
  </div>

  <div class="full-width" style="margin-top: 20px;">
    Please list former places of residence for the last 5 years:
    <table>
      <thead>
        <tr>
          <td style="width: 10%;">#</td>
          <td style="width: 60%;">Address</td>
          <td style="width: 30%;">Dates</td>
        </tr>
      </thead>
      <tbody>
        <tr><td>#1</td><td><span data-field="residence_1_address">{{ residence_1_address }}</span></td><td><span data-field="residence_1_dates">{{ residence_1_dates }}</span></td></tr>
        <tr><td>#2</td><td><span data-field="residence_2_address">{{ residence_2_address }}</span></td><td><span data-field="residence_2_dates">{{ residence_2_dates }}</span></td></tr>
        <tr><td>#3</td><td><span data-field="residence_3_address">{{ residence_3_address }}</span></td><td><span data-field="residence_3_dates">{{ residence_3_dates }}</span></td></tr>
        <tr><td>#4</td><td><span data-field="residence_4_address">{{ residence_4_address }}</span></td><td><span data-field="residence_4_dates">{{ residence_4_dates }}</span></td></tr>
        <tr><td>#5</td><td><span data-field="residence_5_address">{{ residence_5_address }}</span></td><td><span data-field="residence_5_dates">{{ residence_5_dates }}</span></td></tr>
      </tbody>
    </table>
  </div>

  <div class="full-width" style="margin-top: 30px;">
    Have you ever been convicted of a crime (other than minor traffic offense) or are there any criminal charges pending against you? If yes - please explain:
    <div style="display: flex; gap: 30px; margin-top: 10px;">
      <label><input type="radio" name="conviction" value="yes"> YES</label>
      <label><input type="radio" name="conviction" value="no"> NO</label>
    </div>
    <div style="border: 1px solid #000; height: 80px; margin-top: 10px; padding: 5px;">
      <span data-field="conviction_explanation">{{ conviction_explanation }}</span>
    </div>
  </div>

  <div class="full-width" style="margin-top: 40px;">
    By signing this application form (below) you are authorizing: (1) The Centers @ SMSU to check your grade point average to verify that you meet the minimum standards, (2) release of any discipline information which may be on file with the University's Judicial Program, and (3) a review of your criminal history.
  </div>

  <div class="form-row" style="margin-top: 50px;">
    <div class="label-col" style="width: 50%;">Signature:</div>
    <div class="input-col" style="width: 50%; text-align: right;">
      <div class="signature-line" data-field="signature">{{ signature }}</div>
    </div>
  </div>

  <div class="full-width" style="margin-top: 50px; text-align: center;">
    This application and schedule can be returned by email to <span data-field="return_email">{{ return_email }}</span> or directly to The Centers Office (Student Center 235).
  </div>
</div>

