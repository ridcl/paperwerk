<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif; }
  h1, h2, h3 { font-weight: bold; margin-top: 0; }
  .section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; }
  .form-row { display: flex; margin-bottom: 10px; }
  .form-row > div { flex: 1; padding-right: 15px; }
  .form-row label { display: block; font-weight: normal; margin-bottom: 3px; font-size: 0.9em; }
  .form-row input[type="text"], .form-row input[type="date"] { width: 100%; border-bottom: 1px solid #ccc; padding: 2px 0; box-sizing: border-box; }
  .signature-line { margin-top: 50px; display: flex; justify-content: space-between; }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px;">
    <div>
      <h1 style="font-size: 24pt; margin: 0;">STOCKTON <span style="font-size: 24pt;">HUMAN</span> UNIVERSITY <span style="font-size: 24pt;">RESOURCES</span></h1>
    </div>
    <div style="text-align: right; font-size: 10pt;">
      <p style="margin: 0;">STOCKTON UNIVERSITY</p>
      <p style="margin: 0;">101 VERA KING FARRIS DRIVE</p>
      <p style="margin: 0;">GALLOWAY, NJ 08205-9441</p>
    </div>
  </div>

  <!-- SECTION 1 -->
  <div style="border: 1px solid #000; padding: 20px; margin-bottom: 30px;">
    <div class="section-header">
      <h2 style="font-size: 14pt; margin: 0;">SECTION 1</h2>
      <h3 style="font-size: 12pt; margin: 0;">Personal Identification and Information</h3>
    </div>
    <div style="margin-top: 15px;">
      <div class="form-row">
        <div style="flex-basis: 30%;">
          <label>To be completed by the Employee</label>
        </div>
        <div style="flex-basis: 70%;">
          <!-- Placeholder for instructions/context if needed -->
        </div>
      </div>

      <div class="form-row" style="margin-top: 15px;">
        <div style="flex-basis: 20%;">
          <label>City</label>
          <input type="text" value="{{ city }}">
        </div>
        <div style="flex-basis: 20%;">
          <label>State</label>
          <input type="text" value="{{ state }}">
        </div>
        <div style="flex-basis: 30%;">
          <label>Zip/Postal Code</label>
          <input type="text" value="{{ zip_code }}">
        </div>
        <div style="flex-basis: 30%;">
          <label>First Name</label>
          <input type="text" value="{{ first_name }}">
        </div>
      </div>

      <div class="form-row" style="margin-top: 15px;">
        <div style="flex-basis: 25%;">
          <label>Last Name</label>
          <input type="text" value="{{ last_name }}">
        </div>
        <div style="flex-basis: 25%;">
          <label>Primary Phone Number</label>
          <input type="text" value="{{ primary_phone_number }}">
        </div>
        <div style="flex-basis: 25%;">
          <label>Retirement Date</label>
          <input type="date" value="{{ retirement_date }}">
        </div>
        <div style="flex-basis: 25%;">
          <label>Last Day Worked</label>
          <input type="date" value="{{ last_day_worked }}">
        </div>
      </div>

      <div class="form-row" style="margin-top: 15px;">
        <div style="flex-basis: 25%;">
          <label>Z-Number</label>
          <input type="text" value="{{ z_number }}">
        </div>
        <div style="flex-basis: 25%;">
          <label>Username</label>
          <input type="text" value="{{ username }}">
        </div>
        <div style="flex-basis: 25%;">
          <label>Previous Division</label>
          <input type="text" value="{{ previous_division }}">
        </div>
        <div style="flex-basis: 25%;">
          <label>Previous Department</label>
          <input type="text" value="{{ previous_department }}">
        </div>
      </div>

      <div class="form-row" style="margin-top: 20px;">
        <div style="flex-basis: 50%; display: flex; align-items: center;">
          <input type="checkbox" style="margin-right: 10px;">
          <label>Retain Previous Photo</label>
        </div>
        <div style="flex-basis: 50%; display: flex; align-items: center;">
          <input type="checkbox" style="margin-right: 10px;">
          <label>Take New Photo</label>
        </div>
      </div>
    </div>
  </div>

  <!-- SECTION 2 -->
  <div style="border: 1px solid #000; padding: 20px; margin-bottom: 30px;">
    <div class="section-header">
      <h2 style="font-size: 14pt; margin: 0;">SECTION 2</h2>
      <h3 style="font-size: 12pt; margin: 0;">Retirees are eligible to opt into the Stockton University Retirees' Association distribution list using a personal email address.</h3>
    </div>
    <div style="margin-top: 15px;">
      <div class="form-row">
        <div style="flex-basis: 100%;">
          <label>Personal Email Address</label>
          <input type="text" value="{{ personal_email_address }}">
        </div>
      </div>
      <div style="margin-top: 30px;">
        <p>Please check the SURA box to opt in to the Stockton University Retiree's Association email distribution list.</p>
        <div style="margin-top: 15px;">
          <input type="checkbox" id="sura_optin" style="margin-right: 10px;">
          <label for="sura_optin">SURA</label>
        </div>
      </div>
    </div>
  </div>

  <!-- SECTION 3 -->
  <div style="border: 1px solid #000; padding: 20px; margin-bottom: 30px;">
    <div class="section-header">
      <h2 style="font-size: 14pt; margin: 0;">SECTION 3</h2>
      <h3 style="font-size: 12pt; margin: 0;">Acceptable Usage Policy Information</h3>
    </div>
    <div style="margin-top: 15px;">
      <p>Any Stockton retiree who chooses to opt into SURA distribution list must continue to uphold the expectations set forth in the University's Standards Concerning Acceptable Usage, which can be found at: <a href="{{ usage_policy_link }}" style="color: blue;">{{ usage_policy_link }}</a></p>
      <p style="margin-top: 15px;">The University will observe reasonable practices to respect the privacy of a retiree's personal email, however, it reserves the right to access email documents that pertain to University business.</p>
    </div>
  </div>

  <!-- Signatures -->
  <div class="signature-line">
    <div>
      <p>Employee Signature</p>
      <div style="border-bottom: 1px solid #000; width: 200px; margin-top: 5px;" data-field="employee_signature">{{ employee_signature }}</div>
      <p style="margin-top: 5px;">Date: <span data-field="employee_signature_date">{{ employee_signature_date }}</span></p>
    </div>
    <div>
      <p>Human Resources Signature</p>
      <div style="border-bottom: 1px solid #000; width: 200px; margin-top: 5px;" data-field="human_resources_signature">{{ human_resources_signature }}</div>
      <p style="margin-top: 5px;">Date: <span data-field="hr_signature_date">{{ hr_signature_date }}</span></p>
    </div>
  </div>

  <div style="position: absolute; bottom: 50px; right: 60px; font-size: 9pt; text-align: right;">
    <p>Stockton University</p>
    <p>Retired Staff Request Form</p>
  </div>
</div>