<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1 { font-size: 18pt; font-weight: bold; margin-bottom: 5px; }
  h2 { font-size: 14pt; font-weight: bold; margin-top: 20px; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 15px; }
  .form-label { font-weight: normal; }
  .form-input-line { border-bottom: 1px solid black; flex-grow: 1; margin-left: 10px; }
  .signature-line { border-bottom: 1px solid black; width: 50%; margin-top: 50px; }
</style>

<div class="page">
  <h1>UNDERGRADUATE STUDENT TECHNICAL PAPER COMPETITION</h1>
  <p>Submission Form</p>
  <p>Please type or print all information</p>

  <div class="form-row">
    <div class="form-label">Date</div>
    <div class="form-input-line"><span data-field="submission_date">{{ submission_date }}</span></div>
  </div>

  <div class="form-row">
    <div class="form-label">Chapter Name</div>
    <div class="form-input-line"><span data-field="chapter_name">{{ chapter_name }}</span></div>
    <div class="form-label">Number</div>
    <div class="form-input-line"><span data-field="paper_number">{{ paper_number }}</span></div>
    <div class="form-label">Region</div>
    <div class="form-input-line"><span data-field="region">{{ region }}</span></div>
  </div>

  <div class="form-row">
    <div class="form-label">Title of Paper</div>
  </div>
  <div style="margin-bottom: 30px;">
    <div class="form-input-line" style="width: 100%;" data-field="title_of_paper">{{ title_of_paper }}</div>
  </div>

  <div class="form-row" style="margin-bottom: 40px;">
    <div style="flex-basis: 100%;">
      Name, IIE membership number, address, phone number and e-mail for each author:
      <div class="form-input-line" style="width: 100%; margin-top: 10px;" data-field="title_of_paper_2">{{ title_of_paper_2 }}</div>
    </div>
  </div>

  <div style="margin-top: 50px;">
    <p>Faculty Advisor Certification: I, hereby, certify that this work is the original work of the author(s) and that it was completed while they were undergraduates.</p>
    <div class="form-row" style="margin-top: 50px;">
      <div style="flex-basis: 50%;">
        Name
        <div class="signature-line" data-field="field_1">{{ field_1 }}</div>
        <span data-field="advisor_name">{{ advisor_name }}</span>
      </div>
      <div style="flex-basis: 50%;">
        Signature
        <div class="signature-line" data-field="name">{{ name }}</div>
        <span data-field="advisor_signature">{{ advisor_signature }}</span>
      </div>
    </div>
  </div>

  <div class="form-row" style="margin-top: 60px;">
    <div class="form-label">Chapter #</div>
    <div class="form-input-line"><span data-field="chapter_number">{{ chapter_number }}</span></div>
    <div class="form-label">Date</div>
    <div class="form-input-line"><span data-field="certification_date">{{ certification_date }}</span></div>
  </div>

  <p style="margin-top: 40px;">No paper shall be received without this certification. Certification for the FIRST place winner must accompany the paper when submitted to IISE headquarters.</p>
</div>