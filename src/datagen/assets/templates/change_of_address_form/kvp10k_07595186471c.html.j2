<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; }
  h1, h2 { font-weight: bold; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 15px; }
  .form-label { font-weight: normal; }
  .input-field { border-bottom: 1px solid #000; padding-bottom: 2px; }
  .signature-line { border-bottom: 1px solid #000; margin-bottom: 30px; }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      <h1 style="font-size: 24pt; margin-bottom: 5px;">Change of Address/ Name form</h1>
    </div>
    <div style="text-align: right;">
      <h2 style="font-size: 12pt; margin-bottom: 5px;">Office of the Registrar</h2>
      <p style="font-size: 10pt; margin: 0;">Mail code L-109, Mackenzie Hall 1120</p>
      <p style="font-size: 10pt; margin: 0;">3181 SW Sam Jackson Park Rd.</p>
      <p style="font-size: 10pt; margin: 0;">Portland, OR 97239</p>
      <p style="font-size: 10pt; margin: 5px 0;">503-494-7800 phone</p>
      <p style="font-size: 10pt; margin: 0;">503-494-4629 fax</p>
      <button style="margin-top: 20px; padding: 8px 15px; border: 1px solid #000; background-color: #fff;">Print Form</button>
    </div>
  </div>

  <p style="margin-top: 30px;">Please complete all fields below and mail, fax or deliver to the Registrar's Office.</p>

  <div style="margin-top: 20px;">
    <div class="form-row">
      <span style="width: 150px;">Current Name:</span>
      <div style="display: flex; gap: 20px;">
        <div style="flex: 1;"><span class="input-field">{{ full_name.last }}</span></div>
        <div style="flex: 1;"><span class="input-field">{{ full_name.first }}</span></div>
        <div style="flex: 1;"><span class="input-field">{{ full_name.m_i }}</span></div>
        <div style="flex: 1;"><span class="input-field">{{ full_name.maiden_former }}</span></div>
      </div>
    </div>
    <div class="form-row">
      <span style="width: 150px;">Student ID or Social Security Number:</span>
      <div style="flex: 1;"><span class="input-field">{{ student_id_ssn }}</span></div>
    </div>
  </div>

  <div style="margin-top: 30px; border-top: 1px solid #000; padding-top: 15px;">
    <p style="font-size: 10pt;">Legal Name Change: Please attach supporting documentation (marriage license, driver's license, etc.). 
      <span style="font-weight: bold;">Before submitting this form to OHSU, it is important that the change is also made with the </span>
      <span style="font-weight: bold;">Social Security Administration</span> 
      <span style="font-size: 10pt;">or visit <a href="#" style="color: #000;">www.ssa.gov</a>.</span>
    </p>
    <p style="font-size: 10pt; margin-top: 10px;">This section is for current students only. If you are a former student, your student records will reflect the name that this office had on file at the time of graduation or the time that you discontinued your enrollment.</p>
    
    <div style="margin-top: 20px;">
      <p style="font-weight: bold;">Reason for name change:</p>
      <div style="display: flex; gap: 30px; margin-top: 10px;">
        <label><input type="radio" name="reason" value="new_legal"> New legal name</label>
        <label><input type="radio" name="reason" value="new_married"> New married name</label>
        <label><input type="radio" name="reason" value="former"> Former name</label>
      </div>
    </div>

    <div style="margin-top: 20px;">
      <p style="font-weight: bold;">New Name:</p>
      <div style="display: flex; gap: 20px;">
        <div style="flex: 1;"><span class="input-field">{{ new_name.last }}</span></div>
        <div style="flex: 1;"><span class="input-field">{{ new_name.first }}</span></div>
        <div style="flex: 1;"><span class="input-field">{{ new_name.m_i }}</span></div>
        <div style="flex: 1;"><span class="input-field">{{ new_name.maiden_former }}</span></div>
      </div>
    </div>
  </div>

  <div style="margin-top: 30px;">
    <p style="font-weight: bold;">Mailing Address Changed To: (Please Print)</p>
    <div style="display: flex; gap: 20px; margin-top: 10px;">
      <div style="flex: 2;"><span class="input-field">{{ new_address.street_line_1 }}</span></div>
    </div>
    <div style="display: flex; gap: 20px; margin-top: 10px;">
      <div style="flex: 1;"><span class="input-field">{{ new_address.city }}</span></div>
      <div style="flex: 1;"><span class="input-field">{{ new_address.state }}</span></div>
      <div style="flex: 1;"><span class="input-field">{{ new_address.zip }}</span></div>
    </div>
    <div style="margin-top: 10px;">
      <span style="display: inline-block; width: 150px;">Phone Number</span>
      <div style="flex: 1;"><span class="input-field">{{ new_address.phone }}</span></div>
    </div>
  </div>

  <div style="margin-top: 80px;">
    <div style="display: flex; justify-content: space-between;">
      <div style="width: 45%;">
        <span class="signature-line" style="width: 100%;" data-field="phone_number">{{ phone_number }}</span>
        <p style="margin-top: 5px;">Student Signature</p>
      </div>
      <div style="width: 45%;">
        <span class="signature-line" style="width: 100%;" data-field="student_signature">{{ student_signature }}</span>
        <p style="margin-top: 5px;">Date</p>
      </div>
    </div>
  </div>
</div>