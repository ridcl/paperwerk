                    <td><span data-field="ordering_key.relay_type_code">{{ ordering_key.relay_type_code }}</span></td>
                </tr>
                <tr>
                    <td>11</td>
                    <td>Vacant digit</td>
                    <td>-</td>
                </tr>
                <tr>
                    <td>12</td>
                    <td>Auxiliary supply</td>
                    <td>
                        {% for item in auxiliary_supply %}
                        <tr style="vertical-align: top;">
                            <td style="width: 10%;"></td>
                            <td style="width: 50%;">{{ item.description }}</td>
                            <td style="width: 20%;">{{ item.code }}</td>
                        </tr>
                        {% endfor %}
                    </td>
                </tr>
            </tbody>
        </table>
        <p style="font-size: 10pt; margin-top: 20px;">Example order code: <span data-field="example_order_code">{{ example_order_code }}</span></p>
        <p style="font-size: 10pt;">Figure 6. Ordering key for relay</p>
    </div>
    <div style="margin-top: 50px;">
        <h3 style="font-size: 12pt;">Your ordering code:</h3>
        <table>
            <thead>
                <tr class="header-row">
                    <td style="width: 10%;">Digit (#)</td>
                    <td style="width: 30%;">1-7</td>
                    <td style="width: 30%;">8-10</td>
                    <td style="width: 30%;">11</td>
                    <td style="width: 30%;">12</td>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Code</td>
                    <td><span data-field="ordering_code.1_7">{{ ordering_code.1_7 }}</span></td>
                    <td><span data-field="ordering_code.8_10">{{ ordering_code.8_10 }}</span></td>
                    <td><span data-field="ordering_code.11">{{ ordering_code.11 }}</span></td>
                    <td><span data-field="ordering_code.12">{{ ordering_code.12 }}</span></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

