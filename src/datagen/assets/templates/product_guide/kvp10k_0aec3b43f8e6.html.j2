        .page:last-child { page-break-after: auto; }
        h1, h2, h3, h4 { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial; }
        p, span, td { font-family: "DejaVu Sans", "Liberation Sans", Arial, "Helvetica"; }
        .header-right { text-align: right; }
        .footer { position: absolute; bottom: 50px; width: 100%; text-align: center; font-size: 10pt; }
        .page-number { float: left; font-size: 10pt; }
        .product-title { font-size: 24pt; font-weight: bold; margin-bottom: 10px; }
        .subtitle { font-size: 14pt; margin-bottom: 30px; }
        .section-heading { font-size: 16pt; font-weight: bold; margin-top: 30px; margin-bottom: 15px; }
        .feature-box { border: 1px solid #ccc; padding: 20px; margin-bottom: 20px; display: flex; align-items: flex-start; }
        .feature-icon { font-size: 24pt; margin-right: 15px; }
        .feature-content h4 { margin-top: 0; font-size: 12pt; }
        .table-container { margin-top: 20px; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th, td { border: 1px solid #ddd; padding: 10px; text-align: left; }
        th { background-color: #f2f2f2; }
    </style>
</head>
