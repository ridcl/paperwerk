    <div style="display: flex; justify-content: space-between; margin-top: 40px;">
        <div style="flex: 1;">
            <h3 style="margin-top: 0;">System voltages</h3>
            <ul>
                <li>United States and Canada</li>
                <li>480 V AC, 3-phase, 3-wire</li>
                <li>600 V AC, 3-phase, 3-wire</li>
                <li>208V/120 V AC, 3-phase, 4-wire</li>
                <li>480V/277 V AC, 3-phase, 4-wire</li>
                <li>600V/347 V AC, 3-phase, 4-wire</li>
                <li>International</li>
                <li>380 V AC, 3-phase, 3-wire</li>
                <li>400 V AC, 3-phase, 3-wire</li>
                <li>415 V AC, 3-phase, 3-wire</li>
                <li>220V/127 V AC, 3-phase, 4-wire</li>
                <li>230V/127 V AC, 3-phase, 4-wire</li>
                <li>380V/220 V AC, 3-phase, 4-wire</li>
                <li>400V/231V AC, 3-phase, 4-wire</li>
                <li>415V/240V AC, 3-phase, 4-wire</li>
            </ul>
        </div>
        <div style="flex: 1;">
            <h3 style="margin-top: 0;">Feed location</h3>
            <p>Top or bottom</p>
            <h3 style="margin-top: 20px;">Incoming type</h3>
            <p>Main lug only (MLO), main circuit breaker (MCB vertically mounted only) and with feed-through lugs or sub-feed breakers</p>
            <h3 style="margin-top: 20px;">Busbar ratings</h3>
            <p>125 A, 225 A, 250 A, 400 A, 600 A</p>
            <h3 style="margin-top: 20px;">Busbar material</h3>
            <p>Bare, silver-plated or tin-plated copper, tin-plated aluminum, heat-rated or density-rated</p>
            <h3 style="margin-top: 20px;">Available environmental enclosure types</h3>
            <ul>
                <li>NEMA 1 • NEMA 3R • NEMA 4/4X • NEMA 12</li>
            </ul>
        </div>
    </div>
</div>

