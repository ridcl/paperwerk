<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  h1, h2 { font-family: "DejaVu Serif", "Liberation Serif", Georgia, serif; }
  p, span { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; }
  hr { border: 0; border-top: 1px solid #ccc; margin: 20px 0; }
</style>

<div class="page">
  <header>
    <h1>Cleveland State University</h1>
    <h2>Information Services and Technology</h2>
  </header>

  <section>
    <h3>Mobile Hotspot (Separate Device from Phone)</h3>
    <p><strong>AT&T Velocity2 (Mobile Hotspot)</strong></p>
    <ul>
      <li>Price: <span data-field="price">{{ price }}</span> - Includes the USB port</li>
      <li>Monthly Charges: <span data-field="monthly_charges">{{ monthly_charges }}</span> which includes unlimited data usage</li>
    </ul>

    <p>For a device description: <a href="{{ device_link }}">{{ device_link }}</a></p>
  </section>

  <hr>

  <footer>
    <p>Revised: <span data-field="revision_date">{{ revision_date }}</span></p>
  </footer>
</div>