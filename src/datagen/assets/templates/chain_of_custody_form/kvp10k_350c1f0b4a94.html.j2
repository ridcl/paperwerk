<!DOCTYPE html>
<html>
<head>
    <title>Chain-of-Custody Form</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        .header-title { font-size: 24pt; font-weight: bold; margin-bottom: 5px; }
        .sub-header { font-size: 14pt; font-weight: bold; margin-bottom: 20px; }
        .section-title { font-size: 12pt; font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
        .form-row { display: flex; margin-bottom: 15px; }
        .form-row > div { flex: 1; }
        .label { font-weight: normal; }
        .input-line { border-bottom: 1px solid #000; margin-top: 5px; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th, td { border: 1px solid #000; padding: 8px; text-align: left; font-size: 10pt; }
        th { background-color: #f0f0f0; }
        .signature-row { display: flex; justify-content: space-between; margin-top: 50px; }
        .signature-box { width: 30%; border-top: 1px solid #000; padding-top: 5px; }
    </style>
</head>
<body>
    <div class="page">
        <div style="text-align: left;">
            <div class="header-title">TAAL</div>
        </div>
        <div style="margin-top: 30px;">
            <div class="sub-header">ULM TOXICOLOGY ASBESTOS ANALYSIS LAB</div>
            <div class="sub-header">CHAIN-OF-CUSTODY FORM - BULK ASBESTOS ANALYSIS</div>
        </div>

        <div style="display: flex; justify-content: space-between; margin-bottom: 30px;">
            <div>
                <div class="section-title">Sample Turn-Around-Time</div>
                <div style="margin-bottom: 10px;">
                    PLM-Bulk: <span data-field="turnaround_time_bulk">{{ turnaround_time_bulk }}</span>; <span data-field="turnaround_time_bulk_2">{{ turnaround_time_bulk_2 }}</span>; <span data-field="turnaround_time_bulk_3">{{ turnaround_time_bulk_3 }}</span>
                </div>
                <div style="margin-bottom: 10px;">
                    <input type="checkbox" style="margin-right: 5px;"> <span data-field="availability_check_1">{{ availability_check_1 }}</span>
                </div>
                <div style="margin-bottom: 10px;">
                    <input type="checkbox" style="margin-right: 5px;"> <span data-field="availability_check_2">{{ availability_check_2 }}</span>
                </div>
            </div>
        </div>

        <div style="margin-bottom: 30px;">
            <p style="font-weight: bold;">** Please call in advance for all drop-off**</p>
            <p>Note:</p>
            <p>All samples must be <span data-field="bagging_instruction">{{ bagging_instruction }}</span> prior to shipment.</p>
            <p>All samples are analyzed using the EPA 600-M4-82-020/R-93-116 method</p>
        </div>

        <div class="section-title">CLIENT INFORMATION:</div>
        <div class="form-row">
            <div style="width: 50%;">
                <div class="label">Company Name:</div>
                <div class="input-line"><span data-field="client_company_name">{{ client_company_name }}</span></div>
                <div class="label">Company Address:</div>
                <div class="input-line"><span data-field="client_company_address">{{ client_company_address }}</span></div>
            </div>
            <div style="width: 50%;">
                <div class="label">Project Manager:</div>
                <div class="input-line"><span data-field="project_manager_name">{{ project_manager_name }}</span></div>
                <div class="label">Phone:</div>
                <div class="input-line"><span data-field="project_manager_phone">{{ project_manager_phone }}</span></div>
                <div class="label">Fax:</div>
                <div class="input-line"><span data-field="project_manager_fax">{{ project_manager_fax }}</span></div>
                <div class="label">Date:</div>
                <div class="input-line"><span data-field="project_manager_date">{{ project_manager_date }}</span></div>
            </div>
        </div>

        <div class="section-title">PROJECT NAME:</div>
        <div class="input-line" style="width: 100%;"><span data-field="project_name">{{ project_name }}</span></div>

        <div class="section-title">CONTACT INFORMATION:</div>
        <div class="form-row">
            <div style="width: 50%;">
                <div class="label">Name:</div>
                <div class="input-line"><span data-field="contact_name">{{ contact_name }}</span></div>
                <div class="label">Invoice Address:</div>
                <div class="input-line"><span data-field="contact_invoice_address">{{ contact_invoice_address }}</span></div>
                <div class="label">E-mail Address:</div>
                <div class="input-line"><span data-field="contact_email">{{ contact_email }}</span></div>
                <div class="label">Notes:</div>
                <div class="input-line"><span data-field="contact_notes">{{ contact_notes }}</span></div>
            </div>
            <div style="width: 50%;">
                <div class="label">Phone #:</div>
                <div class="input-line"><span data-field="contact_phone">{{ contact_phone }}</span></div>
                <div class="label">Mobile #:</div>
                <div class="input-line"><span data-field="contact_mobile">{{ contact_mobile }}</span></div>
                <div class="label">Fax #:</div>
                <div class="input-line"><span data-field="contact_fax">{{ contact_fax }}</span></div>
            </div>
        </div>

        <div class="section-title">Sample Identification & Tracking</div>
        <table>
            <thead>
                <tr>
                    <th style="width: 25%;">Client's Sample Identification</th>
                    <th style="width: 35%;">Type/Description of Material</th>
                    <th style="width: 20%;">Comments</th>
                    <th style="width: 20%;">TAAL Sample # (Lab Use Only)</th>
                </tr>
            </thead>
            <tbody>
                {% for item in line_items %}
                <tr>
                    <td><span data-field="line_items[{{ loop.index0 }}].client_id">{{ item.client_id }}</span></td>
                    <td><span data-field="line_items[{{ loop.index0 }}].description">{{ item.description }}</span></td>
                    <td><span data-field="line_items[{{ loop.index0 }}].comments">{{ item.comments }}</span></td>
                    <td><span data-field="line_items[{{ loop.index0 }}].taal_sample_number">{{ item.taal_sample_number }}</span></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>

        <div class="signature-row">
            <div style="width: 30%;">
                <div class="label">Released By:</div>
                <div class="input-line" style="width: 100%;"><span data-field="release_by_name">{{ release_by_name }}</span></div>
                <div class="label">Date/Time:</div>
                <div class="input-line" style="width: 100%;"><span data-field="release_by_datetime">{{ release_by_datetime }}</span></div>
            </div>
            <div style="width: 30%;">
                <div class="label">Received By:</div>
                <div class="input-line" style="width: 100%;"><span data-field="receive_by_name">{{ receive_by_name }}</span></div>
                <div class="label">Date/Time:</div>
                <div class="input-line" style="width: 100%;"><span data-field="receive_by_datetime">{{ receive_by_datetime }}</span></div>
            </div>
            <div style="width: 30%;">
                <div class="label">Date/Time:</div>
                <div class="input-line" style="width: 100%;"><span data-field="final_date_time">{{ final_date_time }}</span></div>
            </div>
        </div>

        <div style="margin-top: 80px; font-size: 9pt;">
            ULM Toxicology Asbestos Analysis Lab - 700 University Avenue (Sugar Hall) - Monroe, LA 71209<br>
            Phone: <span data-field="lab_phone">{{ lab_phone }}</span>; Fax: <span data-field="lab_fax">{{ lab_fax }}</span><br>
            Document: TAAL-002; Revision 0, <span data-field="document_date">{{ document_date }}</span>
        </div>
    </div>
</body>
</html>