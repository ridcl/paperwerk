<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; }
  h1, h2, h3 { font-weight: bold; }
  hr { border: 0; border-top: 1px solid #ccc; margin: 20px 0; }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px;">
    <div>
      <h1 style="font-size: 36px; margin: 0;">AUS</h1>
      <p style="font-size: 14px; margin: 0;">الجامعة الأمريكية في الشارقة</p>
      <p style="font-size: 14px; margin: 0;">American University of Sharjah</p>
    </div>
    <div style="text-align: right; font-size: 12px;">
      <p style="margin: 0;">INTERNATIONAL EXCHANGE OFFICE</p>
      <p style="margin: 0;">مكتب برامج التبادل الدولي</p>
    </div>
  </div>

  <h2 style="font-size: 24px; margin-top: 40px; margin-bottom: 10px;">Emergency Information for Program Organizer and Chaperones</h2>

  <p style="font-size: 14px; margin-bottom: 20px;">
    Please provide one completed sheet for each program organizer/chaperone. The completed form must be submitted for approvals three weeks before the date of departure.
  </p>
  <p style="font-size: 14px; margin-bottom: 30px;">
    The confidential information requested below will be used in case of emergencies and is limited to the duration of the trip.
  </p>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold; margin-bottom: 5px;">Program Organizer's/Chaperone's Name</p>
    <hr style="margin-top: 0;">
    <div style="margin-top: 5px;"><span data-field="full_name">{{ full_name }}</span></div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold; margin-bottom: 5px;">Program</p>
    <hr style="margin-top: 0;">
    <div style="margin-top: 5px;"><span data-field="program_name">{{ program_name }}</span></div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold; margin-bottom: 5px;">Emergency Contact Information</p>
    <hr style="margin-top: 0;">
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold; margin-bottom: 5px;">Name</p>
    <hr style="margin-top: 0;">
    <div style="margin-top: 5px;"><span data-field="emergency_contact.name">{{ emergency_contact.name }}</span></div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold; margin-bottom: 5px;">Relationship</p>
    <hr style="margin-top: 0;">
    <div style="margin-top: 5px;"><span data-field="emergency_contact.relationship">{{ emergency_contact.relationship }}</span></div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold; margin-bottom: 5px;">Address</p>
    <hr style="margin-top: 0;">
    <div style="margin-top: 5px;"><span data-field="emergency_contact.address">{{ emergency_contact.address }}</span></div>
  </div>

  <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
    <div style="width: 48%;">
      <p style="font-weight: bold; margin-bottom: 5px;">Daytime Telephone</p>
      <hr style="margin-top: 0;">
      <div style="margin-top: 5px;"><span data-field="emergency_contact.daytime_phone">{{ emergency_contact.daytime_phone }}</span></div>
    </div>
    <div style="width: 48%;">
      <p style="font-weight: bold; margin-bottom: 5px;">Evening Telephone</p>
      <hr style="margin-top: 0;">
      <div style="margin-top: 5px;"><span data-field="emergency_contact.evening_phone">{{ emergency_contact.evening_phone }}</span></div>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold; margin-bottom: 5px;">Mobile</p>
    <hr style="margin-top: 0;">
    <div style="margin-top: 5px;"><span data-field="emergency_contact.mobile_phone">{{ emergency_contact.mobile_phone }}</span></div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold; margin-bottom: 5px;">Health and Travel Insurance Information</p>
    <hr style="margin-top: 0;">
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold; margin-bottom: 5px;">Insurance Provider's Name</p>
    <hr style="margin-top: 0;">
    <div style="margin-top: 5px;"><span data-field="insurance_provider.name">{{ insurance_provider.name }}</span></div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold; margin-bottom: 5px;">Insurance Policy Number</p>
    <hr style="margin-top: 0;">
    <div style="margin-top: 5px;"><span data-field="insurance_provider.policy_number">{{ insurance_provider.policy_number }}</span></div>
  </div>

  <div style="margin-bottom: 30px;">
    <p style="font-weight: bold; margin-bottom: 5px;">Additional information you wish us to know (include medical conditions/medications, allergies, all medications you are taking, including dietary supplements)</p>
    <hr style="margin-top: 0;">
    <div style="margin-top: 5px;"><span data-field="medical_information">{{ medical_information }}</span></div>
  </div>

  <div style="margin-bottom: 30px;">
    <p style="font-weight: bold; margin-bottom: 5px;">I give American University of Sharjah permission to contact the above-listed emergency contact in case of an emergency.</p>
    <hr style="margin-top: 0;">
  </div>

  <div style="display: flex; justify-content: space-between; margin-top: 50px; font-size: 12px;">
    <div style="text-align: left;">
      <p>Signature of Faculty Member/ Chaperone</p>
    </div>
    <div style="text-align: right;">
      <p>Date</p>
    </div>
  </div>

  <div style="font-size: 10px; margin-top: 50px; line-height: 1.4;">
    <p><em>*AUS faculty and/or staff are automatically provided with business travel insurance through Al Buhaira National Insurance Company (ABNIC). Please contact the Senior Human Resources Officer to request a Letter of Insurance Coverage for visa purposes. Chaperones who are not AUS faculty/staff must be spouses of direct employees of AUS; these chaperones must organize travel insurance through ABNIC.</em></p>
    <p style="margin-top: 10px;">Emergency Information for Program Organizer and Chaperones</p>
    <p style="text-align: right;">Page 1 of 1</p>
    <p style="text-align: right;">Revised: {{ revision_date }}</p>
  </div>
</div>