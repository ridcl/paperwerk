    </div>
    <div style="text-align: right;">
      <p style="margin: 0; font-size: 14px;">UUPC Approval: <span data-field="uupc_approval">{{ uupc_approval }}</span></p>
      <p style="margin: 0; font-size: 14px;">UGPC Approval: <span data-field="ugpc_approval">{{ ugpc_approval }}</span></p>
      <p style="margin: 0; font-size: 14px;">UFS Approval: <span data-field="ufs_approval">{{ ufs_approval }}</span></p>
      <p style="margin: 0; font-size: 14px;">Banner Posted: <span data-field="banner_posted">{{ banner_posted }}</span></p>
      <p style="margin: 0; font-size: 14px;">Catalog: <span data-field="catalog">{{ catalog }}</span></p>
    </div>
  </div>

  <h2 style="margin-top: 0;">New Combined Degree Program Request</h2>

