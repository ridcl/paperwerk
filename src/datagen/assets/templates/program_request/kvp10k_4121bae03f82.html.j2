        <span data-field="curriculum_requirements">{{ curriculum_requirements }}</span>
      </div>
    </div>
  </div>

  <table style="margin-bottom: 30px;">
    <tr>
      <th style="width: 30%;">GPA Requirements:</th>
      <td style="width: 70%;">Departments must establish a minimum undergraduate GPA for students to be admitted to a combined program. Note: Please attach explanation.</td>
    </tr>
    <tr>
      <td>Students must have a minimum GPA of <span data-field="min_gpa">{{ min_gpa }}</span> in upper division course work.</td>
    </tr>
