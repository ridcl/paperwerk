      <td><span data-field="grad_department">{{ grad_department }}</span></td>
    </tr>
  </table>

  <div style="display: flex; justify-content: space-between; margin-bottom: 30px;">
    <div style="width: 48%;">
      <h3 style="margin-top: 0;">Program Description (provide a brief description of the program, including thesis or non-thesis option)</h3>
