<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  td {
    padding: 5px 0;
    vertical-align: top;
  }
  .header-table td {
    padding: 10px 0;
  }
</style>

<div class="page">
  <div style="text-align: right; margin-bottom: 40px;">
    <div style="font-size: 24px; font-weight: bold;">JCCC</div>
    <div style="font-size: 12px;">COMMUNITY-BASED LEARNING</div>
    <div style="font-size: 10px;">Return to Tara Karaim</div>
    <div style="font-size: 10px;">Community-Based Learning Coordinator</div>
    <div style="font-size: 10px;">tkaraim@jccc.edu</div>
    <div style="font-size: 10px;">COM 201</div>
  </div>
  <h1 style="text-align: center; margin-bottom: 30px;">JCCC Service Award Form</h1>

  <table class="header-table">
    <tr>
      <td style="width: 30%;">Student Name: <span data-field="full_name">{{ full_name }}</span></td>
      <td style="width: 30%;">Student ID: <span data-field="student_id">{{ student_id }}</span></td>
      <td style="width: 40%;"></td>
    </tr>
    <tr>
      <td>Email: <span data-field="student_email">{{ student_email }}</span></td>
      <td>Phone Number: <span data-field="student_phone">{{ student_phone }}</span></td>
      <td>Total Number of Service Hours: <span data-field="total_service_hours">{{ total_service_hours }}</span></td>
    </tr>
  </table>

  <h2 style="margin-top: 40px; margin-bottom: 20px;">Service Hours Verification (attach additional sheets if necessary)</h2>

  <!-- Loop for Service Verification Entries -->
  {% for i in range(3) %}
  <table style="margin-bottom: 30px;">
    <tr>
      <td style="width: 25%;">Nonprofit Name: <span data-field="service_entries[{{ i }}].nonprofit_name">{{ service_entries[i].nonprofit_name }}</span></td>
      <td style="width: 25%;">Start Date of Volunteering: <span data-field="service_entries[{{ i }}].start_date">{{ service_entries[i].start_date }}</span></td>
      <td style="width: 25%;">End Date of Volunteering: <span data-field="service_entries[{{ i }}].end_date">{{ service_entries[i].end_date }}</span></td>
      <td style="width: 25%;">Number of Hours: <span data-field="service_entries[{{ i }}].hours">{{ service_entries[i].hours }}</span></td>
    </tr>
    <tr>
      <td>Supervisor Name and Title: <span data-field="service_entries[{{ i }}].supervisor_name">{{ service_entries[i].supervisor_name }}</span></td>
      <td>Supervisor Email: <span data-field="service_entries[{{ i }}].supervisor_email">{{ service_entries[i].supervisor_email }}</span></td>
      <td style="width: 50%;">Supervisor Phone Number: <span data-field="service_entries[{{ i }}].supervisor_phone">{{ service_entries[i].supervisor_phone }}</span></td>
    </tr>
  </table>
  {% endfor %}

  <div style="margin-top: 80px;">
    <table style="width: 100%;">
      <tr>
        <td style="width: 50%; border-bottom: 1px solid black;">Student Signature:</td>
        <td style="width: 50%; border-bottom: 1px solid black;">Date:</td>
      </tr>
      <tr>
        <td style="width: 50%;">To be filled out by Community-Based Learning office:</td>
        <td style="width: 50%;"></td>
      </tr>
      <tr>
        <td style="width: 50%;">Level of Award: <span data-field="award_level">{{ award_level }}</span></td>
        <td style="width: 50%;">Date turned in: <span data-field="date_turned_in">{{ date_turned_in }}</span> Date verified: <span data-field="date_verified">{{ date_verified }}</span> Verifier's Initials: <span data-field="verifier_initials">{{ verifier_initials }}</span></td>
      </tr>
    </table>
  </div>
</div>