  }
  .page:last-child { page-break-after: auto; }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
    font-family: inherit;
  }
  th, td {
    border: 1px solid #000;
    padding: 8px;
    text-align: left;
  }
  th {
    background-color: #f0f0f0;
    font-weight: bold;
  }
  .header-section {
    margin-bottom: 30px;
  }
  .footer {
    position: absolute;
    bottom: 50px;
    width: 100%;
    font-size: 10px;
    color: #555;
    display: flex;
    justify-content: space-between;
  }
</style>
<style>
