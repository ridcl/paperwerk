<body>

<div class="page">
    <div class="logo-container">
        <!-- Placeholder for University Seal Image -->
        <div style="width: 150px; height: 150px; margin: 0 auto;"></div>
    </div>
    <h1 style="font-size: 36pt; margin-bottom: 5px;">Southern University and</h1>
    <h1 style="font-size: 36pt; margin-top: 0;">Agricultural & Mechanical College</h1>

    <h2 style="font-size: 32pt; margin-top: 60px; margin-bottom: 10px;">Operational Plan</h2>
    <h2 style="font-size: 32pt; margin-top: 0; margin-bottom: 80px;">FY {{ fiscal_year }}</h2>

    <div style="text-align: center;">
        <p>Submitted by:</p>
        <h3 style="margin-top: 10px;">Office of Institutional Effectiveness (OIE)</h3>
        <p>P.O. Box {{ zip_code }}, {{ city }}, {{ state }} {{ zip_code }}</p>
        <p>Telephone: {{ phone_number }}</p>
    </div>

    <div class="signature-line">
        <!-- Placeholder for decorative element -->
        <div style="width: 100px; height: 2px; background-color: #000; margin: 0 auto;"></div>
    </div>
</div>

<div class="page">
    <div style="text-align: left;">
        <h2 style="font-size: 18pt; margin-bottom: 10px;">Office of Institutional Effectiveness (OIE)</h2>
        <p>P.O. Box {{ zip_code }}, {{ city }}, {{ state }} {{ zip_code }}</p>
        <p>Telephone: {{ phone_number }}</p>
    </div>

    <h3 style="margin-top: 40px;">Personnel</h3>

    {% for person in personnel %}
    <div style="margin-bottom: 20px;">
        <p><strong>{{ person.title }}</strong></p>
        <p><strong>{{ person.full_name }}</strong></p>
        <p>Department: {{ person.department }}</p>
        <p>Email: <a href="mailto:{{ person.email }}">{{ person.email }}</a></p>
        <p>Phone: {{ person.phone }}</p>
        <p>Location: {{ person.location }}</p>
    </div>
    {% endfor %}
</div>

<div class="page">
    <div style="text-align: center;">
        <p>DEPARTMENT ID: <span data-field="department_id">{{ department_id }}</span></p>
        <p>AGENCY ID: <span data-field="agency_id">{{ agency_id }}</span></p>
    </div>

    <div style="text-align: center; margin-top: 100px;">
        <h2 style="font-size: 32pt;">OPERATIONAL PLAN</h2>
        <h2 style="font-size: 32pt;">FY {{ fiscal_year }}</h2>
    </div>
</div>

<div class="page">
