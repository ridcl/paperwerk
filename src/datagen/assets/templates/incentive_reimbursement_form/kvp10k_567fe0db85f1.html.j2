<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; }
  .form-group { margin-bottom: 15px; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 15px; }
  .form-row > div { width: 48%; }
  .full-width-field { width: 100%; }
  .input-field { border: 1px solid #ccc; padding: 8px; box-sizing: border-box; width: 100%; }
  .signature-line { margin-top: 60px; display: flex; justify-content: space-between; }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px;">
    <div style="text-align: left;">
      <div style="font-size: 24px; font-weight: bold;">LOMA LINDA UNIVERSITY</div>
      <div style="font-size: 12px;">Research Affairs Financial Management</div>
      <div style="font-size: 12px;">24887 Taylor Street, Suite 202</div>
      <div style="font-size: 12px;">Loma Linda, CA 92350</div>
      <div style="font-size: 12px;">Phone: (909) 558-4589 or Ext. 44589</div>
      <div style="font-size: 12px;">Fax: (909) 558-0199</div>
    </div>
    <div style="text-align: right;">
      <button style="padding: 10px 20px; border: 1px solid #000; background-color: #fff; cursor: pointer;">Print Form</button>
      <div style="margin-top: 20px;">
        <span data-field="llera_id">{{ llera_id }}</span>
      </div>
    </div>
  </div>

  <h2 style="text-align: center; margin-bottom: 30px;">Participant Incentive Reimbursement Form</h2>

  <p style="margin-bottom: 30px;">To reimburse a participant, this form must be completed and accompanied by a signed <span data-field="payment_voucher_reference">{{ payment_voucher_reference }}</span>. Send original, signed documents to RAFM, (909) 558-4589, rafm@llu.edu.</p>

  <!-- STUDY INFORMATION SECTION -->
  <h3 style="border-bottom: 1px solid #000; padding-bottom: 5px; margin-top: 30px;">STUDY INFORMATION - To be completed by the Principal Investigator or staff</h3>

  <div class="form-group">
    <div class="form-row">
      <div style="width: 50%;">
        <label for="pi_director">Principal investigator/Project Director</label>
        <input type="text" id="pi_director" class="input-field" style="margin-top: 5px;" data-field="principal_investigator.name" value="{{ principal_investigator.name }}">
      </div>
      <div style="width: 50%;">
        <label for="school_entity">School/Entity</label>
        <input type="text" id="school_entity" class="input-field" style="margin-top: 5px;" data-field="school_entity.name" value="{{ school_entity.name }}">
      </div>
    </div>
  </div>

  <div class="form-group">
    <div class="form-row">
      <div style="width: 50%;">
        <label for="department">Department</label>
        <input type="text" id="department" class="input-field" style="margin-top: 5px;" data-field="department.name" value="{{ department.name }}">
      </div>
      <div style="width: 50%;">
        <label for="llu_account">LLU Account Number</label>
        <input type="text" id="llu_account" class="input-field" style="margin-top: 5px;" data-field="llu_account.number" value="{{ llu_account.number }}">
      </div>
    </div>
  </div>

  <div class="form-group">
    <div class="form-row">
      <div style="width: 50%;">
        <label for="project_title">Project/Study Title</label>
        <input type="text" id="project_title" class="input-field" style="margin-top: 5px;" data-field="project_title.name" value="{{ project_title.name }}">
      </div>
      <div></div> <!-- Spacer -->
    </div>
  </div>

  <!-- STUDY PARTICIPATION INFORMATION SECTION -->
  <h3 style="border-bottom: 1px solid #000; padding-bottom: 5px; margin-top: 30px;">STUDY PARTICIPATION INFORMATION - To be completed by the Principal Investigator or staff</h3>

  <div class="form-group">
    <div class="form-row">
      <div style="width: 50%;">
        <label for="date_of_study">Date(s) of Study Participation</label>
        <input type="text" id="date_of_study" class="input-field" style="margin-top: 5px;" data-field="study_participation.dates" value="{{ study_participation.dates }}">
      </div>
      <div style="width: 40%; text-align: right;">
        <label>Incentive Amount</label>
        <input type="text" class="input-field" style="width: 100%; text-align: right;" data-field="incentive_amount.value" value="{{ incentive_amount.value }}">
        <span style="font-size: 12px;">$</span>
      </div>
    </div>
  </div>

  <div class="form-group">
    <label>Does incentive amount match compensation amount stated in protocol?</label>
    <div style="margin-top: 10px;">
      <input type="radio" id="yes" name="match" value="yes" style="margin-right: 5px;">
      <label for="yes">Yes</label>
      <input type="radio" id="no" name="match" value="no" style="margin-left: 20px; margin-right: 5px;">
      <label for="no">No</label>
    </div>
  </div>

  <div class="form-group">
    <label>If no, please provide an explanation:</label>
    <textarea class="input-field full-width-field" rows="4" data-field="explanation.text">{{ explanation.text }}</textarea>
  </div>

  <!-- PARTICIPANT INFORMATION SECTION -->
  <h3 style="border-bottom: 1px solid #000; padding-bottom: 5px; margin-top: 30px;">PARTICIPANT INFORMATION - To be completed by Study Participant</h3>

  <div class="form-group">
    <div class="form-row">
      <div style="width: 50%;">
        <label for="participant_name">Name of Participant</label>
        <input type="text" id="participant_name" class="input-field" style="margin-top: 5px;" data-field="participant_info.name" value="{{ participant_info.name }}">
      </div>
      <div style="width: 50%;">
        <label for="legal_guardian_name">Name of Legal Guardian (if applicable)</label>
        <input type="text" id="legal_guardian_name" class="input-field" style="margin-top: 5px;" data-field="legal_guardian.name" value="{{ legal_guardian.name }}">
      </div>
    </div>
  </div>

  <div class="form-group">
    <div class="form-row">
      <div style="width: 50%;">
        <label for="participant_address">Participant Address</label>
        <input type="text" id="participant_address" class="input-field" style="margin-top: 5px;" data-field="participant_info.address" value="{{ participant_info.address }}">
      </div>
      <div style="width: 50%;">
        <label for="city">City</label>
        <input type="text" id="city" class="input-field" style="margin-top: 5px;" data-field="participant_info.city" value="{{ participant_info.city }}">
        <label for="state">State</label>
        <input type="text" id="state" class="input-field" style="margin-top: 5px;" data-field="participant_info.state" value="{{ participant_info.state }}">
        <label for="zip">Zip</label>
        <input type="text" id="zip" class="input-field" style="margin-top: 5px;" data-field="participant_info.zip" value="{{ participant_info.zip }}">
      </div>
    </div>
  </div>

  <div class="form-group">
    <div class="form-row">
      <div style="width: 50%;">
        <label for="ssn">Participant Social Security Number</label>
        <input type="text" id="ssn" class="input-field" style="margin-top: 5px;" data-field="participant_info.ssn" value="{{ participant_info.ssn }}">
      </div>
      <div style="width: 50%;">
        <label for="lg_ssn">Legal Guardian Social Security Number (if applicable)</label>
        <input type="text" id="lg_ssn" class="input-field" style="margin-top: 5px;" data-field="legal_guardian.ssn" value="{{ legal_guardian.ssn }}">
      </div>
    </div>
  </div>

  <!-- SIGNATURES SECTION -->
  <div class="signature-line">
    <div style="width: 30%;">
      <p>Print Name of Participant</p>
      <div style="height: 1px; border-top: 1px solid #000; margin-top: 50px;"></div>
      <p>Participant Signature</p>
    </div>
    <div style="width: 30%; text-align: right;">
      <p>Date</p>
    </div>
  </div>

  <div class="signature-line" style="margin-top: 40px;">
    <div style="width: 30%;">
      <p>Print Name of Legal Guardian</p>
      <div style="height: 1px; border-top: 1px solid #000; margin-top: 50px;"></div>
      <p>Legal Guardian Signature</p>
    </div>
    <div style="width: 30%; text-align: right;">
      <p>Date</p>
    </div>
  </div>

  <div class="signature-line" style="margin-top: 40px;">
    <div style="width: 30%;">
      <p>Print Name of Witness</p>
      <div style="height: 1px; border-top: 1px solid #000; margin-top: 50px;"></div>
      <p>Witness Signature</p>
    </div>
    <div style="width: 30%; text-align: right;">
      <p>Date</p>
    </div>
  </div>
</div>