<!DOCTYPE html>
<html>
<head>
    <title>Equestrian Center Boarding Wait List Sign-Up Form</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
        }
        .page:last-child { page-break-after: auto; }
        /* Basic styling to mimic layout structure */
        h1, h2 { font-weight: bold; }
        .form-group { margin-bottom: 15px; }
        .label { display: inline-block; width: 150px; vertical-align: top; }
        .input-field { border-bottom: 1px solid #000; width: calc(100% - 160px); }
        .checkbox-group label { margin-right: 15px; }
        .divider { border-top: 1px solid #000; margin: 20px 0; }
    </style>
</head>
<body>
    <div class="page">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
                <h1 style="font-size: 24pt; margin: 0;">UC DAVIS</h1>
                <h2 style="font-size: 16pt; margin: 0;">CAMPUS RECREATION</h2>
                <p style="font-size: 12pt; margin: 0;">Equestrian Center</p>
            </div>
            <div style="text-align: right;">
                <h1 style="font-size: 20pt; margin: 0;">Equestrian Center</h1>
                <h2 style="font-size: 18pt; margin: 0;">Boarding Wait List</h2>
                <h2 style="font-size: 18pt; margin: 0;">Sign-Up Form</h2>
            </div>
        </div>

        <div class="divider"></div>

        <div style="display: flex; justify-content: space-between; margin-bottom: 20px; font-size: 10pt;">
            <div>1 Equestrian Lane</div>
            <div><span data-field="website_url">{{ website_url }}</span></div>
            <div><span data-field="phone_number">{{ phone_number }}</span></div>
        </div>

        <div class="form-group">
            <div style="display: flex;">
                <div class="label">Name:</div>
                <div style="flex-grow: 1;"><span data-field="full_name" class="input-field">{{ full_name }}</span></div>
            </div>
        </div>

        <div class="form-group">
            <div style="display: flex;">
                <div class="label">Address:</div>
                <div style="flex-grow: 1;"><span data-field="address" class="input-field">{{ address }}</span></div>
            </div>
        </div>

        <div class="form-group">
            <div style="display: flex;">
                <div class="label">Home Phone #:</div>
                <div style="flex-grow: 1;"><span data-field="home_phone" class="input-field">{{ home_phone }}</span></div>
            </div>
        </div>

        <div class="form-group">
            <div style="display: flex;">
                <div class="label">Cell Phone #:</div>
                <div style="flex-grow: 1;"><span data-field="cell_phone" class="input-field">{{ cell_phone }}</span></div>
            </div>
        </div>

        <div class="form-group">
            <div style="display: flex;">
                <div class="label">Email:</div>
                <div style="flex-grow: 1;"><span data-field="email" class="input-field">{{ email }}</span></div>
            </div>
        </div>

        <div style="margin-top: 25px;">
            <p style="font-weight: bold;">Please Check Your Preference Below:</p>
            <div class="checkbox-group" style="margin-top: 10px;">
                <label><input type="checkbox"> Stall $475</label>
                <label><input type="checkbox"> Pasture $300</label>
            </div>
        </div>

        <div style="margin-top: 25px;">
            <p style="font-weight: bold;">Please Check Your Horse's Gender Below:</p>
            <div class="checkbox-group" style="margin-top: 10px;">
                <label><input type="checkbox"> Mare</label>
                <label><input type="checkbox"> Gelding</label>
            </div>
        </div>

        <div class="form-group" style="margin-top: 25px;">
            <div style="display: flex;">
                <div class="label">Anticipated Move-In Date:</div>
                <div style="flex-grow: 1;"><span data-field="move_in_date" class="input-field">{{ move_in_date }}</span></div>
            </div>
        </div>

        <p style="font-size: 10pt; margin-top: 15px;">*Please attach a copy of your UC Davis acceptance letter*</p>

        <div style="margin-top: 40px; padding: 20px; border: 1px solid #000;">
            <p style="font-weight: bold; margin-top: 0;">Please Email or Mail This Form, Along With You Acceptance Letter To:</p>
            <p style="margin: 5px 0;">UC Davis Equestrian Center</p>
            <p style="margin: 5px 0;">1 Equestrian Lane</p>
            <p style="margin: 5px 0;">Davis, CA 95616</p>
            <p style="margin: 5px 0;">(530)752-2372</p>
        </div>
    </div>

    <div class="page">
        <div style="text-align: center; margin-top: 50px;">
            <div style="border: 1px solid #000; padding: 10px; width: 80%;">
                <span data-field="email_address">{{ email_address }}</span>
            </div>
        </div>
    </div>
</body>
</html>