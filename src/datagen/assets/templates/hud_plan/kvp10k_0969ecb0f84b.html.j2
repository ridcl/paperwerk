      <input type="checkbox" id="opt1"><label for="opt1" style="margin-left: 5px;">A. Low/Very low income</label>
      <input type="checkbox" id="opt2"><label for="opt2" style="margin-left: 5px;">B. Public housing resident</label>
      <input type="checkbox" id="opt3"><label for="opt3" style="margin-left: 5px;">C. A representative of A or B</label>
      <input type="checkbox" id="opt4"><label for="opt4" style="margin-left: 5px;">D. Section 3 business concern</label>
      <input type="checkbox" id="opt5"><label for="opt5" style="margin-left: 5px;">E. A representative of D</label>
      <input type="checkbox" id="opt6"><label for="opt6" style="margin-left: 5px;">F. Other (please specify)</label>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Complainant is against (check one or more boxes):</p>
