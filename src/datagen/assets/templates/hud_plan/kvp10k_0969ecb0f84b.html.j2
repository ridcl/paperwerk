      <input type="checkbox" id="comp1"><label for="comp1" style="margin-left: 5px;">A. Applicant</label>
      <input type="checkbox" id="comp2"><label for="comp2" style="margin-left: 5px;">B. Sub-recipient</label>
      <input type="checkbox" id="comp3"><label for="comp3" style="margin-left: 5px;">C. Subcontractor</label>
      <input type="checkbox" id="comp4"><label for="comp4" style="margin-left: 5px;">D. Recipient</label>
      <input type="checkbox" id="comp5"><label for="comp5" style="margin-left: 5px;">E. Contractor</label>
      <input type="checkbox" id="comp6"><label for="comp6" style="margin-left: 5px;">F. Other (please specify)</label>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Basis for non-compliance with Section 3:</p>
