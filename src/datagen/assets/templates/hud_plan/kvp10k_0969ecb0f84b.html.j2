<div class="page">
  <h1 style="font-size: 16pt; margin-bottom: 10px;">EXHIBIT H</h1>

  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px;">
    <div>
      <h2 style="font-size: 12pt; font-weight: bold;">Complaint Register</h2>
      <p style="font-size: 10pt;">Under Section 3 of the Housing and Urban Development Act of 1968</p>
    </div>
    <div style="text-align: right;">
      <p style="font-size: 10pt;">OMB Approval No. <span data-field="omb_approval_no">{{ omb_approval_no }}</span></p>
      <p style="font-size: 10pt;">(Expires <span data-field="omb_expiration_date">{{ omb_expiration_date }}</span>)</p>
    </div>
  </div>

  <table style="margin-bottom: 20px;">
    <tr>
