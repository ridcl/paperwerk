        <label for="date_signed" style="display: block; margin-bottom: 5px;">Date:</label>
        <span data-field="date_signed">{{ date_signed }}</span>
      </div>
    </div>
  </div>

  <div style="margin-top: 50px; font-size: 9pt;">
    <p><span data-field="page_footer_text">{{ page_footer_text }}</span></p>
  </div>
</div>

