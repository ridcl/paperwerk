<!DOCTYPE html>
<html>
<head>
<title>Memorandum</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
    line-height: 1.6;
    color: #000;
  }
  h1, h2, h3 {
    font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif;
    font-weight: bold;
  }
  .header-title {
    font-size: 24pt;
    font-weight: bold;
    margin-bottom: 5px;
  }
  .sub-header {
    font-size: 14pt;
    font-weight: bold;
    margin-bottom: 20px;
  }
  .metadata p {
    margin: 2px 0;
    font-size: 10pt;
  }
  .section-heading {
    font-size: 12pt;
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 5px;
  }
  .divider {
    border-top: 1px solid #000;
    margin: 20px 0;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
  }
  td {
    padding: 5px 0;
    vertical-align: top;
  }
</style>
</head>
<body>

<div class="page">
  <div style="margin-bottom: 20px;">
    <div class="header-title">Office of Chief Counsel</div>
    <div class="sub-header">Internal Revenue Service</div>
    <div style="margin-top: 10px;">
      <div style="font-size: 18pt; font-weight: bold;">Memorandum</div>
    </div>
  </div>

  <div class="metadata" style="margin-bottom: 30px;">
    <p>Number: <span data-field="document_number">{{ document_number }}</span></p>
    <p>Release Date: <span data-field="release_date">{{ release_date }}</span></p>
    <p>CC: <span data-field="cc_recipient">{{ cc_recipient }}</span></p>
    <p>POSTN: <span data-field="posting_number">{{ posting_number }}</span></p>
  </div>

  <div style="margin-bottom: 20px;">
    <p>UILC: <span data-field="uilc_code">{{ uilc_code }}</span></p>
    <p>date: <span data-field="date">{{ date }}</span></p>
    <p>to: <span data-field="recipient_name">{{ recipient_name }}</span>, <span data-field="recipient_title">{{ recipient_title }}</span></p>
    <p>from: <span data-field="sender_name">{{ sender_name }}</span>, <span data-field="sender_title">{{ sender_title }}</span></p>
  </div>

  <div class="divider"></div>

  <div style="margin-top: 20px;">
    <p>subject: <span data-field="subject_summary">{{ subject_summary }}</span></p>
    <p>This memorandum responds to your request for assistance. This advice may not be used or cited as precedent.</p>
  </div>

  <div style="margin-top: 30px;">
    <div class="section-heading">LEGEND</div>
    <table style="width: 50%;">
      <tr>
        <td style="width: 30%;">Corporation X</td>
        <td style="width: 20%;">=</td>
        <td style="width: 50%;"><span data-field="legend_item_1">{{ legend_item_1 }}</span></td>
      </tr>
      <tr>
        <td>YR1</td>
        <td>=</td>
        <td><span data-field="legend_item_2">{{ legend_item_2 }}</span></td>
      </tr>
      <tr>
        <td>YR2</td>
        <td>=</td>
        <td><span data-field="legend_item_3">{{ legend_item_3 }}</span></td>
      </tr>
      <tr>
        <td>YR6</td>
        <td>=</td>
        <td><span data-field="legend_item_4">{{ legend_item_4 }}</span></td>
      </tr>
      <tr>
        <td>Date 1</td>
        <td>=</td>
        <td><span data-field="legend_item_5">{{ legend_item_5 }}</span></td>
      </tr>
    </table>
  </div>

  <div style="margin-top: 30px;">
    <div class="section-heading">ISSUE</div>
    <p><span data-field="issue_statement">{{ issue_statement }}</span></p>
  </div>

  <div style="margin-top: 30px;">
    <div class="section-heading">CONCLUSIONS</div>
    <p><span data-field="conclusion_summary">{{ conclusion_summary }}</span></p>
    <ol>
      <li><span data-field="conclusion_point_1">{{ conclusion_point_1 }}</span></li>
    </ol>
  </div>

</div>

<div class="page">
  <div style="text-align: right; margin-bottom: 50px;">
    <span data-field="page_number_top">{{ page_number_top }}</span>
  </div>

  <div style="margin-bottom: 20px;">
    <p>POSTN-111014-21</p>
  </div>

  <div style="margin-bottom: 20px;">
    <p><span data-field="paragraph_1_text">{{ paragraph_1_text }}</span></p>
  </div>

  <div style="margin-bottom: 20px;">
    <p><span data-field="paragraph_2_text">{{ paragraph_2_text }}</span></p>
  </div>

  <div style="margin-top: 30px;">
    <div class="section-heading">FACTS</div>
    <p><span data-field="facts_intro">{{ facts_intro }}</span></p>
    <p><span data-field="facts_detail_1">{{ facts_detail_1 }}</span></p>
  </div>

</div>

<div class="page">
  <div style="margin-bottom: 20px;">
    <p>POSTN-111014-21</p>
    <span data-field="page_number_top_2">{{ page_number_top_2 }}</span>
  </div>

  <div style="margin-bottom: 20px;">
    <p><span data-field="paragraph_3_text">{{ paragraph_3_text }}</span></p>
  </div>

  <div style="margin-bottom: 20px;">
    <p><span data-field="paragraph_4_text">{{ paragraph_4_text }}</span></p>
  </div>

  <div style="margin-top: 30px;">
    <div class="section-heading">LAW AND ANALYSIS</div>
    <p><span data-field="law_analysis_intro">{{ law_analysis_intro }}</span></p>
    <p><span data-field="law_analysis_detail_1">{{ law_analysis_detail_1 }}</span></p>
    <p><span data-field="law_analysis_detail_2">{{ law_analysis_detail_2 }}</span></p>
  </div>

</div>

<div class="page">
  <div style="margin-bottom: 20px;">
    <p>POSTN-111014-21</p>
    <span data-field="page_number_top_3">{{ page_number_top_3 }}</span>
  </div>

  <div style="margin-bottom: 20px;">
    <p><span data-field="paragraph_5_text">{{ paragraph_5_text }}</span></p>
  </div>

  <div style="margin-top: 30px;">
    <div class="section-heading">CASE DEVELOPMENT, HAZARDS AND OTHER CONSIDERATIONS</div>
    <div style="height: 200px; background-color: #f0f0f0; border: 1px solid #ccc; margin-top: 10px;">
      <!-- Placeholder for large block of text/diagram -->
    </div>
  </div>

  <div style="margin-top: 50px;">
    <p><span data-field="disclaimer_text">{{ disclaimer_text }}</span></p>
    <p>Please call <span data-field="contact_name">{{ contact_name }}</span> at (<span data-field="contact_area_code">{{ contact_area_code }}</span>) <span data-field="contact_number">{{ contact_number }}</span> if you have any further questions.</p>
  </div>
</div>

</body>
</html>