<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; }
  h1, h2 { text-align: center; font-weight: bold; }
  .form-row { display: flex; margin-bottom: 15px; align-items: center; }
  .form-row > div { flex: 1; }
  .label-group { display: flex; gap: 30px; margin-bottom: 20px; }
  .input-line { border-bottom: 1px solid #000; width: 100%; }
  .radio-group label { margin-right: 15px; }
</style>

<div class="page">
  <div style="text-align: center; margin-bottom: 40px;">
    <img src="" alt="Logo" style="width: 80px; height: auto; margin-bottom: 10px;">
    <h1 style="font-size: 18pt; margin: 0;">THE UNIVERSITY OF SOUTHERN MISSISSIPPI</h1>
    <h2 style="font-size: 14pt; margin: 5px 0;">VENDOR REGISTRATION</h2>
    <h3 style="font-size: 12pt; margin: 5px 0;">PURCHASING DEPARTMENT</h3>
  </div>

  <div style="margin-bottom: 30px;">
    <p style="font-weight: bold;">VENDOR NAME:</p>
    <div class="input-line" style="width: 80%;">
      <span data-field="vendor_name">{{ vendor_name }}</span>
    </div>
  </div>

  <div class="label-group">
    <div>
      <p style="font-weight: bold;">ADDRESS</p>
      <p style="font-weight: bold;">Ordering Address:</p>
      <div class="input-line" style="width: 100%;">
        <span data-field="address.street_line_1">{{ address.street_line_1 }}</span>
      </div>
      <div class="form-row" style="margin-top: 5px;">
        <div style="flex: 1;">City/Town: <span data-field="address.city">{{ address.city }}</span></div>
        <div style="flex: 1;">State: <span data-field="address.state">{{ address.state }}</span></div>
      </div>
      <div class="form-row" style="margin-top: 5px;">
        <div style="flex: 1;">Zip/Postal Code: <span data-field="address.zip_code">{{ address.zip_code }}</span></div>
        <div style="flex: 1;">Country: <span data-field="address.country">{{ address.country }}</span></div>
      </div>
    </div>

    <div>
      <p style="font-weight: bold;">TELEPHONE</p>
      <p style="font-weight: bold;">Telephone:</p>
      <div class="input-line" style="width: 100%;">
        <span data-field="phone.telephone">{{ phone.telephone }}</span>
      </div>
      <p style="font-weight: bold; margin-top: 15px;">Extension:</p>
      <div class="input-line" style="width: 100%;">
        <span data-field="phone.extension">{{ phone.extension }}</span>
      </div>
      <p style="font-weight: bold; margin-top: 15px;">Fax:</p>
      <div class="input-line" style="width: 100%;">
        <span data-field="phone.fax">{{ phone.fax }}</span>
      </div>
    </div>
  </div>

  <div style="margin-bottom: 30px;">
    <p style="font-weight: bold;">Remit to Address:</p>
    <div class="input-line" style="width: 100%;">
      <span data-field="remit_address.street_line_1">{{ remit_address.street_line_1 }}</span>
    </div>
    <div class="form-row" style="margin-top: 5px;">
      <div style="flex: 1;">City/Town: <span data-field="remit_address.city">{{ remit_address.city }}</span></div>
      <div style="flex: 1;">State: <span data-field="remit_address.state">{{ remit_address.state }}</span></div>
    </div>
    <div class="form-row" style="margin-top: 5px;">
      <div style="flex: 1;">Zip/Postal Code: <span data-field="remit_address.zip_code">{{ remit_address.zip_code }}</span></div>
      <div style="flex: 1;">Country: <span data-field="remit_address.country">{{ remit_address.country }}</span></div>
    </div>
  </div>

  <div style="margin-bottom: 30px;">
    <p style="font-weight: bold;">Federal Tax ID#:</p>
    <div class="input-line" style="width: 40%;">
      <span data-field="tax_id">{{ tax_id }}</span>
    </div>
    <p style="font-weight: bold; margin-top: 20px;">Type of TIN:</p>
    <div class="radio-group" style="margin-top: 10px;">
      <label><input type="radio" name="tin_type" value="individual"> Individual</label>
      <label><input type="radio" name="tin_type" value="corporation"> Corporation</label>
      <label><input type="radio" name="tin_type" value="other"> Other</label>
    </div>
    <div class="form-row" style="margin-top: 15px;">
      <div style="flex: 1;">Federal ID#: <div class="input-line" style="width: 100%;"><span data-field="tin_federal_id">{{ tin_federal_id }}</span></div></div>
      <div style="flex: 1;">SS ID#: <div class="input-line" style="width: 100%;"><span data-field="tin_ss_id">{{ tin_ss_id }}</span></div></div>
    </div>
  </div>

  <div style="margin-bottom: 30px;">
    <p style="font-weight: bold;">VENDOR TYPE</p>
    <div class="radio-group" style="margin-top: 10px;">
      <label><input type="radio" name="vendor_type" value="small_business"> Small Business</label>
      <label><input type="radio" name="vendor_type" value="small_disadvantaged_business"> Small Disadvantaged Business</label>
      <label><input type="radio" name="vendor_type" value="small_disabled_veteran_business"> Small Disabled Veteran Business</label>
      <br>
      <label><input type="radio" name="vendor_type" value="small_minority_owned_business"> Small Minority-Owned Business</label>
      <label><input type="radio" name="vendor_type" value="woman_owned_small_business"> Woman-owned Small Business</label>
      <label><input type="radio" name="vendor_type" value="large_business"> Large Business</label>
      <br>
      <label><input type="radio" name="vendor_type" value="hub_zone_small_business"> Hub-Zone Small Business</label>
      <label><input type="radio" name="vendor_type" value="non_profit_business"> Non-Profit Business</label>
      <label><input type="radio" name="vendor_type" value="government_business"> Government Business</label>
      <br>
      <label><input type="radio" name="vendor_type" value="foreign_owned_business"> Foreign-Owned Business</label>
      <label><input type="radio" name="vendor_type" value="other"> Other</label>
    </div>
  </div>

  <div style="margin-bottom: 30px;">
    <h3 style="text-align: center; margin-bottom: 10px;">1099 and 1042 Information</h3>
    <p style="text-align: center; font-size: 10pt;">(Substitute Form W-9)</p>
  </div>

  <div style="margin-bottom: 30px;">
    <p style="font-weight: bold;">Name:</p>
    <div class="input-line" style="width: 80%;">
      <span data-field="name">{{ name }}</span>
    </div>
  </div>

  <div style="margin-bottom: 30px;">
    <p style="font-weight: bold;">Residence:</p>
    <div class="input-line" style="width: 80%;">
      <span data-field="residence_address.street_line_1">{{ residence_address.street_line_1 }}</span>
    </div>
  </div>

  <div class="label-group">
    <div>
      <p style="font-weight: bold;">City/Town:</p>
      <div class="input-line" style="width: 50%;">
        <span data-field="residence_address.city">{{ residence_address.city }}</span>
      </div>
      <p style="font-weight: bold;">Zip/Postal Code:</p>
      <div class="input-line" style="width: 50%;">
        <span data-field="residence_address.zip_code">{{ residence_address.zip_code }}</span>
      </div>
    </div>
    <div>
      <p style="font-weight: bold;">State:</p>
      <div class="input-line" style="width: 50%;">
        <span data-field="residence_address.state">{{ residence_address.state }}</span>
      </div>
      <p style="font-weight: bold;">Country:</p>
      <div class="input-line" style="width: 50%;">
        <span data-field="residence_address.country">{{ residence_address.country }}</span>
      </div>
    </div>
  </div>

  <div style="margin-top: 50px;">
    <p style="font-weight: bold;">TYPE OF PRODUCTS OR SERVICES THAT YOU ARE INTERESTED IN PROVIDING TO THE UNIVERSITY:</p>
    <div class="input-line" style="width: 100%; margin-top: 10px;">
      <span data-field="products_services_description">{{ products_services_description }}</span>
    </div>
  </div>

  <div style="margin-top: 100px; text-align: left;">
    <p style="font-weight: bold;">THE UNIVERSITY OF SOUTHERN MISSISSIPPI</p>
    <p>P. O. BOX 5003</p>
    <p><span data-field="university_address.city">{{ university_address.city }}</span>, <span data-field="university_address.state">{{ university_address.state }}</span> <span data-field="university_address.zip_code">{{ university_address.zip_code }}</span></p>
    <p>PHONE: <span data-field="university_phone">{{ university_phone }}</span></p>
    <p>FAX: <span data-field="university_fax">{{ university_fax }}</span></p>
  </div>
</div>