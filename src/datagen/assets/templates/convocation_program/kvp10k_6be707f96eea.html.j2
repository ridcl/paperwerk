<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  h1, h2, h3, h4, h5, h6 {
    margin-top: 0;
    margin-bottom: 0.5em;
    font-weight: bold;
  }
  .header-title {
    font-size: 24pt;
    font-weight: bold;
  }
  .sub-header {
    font-size: 14pt;
    margin-bottom: 10px;
  }
  .section-title {
    font-size: 14pt;
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
  }
  .divider {
    border-top: 1px solid #000;
    margin: 20px 0;
  }
  .signature-block {
    margin-top: 40px;
  }
  .signature-line {
    margin-bottom: 5px;
  }
  .centered-text {
    text-align: center;
  }
  .two-column {
    display: flex;
    justify-content: space-between;
    margin-bottom: 20px;
  }
  .two-column > div {
    width: 48%;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
  }
  td {
    padding: 5px 0;
    vertical-align: top;
  }
  .small-text {
    font-size: 10pt;
    line-height: 1.4;
  }
</style>

<div class="page">
  <div class="centered-text">
    <span class="header-title">Lindenwood University</span>
    <div class="sub-header">
      Digital Commons@<span data-field="university_domain">{{ university_domain }}</span>
    </div>
  </div>
  <div class="divider"></div>
  <div class="two-column">
    <div>
      <span class="sub-header">Honors Convocation Programs</span>
    </div>
    <div>
      <span class="sub-header">Lindenwood Historic Documents</span>
    </div>
  </div>
  <div class="centered-text" style="margin-top: 20px;">
    <span data-field="date_of_document">{{ date_of_document }}</span>
  </div>
  <div class="centered-text" style="margin-top: 10px;">
    <span data-field="convocation_title">{{ convocation_title }}</span>
  </div>
  <div class="centered-text" style="margin-top: 10px;">
    <span data-field="university_name_footer">{{ university_name_footer }}</span>
  </div>
  <div style="margin-top: 50px;">
    <div class="small-text">
      Follow this and additional works at: <a href="http://digitalcommons.lindenwood.edu/honors-convo"><span data-field="digital_commons_url">{{ digital_commons_url }}</span></a>
    </div>
    <div class="small-text" style="margin-top: 10px;">
      Part of the <span data-field="history_commons_name">{{ history_commons_name }}</span>
    </div>
  </div>
</div>

<div class="page">
  <div class="centered-text">
    <span class="header-title">Lindenwood University</span>
    <div class="centered-text" style="font-size: 60pt; margin-top: 10px;">HONORS</div>
    <div class="centered-text" style="font-size: 30pt; margin-top: -20px;">Convocation</div>
  </div>
  <div style="margin-top: 50px;">
    <div class="small-text">
      <span data-field="award_list">
        {% for award in award_list %}
          <div style="margin-bottom: 5px;">{{ award }}</div>
        {% endfor %}
      </span>
    </div>
  </div>
</div>

<div class="page">
  <div class="centered-text">
    <span class="section-title">{{ award_list">
        {% for award in award_list %}
          <div style="margin-bottom: 5px;">award</div>
        {% endfor %}
      </span>
    </div>
  </div>
</div>

<div class="page">
  <div class="centered-text">
    <span class= }}</span>
  </div>
  <div class="two-column" style="margin-top: 30px;">
    <div>
      <div class="small-text">Welcome</div>
      <div class="small-text" style="margin-top: 10px;">Invocation</div>
      <div class="small-text" style="margin-top: 10px;">Remarks</div>
      <div class="small-text" style="margin-top: 10px;">Presentation of University Honors & Awards</div>
      <div class="small-text" style="margin-top: 10px;">Benediction</div>
    </div>
    <div>
      <div class="small-text">Vice President <span data-field="vp_name">{{ vp_name }}</span></div>
      <div class="small-text" style="margin-top: 10px;">Timothy Butler, University Chaplain</div>
      <div class="small-text" style="margin-top: 10px;">President <span data-field="president_name">{{ president_name }}</span></div>
      <div class="small-text" style="margin-top: 10px;">Faculty, Staff Alumni & Friends</div>
      <div class="small-text" style="margin-top: 10px;">Timothy Butler</div>
    </div>
  </div>
  <div class="small-text" style="margin-top: 30px;">
    <div class="centered-text">
      *Presentation of Honors and Awards by Academic Schools
    </div>
    <div class="small-text" style="margin-top: 5px;">
      *Please note: After the presentation of University Honors and Awards, attendees will be directed to individual spaces in the J. Scheidegger Center for the Arts for presentation of individual academic school awards.
    </div>
  </div>
  <div class="centered-text" style="margin-top: 30px;">
    Piano accompaniment by Dr. <span data-field="accompanist_name">{{ accompanist_name }}</span>
  </div>
  <div class="centered-text" style="margin-top: 30px;">
    Lindenwood Mission Statement
  </div>
  <div class="small-text" style="margin-top: 15px;">
    Lindenwood University offers values-centered programs leading to the development of the whole person—an educated, responsible citizen of a global community.
    <div style="margin-top: 10px;">
      Lindenwood is committed to
      <ul style="list-style-type: disc; padding-left: 20px;">
        <li>providing an integrative liberal arts curriculum,</li>
        <li>offering professional and pre-professional degree programs,</li>
        <li>focusing on the talents, interests, and future of the student,</li>
        <li>supporting academic freedom and the unrestricted search for truth,</li>
        <li>affording cultural enrichment to the surrounding community,</li>
        <li>promoting ethical lifestyles,</li>
        <li>developing adaptive thinking and problem-solving skills,</li>
        <li>furthering lifelong learning.</li>
      </ul>
    </div>
    <div style="margin-top: 15px;">
      Lindenwood is an independent, public-serving liberal arts university that has a historical relationship with the Presbyterian Church and is firmly rooted in Judeo-Christian values. These values include belief in an ordered, purposeful universe, the dignity of work, the worth and integrity of the individual, the obligations and privileges of citizenship, and the primacy of the truth.
    </div>
  </div>
  <div class="centered-text" style="margin-top: 50px;">
    3
  </div>
</div>

<div class="page">
  <div class="centered-text">
    <span class="section-title">RECOGNITION</span>
  </div>
  <div class="small-text" style="margin-top: 10px;">
    Alpha Chi presented by Dr. <span data-field="alpha_chi_presenter">{{ alpha_chi_presenter }}</span>
    <div style="margin-top: 5px;">
      Alpha Chi is a national college honor society that admits students from all academic disciplines. Membership is limited to the top 10 percent of an institution's juniors, seniors, and graduate students.
    </div>
  </div>
  <div class="two-column" style="margin-top: 20px;">
    <div>
      <div class="small-text">2013 Initiates</div>
      <div class="small-text" style="margin-top: 5px;">
        {% for initiate in alpha_chi_initiates %}
          <div style="margin-bottom: 3px;">{{ initiate }}</div>
        {% endfor %}
      </div>
    </div>
    <div>
      <div class="small-text">2013 Initiates</div>
      <div class="small-text" style="margin-top: 5px;">
        {% for initiate in alpha_chi_initiates_right %}
          <div style="margin-bottom: 3px;">{{ initiate }}</div>
        {% endfor %}
      </div>
    </div>
  </div>
  <div class="small-text" style="margin-top: 30px;">
    Alpha Lambda Delta presented by Dr. <span data-field="alpha_lambda_delta_presenter">{{ alpha_lambda_delta_presenter }}</span>
    <div style="margin-top: 5px;">
      Alpha Lambda Delta is the national scholarship honor society for first-year students. Alpha Lambda Delta has recognized superior academic performance among entering students since its inception at the University of Illinois in 1924. Lindenwood's chapter has been active since 1949.
    </div>
  </div>
  <div class="two-column" style="margin-top: 20px;">
    <div>
      <div class="small-text">2013 Initiates</div>
      <div class="small-text" style="margin-top: 5px;">
        {% for initiate in alpha_lambda_delta_initiates %}
          <div style="margin-bottom: 3px;">{{ initiate }}</div>
        {% endfor %}
      </div>
    </div>
    <div>
      <div class="small-text">2013 Initiates</div>
      <div class="small-text" style="margin-top: 5px;">
        {% for initiate in alpha_lambda_delta_initiates_right %}
          <div style="margin-bottom: 3px;">{{ initiate }}</div>
        {% endfor %}
      </div>
    </div>
  </div>
  <div class="small-text" style="margin-top: 30px;">
    Alpha Sigma Lambda presented by Dr. <span data-field="alpha_sigma_lambda_presenter">{{ alpha_sigma_lambda_presenter }}</span>
    <div style="margin-top: 5px;">
      Alpha Sigma Lambda National Honor Society recognizes those senior students in the adult evening programs who have achieved academic excellence while handling other life responsibilities, including family, work, and community service. Nominees must have completed 84 credit hours at Lindenwood University and maintained a 3.8 cumulative grade point average.
    </div>
  </div>
  <div class="two-column" style="margin-top: 20px;">
    <div>
      <div class="small-text">2013 Initiates</div>
      <div class="small-text" style="margin-top: 5px;">
        {% for initiate in alpha_sigma_lambda_initiates %}
          <div style="margin-bottom: 3px;">{{ initiate }}</div>
        {% endfor %}
      </div>
    </div>
    <div>
      <div class="small-text">2013 Initiates</div>
      <div class="small-text" style="margin-top: 5px;">
        {% for initiate in alpha_sigma_lambda_initiates_right %}
          <div style="margin-bottom: 3px;">{{ initiate }}</div>
        {% endfor %}
      </div>
    </div>
  </div>
  <div class="small-text" style="margin-top: 30px;">
    Chi Sigma Iota presented by Dr. <span data-field="chi_sigma_iota_presenter">{{ chi_sigma_iota_presenter }}</span>
    <div style="margin-top: 5px;">
      The Lindenwood chapter (Lambda Chi) of Chi Sigma Iota was founded in 1996. It is an international honor society of counseling professionals and pre-professionals in training dedicated to excellence in scholarship, research, and clinical practice. Graduate counseling students with a grade point average of 3.5 or higher are invited to membership.
    </div>
  </div>
  <div class="two-column" style="margin-top: 20px;">
    <div>
      <div class="small-text">2013 Candidates</div>
      <div class="small-text" style="margin-top: 5px;">
        {% for candidate in chi_sigma_iota_candidates %}
          <div style="margin-bottom: 3px;">{{ candidate }}</div>
        {% endfor %}
      </div>
    </div>
    <div>
      <div class="small-text">2013 Candidates</div>
      <div class="small-text" style="margin-top: 5px;">
        {% for candidate in chi_sigma_iota_candidates_right %}
          <div style="margin-bottom: 3px;">{{ candidate }}</div>
        {% endfor %}
      </div>
    </div>
  </div>
  <div class="centered-text" style="margin-top: 50px;">
    6
  </div>
</div>

<div class="page">
  <div class="small-text" style="margin-top: 10px;">
    Delta Mu Delta presented by Dr. <span data-field="delta_mu_delta_presenter">{{ delta_mu_delta_presenter }}</span>
    <div style="margin-top: 5px;">
      Delta Mu Delta is an international honor society for outstanding students of business majors at the undergraduate and graduate levels. Its purpose is to reward scholastic achievement and advance scholarship, ethics, and professionalism in all business disciplines. This year, the School of Business and Entrepreneurship inducted the following members:
