<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  /* Basic styling to mimic document structure */
  h1, h2 {
    font-weight: bold;
  }
  .form-section {
    margin-bottom: 20px;
  }
  .field-row {
    display: flex;
    margin-bottom: 10px;
  }
  .field-row > div {
    flex: 1;
  }
  .label {
    font-weight: normal;
  }
  .input-area {
    border-bottom: 1px solid #000;
    display: inline-block;
    width: 100%;
  }
</style>

<div class="page">
  <div style="text-align: center; margin-bottom: 40px;">
    <div style="font-size: 24px; font-weight: bold;">HUSSON</div>
    <div style="font-size: 14px;">UNIVERSITY</div>
    <div style="font-size: 24px; font-weight: bold;">STUDENT</div>
    <div style="font-size: 14px;">HEALTH SERVICES</div>
  </div>

  <h2 style="text-align: center; margin-bottom: 30px;">Release of Vaccine Records Request Form</h2>

  <p style="margin-bottom: 20px;">In order to receive copies of your immunization records please complete this form and fax to <span data-field="fax_number">{{ fax_number }}</span>.</p>
  <p style="margin-bottom: 30px;">Please allow <span data-field="processing_time">{{ processing_time }}</span> business days to fulfill this request.</p>

  <div class="form-section">
    <h3 style="font-weight: bold;">Your Information:</h3>
    <div class="field-row">
      <div style="width: 30%;">
        <span class="label">Last Name:</span>
        <div class="input-area"><span data-field="full_name_last">{{ full_name_last }}</span></div>
      </div>
      <div style="width: 70%;">
        <span class="label">First Name:</span>
        <div class="input-area"><span data-field="full_name_first">{{ full_name_first }}</span></div>
      </div>
    </div>

    <div class="field-row">
      <div style="width: 30%;">
        <span class="label">Date of Birth:</span>
        <div class="input-area"><span data-field="date_of_birth">{{ date_of_birth }}</span></div>
      </div>
      <div style="width: 70%;">
        <span class="label">Student ID#:</span>
        <div class="input-area"><span data-field="student_id">{{ student_id }}</span></div>
      </div>
    </div>

    <div class="field-row">
      <div style="width: 30%;">
        <span class="label">Campus:</span>
        <div class="input-area"><span data-field="campus_name">{{ campus_name }}</span></div>
      </div>
      <div style="width: 70%;">
        <span class="label">Last Date of Attendance:</span>
        <div class="input-area"><span data-field="last_attendance_date">{{ last_attendance_date }}</span></div>
      </div>
    </div>

    <div class="field-row">
      <div style="width: 30%;">
        <span class="label">Telephone #:</span>
        <div class="input-area"><span data-field="phone_number">{{ phone_number }}</span></div>
      </div>
      <div style="width: 70%;">
        <span class="label">Email:</span>
        <div class="input-area"><span data-field="email_address">{{ email_address }}</span></div>
      </div>
    </div>

    <div class="field-row">
      <div style="width: 30%;">
        <span class="label">Address:</span>
        <div class="input-area"><span data-field="mailing_address">{{ mailing_address }}</span></div>
      </div>
      <div style="width: 70%;">
        <span class="label">City:</span>
        <div class="input-area"><span data-field="city">{{ city }}</span></div>
        <span class="label" style="margin-left: 20px;">State:</span>
        <div class="input-area" style="width: 30%; display: inline-block;"><span data-field="state">{{ state }}</span></div>
        <span class="label" style="margin-left: 10px;">Zip:</span>
        <div class="input-area" style="width: 30%; display: inline-block;"><span data-field="zip_code">{{ zip_code }}</span></div>
      </div>
    </div>
  </div>

  <div class="form-section">
    <h3 style="font-weight: bold;">Please check all that apply:</h3>
    <div style="margin-left: 20px;">
      <input type="checkbox" style="margin-right: 5px;"> I will pick up my records in person.
    </div>
    <div style="margin-left: 20px;">
      <input type="checkbox" style="margin-right: 5px;"> Please mail a copy of my immunization records to my address listed above.
    </div>
    <div style="margin-left: 20px;">
      <input type="checkbox" style="margin-right: 5px;"> Please fax a copy of my immunization records to: <div class="input-area" style="width: 50%;" data-field="field_1">{{ field_1 }}</div>
    </div>
    <div style="margin-left: 20px;">
      <input type="checkbox" style="margin-right: 5px;"> Please forward a copy of my immunization records to: <div class="input-area" style="width: 50%;" data-field="field_2">{{ field_2 }}</div>
    </div>
    <div style="margin-left: 20px;">
      <span class="label">Attn:</span>
      <div class="input-area" style="width: 50%;" data-field="attn">{{ attn }}</div>
    </div>
  </div>

  <div class="form-section" style="margin-top: 50px;">
    <div class="field-row" style="justify-content: space-between;">
      <div style="width: 50%;">
        <span class="label">Student Signature:</span>
        <div class="input-area" style="height: 30px;" data-field="student_signature">{{ student_signature }}</div>
      </div>
      <div style="width: 50%;">
        <span class="label">Date:</span>
        <div class="input-area" style="height: 30px;" data-field="date">{{ date }}</div>
      </div>
    </div>
  </div>

  <p style="text-align: center; margin-top: 40px; font-weight: bold;">Please note: this form is not valid without a signature and date.</p>

  <div style="margin-top: 80px; display: flex; justify-content: space-between;">
    <div style="width: 30%;">
      <span class="label">Request Received:</span>
      <div class="input-area" style="height: 20px;" data-field="request_received">{{ request_received }}</div>
    </div>
    <div style="width: 30%;">
      <span class="label">Office Use Only:</span>
      <div class="input-area" style="height: 20px;" data-field="office_use_only">{{ office_use_only }}</div>
    </div>
    <div style="width: 30%;">
      <span class="label">Initials:</span>
      <div class="input-area" style="height: 20px;" data-field="initials">{{ initials }}</div>
    </div>
  </div>

  <div style="text-align: center; margin-top: 100px; font-size: 10px; color: #555;">
    <span data-field="footer_address">{{ footer_address }}</span> |
    <span data-field="footer_phone">{{ footer_phone }}</span> |
    <span data-field="footer_website">{{ footer_website }}</span>
  </div>
</div>