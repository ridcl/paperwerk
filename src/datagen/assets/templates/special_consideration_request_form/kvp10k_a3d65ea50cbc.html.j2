    </div>
    <div>
      <span class="form-label">Today's Date</span>
      <div style="border-bottom: 1px solid black; height: 30px; margin-top: 5px;" data-field="today_s_date">{{ today_s_date }}</div>
    </div>
  </div>

  <div style="margin-top: 30px;">
    <span class="form-label">Spouse or Parent Hand-Signature (if Dependent)</span>
    <div style="border-bottom: 1px solid black; height: 30px; margin-top: 5px;" data-field="spouse_or_parent_hand_signature">{{ spouse_or_parent_hand_signature }}</div>
    <span class="form-label" style="margin-left: 30px;">Today's Date</span>
    <div style="border-bottom: 1px solid black; height: 30px; margin-top: 5px;" data-field="today_s_date_2">{{ today_s_date_2 }}</div>
