<!DOCTYPE html>
<html>
<head>
<title>Holiday Wreath Sale Order Form</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2 { font-weight: bold; }
  .form-section { margin-bottom: 20px; }
  .input-row { display: flex; margin-bottom: 10px; }
  .input-row label { width: 100px; }
  .input-row input[type="text"], .input-row select { flex-grow: 1; border-bottom: 1px solid #000; }
  .checkbox-group { margin-top: 10px; }
  .checkbox-group label { display: block; margin-bottom: 5px; }
  .divider { border-top: 1px solid #000; margin: 20px 0; }
  .table-container { width: 100%; border-collapse: collapse; margin-top: 15px; }
  .table-container th, .table-container td { border: 1px solid #000; padding: 8px; text-align: left; }
  .table-container th { background-color: #f0f0f0; }
</style>
</head>
<body>
<div class="page">
  <div style="text-align: center; margin-bottom: 30px;">
    <h1 style="font-size: 24pt;">MSU HOLIDAY WREATH SALE</h1>
  </div>
  <div style="font-size: 10pt; margin-bottom: 20px;">
    Back by popular demand! Now is your chance to pre-order a Holiday Wreath! Please complete this form and return with payment in full to <span data-field="department.name">{{ department.name }}</span> by one of the two deadlines listed below. The MSU Office is located in the MSSP office and anyone at the front desk can assist you. Exact amounts would be greatly appreciated since we may not have change.
    <br><br>
    Please see link on e-mail for pictures! <a href="http://www.wou.edu/msu/">http://www.wou.edu/msu/</a>
  </div>

  <div style="text-align: center; margin: 30px 0;">
    <div style="font-size: 12pt; font-weight: bold;">ORDER FORM</div>
  </div>

  <div class="form-section">
    <div class="input-row">
      <label>Name:</label>
      <span data-field="full_name" style="flex-grow: 1; border-bottom: 1px solid #000;">{{ full_name }}</span>
    </div>
    <div class="input-row">
      <label>E-mail:</label>
      <span data-field="email" style="flex-grow: 1; border-bottom: 1px solid #000;">{{ email }}</span>
    </div>
    <div class="input-row">
      <label>Phone:</label>
      <span data-field="phone" style="flex-grow: 1; border-bottom: 1px solid #000;">{{ phone }}</span>
    </div>
  </div>

  <div class="form-section">
    <p style="font-weight: bold;">Please note: Wreaths start at 10 inches; this indicates the size of the ring, making the actual wreath much larger.</p>
    <div class="checkbox-group">
      <label><input type="checkbox"> Holiday Wreath</label>
      <div style="margin-left: 20px;">
        <label><input type="checkbox"> 10inches/$20</label>
        <label><input type="checkbox"> 12inches/$22</label>
        <label><input type="checkbox"> 14inches/$24</label>
        <label><input type="checkbox"> 16inches/$26</label>
        <label><input type="checkbox"> 18inches/$28</label>
        <label><input type="checkbox"> 20inches/$30</label>
        <label><input type="checkbox"> 22inches/$32</label>
        <label><input type="checkbox"> 24inches/$34</label>
        <label><input type="checkbox"> 26inches/$36</label>
      </div>
    </div>
  </div>

  <div class="form-section" style="display: flex; justify-content: space-between;">
    <div style="width: 48%;">
      <p style="font-weight: bold;">Noble Garland ($2 per foot)</p>
      <table class="table-container">
        <thead>
          <tr>
            <th style="width: 30%;"># of Ft.</th>
            <th style="width: 30%;">Total</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><span data-field="garland_feet">{{ garland_feet }}</span></td>
            <td><span data-field="garland_total">{{ garland_total }}</span></td>
          </tr>
        </tbody>
      </table>
      <p style="font-size: 9pt; margin-top: 10px;">(Freshly made)</p>
    </div>
    <div style="width: 48%;">
      <p style="font-weight: bold;">Pick Up Date (Choose One):</p>
      <div class="checkbox-group">
        <label><input type="checkbox"> I will pick up my wreath on: Monday, <span data-field="pickup_date_1">{{ pickup_date_1 }}</span></label>
        <label><input type="checkbox"> Deadline for this order: Tuesday, <span data-field="deadline_1">{{ deadline_1 }}</span></label>
        <br>
        <label><input type="checkbox"> I will pick up my wreath on: Monday, <span data-field="pickup_date_2">{{ pickup_date_2 }}</span></label>
        <label><input type="checkbox"> Deadline for this order: Tuesday, <span data-field="deadline_2">{{ deadline_2 }}</span></label>
      </div>
      <p style="font-weight: bold; margin-top: 20px;">*NOTE: Checks will not be cashed until delivery date.</p>
      <p style="font-weight: bold;">* Please Note: Larger wreath sizes available upon request.*</p>
    </div>
  </div>

  <div class="divider"></div>

  <div class="form-section">
    <h2 style="text-align: center;">Special Styles</h2>
    <table class="table-container">
      <thead>
        <tr>
          <th style="width: 50%;">Item</th>
          <th style="width: 50%;">Price</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>SM Candy Cane (16-18in)</td>
          <td>x $28 Total: <span data-field="special_styles.sm_candy_cane_price">{{ special_styles.sm_candy_cane_price }}</span></td>
        </tr>
        <tr>
          <td>LG Candy Cane (22in)</td>
          <td>x $32 Total: <span data-field="special_styles.lg_candy_cane_price">{{ special_styles.lg_candy_cane_price }}</span></td>
        </tr>
        <tr>
          <td>SM Cross (16-18in)</td>
          <td>x $28 Total: <span data-field="special_styles.sm_cross_price">{{ special_styles.sm_cross_price }}</span></td>
        </tr>
        <tr>
          <td>LG Cross (24in)</td>
          <td>x $32 Total: <span data-field="special_styles.lg_cross_price">{{ special_styles.lg_cross_price }}</span></td>
        </tr>
        <tr>
          <td>Snowflake (24in)</td>
          <td>x $32 Total: <span data-field="special_styles.snowflake_price">{{ special_styles.snowflake_price }}</span></td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="divider"></div>

  <div class="form-section" style="display: flex; justify-content: space-between;">
    <div style="width: 48%;">
      <p>Total Wreaths Ordered: <span data-field="total_wreaths">{{ total_wreaths }}</span></p>
      <p>Total Amount Due: $ <span data-field="total_amount_due">{{ total_amount_due }}</span></p>
      <p>Sold By: <span data-field="sold_by">{{ sold_by }}</span></p>
    </div>
    <div style="width: 48%; text-align: right;">
      <p>Cash <span data-field="payment_method_cash">{{ payment_method_cash }}</span> Check # <span data-field="payment_method_check">{{ payment_method_check }}</span></p>
      <p>Date: <span data-field="order_date">{{ order_date }}</span></p>
    </div>
  </div>

  <div style="text-align: center; margin-top: 40px;">
    <p style="font-size: 12pt; font-weight: bold;">Thank you for your support!</p>
  </div>

  <div style="font-size: 9pt; margin-top: 30px; text-align: center;">
    Please make checks payable to: <span data-field="payable_entity">{{ payable_entity }}</span>. Phone#: <span data-field="phone_contact">{{ phone_contact }}</span> Fax#: <span data-field="fax_contact">{{ fax_contact }}</span> <span data-field="email_contact">{{ email_contact }}</span>
  </div>
</div>
</body>
</html>