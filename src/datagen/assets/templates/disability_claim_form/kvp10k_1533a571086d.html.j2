<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Long Term Disability Claim Form</title>
<style>
  @page { size: A4; margin: 0; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: "Liberation Sans", "DejaVu Sans", Arial, Helvetica, sans-serif; font-size: 9px; color: #000; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }

  /* Header */
  .header-row { display: flex; align-items: flex-start; margin-bottom: 8px; }
  .logo-box { width: 110px; flex-shrink: 0; }
  .logo-box .logo-text { font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; font-size: 22px; font-weight: bold; color: #1a3a6b; line-height: 1; }
  .logo-box .logo-sub { font-size: 8px; color: #1a3a6b; }
  .logo-box .logo-icon { font-size: 28px; color: #1a3a6b; font-weight: bold; }
  .header-title { flex: 1; text-align: center; }
  .header-title h1 { font-size: 15px; font-weight: bold; font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; }
  .header-contact { text-align: right; font-size: 8px; line-height: 1.5; }
  .header-contact .company-name { font-weight: bold; font-size: 9px; }

  /* Dividers */
  .thick-divider { border: none; border-top: 3px solid #000; margin: 4px 0; }
  .thin-divider { border: none; border-top: 1px solid #000; margin: 3px 0; }

  /* Section headings */
  .section-heading { font-weight: bold; font-size: 10px; margin: 5px 0 4px 0; }

  /* Form rows */
  .form-row { display: flex; align-items: baseline; margin-bottom: 5px; gap: 8px; }
  .form-label { white-space: nowrap; font-size: 9px; }
  .form-underline { border-bottom: 1px solid #000; flex: 1; min-width: 40px; height: 14px; display: inline-block; }
  .form-underline-fixed { border-bottom: 1px solid #000; display: inline-block; height: 14px; }

  /* Checkbox */
  .checkbox-item { display: inline-flex; align-items: center; gap: 3px; margin-right: 8px; font-size: 9px; }
  .checkbox-box { width: 10px; height: 10px; border: 1px solid #000; display: inline-block; }

  /* Income table */
  .income-table { width: 100%; border-collapse: collapse; margin: 4px 0; }
  .income-table th { font-size: 9px; font-weight: normal; text-align: center; padding: 2px 4px; }
  .income-table td { font-size: 9px; padding: 2px 4px; }
  .income-table td.label-col { width: 130px; }
  .income-table td.value-col { border-bottom: 1px solid #000; text-align: center; min-width: 100px; }

  /* Footer */
  .page-footer { position: absolute; bottom: 20px; left: 60px; right: 60px; font-size: 7.5px; }
  .page-footer-center { text-align: center; }
  .page-footer-row { display: flex; justify-content: space-between; }

  /* Signature row */
  .sig-row { display: flex; align-items: baseline; gap: 20px; margin-top: 8px; }
  .sig-label { font-weight: bold; font-size: 9px; white-space: nowrap; }
  .sig-line { border-bottom: 1px solid #000; flex: 1; height: 14px; }

  /* Italic note */
  .italic-note { font-style: italic; font-size: 8px; margin-top: 3px; }

  /* Page 2 */
  .questionnaire-heading { font-size: 14px; font-weight: bold; font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; margin-bottom: 6px; }
  .q-instructions { font-weight: bold; font-size: 9px; margin-bottom: 8px; margin-left: 20px; }
  .q-item { display: flex; gap: 8px; margin-bottom: 8px; }
  .q-num { font-weight: bold; min-width: 16px; font-size: 9px; }
  .q-text { font-size: 9px; flex: 1; }
  .q-answer-line { border-bottom: 1px solid #000; width: 100%; height: 14px; display: block; margin-top: 4px; }
  .q-bold-note { font-weight: bold; font-size: 9px; margin: 6px 0 6px 20px; }
  .responsible-party { margin-left: 30px; }
  .rp-item { display: flex; align-items: baseline; gap: 6px; margin-bottom: 5px; font-size: 9px; }
  .rp-label { white-space: nowrap; }
  .rp-line { border-bottom: 1px solid #000; flex: 1; height: 14px; }

  /* Page 3 employer */
  .two-col { display: flex; gap: 10px; }
  .two-col .col { flex: 1; }

  /* Page 4 physician */
  .activity-table { width: 100%; border: 1px solid #000; border-collapse: collapse; margin: 6px 0; }
  .activity-table th, .activity-table td { border: 1px solid #000; padding: 3px 5px; font-size: 8.5px; }
  .activity-table .header-row-t { background: #fff; }
  .activity-table .underline-cell { border-bottom: 1px solid #555; }

  /* Limitations box */
  .limits-box { border: 1px solid #000; padding: 5px 8px; margin: 5px 0; font-size: 8.5px; }
  .limits-box .limits-header { font-weight: bold; margin-bottom: 3px; }

  /* Activities of daily living */
  .adl-row { display: flex; gap: 10px; margin-bottom: 5px; }
  .adl-item { display: flex; align-items: baseline; gap: 4px; font-size: 9px; flex: 1; }
  .adl-line { border-bottom: 1px solid #000; flex: 1; height: 14px; }

  /* Page 7 auth */
  .auth-numbered { margin-bottom: 6px; }
  .auth-numbered .auth-num { font-weight: bold; }
  .auth-body { font-size: 8.5px; line-height: 1.5; }
  .bullet-list { list-style: disc; margin-left: 20px; font-size: 8.5px; line-height: 1.6; }

  /* Page 8 fraud */
  .fraud-body { font-size: 8.5px; line-height: 1.55; }
  .fraud-state { font-weight: bold; }

  /* Textarea-like fields */
  .text-area-lines { border-bottom: 1px solid #000; width: 100%; height: 14px; display: block; margin-top: 3px; }
  .text-area-lines + .text-area-lines { margin-top: 4px; }

  .bold-warning { font-weight: bold; font-size: 9px; line-height: 1.5; margin: 8px 0; }
  .ny-warning { font-size: 9px; line-height: 1.5; margin: 6px 0; }
  .ny-warning strong { font-weight: bold; }

  .logo-wrapper { display: flex; align-items: center; gap: 4px; }
  .logo-bracket { font-size: 36px; font-weight: bold; color: #1a3a6b; line-height: 1; }
  .logo-words { display: flex; flex-direction: column; }
  .logo-lincoln { font-size: 20px; font-weight: bold; color: #1a3a6b; font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; line-height: 1; }
  .logo-financial { font-size: 9px; color: #1a3a6b; }
  .logo-group { font-size: 9px; color: #1a3a6b; }
</style>

<style>
  @page { size: A4; margin: 0; }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
    font-size: 13px;
    color: #000;
  }

  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
  }

  .page:last-child {
    page-break-after: auto;
  }

  .content {
    text-align: justify;
    line-height: 1.5;
  }

  .notice-block {
    margin-bottom: 10px;
  }

  .notice-block p {
    text-align: justify;
    line-height: 1.5;
  }

  .state-label {
    font-weight: bold;
  }

  .footer {
    position: absolute;
    bottom: 30px;
    left: 60px;
    right: 60px;
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    font-family: "Liberation Sans", "DejaVu Sans", Arial, Helvetica, sans-serif;
  }

  .footer-left {
    text-align: left;
  }

  .footer-right {
    text-align: right;
  }
</style>
</head>
<body>

<!-- ==================== PAGE 1: Statement of Employee ==================== -->
<div class="page">
  <!-- Header -->
  <div class="header-row">
    <div class="logo-box">
      <div class="logo-wrapper">
        <div class="logo-bracket">[</div>
        <div class="logo-words">
          <span class="logo-lincoln">Lincoln</span>
          <span class="logo-financial">Financial</span>
          <span class="logo-group">Group<sup style="font-size:6px;">®</sup></span>
        </div>
      </div>
    </div>
    <div class="header-title" style="flex:1; text-align:center; padding-top:4px;">
      <h1 style="font-size:15px; font-weight:bold; font-family:'Liberation Serif','DejaVu Serif',Georgia,serif;">Long Term Disability Claim Form Statement Of Employee</h1>
    </div>
    <div class="header-contact">
      <div class="company-name">Lincoln Life &amp; Annuity Company of New York</div>
      <div>PO Box 2609, Omaha, NE 68103-2609</div>
      <div>Toll Free (800) 423-2765&nbsp;&nbsp;Fax (877) 843-3950</div>
      <div>LincolnFinancial.com</div>
      <div>disabilityclaims@lfg.com</div>
    </div>
  </div>

  <hr class="thick-divider">

  <!-- Section 1 -->
  <div class="section-heading">1. Your Information</div>
  <div class="form-row">
    <span class="form-label">First Name:</span>
    <span class="form-underline"><span data-field="employee.first_name">{{ employee.first_name }}</span></span>
    <span class="form-label">M.I.:</span>
    <span class="form-underline-fixed" style="width:50px;"><span data-field="employee.middle_initial">{{ employee.middle_initial }}</span></span>
    <span class="form-label">Last Name:</span>
    <span class="form-underline"><span data-field="employee.last_name">{{ employee.last_name }}</span></span>
  </div>
  <div class="form-row">
    <span class="form-label">Street Address:</span>
    <span class="form-underline"><span data-field="employee.street_address">{{ employee.street_address }}</span></span>
  </div>
  <div class="form-row">
    <span class="form-label">City:</span>
    <span class="form-underline"><span data-field="employee.city">{{ employee.city }}</span></span>
    <span class="form-label">State:</span>
    <span class="form-underline-fixed" style="width:70px;"><span data-field="employee.state">{{ employee.state }}</span></span>
    <span class="form-label">Zip Code:</span>
    <span class="form-underline-fixed" style="width:100px;"><span data-field="employee.zip_code">{{ employee.zip_code }}</span></span>
  </div>
  <div class="form-row">
    <span class="form-label">Social Security Number:</span>
    <span class="form-underline"><span data-field="employee.ssn">{{ employee.ssn }}</span></span>
    <span class="form-label">Date of Birth:</span>
    <span class="form-underline-fixed" style="width:100px;"><span data-field="employee.date_of_birth">{{ employee.date_of_birth }}</span></span>
    <span class="checkbox-item"><span class="checkbox-box"></span> Male</span>
    <span class="checkbox-item"><span class="checkbox-box"></span> Female</span>
  </div>
  <div class="form-row">
    <span class="form-label">Email Address:</span>
    <span class="form-underline"><span data-field="employee.email">{{ employee.email }}</span></span>
    <span class="form-label">Phone Number:</span>
    <span class="form-underline"><span data-field="employee.phone">{{ employee.phone }}</span></span>
  </div>

  <hr class="thick-divider">

  <!-- Section 2 -->
  <div class="section-heading">2. Your Employer</div>
  <div class="form-row">
    <span class="form-label">Employer Name:</span>
    <span class="form-underline"><span data-field="employer.name">{{ employer.name }}</span></span>
  </div>
  <div class="form-row">
    <span class="form-label">Group ID:</span>
    <span class="form-underline"><span data-field="employer.group_id">{{ employer.group_id }}</span></span>
    <span class="form-label">Job Title:</span>
    <span class="form-underline"><span data-field="employer.job_title">{{ employer.job_title }}</span></span>
  </div>
  <div class="form-row">
    <span class="form-label">Policy Number:</span>
    <span class="form-underline" style="max-width:280px;"><span data-field="employer.policy_number">{{ employer.policy_number }}</span></span>
  </div>

  <hr class="thick-divider">

  <!-- Section 3 -->
  <div class="section-heading">3. Reason for inability to work</div>
  <div class="form-row">
    <span class="form-label">Description of Sickness, Injury or Pregnancy:</span>
    <span class="form-underline"><span data-field="reason.description">{{ reason.description }}</span></span>
  </div>
  <div class="form-row">
    <span class="form-label">Injury work related?</span>
    <span class="checkbox-item"><span class="checkbox-box"></span> Yes</span>
    <span class="checkbox-item"><span class="checkbox-box"></span> No</span>
  </div>

  <hr class="thick-divider">

  <!-- Section 4 -->
  <div class="section-heading">4. Other Income Being Received</div>
  <table class="income-table">
    <thead>
      <tr>
        <th style="text-align:left; width:130px;"></th>
        <th>Amount $</th>
        <th>Date Began</th>
        <th>Date Will Terminate</th>
        <th>Date Applied For</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="label-col">Social Security</td>
        <td class="value-col"><span data-field="other_income.social_security.amount">{{ other_income.social_security.amount }}</span></td>
        <td class="value-col"><span data-field="other_income.social_security.date_began">{{ other_income.social_security.date_began }}</span></td>
        <td class="value-col"><span data-field="other_income.social_security.date_terminate">{{ other_income.social_security.date_terminate }}</span></td>
        <td class="value-col"><span data-field="other_income.social_security.date_applied">{{ other_income.social_security.date_applied }}</span></td>
      </tr>
      <tr>
        <td class="label-col">Workers' Comp</td>
        <td class="value-col"><span data-field="other_income.workers_comp.amount">{{ other_income.workers_comp.amount }}</span></td>
        <td class="value-col"><span data-field="other_income.workers_comp.date_began">{{ other_income.workers_comp.date_began }}</span></td>
        <td class="value-col"><span data-field="other_income.workers_comp.date_terminate">{{ other_income.workers_comp.date_terminate }}</span></td>
        <td class="value-col"><span data-field="other_income.workers_comp.date_applied">{{ other_income.workers_comp.date_applied }}</span></td>
      </tr>
      <tr>
        <td class="label-col">Salary Continuance</td>
        <td class="value-col"><span data-field="other_income.salary_continuance.amount">{{ other_income.salary_continuance.amount }}</span></td>
        <td class="value-col"><span data-field="other_income.salary_continuance.date_began">{{ other_income.salary_continuance.date_began }}</span></td>
        <td class="value-col"><span data-field="other_income.salary_continuance.date_terminate">{{ other_income.salary_continuance.date_terminate }}</span></td>
        <td class="value-col"><span data-field="other_income.salary_continuance.date_applied">{{ other_income.salary_continuance.date_applied }}</span></td>
      </tr>
      <tr>
        <td class="label-col">State Disability</td>
        <td class="value-col"><span data-field="other_income.state_disability.amount">{{ other_income.state_disability.amount }}</span></td>
        <td class="value-col"><span data-field="other_income.state_disability.date_began">{{ other_income.state_disability.date_began }}</span></td>
        <td class="value-col"><span data-field="other_income.state_disability.date_terminate">{{ other_income.state_disability.date_terminate }}</span></td>
        <td class="value-col"><span data-field="other_income.state_disability.date_applied">{{ other_income.state_disability.date_applied }}</span></td>
      </tr>
      <tr>
        <td class="label-col">Other Disability</td>
        <td class="value-col"><span data-field="other_income.other_disability.amount">{{ other_income.other_disability.amount }}</span></td>
        <td class="value-col"><span data-field="other_income.other_disability.date_began">{{ other_income.other_disability.date_began }}</span></td>
        <td class="value-col"><span data-field="other_income.other_disability.date_terminate">{{ other_income.other_disability.date_terminate }}</span></td>
        <td class="value-col"><span data-field="other_income.other_disability.date_applied">{{ other_income.other_disability.date_applied }}</span></td>
      </tr>
      <tr>
        <td class="label-col">Sick Pay</td>
        <td class="value-col"><span data-field="other_income.sick_pay.amount">{{ other_income.sick_pay.amount }}</span></td>
        <td class="value-col"><span data-field="other_income.sick_pay.date_began">{{ other_income.sick_pay.date_began }}</span></td>
        <td class="value-col"><span data-field="other_income.sick_pay.date_terminate">{{ other_income.sick_pay.date_terminate }}</span></td>
        <td class="value-col"><span data-field="other_income.sick_pay.date_applied">{{ other_income.sick_pay.date_applied }}</span></td>
      </tr>
    </tbody>
  </table>
  <div style="font-size:9px; margin-top:4px;">If approved, should Lincoln National Life Insurance Co. withhold Federal Income Taxes from your benefits?</div>
  <div class="form-row" style="margin-top:3px;">
    <span class="checkbox-item"><span class="checkbox-box"></span> Yes</span>
    <span class="checkbox-item"><span class="checkbox-box"></span> No</span>
    <span class="form-label">If yes, indicate how much?</span>
    <span class="form-underline"><span data-field="withhold_tax_amount">{{ withhold_tax_amount }}</span></span>
  </div>
  <div class="italic-note">(Minimum: $20 per week Short-Term Disability) (Minimum: $88 per Month Long-Term Disability)</div>

  <hr class="thick-divider">

  <!-- Section 5 -->
  <div class="section-heading">5. Who is your treating health care provider?</div>
  <div style="font-size:9px; margin-bottom:5px;">This is your primary health care professional. Please have them complete the <u>Attending Physician's Statement</u>. If you have additional health care providers, please also complete the Treating Medical Professional form.</div>
  <div class="form-row">
    <span class="form-label">Physician's Full Name:</span>
    <span class="form-underline"><span data-field="physician.full_name">{{ physician.full_name }}</span></span>
  </div>
  <div class="form-row">
    <span class="form-label">Phone Number:</span>
    <span class="form-underline"><span data-field="physician.phone">{{ physician.phone }}</span></span>
    <span class="form-label">Fax Number:</span>
    <span class="form-underline"><span data-field="physician.fax">{{ physician.fax }}</span></span>
  </div>
  <div class="form-row">
    <span class="form-label">Street Address:</span>
    <span class="form-underline"><span data-field="physician.street_address">{{ physician.street_address }}</span></span>
  </div>
  <div class="form-row">
    <span class="form-label">City:</span>
    <span class="form-underline"><span data-field="physician.city">{{ physician.city }}</span></span>
    <span class="form-label">State:</span>
    <span class="form-underline-fixed" style="width:70px;"><span data-field="physician.state">{{ physician.state }}</span></span>
    <span class="form-label">Zip Code:</span>
    <span class="form-underline-fixed" style="width:100px;"><span data-field="physician.zip_code">{{ physician.zip_code }}</span></span>
  </div>

  <hr class="thick-divider">

  <!-- Section 6 -->
  <div class="section-heading">6. Account for Direct Deposit</div>
  <div class="form-row">
    <span class="form-label">Bank Name</span>
    <span class="form-underline-fixed" style="width:180px;"><span data-field="bank.name">{{ bank.name }}</span></span>
    <span class="form-label">Routing Number</span>
    <span class="form-underline-fixed" style="width:110px;"><span data-field="bank.routing_number">{{ bank.routing_number }}</span></span>
    <span class="form-label">Account Number</span>
    <span class="form-underline-fixed" style="width:110px;"><span data-field="bank.account_number">{{ bank.account_number }}</span></span>
  </div>

  <div style="font-size:9px; margin-top:5px; line-height:1.5;">The above statements are true and complete to the best of my knowledge and belief. I have read and understand Fraud Warning Statements. I have completed and attached the Authorization for Release of Information.</div>

  <div class="ny-warning" style="margin-top:5px;"><strong>New York.</strong> Any person who knowingly and with intent to defraud any insurance company or other person files an application for insurance or statement of claim containing any materially false information or conceals for the purpose of misleading, information concerning any fact material thereto commits a fraudulent insurance act, which is a crime and subject to a civil penalty not to exceed five thousand dollars and the stated value of the claim for each such violation.</div>

  <div class="sig-row" style="margin-top:8px;">
    <span class="sig-label">Signature</span>
    <span class="sig-line"><span data-field="employee_signature">{{ employee_signature }}</span></span>
    <span class="sig-label">Date</span>
    <span class="sig-line" style="max-width:160px;"><span data-field="employee_signature_date">{{ employee_signature_date }}</span></span>
  </div>
  <div class="form-row" style="margin-top:5px;">
    <span class="form-label">Print Name</span>
    <span class="form-underline"><span data-field="employee_print_name">{{ employee_print_name }}</span></span>
  </div>

  <div class="page-footer">
    <div class="page-footer-center">(Please see FRAUD NOTICES attached)</div>
    <div class="page-footer-row">
      <span>Lincoln Financial Group is the marketing name for Lincoln National Corporation and its affiliates.</span>
      <span>Page 1 of 9</span>
    </div>
    <div class="page-footer-row">
      <span>GLC11750LTDNY</span>
      <span style="text-align:center; flex:1;">Claim Submission Part 1 of 5</span>
      <span>8/18</span>
    </div>
  </div>
</div>

<!-- ==================== PAGE 2: Illness or Injury Supplemental Questionnaire ==================== -->
<div class="page">
  <hr class="thick-divider" style="margin-bottom:6px;">
  <div class="questionnaire-heading">Illness or Injury Supplemental Questionnaire</div>
  <div class="q-instructions">Instructions: Please answer the questions to the best of your ability and sign and date below.</div>

  <div class="q-item">
    <span class="q-num">1.</span>
    <span class="q-text">Is someone else responsible for your illness/injury?&nbsp;&nbsp;<span class="checkbox-item"><span class="checkbox-box"></span> Yes</span><span class="checkbox-item"><span class="checkbox-box"></span> No</span></span>
  </div>
  <div class="q-item">
    <span class="q-num">2.</span>
    <span class="q-text">Are you making a claim against anyone or any insurance company other than Lincoln Financial Group?&nbsp;&nbsp;<span class="checkbox-item"><span class="checkbox-box"></span> Yes</span><span class="checkbox-item"><span class="checkbox-box"></span> No</span></span>
  </div>

  <div class="q-bold-note">If you answered yes to either question above, please answer the following questions:</div>

  <div class="q-item">
    <span class="q-num">3.</span>
    <span class="q-text">
      Please describe in detail the cause of your illness or injury:<span class="form-underline" style="display:inline-block; width:200px; vertical-align:bottom;"><span data-field="supp.cause_description_inline">{{ supp.cause_description_inline }}</span></span>
      <span class="q-answer-line"><span data-field="supp.cause_description_line2">{{ supp.cause_description_line2 }}</span></span>
    </span>
  </div>

  <div class="q-item" style="margin-top:6px;">
    <span class="q-num">4.</span>
    <span class="q-text">
      Please provide the location and address where the illness or injury occurred:&nbsp;<span class="form-underline" style="display:inline-block; width:120px; vertical-align:bottom;"><span data-field="supp.injury_location_inline">{{ supp.injury_location_inline }}</span></span>
