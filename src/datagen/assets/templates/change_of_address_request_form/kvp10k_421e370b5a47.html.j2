<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
</style>
<div class="page">
  <h1 style="font-size: 18pt; font-weight: bold;">MTSU Human Resource Services Change of Address Request Form</h1>
  <p style="margin-top: 20px;">Print, complete this form, and return to Human Resource Services, <span data-field="department.name">{{ department.name }}</span>, <span data-field="department.address">{{ department.address }}</span>. This form must be signed in order to be processed.</p>
  <p style="margin-top: 30px;">I am requesting a change of address as follows:</p>

  <div style="margin-top: 40px;">
    <p>M No: <span data-field="m_number">{{ m_number }}</span></p>
    <p>Name: <span data-field="full_name">{{ full_name }}</span></p>
    <p>Street: <span data-field="address.street">{{ address.street }}</span></p>
    <p>City, State, Zip: <span data-field="address.city_state_zip">{{ address.city_state_zip }}</span></p>
    <p>Phone No: <span data-field="phone_number">{{ phone_number }}</span></p>
    <p>Signature: _________________________ Date: <span data-field="date_signed">{{ date_signed }}</span></p>
    <p style="margin-top: 20px;">Check one: Employee <span data-field="employee_checkbox">{{ employee_checkbox }}</span> Student <span data-field="student_checkbox">{{ student_checkbox }}</span></p>
  </div>

  <div style="position: absolute; bottom: 50px; right: 60px; font-size: 10pt;">
    Revised: <span data-field="revision_date">{{ revision_date }}</span>
  </div>
</div>