<!DOCTYPE html>
<html>
<head>
<title>Document</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    line-height: 1.5;
    color: #000;
  }
  h1, h2, h3 {
    font-weight: bold;
    margin-top: 0;
  }
  .header-info {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 20px;
  }
  .contact-info {
    text-align: left;
  }
  .title-block {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 30px;
  }
  .section-title {
    font-size: 1.2em;
    font-weight: bold;
    margin-top: 25px;
    margin-bottom: 10px;
    border-bottom: 1px solid #ccc;
    padding-bottom: 3px;
  }
  .job-entry, .education-entry, .award-entry, .patent-entry, .certification-entry {
    margin-bottom: 15px;
  }
  .job-header, .education-header, .award-header, .patent-header, .certification-header {
    display: flex;
    justify-content: space-between;
    font-weight: bold;
    margin-bottom: 3px;
  }
  .job-details, .education-details, .award-details, .patent-details, .certification-details {
    margin-left: 20px;
    font-size: 0.95em;
  }
  .responsibility-list {
    list-style-type: disc;
    margin-left: 40px;
    padding-left: 0;
  }
  .responsibility-list li {
    margin-bottom: 5px;
    font-size: 0.95em;
  }
  .two-column-section {
    display: flex;
    gap: 50px;
  }
  .two-column-section > div {
    flex: 1;
  }
  .skills-list, .interests-list {
    list-style-type: none;
    padding: 0;
    margin: 0;
  }
  .skills-list li, .interests-list li {
    display: inline-block;
    margin-right: 10px;
    margin-bottom: 5px;
    font-size: 0.95em;
  }
  .table-container {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
  }
  .table-container th, .table-container td {
    border: 1px solid #ddd;
    padding: 8px;
    text-align: left;
    font-size: 0.9em;
  }
  .table-container th {
    background-color: #f2f2f2;
    font-weight: bold;
  }
</style>
</head>
<body>

<div class="page">
