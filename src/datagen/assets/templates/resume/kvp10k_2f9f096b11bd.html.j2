<!DOCTYPE html>
<html>
<head>
<title>CV Template</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    line-height: 1.5;
    color: #333;
  }
  h1, h2, h3 {
    font-weight: bold;
    margin-top: 0;
  }
  .header-info {
    text-align: center;
    margin-bottom: 30px;
  }
  .contact-info {
    text-align: center;
    font-size: 0.9em;
  }
  .section-title {
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
    border-bottom: 1px solid #ccc;
    padding-bottom: 3px;
  }
  .job-entry, .publication-entry, .presentation-entry {
    margin-bottom: 15px;
  }
  .job-title {
    font-weight: bold;
  }
  .dates {
    float: right;
    font-style: italic;
  }
  .list-item {
    margin-bottom: 5px;
  }
  .columns {
    display: flex;
    justify-content: space-between;
  }
  .column {
    width: 48%;
  }
</style>

