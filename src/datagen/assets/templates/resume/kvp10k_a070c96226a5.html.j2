<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child {
    page-break-after: auto;
  }
  h1, h2, h3, h4 {
    font-weight: bold;
    margin-top: 0.5em;
    margin-bottom: 0.5em;
  }
  .header-info {
    text-align: center;
    margin-bottom: 30px;
  }
  .contact-info {
    text-align: center;
    margin-bottom: 40px;
  }
  .section {
    margin-bottom: 30px;
  }
  .two-column {
    display: flex;
    justify-content: space-between;
  }
  .two-column > div {
    width: 48%;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
  }
  td {
    padding: 8px 0;
  }
  .job-entry, .edu-entry {
    margin-bottom: 20px;
  }
  .job-header, .edu-header {
    display: flex;
    justify-content: space-between;
    font-weight: bold;
    margin-bottom: 5px;
  }
  .job-description, .edu-description {
    margin-left: 10px;
    font-size: 0.95em;
  }
  .list-item {
    margin-bottom: 5px;
  }
</style>

