<!DOCTYPE html>
<html>
<head>
<title>CV Template</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 {
    font-family: "DejaVu Sans", "Liberation Sans", Arial, Helvetica, sans-serif;
    font-weight: bold;
  }
  .header-info {
    text-align: center;
    margin-bottom: 20px;
  }
  .contact-info {
    text-align: center;
    font-size: 0.9em;
    margin-bottom: 30px;
  }
  .section {
    margin-bottom: 25px;
  }
  .section-title {
    font-size: 1.2em;
    font-weight: bold;
    margin-bottom: 10px;
    border-bottom: 1px solid #ccc;
    padding-bottom: 3px;
  }
  .entry {
    margin-bottom: 15px;
  }
  .entry-header {
    display: flex;
    justify-content: space-between;
    font-weight: bold;
  }
  .entry-details {
    margin-top: 3px;
    font-size: 0.95em;
  }
  .job-title {
    font-weight: bold;
  }
  .description-list {
    margin-top: 5px;
    padding-left: 20px;
    font-size: 0.95em;
  }
  .publication-list, .presentation-list, .service-list, .professional-org-list {
    list-style-type: disc;
    padding-left: 20px;
    margin-top: 5px;
  }
  .publication-list li, .presentation-list li, .service-list li, .professional-org-list li {
    margin-bottom: 5px;
    font-size: 0.95em;
  }
</style>
</head>
<body>

<div class="page">
  <div class="header-info">
    <h1><span data-field="full_name">{{ full_name }}</span></h1>
  </div>
  <div class="contact-info">
    <p><span data-field="employer.name">{{ employer.name }}</span></p>
    <p><span data-field="employer.address">{{ employer.address }}</span></p>
    <p>Office Phone: <span data-field="phone">{{ phone }}</span></p>
    <p>E-mail: <span data-field="email">{{ email }}</span></p>
  </div>

  <div class="section">
    <div class="section-title">EDUCATION</div>
    <div class="entry">
      <div class="entry-header">
        <span class="job-title">Master of Arts in English</span>
        <span>July 2011</span>
      </div>
      <div class="entry-details">
        <span data-field="education.institution_name">{{ education.institution_name }}</span>, <span data-field="education.location">{{ education.location }}</span>
        <br>Major: <span data-field="education.major">{{ education.major }}</span>
      </div>
    </div>
    <div class="entry">
      <div class="entry-header">
        <span class="job-title">Bachelor of Arts in Mass Communications</span>
        <span>August 2003</span>
      </div>
      <div class="entry-details">
        <span data-field="education.institution_name">{{ education.institution_name }}</span>, <span data-field="education.location">{{ education.location }}</span>
        <br>Minor: <span data-field="education.minor">{{ education.minor }}</span>
      </div>
    </div>
  </div>

  <div class="section">
    <div class="section-title">PROFESSIONAL CREDENTIALS</div>

    <div class="entry">
      <div class="entry-header">
        <span class="job-title">Senior Lecturer</span>
        <span>August 2023-present</span>
      </div>
      <div class="entry-details">
        <span data-field="employment.institution_name">{{ employment.institution_name }}</span>
        <br>Department of <span data-field="employment.department">{{ employment.department }}</span>
        <br><span data-field="employment.location">{{ employment.location }}</span>
        <div class="description-list">
          <p>Teach a combination of four English/Film courses per semester (total of eight courses per year, with occasional summer courses) in the department's First-Year Writing Program, and also work in the University Writing Center for three hours per week during the fall and spring semesters.</p>
        </div>
      </div>
    </div>

    <div class="entry">
      <div class="entry-header">
        <span class="job-title">English Lecturer</span>
        <span>August 2020-July 2023</span>
      </div>
      <div class="entry-details">
        <span data-field="employment.institution_name">{{ employment.institution_name }}</span>
        <br>Department of <span data-field="employment.department">{{ employment.department }}</span>
        <br><span data-field="employment.location">{{ employment.location }}</span>
        <div class="description-list">
          <p>Same job responsibilities as previous role, as well as added committee duties, but First-Year Writing has shifted to a new department.</p>
        </div>
      </div>
    </div>

    <div class="entry">
      <div class="entry-header">
        <span class="job-title">Lecturer</span>
        <span>August 2017-August 2020</span>
      </div>
      <div class="entry-details">
        <span data-field="employment.institution_name">{{ employment.institution_name }}</span>
        <br>Department of <span data-field="employment.department">{{ employment.department }}</span> and <span data-field="employment.sub_department">{{ employment.sub_department }}</span>
        <br><span data-field="employment.location">{{ employment.location }}</span>
      </div>
    </div>

    <div class="entry">
      <div class="entry-header">
        <span class="job-title">Instructor</span>
        <span>August 2012-August 2017</span>
      </div>
      <div class="entry-details">
        <span data-field="employment.institution_name">{{ employment.institution_name }}</span>
        <br>Department of <span data-field="employment.department">{{ employment.department }}</span> and <span data-field="employment.sub_department">{{ employment.sub_department }}</span>
        <br><span data-field="employment.location">{{ employment.location }}</span>
        <div class="description-list">
          <p>Taught a combination of four English/Film courses per semester (total of eight courses per year) in the department's First-Year Writing Program, and also worked as a tutor in the University Writing Center for three hours per week during the fall and spring semesters.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="section">
    <div class="section-title">FILM CRITIC</div>
    <div class="entry">
      <div class="entry-header">
        <span class="job-title">January 2002-present</span>
      </div>
      <div class="entry-details">
        <span data-field="critic.publication_name">{{ critic.publication_name }}</span>/Douglas County Sentinel/West Georgia Living
        <br><span data-field="critic.location">{{ critic.location }}</span>
        <div class="description-list">
          <p>Write a weekly film column for two daily/online newspapers, as well as a bimonthly column for a regional magazine.</p>
        </div>
      </div>
    </div>
    <div class="entry">
      <div class="entry-header">
        <span class="job-title">January 2015-present</span>
      </div>
      <div class="entry-details">
        <span data-field="critic.publication_name">{{ critic.publication_name }}</span>
        <br><span data-field="critic.location">{{ critic.location }}</span>
        <div class="description-list">
          <p>Featured guest in a weekly movie review segment on local radio.</p>
        </div>
      </div>
    </div>
    <div class="entry">
      <div class="entry-header">
        <span class="job-title">June 2006-September 2008</span>
      </div>
      <div class="entry-details">
        <span data-field="critic.publication_name">{{ critic.publication_name }}</span>
        <br><span data-field="critic.location">{{ critic.location }}</span>
      </div>
    </div>
  </div>

  <div class="section">
    <div class="section-title">COORDINATOR OF MARKETING PUBLICATIONS</div>
    <div class="entry">
      <div class="entry-header">
        <span class="job-title">September 2009-July 2012</span>
      </div>
      <div class="entry-details">
        <span data-field="marketing.institution_name">{{ marketing.institution_name }}</span>
        <br>Office of University Communications and Marketing
        <br><span data-field="marketing.location">{{ marketing.location }}</span>
        <div class="description-list">
          <p>Wrote and edited copy for marketing materials and media relations, as well as managed communication with potential ad subjects. Other duties included writing, editing, and managing the production of <span data-field="marketing.publication_name">{{ marketing.publication_name }}</span> (biannual alumni magazine), producing <span data-field="marketing.publication_name">{{ marketing.publication_name }}</span> (monthly alumni email newsletter), and the <span data-field="marketing.publication_name">{{ marketing.publication_name }}</span> (faculty/staff online publication). Also supervised and mentored several student writers. Played a supporting role in the institution's social media strategy, as well as initiated the planning stages of expanding the <span data-field="marketing.publication_name">{{ marketing.publication_name }}</span> brand to include a separate issue for each of UWG's schools and colleges, along with an enhanced web presence.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="section">
    <div class="section-title">COORDINATOR OF ADVANCEMENT PUBLICATIONS</div>
    <div class="entry">
      <div class="entry-header">
        <span class="job-title">August 2006-September 2009</span>
      </div>
      <div class="entry-details">
        <span data-field="advancement.institution_name">{{ advancement.institution_name }}</span>
        <br>Office of University Communications and Marketing
      </div>
    </div>
  </div>

  <div class="section">
    <div class="section-title">MULTIMEDIA SPECIALIST</div>
    <div class="entry">
      <div class="entry-header">
        <span class="job-title">January 2004-August 2006</span>
      </div>
      <div class="entry-details">
        <span data-field="media.institution_name">{{ media.institution_name }}</span>
        <br><span data-field="media.location">{{ media.location }}</span>
        <div class="description-list">
          <p>Generated articles for most of the publications that reached 2,000+ members, copy edited all documents disseminated by church leadership, assisted with advertising campaigns, produced and edited multimedia projects, and managed a 10-person team responsible for producing multiple weekly services.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="section">
    <div class="section-title">FEATURES EDITOR</div>
    <div class="entry">
      <div class="entry-header">
        <span class="job-title">February 2001-May 2003</span>
      </div>
      <div class="entry-details">
        <span data-field="media.institution_name">{{ media.institution_name }}</span>
        <br><span data-field="media.location">{{ media.location }}</span>
        <div class="description-list">
          <p>Wrote and edited stories, designed pages, and supervised staff writers for the weekly campus newspaper.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="section">
    <div class="section-title">AWARDS AND RECOGNITION</div>
    <ul class="publication-list">
      <li><span data-field="award.award_name">{{ award.award_name }}</span>, <span data-field="award.year">{{ award.year }}</span></li>
      <li><span data-field="award.award_name">{{ award.award_name }}</span>, <span data-field="award.year">{{ award.year }}</span></li>
      <li><span data-field="award.award_name">{{ award.award_name }}</span>, <span data-field="award.year">{{ award.year }}</span></li>
    </ul>
  </div>

  <div class="section">
    <div class="section-title">COURSES TAUGHT</div>
    <ul class="publication-list">
      <li><span data-field="course.course_name">{{ course.course_name }}</span></li>
      <li><span data-field="course.course_name">{{ course.course_name }}</span></li>
      <li><span data-field="course.course_name">{{ course.course_name }}</span></li>
      <li><span data-field="course.course_name">{{ course.course_name }}</span></li>
      <li><span data-field="course.course_name">{{ course.course_name }}</span></li>
      <li><span data-field="course.course_name">{{ course.course_name }}</span></li>
      <li><span data-field="course.course_name">{{ course.course_name }}</span></li>
      <li><span data-field="course.course_name">{{ course.course_name }}</span></li>
    </ul>
  </div>

  <div class="section">
    <div class="section-title">PUBLICATIONS</div>
    <ul class="publication-list">
      <li><span data-field="publication.title">{{ publication.title }}</span>, <span data-field="publication.date">{{ publication.date }}</span></li>
      <li><span data-field="publication.title">{{ publication.title }}</span></li>
    </ul>
  </div>

  <div class="page">
    <div class="section">
      <div class="section-title">SERVICE TO THE UNIVERSITY</div>
      <ul class="service-list">
        <li><span data-field="service.service_name">{{ service.service_name }}</span>, <span data-field="service.date">{{ service.date }}</span></li>
        <li><span data-field="service.service_name">{{ service.service_name }}</span>, <span data-field="service.date">{{ service.date }}</span></li>
        <li><span data-field="service.service_name">{{ service.service_name }}</span>, <span data-field="service.date">{{ service.date }}</span></li>
        <li><span data-field="service.service_name">{{ service.service_name }}</span>, <span data-field="service.date">{{ service.date }}</span></li>
        <li><span data-field="service.service_name">{{ service.service_name }}</span>, <span data-field="service.date">{{ service.date }}</span></li>
        <li><span data-field="service.service_name">{{ service.service_name }}</span>, <span data-field="service.date">{{ service.date }}</span></li>
        <li><span data-field="service.service_name">{{ service.service_name }}</span>, <span data-field="service.date">{{ service.date }}</span></li>
        <li><span data-field="service.service_name">{{ service.service_name }}</span>, <span data-field="service.date">{{ service.date }}</span></li>
      </ul>
    </div>

    <div class="section">
      <div class="section-title">SERVICE TO THE COMMUNITY</div>
      <ul class="service-list">
        <li><span data-field="community_service.service_name">{{ community_service.service_name }}</span>, <span data-field="community_service.date">{{ community_service.date }}</span></li>
        <li><span data-field="community_service.service_name">{{ community_service.service_name }}</span>, <span data-field="community_service.date">{{ community_service.date }}</span></li>
        <li><span data-field="community_service.service_name">{{ community_service.service_name }}</span>, <span data-field="community_service.date">{{ community_service.date }}</span></li>
        <li><span data-field="community_service.service_name">{{ community_service.service_name }}</span>, <span data-field="community_service.date">{{ community_service.date }}</span></li>
        <li><span data-field="community_service.service_name">{{ community_service.service_name }}</span>, <span data-field="community_service.date">{{ community_service.date }}</span></li>
      </ul>
    </div>

    <div class="section">
      <div class="section-title">PROFESSIONAL ORGANIZATIONS</div>
      <ul class="professional-org-list">
        <li><span data-field="org.org_name">{{ org.org_name }}</span>, <span data-field="org.date">{{ org.date }}</span></li>
        <li><span data-field="org.org_name">{{ org.org_name }}</span>, <span data-field="org.date">{{ org.date }}</span></li>
        <li><span data-field="org.org_name">{{ org.org_name }}</span>, <span data-field="org.date">{{ org.date }}</span></li>
      </ul>
    </div>
  </div>

</body>
</html>