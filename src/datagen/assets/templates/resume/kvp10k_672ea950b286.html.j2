<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child { page-break-after: auto; }
  h1 { font-size: 36pt; text-align: center; margin-bottom: 5px; }
  .contact-info { text-align: center; font-size: 12pt; margin-bottom: 30px; }
  .references-section { margin-top: 40px; }
  .reference-block { margin-bottom: 20px; }
  .reference-block p { margin: 2px 0; font-size: 11pt; }
  .label { font-weight: bold; display: inline-block; width: 100px; }
</style>

<div class="page">
  <h1>Rowdy River Hawk</h1>
  <div class="contact-info">
    <span data-field="phone_number">{{ phone_number }}</span><br>
    <span data-field="email">{{ email }}</span>
  </div>

  <div class="references-section">
    <h2>REFERENCES</h2>

    <div class="reference-block">
      <p><span class="label">Name:</span> <span data-field="reference_1.name">{{ reference_1.name }}</span></p>
      <p><span class="label">Title:</span> <span data-field="reference_1.title">{{ reference_1.title }}</span></p>
      <p><span class="label">Company:</span> <span data-field="reference_1.company">{{ reference_1.company }}</span></p>
      <p><span class="label">E-mail Address:</span> <span data-field="reference_1.email_address">{{ reference_1.email_address }}</span></p>
      <p><span class="label">Phone Number:</span> <span data-field="reference_1.phone_number">{{ reference_1.phone_number }}</span></p>
    </div>

    <div class="reference-block">
      <p><span class="label">Name:</span> <span data-field="reference_2.name">{{ reference_2.name }}</span></p>
      <p><span class="label">Title:</span> <span data-field="reference_2.title">{{ reference_2.title }}</span></p>
      <p><span class="label">Company:</span> <span data-field="reference_2.company">{{ reference_2.company }}</span></p>
      <p><span class="label">E-mail Address:</span> <span data-field="reference_2.email_address">{{ reference_2.email_address }}</span></p>
      <p><span class="label">Phone Number:</span> <span data-field="reference_2.phone_number">{{ reference_2.phone_number }}</span></p>
    </div>

    <div class="reference-block">
      <p><span class="label">Name:</span> <span data-field="reference_3.name">{{ reference_3.name }}</span></p>
      <p><span class="label">Title:</span> <span data-field="reference_3.title">{{ reference_3.title }}</span></p>
      <p><span class="label">Company:</span> <span data-field="reference_3.company">{{ reference_3.company }}</span></p>
      <p><span class="label">E-mail Address:</span> <span data-field="reference_3.email_address">{{ reference_3.email_address }}</span></p>
      <p><span class="label">Phone Number:</span> <span data-field="reference_3.phone_number">{{ reference_3.phone_number }}</span></p>
    </div>
  </div>
</div>