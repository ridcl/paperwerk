<!DOCTYPE html>
<html>
<head>
<title>CV Template</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 {
    font-family: "DejaVu Sans", "Liberation Sans", Arial, Helvetica, sans-serif;
    font-weight: bold;
  }
  .section-title {
    font-size: 14pt;
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 5px;
  }
  .job-title, .degree-name {
    font-weight: bold;
  }
  .date-range {
    float: right;
    font-style: italic;
  }
  .divider {
    border-top: 1px solid #ccc;
    margin: 20px 0;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
  }
  td {
    padding: 5px 0;
  }
</style>
</head>
<body>

<div class="page">
  <h1 style="text-align: center; font-size: 24pt; margin-bottom: 5px;">{{ full_name }}</h1>
  <p style="text-align: center; font-size: 10pt; margin-top: 0;">
    {{ contact.address_line_1 }}, {{ contact.city }}, {{ contact.state }} {{ contact.zip }}<br>
    Phone: {{ contact.phone }} • Email: {{ contact.email }} • Website: {{ contact.website }}
  </p>

  <div class="divider"></div>

  <div class="section-title">EMPLOYMENT</div>
  <div>
    <p class="job-title">{{ employer_history[0].title }} at {{ employer_history[0].name }} <span class="date-range">{{ employer_history[0].dates }}</span></p>
    <p>{{ employer_history[0].description }}</p>
  </div>
  <div>
    <p class="job-title">{{ employer_history[1].title }} at {{ employer_history[1].name }} <span class="date-range">{{ employer_history[1].dates }}</span></p>
    <p>{{ employer_history[1].description }}</p>
  </div>

  <div class="divider"></div>

  <div class="section-title">EDUCATION</div>
  <div>
    <p class="degree-name">{{ education_history[0].degree }} from {{ education_history[0].institution }} <span class="date-range">{{ education_history[0].dates }}</span></p>
    <p>Subfields: {{ education_history[0].subfields }}</p>
    <p>Dissertation Title: {{ education_history[0].dissertation_title }}</p>
    <p>Committee Members: {{ education_history[0].committee_members }}</p>
  </div>

  <div class="divider"></div>

  <div class="section-title">PUBLICATIONS</div>
  <div>
    <p><strong>Book:</strong></p>
    <ul>
      {% for pub in publications.books %}
        <li>{{ pub.title }}</li>
      {% endfor %}
    </ul>
  </div>
  <div>
    <p><strong>Articles:</strong></p>
    <ul>
      {% for pub in publications.articles %}
        <li>{{ pub.title }}</li>
      {% endfor %}
    </ul>
  </div>

  <div class="divider"></div>

  <div class="section-title">CURRENT RESEARCH</div>
  <div>
    <p><strong>Book Project:</strong> {{ research_projects[0].title }}</p>
    <p><strong>Book Project:</strong> {{ research_projects[1].title }}</p>
    <p><strong>Article:</strong> {{ research_articles[0].title }}</p>
    <p><strong>Article:</strong> {{ research_articles[1].title }}</p>
  </div>

  <div class="divider"></div>

  <div class="section-title">PRESENTATIONS</div>
  <ul>
    {% for presentation in presentations %}
      <li>{{ presentation.title }}</li>
    {% endfor %}
  </ul>

  <div class="divider"></div>

  <div class="section-title">MEDIA, AWARDS, AND PROFESSIONAL EXPERIENCE</div>
  <div>
    <p><strong>Field work:</strong> {{ media_experience[0].details }}</p>
    <p><strong>Media interviews:</strong> {{ media_experience[1].details }}</p>
    <p><strong>Panel participant:</strong> {{ media_experience[2].details }}</p>
    <p><strong>Co-founder:</strong> {{ media_experience[3].details }}</p>
  </div>

  <div class="divider"></div>

  <div class="section-title">MEMBERSHIP, SCHOLARS STRATEGY NETWORK</div>
  <ul>
    <li>{{ membership[0].details }}</li>
    <li>{{ membership[1].details }}</li>
    <li>{{ membership[2].details }}</li>
    <li>{{ membership[3].details }}</li>
  </ul>

  <div class="divider"></div>

  <div class="section-title">TEACHING AND SERVICE</div>
  <div>
    <p><strong>Reviewer:</strong> {{ teaching_service[0].details }}</p>
    <p><strong>Section Chair:</strong> {{ teaching_service[1].details }}</p>
    <p><strong>Instructor:</strong> {{ teaching_service[2].details }}</p>
    <p><strong>Graduate Mentor:</strong> {{ teaching_service[3].details }}</p>
    <p><strong>Teaching Assistant:</strong> {{ teaching_service[4].details }}</p>
  </div>

  <div class="divider"></div>

  <div class="section-title">COMPARATIVE DEMOCRATIZATION, APSA 2019</div>
  <div>
    <p><strong>George Washington University:</strong></p>
    <ul>
      <li>Instructor: {{ teaching_service_gwu[0].details }}</li>
      <li>Instructor: {{ teaching_service_gwu[1].details }}</li>
      <li>Instructor: {{ teaching_service_gwu[2].details }}</li>
      <li>Methodology Field Chair: {{ teaching_service_gwu[3].details }}</li>
      <li>Methodology Coordinating Committee: {{ teaching_service_gwu[4].details }}</li>
      <li>Graduate Program Review Committee: {{ teaching_service_gwu[5].details }}</li>
      <li>Thesis advisor: {{ teaching_service_gwu[6].details }}</li>
      <li>Former advisor: {{ teaching_service_gwu[7].details }}</li>
    </ul>
  </div>

  <div class="divider"></div>

  <div class="section-title">AUSTRALIAN NATIONAL UNIVERSITY</div>
  <div>
    <p>Instructor: {{ teaching_service_anu[0].details }}</p>
    <p>Coordinator: {{ teaching_service_anu[1].details }}</p>
  </div>

  <div class="divider"></div>

  <div class="section-title">PRINCETON UNIVERSITY</div>
  <div>
    <p>Graduate Mentor: {{ teaching_service_pu[0].details }}</p>
    <p>Consultant to Undergraduates, Data and Statistical Services: {{ teaching_service_pu[1].details }}</p>
    <p>Teaching Assistant: {{ teaching_service_pu[2].details }}</p>
  </div>

</div>

</body>
</html>