<!DOCTYPE html>
<html>
<head>
<title>Document</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    line-height: 1.5;
  }
  h1, h2, h3 {
    font-weight: bold;
    margin-top: 0.5em;
    margin-bottom: 0.5em;
  }
  .header-info {
    margin-bottom: 20px;
  }
  .contact-info p {
    margin: 2px 0;
  }
  .section-title {
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
  }
  .education-entry, .work-entry, .journal-entry, .patent-entry, .conference-entry, .invited-presentation-entry {
    margin-bottom: 15px;
  }
  .journal-entry-meta, .patent-entry-meta, .conference-entry-meta, .invited-presentation-entry-meta {
    font-size: 0.9em;
    color: #555;
    margin-top: 3px;
  }
  .journal-entry-title, .patent-entry-title, .conference-entry-title, .invited-presentation-entry-title {
    font-weight: bold;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
  }
  td {
    padding: 5px 0;
  }
</style>
</head>
<body>

<div class="page">
  <div style="text-align: right;">
    <span data-field="full_name">{{ full_name }}</span>
  </div>
  <div style="text-align: right; font-size: 0.9em;">
    <span data-field="title">{{ title }}</span>
  </div>
  <div class="header-info">
    <p><span data-field="affiliation.department">{{ affiliation.department }}</span>, <span data-field="affiliation.address">{{ affiliation.address }}</span></p>
    <div class="contact-info">
      <p>Office Phone: <span data-field="contact.office_phone">{{ contact.office_phone }}</span>; Cell Phone: <span data-field="contact.cell_phone">{{ contact.cell_phone }}</span></p>
      <p>Email: <span data-field="contact.email">{{ contact.email }}</span>; Website: <span data-field="contact.website">{{ contact.website }}</span></p>
    </div>
  </div>

  <div class="section-title">Education</div>
  <div class="education-entry">
    <p>
      <span data-field="education.year_1">{{ education.year_1 }}</span>: <span data-field="education.degree_1">{{ education.degree_1 }}</span>, <span data-field="education.institution_1">{{ education.institution_1 }}</span>, <span data-field="education.location_1">{{ education.location_1 }}</span>
    </p>
    <p>
      <span data-field="education.year_2">{{ education.year_2 }}</span>: <span data-field="education.degree_2">{{ education.degree_2 }}</span>, <span data-field="education.institution_2">{{ education.institution_2 }}</span>, <span data-field="education.location_2">{{ education.location_2 }}</span>
    </p>
  </div>

  <div class="section-title">Professional Positions</div>
  <div class="work-entry">
    <p>
      <span data-field="work_experience.title_1">{{ work_experience.title_1 }}</span> at <span data-field="work_experience.employer_1">{{ work_experience.employer_1 }}</span> (<span data-field="work_experience.dates_1">{{ work_experience.dates_1 }}</span>)
    </p>
    <p>
      <span data-field="work_experience.title_2">{{ work_experience.title_2 }}</span> at <span data-field="work_experience.employer_2">{{ work_experience.employer_2 }}</span> (<span data-field="work_experience.dates_2">{{ work_experience.dates_2 }}</span>)
    </p>
  </div>

  <div class="section-title">Professional Memberships</div>
  <div class="membership-list">
    <p>
      <span data-field="membership_1">{{ membership_1 }}</span> (Since <span data-field="membership_1_year">{{ membership_1_year }}</span>)
    </p>
    <p>
      <span data-field="membership_2">{{ membership_2 }}</span> (Since <span data-field="membership_2_year">{{ membership_2_year }}</span>)
    </p>
    <p>
      <span data-field="membership_3">{{ membership_3 }}</span> (Since <span data-field="membership_3_year">{{ membership_3_year }}</span>)
    </p>
    <p>
      <span data-field="membership_4">{{ membership_4 }}</span> (Since <span data-field="membership_4_year">{{ membership_4_year }}</span>)
    </p>
    <p>
      <span data-field="membership_5">{{ membership_5 }}</span> (Since <span data-field="membership_5_year">{{ membership_5_year }}</span>)
    </p>
  </div>

  <div class="section-title">Awards and Honors</div>
  <div class="award-list">
    <p><span data-field="award_1">{{ award_1 }}</span> (<span data-field="award_1_year">{{ award_1_year }}</span>)</p>
    <p><span data-field="award_2">{{ award_2 }}</span> (<span data-field="award_2_year">{{ award_2_year }}</span>)</p>
    <p><span data-field="award_3">{{ award_3 }}</span> (<span data-field="award_3_year">{{ award_3_year }}</span>)</p>
    <p><span data-field="award_4">{{ award_4 }}</span> (<span data-field="award_4_year">{{ award_4_year }}</span>)</p>
    <p><span data-field="award_5">{{ award_5 }}</span> (<span data-field="award_5_year">{{ award_5_year }}</span>)</p>
  </div>

  <div class="section-title">Research Projects</div>
  <div class="project-list">
    <p><span data-field="project_1">{{ project_1 }}</span> (PI: <span data-field="project_1_pi">{{ project_1_pi }}</span>). <span data-field="project_1_details">{{ project_1_details }}</span> June 1, 2017-June 30, 2020. $134,750.</span></p>
    <p><span data-field="project_2">{{ project_2 }}</span> (PI: <span data-field="project_2_pi">{{ project_2_pi }}</span>). <span data-field="project_2_details">{{ project_2_details }}</span> July 1, 2017 – June 30, 2018. $34,475.</span></p>
    <p><span data-field="project_3">{{ project_3 }}</span> (PI: <span data-field="project_3_pi">{{ project_3_pi }}</span>). <span data-field="project_3_details">{{ project_3_details }}</span> March 1, 2017 - February 28, 2018. $15,400.</span></p>
    <p><span data-field="project_4">{{ project_4 }}</span> <span data-field="project_4_details">{{ project_4_details }}</span> July 1, 2017 - June 30, 2018. $10,000.</span></p>
    <p><span data-field="project_5">{{ project_5 }}</span> (PI: <span data-field="project_5_pi">{{ project_5_pi }}</span>, Co-PI: <span data-field="project_5_copi">{{ project_5_copi }}</span>). <span data-field="project_5_details">{{ project_5_details }}</span> September, 2018-August, 2021. $299,535.</span></p>
  </div>

  <div class="section-title">Journal Publications</div>
  <table>
    <thead>
      <tr>
        <td style="width: 1%;">#</td>
        <td style="width: 99%;">Publication Details</td>
      </tr>
    </thead>
    <tbody>
      {% for item in journal_publications %}
      <tr>
        <td>{{ loop.index }}</td>
        <td>
          <div class="journal-entry-title">{{ item.title }}</div>
          <div class="journal-entry-meta">
            {{ item.authors }} in <span data-field="journal_publications[{{ loop.index0 }}].journal_name</span>, {{ item.year }}.
          </div>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="section-title">Patents</div>
  <table>
    <thead>
      <tr>
        <td style="width: 1%;">#</td>
        <td style="width: 99%;">Patent Details</td>
      </tr>
    </thead>
    <tbody>
      {% for item in patents %}
      <tr>
        <td>{{ loop.index }}</td>
        <td>
          <div class="patent-entry-title">{{ item.title }}</div>
          <div class="patent-entry-meta">
            {{ item.inventors }} in <span data-field="patents[{{ loop.index0 }}].patent_name</span>, {{ item.year }}.
          </div>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="section-title">Conference Presentations</div>
  <table>
    <thead>
      <tr>
        <td style="width: 1%;">#</td>
        <td style="width: 99%;">Presentation Details</td>
      </tr>
    </thead>
    <tbody>
      {% for item in conference_presentations %}
      <tr>
        <td>{{ loop.index }}</td>
        <td>
          <div class="conference-entry-title">{{ item.title }}</div>
          <div class="conference-entry-meta">
            {{ item.authors }} at <span data-field="conference_presentations[{{ loop.index0 }}].conference_name</span>, {{ item.year }}.
          </div>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="section-title">Invited Presentations</div>
  <table>
    <thead>
      <tr>
        <td style="width: 1%;">#</td>
        <td style="width: 99%;">Presentation Details</td>
      </tr>
    </thead>
    <tbody>
      {% for item in invited_presentations %}
      <tr>
        <td>{{ loop.index }}</td>
        <td>
          <div class="invited-presentation-entry-title">{{ item.title }}</div>
          <div class="invited-presentation-entry-meta">
            {{ item.authors }} at <span data-field="invited_presentations[{{ loop.index0 }}].conference_name</span>, {{ item.year }}.
          </div>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="section-title">Teaching</div>
  <div class="teaching-list">
    <p>CE 7105 Advanced Topics in Water Quality and Treatment (Fall 2017)</p>
    <p>EVEG 4780 Renewable Energy and Power Generation (Spring 2017, Course evaluation: 3.498)</p>
    <p>EVEG 3110 Water and Wastewater Treatment (Fall 2016, Course evaluation: 3.278)</p>
  </div>

  <div class="section-title">Student Advising</div>
  <div class="advising-list">
    <p>Ph.D. students: <span data-field="advising.phd_students">{{ journal_publications[loop.index0].journal_name</span>, item.year.
          </div>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="section-title">Patents</div>
  <table>
    <thead>
      <tr>
        <td style="width: 1%;">#</td>
        <td style="width: 99%;">Patent Details</td>
      </tr>
    </thead>
    <tbody>
      {% for item in patents %}
      <tr>
        <td>loop.index</td>
        <td>
          <div class="patent-entry-title">item.title</div>
          <div class="patent-entry-meta">
            item.inventors in <span data-field="patents[loop.index0].patent_name</span>, item.year.
          </div>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="section-title">Conference Presentations</div>
  <table>
    <thead>
      <tr>
        <td style="width: 1%;">#</td>
        <td style="width: 99%;">Presentation Details</td>
      </tr>
    </thead>
    <tbody>
      {% for item in conference_presentations %}
      <tr>
        <td>loop.index</td>
        <td>
          <div class="conference-entry-title">item.title</div>
          <div class="conference-entry-meta">
            item.authors at <span data-field="conference_presentations[loop.index0].conference_name</span>, item.year.
          </div>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="section-title">Invited Presentations</div>
  <table>
    <thead>
      <tr>
        <td style="width: 1%;">#</td>
        <td style="width: 99%;">Presentation Details</td>
      </tr>
    </thead>
    <tbody>
      {% for item in invited_presentations %}
      <tr>
        <td>loop.index</td>
        <td>
          <div class="invited-presentation-entry-title">item.title</div>
          <div class="invited-presentation-entry-meta">
            item.authors at <span data-field="invited_presentations[loop.index0].conference_name</span>, item.year.
          </div>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="section-title">Teaching</div>
  <div class="teaching-list">
    <p>CE 7105 Advanced Topics in Water Quality and Treatment (Fall 2017)</p>
    <p>EVEG 4780 Renewable Energy and Power Generation (Spring 2017, Course evaluation: 3.498)</p>
    <p>EVEG 3110 Water and Wastewater Treatment (Fall 2016, Course evaluation: 3.278)</p>
  </div>

  <div class="section-title">Student Advising</div>
  <div class="advising-list">
    <p>Ph.D. students: <span data-field= }}</span> (Aug. 2017 – present), <span data-field="advising.phd_students_2">{{ advising.phd_students_2 }}</span> (Aug. 2017 – present)</p>
    <p>Master students: <span data-field="advising.master_students">{{ advising.master_students }}</span> (Aug. 2017 – present), <span data-field="advising.master_students_2">{{ advising.master_students_2 }}</span> (Aug. 2016 – present)</p>
    <p>Undergraduate students: <span data-field="advising.undergrad_students">{{ advising.undergrad_students }}</span> (Aug. 2016 – present), <span data-field="advising.undergrad_students_2">{{ advising.undergrad_students_2 }}</span> (Jul. 2017)</p>
  </div>

  <div class="section-title">Journal Review</div>
  <div class="review-list">
    <p><span data-field="review_1">{{ review_1 }}</span> (since <span data-field="review_1_year">{{ review_1_year }}</span>)</p>
    <p><span data-field="review_2">{{ review_2 }}</span> (since <span data-field="review_2_year">{{ review_2_year }}</span>)</p>
    <p><span data-field="review_3">{{ review_3 }}</span> (since <span data-field="review_3_year">{{ review_3_year }}</span>)</p>
    <p><span data-field="review_4">{{ review_4 }}</span> (since <span data-field="review_4_year">{{ review_4_year }}</span>)</p>
    <p><span data-field="review_5">{{ review_5 }}</span> (since <span data-field="review_5_year">{{ review_5_year }}</span>)</p>
    <p><span data-field="review_6">{{ review_6 }}</span> (since <span data-field="review_6_year">{{ review_6_year }}</span>)</p>
    <p><span data-field="review_7">{{ review_7 }}</span> (since <span data-field="review_7_year">{{ review_7_year }}</span>)</p>
    <p><span data-field="review_8">{{ review_8 }}</span> (since <span data-field="review_8_year">{{ review_8_year }}</span>)</p>
    <p><span data-field="review_9">{{ review_9 }}</span> (since <span data-field="review_9_year">{{ review_9_year }}</span>)</p>
    <p><span data-field="review_10">{{ review_10 }}</span> (since <span data-field="review_10_year">{{ review_10_year }}</span>)</p>
    <p><span data-field="review_11">{{ review_11 }}</span> (since <span data-field="review_11_year">{{ review_11_year }}</span>)</p>
    <p><span data-field="review_12">{{ review_12 }}</span> (since <span data-field="review_12_year">{{ review_12_year }}</span>)</p>
  </div>

  <div class="section-title">Synergistic Activities</div>
  <div class="activity-list">
    <p><span data-field="activity_1">{{ activity_1 }}</span>, <span data-field="activity_1_year">{{ activity_1_year }}</span>.</p>
    <p><span data-field="activity_2">{{ activity_2 }}</span>, <span data-field="activity_2_year">{{ activity_2_year }}</span>.</p>
    <p><span data-field="activity_3">{{ activity_3 }}</span>, <span data-field="activity_3_year">{{ activity_3_year }}</span>.</p>
  </div>
</div>

<div class="page">
