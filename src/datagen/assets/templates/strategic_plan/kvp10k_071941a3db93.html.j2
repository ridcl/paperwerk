      <svg width="200" height="200" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
        <circle cx="50" cy="50" r="48" stroke="black" stroke-width="2" fill="none"/>
        <text x="50" y="25" font-size="10" text-anchor="middle" dominant-baseline="middle">ANDREWS</text>
        <text x="50" y="75" font-size="10" text-anchor="middle" dominant-baseline="middle">UNIVERSITY</text>
        <text x="50" y="50" font-size="12" text-anchor="middle" dominant-baseline="middle">Spiritus</text>
        <!-- Simplified representation of the internal elements -->
        <rect x="35" y="35" width="30" height="30" fill="black"/>
        <path d="M 50 35 L 50 65" stroke="black" stroke-width="2"/>
        <text x="50" y="55" font-size="8" text-anchor="middle">Mens</text>
        <text x="50" y="75" font-size="8" text-anchor="middle">Corpus</text>
        <text x="50" y="90" font-size="10" text-anchor="middle">1874</text>
      </svg>
    </div>
  </div>
</div>

<div class="page">
  <!-- Content from the second image (Campus View/Contact Info) -->
  <div style="text-align: center; margin-top: 100px;">
    <img src="placeholder_campus_image.jpg" alt="Campus View" style="max-width: 100%; height: auto; display: block; margin: 0 auto 50px auto;">
  </div>

  <div style="text-align: center; font-size: 1.2em; margin-bottom: 10px;">
    <span data-field="university.name">{{ university.name }}</span>
  </div>

  <div style="text-align: center; font-size: 1em; margin-bottom: 5px;">
    <span data-field="university.address_line1">{{ university.address_line1 }}</span>
  </div>

  <div style="text-align: center; font-size: 1em;">
    <span data-field="university.website">{{ university.website }}</span>
  </div>
</div></body>
</html>