    <p style="font-size: 18px; margin-top: 15px;">Thursday, <span data-field="date_2">{{ date_2 }}</span>, 11:15 a.m. | Friday, <span data-field="date_3">{{ date_3 }}</span>, 7:30 p.m. | Saturday, <span data-field="date_4">{{ date_4 }}</span>, 7:30 p.m.</p>
