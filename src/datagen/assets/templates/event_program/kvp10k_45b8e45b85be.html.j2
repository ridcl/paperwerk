  <div style="text-align: center; margin-top: 150px;">
    <h2 style="font-size: 32px; margin-bottom: 10px;">University of Mount Union Christmas Festival</h2>
    <p style="font-size: 18px; margin-top: 0;">Sunday, <span data-field="date_1">{{ date_1 }}</span>, 7 p.m.</p>
