<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; /* Defaulting to serif for document feel */
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic layout structure */
  .content-container {
    display: flex;
    gap: 60px;
  }
  .text-section {
    flex: 1;
    min-width: 0;
  }
  .diagram-section {
    flex: 1;
    min-width: 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  h1, h2, h3 {
    font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif;
    font-weight: bold;
  }
  .divider {
    border-top: 1px solid #ccc;
    margin: 20px 0;
  }
</style>

<div class="page">
  <div class="content-container">
    <div class="text-section">
      <h1>Hudson Valley Center</h1>
      <h2>Classroom 1</h2>

      <h3>Hours of Operation:</h3>
      <p><span data-field="hours_of_operation_details">{{ hours_of_operation_details }}</span></p>

      <h3>To Reserve Room:</h3>
      <p><span data-field="reservation_contact_info">Please call {{ reservation_contact_name }}, ext. {{ reservation_extension }}.</span></p>

      <h3>Phone: ext. {{ phone_extension }}</h3>

      <h3>Software Available for Use:</h3>
      <p><a href="{{ software_link }}">{{ software_link }}</a></p>
    </div>

    <div class="diagram-section">
      <!-- Placeholder for the visual diagram -->
      <div style="width: 450px; height: 550px; border: 1px solid #eee; position: relative; background-color: #f9f9f9;">
        <!-- Simplified representation of the layout elements -->
        <div style="position: absolute; top: 50px; left: 100px; font-size: 12px;">Ceiling Mounted Projector</div>
        <div style="position: absolute; top: 150px; left: 150px; font-size: 12px;">Ceiling Mounted Screen</div>
        <div style="position: absolute; top: 250px; left: 100px; font-size: 12px;">Marker Boards</div>
        <div style="position: absolute; bottom: 50px; left: 100px; font-size: 12px;">Lateral File Cabinets</div>
        
        <!-- Mocking the furniture layout -->
        <div style="position: absolute; top: 100px; left: 50px; width: 350px; height: 400px; border: 1px dashed #aaa;">
            <!-- Desks/Chairs representation -->
            <div style="position: absolute; top: 20px; left: 20px; width: 80px; height: 50px; background-color: #ddd;"></div>
            <div style="position: absolute; top: 100px; left: 20px; width: 80px; height: 50px; background-color: #ddd;"></div>
            <div style="position: absolute; top: 180px; left: 20px; width: 80px; height: 50px; background-color: #ddd;"></div>
            <div style="position: absolute; top: 260px; left: 20px; width: 80px; height: 50px; background-color: #ddd;"></div>
            <div style="position: absolute; top: 340px; left: 20px; width: 80px; height: 50px; background-color: #ddd;"></div>
        </div>
      </div>
    </div>
  </div>
</div>