<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  h1, h2, h3 {
    font-weight: bold;
  }
  .signature-line {
    border-bottom: 1px solid black;
    margin-top: 50px;
    margin-bottom: 50px;
  }
</style>

<div class="page">
  <div style="text-align: center; margin-bottom: 50px;">
    <span style="font-size: 48px; font-weight: bold;">W</span>
    <div style="display: inline-block; vertical-align: top; margin-left: 10px;">
      <div style="font-size: 24px; font-weight: bold;">Western Illinois</div>
      <div style="font-size: 24px; font-weight: normal;">University</div>
    </div>
  </div>

  <div style="text-align: center; margin-bottom: 40px;">
    <span data-field="document_title">{{ document_title }}</span>
  </div>

  <div style="text-align: justify; line-height: 1.6; margin-bottom: 40px;">
    <p>I authorize <span data-field="institution_name">{{ institution_name }}</span> to apply any Federal Direct PLUS loans towards the student's account (listed below) to cover miscellaneous charges. Miscellaneous charges may include but are not limited to <span data-field="charge_examples">{{ charge_examples }}</span> and up to <span data-field="loan_limit_amount">{{ loan_limit_amount }}</span> from the previous academic year.</p>
    <p>This authorization will remain in effect until a written request is received to revoke the authorization.</p>
    <p>I have read, fully understand, and agree to the conditions of this authorization statement.</p>
  </div>

  <div style="margin-bottom: 10px;">
    Signature of Parent: 
    <div class="signature-line" style="display: inline-block; width: 50%;"></div>
  </div>

  <div style="margin-top: 50px;">
    Name of Student: 
    <div class="signature-line" style="display: inline-block; width: 50%;"></div>
  </div>

  <div style="margin-top: 50px;">
    Student Account Number: 
    <div class="signature-line" style="display: inline-block; width: 50%;"></div>
  </div>

  <div style="margin-top: 50px;">
    Date: 
    <div class="signature-line" style="display: inline-block; width: 50%;"></div>
  </div>

  <div style="margin-top: 50px;">
    Return this form to:
    <div style="margin-top: 10px;">
      Billing and Receivables Office<br>
      <span data-field="institution_name">{{ institution_name }}</span><br>
      <span data-field="address_line_1">{{ address_line_1 }}</span><br>
      <span data-field="address_line_2">{{ address_line_2 }}</span><br>
      Phone <span data-field="phone_number">{{ phone_number }}</span> FAX <span data-field="fax_number">{{ fax_number }}</span>
    </div>
  </div>

  <div style="margin-top: 80px;">
    <div style="display: flex; justify-content: space-between; width: 100%;">
      <div>
        Office Use Only: Held placed by: 
        <div class="signature-line" style="display: inline-block; width: 30%;"></div>
        Date: 
        <div class="signature-line" style="display: inline-block; width: 30%;"></div>
      </div>
      <div>
        Held released by: 
        <div class="signature-line" style="display: inline-block; width: 30%;"></div>
        Date: 
        <div class="signature-line" style="display: inline-block; width: 30%;"></div>
      </div>
    </div>
  </div>

  <div style="margin-top: 80px; text-align: right;">
    Revised: <span data-field="revision_date">{{ revision_date }}</span>
  </div>
</div>