<!DOCTYPE html>
<html>
<head>
<title>Insurance Application</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  table { width: 100%; border-collapse: collapse; margin-bottom: 15px; }
  td { padding: 5px; }
  .header { text-align: center; margin-bottom: 20px; }
  .section-title { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
</style>
</head>
<body>

<div class="page">
  <div class="header">
    <h1>The Lincoln National Life Insurance Company</h1>
    <p>A Stock Company</p>
    <p>Home Office Location: Fort Wayne, Indiana</p>
    <p>Group Insurance Service Office: P.O. Box 2616, Omaha, NE 68103-2616</p>
    <p>Phone: (800) 423-2765 Fax: (800) 573-6177</p>
  </div>

  <div class="section-title">EVIDENCE OF INSURABILITY INFORMATION</div>
  <p>Please submit this form to The Lincoln National Life Insurance Company (herein referred to as "the Company"). No coverage for which evidence of insurability is required will be effective until approved in writing by the Company.</p>

  <div class="section-title">SECTION 1. Group Information:</div>
  <table>
    <tr>
      <td>Group Name: <span data-field="group_name">{{ group_name }}</span></td>
      <td>Group ID: <span data-field="group_id">{{ group_id }}</span></td>
    </tr>
    <tr>
      <td>Group Policy No(s): <span data-field="group_policy_numbers">{{ group_policy_numbers }}</span></td>
      <td>Billing Division/Location: <span data-field="billing_division_location">{{ billing_division_location }}</span></td>
    </tr>
  </table>

  <div class="section-title">SECTION 2. Employee Information: (Complete even if employee is not applying for coverage.)</div>
  <table>
    <tr>
      <td>First Name: <span data-field="employee.first_name">{{ employee.first_name }}</span></td>
      <td>Last Name: <span data-field="employee.last_name">{{ employee.last_name }}</span></td>
      <td>Middle Initial: <span data-field="employee.middle_initial">{{ employee.middle_initial }}</span></td>
    </tr>
    <tr>
      <td>Social Security No.: <span data-field="employee.ssn">{{ employee.ssn }}</span></td>
      <td>State of Birth: <span data-field="employee.state_of_birth">{{ employee.state_of_birth }}</span></td>
      <td>Date of Birth: <span data-field="employee.date_of_birth">{{ employee.date_of_birth }}</span></td>
    </tr>
    <tr>
      <td>Annual Earnings $: <span data-field="employee.annual_earnings">{{ employee.annual_earnings }}</span></td>
      <td>Date of Hire/Rehire: <span data-field="employee.date_of_hire">{{ employee.date_of_hire }}</span></td>
    </tr>
    <tr>
      <td>Home Mailing Address:</td>
      <td>(Street)</td>
      <td>(City)</td>
      <td>(State)</td>
      <td>(Zip)</td>
    </tr>
    <tr>
      <td>Phone No(s):</td>
      <td>Home</td>
      <td>Work</td>
      <td>Best Time to Call</td>
      <td>AM/PM</td>
    </tr>
    <tr>
      <td>Email Address:</td>
      <td></td>
      <td></td>
      <td>Home</td>
      <td>Work</td>
    </tr>
    <tr>
      <td>Beneficiary (for Life or AD&D Insurance):</td>
      <td>Relationship: <span data-field="beneficiary.relationship">{{ beneficiary.relationship }}</span></td>
    </tr>
  </table>

  <div class="section-title">SECTION 3. Spouse Information: (Complete only if applying for Dependent coverage.)</div>
  <table>
    <tr>
      <td>First Name: <span data-field="spouse.first_name">{{ spouse.first_name }}</span></td>
      <td>Last Name: <span data-field="spouse.last_name">{{ spouse.last_name }}</span></td>
      <td>Middle Initial: <span data-field="spouse.middle_initial">{{ spouse.middle_initial }}</span></td>
    </tr>
    <tr>
      <td>Social Security No.: <span data-field="spouse.ssn">{{ spouse.ssn }}</span></td>
      <td>State of Birth: <span data-field="spouse.state_of_birth">{{ spouse.state_of_birth }}</span></td>
      <td>Date of Birth: <span data-field="spouse.date_of_birth">{{ spouse.date_of_birth }}</span></td>
    </tr>
    <tr>
      <td>Home Mailing Address (if different than above):</td>
      <td>(Street)</td>
      <td>(City)</td>
      <td>(State)</td>
      <td>(Zip)</td>
    </tr>
    <tr>
      <td>Phone No(s):</td>
      <td>Home</td>
      <td>Work</td>
      <td>Best Time to Call</td>
      <td>AM/PM</td>
    </tr>
    <tr>
      <td>Email Address:</td>
      <td></td>
      <td></td>
      <td>Home</td>
      <td>Work</td>
    </tr>
  </table>

  <div class="section-title">SECTION 4. Plan(s) Applied for: (Only include the amount of coverage in excess of any existing amount or guaranteed issue amount.)</div>
  <table>
    <thead>
      <tr>
        <td style="width: 30%;">Basic Coverage(s)</td>
        <td style="width: 20%;">Requested Basic Coverage Amount</td>
        <td style="width: 25%;">Optional/Voluntary Coverage(s)</td>
        <td style="width: 25%;">Requested Optional/Voluntary Coverage Amount</td>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Life</td>
        <td><span data-field="coverage_requests[0].basic_amount">{{ coverage_requests[0].basic_amount }}</span></td>
        <td>Employee Life</td>
        <td><span data-field="coverage_requests[0].optional_amount">{{ coverage_requests[0].optional_amount }}</span></td>
      </tr>
      <tr>
        <td>Dependent Life</td>
        <td><span data-field="coverage_requests[1].basic_amount">{{ coverage_requests[1].basic_amount }}</span></td>
        <td>Employee Life & AD&D</td>
        <td><span data-field="coverage_requests[1].optional_amount">{{ coverage_requests[1].optional_amount }}</span></td>
      </tr>
      <tr>
        <td>STD</td>
        <td><span data-field="coverage_requests[2].basic_amount">{{ coverage_requests[2].basic_amount }}</span></td>
        <td>Spouse Life</td>
        <td><span data-field="coverage_requests[2].optional_amount">{{ coverage_requests[2].optional_amount }}</span></td>
      </tr>
      <tr>
        <td>LTD</td>
        <td><span data-field="coverage_requests[3].basic_amount">{{ coverage_requests[3].basic_amount }}</span></td>
        <td>Spouse Life & AD&D</td>
        <td><span data-field="coverage_requests[3].optional_amount">{{ coverage_requests[3].optional_amount }}</span></td>
      </tr>
      <tr>
        <td>LTD with Critical Illness</td>
        <td><span data-field="coverage_requests[4].basic_amount">{{ coverage_requests[4].basic_amount }}</span></td>
        <td>Short Term Disability (STD)</td>
        <td><span data-field="coverage_requests[4].optional_amount">{{ coverage_requests[4].optional_amount }}</span></td>
      </tr>
      <tr>
        <td>Voluntary/Optional Employee Life</td>
        <td><span data-field="coverage_requests[5].basic_amount">{{ coverage_requests[5].basic_amount }}</span></td>
        <td>Long Term Disability (LTD)</td>
        <td><span data-field="coverage_requests[5].optional_amount">{{ coverage_requests[5].optional_amount }}</span></td>
      </tr>
      <tr>
        <td>Voluntary/Optional Employee Life & AD&D</td>
        <td><span data-field="coverage_requests[6].basic_amount">{{ coverage_requests[6].basic_amount }}</span></td>
        <td>Critical Illness (Mark Categories below)</td>
        <td><span data-field="coverage_requests[6].optional_amount">{{ coverage_requests[6].optional_amount }}</span></td>
      </tr>
      <tr>
        <td>Voluntary/Optional Spouse Life</td>
        <td><span data-field="coverage_requests[7].basic_amount">{{ coverage_requests[7].basic_amount }}</span></td>
        <td>Employee $</td>
        <td><span data-field="coverage_requests[7].optional_amount">{{ coverage_requests[7].optional_amount }}</span></td>
      </tr>
      <tr>
        <td>Voluntary/Optional Spouse Life & AD&D</td>
        <td><span data-field="coverage_requests[8].basic_amount">{{ coverage_requests[8].basic_amount }}</span></td>
        <td>Spouse $</td>
        <td><span data-field="coverage_requests[8].optional_amount">{{ coverage_requests[8].optional_amount }}</span></td>
      </tr>
      <tr>
        <td>Voluntary/Optional Short Term Disability (STD)</td>
        <td><span data-field="coverage_requests[9].basic_amount">{{ coverage_requests[9].basic_amount }}</span></td>
        <td>Spouse $</td>
        <td><span data-field="coverage_requests[9].optional_amount">{{ coverage_requests[9].optional_amount }}</span></td>
      </tr>
      <tr>
        <td>Voluntary/Optional Long Term Disability (LTD)</td>
        <td><span data-field="coverage_requests[10].basic_amount">{{ coverage_requests[10].basic_amount }}</span></td>
        <td>Child $</td>
        <td><span data-field="coverage_requests[10].optional_amount">{{ coverage_requests[10].optional_amount }}</span></td>
      </tr>
      <tr>
        <td>Critical Illness (Mark Categories below)</td>
        <td><span data-field="coverage_requests[11].basic_amount">{{ coverage_requests[11].basic_amount }}</span></td>
        <td></td>
        <td>Enter Principal Sum for:</td>
      </tr>
    </tbody>
  </table>

  <div class="section-title">Critical Illness (Mark Categories below)</div>
  <table>
    <tr>
      <td>Heart Category</td>
      <td>Employee $ <span data-field="ci_amounts[0].employee_amount">{{ ci_amounts[0].employee_amount }}</span></td>
      <td>Employee $ <span data-field="ci_amounts[0].employee_amount_2">{{ ci_amounts[0].employee_amount_2 }}</span></td>
      <td>Employee $ <span data-field="ci_amounts[0].employee_amount_3">{{ ci_amounts[0].employee_amount_3 }}</span></td>
    </tr>
    <tr>
      <td>Cancer Category</td>
      <td>Spouse $ <span data-field="ci_amounts[1].spouse_amount">{{ ci_amounts[1].spouse_amount }}</span></td>
      <td>Spouse $ <span data-field="ci_amounts[1].spouse_amount_2">{{ ci_amounts[1].spouse_amount_2 }}</span></td>
      <td>Spouse $ <span data-field="ci_amounts[1].spouse_amount_3">{{ ci_amounts[1].spouse_amount_3 }}</span></td>
    </tr>
    <tr>
      <td>Organ Category</td>
      <td>Child $ <span data-field="ci_amounts[2].child_amount">{{ ci_amounts[2].child_amount }}</span></td>
      <td>Child $ <span data-field="ci_amounts[2].child_amount_2">{{ ci_amounts[2].child_amount_2 }}</span></td>
      <td>Child $ <span data-field="ci_amounts[2].child_amount_3">{{ ci_amounts[2].child_amount_3 }}</span></td>
    </tr>
    <tr>
      <td>Quality of Life Category</td>
      <td></td>
      <td></td>
      <td></td>
    </tr>
  </table>

</div>

<div class="page">
  <div class="section-title">STATEMENT OF HEALTH</div>

  <p>Employee Applicant Gender: <span data-field="health_applicant.gender">{{ health_applicant.gender }}</span> Male <span data-field="health_applicant.gender">{{ health_applicant.gender }}</span> Female Height: <span data-field="health_applicant.height">{{ health_applicant.height }}</span> Ft. <span data-field="health_applicant.height">{{ health_applicant.height }}</span> In. Weight: <span data-field="health_applicant.weight">{{ health_applicant.weight }}</span> lbs.</p>
  <p>Spouse Applicant Gender: <span data-field="health_spouse.gender">{{ health_spouse.gender }}</span> Male <span data-field="health_spouse.gender">{{ health_spouse.gender }}</span> Female Height: <span data-field="health_spouse.height">{{ health_spouse.height }}</span> Ft. <span data-field="health_spouse.height">{{ health_spouse.height }}</span> In. Weight: <span data-field="health_spouse.weight">{{ health_spouse.weight }}</span> lbs.</p>

  <p>In the past 12 months, have you smoked a cigarette, cigar or pipe, chewed tobacco or used tobacco or nicotine in any form?</p>
  <table style="width: 100%;">
    <tr>
      <td>Employee</td>
      <td>Yes</td>
      <td>No</td>
      <td>Spouse</td>
      <td>Yes</td>
      <td>No</td>
    </tr>
  </table>

  <div class="section-title">SECTION 6. Medical Information - To be completed if applying for LIFE or DISABILITY coverages.</div>
  <p>1. Within the past 7 years, have you had, or been told by a physician that you had, or been treated for a condition listed below? (FOR CONDITIONS ANSWERED YES, PLEASE PROVIDE DETAILS IN SECTION 7.)</p>
  <table style="width: 100%;">
    <tr>
      <td>a. Heart or circulatory disorder; liver or kidney disorder; lung or respiratory disorder; mental or nervous disorder; alcoholism, drug or substance abuse; diabetes, cancer, tumor, epilepsy, hepatitis or stroke?</td>
      <td>Employee</td>
      <td>Yes</td>
      <td>No</td>
      <td>Spouse</td>
      <td>Yes</td>
      <td>No</td>
    </tr>
    <tr>
      <td>b. High blood pressure? If answered YES, please provide last reading and date of reading:</td>
      <td>Date: <span data-field="health_conditions[0].date">{{ health_conditions[0].date }}</span></td>
      <td></td>
      <td>Date: <span data-field="health_conditions[1].date">{{ health_conditions[1].date }}</span></td>
      <td></td>
    </tr>
    <tr>
      <td>c. Acquired Immune Deficiency Syndrome (AIDS) or AIDS Related Complex (ARC), or tested positive for antibodies to HIV (Human Immunodeficiency Virus)?</td>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
    </tr>
  </table>

  <p>2. Within the past 5 years, have you been diagnosed with a physical disorder not listed above?</p>
  <table style="width: 100%;">
    <tr>
      <td>Employee</td>
      <td>Yes</td>
      <td>No</td>
      <td>Spouse</td>
      <td>Yes</td>
      <td>No</td>
    </tr>
  </table>

  <p>3. Are you currently under treatment for any medical condition or taking medication? (IF ANSWERED YES, PLEASE PROVIDE DETAILS IN SECTION 7.)</p>
  <table style="width: 100%;">
    <tr>
      <td>Employee</td>
      <td>Yes</td>
      <td>No</td>
      <td>Spouse</td>
      <td>Yes</td>
      <td>No</td>
    </tr>
  </table>

  <p>4. If applying for DISABILITY coverage, please complete these additional questions.</p>
  <table style="width: 100%;">
    <tr>
      <td>a. Are you currently pregnant?</td>
      <td></td>
      <td></td>
    </tr>
    <tr>
      <td>b. Within the past 5 years, have you been diagnosed or treated for:</td>
      <td></td>
      <td></td>
    </tr>
  </table>

  <p>i. Osteoarthritis, Rheumatoid Arthritis, or degenerative joint disease?</p>
  <table style="width: 100%;">
    <tr>
      <td>Employee</td>
      <td>Yes</td>
      <td>No</td>
      <td>Spouse</td>
      <td>Yes</td>
      <td>No</td>
    </tr>
  </table>
  <p>ii. Knee Disorder, Injury or Surgery?</p>
  <table style="width: 100%;">
    <tr>
      <td>Employee</td>
      <td>Yes</td>
      <td>No</td>
      <td>Spouse</td>
      <td>Yes</td>
      <td>No</td>
    </tr>
  </table>
  <p>(FOR CONDITIONS ANSWERED YES, PLEASE PROVIDE DETAILS IN SECTION 7.)</p>

  <div class="section-title">SECTION 7. Provide details for any questions answered YES in SECTION 6. (Attach additional sheet, if needed.)</div>
  <table>
    <thead>
      <tr>
        <td style="width: 15%;">Question Number</td>
        <td style="width: 25%;">Applicant Name</td>
        <td style="width: 30%;">Condition/Treatment/Medication</td>
        <td style="width: 15%;">Date of Diagnosis</td>
        <td style="width: 15%;">Date of Last Symptom</td>
        <td style="width: 10%;">Current Status or Condition</td>
        <td style="width: 10%;">Attending Physician's Name, Address, and Phone Number</td>
      </tr>
    </thead>
    <tbody>
      {% for i in health_details %}
      <tr>
        <td><span data-field="health_details[{{ loop.index0 }}].question_number">{{ health_details[loop.index0].question_number }}</span></td>
        <td><span data-field="health_details[{{ loop.index0 }}].applicant_name">{{ health_details[loop.index0].applicant_name }}</span></td>
        <td><span data-field="health_details[{{ loop.index0 }}].condition_treatment_medication">{{ health_details[loop.index0].condition_treatment_medication }}</span></td>
        <td><span data-field="health_details[{{ loop.index0 }}].date_of_diagnosis">{{ health_details[loop.index0].date_of_diagnosis }}</span></td>
        <td><span data-field="health_details[{{ loop.index0 }}].date_of_last_symptom">{{ health_details[loop.index0].date_of_last_symptom }}</span></td>
        <td><span data-field="health_details[{{ loop.index0 }}].current_status_condition">{{ health_details[loop.index0].current_status_condition }}</span></td>
        <td><span data-field="health_details[{{ loop.index0 }}].physician_info">{{ health_details[loop.index0].physician_info }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

<div class="page">
  <p style="text-align: center; margin-bottom: 30px;">GL4A 10</p>
  <p style="text-align: center;">CONTINUED ON NEXT PAGE</p>
</div>

<div class="page">
