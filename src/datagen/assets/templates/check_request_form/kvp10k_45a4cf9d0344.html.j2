<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; }
  h1, h2 { font-weight: bold; }
  .header-info { display: flex; justify-content: space-between; margin-bottom: 30px; }
  .contact-info { font-size: 12pt; }
  .form-section { margin-bottom: 20px; }
  .line-item-row { display: flex; margin-bottom: 5px; }
  .label { font-weight: normal; }
  .input-line { border-bottom: 1px solid #000; display: inline-block; width: 100%; }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      <h1 style="font-size: 24pt; margin: 0;">CSUN</h1>
      <div class="contact-info" style="margin-top: 10px;">
        CALIFORNIA<br>
        STATE UNIVERSITY<br>
        NORTHRIDGE
      </div>
    </div>
    <div style="text-align: right;">
      <h2 style="font-size: 14pt; margin: 0;">ACCOUNTS PAYABLE</h2>
      <h1 style="font-size: 16pt; margin: 5px 0 0 0;">Check Request Form</h1>
    </div>
  </div>

  <div class="form-section" style="margin-top: 40px;">
    <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
      <div style="width: 45%;">
        <div class="label" style="display: block; margin-bottom: 5px;">Valera Hall 360</div>
        <div class="label" style="display: block; margin-bottom: 5px;">Phone: <span data-field="phone_number">{{ phone_number }}</span></div>
        <div class="label" style="display: block; margin-bottom: 5px;">Fax: <span data-field="fax_number">{{ fax_number }}</span></div>
        <div class="label" style="display: block;">Mail Code: <span data-field="mail_code">{{ mail_code }}</span></div>
      </div>
    </div>
  </div>

  <div class="form-section" style="margin-top: 30px;">
    <h2 style="font-size: 12pt; font-weight: bold;">CHECK REQUEST INFORMATION:</h2>
    <div style="margin-top: 15px;">
      <div style="display: flex; align-items: center; margin-bottom: 15px;">
        <div style="width: 150px; font-weight: bold;">Payee Name:</div>
        <div style="flex-grow: 1; border-bottom: 1px solid #000; margin-left: 10px;">
          <span data-field="payee_name">{{ payee_name }}</span>
        </div>
      </div>
      <div style="display: flex; align-items: center; margin-bottom: 15px;">
        <div style="width: 150px; font-weight: bold;">Address:</div>
        <div style="flex-grow: 1; border-bottom: 1px solid #000; margin-left: 10px;">
          <span data-field="address">{{ address }}</span>
        </div>
      </div>
      <div style="display: flex; align-items: center; margin-bottom: 15px;">
        <div style="width: 150px; font-weight: bold;">Reason for Request:</div>
        <div style="flex-grow: 1; border-bottom: 1px solid #000; margin-left: 10px;">
          <span data-field="reason_for_request">{{ reason_for_request }}</span>
        </div>
      </div>
    </div>
  </div>

  <div class="form-section" style="margin-top: 40px;">
    <h2 style="font-size: 12pt; font-weight: bold;">CHARTFIELDS: (Required)</h2>
    
    <!-- Dynamic Line Items Section -->
    <div style="margin-top: 15px;">
      {% for item in line_items %}
        <div class="line-item-row" style="margin-bottom: 10px;">
          <div style="width: 15%;">
            <div class="label" style="font-weight: bold;">Account:</div>
            <div class="input-line" style="height: 18px;" data-field="account">{{ account }}</div>
          </div>
          <div style="width: 10%;">
            <div class="label" style="font-weight: bold;">Fund:</div>
            <div class="input-line" style="height: 18px;" data-field="fund">{{ fund }}</div>
          </div>
          <div style="width: 15%;">
            <div class="label" style="font-weight: bold;">DeptID:</div>
            <div class="input-line" style="height: 18px;" data-field="deptid">{{ deptid }}</div>
          </div>
          <div style="width: 15%;">
            <div class="label" style="font-weight: bold;">Program:</div>
            <div class="input-line" style="height: 18px;" data-field="program">{{ program }}</div>
          </div>
          <div style="width: 15%;">
            <div class="label" style="font-weight: bold;">Class:</div>
            <div class="input-line" style="height: 18px;" data-field="class">{{ class }}</div>
          </div>
          <div style="width: 15%;">
            <div class="label" style="font-weight: bold;">Project:</div>
            <div class="input-line" style="height: 18px;" data-field="project">{{ project }}</div>
          </div>
          <div style="width: 10%;">
            <div class="label" style="font-weight: bold;">Amount:$</div>
            <div class="input-line" style="height: 18px;" data-field="amount">{{ amount }}</div>
          </div>
        </div>
      {% endfor %}
    </div>

    <!-- Summary Totals -->
    <div style="margin-top: 30px; display: flex; justify-content: flex-end;">
      <div style="width: 300px;">
        <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">
          <span style="font-weight: bold;">Total Amount:</span>
          <span data-field="total_amount">{{ total_amount }}</span>
        </div>
      </div>
    </div>

    <!-- Check Details -->
    <div style="margin-top: 30px;">
      <div style="display: flex; align-items: center; margin-bottom: 15px;">
        <div style="width: 150px; font-weight: bold;">Mail Check:</div>
        <div style="margin-left: 10px;">
          <input type="checkbox" style="margin-right: 5px;"> Yes
          <input type="checkbox" style="margin-right: 5px;"> No
        </div>
        <div style="flex-grow: 1; margin-left: 30px;">
          <div class="label" style="font-weight: bold;">Pick Up Check by:</div>
          <div class="input-line" style="width: 50%;" data-field="pick_up_check_by">{{ pick_up_check_by }}</div>
        </div>
        <div style="width: 100px; text-align: right;">
          <div class="label" style="font-weight: bold;">Ext.#:</div>
          <div class="input-line" style="width: 50%;" data-field="ext">{{ ext }}</div>
        </div>
      </div>
    </div>
  </div>

  <div class="form-section" style="margin-top: 30px;">
    <div style="display: flex; align-items: center; margin-bottom: 15px;">
      <div style="width: 150px; font-weight: bold;">Requested By:</div>
      <div style="flex-grow: 1; border-bottom: 1px solid #000; margin-left: 10px;">
        <span data-field="requested_by_name">{{ requested_by_name }}</span>
      </div>
      <div style="width: 150px; text-align: right; margin-left: 20px;">
        <div class="label" style="font-weight: bold;">Date:</div>
        <div class="input-line" style="width: 50%;" data-field="date">{{ date }}</div>
      </div>
    </div>
    <div style="display: flex; align-items: center; margin-bottom: 15px;">
      <div style="width: 150px; font-weight: bold;">Print Name:</div>
      <div style="flex-grow: 1; border-bottom: 1px solid #000; margin-left: 10px;">
        <span data-field="print_name_requested">{{ print_name_requested }}</span>
      </div>
    </div>
    <div style="display: flex; align-items: center; margin-bottom: 15px;">
      <div style="width: 150px; font-weight: bold;">Financial Approver:</div>
      <div style="flex-grow: 1; border-bottom: 1px solid #000; margin-left: 10px;">
        <span data-field="financial_approver_name">{{ financial_approver_name }}</span>
      </div>
      <div style="width: 150px; text-align: right; margin-left: 20px;">
        <div class="label" style="font-weight: bold;">Date:</div>
        <div class="input-line" style="width: 50%;" data-field="date_2">{{ date_2 }}</div>
      </div>
    </div>
    <div style="display: flex; align-items: center; margin-bottom: 15px;">
      <div style="width: 150px; font-weight: bold;">Print Name:</div>
      <div style="flex-grow: 1; border-bottom: 1px solid #000; margin-left: 10px;">
        <span data-field="print_name_approver">{{ print_name_approver }}</span>
      </div>
    </div>
  </div>

  <div style="margin-top: 50px; border-top: 1px solid #000; padding-top: 10px;">
    <div style="font-weight: bold; text-transform: uppercase;">DO NOT WRITE BELOW THIS LINE – FOR AP OFFICE USE ONLY:</div>
  </div>

  <div style="margin-top: 40px; display: flex; justify-content: space-between;">
    <div style="width: 30%;">
      <div style="display: flex; align-items: center; margin-bottom: 15px;">
        <div style="width: 150px; font-weight: bold;">Voucher ID #:</div>
        <div style="flex-grow: 1; border-bottom: 1px solid #000; margin-left: 10px;">
          <span data-field="voucher_id">{{ voucher_id }}</span>
        </div>
      </div>
    </div>
    <div style="width: 30%;">
      <div style="display: flex; align-items: center; margin-bottom: 15px;">
        <div style="width: 150px; font-weight: bold;">Check#:</div>
        <div style="flex-grow: 1; border-bottom: 1px solid #000; margin-left: 10px;">
          <span data-field="check_number">{{ check_number }}</span>
        </div>
      </div>
    </div>
    <div style="width: 30%; text-align: right;">
      <div style="display: flex; align-items: center; margin-bottom: 15px;">
        <div style="width: 150px; font-weight: bold;">Check Date:</div>
        <div style="flex-grow: 1; border-bottom: 1px solid #000; margin-left: 10px;">
          <span data-field="check_date">{{ check_date }}</span>
        </div>
      </div>
    </div>
  </div>
</div>