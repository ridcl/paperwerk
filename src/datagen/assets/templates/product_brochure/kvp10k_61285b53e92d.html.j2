<!DOCTYPE html>
<html>
<head>
    <title>Descriptive Bulletin</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3, h4 { font-weight: bold; }
        .header-logo { float: right; }
        .section-title { border-bottom: 2px solid #ccc; padding-bottom: 5px; margin-bottom: 20px; }
        .table-container { width: 100%; border-collapse: collapse; margin-top: 15px; }
        .table-container th, .table-container td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        .table-container th { background-color: #f2f2f2; }
        .two-column-layout { display: flex; justify-content: space-between; gap: 40px; }
        .column { flex: 1; }
        .red-line { width: 10px; height: 20px; background-color: red; margin-bottom: 10px; }
    </style>

<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
