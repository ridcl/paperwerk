<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<style>
  @page { size: A4; margin: 0; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: "Liberation Sans", Arial, Helvetica, sans-serif; font-size: 8px; color: #222; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }

  /* Common */
  .page-header-line { border-top: 1px solid #aaa; margin-bottom: 4px; }
  .main-title { font-size: 22px; font-weight: normal; color: #333; line-height: 1.2; margin-bottom: 30px; font-family: "Liberation Serif", Georgia, serif; }
  .main-title span { color: #4a90c4; display: block; }
  .section-block { display: flex; gap: 18px; margin-bottom: 18px; }
  .section-image { width: 90px; flex-shrink: 0; }
  .section-image img { width: 90px; }
  .section-image-label { font-size: 7.5px; color: #555; margin-top: 4px; }
  .section-content { flex: 1; }
  .section-title { font-size: 10px; font-weight: bold; color: #4a90c4; margin-bottom: 2px; }
  .section-subtitle { font-size: 8px; color: #333; margin-bottom: 8px; border-bottom: 1px solid #4a90c4; padding-bottom: 3px; }
  .data-table { width: 100%; border-collapse: collapse; font-size: 7.5px; margin-bottom: 6px; }
  .data-table th { font-weight: bold; text-align: left; padding: 3px 4px; border-bottom: 1px solid #4a90c4; vertical-align: bottom; line-height: 1.2; }
  .data-table td { padding: 2px 4px; border-bottom: 1px dotted #ccc; vertical-align: top; }
  .data-table tr:last-child td { border-bottom: none; }
  .th-blue { color: #4a90c4; }
  .notes { font-size: 7.5px; color: #333; margin-top: 4px; line-height: 1.6; }
  .notes p { margin-bottom: 1px; }
  .delivery-note { font-size: 7.5px; color: #555; margin-top: 6px; }
  .divider { border: none; border-top: 1px solid #ccc; margin: 14px 0; }
  .footer-bar { position: absolute; bottom: 18px; left: 60px; right: 60px; display: flex; justify-content: space-between; font-size: 7px; color: #555; border-top: 1px solid #ccc; padding-top: 4px; }
  .footer-bar .footer-left { font-size: 7px; }
  .footer-bar .footer-right { font-size: 7px; }
  .section-image-block { display: flex; flex-direction: column; align-items: center; }
  .zulassung-label { font-size: 7px; color: #555; margin-top: 6px; font-weight: bold; }
  .zulassung-logo { font-size: 8px; color: #333; margin-top: 2px; }

  /* Index page */
  .index-title { font-size: 22px; font-weight: normal; color: #333; line-height: 1.2; margin-bottom: 20px; font-family: "Liberation Serif", Georgia, serif; }
  .index-title span { color: #4a90c4; display: block; }
  .index-table { width: 100%; border-collapse: collapse; font-size: 7.5px; }
  .index-table th { font-weight: bold; padding: 3px 4px; border-bottom: 1px solid #4a90c4; text-align: left; }
  .index-table td { padding: 2px 4px; border-bottom: 1px dotted #ccc; }
  .index-table tr:last-child td { border-bottom: none; }
  .index-cols { display: flex; gap: 10px; }
  .index-col { flex: 1; }
  .th-seite { color: #4a90c4; }

  /* Contact page */
  .contact-title { font-size: 22px; font-weight: normal; color: #333; margin-bottom: 30px; font-family: "Liberation Serif", Georgia, serif; }
  .contact-cols { display: flex; gap: 30px; }
  .contact-left { flex: 1; font-size: 8px; line-height: 1.6; }
  .contact-right { width: 260px; font-size: 7.5px; line-height: 1.5; color: #333; }
  .contact-section-title { font-weight: bold; font-size: 8.5px; margin-top: 14px; margin-bottom: 2px; }
  .contact-section-title:first-child { margin-top: 0; }
  .contact-country { font-size: 8px; color: #555; margin-top: 10px; margin-bottom: 1px; }
  .contact-right-note { font-size: 7px; line-height: 1.5; color: #333; }
  .rotated-text { position: absolute; right: 10px; top: 50px; writing-mode: vertical-rl; transform: rotate(180deg); font-size: 6.5px; color: #555; }
  .abb-footer { display: flex; align-items: center; justify-content: flex-end; margin-top: 20px; gap: 10px; }
  .abb-tagline { font-size: 9px; color: #333; text-align: right; }
  .abb-logo { font-size: 22px; font-weight: bold; color: #cc0000; letter-spacing: 2px; }
</style>
</head>
<body>

<!-- PAGE 1: EMV-Anschlüsse mit Innengewinde -->
<div class="page">
  <div class="page-header-line"></div>
  <div class="main-title">
    <span data-field="page1.system_title">{{ page1.system_title }}</span>
    <span data-field="page1.page_subtitle">{{ page1.page_subtitle }}</span>
  </div>

  <!-- Section 1: VIMV UN -->
  <div class="section-block">
    <div class="section-image-block section-image">
      <div style="width:90px;height:80px;background:#ddd;display:flex;align-items:center;justify-content:center;font-size:7px;color:#888;">[Bild]</div>
      <div class="section-image-label"><span data-field="page1.section1.image_label">{{ page1.section1.image_label }}</span></div>
    </div>
    <div class="section-content">
      <div class="section-title"><span data-field="page1.section1.product_code">{{ page1.section1.product_code }}</span></div>
      <div class="section-subtitle"><span data-field="page1.section1.description">{{ page1.section1.description }}</span></div>
      <table class="data-table">
        <thead>
          <tr>
            <th>Bestell-Nr.<br>schwarz, IP68</th>
            <th>Gewinde<br>UN</th>
            <th class="th-blue">Passend zu<br>NW</th>
            <th class="th-blue">Passend zu<br>F.CK</th>
            <th class="th-blue">Passend zu<br>F.CU</th>
            <th class="th-blue">Passend zu<br>F.HY</th>
            <th>Gewinde-<br>länge</th>
            <th>Gesamt-<br>länge</th>
          </tr>
        </thead>
        <tbody>
          {% for row in page1.section1.rows %}
          <tr>
