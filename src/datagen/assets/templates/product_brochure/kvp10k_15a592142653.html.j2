  .cover-title { color: #fff; font-size: 22px; font-weight: normal; font-family: "Liberation Sans", Arial; line-height: 1.3; }
  .cover-logo-pma {
    position: absolute; left: 60px; bottom: 110px;
    font-size: 36px; font-weight: bold; color: #2db84b; letter-spacing: 2px;
    font-family: "Liberation Sans", Arial;
  }
  .cover-footer {
    position: absolute; right: 60px; bottom: 50px;
    display: flex; align-items: center; gap: 10px;
  }
  .cover-footer-text { font-size: 9px; color: #444; text-align: right; line-height: 1.5; }
  .abb-logo {
    width: 52px; height: 36px;
    background: #e2000f;
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-size: 18px; font-weight: bold; font-family: "Liberation Sans", Arial;
    letter-spacing: 1px;
  }
  .footer-doc { position: absolute; bottom: 18px; left: 60px; font-size: 7.5px; color: #888; }

  /* Page 2 - blank with thumbnails */
  .p2-thumb {
    position: absolute; right: 0; width: 28px;
