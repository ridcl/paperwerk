  }
  .p2-footer { position: absolute; bottom: 18px; left: 60px; font-size: 7.5px; color: #888; }
  .p2-footer-bold { font-weight: bold; }

  /* Section pages common */
  .section-heading { margin-bottom: 22px; }
  .section-heading .line1 { font-size: 20px; color: #4db8d4; font-weight: normal; font-family: "Liberation Sans", Arial; }
