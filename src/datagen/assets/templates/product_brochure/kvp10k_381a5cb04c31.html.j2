    </div>
    <div style="clear: both;"></div>
    <div style="margin-top: 20px;">
        <div style="font-size: 12px; color: #888;">SMART POWER</div>
        <h1 style="font-size: 36px; margin: 5px 0;">ATEX enclosed safety switches</h1>
        <h2 style="font-size: 24px; margin-top: 5px;">Designed for a potentially explosive atmosphere</h2>
    </div>
    <div style="margin-top: 80px; text-align: center;">
        <!-- Image Placeholder -->
