<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; }
  table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
  td { padding: 5px 0; }
  .header-table td { padding: 0; }
  .input-line { border-bottom: 1px solid #000; min-height: 1.2em; }
</style>

<div class="page">
  <table class="header-table">
    <tr>
      <td style="width: 50%;">
        <div style="font-size: 14px; font-weight: bold;">FOOTHILL'DE ANZA</div>
        <div style="font-size: 12px;">Community College District</div>
      </td>
      <td style="width: 50%; text-align: right;">
        <div style="font-weight: bold;">DISTRICT ACCOUNTS PAYABLE OFFICE</div>
        <div style="font-weight: bold;">DIRECT PAY REQUEST</div>
        <div style="font-size: 12px;">(DO NOT USE FOR MILEAGE, TRAVEL, OR PROFESSIONAL SERVICES)</div>
        <div style="margin-top: 20px;">For Accounting Use Only</div>
        <div style="margin-top: 10px;">BANNER ID: <span data-field="banner_id">{{ banner_id }}</span></div>
        <div style="margin-top: 5px;">BANNER INV: <span data-field="banner_inv">{{ banner_inv }}</span></div>
      </td>
    </tr>
  </table>

  <table style="margin-top: 30px;">
    <tr>
      <td style="width: 33%;">Date of Request: <span class="input-line" data-field="banner_inv_2">{{ banner_inv_2 }}</span></td>
      <td style="width: 33%;">Date Check Required: <span class="input-line" data-field="date_of_request">{{ date_of_request }}</span></td>
      <td style="width: 33%; text-align: right;">Your Reference #: <span class="input-line" style="width: 50%;" data-field="date_check_required">{{ date_check_required }}</span> (Optional)</td>
    </tr>
    <tr>
      <td style="width: 100%; padding-top: 20px;">
        Make Check Payable To: (Please Print)
        <div class="input-line" style="width: 95%;" data-field="your_reference">{{ your_reference }}</div>
      </td>
    </tr>
    <tr>
      <td style="width: 50%; padding-top: 20px;">
        Remit To Address: (Please Print)
        <div class="input-line" style="width: 95%;" data-field="make_check_payable_to">{{ make_check_payable_to }}</div>
      </td>
      <td style="width: 50%; padding-top: 20px;">
        <!-- Placeholder for potential second address/info block if layout implied it -->
      </td>
    </tr>
  </table>

  <h3 style="margin-top: 40px; font-weight: bold;">PLEASE LIST THE INVOICES BELOW: (PROVIDE COMPLETE EXPLANATION AND ATTACH ORIGINAL RECEIPTS)</h3>

  <div style="border: 1px solid #000; padding: 10px; margin-top: 10px;">
    <!-- Invoice Line Items Table -->
    <table>
      <thead>
        <tr>
          <th style="width: 5%;">INDEX (6 digits)</th>
          <th style="width: 15%;">FUND (6 digits)</th>
          <th style="width: 15%;">ORG (6 digits)</th>
          <th style="width: 15%;">ACCT (4 digits)</th>
          <th style="width: 15%;">PROG (6 digits)</th>
          <th style="width: 20%;">AMOUNT</th>
        </tr>
      </thead>
      <tbody>
        {% for item in line_items %}
        <tr>
          <td><span data-field="line_items[{{ loop.index0 }}].index">{{ item.index }}</span></td>
          <td><span data-field="line_items[{{ loop.index0 }}].fund">{{ item.fund }}</span></td>
          <td><span data-field="line_items[{{ loop.index0 }}].org">{{ item.org }}</span></td>
          <td><span data-field="line_items[{{ loop.index0 }}].acct">{{ item.acct }}</span></td>
          <td><span data-field="line_items[{{ loop.index0 }}].prog">{{ item.prog }}</span></td>
          <td><span data-field="line_items[{{ loop.index0 }}].amount">{{ item.amount }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
      <tfoot>
        <tr>
          <td colspan="5" style="text-align: right; font-weight: bold;">TOTAL:</td>
          <td style="font-weight: bold;">$0.00</td>
        </tr>
      </tfoot>
    </table>
  </div>

  <table style="margin-top: 40px;">
    <tr>
      <td style="width: 25%;">Requested by:</td>
      <td style="width: 35%;">First & Last Name (Please Print): <span class="input-line" data-field="requested_by">{{ requested_by }}</span></td>
      <td style="width: 15%;">Extension</td>
      <td style="width: 15%;">Date</td>
      <td style="width: 10%;">EMPLOYEE Signature (Required)</td>
    </tr>
    <tr>
      <td style="width: 25%;">Approved by:</td>
      <td style="width: 35%;">First & Last Name (Please Print): <span class="input-line" data-field="approved_by">{{ approved_by }}</span></td>
      <td style="width: 15%;">Extension</td>
      <td style="width: 15%;">Date</td>
      <td style="width: 10%;">APPROVER Signature (Required)</td>
    </tr>
  </table>

  <p style="margin-top: 60px; font-size: 11px;">Please refer to Delegations of Purchasing and Contracting Authority at: <a href="http://purchasing.fhda.edu/policies">http://purchasing.fhda.edu/policies</a></p>

</div>