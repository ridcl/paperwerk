<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 15px;
  }
  td {
    padding: 5px 0;
    vertical-align: top;
  }
  .form-row td {
    padding-bottom: 10px;
  }
</style>

<div class="page">
  <div style="text-align: center; margin-bottom: 30px;">
    <img src="placeholder_logo.png" alt="Virginia Military Institute Logo" style="width: 100px; height: auto;">
    <h1 style="font-size: 24pt; margin: 10px 0;">Virginia Military Institute</h1>
    <h2 style="font-size: 18pt; margin-top: 5px;">Visiting &amp; Foreign Student Application</h2>
  </div>

  <table style="width: 100%;">
    <tbody>
      <tr class="form-row">
        <td style="width: 20%;">Full Name:</td>
        <td style="width: 20%;"><span data-field="full_name_last">{{ full_name_last }}</span> (Last)</td>
        <td style="width: 20%;"><span data-field="full_name_first">{{ full_name_first }}</span> (First)</td>
        <td style="width: 20%;"></td>
        <td style="width: 20%;">Date of Birth: <span data-field="date_of_birth">{{ date_of_birth }}</span> (Middle)</td>
      </tr>
      <tr class="form-row">
        <td>Sex:</td>
        <td><input type="radio" name="sex" value="Female"> Female</td>
        <td><input type="radio" name="sex" value="Male"> Male</td>
        <td></td>
        <td>State of Legal Residence: <span data-field="state_of_legal_residence">{{ state_of_legal_residence }}</span></td>
      </tr>
      <tr class="form-row">
        <td>County of Legal Residence (if VA):</td>
        <td><span data-field="county_of_legal_residence">{{ county_of_legal_residence }}</span></td>
        <td></td>
        <td>Country of Residence: <span data-field="country_of_residence">{{ country_of_residence }}</span></td>
        <td></td>
      </tr>
      <tr class="form-row">
        <td>Home Address:</td>
        <td colspan="3"><span data-field="home_address">{{ home_address }}</span></td>
        <td>Phone: <span data-field="phone_number">{{ phone_number }}</span></td>
      </tr>
      <tr class="form-row">
        <td>Home Institution:</td>
        <td colspan="3"><span data-field="home_institution">{{ home_institution }}</span></td>
        <td>Phone: <span data-field="home_institution_phone">{{ home_institution_phone }}</span></td>
      </tr>
    </tbody>
  </table>

  <h3 style="margin-top: 20px;">Student's Email: <span data-field="student_email">{{ student_email }}</span></h3>

  <p style="font-size: 10pt; margin-bottom: 15px;">NOTE: Information below is collected for statistical purposes only.</p>

  <table style="width: 100%;">
    <tbody>
      <tr class="form-row">
        <td style="width: 10%;">Race:</td>
        <td style="width: 20%;"><input type="checkbox"> Hispanic</td>
        <td style="width: 20%;"><input type="checkbox"> Non-Hispanic</td>
        <td style="width: 20%;"><input type="checkbox"> Not Reported</td>
      </tr>
      <tr class="form-row">
        <td>Ethnicity:</td>
        <td style="width: 20%;"><input type="checkbox"> Black</td>
        <td style="width: 20%;"><input type="checkbox"> American Indian or Alaskan Native</td>
        <td style="width: 20%;"><input type="checkbox"> Hawaiian/Pacific Islander</td>
      </tr>
      <tr class="form-row">
        <td></td>
        <td style="width: 20%;"><input type="checkbox"> Asian or Pacific Islander</td>
        <td style="width: 20%;"><input type="checkbox"> White, Non-Hispanic</td>
        <td style="width: 20%;"><input type="checkbox"> Not Reported</td>
      </tr>
    </tbody>
  </table>

  <h3 style="margin-top: 30px;">REQUESTED COURSES:</h3>

  <table style="width: 100%;">
    <tbody>
      {% for i in range(1, 7) %}
      <tr class="form-row">
        <td style="width: 20%;">Course # &amp; Section: <span data-field="requested_courses[{{ i-1 }}].course_section">{{ requested_courses[i-1].course_section }}</span></td>
        <td style="width: 80%;">Title: <span data-field="requested_courses[{{ i-1 }}].title">{{ requested_courses[i-1].title }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div style="margin-top: 50px;">
    <p style="font-size: 10pt;">I certify that I am a full-time student and acknowledge that it is my responsibility to notify the Registrar's Office at VMI if I choose not to take or withdraw from the above activity prior to the end of classes. I further authorize the VMI Registrar's Office to release to the respective home institution specific grade information upon request and at the conclusion of each semester of registration. (NOTE: Student grades are posted directly online and can be accessed thru Post View.)</p>
  </div>

  <div style="margin-top: 100px;">
    <table style="width: 100%;">
      <tbody>
        <tr>
          <td style="width: 50%;">
            (Student's Signature)
          </td>
          <td style="width: 50%; text-align: right;">
            (Date)
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>