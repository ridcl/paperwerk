<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>IPEDS Student Financial Aid</title>
<style>
  @page { size: A4; margin: 0; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: "Liberation Sans", Arial, Helvetica, sans-serif; font-size: 11px; color: #000; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }

  /* Page 1 - Cover */
  .main-title {
    font-family: "DejaVu Serif", Georgia, serif;
    font-size: 26px;
    font-weight: 900;
    letter-spacing: 1px;
    margin-bottom: 10px;
  }
  .subtitle {
    font-size: 16px;
    font-weight: normal;
    margin-bottom: 18px;
  }
  .institution-name {
    color: #2255aa;
    font-weight: bold;
    font-size: 12px;
    margin-bottom: 6px;
  }
  .info-table { border-collapse: collapse; }
  .info-table td { padding: 2px 0; vertical-align: top; }
  .info-table td:first-child { font-weight: bold; width: 110px; }

  /* Shared */
  .inst-header {
    background: #b8cce4;
    padding: 3px 6px;
    font-size: 11px;
    margin-bottom: 10px;
  }
  .section-label { font-weight: bold; font-size: 11px; margin-bottom: 2px; }
  .section-title { color: #2255aa; font-weight: bold; font-size: 12px; margin-bottom: 6px; }
  .description { font-size: 10.5px; margin-bottom: 8px; line-height: 1.4; }
  .part-header { font-weight: bold; font-size: 11px; margin-bottom: 2px; }

  /* Page header bar */
  .page-title-bar {
    background: #dce6f1;
    text-align: center;
    font-weight: bold;
    font-size: 11px;
    padding: 4px;
    margin-bottom: 6px;
    border: 1px solid #aaa;
  }

  /* Tables */
  .data-table { width: 100%; border-collapse: collapse; font-size: 10px; margin-top: 6px; }
  .data-table th {
    background: #dce6f1;
    border: 1px solid #aaa;
    padding: 3px 4px;
    text-align: center;
    font-weight: bold;
    vertical-align: bottom;
  }
  .data-table td {
    border: 1px solid #ccc;
    padding: 3px 4px;
    vertical-align: top;
  }
  .data-table td.label-cell { font-size: 10px; }
  .data-table td.num-cell { text-align: right; }
  .data-table td.center-cell { text-align: center; }
  .data-table .shaded { background: #e8e8e8; }
  .data-table .red-val { color: red; font-weight: bold; }
  .data-table .blue-val { color: #2255aa; }
  .input-box {
    border: 1px solid #999;
    background: #fff;
    padding: 1px 3px;
    min-width: 70px;
    display: inline-block;
  }
  .context-note-bar {
    background: #dce6f1;
    color: #2255aa;
    font-weight: bold;
    font-size: 10px;
    padding: 4px 6px;
    margin-top: 8px;
    line-height: 1.4;
  }
  .context-note-box {
    border: 1px solid #aaa;
    background: #f5f5f5;
    height: 36px;
    width: 140px;
    margin-top: 4px;
  }
  ul.bullet-list { margin-left: 20px; margin-bottom: 8px; }
  ul.bullet-list li { font-size: 10.5px; margin-bottom: 4px; line-height: 1.4; }
  .row-indent { padding-left: 16px; }
  .row-indent2 { padding-left: 30px; }
  .bold { font-weight: bold; }
  .arrow-down { color: #2255aa; font-size: 10px; }
</style>

<style>
  @page { size: A4; margin: 0; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: "Liberation Sans", Arial, Helvetica, sans-serif; font-size: 11px; color: #000; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }

  .institution-header {
    background-color: #b8cce4;
    padding: 4px 8px;
    font-size: 11px;
    margin-bottom: 12px;
    display: inline-block;
    width: 100%;
  }
  .part-label { font-weight: bold; font-size: 11px; margin-bottom: 2px; }
  .part-title { color: #1f4e79; font-weight: bold; font-size: 11px; margin-bottom: 6px; }
  .part-desc { font-size: 11px; margin-bottom: 6px; line-height: 1.4; }
  .highlight-blue { background-color: #dce6f1; padding: 6px 8px; margin-bottom: 6px; font-size: 11px; line-height: 1.4; }
  .highlight-blue-bold { background-color: #dce6f1; padding: 6px 8px; margin-bottom: 6px; font-size: 11px; font-weight: bold; color: #1f4e79; line-height: 1.5; }
  .highlight-note { background-color: #dce6f1; padding: 4px 8px; margin-bottom: 4px; font-size: 11px; color: #1f4e79; }
  .context-note { background-color: #dce6f1; padding: 4px 8px; margin-bottom: 4px; font-size: 11px; color: #1f4e79; }

  ul { margin-left: 30px; margin-bottom: 6px; }
  ul li { margin-bottom: 3px; font-size: 11px; line-height: 1.4; }

  table { border-collapse: collapse; width: 100%; font-size: 11px; }
  th, td { padding: 2px 4px; vertical-align: top; }
  .tbl-header { background-color: #f2f2f2; font-weight: bold; text-align: center; border-bottom: 1px solid #ccc; }
  .tbl-subheader { background-color: #f2f2f2; font-weight: bold; }
  .input-cell { border: 1px solid #aaa; background: #fff; min-width: 60px; padding: 1px 3px; display: inline-block; }
  .row-label { font-weight: bold; }
  .row-sublabel { padding-left: 20px; }
  .shaded { background-color: #f2f2f2; }
  .bold { font-weight: bold; }
  .center { text-align: center; }
  .right { text-align: right; }
  .section-divider { border-top: 1px solid #999; margin: 6px 0; }
  .col-year { text-align: center; font-weight: bold; }
  .small { font-size: 10px; }

  /* Summary page */
  .summary-title { text-align: center; font-weight: bold; font-size: 14px; color: #1f4e79; margin-bottom: 10px; font-family: "Liberation Serif", Georgia, serif; }
  .summary-table { border-collapse: collapse; width: 100%; font-size: 11px; margin-bottom: 10px; }
  .summary-table td { padding: 3px 6px; border-bottom: 1px solid #ddd; }
  .summary-table .val { text-align: right; }
  .grant-table { border-collapse: collapse; width: 60%; font-size: 11px; margin-bottom: 10px; }
  .grant-table th { background-color: #f2f2f2; padding: 3px 6px; text-align: left; border: 1px solid #ccc; font-weight: bold; }
  .grant-table td { padding: 3px 6px; border: 1px solid #ccc; }
  .grant-table .val { text-align: right; }
</style>
</head>
<body>

<!-- PAGE 1: Cover / Institution Info -->
<div class="page">
  <div class="main-title">National Center for Education Statistics</div>
  <div class="subtitle">IPEDS Data Center</div>
  <div class="institution-name"><span data-field="institution.name">{{ institution.name }}</span></div>
  <table class="info-table">
    <tr>
      <td>UnitID</td>
      <td><span data-field="institution.unit_id">{{ institution.unit_id }}</span></td>
    </tr>
    <tr>
      <td>OPEID</td>
      <td><span data-field="institution.ope_id">{{ institution.ope_id }}</span></td>
    </tr>
    <tr>
      <td>Address</td>
      <td><span data-field="institution.address">{{ institution.address }}</span></td>
    </tr>
    <tr>
      <td>Web Address</td>
      <td><span data-field="institution.web_address">{{ institution.web_address }}</span></td>
    </tr>
  </table>
</div>

<!-- PAGE 2: Part A -->
<div class="page">
  <div class="page-title-bar">Student Financial Aid <span data-field="survey_year">{{ survey_year }}</span></div>
  <div class="inst-header">Institution: <span data-field="institution.name">{{ institution.name }}</span> (<span data-field="institution.unit_id">{{ institution.unit_id }}</span>)</div>

  <div class="part-header">Part A</div>
  <div class="section-title">Part A - Establish Your Groups</div>
  <div class="description">
    Part A establishes the number of students in various groups. Note that the numbers on this screen will be carried forward to other parts of the Student Financial Aid component.
  </div>
  <div class="description">In the fields below, report the number of students in each of the following groups:</div>

  <table class="data-table">
    <thead>
      <tr>
        <th style="width:52%; text-align:left;"></th>
        <th>Fall <span data-field="part_a.fall_year_current">{{ part_a.fall_year_current }}</span></th>
        <th>Fall <span data-field="part_a.fall_year_current">{{ part_a.fall_year_current }}</span> counts<br>reported on last<br>year's Fall<br>Enrollment survey</th>
        <th>Fall <span data-field="part_a.fall_year_prior">{{ part_a.fall_year_prior }}</span><br>counts reported<br>on last year's<br>SFA survey</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="label-cell"><strong>01. Group 1</strong><br>All undergraduate students enrolled in Fall <span data-field="part_a.fall_year_current">{{ part_a.fall_year_current }}</span></td>
        <td class="num-cell"><div class="input-box"><span data-field="part_a.group1.current_value">{{ part_a.group1.current_value }}</span></div></td>
        <td class="num-cell shaded"><span data-field="part_a.group1.enrollment_survey_value">{{ part_a.group1.enrollment_survey_value }}</span></td>
        <td class="num-cell shaded red-val"><span data-field="part_a.group1.prior_sfa_value">{{ part_a.group1.prior_sfa_value }}</span></td>
      </tr>
      <tr>
        <td class="label-cell"><strong>02. Group 2</strong><br>Of those in Group 1, those who are full-time, first-time degree/certificate-seeking</td>
        <td class="num-cell"><div class="input-box"><span data-field="part_a.group2.current_value">{{ part_a.group2.current_value }}</span></div></td>
        <td class="num-cell shaded"><span data-field="part_a.group2.enrollment_survey_value">{{ part_a.group2.enrollment_survey_value }}</span></td>
        <td class="num-cell shaded red-val"><span data-field="part_a.group2.prior_sfa_value">{{ part_a.group2.prior_sfa_value }}</span></td>
      </tr>
      <tr>
        <td class="label-cell row-indent"><strong>02a.</strong> Of those in Group 2, those who received any Federal Work Study, loans to students, or grant or scholarship aid from the federal government, state/local government, the institution, or other sources known to the institution</td>
        <td class="num-cell"><div class="input-box"><span data-field="part_a.group2a.current_value">{{ part_a.group2a.current_value }}</span></div></td>
        <td class="num-cell shaded"></td>
        <td class="num-cell shaded red-val"><span data-field="part_a.group2a.prior_sfa_value">{{ part_a.group2a.prior_sfa_value }}</span></td>
      </tr>
      <tr>
        <td class="label-cell row-indent"><strong>02b.</strong> Of those in Group 2, those who received any loans to students or grant or scholarship aid from the federal government, state/local government, or the institution</td>
        <td class="num-cell"><div class="input-box"><span data-field="part_a.group2b.current_value">{{ part_a.group2b.current_value }}</span></div></td>
        <td class="num-cell shaded"></td>
        <td class="num-cell shaded"></td>
      </tr>
      <tr>
        <td class="label-cell"><strong>03. Group 3</strong><br>Of those in Group 2, those who <strong>paid the in-state or in-district tuition rate</strong> who received grant or scholarship aid from the federal government, state/local government, or the institution. Exclude other sources of grants.</td>
        <td class="num-cell"><div class="input-box"><span data-field="part_a.group3.current_value">{{ part_a.group3.current_value }}</span></div></td>
        <td class="num-cell shaded"></td>
        <td class="num-cell shaded red-val"><span data-field="part_a.group3.prior_sfa_value">{{ part_a.group3.prior_sfa_value }}</span></td>
      </tr>
      <tr>
        <td class="label-cell"><strong>04. Group 4</strong><br>Of those in Group 2, those who <strong>paid the in-state or in-district tuition rate</strong> who received Title IV federal student aid</td>
        <td class="num-cell"><div class="input-box"><span data-field="part_a.group4.current_value">{{ part_a.group4.current_value }}</span></div></td>
        <td class="num-cell shaded"></td>
        <td class="num-cell shaded red-val"><span data-field="part_a.group4.prior_sfa_value">{{ part_a.group4.prior_sfa_value }}</span></td>
      </tr>
    </tbody>
  </table>
</div>

<!-- PAGE 3: Part B -->
<div class="page">
  <div class="inst-header">Institution: <span data-field="institution.name">{{ institution.name }}</span> (<span data-field="institution.unit_id">{{ institution.unit_id }}</span>)</div>

  <div class="part-header">Part B</div>
  <div class="section-title">Part B - Enter Financial Aid About Group 1</div>
  <div class="description">Group 1 students are all undergraduates enrolled in Fall <span data-field="part_a.fall_year_current">{{ part_a.fall_year_current }}</span>.</div>
  <div class="description">For this part, report:</div>
  <ul class="bullet-list">
    <li>Financial aid received by Group 1 students from all sources: the federal government, state/local government, the institution, and other sources known to the institution</li>
    <li>Financial aid received by Group 1 students at any time during the full aid year (academic year <span data-field="part_b.aid_year">{{ part_b.aid_year }}</span>)</li>
  </ul>
  <div class="description">In the fields below, report the number of Group 1 students and the total amount of aid received by these students for each type of aid.</div>

  <table class="data-table">
    <thead>
      <tr>
        <th style="text-align:left;">Information from Part A:</th>
        <th>Fall <span data-field="part_a.fall_year_current">{{ part_a.fall_year_current }}</span></th>
        <th>Fall <span data-field="part_a.fall_year_prior">{{ part_a.fall_year_prior }}</span></th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="label-cell"><strong>Group 1</strong><br>All undergraduate students enrolled in Fall <span data-field="part_a.fall_year_current">{{ part_a.fall_year_current }}</span><br>(This number is carried forward from Part A, Line 01.)</td>
        <td class="num-cell shaded"><span data-field="part_b.group1_fall_current">{{ part_b.group1_fall_current }}</span></td>
        <td class="num-cell shaded red-val"><span data-field="part_b.group1_fall_prior">{{ part_b.group1_fall_prior }}</span></td>
      </tr>
    </tbody>
  </table>

  <table class="data-table" style="margin-top:10px;">
    <thead>
      <tr>
        <th style="width:30%; text-align:left;">Aid Type</th>
        <th>Number of students in <strong>Group 1</strong><br>receiving aid in <span data-field="part_b.aid_year">{{ part_b.aid_year }}</span></th>
        <th>Percentage of<br>students<br>receiving aid</th>
        <th>Total amount of aid received by<br><strong>Group 1</strong> in <span data-field="part_b.aid_year">{{ part_b.aid_year }}</span></th>
        <th>Average<br>amount of aid<br>received by<br>students in<br><strong>Group 1</strong></th>
      </tr>
    </thead>
    <tbody>
      {% for row in part_b.aid_rows %}
      <tr>
        <td class="label-cell"><strong>{{ loop.index | string | zfill(2) }}.</strong> <span data-field="part_b.aid_rows[{{ loop.index0 }}].label">{{ row.label }}</span></td>
        <td class="num-cell"><div class="input-box"><span data-field="part_b.aid_rows[{{ loop.index0 }}].num_students">{{ row.num_students }}</span></div></td>
        <td class="num-cell shaded"><span data-field="part_b.aid_rows[{{ loop.index0 }}].pct_students">{{ row.pct_students }}</span></td>
        <td class="num-cell"><div class="input-box"><span data-field="part_b.aid_rows[{{ loop.index0 }}].total_amount">{{ row.total_amount }}</span></div></td>
        <td class="num-cell shaded"><span data-field="part_b.aid_rows[{{ loop.index0 }}].avg_amount">{{ row.avg_amount }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="context-note-bar">
    &#x2611; You may use the space below to provide context for data you've reported above. These context notes will be posted on the College Navigator website and should be written to be understood by students and parents.
  </div>
  <div class="context-note-box"></div>
</div>

<!-- PAGE 4: Part C Page 1 -->
<div class="page">
  <div class="inst-header">Institution: <span data-field="institution.name">{{ institution.name }}</span> (<span data-field="institution.unit_id">{{ institution.unit_id }}</span>)</div>

  <div class="part-header">Part C, Page 1</div>
  <div class="section-title">Part C - Enter Financial Aid About Group 2, Page 1</div>
  <div class="description">Group 2 students are all full-time, first-time degree/certificate-seeking undergraduate students enrolled in Fall <span data-field="part_a.fall_year_current">{{ part_a.fall_year_current }}</span>.</div>
  <div class="description">In the fields below, report the number of Group 2 students paying in-district, in-state, and out-of-state tuition rates.</div>

  <table class="data-table">
    <thead>
      <tr>
        <th style="width:40%; text-align:left;">Information from Part A:</th>
        <th>Number of students in Fall <span data-field="part_a.fall_year_current">{{ part_a.fall_year_current }}</span></th>
        <th>Percentage of total number of undergraduate students in Fall <span data-field="part_a.fall_year_current">{{ part_a.fall_year_current }}</span></th>
        <th>Percentage of total undergraduate students in Fall <span data-field="part_a.fall_year_prior">{{ part_a.fall_year_prior }}</span></th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="label-cell"><strong>01. Group 1</strong><br>All undergraduate students enrolled in Fall <span data-field="part_a.fall_year_current">{{ part_a.fall_year_current }}</span><br>(This number is carried forward from A01.)</td>
        <td class="num-cell shaded"><span data-field="part_c1.group1_count">{{ part_c1.group1_count }}</span></td>
        <td class="shaded"></td>
        <td class="shaded"></td>
      </tr>
      <tr>
        <td class="label-cell"><strong>02. Group 2</strong><br>Full-time, first-time degree/certificate-seeking undergraduates enrolled in Fall <span data-field="part_a.fall_year_current">{{ part_a.fall_year_current }}</span><br>(This number is carried forward from A02.)</td>
        <td class="num-cell shaded"><span data-field="part_c1.group2_count">{{ part_c1.group2_count }}</span></td>
        <td class="num-cell shaded"><span data-field="part_c1.group2_pct_current">{{ part_c1.group2_pct_current }}</span></td>
        <td class="num-cell shaded red-val"><span data-field="part_c1.group2_pct_prior">{{ part_c1.group2_pct_prior }}</span></td>
      </tr>
      <tr>
        <td class="label-cell"><strong>02a.</strong> Of those in Group 2, those who received any Federal Work Study, loans to students, or grant or scholarship aid from the federal government, state/local government, the institution, or other sources known to the institution<br>(This number is carried forward from Part A, Line 02a.)</td>
        <td class="num-cell shaded"><span data-field="part_c1.group2a_count">{{ part_c1.group2a_count }}</span></td>
        <td class="num-cell shaded"><span data-field="part_c1.group2a_pct_current">{{ part_c1.group2a_pct_current }}</span></td>
        <td class="num-cell shaded red-val"><span data-field="part_c1.group2a_pct_prior">{{ part_c1.group2a_pct_prior }}</span></td>
      </tr>
      <tr>
        <td class="label-cell"><strong>02b.</strong> Of those in Group 2, those who received any loans to students or grant or scholarship aid from the federal government, state/local government, or the institution</td>
        <td class="num-cell shaded"><span data-field="part_c1.group2b_count">{{ part_c1.group2b_count }}</span></td>
        <td class="num-cell shaded"><span data-field="part_c1.group2b_pct_current">{{ part_c1.group2b_pct_current }}</span></td>
        <td class="shaded"></td>
      </tr>
      <tr>
        <td class="label-cell bold"><strong>04. Group 2</strong> students:</td>
        <th class="center-cell">Number of Group 2 students in Fall <span data-field="part_a.fall_year_current">{{ part_a.fall_year_current }}</span></th>
        <th class="center-cell">Percentage of Group 2 students in Fall <span data-field="part_a.fall_year_current">{{ part_a.fall_year_current }}</span></th>
        <th class="center-cell">Percentage of Group 2 students in Fall <span data-field="part_a.fall_year_prior">{{ part_a.fall_year_prior }}</span></th>
      </tr>
      <tr>
        <td class="label-cell">04a. paying in-district tuition rates</td>
        <td class="num-cell"><div class="input-box"><span data-field="part_c1.in_district_count">{{ part_c1.in_district_count }}</span></div></td>
        <td class="num-cell shaded"><span data-field="part_c1.in_district_pct_current">{{ part_c1.in_district_pct_current }}</span></td>
        <td class="num-cell shaded red-val"><span data-field="part_c1.in_district_pct_prior">{{ part_c1.in_district_pct_prior }}</span></td>
      </tr>
      <tr>
        <td class="label-cell">04b. paying in-state tuition rates</td>
        <td class="num-cell"><div class="input-box"><span data-field="part_c1.in_state_count">{{ part_c1.in_state_count }}</span></div></td>
        <td class="num-cell shaded"><span data-field="part_c1.in_state_pct_current">{{ part_c1.in_state_pct_current }}</span></td>
        <td class="num-cell shaded red-val"><span data-field="part_c1.in_state_pct_prior">{{ part_c1.in_state_pct_prior }}</span></td>
      </tr>
      <tr>
        <td class="label-cell">04c. paying out-of-state tuition rates</td>
        <td class="num-cell"><div class="input-box"><span data-field="part_c1.out_of_state_count">{{ part_c1.out_of_state_count }}</span></div></td>
        <td class="num-cell shaded"><span data-field="part_c1.out_of_state_pct_current">{{ part_c1.out_of_state_pct_current }}</span></td>
        <td class="num-cell shaded red-val"><span data-field="part_c1.out_of_state_pct_prior">{{ part_c1.out_of_state_pct_prior }}</span></td>
      </tr>
      <tr>
        <td class="label-cell"><strong>04d.</strong> Unknown (calculated value)<br>This value is calculated using the following formula: [02-(04a+04b+04c)]</td>
        <td class="num-cell shaded"><span data-field="part_c1.unknown_count">{{ part_c1.unknown_count }}</span></td>
        <td class="num-cell shaded"><span data-field="part_c1.unknown_pct_current">{{ part_c1.unknown_pct_current }}</span></td>
        <td class="num-cell shaded red-val"><span data-field="part_c1.unknown_pct_prior">{{ part_c1.unknown_pct_prior }}</span></td>
      </tr>
    </tbody>
  </table>

  <div class="context-note-bar">
    &#x2611; You may use the space below to provide context for data you've reported above. These context notes will be posted on the College Navigator website and should be written to be understood by students and parents.
  </div>
  <div class="context-note-box"></div>
</div>

<!-- PAGE 5: Part C Page 2 -->
<div class="page">
