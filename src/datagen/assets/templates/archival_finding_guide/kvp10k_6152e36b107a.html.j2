        <th style="width: 70%;"></th>
        <th style="width: 15%;">Box</th>
        <th style="width: 15%;">Folder</th>
      </tr>
    </thead>
    <tbody>
      {% for item in inventory_items %}
      <tr>
        <td><span data-field="inventory_items[{{ loop.index0 }}].description">{{ item.description }}</span></td>
