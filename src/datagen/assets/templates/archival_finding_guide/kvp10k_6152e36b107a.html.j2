<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  h1, h2, h3, h4 {
    font-weight: bold;
  }
  .header-title {
    text-align: center;
    margin-bottom: 20px;
  }
  .logo-container {
    text-align: center;
    margin: 20px 0;
  }
  .footer {
    text-align: center;
    position: absolute;
    bottom: 50px;
    width: 100%;
    font-size: 0.8em;
  }
  .table-container {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
  }
  .table-container th, .table-container td {
    padding: 8px 0;
    text-align: left;
  }
  .table-container th {
    font-weight: bold;
    border-bottom: 1px solid #ccc;
  }
</style>

<div class="page">
  <div class="header-title">
    <span data-field="institution_name">{{ institution_name }}</span>
  </div>
  <div class="logo-container">
    <!-- Placeholder for logo image -->
  </div>
  <div class="header-title">
    <span data-field="archives_center_name">{{ archives_center_name }}</span>
  </div>
  <div class="header-title" style="margin-top: 50px;">
    <span data-field="collection_title">{{ collection_title }}</span>
    <div style="font-size: 0.9em; margin-top: 10px;">
      <span data-field="date_range">{{ date_range }}</span>
    </div>
  </div>
  <div style="text-align: center; margin-top: 50px;">
    <span data-field="size">{{ size }}</span>
  </div>
  <div style="text-align: center; margin-top: 20px;">
    <span data-field="inventory_id">{{ inventory_id }}</span>
  </div>
</div>

<div class="page">
  <div style="text-align: right; font-size: 0.9em;">
    <span data-field="inventory_id">{{ inventory_id }}</span>
  </div>
  <div style="text-align: center; margin-top: 100px;">
    <span data-field="archives_center_name">{{ archives_center_name }}</span>
  </div>
  <div style="text-align: center; margin-top: 20px;">
    <span data-field="address_line_1">{{ address_line_1 }}</span><br>
    <span data-field="city_state_zip">{{ city_state_zip }}</span><br>
    <span data-field="phone">{{ phone }}</span><br>
    <span data-field="fax">{{ fax }}</span><br>
    <span data-field="website">{{ website }}</span><br>
    <span data-field="director_name">{{ director_name }}</span>
  </div>
</div>

