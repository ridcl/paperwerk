<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  h1, h2, h3, h4 {
    font-weight: bold;
  }
  .center-text {
    text-align: center;
  }
  .right-align {
    text-align: right;
  }
  .divider {
    border-top: 1px solid #000;
    margin-top: 10px;
    margin-bottom: 10px;
  }
</style>
<div class="page">
  <div class="center-text">
    <span data-field="institution_name">{{ institution_name }}</span>
    <div style="margin: 20px 0;">
      <!-- Placeholder for University Logo -->
    </div>
    <span data-field="archives_center_name">{{ archives_center_name }}</span>
  </div>
  <div class="center-text" style="margin-top: 50px;">
    <span data-field="guide_title">{{ guide_title }}</span>
    <div style="margin-top: 10px;">
      <span data-field="record_period">{{ record_period }}</span>
    </div>
    <div style="margin-top: 20px;">
      <span data-field="volume_size">{{ volume_size }}</span>
    </div>
    <div style="margin-top: 5px;">
      <span data-field="accession_number">{{ accession_number }}</span>
    </div>
  </div>
</div>
<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      <span data-field="archives_center_name">{{ archives_center_name }}</span>
      <div style="margin-top: 10px;">
        <span data-field="address_line_1">{{ address_line_1 }}</span><br>
        <span data-field="city_state_zip">{{ city_state_zip }}</span><br>
        <span data-field="phone">{{ phone }}</span><br>
        <span data-field="fax">{{ fax }}</span><br>
        <span data-field="website">{{ website }}</span>
      </div>
      <div style="margin-top: 20px;">
        <span data-field="director_name">{{ director_name }}</span>
      </div>
    </div>
  </div>
</div>
<div class="page">
  <div class="center-text">
    <span data-field="collection_title">{{ collection_title }}</span>
    <div style="margin-top: 10px;">
      <span data-field="accession_number">{{ accession_number }}</span>
    </div>
  </div>
  <div class="center-text" style="margin-top: 50px;">
    <span data-field="guide_title">{{ guide_title }}</span><br>
    <span data-field="collection_description">{{ collection_description }}</span><br>
    <span data-field="record_period">{{ record_period }}</span>
    <div style="margin-top: 20px;">
      <span data-field="volume_size">{{ volume_size }}</span>
    </div>
    <div style="margin-top: 5px;">
      <span data-field="accession_number">{{ accession_number }}</span>
    </div>
  </div>
  <div class="center-text" style="margin-top: 50px;">
    <span data-field="access_statement">Access is granted in accordance with the <span data-field="protocols_link">{{ access_statement">Access is granted in accordance with the <span data-field= }}</span>.</span>
  </div>
  <div class="center-text" style="margin-top: 50px;">
    <span data-field="section_heading">{{ section_heading }}</span>
  </div>
  <div class="center-text" style="margin-top: 10px;">
    <span data-field="arrangement_note">{{ arrangement_note }}</span>
  </div>
</div>
<div class="page">
  <div class="center-text">
    <span data-field="collection_title">{{ collection_title }}</span>
    <div style="margin-top: 10px;">
      <span data-field="accession_number">{{ accession_number }}</span>
    </div>
  </div>
  <div class="center-text" style="margin-top: 50px;">
    <span data-field="collection_title">{{ collection_title }}</span><br>
    <span data-field="record_period">{{ record_period }}</span>
    <div style="margin-top: 20px;">
      <span data-field="volume_size">{{ volume_size }}</span>
    </div>
    <div style="margin-top: 5px;">
      <span data-field="access_statement">Access is granted in accordance with the <span data-field="protocols_link">{{ access_statement">Access is granted in accordance with the <span data-field= }}</span>.</span>
    </div>
  </div>
  <div class="center-text" style="margin-top: 50px;">
    <span data-field="section_heading">{{ section_heading }}</span>
  </div>
  <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
    <thead>
      <tr style="border-bottom: 1px solid #000;">
        <td style="padding: 5px; width: 60%;"></td>
        <td style="padding: 5px; width: 20%; text-align: center;">Box</td>
        <td style="padding: 5px; width: 20%; text-align: center;">Folder</td>
      </tr>
    </thead>
    <tbody>
      {% for item in inventory_list %}
      <tr style="border-bottom: 1px solid #000;">
        <td style="padding: 5px;"><span data-field="inventory_list[{{ loop.index0 }}].description">{{ item.description }}</span></td>
        <td style="padding: 5px; text-align: center;"><span data-field="inventory_list[{{ loop.index0 }}].box">{{ item.box }}</span></td>
        <td style="padding: 5px; text-align: center;"><span data-field="inventory_list[{{ loop.index0 }}].folder">{{ item.folder }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
