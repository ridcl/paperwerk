<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic typography mirroring the source */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1, h2, h3 { font-weight: bold; }
  .center { text-align: center; }
  .right { text-align: right; }
  .left { text-align: left; }
  .divider { border-top: 1px solid #000; margin: 10px 0; }
</style>
<body>
  <div class="page">
    <div class="center">
      <span style="font-size: 18pt;">University of Pennsylvania</span>
      <div style="margin: 20px 0;">
        <!-- Placeholder for University Seal Image -->
        <div style="width: 100px; height: 100px; border: 1px solid #ccc; margin: 0 auto;"></div>
      </div>
      <span style="font-size: 14pt;">The University Archives</span>
      <span style="font-size: 14pt;">and Records Center</span>
    </div>
    <div class="center" style="margin-top: 50px;">
      <span style="font-size: 14pt;">A Guide to the</span>
      <span style="font-size: 14pt;">Office of Assistance to the President. University</span>
      <span style="font-size: 14pt;">Art Collection and Art Committee Records</span>
      <span style="font-size: 12pt; margin-top: 10px;">{{ date_range }}</span>
      <span style="font-size: 12pt; margin-top: 5px;">{{ volume_size }}</span>
    </div>
    <div class="center" style="margin-top: 100px;">
      <span style="font-size: 10pt;">UPA 5.2</span>
    </div>
  </div>

  <div class="page">
    <div class="left">
      <span style="font-size: 12pt;">The University Archives and Records Center</span>
      <div style="margin-top: 10px;">
        <span data-field="address_line_1">{{ address_line_1 }}</span><br>
        <span data-field="address_line_2">{{ address_line_2 }}</span><br>
        <span data-field="city_state_zip">{{ city_state_zip }}</span><br>
        <span data-field="phone">{{ phone }}</span><br>
        <span data-field="fax">{{ fax }}</span><br>
        <span data-field="website">{{ website }}</span><br>
        <span data-field="director_name">{{ director_name }}</span>, Director
      </div>
    </div>
  </div>

  <div class="page">
    <div class="center" style="margin-top: 100px;">
      <span style="font-size: 14pt;">Office of Assistance to the President. University</span>
      <span style="font-size: 14pt;">Art Collection and Art Committee Records</span>
      <span style="font-size: 12pt; margin-top: 5px;">{{ date_range }}</span>
      <span style="font-size: 12pt; margin-top: 5px;">UPA 5.2</span>
    </div>
    <div class="center" style="margin-top: 50px;">
      <span style="font-size: 10pt;">Access is granted in accordance with the <a href="#" data-field="protocols_link">{{ protocols_link }}</a>.</span>
    </div>
  </div>

  <div class="page">
    <div class="center" style="margin-top: 100px;">
      <span style="font-size: 14pt;">TABLE OF CONTENTS</span>
    </div>
    <div style="margin-top: 40px;">
      <table style="width: 100%; border-collapse: collapse; font-size: 11pt;">
        <tr>
          <td style="width: 50%; padding: 2px 0;"><span data-field="toc_scope_note">{{ toc_scope_note }}</span></td>
          <td class="right" style="width: 20%; padding: 2px 0;">..................................................................................................</td>
          <td class="right" style="width: 10%; padding: 2px 0;">1</td>
        </tr>
        <tr>
          <td style="width: 50%; padding: 2px 0;"><span data-field="toc_inventory">{{ toc_inventory }}</span></td>
          <td class="right" style="width: 20%; padding: 2px 0;">..................................................................................................</td>
          <td class="right" style="width: 10%; padding: 2px 0;">2</td>
        </tr>
        <tr>
          <td style="width: 50%; padding: 2px 0;"><span data-field="toc_art_correspondence">{{ toc_art_correspondence }}</span></td>
          <td class="right" style="width: 20%; padding: 2px 0;">..................................................................................................</td>
          <td class="right" style="width: 10%; padding: 2px 0;">2</td>
        </tr>
        <tr>
          <td style="width: 50%; padding: 2px 0;"><span data-field="toc_fine_arts_committee">{{ toc_fine_arts_committee }}</span></td>
          <td class="right" style="width: 20%; padding: 2px 0;">..................................................................................................</td>
          <td class="right" style="width: 10%; padding: 2px 0;">3</td>
        </tr>
      </table>
    </div>
  </div>

  <div class="page">
    <div class="center" style="margin-top: 100px;">
      <span style="font-size: 14pt;">Guide to the</span>
      <span style="font-size: 14pt;">Office of Assistance to the President. University</span>
      <span style="font-size: 14pt;">Art Collection and Art Committee Records</span>
      <span style="font-size: 12pt; margin-top: 5px;">{{ date_range }}</span>
      <span style="font-size: 12pt; margin-top: 5px;">UPA 5.2</span>
    </div>
    <div class="center" style="margin-top: 50px;">
      <span style="font-size: 12pt;">{{ volume_size }} Cubic feet</span>
    </div>
    <div class="center" style="margin-top: 100px;">
      <span style="font-size: 10pt;">Access is granted in accordance with the <a href="#" data-field="protocols_link">{{ protocols_link }}</a>.</span>
    </div>
    <div class="center" style="margin-top: 50px;">
      <span style="font-size: 12pt;">SCOPE AND CONTENT NOTE</span>
    </div>
    <div style="margin-top: 20px; font-size: 11pt; line-height: 1.5;">
      <span data-field="scope_note_text">{{ scope_note_text }}</span>
    </div>
  </div>

  <div class="page">
    <div class="center" style="margin-top: 100px;">
      <span style="font-size: 14pt;">Office of Assistance to the President. University</span>
      <span style="font-size: 14pt;">Art Collection and Art Committee Records</span>
      <span style="font-size: 12pt; margin-top: 5px;">{{ date_range }}</span>
      <span style="font-size: 12pt; margin-top: 5px;">UPA 5.2</span>
    </div>
    <div class="center" style="margin-top: 50px;">
      <span style="font-size: 10pt;">Access is granted in accordance with the <a href="#" data-field="protocols_link">{{ protocols_link }}</a>.</span>
    </div>
    <div class="center" style="margin-top: 50px;">
      <span style="font-size: 14pt;">INVENTORY</span>
    </div>

    <div style="margin-top: 40px;">
      <table style="width: 100%; border-collapse: collapse; font-size: 11pt;">
        <thead>
          <tr style="background-color: #f0f0f0;">
            <th style="padding: 8px; text-align: left;">ART AND ART OBJECTS, CORRESPONDENCE</th>
            <th style="padding: 8px; text-align: center;">Box</th>
            <th style="padding: 8px; text-align: center;">Folder</th>
          </tr>
        </thead>
        <tbody>
          {% for item in inventory_art_correspondence %}
          <tr>
            <td style="padding: 8px;">{{ item.description }}</td>
            <td style="padding: 8px; text-align: center;">{{ item.box }}</td>
            <td style="padding: 8px; text-align: center;">{{ item.folder }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  <div class="page">
    <div class="center" style="margin-top: 100px;">
      <span style="font-size: 14pt;">Office of Assistance to the President. University</span>
      <span style="font-size: 14pt;">Art Collection and Art Committee Records</span>
      <span style="font-size: 12pt; margin-top: 5px;">{{ date_range }}</span>
      <span style="font-size: 12pt; margin-top: 5px;">UPA 5.2</span>
    </div>
    <div class="center" style="margin-top: 50px;">
      <span style="font-size: 14pt;">INVENTORY</span>
    </div>

    <div style="margin-top: 40px;">
      <table style="width: 100%; border-collapse: collapse; font-size: 11pt;">
        <thead>
          <tr style="background-color: #f0f0f0;">
            <th style="padding: 8px; text-align: left;">FINE ARTS COMMITTEE</th>
            <th style="padding: 8px; text-align: center;">Box</th>
            <th style="padding: 8px; text-align: center;">Folder</th>
          </tr>
        </thead>
        <tbody>
          {% for item in inventory_fine_arts_committee %}
          <tr>
            <td style="padding: 8px;">{{ item.description }}</td>
            <td style="padding: 8px; text-align: center;">{{ item.box }}</td>
            <td style="padding: 8px; text-align: center;">{{ item.folder }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</body>