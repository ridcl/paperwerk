<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
    margin-bottom: 20px;
  }
  th, td {
    padding: 8px 12px;
    text-align: left;
    border-bottom: 1px solid #ddd;
  }
  th {
    background-color: #f2f2f2;
    font-weight: bold;
  }
  .header-title {
    font-size: 24pt;
    font-weight: bold;
    margin-bottom: 5px;
  }
  .sub-header {
    font-size: 14pt;
    font-weight: bold;
    margin-bottom: 20px;
  }
  .logo {
    position: absolute;
    top: 40px;
    right: 60px;
    font-size: 48pt;
    font-weight: bold;
    color: #cc0000; /* Placeholder color matching visual style */
  }
  .footer-text {
    font-size: 9pt;
    margin-top: 40px;
    text-align: center;
  }
  .contact-info {
    font-size: 10pt;
    margin-top: 20px;
  }
  .contact-info p {
    margin: 3px 0;
  }
</style>

<div class="page">
  <div class="logo">ABB</div>
  <div class="header-title">Course Schedule 2019</div>
  <div class="sub-header">ABB India Limited</div>

  <table>
    <thead>
      <tr>
        <th style="width: 5%;">Sr. No.</th>
        <th style="width: 50%;">Product Category</th>
        <th style="width: 10%;">Page No.</th>
      </tr>
    </thead>
    <tbody>
      {% for i in range(1, 17) %}
      <tr>
        <td>{{ i }}</td>
        <td><span data-field="product_category_{{ i }}">{{ "Category Name" if i == 1 else "Category Name" }}</span></td>
        <td>{{ i }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

