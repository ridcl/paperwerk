        <div style="font-size: 30pt; font-weight: bold;">ABB</div>
      </div>
    </div>

    <table>
      <thead>
        <tr>
          <th style="width: 5%;">Sr. No.</th>
          <th style="width: 35%;">Course Name</th>
          <th style="width: 15%;">Course No.</th>
          <th style="width: 10%;">Days</th>
          <th style="width: 35%;">Remarks</th>
        </tr>
      </thead>
      <tbody>
        {% for item in course_schedule %}
        <tr>
          <td><span data-field="course_schedule[{{ loop.index0 }}].sr_no">{{ item.sr_no }}</span></td>
          <td><span data-field="course_schedule[{{ loop.index0 }}].course_name">{{ item.course_name }}</span></td>
          <td><span data-field="course_schedule[{{ loop.index0 }}].course_no">{{ item.course_no }}</span></td>
          <td><span data-field="course_schedule[{{ loop.index0 }}].days">{{ item.days }}</span></td>
          <td><span data-field="course_schedule[{{ loop.index0 }}].remarks">{{ item.remarks }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <div style="margin-top: 40px;">
      <table style="width: 100%;">
        <thead>
          <tr>
            <th style="width: 10%;">Week no.</th>
            {% for month in ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'] %}
            <th style="width: 8%;">{{ month }}</th>
            {% endfor %}
          </tr>
          <tr>
            <th style="width: 10%;"></th>
            {% for day in range(1, 32) %}
            <th style="width: 8%;">{{ day }}</th>
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          <!-- Calendar grid structure would go here, but since the source is a static grid representation, we mimic the structure -->
          <tr>
            <td style="text-align: left; font-weight: bold;">Week no.</td>
            {% for day in range(1, 32) %}
            <td></td>
            {% endfor %}
          </tr>
        </tbody>
      </table>
    </div>

    <div style="margin-top: 80px;">
      <div style="display: flex; justify-content: space-between;">
        <div style="width: 50%;">
          <div style="font-weight: bold;">Venue:</div>
          <div class="footer-text"><span data-field="venue_details">{{ venue_details }}</span></div>
        </div>
        <div style="width: 50%; text-align: right;">
          <div style="font-weight: bold;">Contact Person:</div>
          <div class="footer-text">
            <span data-field="contact_person_name">{{ contact_person_name }}</span> |
            Email: <span data-field="contact_email">{{ contact_email }}</span> |
            Mobile: <span data-field="contact_mobile">{{ contact_mobile }}</span> |
            Phone: <span data-field="contact_phone">{{ contact_phone }}</span>
          </div>
        </div>
      </div>
      <div class="footer-text" style="margin-top: 20px;">
        The latest version of our course schedule can be found on internet link: <span data-field="internet_link">{{ internet_link }}</span>
      </div>
    </div>

    <div style="position: absolute; bottom: 50px; right: 60px; font-size: 10pt;">17</div>
  </div>
</body>