<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    line-height: 1.5;
  }
  h1 {
    text-align: center;
    font-size: 24pt;
    margin-bottom: 5px;
  }
  h2 {
    font-size: 14pt;
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 5px;
  }
  .course-header {
    border-top: 1px solid #ccc;
    border-bottom: 1px solid #ccc;
    padding: 10px 0;
    margin-bottom: 15px;
  }
  .course-header span {
    font-weight: bold;
  }
  .details p {
    margin: 2px 0;
    font-size: 11pt;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
    margin-bottom: 20px;
    font-size: 10pt;
  }
  th, td {
    border: 1px solid #ddd;
    padding: 8px;
    text-align: left;
  }
  th {
    background-color: #f2f2f2;
    font-weight: bold;
  }
  .section-title {
    font-weight: bold;
    margin-top: 15px;
    margin-bottom: 5px;
  }
</style>
<div class="page">
  <h1>SUMMER 2014 SCHEDULE</h1>
  <p>Registration Dates: <span data-field="registration_dates">{{ registration_dates }}</span></p>

  <div class="course-header">
    <span>DEVELOPMENTAL MATHEMATICS - 60076 - MATH 001 - 01</span>
  </div>
  <div class="details">
    <p>Levels: <span data-field="levels">{{ levels }}</span></p>
    <p>Instructors: <span data-field="instructors">{{ instructors }}</span></p>
    <p>Main Campus</p>
    <p>Lecture Schedule Type: <span data-field="schedule_type">{{ schedule_type }}</span></p>
    <p><span data-field="credits">{{ credits }}</span></p>
  </div>

  <div class="section-title">Scheduled Meeting Times</div>
  <table>
    <thead>
      <tr>
        <th>Type Time</th>
        <th>Days</th>
        <th>Where</th>
        <th>Date Range</th>
        <th>Schedule Type</th>
        <th>Instructors</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Class 9:00 am - 9:50 am</td>
        <td>MTWRF</td>
        <td>Charles F. Moore Building - 207</td>
        <td><span data-field="date_range">{{ date_range }}</span></td>
        <td>Lecture</td>
        <td><span data-field="instructors">{{ instructors }}</span></td>
