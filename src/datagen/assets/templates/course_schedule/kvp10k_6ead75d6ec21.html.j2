<!DOCTYPE html>
<html>
<head>
    <title>Schedule</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
        }
        .page:last-child { page-break-after: auto; }
        body {
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, Helvetica, Arial, sans-serif;
            margin: 0;
            padding: 0;
        }
        h1, h2, h3 {
            font-weight: bold;
        }
        .header-info {
            display: flex;
            justify-content: space-between;
            margin-bottom: 40px;
        }
        .logo-container {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }
        .university-name {
            font-size: 36pt;
            line-height: 1;
        }
        .logo-graphic {
            margin-bottom: 10px;
        }
        .contact-info {
            text-align: right;
            font-size: 10pt;
        }
        .schedule-title {
            text-align: center;
            margin-bottom: 30px;
        }
        .course-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 10pt;
        }
        .course-table th, .course-table td {
            padding: 8px 0;
            text-align: left;
        }
        .course-table tr:nth-child(even) {
            background-color: #f9f9f9;
        }
        .course-code {
            width: 10%;
            font-weight: bold;
        }
        .course-title {
            width: 55%;
        }
        .course-details {
            width: 35%;
            text-align: right;
        }
        .divider {
            border-top: 1px solid #ccc;
            margin: 30px 0;
        }
        .section-header {
            font-size: 14pt;
            font-weight: bold;
            margin-top: 30px;
            margin-bottom: 15px;
        }
        .academic-calendar-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 10pt;
        }
        .academic-calendar-table th, .academic-calendar-table td {
            padding: 8px 0;
            text-align: left;
        }
        .footer {
            text-align: center;
            font-size: 8pt;
            margin-top: 50px;
        }
    </style>

<style>
