<body>

<div class="page">
    <div class="header-info">
        <div class="logo-container">
            <div class="logo-graphic">
                <!-- Placeholder for Lincoln University Seal -->
            </div>
            <div class="university-name">LINCOLN UNIVERSITY</div>
        </div>
        <div class="contact-info">
            <span data-field="university.address">{{ university.address }}</span><br>
            Tel: <span data-field="university.phone">{{ university.phone }}</span><br>
            Fax: <span data-field="university.fax">{{ university.fax }}</span><br>
            E-mail: <span data-field="university.email">{{ university.email }}</span><br>
            Website: <span data-field="university.website">{{ university.website }}</span>
        </div>
    </div>

    <div class="schedule-title">
        <h1>LINCOLN UNIVERSITY</h1>
        <h2>COLLEGE OF GRADUATE AND UNDERGRADUATE STUDIES</h2>
        <h3>FALL SCHEDULE 2020</h3>
        <p>Date: <span data-field="schedule_date">{{ schedule_date }}</span></p>
    </div>

    <div class="section-header">BUSINESS ADMINISTRATION - GRADUATE LEVEL COURSES</div>
    <table class="course-table">
        <thead>
            <tr>
                <th class="course-code">Course</th>
                <th class="course-title">Title</th>
                <th class="course-details">Time & Instructor</th>
            </tr>
        </thead>
        <tbody>
            {% for course in graduate_courses %}
            <tr>
                <td class="course-code">{{ course.code }}</td>
                <td class="course-title">{{ course.title }}</td>
                <td class="course-details">{{ course.day }} {{ course.time }} with {{ course.instructor }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="divider"></div>

    <div class="section-header">BUSINESS ADMINISTRATION - UNDERGRADUATE LEVEL COURSES</div>
