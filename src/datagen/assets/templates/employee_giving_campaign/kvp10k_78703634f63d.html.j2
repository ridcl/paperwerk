<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1 { text-align: center; font-size: 24pt; margin-bottom: 5px; }
  h2 { text-align: center; font-size: 14pt; margin-top: 0; margin-bottom: 30px; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 20px; }
  .form-label { font-weight: bold; }
  .input-line { border-bottom: 1px solid #000; min-width: 300px; }
  .checkbox-group { margin-top: 15px; }
  .checkbox-group label { font-weight: normal; display: inline-block; margin-right: 20px; }
  .signature-line { margin-top: 60px; }
</style>
<body>
  <div class="page">
    <h1>HUGives</h1>
    <h2>EMPLOYEE GIVING CAMPAIGN</h2>

    <div class="form-row">
      <div>
        <span class="form-label">Employee Name:</span>
        <div class="input-line" style="width: 50%;"></div>
      </div>
      <div>
        <span class="form-label">Employee ID #</span>
        <div class="input-line" style="width: 50%;"></div>
      </div>
    </div>

    <div class="checkbox-group">
      <input type="checkbox" id="option1" name="option1">
      <label for="option1"><strong>Option #1:</strong> Make an ongoing difference though a recurring payroll deduction</label>
    </div>

    <p style="margin-top: 15px;">
      I would like to contribute <span data-field="contribution_amount">{{ contribution_amount }}</span> per paycheck on a recurring basis.
    </p>

    <p style="margin-top: 20px;">
      I authorize the Payroll Office to make the deduction noted above. I understand that I will receive a written summary of my yearly gift. I also understand that my contribution will continue until I cancel this authorization by written notice to <span data-field="office_name">{{ office_name }}</span>, Office of Advancement.
    </p>

    <div class="form-row" style="margin-top: 40px;">
      <div>
        <span class="form-label">Signature:</span>
        <div class="input-line" style="width: 50%;"></div>
      </div>
      <div>
        <span class="form-label">Date:</span>
        <div class="input-line" style="width: 50%;"></div>
      </div>
    </div>

    <div class="checkbox-group">
      <input type="checkbox" id="option2" name="option2">
      <label for="option2"><strong>Option #2:</strong> One-time gift</label>
    </div>

    <p style="margin-top: 15px;">
      <input type="checkbox" id="option3" name="option3">
      <label for="option3"><strong>Option #3:</strong> GIVE ONLINE! <a href="https://www.heritage.edu/Giving" style="color: blue;">https://www.heritage.edu/Giving</a></label>
    </p>

    <div class="checkbox-group" style="margin-top: 20px;">
      <input type="checkbox" id="other_gift" name="other_gift">
      <label for="other_gift">Other (please specify fund)</label>
      <div class="input-line" style="width: 50%; display: inline-block; margin-left: 10px;"></div>
    </div>

    <p style="margin-top: 30px;">
      <strong>Heritage Fund:</strong> The largest unrestricted source of scholarship funds for students. These funds go to the area of greatest need.
    </p>
    <p style="margin-top: 10px;">
      <strong>HU Faculty & Staff Scholarship:</strong> Established by faculty and staff, this is an endowed scholarship fund. Contributions go to the principal, and annually 5% of the principal balance, including earnings, are available to be awarded as scholarships to students.
    </p>

    <div style="margin-top: 80px; font-size: 10pt;">
      Please email this form to <span data-field="email_address">{{ email_address }}</span> or mail to: <span data-field="mailing_address">{{ mailing_address }}</span>. If you have any questions, please contact <span data-field="phone_number">{{ phone_number }}</span>.
    </div>

    <div style="margin-top: 50px; font-size: 10pt;">
      FOR OFFICE USE ONLY: SCHEN / SFD10 / SFUND / STEMP Notes:
    </div>
  </div>
</body>