<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  .header { text-align: center; margin-bottom: 30px; }
  .title { font-size: 18pt; font-weight: bold; }
  .section-title { font-size: 12pt; font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
  .form-row { display: flex; margin-bottom: 15px; }
  .form-label { width: 150px; font-weight: normal; }
  .form-input { flex-grow: 1; border-bottom: 1px solid #000; }
  .signature-block { margin-top: 50px; }
  .signature-line { display: flex; justify-content: space-between; margin-bottom: 20px; }
  .signature-label { font-weight: bold; }
  .text-block { margin-top: 20px; line-height: 1.5; }
  .checkbox-group label { margin-right: 15px; }
</style>

<div class="page">
  <div class="header">
    <div style="display: flex; justify-content: space-between; align-items: center;">
      <div style="display: flex; align-items: center;">
        <div style="font-size: 30pt; font-weight: bold;">JP</div>
        <div style="margin-left: 10px;">
          <div style="font-size: 14pt; font-weight: bold;">JOURNAL of</div>
          <div style="font-size: 16pt; font-weight: bold;">PRACTICAL</div>
          <div style="font-size: 16pt; font-weight: bold;">CONSULTING</div>
        </div>
      </div>
      <div style="text-align: right;">
        <div style="font-size: 14pt; font-weight: bold;">PERMISSION TO PUBLISH FORM</div>
      </div>
    </div>
  </div>

  <div class="section-title">Full Article Title:</div>
  <div style="border-bottom: 1px solid #000; margin-bottom: 30px;">
    <span data-field="full_article_title">{{ full_article_title }}</span>
  </div>

  <div class="section-title">Word Count:</div>
  <div style="border-bottom: 1px solid #000; margin-bottom: 30px;">
    <span data-field="word_count">{{ word_count }}</span>
  </div>

  <div class="section-title">Keywords (up to six):</div>
  <div style="display: flex; gap: 40px;">
    <div>
      <div style="border-bottom: 1px solid #000; margin-bottom: 10px;">
        <span data-field="keywords[0]">{{ keywords[0] }}</span>
      </div>
      <div style="border-bottom: 1px solid #000; margin-bottom: 10px;">
        <span data-field="keywords[1]">{{ keywords[1] }}</span>
      </div>
      <div style="border-bottom: 1px solid #000; margin-bottom: 10px;">
        <span data-field="keywords[2]">{{ keywords[2] }}</span>
      </div>
      <div style="border-bottom: 1px solid #000; margin-bottom: 10px;">
        <span data-field="keywords[3]">{{ keywords[3] }}</span>
      </div>
    </div>
    <div>
      <div style="border-bottom: 1px solid #000; margin-bottom: 10px;">
        <span data-field="keywords[4]">{{ keywords[4] }}</span>
      </div>
      <div style="border-bottom: 1px solid #000; margin-bottom: 10px;">
        <span data-field="keywords[5]">{{ keywords[5] }}</span>
      </div>
      <div style="border-bottom: 1px solid #000; margin-bottom: 10px;">
        <span data-field="keywords[6]">{{ keywords[6] }}</span>
      </div>
    </div>
  </div>

  <div class="section-title">Article Category (select the correct category):</div>
  <div class="checkbox-group" style="margin-bottom: 30px;">
    <label><input type="checkbox"> Research paper</label>
    <label><input type="checkbox"> Technical paper</label>
    <label><input type="checkbox"> Case study</label>
    <label><input type="checkbox"> Conceptual paper</label>
    <br>
    <label><input type="checkbox"> Literature review</label>
    <label><input type="checkbox"> General review</label>
    <label><input type="checkbox"> Viewpoint</label>
    <label><input type="checkbox"> Popular press article</label>
    <br>
    <label><input type="checkbox"> Book Review</label>
    <label><input type="checkbox"> Editorial</label>
    <label><input type="checkbox"> Other</label>
  </div>

  <div class="section-title">1. First-named author:</div>
  <div class="text-block">
    <p>Author, please check here <input type="checkbox"> and complete one of the supplemental sheets at the end of this form for each additional author. The authors are collectively referred to in this Permission as the "Author."</p>
  </div>

  <div class="section-title">Title (please select):</div>
  <div style="border-bottom: 1px solid #000; margin-bottom: 30px;">
    <span data-field="first_author.title">{{ first_author.title }}</span>
  </div>

  <div class="form-row">
    <div class="form-label">First Name:</div>
    <div class="form-input"><span data-field="first_author.first_name">{{ first_author.first_name }}</span></div>
  </div>
  <div class="form-row">
    <div class="form-label">Last Name:</div>
    <div class="form-input"><span data-field="first_author.last_name">{{ first_author.last_name }}</span></div>
  </div>
  <div class="form-row">
    <div class="form-label">Job Title:</div>
    <div class="form-input"><span data-field="first_author.job_title">{{ first_author.job_title }}</span></div>
    <div class="form-label" style="margin-left: 300px;">Organization:</div>
    <div class="form-input" style="margin-left: 300px;"><span data-field="first_author.organization">{{ first_author.organization }}</span></div>
  </div>
  <div class="form-row">
    <div class="form-label">Address:</div>
    <div class="form-input"><span data-field="first_author.address">{{ first_author.address }}</span></div>
  </div>
  <div class="form-row">
    <div class="form-label">City:</div>
    <div class="form-input"><span data-field="first_author.city">{{ first_author.city }}</span></div>
    <div class="form-label" style="margin-left: 300px;">State:</div>
    <div class="form-input" style="margin-left: 300px;"><span data-field="first_author.state">{{ first_author.state }}</span></div>
  </div>
  <div class="form-row">
    <div class="form-label">Postal/Zip Code:</div>
    <div class="form-input"><span data-field="first_author.postal_zip_code">{{ first_author.postal_zip_code }}</span></div>
    <div class="form-label" style="margin-left: 300px;">Country:</div>
    <div class="form-input" style="margin-left: 300px;"><span data-field="first_author.country">{{ first_author.country }}</span></div>
  </div>
  <div class="form-row">
    <div class="form-label">Telephone:</div>
    <div class="form-input"><span data-field="first_author.telephone">{{ first_author.telephone }}</span></div>
    <div class="form-label" style="margin-left: 300px;">Fax:</div>
    <div class="form-input" style="margin-left: 300px;"><span data-field="first_author.fax">{{ first_author.fax }}</span></div>
  </div>
  <div class="form-row">
    <div class="form-label">Email Address:</div>
    <div class="form-input"><span data-field="first_author.email_address">{{ first_author.email_address }}</span></div>
  </div>
  <div class="form-row">
    <div class="form-label">Please address all correspondence to:</div>
    <div class="form-input"><span data-field="first_author.correspondence_address">{{ first_author.correspondence_address }}</span></div>
  </div>

  <div class="text-block">
    <p>2. Please indicate your agreement to the following terms by signing below and submitting this Permission Form to <span data-field="journal_email">{{ journal_email }}</span>. The Author agrees with Regent University ("REGENT") as follows:</p>
  </div>

  <div class="text-block">
    <ul>
      <li>Author grants REGENT exclusive permission to publish this Article and authorize others to publish this Article at any time, in any format now known or hereafter discovered, throughout the world and in perpetuity, with the full understanding that REGENT has the right to edit, format and design the Article in accordance with REGENT's standards. Author grants to REGENT an exclusive license to reproduce and distribute copies, reprints, or duplications of the Article, including but not limited to, reproduction and distribution by any publisher REGENT might reasonably designate. Author grants to REGENT an exclusive license to authorize others to reproduce and distribute the Article, in whole or in part, in sources including, but not limited to, anthologies, textbooks, journals, bibliographies, or any other published format, for profit or not. Author grants to REGENT an exclusive license to authorize others to reproduce and distribute the Article through electronic media, including, but not limited to microform, microfiche, CD-ROM format, internet, on-line and other computer-assisted legal research services, databases, or products.</li>
      <li>Author understands that the publication in which this Article is published will be copyrighted by REGENT.</li>
      <li>Author hereby assigns the worldwide copyright of the Article named above in all forms of media, whether now known or hereafter developed, to REGENT. This assignment of copyright to REGENT is done with the understanding that permission from REGENT is not required for Author to reproduce, republish or distribute copies of the Article in whole or in part. Author will ensure that all such copies carry a notice of copyright ownership and reference to the original journal publication.</li>
      <li>Author attests to the fact that this Article is an original creation of Author and that it is not under review at any other publication, except as follows: <span data-field="other_review_details">{{ other_review_details }}</span>. Author warrants that the Article has not been previously published, does not contain any unlawful statements, and does not infringe any existing copyright, trademark, right of publicity or privacy, or any other third party right, nor constitute a defamation of any person, entity or product. Author warrants that "proof of consent" has been obtained for studies of named organizations and people. Author also warrants that Author has obtained the necessary permission from the copyright holder's to reproduce in the Article, in all media, in all countries, and transmit via all reputable third parties, any materials including tables, diagrams or photographs not owned by Author. (Please attach any permission documents.)</li>
    </ul>
  </div>

  <div class="text-block">
    <p>Author understands that no promise has been made by REGENT that it will publish the Article, but it may do so at its sole discretion.</p>
    <p>Author understands that Author will not be compensated financially for the publication of the Article.</p>
  </div>

  <div class="signature-block">
    <div class="signature-line">
      <div class="signature-label">Author #1 Signature:</div>
      <div style="width: 40%;"></div>
      <div class="signature-label">Date:</div>
      <div style="width: 40%;"></div>
    </div>
    <div class="signature-line">
      <div class="signature-label">Author #2 Signature:</div>
      <div style="width: 40%;"></div>
      <div class="signature-label">Date:</div>
      <div style="width: 40%;"></div>
    </div>
    <div class="signature-line">
      <div class="signature-label">Author #3 Signature:</div>
      <div style="width: 40%;"></div>
      <div class="signature-label">Date:</div>
      <div style="width: 40%;"></div>
    </div>
    <div class="signature-line">
      <div class="signature-label">Author #4 Signature:</div>
      <div style="width: 40%;"></div>
      <div class="signature-label">Date:</div>
      <div style="width: 40%;"></div>
    </div>
    <div class="signature-line">
      <div class="signature-label">Author #5 Signature:</div>
      <div style="width: 40%;"></div>
      <div class="signature-label">Date:</div>
      <div style="width: 40%;"></div>
    </div>
    <p style="text-align: center; margin-top: 40px;">(Note: Each author of the Article should sign this Permission to Publish form)</p>
  </div>

  <div style="text-align: center; margin-top: 50px;">
    <button style="padding: 10px 30px; font-size: 12pt; cursor: pointer;">Submit</button>
  </div>
</div>

