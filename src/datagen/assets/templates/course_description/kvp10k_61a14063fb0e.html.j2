<!DOCTYPE html>
<html>
<head>
    <title>Course Description</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 { font-weight: bold; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        td, th { padding: 8px; text-align: left; border-bottom: 1px solid #ddd; }
        .section-title { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
    </style>
</head>
<body>
    <div class="page">
        <div style="margin-bottom: 30px;">
            <h2 style="font-size: 24pt; margin: 0;">Course description</h2>
            <h1 style="font-size: 36pt; margin: 5px 0;">{{ course_code }}</h1>
            <h1 style="font-size: 36pt; margin: 5px 0;">{{ course_title }}</h1>
            <h1 style="font-size: 36pt; margin: 5px 0;">{{ course_subtitle }}</h1>
        </div>

        <div style="display: flex; justify-content: space-between; margin-bottom: 40px;">
            <div style="width: 48%;">
                <div class="section-title">Course Duration</div>
                <p><span data-field="duration_description">{{ duration_description }}</span></p>

                <div class="section-title">Course Type</div>
                <p><span data-field="course_type_description">{{ course_type_description }}</span></p>

                <div class="section-title">Course Goal and Learning Objectives</div>
                <p><span data-field="course_goal">{{ course_goal }}</span></p>
                <p><span data-field="learning_objective_summary">{{ learning_objective_summary }}</span></p>

                <div class="section-title">Student Profile</div>
                <p><span data-field="student_profile">{{ student_profile }}</span></p>

                <div class="section-title">Prerequisites and Recommendations</div>
                <p><span data-field="prerequisites">{{ prerequisites }}</span></p>

                <div class="section-title">Main Topics of the Training</div>
                <ul>
                    {% for topic in main_topics %}
                        <li>
                            <span data-field="main_topics[{{ loop.index0 }}].topic_name">{{ topic.topic_name }}</span>
                            <ul>
                                {% for sub_topic in topic.sub_topics %}
                                    <li><span data-field="main_topics[{{ loop.index0 }}].sub_topics[{{ loop.index1 }}]">{{ sub_topic }}</span></li>
                                {% endfor %}
                            </ul>
                        </li>
                    {% endfor %}
                </ul>
            </div>

            <div style="width: 48%;">
                <div class="section-title">Integrated Visualization</div>
                <ul>
                    {% for item in integrated_visualization %}
                        <li><span data-field="integrated_visualization[{{ loop.index0 }}]">{{ item }}</span></li>
                    {% endfor %}
                </ul>

                <div class="section-title">Programming of parallel control and monitoring devices</div>
                <ul>
                    {% for item in parallel_control %}
                        <li><span data-field="parallel_control[{{ loop.index0 }}]">{{ item }}</span></li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>

    <div class="page">
        <div style="margin-bottom: 30px;">
            <h2 style="font-size: 24pt; margin: 0;">Course outline</h2>
        </div>

        <table>
            <thead>
                <tr>
                    <th style="width: 33%;">Day 1</th>
                    <th style="width: 33%;">Day 2</th>
                    <th style="width: 33%;">Day 3</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <ul>
                            {% for item in day1_topics %}
                                <li><span data-field="day1_topics[{{ loop.index0 }}]">{{ item }}</span></li>
                            {% endfor %}
                        </ul>
                    </td>
                    <td>
                        <ul>
                            {% for item in day2_topics %}
                                <li><span data-field="day2_topics[{{ loop.index0 }}]">{{ item }}</span></li>
                            {% endfor %}
                        </ul>
                    </td>
                    <td>
                        <ul>
                            {% for item in day3_topics %}
                                <li><span data-field="day3_topics[{{ loop.index0 }}]">{{ item }}</span></li>
                            {% endfor %}
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>

        <div style="margin-top: 50px;">
            <p><span data-field="note_text">{{ note_text }}</span></p>
        </div>
    </div>

    <div class="page">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 50px;">
            <div style="width: 50%;">
                <div class="section-title">Course Bookings</div>
                <p>Website: <a href="http://www.abb.com/TPOnline/NET/TPublic/9620Courses.aspx"><span data-field="booking_url">{{ booking_url }}</span></a></p>
            </div>
            <div style="width: 45%; text-align: right;">
                <div class="section-title">Contact</div>
                <p>Email: <span data-field="contact_email">{{ contact_email }}</span></p>
                <p>Team Leader: <span data-field="team_leader_name">{{ team_leader_name }}</span></p>
                <p>Phone: <span data-field="team_leader_phone">{{ team_leader_phone }}</span></p>
                <p>Fax: <span data-field="team_leader_fax">{{ team_leader_fax }}</span></p>
                <p>Email: <span data-field="contact_email_2">{{ contact_email_2 }}</span></p>
            </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 50px;">
            <div style="text-align: left;">
                <p>Home | Offerings | Media | Careers | Investors | About | Conversations | My ABB</p>
            </div>
            <div style="text-align: right;">
                <p>Power and productivity for a better world™</p>
                <img src="abb_logo.png" alt="ABB Logo" style="height: 50px;">
            </div>
        </div>
    </div>
</body>
</html>