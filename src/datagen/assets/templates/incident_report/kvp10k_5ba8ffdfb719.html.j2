<!DOCTYPE html>
<html>
<head>
<title>Report Exec Administrator</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    line-height: 1.5;
  }
  h1 {
    font-size: 24pt;
    font-weight: bold;
    text-align: center;
    margin-bottom: 5px;
  }
  h2 {
    font-size: 12pt;
    font-weight: bold;
    text-align: center;
    margin-top: 0;
    margin-bottom: 30px;
  }
  .incident-report {
    border-bottom: 1px solid #ccc;
    padding-bottom: 15px;
    margin-bottom: 20px;
  }
  .incident-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 10px;
    font-weight: bold;
  }
  .incident-details div {
    margin-bottom: 5px;
  }
  .incident-details span {
    display: inline-block;
    width: 150px; /* Adjust as needed for alignment */
  }
  .incident-details .value {
    font-weight: normal;
  }
  .incident-notes {
    margin-top: 10px;
    font-style: italic;
    font-size: 10pt;
  }
</style>
</head>
<body>

<div class="page">
  <h1>Report Exec Administrator</h1>
  <h2>Clery Act Public Crime Log</h2>
  
  {% for incident in incidents %}
  <div class="incident-report">
    <div class="incident-header">
      <div>Incident Type:</div>
      <div>Location:</div>
    </div>
    <div class="incident-details">
      <div>Incident Type: <span data-field="incident.type">{{ incident.type }}</span></div>
      <div>Location: <span data-field="incident.location">{{ incident.location }}</span></div>
      <div>Date/Time Reported: <span data-field="incident.date_time_reported">{{ incident.date_time_reported }}</span></div>
      <div>Incident Occurred Between: <span data-field="incident.incident_occurred_between">{{ incident.incident_occurred_between }}</span></div>
      <div>Case #: <span data-field="incident.case_number">{{ incident.case_number }}</span></div>
      <div>Int. Ref. #: <span data-field="incident.int_ref_number">{{ incident.int_ref_number }}</span></div>
      <div>Disposition: <span data-field="incident.disposition">{{ incident.disposition }}</span></div>
    </div>
    <div class="incident-notes">
      Notes: <span data-field="incident.notes">{{ incident.notes }}</span>
    </div>
  </div>
  {% endfor %}
</div>

<div class="page">
  {% for incident in incidents %}
  <div class="incident-report">
    <div class="incident-header">
      <div>Incident Type:</div>
      <div>Location:</div>
    </div>
    <div class="incident-details">
      <div>Incident Type: <span data-field="incident.type">{{ incident.type }}</span></div>
      <div>Location: <span data-field="incident.location">{{ incident.location }}</span></div>
      <div>Date/Time Reported: <span data-field="incident.date_time_reported">{{ incident.date_time_reported }}</span></div>
      <div>Incident Occurred Between: <span data-field="incident.incident_occurred_between">{{ incident.incident_occurred_between }}</span></div>
      <div>Case #: <span data-field="incident.case_number">{{ incident.case_number }}</span></div>
      <div>Int. Ref. #: <span data-field="incident.int_ref_number">{{ incident.int_ref_number }}</span></div>
      <div>Disposition: <span data-field="incident.disposition">{{ incident.disposition }}</span></div>
    </div>
    <div class="incident-notes">
      Notes: <span data-field="incident.notes">{{ incident.notes }}</span>
    </div>
  </div>
  {% endfor %}
</div>

</body>
</html>