<div class="page">
  <h1 style="text-align: center; font-size: 18pt; margin-bottom: 10px;">Evaluating Potential Herbicides for Row-Middles with Plasticulture</h1>
  <h2 style="text-align: center; font-size: 14pt; margin-top: 0;">Final Report for {{ report_year }}</h2>

  <div style="margin-top: 40px;">
