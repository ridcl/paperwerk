<!DOCTYPE html>
<html>
<head>
    <title>Synthetic Data Generation</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        th, td { padding: 8px; text-align: left; border: 1px solid #ddd; }
        .header-title { text-align: center; font-weight: bold; margin-bottom: 20px; }
        .section-header { font-weight: bold; margin-top: 15px; margin-bottom: 10px; }
        .data-row td:first-child { font-weight: bold; }
    </style>
</head>
<body>

<div class="page">
    <div style="text-align: left;">
        <div style="font-size: 24px; font-weight: bold;">adhe</div>
    </div>
    <div style="text-align: right;">
        <div style="font-size: 12px;">ADHE 16-1</div>
        <div style="font-size: 12px;">HOUSING DESIGN, OCCUPANCY, AND RATE SURVEY</div>
        <div style="font-size: 10px;">(SEE INSTRUCTIONS)</div>
    </div>

    <table style="width: 100%; margin-top: 30px;">
        <tr>
            <td style="width: 25%;">FICE CODE</td>
            <td><span data-field="fice_code">{{ fice_code }}</span></td>
        </tr>
        <tr>
            <td>INSTITUTION</td>
            <td><span data-field="institution_name">{{ institution_name }}</span></td>
        </tr>
        <tr>
            <td>CURRENT FISCAL YEAR</td>
            <td><span data-field="current_fiscal_year">{{ current_fiscal_year }}</span></td>
        </tr>
        <tr>
            <td style="width: 25%;">COMPLETED BY</td>
            <td><span data-field="completed_by_name">{{ completed_by_name }}</span></td>
        </tr>
        <tr>
            <td>DATE COMPLETED</td>
            <td><span data-field="date_completed">{{ date_completed }}</span></td>
        </tr>
        <tr>
            <td>EMAIL</td>
            <td><span data-field="email">{{ email }}</span></td>
        </tr>
    </table>

    <div class="section-header">NAME OF HOUSING UNIT</div>
    <table style="margin-top: 10px;">
        <thead>
            <tr>
                <th style="width: 20%;">UNIT</th>
                <th style="width: 10%;">DESIGN CAPACITY (A)</th>
                <th style="width: 10%;">BEGINNING (B)</th>
                <th style="width: 10%;">ROOM RATE (C)</th>
                <th style="width: 10%;">SPRING OCCUPANCY PREVIOUS YEAR (D)</th>
                <th style="width: 10%;">BEGINNING (E)</th>
                <th style="width: 10%;">ROOM RATE (F)</th>
                <th style="width: 10%;">FALL OCCUPANCY CURRENT YEAR (G)</th>
                <th style="width: 10%;">BEGINNING (H)</th>
                <th style="width: 10%;">ROOM RATE (I)</th>
            </tr>
        </thead>
        <tbody>
            {% for unit in housing_units %}
            <tr class="data-row">
                <td><span data-field="unit.name">{{ unit.name }}</span></td>
                <td><span data-field="unit.design_capacity">{{ unit.design_capacity }}</span></td>
                <td><span data-field="unit.beginning_b">{{ unit.beginning_b }}</span></td>
                <td><span data-field="unit.room_rate_c">{{ unit.room_rate_c }}</span></td>
                <td><span data-field="unit.spring_occupancy_prev_d">{{ unit.spring_occupancy_prev_d }}</span></td>
                <td><span data-field="unit.beginning_e">{{ unit.beginning_e }}</span></td>
                <td><span data-field="unit.room_rate_f">{{ unit.room_rate_f }}</span></td>
                <td><span data-field="unit.fall_occupancy_current_g">{{ unit.fall_occupancy_current_g }}</span></td>
                <td><span data-field="unit.beginning_h">{{ unit.beginning_h }}</span></td>
                <td><span data-field="unit.room_rate_i">{{ unit.room_rate_i }}</span></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <div style="text-align: right; margin-top: 10px;">
        <span data-field="total_residence_halls_total_capacity">{{ total_residence_halls_total_capacity }}</span>
        <span data-field="total_residence_halls_total_beginning_b">{{ total_residence_halls_total_beginning_b }}</span>
        <span data-field="total_residence_halls_total_room_rate_c">{{ total_residence_halls_total_room_rate_c }}</span>
        <span data-field="total_residence_halls_total_spring_occupancy_prev_d">{{ total_residence_halls_total_spring_occupancy_prev_d }}</span>
        <span data-field="total_residence_halls_total_beginning_e">{{ total_residence_halls_total_beginning_e }}</span>
        <span data-field="total_residence_halls_total_room_rate_f">{{ total_residence_halls_total_room_rate_f }}</span>
        <span data-field="total_residence_halls_total_fall_occupancy_current_g">{{ total_residence_halls_total_fall_occupancy_current_g }}</span>
        <span data-field="total_residence_halls_total_beginning_h">{{ total_residence_halls_total_beginning_h }}</span>
        <span data-field="total_residence_halls_total_room_rate_i">{{ total_residence_halls_total_room_rate_i }}</span>
    </div>

    <div class="section-header" style="margin-top: 40px;">STUDENT APARTMENT HOUSING:</div>
    <!-- Placeholder for Student Apartment Housing data if structure were provided -->
</div>

<div class="page">
    <div style="text-align: left;">
        <div style="font-size: 24px; font-weight: bold;">adhe</div>
    </div>
    <div style="text-align: right;">
        <div style="font-size: 12px;">ADHE 16-2</div>
        <div style="font-size: 12px;">FOOD SERVICE PARTICIPANT AND RATE SURVEY</div>
        <div style="font-size: 10px;">(SEE INSTRUCTIONS)</div>
    </div>

    <table style="width: 100%; margin-top: 30px;">
        <tr>
            <td style="width: 25%;">FICE CODE</td>
            <td><span data-field="fice_code_2">{{ fice_code_2 }}</span></td>
        </tr>
        <tr>
            <td>INSTITUTION</td>
            <td><span data-field="institution_name_2">{{ institution_name_2 }}</span></td>
        </tr>
        <tr>
            <td>CURRENT FISCAL YEAR</td>
            <td><span data-field="current_fiscal_year_2">{{ current_fiscal_year_2 }}</span></td>
        </tr>
        <tr>
            <td style="width: 25%;">COMPLETED BY</td>
            <td><span data-field="completed_by_name_2">{{ completed_by_name_2 }}</span></td>
        </tr>
        <tr>
            <td>DATE COMPLETED</td>
            <td><span data-field="date_completed_2">{{ date_completed_2 }}</span></td>
        </tr>
        <tr>
            <td>EMAIL</td>
            <td><span data-field="email_2">{{ email_2 }}</span></td>
        </tr>
    </table>

    <div class="section-header">TYPE OF MEAL PLAN</div>
    <table style="margin-top: 10px;">
        <thead>
            <tr>
                <th style="width: 20%;">OPTION</th>
                <th style="width: 10%;">PLAN NAME</th>
                <th style="width: 10%;">FALL PARTICIPANTS PREVIOUS YEAR (A)</th>
                <th style="width: 10%;">BEGINNING (B)</th>
                <th style="width: 10%;">PLAN RATE (C)</th>
                <th style="width: 10%;">SPRING PARTICIPANTS PREVIOUS YEAR (D)</th>
                <th style="width: 10%;">BEGINNING (E)</th>
                <th style="width: 10%;">PLAN RATE (F)</th>
                <th style="width: 10%;">FALL PARTICIPANTS CURRENT YEAR (G)</th>
                <th style="width: 10%;">BEGINNING (H)</th>
                <th style="width: 10%;">PLAN RATE (I)</th>
            </tr>
        </thead>
        <tbody>
            {% for meal_plan in meal_plans %}
            <tr class="data-row">
                <td><span data-field="meal_plan.option">{{ meal_plan.option }}</span></td>
                <td><span data-field="meal_plan.plan_name">{{ meal_plan.plan_name }}</span></td>
                <td><span data-field="meal_plan.fall_participants_prev_a">{{ meal_plan.fall_participants_prev_a }}</span></td>
                <td><span data-field="meal_plan.beginning_b">{{ meal_plan.beginning_b }}</span></td>
                <td><span data-field="meal_plan.plan_rate_c">{{ meal_plan.plan_rate_c }}</span></td>
                <td><span data-field="meal_plan.spring_participants_prev_d">{{ meal_plan.spring_participants_prev_d }}</span></td>
                <td><span data-field="meal_plan.beginning_e">{{ meal_plan.beginning_e }}</span></td>
                <td><span data-field="meal_plan.plan_rate_f">{{ meal_plan.plan_rate_f }}</span></td>
                <td><span data-field="meal_plan.fall_participants_current_g">{{ meal_plan.fall_participants_current_g }}</span></td>
                <td><span data-field="meal_plan.beginning_h">{{ meal_plan.beginning_h }}</span></td>
                <td><span data-field="meal_plan.plan_rate_i">{{ meal_plan.plan_rate_i }}</span></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <div style="margin-top: 20px;">
        <div style="font-weight: bold;">COMMENTS:</div>
        <p><span data-field="comments">{{ comments }}</span></p>
    </div>
</div>

<div class="page">
    <div style="text-align: left;">
        <div style="font-size: 24px; font-weight: bold;">adhe</div>
    </div>
    <div style="text-align: right;">
        <div style="font-size: 12px;">ADHE 16-3</div>
        <div style="font-size: 12px;">COST OF ATTENDANCE SURVEY</div>
        <div style="font-size: 12px;">Books, Supplies, and Other Expenses</div>
    </div>

    <table style="width: 100%; margin-top: 30px;">
        <tr>
            <td style="width: 25%;">Institution</td>
            <td><span data-field="institution_name_3">{{ institution_name_3 }}</span></td>
        </tr>
        <tr>
            <td>Fiscal Year</td>
            <td><span data-field="fiscal_year_3">{{ fiscal_year_3 }}</span></td>
        </tr>
        <tr>
            <td>Person Completing Survey</td>
            <td><span data-field="person_completing_name">{{ person_completing_name }}</span></td>
        </tr>
        <tr>
            <td>Date completed</td>
            <td><span data-field="date_completed_3">{{ date_completed_3 }}</span></td>
        </tr>
        <tr>
            <td>Phone number</td>
            <td><span data-field="phone_number">{{ phone_number }}</span></td>
        </tr>
    </table>

    <div class="section-header" style="margin-top: 40px;">Books and Supplies</div>
    <table style="margin-top: 10px;">
        <thead>
            <tr>
                <th style="width: 50%;">Course/Item</th>
                <th style="width: 25%;">Cost of book(s)</th>
                <th style="width: 25%;">Cost of Mandatory Supplies</th>
            </tr>
        </thead>
        <tbody>
            {% for item in cost_items %}
            <tr class="data-row">
                <td><span data-field="cost_items[{{ loop.index0 }}].description">{{ item.description }}</span></td>
                <td><span data-field="cost_items[{{ loop.index0 }}].book_cost">{{ item.book_cost }}</span></td>
                <td><span data-field="cost_items[{{ loop.index0 }}].supply_cost">{{ item.supply_cost }}</span></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="section-header" style="margin-top: 40px;">Other Expenses</div>
    <table style="margin-top: 10px;">
        <thead>
            <tr>
                <th style="width: 50%;">Item</th>
                <th style="width: 25%;">Estimated Annual Cost</th>
            </tr>
        </thead>
        <tbody>
            {% for expense in other_expenses %}
            <tr class="data-row">
                <td><span data-field="other_expenses[{{ loop.index0 }}].description">{{ expense.description }}</span></td>
                <td><span data-field="other_expenses[{{ loop.index0 }}].annual_cost">{{ expense.annual_cost }}</span></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <div style="margin-top: 40px;">
        <p>Items included in "Other Expenses" category of "Price of Attendance" as reported by Financial Aid office to NCES (see instructions).</p>
        <table style="width: 100%; margin-top: 10px;">
            <tr>
                <td style="width: 50%;">Detailed Explanation of Items</td>
                <td style="width: 50%;"></td>
            </tr>
        </table>
    </div>
</div>

</body>
</html>