<!DOCTYPE html>
<html>
<head>
<title>Schedule Template</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    margin: 0;
    padding: 0;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
  }
  th, td {
    padding: 10px 0;
    text-align: left;
  }
  .header-title {
    text-align: center;
    font-size: 24pt;
    font-weight: bold;
    margin-bottom: 5px;
  }
  .header-subtitle {
    text-align: center;
    font-size: 12pt;
    margin-bottom: 20px;
  }
  .contact-info {
    text-align: center;
    font-size: 10pt;
    margin-bottom: 30px;
  }
  .day-header {
    font-weight: bold;
    font-size: 12pt;
    margin-top: 15px;
    margin-bottom: 5px;
  }
  .time-col {
    width: 15%;
  }
  .topic-col {
    width: 65%;
  }
  .date-col {
    width: 20%;
  }
</style>
</head>
<body>
<div class="page">
  <div style="text-align: center;">
    <img src="logo1.png" alt="Logo 1" style="height: 50px; margin-bottom: 10px;">
    <img src="logo2.png" alt="Logo 2" style="height: 50px; margin-bottom: 10px;">
    <img src="logo3.png" alt="Logo 3" style="height: 50px; margin-bottom: 10px;">
  </div>
  <div class="header-title">Electronics & ICT Academy</div>
  <div class="header-subtitle">(Under Ministry of Electronics and Information Technology, Government of India)</div>
  <div class="header-subtitle">Indian Institute of Technology Guwahati, Guwahati, Assam, Pin <span data-field="pin_code">{{ pin_code }}</span></div>
  <div class="contact-info">
    Phone: +91 - <span data-field="phone_number">{{ phone_number }}</span> - <span data-field="phone_number_2">{{ phone_number_2 }}</span> | <span data-field="email">{{ email }}</span>
  </div>

  <table>
    <thead>
      <tr>
        <th style="width: 20%;">Date</th>
        <th style="width: 15%;">Time</th>
        <th style="width: 65%;">Topic</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="date-col"><span data-field="day_1_label">{{ day_1_label }}</span></td>
        <td>09:00am-9:45am</td>
        <td>Registration & Reporting</td>
      </tr>
      <tr>
        <td class="date-col"></td>
        <td>09:45am-10:15am</td>
        <td>Inauguration</td>
      </tr>
      <tr>
        <td class="date-col"></td>
        <td>10:15am-10:30am</td>
        <td>Tea Break</td>
      </tr>
      <tr>
        <td class="date-col"></td>
        <td>10:30am-01:00pm</td>
        <td>Introduction to Python and Python Programming
          <ul>
            <li>Python Environment Set up</li>
            <li>Instructions for Installing Anaconda and Managing Environment</li>
            <li>Introduction to Python programming Platform</li>
            <li>Python Data Types, Control Statements, Loops, Functions</li>
          </ul>
        </td>
      </tr>
      <tr>
        <td class="date-col"><span data-field="day_2_label">{{ day_2_label }}</span></td>
        <td>01:00pm-02:00pm</td>
        <td>Lunch</td>
      </tr>
      <tr>
        <td class="date-col"></td>
        <td>02:00pm-03:45pm</td>
        <td>Data Analytics
          <ul>
            <li>Introduction to python packages</li>
            <li>Working with Numpy, Pandas, Matplotlib, Seaborn</li>
            <li>Working with Data, Data Preprocessing and Visualization</li>
          </ul>
        </td>
      </tr>
      <tr>
        <td class="date-col"></td>
        <td>03:45pm-04:00pm</td>
        <td>Tea Break</td>
      </tr>
      <tr>
        <td class="date-col"></td>
        <td>04:00pm-05:30pm</td>
        <td>Machine Learning
          <ul>
            <li>Introduction to Machine Learning</li>
            <li>Categories of Machine Learning</li>
            <li>Working with Scikit – Learn(Hands-on)</li>
          </ul>
        </td>
      </tr>
      <tr>
        <td class="date-col"></td>
        <td>09:30am-11:30am</td>
        <td>Supervised learning methods
          <ul>
            <li>Regression - Linear regression and its types</li>
            <li>Working with Dataset – Application (Hands – on)</li>
          </ul>
        </td>
      </tr>
    </tbody>
  </table>
</div>

