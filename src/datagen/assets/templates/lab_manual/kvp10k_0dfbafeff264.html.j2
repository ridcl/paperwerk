                        </tr>
                        <tr>
                            <td></td>
                            <td></td>
                            <td><span>{{ model_m12 }}</span></td>
                            <td><span>{{ buffer_m12 }}</span></td>
                            <td><span>{{ water_m12 }}</span></td>
                            <td><span>{{ total_m12 }}</span></td>
                        </tr>
                        <tr>
                            <td></td>
                            <td></td>
                            <td><span>{{ model_m36_blue }}</span></td>
                            <td><span>{{ buffer_m36_blue }}</span></td>
                            <td><span>{{ water_m36_blue }}</span></td>
                            <td><span>{{ total_m36_blue }}</span></td>
                        </tr>
                        <tr>
                            <td></td>
                            <td></td>
                            <td><span>{{ model_m36_clear }}</span></td>
                            <td><span>{{ buffer_m36_clear }}</span></td>
                            <td><span>{{ water_m36_clear }}</span></td>
                            <td><span>{{ total_m36_clear }}</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <p>15. Make sure the gel is completely covered with buffer.</p>
            <p>16. Proceed to loading the samples and conducting electrophoresis.</p>
        </div>

