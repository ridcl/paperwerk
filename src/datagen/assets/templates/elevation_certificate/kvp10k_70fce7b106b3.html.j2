<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  h1, h2, h3, h4, h5, h6 {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial;
  }
  .header-info {
    display: flex;
    justify-content: space-between;
    margin-bottom: 30px;
    font-size: 10pt;
  }
  .logo-container {
    text-align: center;
    margin-bottom: 30px;
  }
  .logo-image {
    width: 150px; /* Placeholder size */
    height: auto;
  }
  .title-section {
    text-align: center;
    margin-bottom: 40px;
  }
  .main-title {
    font-size: 36pt;
    font-weight: bold;
    text-align: center;
    margin-bottom: 10px;
  }
  .subtitle {
    font-size: 16pt;
    text-align: center;
    margin-bottom: 40px;
  }
  .section-header {
    font-size: 14pt;
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 15px;
    text-align: center;
  }
  .form-row {
    display: flex;
    margin-bottom: 15px;
    font-size: 10pt;
  }
  .form-row > div {
    flex: 1;
    padding-right: 20px;
  }
  .form-label {
    font-weight: bold;
    display: block;
    margin-bottom: 3px;
  }
  .form-input {
    border-bottom: 1px solid #000;
    padding: 2px 0;
    min-width: 150px;
  }
  .checkbox-group label {
    font-weight: normal;
    margin-right: 15px;
  }
  .table-container {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
    font-size: 10pt;
  }
  .table-container th, .table-container td {
    border: 1px solid #000;
    padding: 8px;
    text-align: left;
  }
  .table-container th {
    background-color: #f0f0f0;
  }
  .signature-block {
    margin-top: 50px;
    display: flex;
    justify-content: space-between;
    font-size: 10pt;
  }
  .signature-area {
    width: 45%;
    text-align: center;
  }
  .signature-line {
    border-top: 1px solid #000;
    margin-top: 40px;
    padding-top: 5px;
  }
  .footer {
    text-align: center;
    font-size: 8pt;
    margin-top: 50px;
    padding-top: 20px;
    border-top: 1px solid #000;
  }
</style>

<div class="page">
  <div class="header-info">
    <div>OMB No. <span data-field="omb_number">{{ omb_number }}</span></div>
    <div>Expiration Date: <span data-field="expiration_date">{{ expiration_date }}</span></div>
  </div>

  <div class="logo-container">
    <!-- Placeholder for FEMA Logo -->
    <div style="width: 150px; height: auto; border: 1px solid #ccc; text-align: center; line-height: 150px;">FEMA Logo Placeholder</div>
  </div>

  <div class="title-section">
    <h1 style="font-size: 24pt; margin-bottom: 5px;">U.S. DEPARTMENT OF HOMELAND SECURITY</h1>
    <h2 style="font-size: 18pt; margin-top: 0;">Federal Emergency Management Agency</h2>
    <h3 style="font-size: 20pt; margin-top: 0;">ELEVATION CERTIFICATE AND INSTRUCTIONS</h3>
  </div>

  <p style="font-size: 10pt; margin-bottom: 30px;">
    <span data-field="document_title">{{ document_title }}</span>
  </p>

  <div class="section-header">
    SECTION A – PROPERTY INFORMATION
  </div>

  <div class="form-row">
    <div>
      <span class="form-label">A1. Building Owner's Name</span>
      <div class="form-input"><span data-field="a1_owner_name">{{ a1_owner_name }}</span></div>
    </div>
    <div>
      <span class="form-label">For Insurance Company Use</span>
      <div class="form-input"><span data-field="insurance_company_name">{{ insurance_company_name }}</span></div>
    </div>
  </div>

  <div class="form-row">
    <div>
      <span class="form-label">A2. Building Street Address (including Apt., Unit, Suite, and/or Bldg. No.) or P.O. Route and Box No.</span>
      <div class="form-input"><span data-field="a2_address">{{ a2_address }}</span></div>
    </div>
    <div>
      <span class="form-label">Company NAIC Number:</span>
      <div class="form-input"><span data-field="company_naic_number">{{ company_naic_number }}</span></div>
    </div>
  </div>

  <div class="form-row">
    <div>
      <span class="form-label">A3. Property Description (Lot and Block Numbers, Tax Parcel Number, Legal Description, etc.)</span>
      <div class="form-input"><span data-field="a3_property_description">{{ a3_property_description }}</span></div>
    </div>
    <div>
      <span class="form-label">State</span>
      <div class="form-input"><span data-field="a3_state">{{ a3_state }}</span></div>
    </div>
    <div>
      <span class="form-label">ZIP Code</span>
      <div class="form-input"><span data-field="a3_zip_code">{{ a3_zip_code }}</span></div>
    </div>
  </div>

  <div class="form-row">
    <div>
      <span class="form-label">A4. Building Use (e.g., Residential, Non-Residential, Addition, Accessory, etc.)</span>
      <div class="form-input"><span data-field="a4_building_use">{{ a4_building_use }}</span></div>
    </div>
    <div>
      <span class="form-label">A5. Latitude/Longitude:</span>
      <div class="form-input"><span data-field="a5_latitude">{{ a5_latitude }}</span></div>
      <div class="form-input" style="margin-top: 5px;"><span data-field="a5_longitude">{{ a5_longitude }}</span></div>
    </div>
    <div>
      <span class="form-label">Horizontal Datum:</span>
      <div class="checkbox-group">
        <label><input type="checkbox" data-field="a5_datum_nad1927" value="{{ a5_datum_nad1927 }}"> NAD 1927</label>
        <label><input type="checkbox" data-field="a5_datum_nad1983" value="{{ a5_datum_nad1983 }}"> NAD 1983</label>
      </div>
    </div>
  </div>

  <div class="form-row">
    <div>
      <span class="form-label">A6. Attach at least 2 photographs of the building if the Certificate is being used to obtain flood insurance.</span>
      <div class="form-input" style="min-width: 300px;"><span data-field="a6_photo_note">{{ a6_photo_note }}</span></div>
    </div>
    <div>
      <span class="form-label">A7. Building Diagram Number</span>
      <div class="form-input"><span data-field="a7_diagram_number">{{ a7_diagram_number }}</span></div>
    </div>
    <div>
      <span class="form-label">A8. For a building with a crawlspace or enclosure(s):</span>
      <div class="checkbox-group">
        <label><input type="checkbox" data-field="a8_crawlspace_yes" value="{{ a8_crawlspace_yes }}"> Yes</label>
        <label><input type="checkbox" data-field="a8_crawlspace_no" value="{{ a8_crawlspace_no }}"> No</label>
      </div>
    </div>
  </div>

  <div class="form-row">
    <div>
      <span class="form-label">A9. For a building with an attached garage:</span>
      <div class="checkbox-group">
        <label><input type="checkbox" data-field="a9_garage_yes" value="{{ a9_garage_yes }}"> Yes</label>
        <label><input type="checkbox" data-field="a9_garage_no" value="{{ a9_garage_no }}"> No</label>
      </div>
    </div>
    <div>
      <span class="form-label">A10. Indicate the square footage of the building:</span>
      <div class="form-input" style="width: 100px;"><span data-field="a10_sqft">{{ a10_sqft }}</span> sq ft</div>
    </div>
    <div>
      <span class="form-label">A11. Indicate the number of permanent flood openings in the crawlspace or enclosure(s) within 1.0 foot above adjacent grade:</span>
      <div class="form-input" style="width: 100px;"><span data-field="a11_flood_openings">{{ a11_flood_openings }}</span> sq in</div>
    </div>
  </div>

  <div class="form-row">
    <div>
      <span class="form-label">A12. Total net area of flood openings in A9.b:</span>
      <div class="form-input" style="width: 100px;"><span data-field="a12_total_flood_area">{{ a12_total_flood_area }}</span> sq in</div>
    </div>
    <div>
      <span class="form-label">A13. Engineered flood openings?</span>
      <div class="checkbox-group">
        <label><input type="checkbox" data-field="a13_engineered_yes" value="{{ a13_engineered_yes }}"> Yes</label>
        <label><input type="checkbox" data-field="a13_engineered_no" value="{{ a13_engineered_no }}"> No</label>
      </div>
    </div>
  </div>

  <div class="section-header">
    SECTION B – FLOOD INSURANCE RATE MAP (FIRM) INFORMATION
  </div>

  <div class="form-row">
    <div>
      <span class="form-label">B1. NFIP Community Name & Community Number</span>
      <div class="form-input"><span data-field="b1_community_name">{{ b1_community_name }}</span></div>
      <div class="form-input" style="margin-top: 5px;"><span data-field="b1_community_number">{{ b1_community_number }}</span></div>
    </div>
    <div>
      <span class="form-label">B2. County Name</span>
      <div class="form-input"><span data-field="b2_county_name">{{ b2_county_name }}</span></div>
    </div>
    <div>
      <span class="form-label">B3. State</span>
      <div class="form-input"><span data-field="b3_state">{{ b3_state }}</span></div>
    </div>
  </div>

  <div class="form-row">
    <div>
      <span class="form-label">B4. Map/Panel Number</span>
      <div class="form-input"><span data-field="b4_map_panel_number">{{ b4_map_panel_number }}</span></div>
    </div>
    <div>
      <span class="form-label">B5. Suffix</span>
      <div class="form-input"><span data-field="b5_suffix">{{ b5_suffix }}</span></div>
    </div>
    <div>
      <span class="form-label">B6. FIRM Index Date</span>
      <div class="form-input"><span data-field="b6_firm_index_date">{{ b6_firm_index_date }}</span></div>
    </div>
    <div>
      <span class="form-label">B7. FIRM Panel Effective/Revised Date</span>
      <div class="form-input"><span data-field="b7_firm_effective_date">{{ b7_firm_effective_date }}</span></div>
    </div>
    <div>
      <span class="form-label">B8. Flood Zone(s)</span>
      <div class="form-input"><span data-field="b8_flood_zone">{{ b8_flood_zone }}</span></div>
    </div>
    <div>
      <span class="form-label">B9. Base Flood Elevation(s) (Zone AO, use Base Flood Depth)</span>
      <div class="form-input"><span data-field="b9_base_flood_elevation">{{ b9_base_flood_elevation }}</span></div>
    </div>
  </div>

  <div class="form-row" style="margin-top: 30px;">
    <div style="flex: 1;">
      <span class="form-label">B10. Indicate the base flood elevation (BFE) data or base flood depth entered in Item B9:</span>
      <div class="checkbox-group">
        <label><input type="checkbox" data-field="b10_data_source_nfip" value="{{ b10_data_source_nfip }}"> NFIP Profile</label>
        <label><input type="checkbox" data-field="b10_data_source_firm" value="{{ b10_data_source_firm }}"> FIRM</label>
        <label><input type="checkbox" data-field="b10_data_source_other" value="{{ b10_data_source_other }}"> Other/Source</label>
      </div>
    </div>
    <div style="flex: 1;">
      <span class="form-label">B11. Indicate elevation datum used for BFE in Item B9:</span>
      <div class="checkbox-group">
        <label><input type="checkbox" data-field="b11_datum_ngvd1929" value="{{ b11_datum_ngvd1929 }}"> NGVD 1929</label>
        <label><input type="checkbox" data-field="b11_datum_navd1988" value="{{ b11_datum_navd1988 }}"> NAVD 1988</label>
        <label><input type="checkbox" data-field="b11_datum_other" value="{{ b11_datum_other }}"> Other/Source</label>
      </div>
    </div>
    <div style="flex: 1;">
      <span class="form-label">B12. Is the building located in a Coastal Barrier Resources System (CBRS) area or Otherwise Protected Area (OPA)?</span>
      <div class="checkbox-group">
        <label><input type="checkbox" data-field="b12_cbrs_yes" value="{{ b12_cbrs_yes }}"> Yes</label>
        <label><input type="checkbox" data-field="b12_cbrs_no" value="{{ b12_cbrs_no }}"> No</label>
      </div>
    </div>
  </div>

  <div class="section-header">
    SECTION C – BUILDING ELEVATION INFORMATION (SURVEY REQUIRED)
  </div>

  <div class="form-row">
    <div>
      <span class="form-label">C1. Building elevations are based on:</span>
      <div class="checkbox-group">
        <label><input type="checkbox" data-field="c1_construction_drawings" value="{{ c1_construction_drawings }}"> Construction Drawings</label>
        <label><input type="checkbox" data-field="c1_building_under_construction" value="{{ c1_building_under_construction }}"> Building Under Construction</label>
      </div>
    </div>
    <div>
      <span class="form-label">C2. Elevations – Zones A1-A30, AE, AH, A (with BFE), VE1, V1-V30, A/R, AR/AE, AR/A1-A30, AR/AH, AR/AO. Complete items C2.a-h below according to the building diagram in Item A7. Puerto Rico only, enter meters.</span>
      <div class="form-input" style="min-width: 400px;"><span data-field="c2_elevation_note">{{ c2_elevation_note }}</span></div>
    </div>
  </div>

  <div class="form-row">
    <div>
      <span class="form-label">Indicate elevation datum used for the elevations in items a through h below.</span>
      <div class="checkbox-group">
        <label><input type="checkbox" data-field="c2_datum_ngvd1929" value="{{ c2_datum_ngvd1929 }}"> NGVD 1929</label>
        <label><input type="checkbox" data-field="c2_datum_navd1988" value="{{ c2_datum_navd1988 }}"> NAVD 1988</label>
        <label><input type="checkbox" data-field="c2_datum_other" value="{{ c2_datum_other }}"> Other/Source</label>
      </div>
    </div>
    <div style="flex: 3;">
      <span class="form-label">Datum used for building elevations must be the same as that used for the BFE.</span>
    </div>
  </div>

  <div class="table-container">
    <thead>
      <tr>
        <th style="width: 20%;">Check the measurement used.</th>
        <th style="width: 15%;">Item</th>
        <th style="width: 20%;">Description</th>
        <th style="width: 25%;">Value</th>
        <th style="width: 20%;">Units</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><input type="checkbox" data-field="c3_check_used" value="{{ c3_check_used }}"></td>
        <td>a)</td>
        <td>Top of bottom floor (including basement, crawlspace, or enclosure floor)</td>
        <td><span data-field="c3_a_value">{{ c3_a_value }}</span></td>
        <td><span data-field="c3_a_units">{{ c3_a_units }}</span></td>
      </tr>
      <tr>
        <td><input type="checkbox" data-field="c3_check_used" value="{{ c3_check_used }}"></td>
        <td>b)</td>
        <td>Top of the next higher floor</td>
        <td><span data-field="c3_b_value">{{ c3_b_value }}</span></td>
        <td><span data-field="c3_b_units">{{ c3_b_units }}</span></td>
      </tr>
      <tr>
        <td><input type="checkbox" data-field="c3_check_used" value="{{ c3_check_used }}"></td>
        <td>c)</td>
        <td>Bottom of the lowest horizontal structural member (V Zones only)</td>
        <td><span data-field="c3_c_value">{{ c3_c_value }}</span></td>
        <td><span data-field="c3_c_units">{{ c3_c_units }}</span></td>
      </tr>
      <tr>
        <td><input type="checkbox" data-field="c3_check_used" value="{{ c3_check_used }}"></td>
        <td>d)</td>
        <td>Attached garage (top of slab)</td>
        <td><span data-field="c3_d_value">{{ c3_d_value }}</span></td>
        <td><span data-field="c3_d_units">{{ c3_d_units }}</span></td>
      </tr>
      <tr>
        <td><input type="checkbox" data-field="c3_check_used" value="{{ c3_check_used }}"></td>
        <td>e)</td>
        <td>Lowest elevation of machinery or equipment servicing the building (Describe type of equipment and location in Comments)</td>
        <td><span data-field="c3_e_value">{{ c3_e_value }}</span></td>
        <td><span data-field="c3_e_units">{{ c3_e_units }}</span></td>
      </tr>
      <tr>
        <td><input type="checkbox" data-field="c3_check_used" value="{{ c3_check_used }}"></td>
        <td>f)</td>
        <td>Lowest adjacent (finished) grade next to building (LAG)</td>
        <td><span data-field="c3_f_value">{{ c3_f_value }}</span></td>
        <td><span data-field="c3_f_units">{{ c3_f_units }}</span></td>
      </tr>
      <tr>
        <td><input type="checkbox" data-field="c3_check_used" value="{{ c3_check_used }}"></td>
        <td>g)</td>
        <td>Highest adjacent (finished) grade next to building (HAG)</td>
        <td><span data-field="c3_g_value">{{ c3_g_value }}</span></td>
        <td><span data-field="c3_g_units">{{ c3_g_units }}</span></td>
      </tr>
      <tr>
        <td><input type="checkbox" data-field="c3_check_used" value="{{ c3_check_used }}"></td>
        <td>h)</td>
        <td>Lowest adjacent grade at lowest elevation of deck or stairs, including structural support</td>
        <td><span data-field="c3_h_value">{{ c3_h_value }}</span></td>
        <td><span data-field="c3_h_units">{{ c3_h_units }}</span></td>
      </tr>
    </tbody>
  </div>

  <div class="form-row" style="margin-top: 30px;">
    <div style="flex: 1;">
      <span class="form-label">SECTION D – SURVEYOR, ENGINEER, OR ARCHITECT CERTIFICATION</span>
      <p style="font-size: 9pt; margin: 5px 0;">I certify that the information on this Certificate represents my best efforts to interpret the data available. I understand that any false statement may be punishable by fine or imprisonment under 18 U.S. Code, Section 1001.</p>
      <div class="form-row" style="margin-top: 15px;">
        <div style="flex: 1;">
          <span class="form-label">Were latitude and longitude in Section A provided by a licensed land surveyor?</span>
          <div class="checkbox-group">
            <label><input type="checkbox" data-field="d1_surveyor_lat_lon_yes" value="{{ d1_surveyor_lat_lon_yes }}"> Yes</label>
            <label><input type="checkbox" data-field="d1_surveyor_lat_lon_no" value="{{ d1_surveyor_lat_lon_no }}"> No</label>
          </div>
        </div>
        <div style="flex: 1; text-align: right;">
          <label><input type="checkbox" data-field="d1_attachments_check" value="{{ d1_attachments_check }}"> Check here if attachments.</label>
        </div>
      </div>
    </div>
    <div style="flex: 2;">
      <div class="form-row" style="margin-top: 20px;">
        <div style="flex: 1;">
          <span class="form-label">Certifier's Name</span>
          <div class="form-input"><span data-field="d2_certifier_name">{{ d2_certifier_name }}</span></div>
        </div>
        <div style="flex: 1;">
          <span class="form-label">License Number</span>
          <div class="form-input"><span data-field="d2_license_number">{{ d2_license_number }}</span></div>
        </div>
      </div>
      <div class="form-row" style="margin-top: 15px;">
        <div style="flex: 1;">
          <span class="form-label">Title</span>
          <div class="form-input"><span data-field="d3_title">{{ d3_title }}</span></div>
        </div>
        <div style="flex: 1;">
          <span class="form-label">Date</span>
          <div class="form-input"><span data-field="d3_date">{{ d3_date }}</span></div>
        </div>
      </div>
      <div class="form-row" style="margin-top: 15px;">
        <div style="flex: 1;">
          <span class="form-label">Company Name</span>
          <div class="form-input"><span data-field="d4_company_name">{{ d4_company_name }}</span></div>
        </div>
        <div style="flex: 1;">
          <span class="form-label">Telephone</span>
          <div class="form-input"><span data-field="d4_telephone">{{ d4_telephone }}</span></div>
        </div>
      </div>
      <div class="form-row" style="margin-top: 15px;">
        <div style="flex: 1;">
          <span class="form-label">Address</span>
          <div class="form-input"><span data-field="d5_address">{{ d5_address }}</span></div>
        </div>
        <div style="flex: 1;">
          <span class="form-label">Ext.</span>
          <div class="form-input"><span data-field="d5_extension">{{ d5_extension }}</span></div>
        </div>
      </div>
    </div>
  </div>

  <div class="signature-block">
    <div class="signature-area">
      <div class="signature-line"></div>
      <div style="margin-top: 5px;">Signature</div>
    </div>
    <div class="signature-area" style="text-align: right;">
      <div style="border: 1px solid #000; width: 150px; height: 100px; margin: auto;">Place Seal Here</div>
    </div>
  </div>

  <div class="form-row" style="margin-top: 30px;">
    <div style="flex: 1;">
      <span class="form-label">Comments (including type of equipment and location, per C2(e), if applicable)</span>
      <div style="border: 1px solid #000; height: 100px; padding: 5px; font-size: 10pt;"><span data-field="d6_comments">{{ d6_comments }}</span></div>
    </div>
  </div>

  <div class="footer">
    FEMA Form 086-0-33 (7/15) &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Replaces all previous editions. &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Form Page 2 of 6
  </div>
</div>

<div class="page">
  <div class="header-info">
    <div>OMB No. <span data-field="omb_number_p2">{{ omb_number_p2 }}</span></div>
    <div>Expiration Date: <span data-field="expiration_date_p2">{{ expiration_date_p2 }}</span></div>
  </div>

  <div class="title-section" style="margin-top: 10px;">
    <h1 style="font-size: 24pt; margin-bottom: 5px;">U.S. DEPARTMENT OF HOMELAND SECURITY</h1>
    <h2 style="font-size: 18pt; margin-top: 0;">Federal Emergency Management Agency</h2>
    <h3 style="font-size: 20pt; margin-top: 0;">ELEVATION CERTIFICATE</h3>
  </div>

  <p style="font-size: 10pt; margin-bottom: 20px;">
    Important: Follow the instructions on pages 1–9.
  </p>

  <div class="section-header">
    SECTION E – BUILDING ELEVATION INFORMATION (SURVEY NOT REQUIRED)
  </div>

  <div class="form-row">
    <div>
