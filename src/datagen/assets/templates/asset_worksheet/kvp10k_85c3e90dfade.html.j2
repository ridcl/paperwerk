<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  .header-title { font-size: 18pt; font-weight: bold; }
  .section-heading { font-size: 12pt; font-weight: bold; margin-top: 20px; margin-bottom: 5px; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 10px; }
  .form-label { width: 30%; }
  .form-input-area { width: 65%; border-bottom: 1px solid #000; }
  .two-column-section { display: flex; justify-content: space-between; margin-top: 20px; }
  .two-column-item { width: 48%; }
  .signature-line { border-bottom: 1px solid #000; margin-top: 50px; margin-bottom: 50px; }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      <div class="header-title">STUDENT/SPOUSE ASSET WORK SHEET</div>
    </div>
    <div>
      <div style="font-size: 12pt; font-weight: bold;">Student Financial Assistance</div>
      <div style="font-size: 10pt;">UCF | UNIVERSITY OF CENTRAL FLORIDA</div>
    </div>
  </div>

  <div style="margin-top: 30px;">
    <div style="font-size: 14pt; font-weight: bold;">2021-2022 ACADEMIC YEAR</div>
  </div>

  <div style="margin-top: 30px;">
    <div class="form-row">
      <div class="form-label">Student's Name:</div>
      <div class="form-input-area"><span data-field="full_name">{{ full_name }}</span></div>
    </div>
    <div class="form-row">
      <div class="form-label">Address:</div>
      <div class="form-input-area"><span data-field="address">{{ address }}</span></div>
    </div>
    <div class="form-row">
      <div class="form-label">City:</div>
      <div class="form-input-area"><span data-field="city">{{ city }}</span></div>
    </div>
    <div class="form-row">
      <div class="form-label">Spouse's Name:</div>
      <div class="form-input-area"><span data-field="spouse_full_name">{{ spouse_full_name }}</span></div>
    </div>
  </div>

  <div style="margin-top: 30px;">
    <div class="form-row">
      <div class="form-label">UCF ID:</div>
      <div class="form-input-area"><span data-field="ucf_id">{{ ucf_id }}</span></div>
    </div>
    <div class="form-row">
      <div class="form-label">Date:</div>
      <div class="form-input-area"><span data-field="date">{{ date }}</span></div>
    </div>
    <div class="form-row">
      <div class="form-label">State/Zip:</div>
      <div class="form-input-area"><span data-field="state_zip">{{ state_zip }}</span></div>
    </div>
    <div class="form-row">
      <div class="form-label">Phone:</div>
      <div class="form-input-area"><span data-field="phone">{{ phone }}</span></div>
    </div>
  </div>

  <div style="margin-top: 30px; font-size: 10pt;">
    Complete every question in this worksheet to report the value and debt of assets as of the day you first completed the FAFSA. Do not leave any answer blank. If the tax return indicates the existence of an asset such as interest, dividends, capital gains, rental real estate, partnerships, and S corporations, and you report a $0 value, please provide a written explanation below.
  </div>

  <div style="margin-top: 20px;">
    <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
      <div style="width: 45%;">CASH, SAVINGS, AND CHECKING ACCOUNTS:</div>
      <div style="width: 10%;">VALUE</div>
      <div style="width: 10%;">DEBT</div>
    </div>
    <div style="border-bottom: 1px solid #000; margin-bottom: 20px;" data-field="debt">{{ debt }}</div>
  </div>

  <div style="margin-top: 20px;">
    <div class="section-heading">REAL ESTATE:</div>
    <div style="font-size: 10pt; margin-bottom: 10px;">(Ex: land, rental property, second and summer homes. DO NOT INCLUDE THE HOME YOU LIVE IN)</div>
    <div class="form-row">
      <div class="form-label">Was rental property sold/foreclosed?:</div>
      <div class="form-input-area" data-field="was_rental_property_sold_foreclosed">{{ was_rental_property_sold_foreclosed }}</div>
    </div>
    <div class="form-row">
      <div class="form-label">Was the rental property(s) listed on your or your spouse's Schedule E?:</div>
      <div class="form-input-area">
        <span data-field="rental_property_schedule_e_yes">{{ rental_property_schedule_e_yes }}</span> Yes / <span data-field="rental_property_schedule_e_no">{{ rental_property_schedule_e_no }}</span> No
      </div>
    </div>
    <div style="margin-top: 15px;">
      <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
        <div style="width: 45%;">Address of rental property:</div>
        <div class="form-input-area" style="width: 50%;" data-field="address_of_rental_property">{{ address_of_rental_property }}</div>
      </div>
    </div>
  </div>

  <div style="margin-top: 30px;">
    <div class="section-heading">INVESTMENTS:</div>
    <div style="font-size: 10pt; margin-bottom: 10px;">(Ex: Qualified tuition plans such as Florida prepaid and 529s, CDs, trusts, mutual funds, stocks, bonds, Education IRAs, S corporations, partnerships, etc.)</div>
    <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
      <div style="width: 45%;"></div>
      <div style="width: 10%;">VALUE</div>
      <div style="width: 10%;">DEBT</div>
    </div>
    <div style="border-bottom: 1px solid #000; margin-bottom: 20px;" data-field="debt_2">{{ debt_2 }}</div>
  </div>

  <div style="margin-top: 30px;">
    <div class="section-heading">BUSINESS:</div>
    <div style="font-size: 10pt; margin-bottom: 10px;">(Ex: land, buildings, inventories, equipment, machinery, etc. Note: Do not report small businesses that you or your spouse own and control that has 100 or fewer full time or full time equivalent employees.)</div>
    <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
      <div style="width: 45%;"></div>
      <div style="width: 10%;">VALUE</div>
      <div style="width: 10%;">DEBT</div>
    </div>
    <div style="border-bottom: 1px solid #000; margin-bottom: 20px;" data-field="debt_3">{{ debt_3 }}</div>
  </div>

  <div style="margin-top: 30px;">
    <div class="section-heading">FARM INVESTMENT:</div>
    <div style="font-size: 10pt; margin-bottom: 10px;">(Ex: livestock, machinery, land, buildings, equipment, etc.)</div>
    <div class="form-row">
      <div class="form-label">Does the family live on a farm?:</div>
      <div class="form-input-area">
        <span data-field="farm_living_yes">{{ farm_living_yes }}</span> Yes <span data-field="farm_living_no">{{ farm_living_no }}</span> No
      </div>
    </div>
    <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
      <div style="width: 45%;"></div>
      <div style="width: 10%;">VALUE</div>
      <div style="width: 10%;">DEBT</div>
    </div>
    <div style="border-bottom: 1px solid #000; margin-bottom: 20px;" data-field="debt_4">{{ debt_4 }}</div>
  </div>

  <div style="margin-top: 30px;">
    <div class="section-heading">Explanation:</div>
    <div style="border-bottom: 1px solid #000; height: 100px; margin-bottom: 50px;" data-field="explanation">{{ explanation }}</div>
  </div>

  <div style="display: flex; justify-content: space-between; margin-top: 50px;">
    <div style="width: 30%;">Student's Signature</div>
    <div style="width: 20%; text-align: center;">Date</div>
    <div style="width: 30%;">Spouse's Signature</div>
    <div style="width: 20%; text-align: center;">Date</div>
  </div>
  <div style="display: flex; justify-content: space-between; margin-top: 50px;">
    <div style="width: 30%; height: 1px; border-bottom: 1px solid #000;" data-field="date_2">{{ date_2 }}</div>
    <div style="width: 20%; height: 1px; border-bottom: 1px solid #000;" data-field="date_3">{{ date_3 }}</div>
    <div style="width: 30%; height: 1px; border-bottom: 1px solid #000;" data-field="date_4">{{ date_4 }}</div>
    <div style="width: 20%; height: 1px; border-bottom: 1px solid #000;" data-field="date_5">{{ date_5 }}</div>
  </div>

  <div style="margin-top: 100px; font-size: 8pt; text-align: center;">
    Submit complete forms at finaid.ucf.edu/upload. Route this form to Verification/ Taxes<br>
    Phone: 407.823.2827 • Fax: 407.823.5241 • Web: finaid.ucf.edu | a division of Student Development and Enrollment Services
  </div>
</div>