<!DOCTYPE html>
<html>
<head>
    <title>Accident Form</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
        }
        .page:last-child { page-break-after: auto; }
        .form-section { margin-bottom: 20px; }
        .line-item-row { display: flex; justify-content: space-between; margin-bottom: 10px; }
        .line-item-row > div { flex: 1; margin-right: 10px; }
        .full-width-line { width: 100%; border-bottom: 1px solid #000; margin-top: 5px; margin-bottom: 5px; }
        .grid-2-col { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
        .grid-3-col { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    </style>
</head>
<body>
    <div class="page">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px;">
            <div style="text-align: left;">
                <h1 style="font-size: 24pt; margin: 0;">Eastern Illinois University</h1>
            </div>
            <div style="text-align: right;">
                <h1 style="font-size: 24pt; margin: 0;">Accident Form</h1>
                <div style="margin-top: 30px;">
                    Date: <span class="full-width-line" style="width: 200px;" data-field="accident_form">{{ accident_form }}</span>
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="grid-2-col">
                <div>
                    First Name: <span class="full-width-line" style="width: 300px;" data-field="date">{{ date }}</span>
                </div>
                <div>
                    Last Name: <span class="full-width-line" style="width: 300px;" data-field="first_name">{{ first_name }}</span>
                </div>
            </div>
            <div class="grid-2-col" style="margin-top: 20px;">
                <div>
                    Local Address: <span class="full-width-line" style="width: 300px;" data-field="last_name">{{ last_name }}</span>
                </div>
                <div>
                    State / Province: <span class="full-width-line" style="width: 300px;" data-field="local_address">{{ local_address }}</span>
                </div>
            </div>
            <div class="grid-2-col" style="margin-top: 20px;">
                <div>
                    Phone: <span class="full-width-line" style="width: 300px;" data-field="state_province">{{ state_province }}</span>
                </div>
                <div>
                    Zip / Postal Code: <span class="full-width-line" style="width: 300px;" data-field="phone">{{ phone }}</span>
                </div>
            </div>
            <div class="grid-2-col" style="margin-top: 20px;">
                <div>
                    Email: <span class="full-width-line" style="width: 300px;" data-field="zip_postal_code">{{ zip_postal_code }}</span>
                </div>
                <div>
                    Status (Please X below):
                    <div style="margin-top: 10px;">
                        <label><input type="radio" name="status"> Student</label>
                        <label><input type="radio" name="status"> Faculty</label>
                        <label><input type="radio" name="status"> Guest</label>
                        <label><input type="radio" name="status"> Other</label>
                        <label><input type="radio" name="status"> Specify Other</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-section">
            <h3 style="margin-bottom: 15px;">Nature of suspected / stated injury or illness</h3>
            <div style="display: flex; flex-wrap: wrap; gap: 20px; font-size: 10pt;">
                <label><input type="checkbox"> Abrasion</label>
                <label><input type="checkbox"> Amputation</label>
                <label><input type="checkbox"> Bleeding</label>
                <label><input type="checkbox"> Bruise</label>
                <label><input type="checkbox"> Burn/Scald</label>
                <label><input type="checkbox"> Concussion</label>
                <label><input type="checkbox"> Convulsion</label>
                <label><input type="checkbox"> Cramps</label>
                <label><input type="checkbox"> Dislocation</label>
                <label><input type="checkbox"> Drowning</label>
                <label><input type="checkbox"> Fainting</label>
                <label><input type="checkbox"> Foreign Body</label>
                <label><input type="checkbox"> Fracture</label>
                <label><input type="checkbox"> Heart</label>
                <label><input type="checkbox"> Heat Exhaustion</label>
                <label><input type="checkbox"> Heat Stroke</label>
                <label><input type="checkbox"> Inhalation</label>
                <label><input type="checkbox"> Internal Injury</label>
                <label><input type="checkbox"> Laceration</label>
                <label><input type="checkbox"> Poisoning</label>
                <label><input type="checkbox"> Puncture</label>
                <label><input type="checkbox"> Shock (Specify)</label>
                <label><input type="checkbox"> Suffocation</label>
                <label><input type="checkbox"> Other</label>
            </div>
        </div>

        <div class="form-section">
            <h3 style="margin-bottom: 15px;">Part of body that was injured: (Please mark "R" for Right and "L" for Left)</h3>
            <div style="display: flex; flex-wrap: wrap; gap: 20px; font-size: 10pt;">
                <label><input type="checkbox"> Generalized</label>
                <label><input type="checkbox"> Skull/Scalp</label>
                <label><input type="checkbox"> Eye</label>
                <label><input type="checkbox"> Ear</label>
                <label><input type="checkbox"> Nose</label>
                <label><input type="checkbox"> Mouth</label>
                <label><input type="checkbox"> Tongue</label>
                <label><input type="checkbox"> Tooth</label>
                <label><input type="checkbox"> Jaw</label>
                <label><input type="checkbox"> Neck</label>
                <label><input type="checkbox"> Pelvis</label>
                <label><input type="checkbox"> Shoulder</label>
                <label><input type="checkbox"> Upper Arm</label>
                <label><input type="checkbox"> Elbow</label>
                <label><input type="checkbox"> Forearm</label>
                <label><input type="checkbox"> Knee</label>
                <label><input type="checkbox"> Lower Leg</label>
                <label><input type="checkbox"> Ankle</label>
                <label><input type="checkbox"> Foot</label>
                <label><input type="checkbox"> Toe</label>
                <label><input type="checkbox"> Other</label>
            </div>
        </div>

        <div class="form-section">
            <p>A. Please indicate below the exact location of the accident and the conditions in which the accident occurred:</p>
            <div class="full-width-line" style="height: 100px;" data-field="other">{{ other }}</div>
        </div>

        <div class="form-section">
            <p>B. Name of department sponsoring the event</p>
            <div class="full-width-line" style="width: 50%;" data-field="field_1">{{ field_1 }}</div>
        </div>

        <div class="form-section">
            <p>C. How did the injury occur? (Describe in full the events, actions, and conditions which contributed to the injury.)</p>
            <div class="full-width-line" style="height: 100px;" data-field="field_2">{{ field_2 }}</div>
        </div>

        <div class="form-section">
            <p>D. Precise explanation of action taken (First Aid? Referred to Health Service?)</p>
            <div class="full-width-line" style="height: 100px;" data-field="field_3">{{ field_3 }}</div>
        </div>

        <div class="form-section">
            <p>E. Care of injured transferred to:</p>
            <div class="grid-2-col">
                <div>
                    Name: <span class="full-width-line" style="width: 50%;" data-field="e_care_of_injured_transferred_to">{{ e_care_of_injured_transferred_to }}</span>
                </div>
                <div>
                    Position: <span class="full-width-line" style="width: 50%;" data-field="name">{{ name }}</span>
                </div>
            </div>
        </div>

        <div class="form-section">
            <p>Police Called?</p>
            <div style="display: flex; gap: 30px; margin-top: 10px;">
                <div>
                    No <input type="radio" name="police_called"> Yes <input type="radio" name="police_called">
                    Time Called: <span class="full-width-line" style="width: 150px;" data-field="yes">{{ yes }}</span>
                </div>
                <div>
                    Arrival Time: <span class="full-width-line" style="width: 150px;" data-field="time_called">{{ time_called }}</span>
                </div>
            </div>
        </div>

        <div class="form-section">
            <p>Ambulance Called?</p>
            <div style="display: flex; gap: 30px; margin-top: 10px;">
                <div>
                    No <input type="radio" name="ambulance_called"> Yes <input type="radio" name="ambulance_called">
                    Time Called: <span class="full-width-line" style="width: 150px;" data-field="yes_2">{{ yes_2 }}</span>
                </div>
                <div>
                    Arrival Time: <span class="full-width-line" style="width: 150px;" data-field="time_called_2">{{ time_called_2 }}</span>
                </div>
            </div>
        </div>

        <div class="form-section">
            <p>Sent to Health Services:</p>
            <div style="display: flex; gap: 30px; margin-top: 10px;">
                <div>
                    No <input type="radio" name="sent_health"> Yes <input type="radio" name="sent_health">
                </div>
            </div>
        </div>

        <div class="form-section">
            <p>Sent to hospital / clinic?</p>
            <div style="display: flex; gap: 30px; margin-top: 10px;">
                <div>
                    No <input type="radio" name="sent_hospital"> Yes <input type="radio" name="sent_hospital">
                </div>
            </div>
        </div>

        <div class="form-section">
            <p>If yes, Specify</p>
            <div class="full-width-line" style="height: 50px;" data-field="if_yes_specify">{{ if_yes_specify }}</div>
        </div>

        <div class="form-section">
            <h3 style="margin-bottom: 15px;">F. Witness</h3>
            <div class="grid-2-col">
                <div>
                    First Name: <span class="full-width-line" style="width: 50%;" data-field="f_witness">{{ f_witness }}</span>
                </div>
                <div>
                    Last Name: <span class="full-width-line" style="width: 50%;" data-field="first_name_2">{{ first_name_2 }}</span>
                </div>
            </div>
            <div class="grid-2-col" style="margin-top: 20px;">
                <div>
                    Local Address: <span class="full-width-line" style="width: 50%;" data-field="last_name_2">{{ last_name_2 }}</span>
                </div>
                <div>
                    State/Province: <span class="full-width-line" style="width: 50%;" data-field="local_address_2">{{ local_address_2 }}</span>
                </div>
            </div>
            <div class="grid-2-col" style="margin-top: 20px;">
                <div>
                    Phone Number: <span class="full-width-line" style="width: 50%;" data-field="state_province_2">{{ state_province_2 }}</span>
                </div>
                <div>
                    Zip/Postal Code: <span class="full-width-line" style="width: 50%;" data-field="phone_number">{{ phone_number }}</span>
                </div>
            </div>
            <div class="grid-2-col" style="margin-top: 20px;">
                <div>
                    Email: <span class="full-width-line" style="width: 50%;" data-field="zip_postal_code_2">{{ zip_postal_code_2 }}</span>
                </div>
                <div>
                    <!-- Empty placeholder -->
                </div>
            </div>
        </div>

        <div class="form-section">
            <h3 style="margin-bottom: 15px;">G. Accident Form</h3>
            <div class="grid-2-col">
                <div>
                    Prepared by: <span class="full-width-line" style="width: 50%;" data-field="g_accident_form">{{ g_accident_form }}</span>
                </div>
                <div>
                    Position: <span class="full-width-line" style="width: 50%;" data-field="prepared_by">{{ prepared_by }}</span>
                </div>
            </div>
            <div style="margin-top: 20px;">
                Date: <span class="full-width-line" style="width: 300px;" data-field="position">{{ position }}</span>
            </div>
        </div>

        <div class="form-section">
            <h3 style="margin-bottom: 15px;">H. Campus Address (corresponds with number chart below)</h3>
            <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
                <div style="width: 30%;">Building</div>
                <div style="width: 30%;">Room Number</div>
                <div style="width: 30%;">Other</div>
            </div>
            <table style="width: 100%; border-collapse: collapse; font-size: 10pt;">
                <thead>
                    <tr style="border-bottom: 1px solid #000;">
                        <th style="padding: 5px; text-align: left;">#</th>
                        <th style="padding: 5px; text-align: left;">Building</th>
                        <th style="padding: 5px; text-align: left;">Room Number</th>
                        <th style="padding: 5px; text-align: left;">Other</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td style="padding: 5px;">1.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.building_1">{{ campus_address.building_1 }}</span></td>
                        <td style="padding: 5px;">12.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.other_12">{{ campus_address.other_12 }}</span></td>
                    </tr>
                    <tr>
                        <td style="padding: 5px;">2.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.building_2">{{ campus_address.building_2 }}</span></td>
                        <td style="padding: 5px;">13.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.other_13">{{ campus_address.other_13 }}</span></td>
                    </tr>
                    <tr>
                        <td style="padding: 5px;">3.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.building_3">{{ campus_address.building_3 }}</span></td>
                        <td style="padding: 5px;">14.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.other_14">{{ campus_address.other_14 }}</span></td>
                    </tr>
                    <tr>
                        <td style="padding: 5px;">4.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.building_4">{{ campus_address.building_4 }}</span></td>
                        <td style="padding: 5px;">15.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.other_15">{{ campus_address.other_15 }}</span></td>
                    </tr>
                    <tr>
                        <td style="padding: 5px;">5.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.building_5">{{ campus_address.building_5 }}</span></td>
                        <td style="padding: 5px;">16.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.other_16">{{ campus_address.other_16 }}</span></td>
                    </tr>
                    <tr>
                        <td style="padding: 5px;">6.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.building_6">{{ campus_address.building_6 }}</span></td>
                        <td style="padding: 5px;">17.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.other_17">{{ campus_address.other_17 }}</span></td>
                    </tr>
                    <tr>
                        <td style="padding: 5px;">7.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.building_7">{{ campus_address.building_7 }}</span></td>
                        <td style="padding: 5px;">18.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.other_18">{{ campus_address.other_18 }}</span></td>
                    </tr>
                    <tr>
                        <td style="padding: 5px;">8.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.building_8">{{ campus_address.building_8 }}</span></td>
                        <td style="padding: 5px;">19.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.other_19">{{ campus_address.other_19 }}</span></td>
                    </tr>
                    <tr>
                        <td style="padding: 5px;">9.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.building_9">{{ campus_address.building_9 }}</span></td>
                        <td style="padding: 5px;">20.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.other_20">{{ campus_address.other_20 }}</span></td>
                    </tr>
                    <tr>
                        <td style="padding: 5px;">10.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.building_10">{{ campus_address.building_10 }}</span></td>
                        <td style="padding: 5px;">21.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.other_21">{{ campus_address.other_21 }}</span></td>
                    </tr>
                    <tr>
                        <td style="padding: 5px;">11.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.building_11">{{ campus_address.building_11 }}</span></td>
                        <td style="padding: 5px;">22.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.other_22">{{ campus_address.other_22 }}</span></td>
                    </tr>
                    <tr>
                        <td style="padding: 5px;">23.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.building_23">{{ campus_address.building_23 }}</span></td>
                        <td style="padding: 5px;">24.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.other_24">{{ campus_address.other_24 }}</span></td>
                    </tr>
                    <tr>
                        <td style="padding: 5px;">25.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.building_25">{{ campus_address.building_25 }}</span></td>
                        <td style="padding: 5px;">26.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.other_26">{{ campus_address.other_26 }}</span></td>
                    </tr>
                    <tr>
                        <td style="padding: 5px;">27.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.building_27">{{ campus_address.building_27 }}</span></td>
                        <td style="padding: 5px;">28.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.other_28">{{ campus_address.other_28 }}</span></td>
                    </tr>
                    <tr>
                        <td style="padding: 5px;">29.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.building_29">{{ campus_address.building_29 }}</span></td>
                        <td style="padding: 5px;">30.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.other_30">{{ campus_address.other_30 }}</span></td>
                    </tr>
                    <tr>
                        <td style="padding: 5px;">31.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.building_31">{{ campus_address.building_31 }}</span></td>
                        <td style="padding: 5px;">32.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.other_32">{{ campus_address.other_32 }}</span></td>
                    </tr>
                    <tr>
                        <td style="padding: 5px;">33.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.building_33">{{ campus_address.building_33 }}</span></td>
                        <td style="padding: 5px;">34.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.other_34">{{ campus_address.other_34 }}</span></td>
                    </tr>
                    <tr>
                        <td style="padding: 5px;">35.</td>
                        <td style="padding: 5px;"><span data-field="campus_address.building_35">{{ campus_address.building_35 }}</span></td>
                        <td style="padding: 5px;"></td>
                        <td style="padding: 5px;"></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="form-section" style="margin-top: 50px;">
            <p>Please sign</p>
            <p>Injured party (if possible): <span class="full-width-line" style="width: 50%;" data-field="please_sign">{{ please_sign }}</span></p>
            <p>Person filing report: <span class="full-width-line" style="width: 50%;" data-field="injured_party">{{ injured_party }}</span></p>
        </div>

        <div style="text-align: center; margin-top: 80px;">
            <button style="padding: 10px 30px; font-size: 12pt; border: 1px solid #000;">Print Form</button>
        </div>
    </div>
</body>
</html>