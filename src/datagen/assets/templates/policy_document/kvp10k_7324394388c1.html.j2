<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  th, td {
    padding: 10px 0;
    text-align: left;
  }
  hr {
    border: 0;
    height: 1px;
    background: #000;
    margin: 20px 0;
  }
</style>

<div class="page">
  <div style="text-align: center;">
    <img src="logo_placeholder.png" alt="Logo" style="height: 50px; margin-bottom: 10px;">
    <h1 style="font-size: 24pt; margin: 0;">Western Oregon UNIVERSITY</h1>
  </div>

  <div style="display: flex; justify-content: space-between; margin-top: 30px;">
    <div>
      <p>Division: <span data-field="division">{{ division }}</span></p>
      <p>Classification: <span data-field="classification">{{ classification }}</span></p>
      <p>Department phone: <span data-field="department_phone">{{ department_phone }}</span></p>
      <p>Department email: <span data-field="department_email">{{ department_email }}</span></p>
    </div>
  </div>

  <h2 style="font-size: 16pt; margin-top: 40px;">TITLE</h2>
  <div style="border: 1px solid #000; padding: 10px 0;">
    <p><span data-field="title">{{ title }}</span></p>
  </div>

  <h2 style="font-size: 16pt; margin-top: 30px;">POLICY NUMBER</h2>
  <div style="border: 1px solid #000; padding: 10px 0;">
    <p><span data-field="policy_number">{{ policy_number }}</span></p>
  </div>

  <table style="margin-top: 30px;">
    <tr>
      <th style="width: 50%;">RESPONSIBLE OFFICER</th>
      <th style="width: 50%;">UNIVERSITY CONTACT</th>
    </tr>
    <tr>
      <td><span data-field="responsible_officer">{{ responsible_officer }}</span></td>
      <td><span data-field="university_contact">{{ university_contact }}</span></td>
    </tr>
  </table>

  <h2 style="font-size: 16pt; margin-top: 30px;">SUMMARY</h2>
  <p><span data-field="summary_text">{{ summary_text }}</span></p>

  <h2 style="font-size: 16pt; margin-top: 30px;">APPLICABLE TO</h2>
  <p><span data-field="applicable_to_text">{{ applicable_to_text }}</span></p>

  <h2 style="font-size: 16pt; margin-top: 30px;">DEFINITIONS</h2>
  <p><span data-field="definition_1">{{ definition_1 }}</span></p>
  <p><span data-field="definition_2">{{ definition_2 }}</span></p>

  <h2 style="font-size: 16pt; margin-top: 30px;">AUTHORITY</h2>
  <p><span data-field="authority">{{ authority }}</span></p>
</div>

<div class="page">
  <h2 style="font-size: 16pt; margin-top: 0;">STATEMENT OF AUTHORITY</h2>
  <p><span data-field="statement_of_authority_text">{{ statement_of_authority_text }}</span></p>

  <h2 style="font-size: 16pt; margin-top: 30px;">REFERENCES OR RELATED POLICIES</h2>
  <ul>
    <li><span data-field="reference_policy_1">{{ reference_policy_1 }}</span></li>
    <li><span data-field="reference_policy_2">{{ reference_policy_2 }}</span></li>
    <li><span data-field="reference_policy_3">{{ reference_policy_3 }}</span></li>
  </ul>

  <h2 style="font-size: 16pt; margin-top: 30px;">RELEVANT DOCUMENTS AND LINKS</h2>
  <!-- This section is left empty as no specific structure was provided for links -->
</div>

<div class="page">
  <table style="width: 100%;">
    <tr>
      <th style="width: 30%;">HISTORY</th>
      <th style="width: 70%;"></th>
    </tr>
    <tr>
      <td>APPROVAL DATE:</td>
      <td><span data-field="approval_date">{{ approval_date }}</span></td>
    </tr>
    <tr>
      <td>EFFECTIVE DATE:</td>
      <td><span data-field="effective_date">{{ effective_date }}</span></td>
    </tr>
    <tr>
      <td>LAST UPDATED:</td>
      <td><span data-field="last_updated">{{ last_updated }}</span></td>
    </tr>
    <tr>
      <td>HISTORICAL DETAIL NOTES:</td>
      <td><span data-field="historical_detail_notes">{{ historical_detail_notes }}</span></td>
    </tr>
    <tr>
      <td>SOURCE:</td>
      <td><span data-field="source">{{ source }}</span></td>
    </tr>
    <tr>
      <td>KEYWORDS</td>
      <td>
        {% for keyword in keywords %}
          <span data-field="keywords[{{ loop.index0 }}]">{{ keyword }}</span>
          {% if not loop.last %}, {% endif %}
        {% endfor %}
      </td>
    </tr>
  </table>
</div>