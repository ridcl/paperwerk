<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child {
    page-break-after: auto;
  }
  h1 {
    font-size: 24pt;
    font-weight: bold;
    text-align: center;
    margin-bottom: 30px;
  }
  .form-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 20px;
}
  .form-group {
    width: 48%;
  }
  .form-group label {
    display: block;
    margin-bottom: 5px;
    font-weight: bold;
  }
  .form-group input[type="text"] {
    width: 100%;
    padding: 8px;
    border: 1px solid #ccc;
    box-sizing: border-box;
  }
  .instructions {
    margin-top: 30px;
    line-height: 1.6;
    font-size: 11pt;
  }
  .checkbox-section {
    margin-top: 30px;
  }
  .checkbox-group {
    display: flex;
    justify-content: space-between;
    margin-bottom: 15px;
  }
  .checkbox-column {
    width: 48%;
  }
  .checkbox-item {
    margin-bottom: 8px;
    display: flex;
    align-items: center;
  }
  .checkbox-item input[type="checkbox"] {
    margin-right: 10px;
  }
  .divider {
    border-top: 1px solid #ccc;
    margin-top: 20px;
    margin-bottom: 20px;
  }
  .footer {
    margin-top: 50px;
    font-size: 9pt;
    color: #555;
  }
</style>

<div class="page">
  <h1>DOCUMENTATION SUBMISSION FORM</h1>
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px;">
    <div class="form-group" style="width: 45%;">
      <label for="first_name">First Name:</label>
      <input type="text" id="first_name" data-field="first_name" value="{{ first_name }}">
    </div>
    <div class="form-group" style="width: 45%;">
      <label for="last_name">Last Name:</label>
      <input type="text" id="last_name" data-field="last_name" value="{{ last_name }}">
    </div>
  </div>

  <div class="form-row">
    <div class="form-group" style="width: 48%;">
      <label for="ucfid">UCFID:</label>
      <input type="text" id="ucfid" data-field="ucfid" value="{{ ucfid }}">
    </div>
    <div class="form-group" style="width: 48%;">
      <label for="date">Date:</label>
      <input type="text" id="date" data-field="date" value="{{ date }}">
    </div>
  </div>

  <div class="instructions">
    <p>In order to submit requested documentation to Student Financial Assistance, you must complete this submission form and upload it along with the requested documentation to the <a href="http://finaid.ucf.edu/upload">Document and File Upload</a> tool found at <span data-field="upload_link">{{ upload_link }}</span>.</p>
  </div>

  <div class="checkbox-section">
    <h2 style="text-align: center; margin-bottom: 20px;">INDICATE THE DOCUMENTATION BEING SUBMITTED</h2>
    <div class="checkbox-group">
      <div class="checkbox-column">
        <div class="checkbox-item">
          <input type="checkbox">
          <span data-field="student_doc_1">{{ student_doc_1 }}</span>
        </div>
        <div class="checkbox-item">
          <input type="checkbox">
          <span data-field="student_doc_2">{{ student_doc_2 }}</span>
        </div>
        <div class="checkbox-item">
          <input type="checkbox">
          <span data-field="student_doc_3">{{ student_doc_3 }}</span>
        </div>
        <div class="checkbox-item">
          <input type="checkbox">
          <span data-field="student_doc_4">{{ student_doc_4 }}</span>
        </div>
        <div class="checkbox-item">
          <input type="checkbox">
          <span data-field="student_doc_5">{{ student_doc_5 }}</span>
        </div>
        <div class="checkbox-item">
          <input type="checkbox">
          <span data-field="student_doc_6">{{ student_doc_6 }}</span>
        </div>
        <div class="checkbox-item">
          <input type="checkbox">
          <span data-field="student_doc_7">{{ student_doc_7 }}</span>
        </div>
        <div class="checkbox-item">
          <input type="checkbox">
          <span data-field="student_doc_8">{{ student_doc_8 }}</span>
        </div>
        <div class="checkbox-item">
          <input type="checkbox">
          <span data-field="student_doc_9">{{ student_doc_9 }}</span>
        </div>
        <div class="checkbox-item">
          <input type="checkbox">
          <span data-field="student_doc_10">{{ student_doc_10 }}</span>
        </div>
      </div>
      <div class="checkbox-column">
        <div class="checkbox-item">
          <input type="checkbox">
          <span data-field="parent_doc_1">{{ parent_doc_1 }}</span>
        </div>
        <div class="checkbox-item">
          <input type="checkbox">
          <span data-field="parent_doc_2">{{ parent_doc_2 }}</span>
        </div>
        <div class="checkbox-item">
          <input type="checkbox">
          <span data-field="parent_doc_3">{{ parent_doc_3 }}</span>
        </div>
        <div class="checkbox-item">
          <input type="checkbox">
          <span data-field="parent_doc_4">{{ parent_doc_4 }}</span>
        </div>
        <div class="checkbox-item">
          <input type="checkbox">
          <span data-field="parent_doc_5">{{ parent_doc_5 }}</span>
        </div>
        <div class="checkbox-item">
          <input type="checkbox">
          <span data-field="parent_doc_6">{{ parent_doc_6 }}</span>
        </div>
        <div class="checkbox-item">
          <input type="checkbox">
          <span data-field="parent_doc_7">{{ parent_doc_7 }}</span>
        </div>
        <div class="checkbox-item">
          <input type="checkbox">
          <span data-field="parent_doc_8">{{ parent_doc_8 }}</span>
        </div>
      </div>
    </div>
  </div>

  <div class="divider"></div>

  <div class="form-group" style="width: 100%;">
    <label for="doc_explanation">Documentation Explanation (required when documentation is not available)</label>
    <input type="text" id="doc_explanation" data-field="field_1" value="{{ field_1 }}">
  </div>

  <div class="footer">
    <p>Submit complete forms at <span data-field="submit_link">{{ submit_link }}</span>. Route this form to Verification / Taxes</p>
    <p>Phone: <span data-field="phone_number">{{ phone_number }}</span> • Fax: <span data-field="fax_number">{{ fax_number }}</span> • Web: <span data-field="web_address">{{ web_address }}</span> | a division of Student Development and Enrollment Services</p>
    <p style="text-align: right;">Doc_Submission-Rev. 12/20</p>
  </div>
</div>