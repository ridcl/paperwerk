        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 {
            font-weight: bold;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        td, th {
            padding: 8px;
            text-align: left;
            border: 1px solid #ccc;
