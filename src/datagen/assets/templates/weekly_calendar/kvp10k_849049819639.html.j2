<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    color: #333;
  }
</style>
<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px;">
    <div style="display: flex; align-items: center;">
      <div style="background-color: #003366; padding: 10px 15px; border-radius: 5px; margin-right: 15px;">
        <div style="font-size: 24px; font-weight: bold; color: white;">LSU</div>
        <div style="font-size: 10px; color: #ccc;">College of Science</div>
        <div style="font-size: 10px; color: #ccc;">Department of Physics & Astronomy</div>
      </div>
      <div>
        <h1 style="font-size: 28px; margin: 0;">Weekly Calendar and News</h1>
        <p style="font-size: 14px; margin-top: 5px;">Dec. 12, 2016</p>
      </div>
    </div>
  </div>

  <div style="background-color: #FFC72C; padding: 15px; text-align: center; margin-bottom: 30px;">
    <h2 style="margin: 0; font-size: 22px;">LSU Physics & Astronomy in the News</h2>
  </div>

  <div style="line-height: 1.6;">
    <p style="margin-bottom: 15px;">
      <span style="font-weight: bold;">•</span> <span data-field="news_item_1_description">{{ news_item_1_description }}</span>: <a href="{{ news_item_1_link }}"></a>
    </p>
    <p style="margin-bottom: 15px;">
      <span style="font-weight: bold;">•</span> <span data-field="news_item_2_description">{{ news_item_2_description }}</span>: <a href="{{ news_item_2_link }}"></a>
    </p>
    <p style="margin-bottom: 15px;">
      <span style="font-weight: bold;">•</span> <span data-field="news_item_3_description">{{ news_item_3_description }}</span>: <a href="{{ news_item_3_link }}"></a>
    </p>
    <p style="margin-bottom: 15px;">
      <span style="font-weight: bold;">•</span> <span data-field="news_item_4_description">{{ news_item_4_description }}</span>: <a href="{{ news_item_4_link }}"></a>
    </p>
  </div>

  <div style="margin-top: 40px;">
    <h2 style="text-align: center; border-bottom: 2px solid #003366; padding-bottom: 10px; margin-bottom: 30px;">Events</h2>

    <div style="line-height: 1.6;">
      <p style="margin-bottom: 15px;">
        <span style="font-weight: bold;">•</span> <span data-field="event_1_description">{{ event_1_description }}</span>
        <br>
        <span data-field="event_1_date_time">{{ event_1_date_time }}</span>, <span data-field="event_1_location">{{ event_1_location }}</span>
      </p>
      <p style="margin-bottom: 15px;">
        <span style="font-weight: bold;">•</span> <span data-field="event_2_description">{{ event_2_description }}</span>
        <br>
        <span data-field="event_2_date_time">{{ event_2_date_time }}</span>, <span data-field="event_2_location">{{ event_2_location }}</span>
      </p>
      <p style="margin-bottom: 15px;">
        <span style="font-weight: bold;">•</span> <span data-field="event_3_description">{{ event_3_description }}</span>
        <br>
        <span data-field="event_3_date_time">{{ event_3_date_time }}</span>, <span data-field="event_3_location">{{ event_3_location }}</span>
      </p>
      <p style="margin-bottom: 15px;">
        <span style="font-weight: bold;">•</span> <span data-field="event_4_description">{{ event_4_description }}</span>
        <br>
        <span data-field="event_4_date_time">{{ event_4_date_time }}</span>, <span data-field="event_4_location">{{ event_4_location }}</span>
      </p>
    </div>
  </div>
</div>

<div class="page">
  <div style="text-align: center; margin-bottom: 50px;">
    <h1 style="font-size: 48px; margin: 0;">LSU College of Science</h1>
    <h2 style="font-size: 60px; margin: 10px 0;">Fall Diploma Ceremony</h2>
  </div>

  <div style="text-align: center; margin-bottom: 80px;">
    <p style="font-size: 18px; margin: 5px 0;">Friday, <span data-field="ceremony_date">{{ ceremony_date }}</span></p>
    <p style="font-size: 18px; margin: 5px 0;">9 a.m.</p>
    <p style="font-size: 18px; margin: 5px 0;">Maddox Fieldhouse</p>
  </div>

  <div style="text-align: center; border: 1px solid #ccc; padding: 30px; margin-top: 50px;">
    <p style="font-size: 20px;">View the ceremony live at <a href="{{ ceremony_link }}">science.lsu.edu</a></p>
  </div>
</div>

<div class="page">
  <div style="text-align: center; margin-bottom: 40px;">
    <h1 style="font-size: 36px; color: #006600;">LACNS</h1>
    <p style="font-size: 16px;">Louisiana Consortium for Neutron Scattering</p>
  </div>

  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px;">
    <div style="flex: 1; padding-right: 30px;">
      <h2 style="font-size: 24px; margin-top: 0;">Monday, <span data-field="seminar_date">{{ seminar_date }}</span></h2>
      <p style="font-size: 18px;">3:00 pm</p>
      <p style="font-size: 18px;">1008B Digital Media Center</p>
      <p style="font-size: 18px;">Louisiana State University</p>
    </div>
    <div style="flex: 1; text-align: center;">
      <div style="border: 1px solid #ccc; padding: 15px; width: 200px; margin-top: 20px;">
        <img src="{{ speaker_photo_url }}" alt="Guest Speaker" style="width: 100%; height: auto;">
        <h3 style="margin-top: 15px; font-size: 20px;">Guest Speaker</h3>
        <p style="font-size: 24px; font-weight: bold; margin: 5px 0;">Dr. Michael Ohl</p>
        <p style="font-size: 14px;">Lead Instrument Scientist, Spallation Neutron Source</p>
        <p style="font-size: 14px;">Oak Ridge National Laboratory, TN</p>
        <p style="font-size: 12px; margin-top: 10px;">Free and open to the public</p>
      </div>
    </div>
  </div>

  <div style="margin-bottom: 40px;">
    <h3 style="font-size: 20px; margin-bottom: 10px;">Neutron Spin Echo: The Technology and the Science</h3>
    <p style="font-size: 14px;">
      <span data-field="seminar_description_paragraph_1">{{ seminar_description_paragraph_1 }}</span>
    </p>
    <p style="font-size: 14px;">
      <span data-field="seminar_description_paragraph_2">{{ seminar_description_paragraph_2 }}</span>
    </p>
    <p style="font-size: 14px;">
      <span data-field="seminar_description_paragraph_3">{{ seminar_description_paragraph_3 }}</span>
    </p>
  </div>

  <div style="margin-top: 50px; text-align: center;">
    <p style="font-size: 14px;">
      <span data-field="sponsors_list">{{ sponsors_list }}</span>
    </p>
  </div>
</div>

<div class="page">
  <div style="text-align: center; margin-bottom: 50px;">
    <h1 style="font-size: 36px; color: #003366;">LSU</h1>
    <p style="font-size: 14px;">Louisiana State University</p>
  </div>
  <div style="text-align: center; margin-bottom: 50px;">
    <p style="font-size: 14px;">Louisiana Tech University</p>
  </div>
  <div style="text-align: center; margin-bottom: 50px;">
    <p style="font-size: 14px;">The University of New Orleans</p>
  </div>
  <div style="text-align: center; margin-bottom: 50px;">
    <p style="font-size: 14px;">Tulane University</p>
  </div>
</div>