<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; }
  h1 { text-align: center; font-size: 24pt; margin-bottom: 40px; }
  .header-info { margin-bottom: 30px; }
  .signature-line { border-bottom: 1px solid #000; margin-top: 50px; margin-bottom: 5px; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 40px; }
  .form-field-group { width: 48%; }
</style>

<div class="page">
  <div class="header-info">
    <div style="font-size: 20pt; font-weight: bold;">
      <span style="font-family: 'DejaVu Sans', sans-serif;">NJCU</span>
    </div>
    <div style="font-size: 10pt;">
      NEW JERSEY CITY UNIVERSITY
    </div>
    <div style="margin-top: 20px;">
      Office of the Registrar<br>
      <span data-field="department_address_line_1">{{ department_address_line_1 }}</span><br>
      Email: <span data-field="department_email">{{ department_email }}</span><br>
      Website: <span data-field="department_website">{{ department_website }}</span><br>
      Phone: <span data-field="department_phone">{{ department_phone }}</span><br>
      Fax: <span data-field="department_fax">{{ department_fax }}</span>
    </div>
  </div>

  <h1>RELEASE OF INFORMATION FORM</h1>

  <div class="form-row">
    <div class="form-field-group">
      Student's Name: <span class="signature-line" data-field="release_of_information_form">{{ release_of_information_form }}</span>
    </div>
    <div class="form-field-group">
      Student ID Number: <span class="signature-line" data-field="student_s_name">{{ student_s_name }}</span>
    </div>
  </div>

  <p>I grant New Jersey City University permission to release my education record information (including grades and grade point average) to: <span class="signature-line" style="width: 60%;" data-field="student_id_number">{{ student_id_number }}</span> my mother/father</p>

  <div class="form-row">
    <div class="form-field-group">
      Student's Signature: <span class="signature-line" data-field="my_mother_father">{{ my_mother_father }}</span>
    </div>
    <div class="form-field-group">
      Parent's Signature: <span class="signature-line" data-field="student_s_signature">{{ student_s_signature }}</span>
    </div>
  </div>

  <div class="form-row">
    <div class="form-field-group">
      Date: <span class="signature-line" data-field="parent_s_signature">{{ parent_s_signature }}</span>
    </div>
    <div class="form-field-group">
      Date: <span class="signature-line" data-field="date">{{ date }}</span>
    </div>
  </div>

  <p style="margin-top: 80px; font-size: 10pt;">Revised <span data-field="revision_date">{{ revision_date }}</span></p>
</div>