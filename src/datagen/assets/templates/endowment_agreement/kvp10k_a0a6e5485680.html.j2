<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 {
    font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif;
  }
  .header-title {
    font-size: 24pt;
    font-weight: bold;
    text-align: center;
    margin-bottom: 30px;
  }
  .metadata-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 30px;
  }
  .metadata-table td {
    padding: 5px 0;
    font-size: 11pt;
  }
  .metadata-table .label {
    width: 100px;
    font-weight: bold;
    vertical-align: top;
  }
  .section-heading {
    font-size: 16pt;
    font-weight: bold;
    text-align: center;
    margin: 40px 0 20px 0;
    font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif;
  }
  .paragraph {
    font-size: 11pt;
    line-height: 1.5;
    margin-bottom: 20px;
  }
  .signature-line {
    margin-top: 80px;
    border-top: 1px solid #000;
    width: 50%;
    margin-left: auto;
    margin-right: auto;
  }
</style>

<div class="page">
  <div style="text-align: center;">
    <div class="header-title">Endowment<br>AGREEMENT</div>
  </div>

  <table class="metadata-table">
    <tr>
      <td class="label">NAME</td>
      <td><span data-field="donor_full_name">{{ donor_full_name }}</span></td>
    </tr>
    <tr>
      <td class="label">ADDRESS</td>
      <td><span data-field="donor_address">{{ donor_address }}</span></td>
    </tr>
    <tr>
      <td class="label">Date</td>
      <td><span data-field="agreement_date">{{ agreement_date }}</span></td>
    </tr>
    <tr>
      <td class="label">Phone</td>
      <td><span data-field="donor_phone">{{ donor_phone }}</span></td>
    </tr>
    <tr>
      <td class="label">ID#</td>
      <td><span data-field="donor_id">{{ donor_id }}</span></td>
    </tr>
  </table>

  <div class="section-heading">PROPOSAL</div>

  <div class="paragraph">
    <span data-field="university_name">{{ university_name }}</span> invites you to establish the <span data-field="scholarship_name">{{ scholarship_name }}</span> of at least <span data-field="minimum_amount">{{ minimum_amount }}</span>. The purpose of this endowment fund is to provide scholarships for students enrolled in the <span data-field="program_name">{{ program_name }}</span> of <span data-field="university_name">{{ university_name }}</span>. Priority will be given to persons <span data-field="priority_criteria">{{ priority_criteria }}</span>. The university's financial assistance office will be responsible for making the scholarship awards and will have the flexibility to determine the eligibility criteria.
  </div>

  <div class="paragraph">
    Each year reports of the funding activities will be provided along with the names of the student recipients. Students are encouraged to express their personal appreciation to you for your generous financial support.
  </div>

  <div class="section-heading">FUNDING PLAN</div>

  <div class="paragraph">
    The <span data-field="scholarship_name">{{ scholarship_name }}</span> will be funded with an initial gift of <span data-field="initial_gift_amount">{{ initial_gift_amount }}</span> additional gifts of <span data-field="additional_gifts_count">{{ additional_gifts_count }}</span> with the remainder to be funded through the <span data-field="funding_source">{{ funding_source }}</span> estate. Guidelines to protect the principal from being spent or eroded by inflation are specified on the reverse of this proposal.
  </div>

  <div style="margin-top: 100px;">
    <div style="width: 45%; float: left;">
      <div class="signature-line"></div>
      <div style="text-align: center; margin-top: 5px;">EMU Development Office Representative</div>
    </div>
    <div style="width: 45%; float: right;">
      <div class="signature-line"></div>
      <div style="text-align: center; margin-top: 5px;">Date</div>
    </div>
  </div>
</div>