<!DOCTYPE html>
<html>
<head>
    <title>Recital Program</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 { text-align: center; }
        .header-line { border-top: 1px solid black; border-bottom: 1px solid black; padding: 10px 0; }
        .title-style { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif; font-size: 80px; line-height: 0.9; color: #a52a2a; }
        .subtitle-style { font-size: 40px; margin-top: 10px; }
        .info-block { text-align: center; margin-top: 50px; }
        .program-list { margin-top: 40px; }
        .song-entry { display: flex; justify-content: space-between; margin-bottom: 15px; font-size: 18px; }
        .song-title { flex-basis: 50%; }
        .performer-info { flex-basis: 50%; text-align: right; }
        .footer-text { text-align: center; margin-top: 50px; font-size: 14px; }
        .sponsorship-box { border: 1px solid #ccc; padding: 20px; margin-top: 40px; font-size: 14px; }
    </style>
</head>
<body>

<div class="page">
    <div class="header-line"></div>
    <div style="text-align: center; margin-bottom: 20px;">
        <span data-field="department.name">{{ department.name }}</span>
    </div>
    <div style="text-align: center; margin-bottom: 40px;">
        <div class="title-style">A Season of</div>
        <div class="title-style" style="font-size: 120px;">Renewal</div>
    </div>
    <div class="subtitle-style">
        Fall Voice Recital
    </div>
    <div class="info-block">
        <div style="font-size: 24px;">Studley Theatre</div>
        <div style="margin-top: 20px;">
            Tuesday, <span data-field="event.date">{{ event.date }}</span><br>
            <span data-field="event.time">{{ event.time }}</span>
        </div>
    </div>
    <div style="margin-top: 80px; text-align: center;">
        <!-- Placeholder for image -->
    </div>
    <div style="text-align: center; margin-top: 50px; font-size: 20px;">
        P R O G R A M
    </div>
</div>

<div class="page">
    <div style="text-align: center; margin-bottom: 30px;">
        <span data-field="studio.name">{{ studio.name }}</span>
    </div>
    <div style="text-align: center; margin-bottom: 40px;">
        <div style="font-size: 30px;">Fall Voice Recital</div>
        <div style="font-size: 20px;">
            <span data-field="featured_performer.name">{{ featured_performer.name }}</span>, piano
        </div>
    </div>

    <div class="program-list">
        {% for item in program_details %}
        <div class="song-entry">
            <div class="song-title">
                <span data-field="program_details[{{ loop.index0 }}].title">{{ item.title }}</span>
                {% if item.subtitle %}
                    <div style="font-size: 16px; margin-top: 5px;">{{ item.subtitle }}</div>
                {% endif %}
            </div>
            <div class="performer-info">
                <span data-field="program_details[{{ loop.index0 }}].performer">{{ item.performer }}</span>
                {% if item.composer %}
                    <div style="font-size: 14px; margin-top: 3px;">({{ item.composer }})</div>
                {% endif %}
            </div>
        </div>
        {% endfor %}
    </div>
</div>

<div class="page">
    <div class="program-list">
        {% for item in program_details %}
        <div class="song-entry">
            <div class="song-title">
                <span data-field="program_details[{{ loop.index0 }}].title">{{ item.title }}</span>
                {% if item.subtitle %}
                    <div style="font-size: 16px; margin-top: 5px;">{{ item.subtitle }}</div>
                {% endif %}
            </div>
            <div class="performer-info">
                <span data-field="program_details[{{ loop.index0 }}].performer">{{ item.performer }}</span>
                {% if item.composer %}
                    <div style="font-size: 14px; margin-top: 3px;">({{ item.composer }})</div>
                {% endif %}
            </div>
        </div>
        {% endfor %}
    </div>
    <div style="text-align: center; margin-top: 100px;">
        <div style="border-top: 1px solid black; padding-top: 10px;">
            <span data-field="season_title">{{ season_title }}</span>
        </div>
    </div>
</div>

<div class="page">
    <div style="text-align: center; margin-bottom: 20px;">
        <span data-field="season_year">{{ season_year }}</span>
    </div>
    <div class="footer-text">
        Please visit <span data-field="website_url">{{ website_url }}</span> to view our upcoming Concert Series events. Enjoy the show!
    </div>
    <div class="sponsorship-box">
        Your generous contributions support <span data-field="department.name">{{ department.name }}</span> programs. Make your tax-deductible gift today at <span data-field="donation_url">{{ donation_url }}</span>, or send your check, made payable to the SUNY New Paltz Foundation and marked for Music to: SUNY New Paltz Foundation, 1 Hawk Drive, New Paltz, NY 12561.
    </div>
</div>

</body>
</html>