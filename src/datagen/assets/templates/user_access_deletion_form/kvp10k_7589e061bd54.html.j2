<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "Liberation Sans", "DejaVu Sans", Arial, sans-serif; }
  h1 { text-align: center; font-weight: bold; margin-bottom: 20px; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 15px; }
  .form-row > div { flex: 1; }
  .full-width-field { width: 100%; border-bottom: 1px solid #000; margin-bottom: 15px; }
  .checkbox-group { margin-top: 10px; }
  .checkbox-group label { margin-right: 20px; }
  .signature-line { margin-top: 50px; display: flex; justify-content: space-between; }
</style>

<div class="page">
  <h1>OUHSC User Access Deletion Form</h1>
  <div style="text-align: right; margin-bottom: 20px;">
    <button style="padding: 5px 10px; border: 1px solid #000;">Reset Values</button>
  </div>

  <div class="form-row">
    <div>
      User's Name (Last Name, First Name)
      <div class="full-width-field">
        <span data-field="full_name">{{ full_name }}</span>
      </div>
    </div>
  </div>

  <div class="form-row">
    <div>
      Department
      <div class="full-width-field">
        <span data-field="department">{{ department }}</span>
      </div>
    </div>
    <div>
      Contact Person
      <div class="full-width-field">
        <span data-field="contact_person">{{ contact_person }}</span>
      </div>
    </div>
    <div>
      Phone
      <div class="full-width-field">
        <span data-field="phone_number">{{ phone_number }}</span>
      </div>
    </div>
  </div>

  <div style="margin-top: 20px;">
    Delete the type(s) of access checked below for the above user. Effective Date
    <div class="full-width-field" style="width: 50%;">
      <span data-field="effective_date">{{ effective_date }}</span>
    </div>
  </div>

  <div style="margin-top: 20px;">
    <div class="checkbox-group">
      <label>
        <input type="checkbox"> OUHSC Domain Access (Local and remote access to E-mail, Internet and Moon File/Print Services)
      </label>
    </div>
    <div class="checkbox-group">
      <label>
        <input type="checkbox"> PeopleSoft Financial Applications
      </label>
      <div style="margin-left: 30px;">
        <label><input type="checkbox"> All Access</label>
        <label><input type="checkbox"> Specific Access as Follows</label>
      </div>
    </div>
    <div class="checkbox-group">
      <label>
        <input type="checkbox"> PeopleSoft Human Resources Applications
      </label>
      <div style="margin-left: 30px;">
        <label><input type="checkbox"> All Access</label>
        <label><input type="checkbox"> Specific Access as Follows</label>
      </div>
    </div>
    <div class="checkbox-group">
      <label>
        <input type="checkbox"> PeopleSoft Student Administration Applications
      </label>
      <div style="margin-left: 30px;">
        <label><input type="checkbox"> All Access</label>
        <label><input type="checkbox"> Specific Access as Follows</label>
      </div>
    </div>
  </div>

  <div class="signature-line">
    <div>
      Signature of authorization (user's supervisor or department's authorizing agent)
      <div class="full-width-field" style="width: 50%;">
        <span data-field="signature_authorization">{{ signature_authorization }}</span>
      </div>
    </div>
    <div>
      Date
      <div class="full-width-field" style="width: 50%;">
        <span data-field="date_signed">{{ date_signed }}</span>
      </div>
    </div>
  </div>

  <div style="margin-top: 50px; text-align: center;">
    Send completed form to IT Account Management @ SCB-101 or fax to 405-271-2126.
  </div>
</div>