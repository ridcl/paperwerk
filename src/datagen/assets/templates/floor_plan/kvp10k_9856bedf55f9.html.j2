<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; /* Defaulting to serif for layout consistency */
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic layout structure */
  h1, h2, h3 { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; }
  .content-section { margin-bottom: 20px; }
</style>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
        <!-- Left Column Content -->
        <div style="width: 55%;">
            <h1 style="font-size: 24pt; margin-bottom: 5px;">Swirbul Room 201</h1>
            <p style="font-size: 12pt; margin-top: 0;">Hay Lab</p>

            <div class="content-section">
                <h2 style="font-size: 14pt; margin-bottom: 5px;">Hours of Operation:</h2>
                <p style="font-size: 11pt;">Room available by reservation only. See Swirbul Library hours of operation <a href="#" style="color: #0000EE;">{{ library_hours_link }}</a></p>
            </div>

            <div class="content-section">
                <h2 style="font-size: 14pt; margin-bottom: 5px;">To Reserve Room:</h2>
                <p style="font-size: 11pt;">Contact Registrar Office at <span data-field="registrar_phone">{{ registrar_phone }}</span></p>
            </div>

            <div class="content-section">
                <p style="font-size: 11pt;">Phone: ext. <span data-field="registrar_extension">{{ registrar_extension }}</span></p>
            </div>

            <div class="content-section">
                <h2 style="font-size: 14pt; margin-bottom: 5px;">Physical Description:</h2>
                <p style="font-size: 11pt;">Collaborative Learning Space based on Crestron AirMedia wireless HD presentation platform</p>
            </div>

            <div class="content-section">
                <h2 style="font-size: 14pt; margin-bottom: 5px;">Software Available for Student Use:</h2>
                <p style="font-size: 11pt;"><a href="{{ software_link }}" style="color: #0000EE;">{{ software_link_text }}</a></p>
            </div>
        </div>

        <!-- Right Column Content (Diagram Placeholder) -->
