<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic layout structure */
  body { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; }
  .content-area { display: flex; justify-content: space-between; }
  .text-section { width: 40%; }
  .diagram-section { width: 55%; position: relative; }
  h1, h2, h3 { font-weight: bold; }
</style>

<div class="page">
  <div class="content-area">
    <div class="text-section">
      <h2>Swirbul Room 101</h2>
      <p>Hours of Operation: <span data-field="hours_of_operation">{{ hours_of_operation }}</span></p>

      <h3>To Reserve Room:</h3>
      <p>Contact Registrar Office at ext. <span data-field="registrar_extension">{{ registrar_extension }}</span></p>

      <h3>Phone:</h3>
      <p><span data-field="phone_number">{{ phone_number }}</span></p>

      <h3>To Refill Paper and Toner:</h3>
      <p>Call IT Help Desk at <span data-field="it_help_desk_number">{{ it_help_desk_number }}</span></p>

      <h3>Software Available for Student Use:</h3>
      <p><a href="{{ software_url }}"><span data-field="software_link_text">{{ software_link_text }}</span></a></p>
    </div>

    <div class="diagram-section">
      <!-- Placeholder for the room layout diagram -->
      <div style="position: absolute; top: 50px; left: 0; width: 100%; height: 90%; border: 1px solid #ccc; background-color: #f9f9f9;">
        <!-- Visual representation of the layout elements -->
        <div style="position: absolute; top: 100px; left: 50px; font-size: 10px;">Marker Board</div>
        <div style="position: absolute; top: 150px; left: 70%; font-size: 10px;">Marker Boards</div>
        <div style="position: absolute; top: 250px; left: 70%; font-size: 10px;">Ceiling Mounted Projector</div>
        <div style="position: absolute; top: 350px; left: 50px; font-size: 10px;">Printer</div>
        <div style="position: absolute; top: 450px; left: 70%; font-size: 10px;">Wheel Chair Accessible</div>
        <div style="position: absolute; top: 550px; left: 70%; font-size: 10px;">Wall Mount Hybrid Box</div>
        <div style="position: absolute; top: 650px; left: 70%; font-size: 10px;">Instructor Desk</div>
        <!-- Simplified representation of desks/chairs -->
        <div style="position: absolute; top: 200px; left: 100px; width: 50px; height: 80px; border: 1px solid #333;"></div>
        <div style="position: absolute; top: 200px; left: 300px; width: 50px; height: 80px; border: 1px solid #333;"></div>
        <div style="position: absolute; top: 200px; left: 500px; width: 50px; height: 80px; border: 1px solid #333;"></div>
        <div style="position: absolute; top: 200px; left: 700px; width: 50px; height: 80px; border: 1px solid #333;"></div>
        <!-- ... more elements would be drawn here based on the image ... -->
      </div>
    </div>
  </div>
</div>