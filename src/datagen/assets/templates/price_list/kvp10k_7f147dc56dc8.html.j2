<style>
    @page { size: A4; margin: 0; }
    .page {
        width: 794px; height: 1123px;
        padding: 50px 60px; box-sizing: border-box;
        overflow: hidden; page-break-after: always;
        position: relative;
        font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; /* Using serif fonts as a default approximation */
    }
    .page:last-child { page-break-after: auto; }
    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
        font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; /* Using sans-serif for table data */
    }
    th, td {
        padding: 10px;
        text-align: left;
        border-bottom: 1px solid #ccc;
    }
    th {
        background-color: #f2f2f2;
        font-weight: bold;
    }
    .header-title {
        font-size: 24pt;
        font-weight: bold;
        margin-bottom: 5px;
    }
    .header-subtitle {
        font-size: 10pt;
        margin-bottom: 20px;
    }
    .section-header {
        font-weight: bold;
        margin-top: 15px;
        margin-bottom: 5px;
    }
</style>

