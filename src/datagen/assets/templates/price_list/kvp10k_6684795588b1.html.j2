<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  td, th {
    padding: 8px;
    text-align: left;
  }
  .header {
    font-size: 24pt;
    font-weight: bold;
    text-align: center;
    margin-bottom: 30px;
  }
  .section-title {
    font-size: 14pt;
    font-weight: bold;
    margin-top: 25px;
    margin-bottom: 10px;
  }
  .sub-section-title {
    font-size: 12pt;
    font-weight: bold;
    margin-top: 15px;
    margin-bottom: 5px;
  }
  .disclaimer {
    font-size: 9pt;
    line-height: 1.4;
    margin-top: 30px;
  }
</style>

