<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif; }
  .header { text-align: center; margin-bottom: 40px; }
  .logo-container img { max-width: 150px; height: auto; }
  .title { font-size: 24pt; font-weight: bold; text-align: center; margin-bottom: 10px; }
  .contact-info { text-align: center; margin-bottom: 30px; }
  .form-section { margin-bottom: 25px; }
  .form-label { display: block; margin-bottom: 5px; font-weight: normal; }
  .form-line { border-bottom: 1px solid #000; margin-top: 5px; margin-bottom: 15px; width: 100%; }
  .radio-options label { margin-right: 20px; }
</style>

<div class="page">
  <div class="header">
    <!-- Placeholder for University of Arkansas logo/text -->
    <div style="text-align: center;">
      <span style="font-size: 10pt;">UNIVERSITY OF ARKANSAS</span>
      <div style="margin-top: 10px;">
        <!-- Placeholder for PMC Solutions logo/text -->
        <span style="font-size: 30pt; font-weight: bold;">PMC</span>
        <div style="font-size: 12pt;">Print • Mail • Copy Solutions</div>
      </div>
    </div>
  </div>

  <div class="title">
    PMC SOLUTIONS - MAIL
  </div>

  <div class="contact-info">
    <div style="font-size: 12pt;">Phone: <span data-field="phone_number">{{ phone_number }}</span></div>
    <div style="font-size: 12pt;">Mailing Information Form</div>
    <div style="font-size: 12pt;">University of Arkansas</div>
  </div>

  <div class="form-section">
    <div class="form-label">Date:</div>
    <div class="form-line" data-field="date">{{ date }}</div>
  </div>

  <div class="form-section">
    <div class="form-label">Department Name:</div>
    <div class="form-line" data-field="department_name">{{ department_name }}</div>
  </div>

  <div class="form-section">
    <div class="form-label">Your UA Mailing Services PO#:</div>
    <div class="form-line" data-field="your_ua_mailing_services_po">{{ your_ua_mailing_services_po }}</div>
    <div style="font-size: 9pt; margin-top: 5px;">(Must be a UA purchase order for UA Mailing Services)</div>
  </div>

  <div class="form-section">
    <div class="form-label">Mailpiece Description:</div>
    <div class="form-line" data-field="mailpiece_description">{{ mailpiece_description }}</div>
  </div>

  <div class="form-section">
    <div class="form-label">Sample Piece Given:</div>
    <div class="radio-options">
      <label><input type="radio" name="sample_given" value="yes"> YES</label>
      <label><input type="radio" name="sample_given" value="no"> NO (circle one)</label>
    </div>
  </div>

  <div class="form-section">
    <div class="form-label">Approximate Piece Count:</div>
    <div class="form-line" data-field="approximate_piece_count">{{ approximate_piece_count }}</div>
  </div>

  <div class="form-section">
    <div class="form-label">Authorized Mailer: (please print)</div>
    <div class="form-line" data-field="authorized_mailer">{{ authorized_mailer }}</div>
  </div>

  <div class="form-section">
    <div class="form-label">Contact Phone:</div>
    <div class="form-line" data-field="contact_phone">{{ contact_phone }}</div>
  </div>

  <div class="form-section">
    <div class="form-label">Signature of Mailer:</div>
    <div class="form-line" data-field="signature_of_mailer">{{ signature_of_mailer }}</div>
  </div>
</div>