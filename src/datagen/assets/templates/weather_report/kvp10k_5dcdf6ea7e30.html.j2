<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child {
    page-break-after: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  th, td {
    padding: 8px;
    text-align: left;
  }
  .header-title {
    font-size: 18pt;
    font-weight: bold;
    text-align: center;
    margin-bottom: 20px;
  }
  .section-title {
    font-size: 12pt;
    font-weight: bold;
    margin-top: 15px;
    margin-bottom: 10px;
  }
  .data-row td:nth-child(odd) {
    text-align: center;
  }
  .data-row td:nth-child(even) {
    text-align: center;
  }
</style>

<div class="page">
  <div style="text-align: center;">
    <div class="header-title">QUALITY CONTROLLED LOCAL CLIMATOLOGICAL DATA</div>
  </div>

  <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
    <div>
      <p>Station Location: <span data-field="station_location">{{ station_location }}</span></p>
      <p>Lat. <span data-field="latitude">{{ latitude }}</span> Lon. <span data-field="longitude">{{ longitude }}</span></p>
    </div>
    <div>
      <p>Elevation(Ground): <span data-field="elevation">{{ elevation }}</span></p>
    </div>
  </div>

  <div class="section-title">Month: <span data-field="month">{{ month }}</span></div>

  <table>
    <thead>
      <tr>
        <th rowspan="2">Temperature</th>
        <th rowspan="2">Degree Days</th>
        <th colspan="10">Sun</th>
        <th colspan="10">Mon</th>
      </tr>
      <tr>
        <th>D</th>
        <th>Avg</th>
        <th>Dev</th>
        <th>Avg</th>
        <th>Wet</th>
        <th>Heating</th>
        <th>Cooling</th>
        <th>LST</th>
        <th>LST</th>
        <th>LST</th>
        <th>D</th>
        <th>Avg</th>
        <th>Dev</th>
        <th>Avg</th>
        <th>Wet</th>
        <th>Heating</th>
        <th>Cooling</th>
        <th>LST</th>
        <th>LST</th>
        <th>LST</th>
      </tr>
    </thead>
    <tbody>
      {% for i in range(1, 32) %}
      <tr class="data-row">
        <td>{{ i }}</td>
        <td><span data-field="temp_day_{{ i }}">{{ temp_day_{{ i }} }}</span></td>
        <td><span data-field="temp_dev_{{ i }}">{{ temp_dev_{{ i }} }}</span></td>
        <td><span data-field="avg_day_{{ i }}">{{ avg_day_{{ i }} }}</span></td>
        <td><span data-field="wet_day_{{ i }}">{{ wet_day_{{ i }} }}</span></td>
        <td><span data-field="heat_day_{{ i }}">{{ heat_day_{{ i }} }}</span></td>
        <td><span data-field="cool_day_{{ i }}">{{ cool_day_{{ i }} }}</span></td>
        <td><span data-field="lst_day_{{ i }}">{{ lst_day_{{ i }} }}</span></td>
        <td><span data-field="lst_day_sun_{{ i }}">{{ lst_day_sun_{{ i }} }}</span></td>
        <td><span data-field="lst_day_mon_{{ i }}">{{ lst_day_mon_{{ i }} }}</span></td>
        <td>{{ i }}</td>
        <td><span data-field="temp_day_mon_{{ i }}">{{ temp_day_mon_{{ i }} }}</span></td>
        <td><span data-field="temp_dev_mon_{{ i }}">{{ temp_dev_mon_{{ i }} }}</span></td>
        <td><span data-field="avg_day_mon_{{ i }}">{{ avg_day_mon_{{ i }} }}</span></td>
        <td><span data-field="wet_day_mon_{{ i }}">{{ wet_day_mon_{{ i }} }}</span></td>
        <td><span data-field="heat_day_mon_{{ i }}">{{ heat_day_mon_{{ i }} }}</span></td>
        <td><span data-field="cool_day_mon_{{ i }}">{{ cool_day_mon_{{ i }} }}</span></td>
        <td><span data-field="lst_day_mon_sun_{{ i }}">{{ lst_day_mon_sun_{{ i }} }}</span></td>
        <td><span data-field="lst_day_mon_mon_{{ i }}">{{ lst_day_mon_mon_{{ i }} }}</span></td>
        <td><span data-field="lst_day_mon_lst_{{ i }}">{{ lst_day_mon_lst_{{ i }} }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div style="display: flex; justify-content: space-between; margin-top: 20px;">
    <div>
      <p>Significant Weather: <span data-field="significant_weather">{{ significant_weather }}</span></p>
    </div>
    <div>
      <p>Pressure(inches of Hg): <span data-field="pressure">{{ pressure }}</span></p>
      <p>Wind: <span data-field="wind">{{ wind }}</span></p>
      <p>Speed/Direction: <span data-field="speed_direction">{{ speed_direction }}</span></p>
    </div>
  </div>

  <div class="section-title" style="margin-top: 30px;">Summary Data</div>
  <table>
    <thead>
      <tr>
        <th></th>
        <th>Max Temp >= 90:</th>
        <th>Min Temp <= 32:</th>
        <th>Precipitation >= 1.0in:</th>
        <th>Snowfall >= 1.0in:</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Heating:</td>
        <td><span data-field="heating_count">{{ heating_count }}</span></td>
        <td><span data-field="min_temp_count">{{ min_temp_count }}</span></td>
        <td><span data-field="precip_count">{{ precip_count }}</span></td>
        <td><span data-field="snowfall_count">{{ snowfall_count }}</span></td>
      </tr>
      <tr>
        <td>Cooling:</td>
        <td><span data-field="cooling_count">{{ cooling_count }}</span></td>
        <td><span data-field="max_temp_count">{{ max_temp_count }}</span></td>
        <td><span data-field="precip_count_2">{{ precip_count_2 }}</span></td>
        <td><span data-field="snowfall_count_2">{{ snowfall_count_2 }}</span></td>
      </tr>
    </tbody>
  </table>

  <div style="margin-top: 30px;">
    <p>
      * EXTREME FOR THE MONTH - LAST OCCURRENCE IF MORE THAN ONE.
    </p>
  </div>

  <div style="margin-top: 50px; text-align: right;">
    <p>Data Version: <span data-field="data_version">{{ data_version }}</span></p>
  </div>
</div>