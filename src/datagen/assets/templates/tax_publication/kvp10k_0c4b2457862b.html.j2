<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Publication Template</title>
<style>
  @page { size: A4; margin: 0; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; font-size: 9px; color: #000; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }

  /* Page header */
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-bottom: 2px solid #000;
    padding-bottom: 4px;
    margin-bottom: 6px;
  }
  .page-header .pub-title {
    font-size: 13px;
    font-family: "Liberation Serif", Georgia, serif;
  }
  .page-header .pub-date {
    font-size: 12px;
    font-family: "Liberation Serif", Georgia, serif;
  }
  .proof-note {
    font-style: italic;
    font-size: 8.5px;
    margin-bottom: 4px;
  }

  /* Page 1 - Worksheet */
  .worksheet-title {
    font-size: 9.5px;
    margin-top: 60px;
    margin-bottom: 6px;
  }
  .worksheet-title span.ws-num {
    font-weight: normal;
  }
  .worksheet-title span.ws-name {
    font-weight: bold;
  }
  .ws-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 8.8px;
  }
  .ws-table td, .ws-table th {
    border: 1px solid #999;
    padding: 4px 5px;
    vertical-align: top;
  }
  .ws-table .col-num {
    width: 28px;
    font-weight: bold;
    text-align: center;
    vertical-align: middle;
  }
  .ws-table .col-desc {
    width: 380px;
  }
  .ws-table .col-line {
    width: 28px;
    font-weight: bold;
    text-align: center;
    vertical-align: middle;
    background: #f5f5f5;
  }
  .ws-table .col-val1 {
    width: 120px;
    background: #e8e8e8;
  }
  .ws-table .col-val2 {
    width: 120px;
    background: #e8e8e8;
  }
  .ws-table tr td.col-desc b {
    font-weight: bold;
  }
  .page-footer {
    position: absolute;
    bottom: 30px;
    right: 60px;
    font-size: 8.5px;
  }

  /* Page 2 - How To Get Tax Help */
  .section-title-bar {
    border-top: 3px solid #000;
    padding-top: 6px;
    margin-bottom: 8px;
  }
  .section-title-bar h2 {
    font-size: 16px;
    font-weight: bold;
    font-family: "Liberation Sans", Arial, Helvetica, sans-serif;
  }
  .four-col {
    display: flex;
    gap: 10px;
    font-size: 8px;
    line-height: 1.35;
    font-family: "Liberation Serif", Georgia, serif;
  }
  .four-col .col {
    flex: 1;
  }
  .four-col .col p {
    margin-bottom: 5px;
  }
  .four-col .col .bold-head {
    font-weight: bold;
  }
  .four-col .col .italic-text {
    font-style: italic;
  }
  .four-col .col .bold-italic {
    font-weight: bold;
    font-style: italic;
  }
  .icon-row {
    display: flex;
    align-items: flex-start;
    gap: 4px;
    margin-bottom: 4px;
  }
  .icon-box {
    width: 22px;
    height: 22px;
    border: 1px solid #000;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    flex-shrink: 0;
  }
  .address-box {
    border: 1px solid #000;
    padding: 3px 5px;
    font-size: 7.5px;
    margin-top: 4px;
  }
  .cd-icon-box {
    border: 1px solid #000;
    padding: 2px 4px;
    font-size: 7.5px;
    margin-bottom: 3px;
  }

  /* Page 3 - Index */
  .index-header {
    display: flex;
    align-items: center;
    gap: 8px;
    border-top: 3px solid #000;
    padding-top: 4px;
    margin-bottom: 8px;
  }
  .index-header .index-label {
    font-weight: bold;
    font-size: 11px;
    font-family: "Liberation Serif", Georgia, serif;
    min-width: 40px;
  }
  .index-header .index-note {
    font-size: 8px;
    line-height: 1.4;
  }
  .index-cols {
    display: flex;
    gap: 8px;
    font-size: 7.8px;
    line-height: 1.5;
    font-family: "Liberation Serif", Georgia, serif;
  }
  .index-cols .idx-col {
    flex: 1;
    border-top: 1px solid #000;
    padding-top: 3px;
  }
  .idx-col .idx-letter {
    font-weight: bold;
    font-size: 9px;
    margin-bottom: 2px;
    border-bottom: 1px solid #000;
  }
  .idx-col .idx-entry {
    display: flex;
    justify-content: space-between;
  }
  .idx-col .idx-entry .idx-term {
    flex: 1;
  }
  .idx-col .idx-entry .idx-page {
    text-align: right;
    min-width: 20px;
  }
  .idx-col .idx-sub {
    padding-left: 10px;
  }
  .idx-col .idx-bold {
    font-weight: bold;
  }
  .idx-col .idx-italic {
    font-style: italic;
  }
  .idx-section-divider {
    border-top: 1px solid #000;
    margin: 3px 0;
  }
  .continued-text {
    font-size: 7.8px;
    line-height: 1.4;
    font-family: "Liberation Serif", Georgia, serif;
    display: flex;
    gap: 10px;
    margin-bottom: 10px;
  }
  .continued-text .ct-col {
    flex: 1;
  }
</style>
</head>
<body>

<!-- PAGE 1: Worksheet -->
<div class="page">
  <div class="page-header">
    <div class="pub-title">Page <span data-field="page1.page_num">{{ page1.page_num }}</span> of <span data-field="page1.total_pages">{{ page1.total_pages }}</span> of Publication <span data-field="page1.pub_number">{{ page1.pub_number }}</span></div>
    <div class="pub-date"><span data-field="page1.timestamp">{{ page1.timestamp }}</span></div>
  </div>
  <div class="proof-note">The type and rule above prints on all proofs including departmental reproduction proofs. MUST be removed before printing.</div>

  <div class="worksheet-title">
    Worksheet <span class="ws-num"><span data-field="worksheet.number">{{ worksheet.number }}</span>.</span>&nbsp;&nbsp;<span class="ws-name"><span data-field="worksheet.title">{{ worksheet.title }}</span></span>
  </div>

  <table class="ws-table">
    {% for row in worksheet.rows %}
    <tr>
      <td class="col-num"><span data-field="worksheet.rows[{{ loop.index0 }}].row_num">{{ row.row_num }}</span></td>
      <td class="col-desc">
        {% if row.bold_prefix %}
        <b><span data-field="worksheet.rows[{{ loop.index0 }}].bold_prefix">{{ row.bold_prefix }}</span></b>
        {% endif %}
        <span data-field="worksheet.rows[{{ loop.index0 }}].description">{{ row.description }}</span>
      </td>
      <td class="col-line"><span data-field="worksheet.rows[{{ loop.index0 }}].line_label">{{ row.line_label }}</span></td>
      <td class="col-val1"></td>
      <td class="col-val2"></td>
    </tr>
    {% endfor %}
  </table>

  <div class="page-footer">Page <span data-field="page1.footer_page">{{ page1.footer_page }}</span></div>
</div>

<!-- PAGE 2: How To Get Tax Help -->
<div class="page">
  <div class="page-header">
    <div class="pub-title">Page <span data-field="page2.page_num">{{ page2.page_num }}</span> of <span data-field="page2.total_pages">{{ page2.total_pages }}</span> of Publication <span data-field="page2.pub_number">{{ page2.pub_number }}</span></div>
    <div class="pub-date"><span data-field="page2.timestamp">{{ page2.timestamp }}</span></div>
  </div>
  <div class="proof-note">The type and rule above prints on all proofs including departmental reproduction proofs. MUST be removed before printing.</div>

  <div style="margin-top: 20px;">
    <div class="section-title-bar">
      <h2><span data-field="page2.section_title">{{ page2.section_title }}</span></h2>
    </div>

    <div class="four-col">
      <div class="col">
        <p><span data-field="page2.col1.intro_text">{{ page2.col1.intro_text }}</span></p>
        <p><span class="bold-head"><span data-field="page2.col1.advocate_head">{{ page2.col1.advocate_head }}</span></span> <span data-field="page2.col1.advocate_text">{{ page2.col1.advocate_text }}</span></p>
        <p><span data-field="page2.col1.advocate_body">{{ page2.col1.advocate_body }}</span></p>
        <p><span data-field="page2.col1.contact_intro">{{ page2.col1.contact_intro }}</span></p>
        <div class="icon-row">
          <div class="icon-box">☎</div>
          <div>
            <p><span data-field="page2.col1.phone_text">{{ page2.col1.phone_text }}</span></p>
            <p><span data-field="page2.col1.phone_number1">{{ page2.col1.phone_number1 }}</span></p>
          </div>
        </div>
        <p><span data-field="page2.col1.call_write_text">{{ page2.col1.call_write_text }}</span></p>
