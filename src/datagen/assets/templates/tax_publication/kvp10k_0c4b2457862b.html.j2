  .f1040-line { display: flex; align-items: center; min-height: 12px; border-bottom: 1px solid #ddd; }
  .f1040-line-num { width: 20px; font-weight: bold; font-size: 6.5px; }
  .f1040-line-desc { flex: 1; font-size: 6.5px; }
  .f1040-line-amt { width: 55px; text-align: right; font-size: 7px; border-left: 1px solid #000; padding-left: 3px; }
  .checkbox { display: inline-block; width: 8px; height: 8px; border: 1px solid #000; margin-right: 2px; text-align: center; font-size: 7px; line-height: 8px; }
  .checked::after { content: "X"; }

  /* Page 15 - 1040 page 2 */
  .f1040p2 { border: 1px solid #000; font-size: 6.5px; font-family: "Liberation Sans", "DejaVu Sans", Arial, Helvetica, sans-serif; }
  .f1040p2-section { display: flex; }
