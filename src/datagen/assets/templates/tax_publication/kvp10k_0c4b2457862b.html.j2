<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Publication Template</title>
<style>
  @page { size: A4; margin: 0; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; font-size: 8.5px; color: #000; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }

  /* Header meta bar */
  .meta-bar {
    display: flex;
    justify-content: space-between;
    font-size: 7.5px;
    font-family: "Liberation Sans", "DejaVu Sans", Arial, Helvetica, sans-serif;
    border-bottom: 1px solid #000;
    padding-bottom: 3px;
    margin-bottom: 4px;
  }
  .meta-bar .left-meta { display: flex; gap: 20px; align-items: flex-start; }
  .meta-bar .pager-label { font-weight: bold; font-size: 10px; }
  .meta-bar .meta-fields { font-size: 7.5px; }
  .meta-bar .meta-fields div { margin-bottom: 1px; }
  .meta-bar .right-meta { text-align: right; font-size: 7.5px; }

  .page-header-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid #000;
    padding-bottom: 3px;
    margin-bottom: 4px;
  }
  .page-header-row .page-num { font-size: 9px; font-family: "Liberation Sans", "DejaVu Sans", Arial, sans-serif; }
  .page-header-row .page-date { font-size: 9px; font-family: "Liberation Sans", "DejaVu Sans", Arial, sans-serif; }

  .proof-notice {
    font-style: italic;
    font-size: 7.5px;
    margin-bottom: 18px;
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
  }

  /* Page 1 layout */
  .page1-body {
    display: flex;
    gap: 20px;
    margin-top: 10px;
  }
  .page1-left {
    width: 310px;
    flex-shrink: 0;
  }
  .page1-right {
    flex: 1;
    border-left: 1px solid #000;
    padding-left: 16px;
  }

  .pub-logo-row {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 6px;
  }
  .pub-logo {
    width: 48px;
    height: 48px;
    border: 2px solid #555;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    color: #555;
    flex-shrink: 0;
  }
  .pub-title-block {}
  .pub-title-block .pub-name {
    font-weight: bold;
    font-size: 9px;
    font-family: "Liberation Sans", "DejaVu Sans", Arial, sans-serif;
  }
  .pub-title-block .pub-cat {
    font-size: 7.5px;
    font-family: "Liberation Sans", "DejaVu Sans", Arial, sans-serif;
  }
  .dept-block {
    font-size: 7px;
    font-family: "Liberation Sans", "DejaVu Sans", Arial, sans-serif;
    line-height: 1.3;
    margin-top: 4px;
  }

  .main-title {
    font-size: 32px;
    font-weight: bold;
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
    line-height: 1.05;
    margin-top: 8px;
    margin-bottom: 10px;
  }

  .for-use-text {
    font-size: 11px;
    font-family: "Liberation Sans", "DejaVu Sans", Arial, sans-serif;
    margin-top: 14px;
    margin-bottom: 2px;
  }
  .tax-year-row {
    font-size: 28px;
    font-weight: bold;
    font-family: "Liberation Sans", "DejaVu Sans", Arial, sans-serif;
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .tax-year-row .returns-label {
    font-size: 14px;
    font-weight: normal;
  }

  .cover-image-box {
    width: 100%;
    height: 200px;
    background: #888;
    margin-top: 14px;
    display: flex;
    align-items: flex-end;
    padding: 8px;
  }
  .cover-image-caption {
    background: rgba(255,255,255,0.85);
    padding: 5px 8px;
    font-size: 8px;
    font-family: "Liberation Sans", "DejaVu Sans", Arial, sans-serif;
    width: 100%;
  }
  .cover-image-caption .caption-bold { font-weight: bold; }
  .cover-image-caption .internet-row {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-top: 2px;
  }
  .cover-image-caption .internet-label { font-weight: bold; font-size: 9px; }
  .cover-image-caption .internet-url { font-size: 9px; }

  /* Contents panel */
  .contents-title {
    font-size: 14px;
    font-weight: bold;
    font-family: "Liberation Sans", "DejaVu Sans", Arial, sans-serif;
    border-bottom: 1px solid #000;
    padding-bottom: 3px;
    margin-bottom: 6px;
  }
  .toc-table { width: 100%; border-collapse: collapse; }
  .toc-table td { font-size: 8px; padding: 1.5px 0; font-family: "Liberation Sans", "DejaVu Sans", Arial, sans-serif; }
  .toc-table td.toc-label { width: 80%; }
  .toc-table td.toc-page { text-align: right; width: 20%; }
  .toc-table td.toc-indent { padding-left: 12px; }

  /* What's New / Reminder / Introduction sections */
  .section-divider { border-top: 1px solid #000; margin: 8px 0 4px 0; }
  .section-heading {
    font-size: 13px;
    font-weight: bold;
    font-family: "Liberation Sans", "DejaVu Sans", Arial, sans-serif;
    margin-bottom: 4px;
  }
  .section-subheading {
    font-size: 9px;
    font-weight: bold;
    font-family: "Liberation Sans", "DejaVu Sans", Arial, sans-serif;
    margin-bottom: 2px;
  }
  .body-text {
    font-size: 7.8px;
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
    line-height: 1.35;
    margin-bottom: 4px;
  }

  /* Page 2 layout */
  .page2-body {
    display: flex;
    gap: 16px;
    margin-top: 6px;
  }
  .page2-left { width: 220px; flex-shrink: 0; }
  .page2-center { flex: 1; }
  .page2-right { width: 220px; flex-shrink: 0; }

  /* Table styles */
  .fica-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 7.5px;
    font-family: "Liberation Sans", "DejaVu Sans", Arial, sans-serif;
    margin-top: 6px;
  }
  .fica-table th, .fica-table td {
    border: 1px solid #000;
    padding: 3px 4px;
    vertical-align: top;
  }
  .fica-table th {
    background: #e0e0e0;
    font-weight: bold;
    text-align: center;
  }
  .fica-table td { text-align: left; }

  .table-title {
    font-size: 9px;
    font-weight: bold;
    font-family: "Liberation Sans", "DejaVu Sans", Arial, sans-serif;
    margin-bottom: 3px;
  }
  .table-intro { font-size: 7.5px; margin-bottom: 4px; font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; }

  /* Useful items / publication lists */
  .useful-heading {
    font-size: 9px;
    font-weight: bold;
    font-family: "Liberation Sans", "DejaVu Sans", Arial, sans-serif;
    margin-top: 6px;
    margin-bottom: 2px;
  }
  .pub-list { list-style: none; padding: 0; margin: 0; }
  .pub-list li { font-size: 7.5px; padding-left: 10px; margin-bottom: 1px; font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; }
  .pub-list li .pub-num { font-weight: bold; }

  .numbered-list { padding-left: 14px; margin: 3px 0; }
  .numbered-list li { font-size: 7.5px; margin-bottom: 2px; font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; line-height: 1.3; }

  /* Three-column body pages */
  .three-col {
    display: flex;
    gap: 14px;
    margin-top: 6px;
  }
  .col { flex: 1; }

  .bold-label { font-weight: bold; }
  .italic-label { font-style: italic; }

  /* Section headings within body pages */
  .h2 {
    font-size: 13px;
    font-weight: bold;
    font-family: "Liberation Sans", "DejaVu Sans", Arial, sans-serif;
    border-bottom: 1px solid #000;
    padding-bottom: 2px;
    margin-bottom: 4px;
    margin-top: 6px;
  }
  .h3 {
    font-size: 10px;
    font-weight: bold;
    font-family: "Liberation Sans", "DejaVu Sans", Arial, sans-serif;
    margin-bottom: 2px;
    margin-top: 5px;
  }
  .h4 {
    font-size: 8.5px;
    font-weight: bold;
    font-family: "Liberation Sans", "DejaVu Sans", Arial, sans-serif;
    margin-bottom: 1px;
    margin-top: 4px;
  }

  /* Tip/Caution/Records boxes */
  .tip-box {
    border: 1px solid #000;
    padding: 4px 5px;
    margin: 4px 0;
    display: flex;
    gap: 5px;
    font-size: 7.5px;
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
  }
  .tip-icon {
    font-weight: bold;
    font-size: 9px;
    flex-shrink: 0;
    width: 22px;
    text-align: center;
    font-family: "Liberation Sans", "DejaVu Sans", Arial, sans-serif;
  }

  /* Table 2 - Exemption process */
  .exemption-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 7.5px;
    font-family: "Liberation Sans", "DejaVu Sans", Arial, sans-serif;
    margin-top: 4px;
  }
  .exemption-table th, .exemption-table td {
    border: 1px solid #000;
    padding: 3px 4px;
    vertical-align: top;
  }
  .exemption-table th { background: #e0e0e0; font-weight: bold; text-align: center; }

  /* Table 3 - Nonfarm */
  .nonfarm-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 7.5px;
    font-family: "Liberation Sans", "DejaVu Sans", Arial, sans-serif;
    margin-top: 4px;
  }
  .nonfarm-table th, .nonfarm-table td {
    border: 1px solid #000;
    padding: 3px 4px;
    vertical-align: top;
  }
  .nonfarm-table th { background: #e0e0e0; font-weight: bold; }

  .footnote { font-size: 7px; font-style: italic; margin-top: 3px; font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; }

  .indent { padding-left: 10px; }
  .two-col { display: flex; gap: 14px; }
  .two-col .col { flex: 1; }

  .page-footer {
    position: absolute;
    bottom: 20px;
    left: 60px;
    font-size: 8px;
    font-family: "Liberation Sans", "DejaVu Sans", Arial, sans-serif;
  }
</style>
</head>
<body>

<!-- ==================== PAGE 1 ==================== -->
<div class="page">
  <!-- Meta bar -->
  <div class="meta-bar">
    <div class="left-meta">
      <span class="pager-label">PAGER/SGML</span>
      <div class="meta-fields">
        <div>Userid: <span data-field="meta.userid">{{ meta.userid }}</span></div>
        <div>Fileid: <span data-field="meta.fileid">{{ meta.fileid }}</span> &nbsp;&nbsp; (<span data-field="meta.file_date">{{ meta.file_date }}</span>)</div>
      </div>
    </div>
    <div style="font-size:7.5px;">Leading adjust: <span data-field="meta.leading_adjust">{{ meta.leading_adjust }}</span></div>
    <div class="right-meta">
      <div>Draft &nbsp;&nbsp;&nbsp; Ok to Print</div>
      <div>(Init. &amp; date) <span data-field="meta.init_date">{{ meta.init_date }}</span></div>
    </div>
  </div>

  <!-- Page number / date row -->
  <div class="page-header-row">
    <span class="page-num">Page <span data-field="page1.page_num">{{ page1.page_num }}</span> of <span data-field="page1.total_pages">{{ page1.total_pages }}</span> of Publication <span data-field="publication.number">{{ publication.number }}</span></span>
    <span class="page-date"><span data-field="page1.timestamp">{{ page1.timestamp }}</span></span>
  </div>

  <div class="proof-notice">The type and rule above prints on all proofs including departmental reproduction proofs. MUST be removed before printing.</div>

  <!-- Main body -->
  <div class="page1-body">
    <!-- Left column -->
    <div class="page1-left">
      <div class="pub-logo-row">
        <div class="pub-logo">&#9752;</div>
        <div class="pub-title-block">
          <div class="pub-name">Publication <span data-field="publication.number">{{ publication.number }}</span></div>
          <div class="pub-cat">Cat. No. <span data-field="publication.cat_no">{{ publication.cat_no }}</span></div>
        </div>
      </div>
      <div class="dept-block">
        Department<br>of the<br>Treasury<br><br>
        <strong>Internal<br>Revenue<br>Service</strong>
      </div>

      <div class="main-title"><span data-field="publication.title">{{ publication.title }}</span></div>

      <div class="for-use-text">For use in preparing</div>
      <div class="tax-year-row">
        <span data-field="publication.tax_year">{{ publication.tax_year }}</span>
        <span class="returns-label">Returns</span>
      </div>

      <div class="cover-image-box">
        <div class="cover-image-caption">
          <div class="caption-bold">Get forms and other information faster and easier by:</div>
          <div class="internet-row">
            <span class="internet-label">Internet</span>
            <span class="internet-url"><span data-field="publication.website">{{ publication.website }}</span></span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right column: Contents + sections -->
    <div class="page1-right">
      <div class="contents-title">Contents</div>
      <table class="toc-table">
        {% for entry in toc_entries %}
        <tr>
          <td class="toc-label {% if entry.indent %}toc-indent{% endif %}">
            <span data-field="toc_entries[{{ loop.index0 }}].label">{{ entry.label }}</span>
            <span style="letter-spacing:1px;">. . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . . 