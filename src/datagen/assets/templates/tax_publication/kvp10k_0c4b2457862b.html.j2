<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Publication 517 Template</title>
<style>
  @page { size: A4; margin: 0; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; font-size: 7.5px; color: #000; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }

  /* Common */
  .page-header { display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 1px solid #000; padding-bottom: 2px; margin-bottom: 4px; }
  .page-header-left { font-size: 11px; font-weight: bold; font-family: "Liberation Sans", "DejaVu Sans", Arial, Helvetica, sans-serif; }
  .page-header-right { font-size: 11px; font-weight: bold; font-family: "Liberation Sans", "DejaVu Sans", Arial, Helvetica, sans-serif; }
  .proof-notice { font-style: italic; font-size: 7px; border-bottom: 1px solid #000; padding-bottom: 3px; margin-bottom: 8px; }
  .three-col { display: flex; gap: 10px; margin-top: 10px; }
  .col { flex: 1; font-size: 7.5px; line-height: 1.4; }
  .col p { margin-bottom: 4px; }
  .section-heading { font-weight: bold; font-size: 9px; margin-bottom: 3px; margin-top: 6px; }
  .section-heading-lg { font-size: 11px; font-weight: bold; margin-bottom: 3px; margin-top: 6px; }
  .bold { font-weight: bold; }
  .italic { font-style: italic; }
  .indent { margin-left: 12px; }
  .indent2 { margin-left: 20px; }
  .divider { border-top: 1px solid #000; margin: 6px 0; }
  .tip-box { border: 1px solid #000; padding: 4px 6px; margin: 4px 0; display: flex; gap: 6px; align-items: flex-start; font-size: 7px; }
  .tip-label { font-weight: bold; font-size: 9px; border: 1px solid #000; padding: 2px 4px; }
  .caution-box { border: 1px solid #000; padding: 4px 6px; margin: 4px 0; display: flex; gap: 6px; align-items: flex-start; font-size: 7px; }
  .caution-label { font-weight: bold; font-size: 8px; border: 1px solid #000; padding: 2px 4px; background: #fff; }
  .formula-box { text-align: center; margin: 4px 0; font-size: 7.5px; }
  .formula-line { border-top: 1px solid #000; display: inline-block; width: 120px; }
  .page-num { position: absolute; bottom: 20px; right: 60px; font-size: 8px; }

  /* Page 9 specific */
  .bullet-list { margin-left: 16px; margin-bottom: 4px; }
  .bullet-list li { list-style: disc; margin-bottom: 2px; }

  /* Page 10 - table */
  .filing-table { width: 100%; border-collapse: collapse; font-size: 7.5px; margin-top: 6px; }
  .filing-table th, .filing-table td { border: 1px solid #000; padding: 3px 5px; }
  .filing-table th { background: #f0f0f0; font-weight: bold; text-align: left; }
  .filing-table td { text-align: left; }
  .filing-table td.amount { text-align: right; }
  .table-title { font-weight: bold; font-size: 8.5px; margin-bottom: 3px; }

  /* Page 13 - W2 forms */
  .w2-form { border: 2px solid #000; margin-bottom: 10px; font-size: 7px; font-family: "Liberation Sans", "DejaVu Sans", Arial, Helvetica, sans-serif; }
