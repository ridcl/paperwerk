  .w2-title { font-size: 10px; font-weight: bold; }
  .w2-header-row { display: flex; border-bottom: 1px solid #000; background: #fff; }

  /* Page 14 - 1040 form */
  .form1040 { border: 1px solid #000; font-size: 7px; font-family: "Liberation Sans", "DejaVu Sans", Arial, Helvetica, sans-serif; }
  .f1040-header { display: flex; align-items: center; border-bottom: 1px solid #000; padding: 3px; }
