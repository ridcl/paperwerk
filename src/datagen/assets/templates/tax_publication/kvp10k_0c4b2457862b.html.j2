  .f1040p2-lines { flex: 1; }
  .f1040p2-line { display: flex; border-bottom: 1px solid #ddd; min-height: 11px; align-items: center; }
  .f1040p2-linenum { width: 18px; font-weight: bold; padding: 1px 2px; font-size: 6.5px; }
  .f1040p2-linedesc { flex: 1; padding: 1px 2px; font-size: 6.5px; }
  .f1040p2-lineamt { width: 55px; border-left: 1px solid #000; text-align: right; padding: 1px 3px; font-size: 7px; }
  .sign-section { border-top: 2px solid #000; padding: 4px; font-size: 6.5px; }
  .sign-row { display: flex; gap: 10px; margin-bottom: 4px; }
  .sign-field { flex: 1; border-bottom: 1px solid #000; }

  /* Page 16 - Schedule A */
  .sched-a { border: 1px solid #000; font-size: 6.5px; font-family: "Liberation Sans", "DejaVu Sans", Arial, Helvetica, sans-serif; }
  .sched-a-header { border-bottom: 1px solid #000; padding: 3px; display: flex; justify-content: space-between; }
  .sched-a-section { display: flex; border-bottom: 1px solid #000; }
  .sched-a-label { width: 80px; font-weight: bold; font-size: 6.5px; border-right: 1px solid #000; padding: 2px 3px; }
  .sched-a-lines { flex: 1; }
  .sched-a-line { display: flex; border-bottom: 1px solid #ddd; min-height: 11px; align-items: center; }
  .sched-a-linenum { width: 18px; font-weight: bold; padding: 1px 2px; }
  .sched-a-linedesc { flex: 1; padding: 1px 2px; }
  .sched-a-lineamt { width: 55px; border-left: 1px solid #000; text-align: right; padding: 1px 3px; }
</style>
