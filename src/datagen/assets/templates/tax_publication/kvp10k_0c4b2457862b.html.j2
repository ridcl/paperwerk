<!-- PAGE 3: Index -->
<div class="page">
  <div class="page-header">
    <div class="pub-title">Page <span data-field="page3.page_num">{{ page3.page_num }}</span> of <span data-field="page3.total_pages">{{ page3.total_pages }}</span> of Publication <span data-field="page3.pub_number">{{ page3.pub_number }}</span></div>
    <div class="pub-date"><span data-field="page3.timestamp">{{ page3.timestamp }}</span></div>
  </div>
  <div class="proof-note">The type and rule above prints on all proofs including departmental reproduction proofs. MUST be removed before printing.</div>

  <!-- Continued text from previous page -->
  <div class="continued-text" style="margin-top:10px;">
    {% for ct in page3.continued_cols %}
    <div class="ct-col">
      <span data-field="page3.continued_cols[{{ loop.index0 }}].text">{{ ct.text }}</span>
    </div>
    {% endfor %}
  </div>

  <!-- Index section -->
  <div class="index-header">
    <div class="index-label">Index</div>
    <div class="icon-box" style="font-size:12px;">💡</div>
    <div class="index-note">
      <span data-field="page3.index_note">{{ page3.index_note }}</span>
    </div>
  </div>

  <div class="index-cols">
    {% for col in page3.index_columns %}
    <div class="idx-col">
      {% for section in col.sections %}
      <div class="idx-section-divider"></div>
      <div class="idx-letter"><span data-field="page3.index_columns[{{ loop.index0 }}].sections[{{ loop.index0 }}].letter">{{ section.letter }}</span></div>
      {% for entry in section.entries %}
      <div class="idx-entry {% if entry.is_sub %}idx-sub{% endif %}">
        <span class="idx-term {% if entry.bold %}idx-bold{% endif %} {% if entry.italic %}idx-italic{% endif %}">
          <span data-field="page3.index_columns[{{ loop.index0 }}].sections[{{ loop.index0 }}].entries[{{ loop.index0 }}].term">{{ entry.term }}</span>
        </span>
        <span class="idx-page">
          <span data-field="page3.index_columns[{{ loop.index0 }}].sections[{{ loop.index0 }}].entries[{{ loop.index0 }}].page_ref">{{ entry.page_ref }}</span>
        </span>
      </div>
      {% endfor %}
      {% endfor %}
    </div>
    {% endfor %}
  </div>

  <div class="page-footer">Page <span data-field="page3.footer_page">{{ page3.footer_page }}</span></div>
</div>

</body>
</html>