<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Publication 517 - Tax Forms</title>
<style>
  @page { size: A4; margin: 0; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: "Liberation Sans", Arial, Helvetica, sans-serif; font-size: 8px; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }

  /* Page header styles */
  .pub-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-bottom: 2px solid #000;
    padding-bottom: 3px;
    margin-bottom: 4px;
  }
  .pub-header .pub-title { font-size: 11px; font-family: "Liberation Serif", Georgia, serif; }
  .pub-header .pub-date { font-size: 11px; font-family: "Liberation Serif", Georgia, serif; }
  .proof-note { font-style: italic; font-size: 7.5px; margin-bottom: 10px; }

  /* Schedule C-EZ styles */
  .form-header-box {
    display: flex;
    border: 1px solid #000;
    margin-top: 60px;
  }
  .form-title-left {
    padding: 4px 8px;
    border-right: 1px solid #000;
    min-width: 120px;
  }
  .form-title-left .schedule-name { font-weight: bold; font-size: 9px; }
  .form-title-left .form-num { font-weight: bold; font-size: 9px; }
  .form-title-left .dept { font-size: 6.5px; margin-top: 4px; }
  .form-title-center {
    flex: 1;
    text-align: center;
    padding: 4px;
    border-right: 1px solid #000;
  }
  .form-title-center .main-title { font-weight: bold; font-size: 14px; }
  .form-title-center .sub-title { font-size: 8px; }
  .form-title-center .instructions { font-size: 7px; margin-top: 2px; }
  .form-title-right {
    padding: 4px 8px;
    text-align: right;
    min-width: 100px;
  }
  .form-title-right .omb { font-size: 6.5px; }
  .form-title-right .year { font-size: 28px; font-weight: bold; }
  .form-title-right .attach { font-size: 6.5px; }

  .name-ssn-row {
    display: flex;
    border: 1px solid #000;
    border-top: none;
  }
  .name-cell {
    flex: 1;
    padding: 2px 4px;
    border-right: 1px solid #000;
  }
  .name-cell .label { font-size: 6.5px; }
  .ssn-cell {
    min-width: 180px;
    padding: 2px 4px;
  }
  .ssn-cell .label { font-size: 6.5px; }

  .part-header {
    background: #000;
    color: #fff;
    font-weight: bold;
    font-size: 8.5px;
    padding: 2px 6px;
    margin-top: 4px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .part-header .part-label { font-size: 8.5px; }

  .you-may-use-box {
    border: 1px solid #000;
    display: flex;
    margin-top: 4px;
    font-size: 7.5px;
  }
  .you-may-use-left {
    padding: 4px 6px;
    border-right: 1px solid #000;
    min-width: 80px;
    font-weight: bold;
    font-size: 7.5px;
  }
  .you-may-use-bullets {
    flex: 1;
    padding: 4px 8px;
    border-right: 1px solid #000;
  }
  .you-may-use-and-you {
    padding: 4px 8px;
    border-right: 1px solid #000;
    min-width: 60px;
    font-weight: bold;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .you-may-use-right {
    flex: 1;
    padding: 4px 8px;
  }
  .bullet-item { margin-bottom: 2px; }

  .field-row {
    display: flex;
    border-bottom: 1px solid #ccc;
    padding: 3px 0;
    align-items: flex-start;
    font-size: 7.5px;
  }
  .field-row .row-num {
    min-width: 16px;
    font-weight: bold;
  }
  .field-row .row-desc {
    flex: 1;
    padding-right: 8px;
  }
  .field-row .row-line-num {
    min-width: 20px;
    text-align: center;
    font-weight: bold;
  }
  .field-row .row-value {
    min-width: 80px;
    text-align: right;
    border-bottom: 1px solid #000;
    padding-right: 4px;
  }
  .field-row .row-value2 {
    min-width: 60px;
    text-align: right;
    border-bottom: 1px solid #000;
    padding-right: 4px;
    margin-left: 4px;
  }

  .section-divider { border-top: 1px solid #000; margin: 3px 0; }

  .alpha-fields-row {
    display: flex;
    border: 1px solid #000;
    border-top: none;
    font-size: 7.5px;
  }
  .alpha-cell {
    flex: 1;
    padding: 3px 4px;
    border-right: 1px solid #000;
  }
  .alpha-cell:last-child { border-right: none; }
  .alpha-cell .alpha-label { font-weight: bold; }

  .vehicle-row {
    display: flex;
    align-items: center;
    padding: 3px 0;
    font-size: 7.5px;
    border-bottom: 1px solid #eee;
  }
  .vehicle-row .vr-num { min-width: 16px; font-weight: bold; }
  .vehicle-row .vr-desc { flex: 1; }
  .vehicle-row .vr-check { min-width: 60px; text-align: right; }

  .checkbox-row {
    display: flex;
    align-items: center;
    padding: 2px 0;
    font-size: 7.5px;
  }
  .checkbox-row .cr-num { min-width: 16px; font-weight: bold; }
  .checkbox-row .cr-desc { flex: 1; }
  .checkbox-row .cr-boxes { display: flex; gap: 8px; align-items: center; }
  .cb { display: inline-block; width: 10px; height: 10px; border: 1px solid #000; margin-right: 2px; text-align: center; line-height: 10px; font-size: 8px; }
  .cb.checked::after { content: "X"; }

  .footer-row {
    display: flex;
    justify-content: space-between;
    font-size: 7px;
    margin-top: 4px;
    border-top: 1px solid #000;
    padding-top: 2px;
  }

  /* Schedule SE styles */
  .se-flowchart {
    border: 1px solid #000;
    margin: 6px 0;
    padding: 4px;
    font-size: 7px;
  }
  .se-flowchart-title {
    text-align: center;
    font-weight: bold;
    border: 1px solid #000;
    padding: 2px;
    margin-bottom: 4px;
  }
  .se-flow-row {
    display: flex;
    gap: 4px;
    margin-bottom: 4px;
  }
  .se-flow-box {
    border: 1px solid #000;
    padding: 3px;
    font-size: 6.5px;
    flex: 1;
  }
  .se-flow-arrow { text-align: center; font-size: 8px; }
  .se-flow-label { font-size: 7px; margin: 2px 0; }

  /* Form 2106-EZ styles */
  .f2106-header {
    display: flex;
    border: 1px solid #000;
    margin-top: 60px;
  }
  .f2106-left {
    padding: 4px 8px;
    border-right: 1px solid #000;
    min-width: 130px;
  }
  .f2106-center {
    flex: 1;
    text-align: center;
    padding: 4px;
    border-right: 1px solid #000;
  }
  .f2106-right {
    padding: 4px 8px;
    text-align: right;
    min-width: 100px;
  }

  /* Worksheet styles */
  .ws-title { font-weight: bold; font-size: 11px; margin-bottom: 6px; }
  .ws-subtitle { font-size: 8px; margin-bottom: 4px; }
  .ws-note { font-size: 7.5px; margin-bottom: 6px; }
  .ws-table { width: 100%; border-collapse: collapse; font-size: 7.5px; }
  .ws-table th, .ws-table td {
    border: 1px solid #000;
    padding: 2px 4px;
    vertical-align: middle;
  }
  .ws-table .shaded { background: #ccc; }
  .ws-table .bold { font-weight: bold; }
  .ws-table .center { text-align: center; }
  .ws-table .right { text-align: right; }
  .ws-table .italic { font-style: italic; }
  .ws-table .note-row td { border: none; padding: 3px 4px; font-size: 7px; }

  .attach-header { font-weight: bold; font-size: 10px; margin-bottom: 4px; }
  .ws-label { font-size: 8px; margin-bottom: 2px; }

  .inline-value { border-bottom: 1px solid #000; min-width: 40px; display: inline-block; text-align: right; }

  .page-num { position: absolute; bottom: 20px; right: 60px; font-size: 8px; }
</style>
</head>
<body>

<!-- PAGE 1: Schedule C-EZ -->
<div class="page">
  <div class="pub-header">
    <span class="pub-title">Page <span data-field="page1.page_num">{{ page1.page_num }}</span> of <span data-field="page1.total_pages">{{ page1.total_pages }}</span> of Publication <span data-field="page1.pub_number">{{ page1.pub_number }}</span></span>
    <span class="pub-date"><span data-field="page1.pub_date">{{ page1.pub_date }}</span></span>
  </div>
  <div class="proof-note">The type and rule above prints on all proofs including departmental reproduction proofs. MUST be removed before printing.</div>

  <!-- Schedule C-EZ Form Header -->
  <div class="form-header-box">
    <div class="form-title-left">
      <div class="schedule-name">SCHEDULE C-EZ</div>
      <div class="form-num">(Form 1040)</div>
      <div class="dept" style="margin-top:6px;">Department of the Treasury<br>Internal Revenue Service</div>
    </div>
    <div class="form-title-center">
      <div class="main-title">Net Profit From Business</div>
      <div class="sub-title">(Sole Proprietorship)</div>
      <div class="instructions">&#9658; Partnerships, joint ventures, etc., must file Form 1065 or 1065-B.<br>&#9658; Attach to Form 1040 or 1041. &#9658; See instructions on back.</div>
    </div>
    <div class="form-title-right">
      <div class="omb">OMB No. 1545-0074</div>
      <div class="year">20<span data-field="sched_cez.tax_year">{{ sched_cez.tax_year }}</span></div>
      <div class="attach">Attachment<br>Sequence No. <strong>09A</strong></div>
    </div>
  </div>

  <div class="name-ssn-row">
    <div class="name-cell">
      <div class="label">Name of proprietor</div>
      <div><span data-field="sched_cez.proprietor_name">{{ sched_cez.proprietor_name }}</span></div>
    </div>
    <div class="ssn-cell">
      <div class="label">Social security number (SSN)</div>
      <div><span data-field="sched_cez.ssn">{{ sched_cez.ssn }}</span></div>
    </div>
  </div>

  <div class="part-header">
    <span class="part-label">Part I</span> &nbsp; General Information
  </div>

  <div class="you-may-use-box">
    <div class="you-may-use-left">
      <div style="margin-bottom:2px;">&#9658;</div>
      <strong>You May Use<br>Schedule C-EZ<br>Instead of<br>Schedule C<br>Only If You:</strong>
      <div style="margin-top:4px;">&#8212;</div>
    </div>
