<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1, h2, h3 { text-align: center; }
  table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
  td { padding: 5px 0; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 10px; }
  .full-width-field { width: 100%; border-bottom: 1px solid #000; }
</style>

<div class="page">
  <!-- Header/Logo Area -->
  <div style="text-align: center; margin-bottom: 30px;">
    <img src="placeholder_logo.png" alt="University Logo" style="height: 60px; margin-bottom: 10px;">
    <h1 style="font-size: 24pt; margin: 0;">Western Oregon</h1>
    <h2 style="font-size: 16pt; margin: 0;">UNIVERSITY</h2>
  </div>

  <!-- Introductory Text -->
  <p style="margin-bottom: 20px;">To make a gift to WOU by check or credit card, please print and complete this gift form and return to:</p>

  <!-- Address Block -->
  <div style="margin-bottom: 30px; text-align: center;">
    <p><span data-field="organization_name">{{ organization_name }}</span></p>
    <p><span data-field="street_address">{{ street_address }}</span></p>
    <p><span data-field="city_state_zip">{{ city_state_zip }}</span></p>
    <p>Phone: <span data-field="phone_number">{{ phone_number }}</span>, <span data-field="email_address">{{ email_address }}</span></p>
  </div>

  <!-- Donation Purpose Box -->
  <div style="border: 1px solid #000; padding: 15px; margin-bottom: 30px;">
    <p style="font-weight: bold; margin-top: 0;">Consider the Fund for WOU (greatest need), Student Success Scholarship, Athletic Scholarships, WOU Food Pantry, Student Emergency Aid and the Hammersly Library Computing Check-Out Program</p>
  </div>

  <!-- Gift Designation Table -->
  <table>
    <thead>
      <tr>
        <td style="width: 50%;">Gift Designation</td>
        <td style="width: 25%; text-align: right;">Amount</td>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>1)</td>
        <td><span data-field="gift_amount_1">{{ gift_amount_1 }}</span></td>
      </tr>
      <tr>
        <td>2)</td>
        <td><span data-field="gift_amount_2">{{ gift_amount_2 }}</span></td>
      </tr>
      <tr>
        <td>3)</td>
        <td><span data-field="gift_amount_3">{{ gift_amount_3 }}</span></td>
      </tr>
    </tbody>
    <tfoot>
      <tr>
        <td style="text-align: right; font-weight: bold;">TOTAL GIFT:</td>
        <td style="text-align: right; font-weight: bold;"><span data-field="total_gift_amount">{{ total_gift_amount }}</span></td>
      </tr>
    </tfoot>
  </table>

  <!-- Donor Information & Billing Address -->
  <h3 style="border-bottom: 1px solid #000; padding-bottom: 5px; margin-top: 30px;">Donor Information & Billing Address</h3>

  <div class="form-row">
    <div style="width: 50%;">First Name: <span data-field="donor.first_name">{{ donor.first_name }}</span></div>
    <div style="width: 50%; text-align: right;">Middle Initial: <span data-field="donor.middle_initial">{{ donor.middle_initial }}</span></div>
  </div>

  <div class="form-row">
    <div style="width: 100%;">Last Name: <span data-field="donor.last_name">{{ donor.last_name }}</span></div>
  </div>

  <div class="form-row">
    <div style="width: 100%;">Alt Last Name: <span data-field="donor.alt_last_name">{{ donor.alt_last_name }}</span> (If different as a student)</div>
  </div>

  <div class="form-row">
    <div style="width: 100%;">Spouse/Partner Name: <span data-field="donor.spouse_partner_name">{{ donor.spouse_partner_name }}</span></div>
  </div>

  <!-- Address Fields -->
  <div style="margin-top: 15px;">
    <div class="form-row">
      <div style="width: 50%;">Address: <span data-field="donor.address">{{ donor.address }}</span></div>
      <div style="width: 25%;">City: <span data-field="donor.city">{{ donor.city }}</span></div>
      <div style="width: 25%; text-align: right;">State: <span data-field="donor.state">{{ donor.state }}</span></div>
    </div>
    <div class="form-row">
      <div style="width: 50%;">Zip: <span data-field="donor.zip">{{ donor.zip }}</span></div>
      <div style="width: 50%;">Phone: <span data-field="donor.phone">{{ donor.phone }}</span></div>
    </div>
  </div>

  <div class="form-row" style="margin-top: 15px;">
    <div style="width: 50%;">Email: <span data-field="donor.email">{{ donor.email }}</span></div>
  </div>


  <!-- Payment Information -->
  <h3 style="border-bottom: 1px solid #000; padding-bottom: 5px; margin-top: 40px;">Payment Information</h3>

  <div style="margin-bottom: 20px;">
    <input type="checkbox" id="check_my_check">
    <label for="check_my_check">Enclosed is my check</label>
  </div>

  <!-- Credit Card Details -->
  <h4 style="margin-top: 20px;">CREDIT CARD DETAILS:</h4>
  <div style="display: flex; gap: 10px; margin-bottom: 15px;">
    <img src="visa_logo.png" alt="Visa" style="height: 20px;">
    <img src="mastercard_logo.png" alt="Mastercard" style="height: 20px;">
    <img src="amex_logo.png" alt="Amex" style="height: 20px;">
    <img src="discover_logo.png" alt="Discover" style="height: 20px;">
    <img src="amex_logo_alt.png" alt="Amex" style="height: 20px;">
  </div>

  <div class="form-row">
    <div style="width: 50%;">Cardholder Name: <span data-field="cc.cardholder_name">{{ cc.cardholder_name }}</span></div>
    <div style="width: 50%;">Card Number: <span data-field="cc.card_number">{{ cc.card_number }}</span></div>
  </div>

  <div class="form-row">
    <div style="width: 50%;">Expiration Date Month/Year: <span data-field="cc.expiry_date">{{ cc.expiry_date }}</span></div>
    <div style="width: 50%;">Security Code (From back of card): <span data-field="cc.security_code">{{ cc.security_code }}</span></div>
  </div>

  <!-- Payment Frequency -->
  <div style="margin-top: 20px;">
    TO BE PAID:
    <label><input type="radio" name="payment_frequency" value="one_time"> One-Time</label>
    <label><input type="radio" name="payment_frequency" value="monthly"> Monthly</label>
    <label><input type="radio" name="payment_frequency" value="quarterly"> Quarterly</label>
    <label><input type="radio" name="payment_frequency" value="semi_annually"> Semi-Annually</label>
    <label><input type="radio" name="payment_frequency" value="annually"> Annually</label>
  </div>

  <!-- Start Date -->
  <div class="form-row" style="margin-top: 20px;">
    <div style="width: 50%;">Start Date: <span data-field="payment_start_date">{{ payment_start_date }}</span></div>
    <div style="width: 50%;">End Date: <span data-field="payment_end_date">{{ payment_end_date }}</span> or <input type="checkbox" id="continuous"> <label for="continuous">Continuous, no end date</label></div>
  </div>

</div>