</head>
<body>
<div class="page">
  <div class="header-title">National Center for Education Statistics</div>
  <div class="sub-header">IPEDS Data Center</div>

  <table class="metadata-table">
    <tr>
      <td>UnitID</td>
      <td><span data-field="unit_id">{{ unit_id }}</span></td>
    </tr>
    <tr>
      <td>OPEID</td>
      <td><span data-field="opeid">{{ opeid }}</span></td>
    </tr>
    <tr>
      <td>Address</td>
      <td><span data-field="address">{{ address }}</span></td>
    </tr>
    <tr>
      <td>Web Address</td>
      <td><span data-field="web_address">{{ web_address }}</span></td>
    </tr>
  </table>

  <div class="sub-header">Completions 2009-010</div>

  <table>
    <thead>
      <tr>
        <th>CIPCODE</th>
        <th>Award Level</th>
        <th>Major Gender</th>
        <th>Resident Alien</th>
        <th>Non Hispanic</th>
        <th>Black, non-Hispanic</th>
        <th>American Indian or Alaska Native</th>
        <th>Asian or Pacific Islander</th>
        <th>Hispanic</th>
        <th>White, non-Hispanic</th>
        <th>Race/ethnicity unknown</th>
        <th>Total</th>
      </tr>
    </thead>
    <tbody>
      {% for row in data_set_1 %}
      <tr>
        <td><span data-field="cipcode">{{ row.cipcode }}</span></td>
        <td><span data-field="award_level">{{ row.award_level }}</span></td>
        <td><span data-field="major_gender">{{ row.major_gender }}</span></td>
        <td><span data-field="resident_alien">{{ row.resident_alien }}</span></td>
        <td><span data-field="non_hispanic">{{ row.non_hispanic }}</span></td>
        <td><span data-field="black_non_hispanic">{{ row.black_non_hispanic }}</span></td>
        <td><span data-field="american_indian_or_alaska_native">{{ row.american_indian_or_alaska_native }}</span></td>
        <td><span data-field="asian_or_pacific_islander">{{ row.asian_or_pacific_islander }}</span></td>
        <td><span data-field="hispanic">{{ row.hispanic }}</span></td>
        <td><span data-field="white_non_hispanic">{{ row.white_non_hispanic }}</span></td>
        <td><span data-field="race_ethnicity_unknown">{{ row.race_ethnicity_unknown }}</span></td>
        <td><span data-field="total">{{ row.total }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

