<!DOCTYPE html>
<html>
<head>
    <title>Document Template</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        .header-logo {
            float: left;
            margin-right: 50px;
        }
        .contact-info {
            float: right;
            text-align: right;
            font-size: 12pt;
        }
        .section-title {
            font-weight: bold;
            margin-top: 20px;
            margin-bottom: 10px;
        }
        .form-row {
            margin-bottom: 15px;
        }
        .form-row label {
            display: inline-block;
            width: 150px;
        }
        .form-row input[type="text"], .form-row select {
            border: 1px solid #ccc;
            padding: 5px;
            width: 300px;
        }
        .divider {
            border-top: 1px solid #000;
            margin: 20px 0;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }
        th, td {
            border: 1px solid #000;
            padding: 8px;
            text-align: left;
        }
        th {
            background-color: #f0f0f0;
            font-weight: bold;
        }
        .signature-line {
            margin-top: 50px;
            border-top: 1px solid #000;
            width: 300px;
        }
    </style>
</head>
<body>
    <div class="page">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div class="header-logo">
                <img src="placeholder_logo.png" alt="Logo" style="width: 150px;">
                <h1 style="font-size: 24pt; margin-top: 10px;">PALMER</h1>
                <h2 style="font-size: 16pt;">Chiropractic Clinics</h2>
            </div>
            <div class="contact-info">
                <p>4705 S. Clyde Morris Blvd.</p>
                <p><span data-field="city">{{ city }}</span>, <span data-field="state">{{ state }}</span> <span data-field="zip">{{ zip }}</span></p>
                <p>Radiologist (386) <span data-field="phone_number_1">{{ phone_number_1 }}</span></p>
                <p>Fax (386) <span data-field="phone_number_2">{{ phone_number_2 }}</span></p>
                <p>Billing (386) <span data-field="phone_number_3">{{ phone_number_3 }}</span></p>
            </div>
        </div>

        <div class="section-title">Imaging Consultation Services – please fill all sections.</div>

        <div class="form-row">
            <label>Patient Name:</label>
            <span data-field="full_name">{{ full_name }}</span>
        </div>
        <div class="form-row">
            <label>Referring Doctor:</label>
            <span data-field="referring_doctor_name">{{ referring_doctor_name }}</span>
            <label>Referring Doc Email:</label>
            <span data-field="referring_doctor_email">{{ referring_doctor_email }}</span>
            <label>NPI:</label>
            <span data-field="npi">{{ npi }}</span>
        </div>

        <div class="form-row">
            <label>Previous Diagnosis, Surgery, Trauma, Cancer (include old diagnostic imaging reports):</label>
            <span data-field="previous_diagnosis_notes">{{ previous_diagnosis_notes }}</span>
        </div>

        <div class="divider"></div>

        <div class="section-title">Date of Examination:</div>
        <div style="display: flex; align-items: center; margin-bottom: 15px;">
            <label style="width: auto;">Verbal Report:</label>
            <span data-field="verbal_report_status">{{ verbal_report_status }}</span>
            <label style="margin-left: 30px;">FAX Report:</label>
            <span data-field="fax_report_status">{{ fax_report_status }}</span>
        </div>

        <div class="form-row">
            <label>Bill Doctor (CC on File):</label>
            <input type="radio" name="bill_doctor_cc" value="yes">
        </div>
        <div class="form-row">
            <label>Bill Doctor (No CC on file/ Change CC on file):</label>
            <input type="radio" name="bill_doctor_no_cc" value="yes">
        </div>

        <div class="form-row">
            <label>Doctor Address:</label>
            <span data-field="doctor_address">{{ doctor_address }}</span>
            <label>City:</label>
            <span data-field="doctor_city">{{ doctor_city }}</span>
            <label>State:</label>
            <span data-field="doctor_state">{{ doctor_state }}</span>
            <label>Zip:</label>
            <span data-field="doctor_zip">{{ doctor_zip }}</span>
        </div>
        <div class="form-row">
            <label>Card Number:</label>
            <span data-field="card_number">{{ card_number }}</span>
            <label>Card Type:</label>
            <span data-field="card_type">{{ card_type }}</span>
            <label>Expiration Date:</label>
            <span data-field="expiration_date">{{ expiration_date }}</span>
        </div>

        <p style="font-size: 10pt; margin-top: 20px;">* You may call 386-763-2638 to register credit card information.</p>
        <p style="font-size: 10pt;">* Your credit card statement will show charges from <span data-field="employer.name">{{ employer.name }}</span> for this service.</p>

        <div class="form-row" style="margin-top: 30px;">
            <label>If sending digitally:</label>
            <input type="checkbox" id="ambra_gateway"> <label for="ambra_gateway">AMBRA Gateway</label>
            <input type="checkbox" id="ambra_link"> <label for="ambra_link">AMBRA Link Share</label>
        </div>

        <div class="section-title">Patient Consent:</div>
        <p style="font-size: 10pt;">I understand that this office will have my radiographs interpreted by <span data-field="radiologist_name">{{ radiologist_name }}</span>, D.C., DACBR, a chiropractic radiologist certified by the American Chiropractic Board of Radiology. I am aware that I will be responsible for any fees associated with this service not paid by my referring doctor.</p>

        <div class="divider"></div>

        <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
            <span style="font-weight: bold;">Patient/Guardian Signature:</span>
            <span style="font-weight: bold;">Date:</span>
        </div>
        <div class="signature-line"></div>
        <span data-field="patient_signature_date">{{ patient_signature_date }}</span>

        <div class="divider"></div>

        <div class="section-title">PALMER IMAGING CONSULTATION SERVICES</div>
        <table>
            <thead>
                <tr>
                    <th style="width: 5%;">#</th>
                    <th style="width: 15%;">CPT</th>
                    <th style="width: 30%;">DESCRIPTION</th>
                    <th style="width: 15%;">FEE</th>
                    <th style="width: 5%;">#</th>
                    <th style="width: 15%;">CPT</th>
                    <th style="width: 30%;">DESCRIPTION</th>
                    <th style="width: 15%;">FEE</th>
                </tr>
            </thead>
            <tbody>
                {% for item in line_items %}
                <tr>
                    <td>{{ loop.index }}</td>
                    <td><span data-field="line_items[{{ loop.index0 }}].cpt_code">{{ item.cpt_code }}</span></td>
                    <td><span data-field="line_items[{{ loop.index0 }}].description">{{ item.description }}</span></td>
                    <td><span data-field="line_items[{{ loop.index0 }}].fee">{{ item.fee }}</span></td>
                    <td>{{ loop.index + line_items | length }}</td>
                    <td><span data-field="line_items[{{ loop.index0 }}].cpt_code_2">{{ item.cpt_code_2 }}</span></td>
                    <td><span data-field="line_items[{{ loop.index0 }}].description_2">{{ item.description_2 }}</span></td>
                    <td><span data-field="line_items[{{ loop.index0 }}].fee_2">{{ item.fee_2 }}</span></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>

        <div style="display: flex; justify-content: space-between; margin-top: 20px;">
            <p>Diagnosis codes: 1. <span data-field="diagnosis_code_1">{{ diagnosis_code_1 }}</span>. 2. <span data-field="diagnosis_code_2">{{ diagnosis_code_2 }}</span>. 3. <span data-field="diagnosis_code_3">{{ diagnosis_code_3 }}</span>. 4. <span data-field="diagnosis_code_4">{{ diagnosis_code_4 }}</span>.</p>
            <p>5. <span data-field="diagnosis_code_5">{{ diagnosis_code_5 }}</span>. 6. <span data-field="diagnosis_code_6">{{ diagnosis_code_6 }}</span>. 7. <span data-field="diagnosis_code_7">{{ diagnosis_code_7 }}</span>. 8. <span data-field="diagnosis_code_8">{{ diagnosis_code_8 }}</span>.</p>
        </div>

        <div style="display: flex; justify-content: space-between; margin-top: 50px;">
            <p>Referring Provider:</p>
            <p>Total Due: $<span data-field="total_due">{{ total_due }}</span></p>
        </div>
        <div class="signature-line" style="width: 50%;"></div>
        <span data-field="referring_provider_name">{{ referring_provider_name }}</span>

        <div style="text-align: right; margin-top: 50px;">
            <span data-field="date_signed">{{ date_signed }}</span>
        </div>
    </div>
</body>
</html>