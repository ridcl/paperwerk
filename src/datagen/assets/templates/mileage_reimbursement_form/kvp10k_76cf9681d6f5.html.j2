<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<style>
  @page { size: A4; margin: 0; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: "Liberation Sans", Arial, Helvetica, sans-serif; font-size: 11px; }
  .page {
    width: 794px; height: 1123px;
    padding: 20px 30px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }

  /* Header */
  .header-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 6px;
  }
  .logo-box {
    width: 60px;
    height: 60px;
    border: 2px solid #000;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    font-weight: bold;
    font-family: Georgia, "Liberation Serif", serif;
    flex-shrink: 0;
  }
  .uni-info {
    flex: 1;
  }
  .uni-name {
    font-weight: bold;
    font-size: 13px;
  }
  .uni-address {
    font-size: 10px;
    line-height: 1.4;
  }
  .accounting-box {
    width: 260px;
    border: 1px solid #000;
    flex-shrink: 0;
  }
  .accounting-box .acct-title {
    text-align: center;
    font-weight: bold;
    font-size: 11px;
    padding: 3px 5px;
    border-bottom: 1px solid #000;
  }
  .accounting-box .acct-row {
    padding: 3px 6px;
    border-bottom: 1px solid #000;
    font-size: 10.5px;
    min-height: 20px;
  }
  .accounting-box .acct-row:last-child {
    border-bottom: none;
  }

  /* Form title */
  .form-title {
    text-align: center;
    margin: 4px 0 1px 0;
  }
  .form-title h2 {
    font-size: 14px;
    font-weight: bold;
    font-family: "Liberation Sans", Arial, sans-serif;
  }
  .form-title h3 {
    font-size: 12px;
    font-weight: bold;
  }
  .form-title p {
    font-size: 11px;
    font-weight: bold;
  }
  .form-subtitle {
    font-size: 10.5px;
    font-weight: bold;
    text-align: left;
    margin-bottom: 4px;
  }

  /* Personal info table */
  .info-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 6px;
  }
  .info-table td {
    border: 1px solid #000;
    padding: 3px 6px;
    font-size: 11px;
    height: 24px;
  }
  .info-table .label {
    font-weight: normal;
  }
  .shaded {
    background-color: #d0d0d0;
  }

  /* Trip table */
  .trip-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 6px;
  }
  .trip-table th, .trip-table td {
    border: 1px solid #000;
    padding: 2px 4px;
    font-size: 10.5px;
    text-align: center;
    height: 22px;
  }
  .trip-table th {
    font-weight: bold;
    background-color: #fff;
  }
  .trip-table .purpose-col {
    text-align: left;
  }
  .trip-table .header-span {
    font-weight: bold;
  }
  .trip-table .footer-note {
    text-align: left;
    font-size: 10.5px;
    padding: 4px 6px;
  }
  .trip-table .footer-note a {
    color: #0000cc;
  }
  .trip-table .total-label {
    font-weight: bold;
    text-align: right;
    font-size: 10.5px;
    padding: 3px 5px;
  }
  .trip-table .total-value {
    font-size: 10.5px;
    padding: 3px 5px;
  }

  /* Certification */
  .cert-text {
    font-size: 11px;
    margin: 8px 0 16px 0;
    line-height: 1.5;
  }

  /* Signature area */
  .sig-row {
    display: flex;
    justify-content: space-between;
    margin-top: 10px;
    margin-bottom: 10px;
  }
  .sig-block {
    display: flex;
    flex-direction: column;
    width: 48%;
  }
  .sig-line {
    border-top: 1px solid #000;
    margin-bottom: 2px;
    margin-top: 18px;
  }
  .sig-labels {
    display: flex;
    justify-content: space-between;
    font-size: 10.5px;
  }

  /* Additional sheet */
  .additional-sheet {
    text-align: right;
    font-size: 10.5px;
    margin-bottom: 6px;
  }
  .checkbox {
    display: inline-block;
    width: 10px;
    height: 10px;
    border: 1px solid #000;
    margin-right: 4px;
    vertical-align: middle;
  }

  /* Footer note */
  .footer-note-box {
    border: 1px solid #000;
    padding: 5px 8px;
    font-size: 10.5px;
    font-weight: bold;
    margin-bottom: 4px;
  }
  .revised-text {
    font-size: 10px;
    margin-top: 3px;
  }
</style>
</head>
<body>
<div class="page">

  <!-- Header -->
  <div class="header-row">
    <div class="logo-box">W</div>
    <div class="uni-info">
      <div class="uni-name">WEBER STATE UNIVERSITY</div>
      <div class="uni-address">
        3850 Dixon Parkway Department 1014<br>
        Ogden, UT 84408-1014<br>
        Phone: (801) 626-6606 &nbsp; Fax: (801) 626-7464
      </div>
      <div style="margin-top:5px;">
        <div class="form-title">
          <h2>Mileage Reimbursement Form</h2>
          <h3>Check Request for Mileage over $100</h3>
          <p>(Use petty cash for $100 or less)</p>
        </div>
        <div class="form-subtitle">WSU EMPLOYEES ONLY-Use requisition if not an employee</div>
      </div>
    </div>
    <div class="accounting-box">
      <div class="acct-title">Accounting Services</div>
      <div class="acct-row">Invoice number: &nbsp;<span data-field="invoice_number">{{ invoice_number }}</span></div>
      <div class="acct-row">Check number: &nbsp;<span data-field="check_number">{{ check_number }}</span></div>
      <div class="acct-row">Date: &nbsp;<span data-field="accounting_date">{{ accounting_date }}</span></div>
      <div class="acct-row">Vendor Number: &nbsp;<span data-field="vendor_number">{{ vendor_number }}</span></div>
    </div>
  </div>

  <!-- Personal Info Table -->
  <table class="info-table">
    <tr>
      <td class="label" style="width:55%;">Name: &nbsp;<span data-field="full_name">{{ full_name }}</span></td>
      <td class="label" style="width:45%;">SSN or WSU ID: &nbsp;<span data-field="ssn_or_wsu_id">{{ ssn_or_wsu_id }}</span></td>
    </tr>
    <tr>
      <td colspan="2" class="label">Address: &nbsp;<span data-field="address">{{ address }}</span></td>
    </tr>
    <tr>
      <td class="label" style="width:40%;">City: &nbsp;<span data-field="city">{{ city }}</span></td>
      <td class="label">State: &nbsp;<span data-field="state">{{ state }}</span> &nbsp;&nbsp;&nbsp; Zip: &nbsp;<span data-field="zip">{{ zip }}</span></td>
    </tr>
    <tr>
      <td colspan="2">
        <table style="width:100%; border-collapse:collapse;">
          <tr>
            <td style="width:33%; border-right:1px solid #000; padding:3px 6px;">Amount: $ &nbsp;<span data-field="amount">{{ amount }}</span></td>
            <td style="width:33%; border-right:1px solid #000; padding:3px 6px;">Date: &nbsp;<span data-field="request_date">{{ request_date }}</span></td>
            <td style="width:34%; padding:3px 6px;" class="shaded">&nbsp;</td>
          </tr>
          <tr>
            <td style="border-right:1px solid #000; border-top:1px solid #000; padding:3px 6px; font-size:10.5px;"><strong>Index</strong> (old FRS account) &nbsp;<span data-field="index_number">{{ index_number }}</span></td>
            <td style="border-right:1px solid #000; border-top:1px solid #000; padding:3px 6px;">Fund &nbsp;<span data-field="fund">{{ fund }}</span></td>
            <td style="border-right:1px solid #000; border-top:1px solid #000; padding:3px 6px;">Orgn &nbsp;<span data-field="orgn">{{ orgn }}</span></td>
            <td style="border-top:1px solid #000; padding:3px 6px; font-size:10.5px;"><strong>Account</strong> (old subcode) &nbsp;<span data-field="account">{{ account }}</span></td>
          </tr>
        </table>
      </td>
    </tr>
  </table>

  <!-- Trip Table -->
  <table class="trip-table">
    <thead>
      <tr>
        <th rowspan="2" style="width:90px;">Date</th>
        <th rowspan="2" class="purpose-col" style="width:240px;">Purpose of Trip</th>
        <th colspan="4" class="header-span">Standard Mileage* or Odometer Reading</th>
      </tr>
      <tr>
        <th style="width:80px;">From</th>
        <th style="width:80px;">To</th>
        <th style="width:90px; font-size:9.5px;">One-way or round trip (x 2)</th>
        <th style="width:80px;">Total miles</th>
      </tr>
    </thead>
    <tbody>
      {% for trip in trips %}
      <tr>
        <td><span data-field="trips[{{ loop.index0 }}].date">{{ trip.date }}</span></td>
        <td class="purpose-col"><span data-field="trips[{{ loop.index0 }}].purpose">{{ trip.purpose }}</span></td>
        <td><span data-field="trips[{{ loop.index0 }}].from_location">{{ trip.from_location }}</span></td>
        <td><span data-field="trips[{{ loop.index0 }}].to_location">{{ trip.to_location }}</span></td>
        <td><span data-field="trips[{{ loop.index0 }}].one_way_or_round">{{ trip.one_way_or_round }}</span></td>
        <td><span data-field="trips[{{ loop.index0 }}].total_miles">{{ trip.total_miles }}</span></td>
      </tr>
      {% endfor %}
      <!-- Empty filler rows to match layout -->
      {% for i in range(12 - trips|length) %}
      <tr>
        <td>&nbsp;</td>
        <td>&nbsp;</td>
        <td>&nbsp;</td>
        <td>&nbsp;</td>
        <td>&nbsp;</td>
        <td>&nbsp;</td>
      </tr>
      {% endfor %}
    </tbody>
    <tfoot>
      <tr>
        <td colspan="4" rowspan="2" class="footer-note" style="vertical-align:top;">
          <strong>Attach additional sheet if necessary. *See</strong><br>
          <a href="#">http://departments.weber.edu/purchasing/Travel/default.htm</a><br>
          <strong>for mileage rates and standard mileage.</strong>
        </td>
        <td class="total-label">Total<br>mileage</td>
        <td class="total-value"><span data-field="total_mileage">{{ total_mileage }}</span></td>
      </tr>
      <tr>
        <td class="total-label">Total<br>X rate</td>
        <td class="total-value">$ <span data-field="total_x_rate">{{ total_x_rate }}</span></td>
      </tr>
    </tfoot>
  </table>

  <!-- Certification -->
  <div class="cert-text">
    I certify that this was a necessary expense for Weber State University and that I have not been,
    nor will be reimbursed from any other source.
  </div>

  <!-- Signatures -->
  <div class="sig-row">
    <div class="sig-block">
      <div class="sig-line"></div>
      <div class="sig-labels">
        <span>Traveler's signature</span>
        <span>Date</span>
      </div>
    </div>
    <div class="sig-block">
      <div class="sig-line"></div>
      <div class="sig-labels">
        <span>Supervisor's signature</span>
        <span>Date</span>
      </div>
    </div>
  </div>

  <!-- Additional sheet -->
  <div class="additional-sheet">
    <span class="checkbox"></span> Additional sheet attached.
  </div>

  <!-- Footer note box -->
  <div class="footer-note-box">
    Please note all signatures must be present before a check can be processed. When complete, return to
    Accounting Services, MC 1014. Checks will be mailed directly unless otherwise noted.
  </div>

  <div class="revised-text">Revised <span data-field="revised_date">{{ revised_date }}</span> srd</div>

</div>
</body>
</html>