<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic layout structure */
  body { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; }
  h1, h2, h3 { margin-top: 0; }
  .product-info-table { width: 100%; border-collapse: collapse; margin-top: 20px; }
  .product-info-table td { padding: 5px 0; font-size: 12px; }
  .header-logo { float: right; font-size: 24px; font-weight: bold; }
  .footer { position: absolute; bottom: 50px; left: 60px; right: 60px; font-size: 10px; color: #666; }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      <h1 style="font-size: 24px; font-weight: bold;">PRODUCT SPECIFICATION</h1>
      <h2 style="font-size: 36px; font-weight: bold; margin-top: 0;">XT200E</h2>
      <h3>PrimEvo Self-Contained 24M IP20 Surface</h3>
    </div>
    <div class="header-logo">ABB</div>
  </div>

  <div style="margin-top: 30px;">
    <p>Catalogue Number: <span data-field="catalogue_number">{{ catalogue_number }}</span></p>
    <p>GID: <span data-field="gid">{{ gid }}</span></p>
  </div>

  <table class="product-info-table">
    <tbody>
      <tr>
        <td style="width: 50%;">
          <strong>Warranty:</strong> <span data-field="warranty">{{ warranty }}</span>
        </td>
        <td style="width: 50%;">
          <strong>Emergency Duration (Hours):</strong> <span data-field="emergency_duration">{{ emergency_duration }}</span>
        </td>
      </tr>
      <tr>
        <td>
          <strong>Product Type:</strong> <span data-field="product_type">{{ product_type }}</span>
        </td>
        <td>
          <strong>Battery:</strong> <span data-field="battery_type">{{ battery_type }}</span>
        </td>
      </tr>
      <tr>
        <td>
          <strong>Mounting Method/Form:</strong> <span data-field="mounting_method">{{ mounting_method }}</span>
        </td>
        <td>
          <strong>Monitoring Equipment:</strong> <span data-field="monitoring_equipment">{{ monitoring_equipment }}</span>
        </td>
      </tr>
      <tr>
        <td>
          <strong>Housing Material:</strong> <span data-field="housing_material">{{ housing_material }}</span>
        </td>
        <td>
          <strong>Lamp:</strong> <span data-field="lamp_type">{{ lamp_type }}</span>
        </td>
      </tr>
      <tr>
        <td>
          <strong>Colour:</strong> <span data-field="colour">{{ colour }}</span>
        </td>
        <td>
          <strong>Emergency Light Output (Lumens):</strong> <span data-field="light_output">{{ light_output }}</span>
        </td>
      </tr>
      <tr>
        <td>
          <strong>Dimensions (LxWxD):</strong> <span data-field="dimensions">{{ dimensions }}</span>
        </td>
        <td>
          <strong>Average Lifespan light source (Hours):</strong> <span data-field="lifespan">{{ lifespan }}</span>
        </td>
      </tr>
      <tr>
        <td>
          <strong>Temperature Range:</strong> <span data-field="temperature_range">{{ temperature_range }}</span>
        </td>
        <td>
          <strong>Light Colour/Temperature/CRI:</strong> <span data-field="light_specs">{{ light_specs }}</span>
        </td>
      </tr>
      <tr>
        <td colspan="2">
          <strong>Degree of Protection:</strong> <span data-field="ip_rating">{{ ip_rating }}</span>
        </td>
      </tr>
    </tbody>
  </table>

  <!-- Footer Area -->
  <div class="footer">
    <div style="display: flex; justify-content: space-between; align-items: center;">
      <div>
        <span style="font-weight: bold;">EMERGI-LITE</span>
        <p style="margin: 2px 0 0 0;">UK +44 (0) 333 999 9900 lv.enquiries@gb.abb.com</p>
        <p style="margin: 2px 0 0 0;">UAE +971 (4) 314 7500 info@ae.abb.com</p>
        <p style="margin: 2px 0 0 0;">www.emergi-lite.co.uk</p>
      </div>
      <div style="text-align: right;">
        <img src="placeholder_exit_sign.png" alt="Exit Sign" style="width: 80px; height: auto; margin-right: 10px;">
        <div style="text-align: right;">
          <span style="font-size: 10px;">Exit Sign</span>
          <span style="font-size: 10px;">Configurable pictograms included</span>
          <div style="margin-top: 10px;">
            <span style="font-size: 14px;">CE</span>
            <span style="font-size: 14px;">LED</span>
          </div>
        </div>
      </div>
    </div>
    <p style="text-align: right; margin-top: 15px;">PrimEvo_XT200E_spec_SKK2709200401 02 February 2022</p>
  </div>
</div>