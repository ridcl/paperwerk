<head>
    <title>Document Conversion</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3, h4, h5, h6 {
            font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif;
            font-weight: bold;
        }
        p {
            line-height: 1.5;
            margin-bottom: 1em;
        }
        .section-title {
            font-weight: bold;
            margin-top: 1.5em;
            margin-bottom: 0.5em;
        }
        .list-item {
            margin-bottom: 0.5em;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 1em;
            margin-bottom: 1em;
        }
        td {
            padding: 8px 0;
            vertical-align: top;
        }
        .header-row td {
            font-weight: bold;
        }
    </style>
</head>
