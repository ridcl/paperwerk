    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 {
    font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
    margin-bottom: 20px;
  }
  td, th {
    padding: 8px;
    text-align: left;
    border: 1px solid #ccc;
  }
  .header-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
  }
  .title-block {
    text-align: center;
    margin-bottom: 40px;
  }
  .title-block h1 {
    font-size: 24pt;
    margin: 0;
  }
  .title-block h2 {
    font-size: 14pt;
    margin: 5px 0 0 0;
  }
  .meeting-details {
    display: flex;
    justify-content: space-between;
    margin-bottom: 30px;
    font-size: 12pt;
  }
  .signature-area {
    margin-top: 50px;
    display: flex;
    justify-content: space-around;
  }
  .signature-box {
    text-align: center;
    width: 40%;
  }
  .signature-line {
    border-top: 1px solid black;
    margin-top: 50px;
    display: block;
  }
</style>

