<!DOCTYPE html>
<html>
<head>
<title>Document</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  .header-title { font-size: 24pt; font-weight: bold; text-align: center; margin-bottom: 20px; }
  .logo { float: right; }
  .section-heading { font-size: 14pt; font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 15px; }
  .form-row > div { flex: 1; }
  .form-label { font-weight: bold; display: block; margin-bottom: 5px; }
  .form-input { border-bottom: 1px solid #000; padding-bottom: 2px; }
  .divider { border-top: 1px solid #000; margin: 20px 0; }
  .note { font-size: 10pt; margin-top: 15px; line-height: 1.4; }
  .signature-block { margin-top: 50px; }
  .signature-line { border-bottom: 1px solid #000; margin-bottom: 5px; width: 50%; }
</style>
</head>
<body>
<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      <span class="header-title">Morris Dailey Auditorium</span>
      <div style="margin-top: 10px;">
        <span data-field="organization_name">{{ organization_name }}</span>, <span data-field="organization_location">{{ organization_location }}</span>
      </div>
    </div>
    <div class="logo">
      <img src="placeholder_sjsu_logo.png" alt="SJSU Logo" style="height: 80px;">
      <div style="text-align: center; font-size: 10pt; margin-top: 5px;">
        <span>SJSU</span><br>
        <span>SAN JOSÉ STATE UNIVERSITY</span>
      </div>
    </div>
  </div>

  <div class="divider"></div>

  <div class="form-row">
    <div>
      <span class="form-label">Organization:</span>
      <div class="form-input"><span data-field="organization_name">{{ organization_name }}</span></div>
    </div>
    <div>
      <span class="form-label">Today's Date:</span>
      <div class="form-input"><span data-field="today_date">{{ today_date }}</span></div>
    </div>
  </div>

  <div class="form-row">
    <div>
      <span class="form-label">Advisor:</span>
      <div class="form-input"><span data-field="advisor_name">{{ advisor_name }}</span></div>
    </div>
    <div>
      <span class="form-label">Phone:</span>
      <div class="form-input"><span data-field="advisor_phone">{{ advisor_phone }}</span></div>
    </div>
  </div>

  <div class="form-row">
    <div>
      <span class="form-label">Primary Contact:</span>
      <div class="form-input"><span data-field="primary_contact_name">{{ primary_contact_name }}</span></div>
    </div>
    <div>
      <span class="form-label">Phone:</span>
      <div class="form-input"><span data-field="primary_contact_phone">{{ primary_contact_phone }}</span></div>
    </div>
  </div>

  <div class="form-row">
    <div>
      <span class="form-label">Email:</span>
      <div class="form-input"><span data-field="primary_contact_email">{{ primary_contact_email }}</span></div>
    </div>
    <div>
      <span class="form-label">Event Date(s):</span>
      <div class="form-input"><span data-field="event_date">{{ event_date }}</span></div>
    </div>
  </div>

  <div class="form-row">
    <div>
      <span class="form-label">Event Title:</span>
      <div class="form-input"><span data-field="event_title">{{ event_title }}</span></div>
    </div>
    <div>
      <span class="form-label">Exit Time:</span>
      <div class="form-input"><span data-field="exit_time">{{ exit_time }}</span></div>
    </div>
  </div>

  <div class="form-row">
    <div>
      <span class="form-label">Access Time:</span>
      <div class="form-input"><span data-field="access_time">{{ access_time }}</span></div>
    </div>
    <div>
      <span class="form-label">Doors:</span>
      <div class="form-input"><span data-field="doors">{{ doors }}</span></div>
    </div>
  </div>

  <div class="form-row">
    <div>
      <span class="form-label">Event Start:</span>
      <div class="form-input"><span data-field="event_start">{{ event_start }}</span></div>
    </div>
    <div>
      <span class="form-label">Event End:</span>
      <div class="form-input"><span data-field="event_end">{{ event_end }}</span></div>
    </div>
  </div>

  <div style="margin-top: 20px;">
    <span class="form-label" style="display: inline-block; width: 100%;">Please provide a brief description of the event:</span>
    <div style="border: 1px solid #000; height: 60px; margin-top: 5px; padding: 5px;"><span data-field="event_description">{{ event_description }}</span></div>
  </div>

  <div class="form-row" style="margin-top: 20px;">
    <div>
      <span class="form-label">Estimated Attendance:</span>
      <div class="form-input"><span data-field="estimated_attendance">{{ estimated_attendance }}</span></div>
    </div>
    <div>
      <span class="form-label">Admission Fee: $</span>
      <div class="form-input"><span data-field="admission_fee">{{ admission_fee }}</span></div>
    </div>
  </div>

  <div class="form-row">
    <div>
      <span class="form-label">Monetary Transactions:</span>
      <div class="form-input"><span data-field="monetary_transactions">{{ monetary_transactions }}</span></div>
    </div>
    <div>
      <span class="form-label">Yes / No</span>
      <div class="form-input"><span data-field="yes_no_transactions">{{ yes_no_transactions }}</span></div>
    </div>
  </div>

  <div class="form-row">
    <div>
      <span class="form-label">Technical Services:</span>
      <div class="form-input"><span data-field="technical_services">{{ technical_services }}</span></div>
    </div>
    <div>
      <span class="form-label">If yes, please list provider:</span>
      <div class="form-input"><span data-field="technical_provider">{{ technical_provider }}</span></div>
    </div>
  </div>

  <div class="note">
    Reminder: FOOD/DRINKS ARE NOT ALLOWED IN THE AUDITORIUM AND FOYER.
    <br>
    PLEASE KEEP ALL FOOD AND DRINKS OUTSIDE OF THE BUILDING.
  </div>

  <div class="divider"></div>

  <div class="note" style="font-size: 10pt;">
    Use of music on campus for events and programs must comply with SJSU/SU Music License requirements with BMI, ASCAP, SESAC, and Global Music.
  </div>

  <div class="divider"></div>

  <div class="note" style="font-size: 10pt;">
    Client agrees to indemnify, defend and hold harmless the Student Union, Inc. and San José State University, San José State University, the Trustees of California State University and the State of California, their officers, agents and employees from any and all liability, claim, loss, cost or obligations on account of or arising out of injury or death, damage to persons or property from whatever cause where such injury, death or damage is connected with the event, use or services scheduled.
  </div>

  <div class="note" style="font-size: 10pt;">
    By signing below, I understand that I must contact the Technical Production Lead at {{ contact_phone }} at {{ contact_email }} to operate the facilities of the facility. Failure to do so at least {{ required_days }} days prior to the event, will lead to a cancellation of the event. I also understand that by law, at least ONE authorized representative of Student Union, Inc. must be present for every 250 people within the facility (including members of the organization, guests, patrons and volunteers) for crowd management.
  </div>

  <div class="note" style="font-size: 10pt;">
    I understand that no food or beverages are permitted in the auditorium.
  </div>

  <div class="note" style="font-size: 10pt;">
    I, on behalf of, and as an authorized agent of the above named organization, agree to abide by the policies of the San José State University and the Student Union, Inc. regarding the use of the facilities. I have read and understand all policies regarding fees, cancellations, and no shows.
  </div>

  <div class="signature-block">
    <div class="form-row">
      <div>
        <span class="form-label">Advisor Signature</span>
        <div class="signature-line" data-field="advisor_signature">{{ advisor_signature }}</div>
      </div>
      <div>
        <span class="form-label">Date</span>
        <div class="form-input"><span data-field="signature_date">{{ signature_date }}</span></div>
      </div>
    </div>
  </div>

  <div class="divider"></div>

  <div class="note" style="text-align: center; font-weight: bold;">
    THIS SECTION BELOW IS TO BE COMPLETED BY ADMINISTRATION ONLY
  </div>

  <div class="signature-block" style="margin-top: 30px;">
    <div class="form-row">
      <div>
        <span class="form-label">Student Union Event Services Signature</span>
        <div class="signature-line" data-field="student_union_event_services_signature">{{ student_union_event_services_signature }}</div>
      </div>
      <div>
        <span class="form-label">Date</span>
        <div class="form-input"><span data-field="admin_date">{{ admin_date }}</span></div>
      </div>
    </div>
    <div class="form-row" style="margin-top: 20px;">
      <div>
        <span class="form-label">Approved/Denied</span>
        <div class="form-input"><span data-field="approval_status">{{ approval_status }}</span></div>
      </div>
      <div>
        <span class="form-label">Additional Requirements:</span>
        <div class="form-input"><span data-field="additional_requirements">{{ additional_requirements }}</span></div>
      </div>
    </div>
  </div>

  <div style="margin-top: 80px; font-size: 9pt; text-align: center;">
    Revised: <span data-field="revision_date">{{ revision_date }}</span> | Copies to: Event Services, Technical Services, UPD, Requestor | Reservation Form for Non-Academic Events
  </div>
</div>
</body>
</html>