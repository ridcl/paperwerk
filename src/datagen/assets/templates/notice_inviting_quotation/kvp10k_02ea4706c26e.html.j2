<!DOCTYPE html>
<html>
<head>
<title>Synthetic Document</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    margin: 0;
    padding: 0;
  }
  h1, h2, h3 {
    text-align: center;
    margin-bottom: 0.5em;
  }
  .header-info {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 30px;
  }
  .logo {
    /* Placeholder for logo area */
    width: 100px;
    height: 100px;
    border: 1px solid #ccc;
    text-align: center;
    line-height: 100px;
    font-size: 12px;
  }
  .title-block {
    text-align: center;
  }
  .title-block h1 {
    font-size: 18pt;
    margin-bottom: 5px;
  }
  .title-block h2 {
    font-size: 14pt;
    margin-top: 0;
    margin-bottom: 20px;
  }
  .notice-header {
    text-align: center;
    margin-bottom: 30px;
  }
  .notice-header h3 {
    font-size: 14pt;
    margin: 0;
  }
  .metadata-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 20px;
    font-size: 10pt;
  }
  .metadata-row div {
    display: flex;
    gap: 20px;
  }
  .section-title {
    font-weight: bold;
    margin-top: 25px;
    margin-bottom: 15px;
    font-size: 12pt;
  }
  .form-row {
    display: flex;
    margin-bottom: 15px;
    font-size: 11pt;
  }
  .form-row > div {
    flex: 1;
  }
  .label {
    font-weight: normal;
    display: block;
    margin-bottom: 3px;
  }
  .value-container {
    border-bottom: 1px solid #000;
    padding-bottom: 2px;
  }
  .table-container {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
    font-size: 10pt;
  }
  .table-container th, .table-container td {
    border: 1px solid #000;
    padding: 8px;
    text-align: left;
  }
  .table-container th {
    background-color: #f0f0f0;
    font-weight: bold;
  }
  .centered-text {
    text-align: center;
  }
  .signature-block {
    margin-top: 60px;
    display: flex;
    justify-content: space-between;
    font-size: 10pt;
  }
  .signature-area {
    text-align: center;
    width: 45%;
  }
  .signature-area p {
    margin-top: 40px;
    border-top: 1px solid #000;
    padding-top: 5px;
  }
  .footer-text {
    margin-top: 50px;
    font-size: 9pt;
    text-align: center;
  }
  .two-column-layout {
    display: flex;
    gap: 40px;
    margin-top: 20px;
  }
  .two-column-layout > div {
    flex: 1;
  }
  .list-item {
    margin-bottom: 10px;
    font-size: 10pt;
  }
  .list-item strong {
    display: inline-block;
    width: 150px;
  }
</style>

<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  table {
    width: 100%;
    border-collapse: collapse;
    font-family: "DejaVu Sans", "Liberation Sans", Arial, Helvetica, sans-serif;
  }
  th, td {
    border: 1px solid #ccc;
    padding: 8px;
    text-align: left;
  }
  h1 {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, serif;
    text-align: center;
    font-size: 18pt;
    margin-bottom: 5px;
  }
  h2 {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, serif;
    text-align: center;
    font-size: 14pt;
    margin-top: 0;
    margin-bottom: 20px;
