    <div class="form-row">
      <div class="form-label">5. Permanent Account Number</div>
      <div class="form-input"><span data-field="pan_number">{{ pan_number }}</span></div>
    </div>
    <div class="form-row">
      <div class="form-label">6. Particulars of Bank:</div>
      <div style="display: flex; justify-content: space-between; width: 100%;">
        <div style="width: 30%;">Bank Name: <span data-field="bank_name">{{ bank_name }}</span></div>
        <div style="width: 30%;">Branch Name: <span data-field="branch_name">{{ branch_name }}</span></div>
      </div>
      <div style="display: flex; justify-content: space-between; margin-top: 10px;">
        <div style="width: 30%;">PIN Code: <span data-field="bank_pin_code">{{ bank_pin_code }}</span></div>
        <div style="width: 30%;">Branch Code: <span data-field="bank_branch_code">{{ bank_branch_code }}</span></div>
      </div>
    </div>

    <div style="margin-top: 20px;">
      <table style="width: 100%; border-collapse: collapse;">
        <tr>
          <td style="width: 25%; padding: 5px;">IFSC Code:(11 digit alpha numeric code)</td>
          <td style="width: 75%; border-bottom: 1px solid #000;"><span data-field="ifsc_code">{{ ifsc_code }}</span></td>
        </tr>
        <tr>
          <td style="width: 25%; padding: 5px;">Account Type</td>
          <td style="width: 25%; border-bottom: 1px solid #000;"><span data-field="account_type">{{ account_type }}</span></td>
          <td style="width: 25%; border-bottom: 1px solid #000;"><span data-field="savings_type">{{ savings_type }}</span></td>
          <td style="width: 25%; border-bottom: 1px solid #000;"><span data-field="current_type">{{ current_type }}</span></td>
        </tr>
        <tr>
          <td style="width: 25%; padding: 5px;">Account Number:</td>
          <td style="width: 75%; border-bottom: 1px solid #000;"><span data-field="account_number">{{ account_number }}</span></td>
        </tr>
      </table>
    </div>
  </div>

  <h2 class="section-title" style="margin-top: 50px;">DECLARATION</h2>

  <p style="text-align: justify; line-height: 1.5;">
    I hereby declare that the particulars given above are correct and complete. If any transaction delayed and not effected for reasons of incomplete or incorrect information I shall not hold Director, National Institute of Technology Tiruchirappalli responsible. I also undertake to advise any change in the particulars of my account to facilitate updating of records for purpose of credit of amount through NEFT/RTGS Transfer.
  </p>

  <div style="display: flex; justify-content: space-between; margin-top: 60px;">
    <div>
      Place: <span data-field="place_of_declaration">{{ place_of_declaration }}</span>
    </div>
    <div>
      Date: <span data-field="date_of_declaration">{{ date_of_declaration }}</span>
    </div>
  </div>
</div>

<div class="page">
  <div class="header-info">
    <div style="float: left; margin-right: 20px;">
      <!-- Placeholder for Logo -->
    </div>
    <div>
      <h1>NATIONAL INSTITUTE OF TECHNOLOGY</h1>
      <p>TIRUCHIRAPPALLI - 620 015</p>
    </div>
  </div>

  <div style="text-align: center; margin-top: 100px;">
    <div class="signature-line" style="width: 50%;"></div>
    <p style="margin-top: 10px;">Signature & Seal of the Authorized Signatory of the Party</p>
  </div>
</div>

</body>
</html>