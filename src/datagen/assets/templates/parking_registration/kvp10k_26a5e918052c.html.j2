          <label><input type="radio" name="vehicle2_type" value="motorcycle"> Motorcycle</label>
          <label><input type="radio" name="vehicle2_type" value="sport"> Sport/Utility</label>
          <label><input type="radio" name="vehicle2_type" value="station"> Station Wagon</label>
          <label><input type="radio" name="vehicle2_type" value="van"> Van/Bus</label>
        </div>
        <div>
