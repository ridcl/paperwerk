                <th style="width: 20%;">Revision</th>
                <th style="width: 30%;">Date</th>
                <th style="width: 50%;">Note/Version Information</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><span data-field="revision_id">{{ revision_id }}</span></td>
                <td><span data-field="revision_date">{{ revision_date }}</span></td>
                <td><span data-field="version_info">{{ version_info }}</span></td>
            </tr>
        </tbody>
    </table>

    <h3 style="font-size: 14pt; margin-top: 30px;">Applicability</h3>
    <p>This document is applicable to all <span data-field="series_name">{{ series_name }}</span> Protection and Control IED versions mentioned in document Revision History above or newer versions if document update is not required.</p>
