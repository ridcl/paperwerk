        <!-- Product Images -->
        <div style="width: 85%; display: flex; justify-content: space-between; align-items: flex-start;">
            {% for i in range(1, 5) %}
            <div style="text-align: center; width: 23%;">
                <div style="font-size: 11px; margin-bottom: 5px;">PowerValue</div>
                <div style="font-size: 10px; margin-bottom: 10px;">11RT G2 - {{ i }} kVA</div>
