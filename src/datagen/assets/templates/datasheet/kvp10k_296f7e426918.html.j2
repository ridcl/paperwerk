<!DOCTYPE html>
<html>
<head>
    <title>Product Datasheet</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3, h4 { margin-top: 0; }
        .header-info { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px; }
        .product-title { font-size: 24pt; font-weight: bold; margin-bottom: 5px; }
        .product-type { font-size: 16pt; font-weight: bold; margin-bottom: 20px; }
        .section-title { font-size: 14pt; font-weight: bold; margin-top: 25px; margin-bottom: 10px; }
        .description-list { list-style-type: disc; padding-left: 20px; margin-top: 10px; }
        .description-list li { margin-bottom: 5px; }
        .image-container { float: right; margin-left: 30px; margin-bottom: 20px; }
        .image-container img { max-width: 100%; height: auto; }
        .table-container { width: 100%; border-collapse: collapse; margin-top: 15px; }
        .table-container th, .table-container td { border: 1px solid #ccc; padding: 8px; text-align: left; }
        .table-container th { background-color: #f2f2f2; }
        .footer { position: absolute; bottom: 20px; width: 100%; text-align: center; font-size: 10pt; color: #555; }
        .page-number { position: absolute; bottom: 30px; right: 60px; font-size: 10pt; }
    </style>
</head>
