                    <p>For enquiries</p>
                    <p>Phone: <span data-field="phone_number">{{ phone_number }}</span></p>
                    <p>E-mail: <span data-field="email_address">{{ email_address }}</span></p>
                    <p>www.<span data-field="website_domain">{{ website_domain }}</span></p>
                </div>
            </div>
            <div style="width: 50%; text-align: right;">
                <div class="body-text" style="text-align: right;">
