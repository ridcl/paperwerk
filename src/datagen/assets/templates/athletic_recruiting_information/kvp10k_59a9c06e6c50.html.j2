<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { margin-top: 0; }
  .header-title { font-size: 24pt; font-weight: bold; }
  .section-title { font-size: 14pt; font-weight: bold; margin-bottom: 10px; }
  .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .field-row { display: flex; flex-direction: column; margin-bottom: 8px; }
  .field-label { font-weight: bold; margin-bottom: 2px; font-size: 10pt; }
  .field-value { font-size: 10pt; }
  .divider { border-top: 1px solid #ccc; margin: 20px 0; }
</style>

<div class="page">
  <div style="text-align: center; margin-bottom: 40px;">
    <img src="placeholder_logo.png" alt="Logo" style="height: 60px; margin-bottom: 10px;">
    <h1 class="header-title">SHORELINE DOLPHIN ATHLETICS</h1>
    <p style="font-size: 12pt;">ATHLETIC RECRUITING INFORMATION</p>
  </div>

  <div class="info-grid">
    <!-- Basic Info Column -->
    <div>
      <h2 class="section-title">Basic Info</h2>
      <div class="field-row">
        <span class="field-label">Full Name:</span>
        <span class="field-value"><span data-field="full_name">{{ full_name }}</span></span>
      </div>
      <div class="field-row">
        <span class="field-label">School:</span>
        <span class="field-value"><span data-field="school">{{ school }}</span></span>
      </div>
      <div class="field-row">
        <span class="field-label">Sport(s):</span>
        <span class="field-value"><span data-field="sport">{{ sport }}</span></span>
      </div>
      <div class="field-row">
        <span class="field-label">Level (Fr, JV, Var):</span>
        <span class="field-value"><span data-field="level">{{ level }}</span></span>
      </div>
    </div>

    <!-- Education Info Column -->
    <div>
      <h2 class="section-title">Education Info</h2>
      <div class="field-row">
        <span class="field-label">Graduation Year:</span>
        <span class="field-value"><span data-field="graduation_year">{{ graduation_year }}</span></span>
      </div>
      <div class="field-row">
        <span class="field-label">GPA:</span>
        <span class="field-value"><span data-field="gpa">{{ gpa }}</span></span>
      </div>
      <div class="field-row">
        <span class="field-label">SAT Score:</span>
        <span class="field-value"><span data-field="sat_score">{{ sat_score }}</span></span>
      </div>
      <div class="field-row">
        <span class="field-label">ACT Score:</span>
        <span class="field-value"><span data-field="act_score">{{ act_score }}</span></span>
      </div>
    </div>
  </div>

  <div class="divider"></div>

  <div class="info-grid">
    <!-- Players Contact Info Column -->
    <div>
      <h2 class="section-title">Players Contact Info</h2>
      <div class="field-row">
        <span class="field-label">Address:</span>
        <span class="field-value"><span data-field="address">{{ address }}</span></span>
      </div>
      <div class="field-row">
        <span class="field-label">City:</span>
        <span class="field-value"><span data-field="city">{{ city }}</span></span>
      </div>
      <div class="field-row">
        <span class="field-label">State:</span>
        <span class="field-value"><span data-field="state">{{ state }}</span></span>
      </div>
      <div class="field-row">
        <span class="field-label">Zip:</span>
        <span class="field-value"><span data-field="zip">{{ zip }}</span></span>
      </div>
      <div class="field-row">
        <span class="field-label">Phone:</span>
        <span class="field-value"><span data-field="phone">{{ phone }}</span></span>
      </div>
      <div class="field-row">
        <span class="field-label">Email:</span>
        <span class="field-value"><span data-field="email">{{ email }}</span></span>
      </div>
    </div>

    <!-- Physical Characteristics Column -->
    <div>
      <h2 class="section-title">Physical Characteristics</h2>
      <div class="field-row">
        <span class="field-label">Height:</span>
        <span class="field-value"><span data-field="height">{{ height }}</span></span>
      </div>
      <div class="field-row">
        <span class="field-label">Weight:</span>
        <span class="field-value"><span data-field="weight">{{ weight }}</span></span>
      </div>
      <div class="field-row">
        <span class="field-label">Date of Birth:</span>
        <span class="field-value"><span data-field="dob">{{ dob }}</span></span>
      </div>
    </div>
  </div>

  <div class="divider"></div>

  <div class="info-grid">
    <!-- Coach's Contact Info Column -->
    <div>
      <h2 class="section-title">Coach's Contact Info</h2>
      <div class="field-row">
        <span class="field-label">Coach Name:</span>
        <span class="field-value"><span data-field="coach_name">{{ coach_name }}</span></span>
      </div>
      <div class="field-row">
        <span class="field-label">Coach Phone:</span>
        <span class="field-value"><span data-field="coach_phone">{{ coach_phone }}</span></span>
      </div>
      <div class="field-row">
        <span class="field-label">Coach Email:</span>
        <span class="field-value"><span data-field="coach_email">{{ coach_email }}</span></span>
      </div>
    </div>

    <!-- Statistics Column -->
    <div>
      <h2 class="section-title">Statistics</h2>
      <div class="field-row">
        <span class="field-label">Position:</span>
        <span class="field-value"><span data-field="position">{{ position }}</span></span>
      </div>
      <div class="field-row">
        <span class="field-label">Dominant Hand:</span>
        <span class="field-value"><span data-field="dominant_hand">{{ dominant_hand }}</span></span>
      </div>
      <div class="field-row">
        <span class="field-label">Notable Stats:</span>
        <span class="field-value"><span data-field="notable_stats">{{ notable_stats }}</span></span>
      </div>
    </div>
  </div>

  <div class="divider"></div>

  <div class="info-grid">
    <!-- Parent/Guardian Contact Info Column -->
    <div>
      <h2 class="section-title">Parent/Guardian Contact Info</h2>
      <div class="field-row">
        <span class="field-label">Parent/Guardian Names:</span>
        <span class="field-value"><span data-field="parent_guardian_names">{{ parent_guardian_names }}</span></span>
      </div>
      <div class="field-row">
        <span class="field-label">Parent/Guardian Phone(s):</span>
        <span class="field-value"><span data-field="parent_guardian_phone">{{ parent_guardian_phone }}</span></span>
      </div>
      <div class="field-row">
        <span class="field-label">Parent/Guardian Email(s):</span>
        <span class="field-value"><span data-field="parent_guardian_email">{{ parent_guardian_email }}</span></span>
      </div>
    </div>

    <!-- Awards & Achievements Column -->
    <div>
      <h2 class="section-title">Awards & Achievements</h2>
      <div style="height: 150px; border-bottom: 1px solid #ccc;">
        <!-- Placeholder for list/text area -->
      </div>
    </div>
  </div>

  <div class="divider"></div>

  <!-- Footer Section -->
  <div style="text-align: center; font-size: 9pt; margin-top: 40px;">
    <p>SCC Athletics: <span data-field="scc_date">{{ scc_date }}</span></p>
    <p style="margin-top: 20px;">Please return to the Athletics Office at Shoreline Community College.</p>
    <p>16101 Greenwood Ave N, Shoreline, WA 98133</p>
    <p>athletics@shoreline.edu</p>
    <p>206-5464746</p>
  </div>
</div>