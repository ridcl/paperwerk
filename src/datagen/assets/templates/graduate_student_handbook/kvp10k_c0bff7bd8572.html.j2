<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  th, td {
    padding: 8px 12px;
    text-align: left;
  }
  th {
    font-weight: bold;
    border-bottom: 1px solid #ccc;
  }
  tr:nth-child(even) {
    background-color: #f9f9f9;
  }
</style>

<div class="page">
  <div style="text-align: right; font-size: 12pt;">
    <span data-field="page_number">{{ page_number }}</span>
  </div>
  <table>
    <thead>
      <tr>
        <th style="width: 30%;">Name</th>
        <th style="width: 35%;">Email</th>
        <th style="width: 35%;">Field of Study</th>
      </tr>
    </thead>
    <tbody>
      {% for person in people %}
      <tr>
        <td><span data-field="people[{{ loop.index0 }}].full_name">{{ person.full_name }}</span></td>
        <td><span data-field="people[{{ loop.index0 }}].email">{{ person.email }}</span></td>
        <td><span data-field="people[{{ loop.index0 }}].field_of_study">{{ person.field_of_study }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <div style="margin-top: auto; display: flex; justify-content: space-between; font-size: 10pt;">
    <div>Graduate Student Handbook, MS Biology</div>
    <div>Winter 2022</div>
  </div>
</div></body>
