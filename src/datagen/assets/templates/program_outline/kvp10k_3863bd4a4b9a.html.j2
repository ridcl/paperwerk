    </tbody>
  </table>

  <h4 style="margin-top: 20px;">Pre-Professional Courses</h4>
  <table>
    <thead>
      <tr>
        <th>Course</th>
        <th>Hrs</th>
        <th>Grade</th>
      </tr>
    </thead>
    <tbody>
      {% for course in pre_professional_courses %}
      <tr>
        <td>{{ course.course_code }}</td>
        <td>{{ course.hours }}</td>
        <td>{{ course.grade }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <h4 style="margin-top: 20px;">Phase 2 Nursing Courses</h4>
  <table>
    <thead>
      <tr>
        <th>Course</th>
        <th>Hrs</th>
        <th>Grade</th>
      </tr>
    </thead>
    <tbody>
      {% for course in phase_2_courses %}
      <tr>
        <td>{{ course.course_code }}</td>
        <td>{{ course.hours }}</td>
        <td>{{ course.grade }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <h4 style="margin-top: 20px;">Phase 3 Nursing Professional Courses</h4>
  <table>
    <thead>
      <tr>
        <th>Course</th>
        <th>Hrs</th>
        <th>Grade</th>
      </tr>
    </thead>
    <tbody>
      {% for course in phase_3_courses %}
      <tr>
        <td>{{ course.course_code }}</td>
        <td>{{ course.hours }}</td>
        <td>{{ course.grade }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div style="margin-top: 30px;">
    <p><strong>Total</strong>: Core: <span data-field="total.core_hours">{{ total.core_hours }}</span> Hrs | Pre-Prof: <span data-field="total.pre_prof_hours">{{ total.pre_prof_hours }}</span> Hrs | Phase 2: <span data-field="total.phase2_hours">{{ total.phase2_hours }}</span> Hrs | Phase 3: <span data-field="total.phase3_hours">{{ total.phase3_hours }}</span> Hrs</p>
    <p>Total Degree Plan Credit Hours: <span data-field="total.degree_hours">{{ total.degree_hours }}</span></p>
  </div>

  <div style="margin-top: 30px;">
    <p><strong>Note:</strong> Students are ranked for selection based on:</p>
    <ol>
      <li>Competitive pre-professional courses GPA</li>
      <li>Competitive cumulative GPA (3.0 or higher)</li>
      <li>Successful completion of the TEAS test (62% or higher)</li>
      <li>Proof of health insurance</li>
    </ol>
    <p>Phase 2 final grades will affect your overall GPA for Phase 2 and/or Phase 3.</p>
  </div>
</div>

<div class="page">
  <h3 class="section-title">Phase 1 Pre-Professional Courses and Pre-requisite Information</h3>

  <table>
    <thead>
      <tr>
        <th>Course</th>
        <th>Pre-requisite</th>
      </tr>
    </thead>
    <tbody>
