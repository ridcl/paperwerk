            <span data-field="issuer_name_address">{{ issuer_name_address }}</span>
          </div>
        </div>
        <div class="form-row">
          <div class="form-label"></div>
          <div class="form-input">
            <input type="checkbox"> VOID <input type="checkbox"> CORRECTED <input type="checkbox"> 1 ABLE contributions
          </div>
        </div>
        <div class="form-row">
          <div class="form-label">OMB No. 1545-2262</div>
          <div class="form-input"></div>
        </div>
      </td>
      <td style="width: 50%; text-align: right;">
        <div class="section-header">ABLE Account Contribution Information</div>
        <div class="form-row" style="margin-top: 20px;">
          <div class="form-label"></div>
          <div class="form-input">
            <span data-field="tax_year">{{ tax_year }}</span>
          </div>
        </div>
        <div class="form-row">
          <div class="form-label">Form 5498-QA</div>
          <div class="form-input"></div>
        </div>
        <div class="form-row">
          <div class="form-label">Copy A</div>
          <div class="form-input"></div>
        </div>
        <div class="form-row">
          <div class="form-label">ISSUER'S TIN</div>
          <div class="form-input">
            <span data-field="issuer_tin">{{ issuer_tin }}</span>
          </div>
        </div>
        <div class="form-row">
          <div class="form-label">BENEFICIARY'S TIN</div>
          <div class="form-input">
            <span data-field="beneficiary_tin">{{ beneficiary_tin }}</span>
          </div>
        </div>
        <div class="form-row">
          <div class="form-label">3 Cumulative contributions</div>
          <div class="form-input">
            <span data-field="cumulative_contributions">{{ cumulative_contributions }}</span>
          </div>
        </div>
        <div class="form-row">
          <div class="form-label">4 Fair market value</div>
          <div class="form-input">
            <span data-field="fair_market_value">{{ fair_market_value }}</span>
          </div>
        </div>
        <div class="form-row">
          <div class="form-label">BENEFICIARY'S name</div>
          <div class="form-input">
            <span data-field="beneficiary_name">{{ beneficiary_name }}</span>
          </div>
        </div>
        <div class="form-row">
          <div class="form-label">5 Check if account opened in 2022</div>
          <div class="form-input">
            <input type="checkbox">
          </div>
        </div>
        <div class="form-row">
          <div class="form-label">6 Basis of eligibility</div>
          <div class="form-input">
            <span data-field="basis_of_eligibility">{{ basis_of_eligibility }}</span>
          </div>
        </div>
        <div class="form-row" style="margin-top: 20px;">
          <div class="form-label">Street address (including apt. no.)</div>
          <div class="form-input">
            <span data-field="beneficiary_address">{{ beneficiary_address }}</span>
          </div>
        </div>
        <div class="form-row">
          <div class="form-label">City or town, state or province, country, and ZIP or foreign postal code</div>
          <div class="form-input">
            <span data-field="beneficiary_city_state_zip">{{ beneficiary_city_state_zip }}</span>
          </div>
        </div>
        <div class="form-row">
          <div class="form-label">Account number (see instructions)</div>
          <div class="form-input">
            <span data-field="account_number">{{ account_number }}</span>
          </div>
        </div>
      </td>
    </tr>
  </table>
  <div style="margin-top: 40px; display: flex; justify-content: space-between;">
    <div style="width: 45%;">
      <div class="form-row">
        <div class="form-label">Form 5498-QA</div>
        <div class="form-input">Cat. No. 67556T</div>
      </div>
      <div class="form-row">
        <div class="form-label"></div>
        <div class="form-input">www.irs.gov/Form5498QA</div>
