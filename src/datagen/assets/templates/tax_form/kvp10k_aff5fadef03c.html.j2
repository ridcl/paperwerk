<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  table { width: 100%; border-collapse: collapse; }
  td, th { padding: 4px 0; text-align: left; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 10px; }
  .form-label { width: 40%; }
  .form-input { width: 55%; }
  .section-header { font-weight: bold; margin-bottom: 10px; }
</style>
<div class="page">
  <table>
    <tr>
      <td style="width: 50%;">
        <div class="form-row">
          <div class="form-label">ISSUER'S name, street address, city or town, state or province, country, and ZIP or foreign postal code</div>
