<!DOCTYPE html>
<html>
<head>
    <title>IRS Form 8849 Schedule C</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 15px; }
        td, th { padding: 5px; text-align: left; }
        .header-row td { font-weight: bold; }
        .section-title { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
        .instruction-text { font-size: 0.9em; line-height: 1.4; }
    </style>
</head>
<body>
    <div class="page">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px;">
            <div>
                <h1 style="font-size: 18pt; margin: 0;">Schedule 5</h1>
                <p style="font-size: 12pt; margin: 0;">(Form 8849)</p>
            </div>
            <div style="text-align: right;">
                <p style="font-size: 10pt; margin: 0;">OMB No. 15-1420</p>
            </div>
        </div>

        <div style="margin-bottom: 30px;">
            <p style="font-size: 12pt;">Department of the Treasury—Internal Revenue Service</p>
            <p style="font-size: 12pt;">Section 4081(e) Claims</p>
            <p style="font-size: 10pt;">(Rev. January 2003)</p>
            <p style="font-size: 10pt;">Attach to Form 8849. Do not file with any other schedule.</p>
        </div>

        <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
            <div style="width: 45%;">
                <label for="name">Name as shown on Form 8849:</label>
                <span data-field="full_name" style="display: block; border-bottom: 1px solid #000; padding-bottom: 2px;">{{ full_name }}</span>
            </div>
            <div style="width: 45%; text-align: right;">
                <label for="ein">EIN:</label>
                <span data-field="ein" style="display: block; border-bottom: 1px solid #000; padding-bottom: 2px;">{{ ein }}</span>
            </div>
        </div>

        <div style="margin-bottom: 20px;">
            <label>Claimant's registration number:</label>
            <span data-field="claimant_registration_number" style="display: inline-block; border-bottom: 1px solid #000; padding-bottom: 2px;">{{ claimant_registration_number }}</span>
        </div>

        <h2 class="section-title">Part I</h2>
        <p style="font-size: 12pt; margin-top: 0;">Claim for Refund of Second Tax</p>

        <table style="margin-top: 15px;">
            <thead>
                <tr class="header-row">
                    <th style="width: 20%;">Type of fuel</th>
                    <th style="width: 30%; text-align: right;">(a) Amount of refund</th>
                    <th style="width: 20%; text-align: right;">(b) CRN</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>1 Gasoline</td>
                    <td style="text-align: right;"><span data-field="part1_fuel_amount_1">{{ part1_fuel_amount_1 }}</span></td>
                    <td style="text-align: right;"><span data-field="part1_crn_1">{{ part1_crn_1 }}</span></td>
                </tr>
                <tr>
                    <td>2 10% gasohol</td>
                    <td style="text-align: right;"><span data-field="part1_fuel_amount_2">{{ part1_fuel_amount_2 }}</span></td>
                    <td style="text-align: right;"><span data-field="part1_crn_2">{{ part1_crn_2 }}</span></td>
                </tr>
                <tr>
                    <td>3 7.7% gasohol</td>
                    <td style="text-align: right;"><span data-field="part1_fuel_amount_3">{{ part1_fuel_amount_3 }}</span></td>
                    <td style="text-align: right;"><span data-field="part1_crn_3">{{ part1_crn_3 }}</span></td>
                </tr>
                <tr>
                    <td>4 5.7% gasohol</td>
                    <td style="text-align: right;"><span data-field="part1_fuel_amount_4">{{ part1_fuel_amount_4 }}</span></td>
                    <td style="text-align: right;"><span data-field="part1_crn_4">{{ part1_crn_4 }}</span></td>
                </tr>
                <tr>
                    <td>5 Aviation gasoline</td>
                    <td style="text-align: right;"><span data-field="part1_fuel_amount_5">{{ part1_fuel_amount_5 }}</span></td>
                    <td style="text-align: right;"><span data-field="part1_crn_5">{{ part1_crn_5 }}</span></td>
                </tr>
                <tr>
                    <td>6 Diesel fuel</td>
                    <td style="text-align: right;"><span data-field="part1_fuel_amount_6">{{ part1_fuel_amount_6 }}</span></td>
                    <td style="text-align: right;"><span data-field="part1_crn_6">{{ part1_crn_6 }}</span></td>
                </tr>
                <tr>
                    <td>7 Kerosene</td>
                    <td style="text-align: right;"><span data-field="part1_fuel_amount_7">{{ part1_fuel_amount_7 }}</span></td>
                    <td style="text-align: right;"><span data-field="part1_crn_7">{{ part1_crn_7 }}</span></td>
                </tr>
            </tbody>
        </table>

        <h2 class="section-title">Part II</h2>
        <p class="instruction-text">Supporting Information Required. See instructions. If more space is needed, attach separate sheets.</p>

        <table style="margin-top: 15px;">
            <thead>
                <tr class="header-row">
                    <th style="width: 15%;"> (c) Type of fuel (Enter line number from Part I)</th>
                    <th style="width: 25%;"> (d) Date second tax liability incurred (Use MM/DD/YYYY format)</th>
                    <th style="width: 30%;"> (e) Gallons of fuel claimed</th>
                    <th style="width: 30%;"> (f) Amount of second tax paid</th>
                </tr>
            </thead>
            <tbody>
                {% for i in range(1, 15) %}
                <tr>
                    <td><span data-field="part2_fuel_type_line_number_{{ i }}">{{ i }}</span></td>
                    <td><span data-field="part2_date_incurred_{{ i }}">{{ part2_date_incurred_{{ i }} }}</span></td>
                    <td><span data-field="part2_gallons_claimed_{{ i }}">{{ part2_gallons_claimed_{{ i }} }}</span></td>
                    <td><span data-field="part2_tax_paid_{{ i }}">{{ part2_tax_paid_{{ i }} }}</span></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>

        <div style="margin-top: 50px; font-size: 10pt;">
            <p style="margin-bottom: 10px;">For Privacy Act and Paperwork Reduction Act Notice, see Form 8849 instructions. Cat. No. 274538 Schedule 5 (Form 8849) (Rev. 1-2003)</p>
        </div>
    </div>
</body>
</html>