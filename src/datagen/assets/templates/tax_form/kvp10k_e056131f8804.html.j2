<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; /* Defaulting to serif for document feel */
  }
  .page:last-child { page-break-after: auto; }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 15px;
  }
  td, th {
    padding: 8px 10px;
    text-align: left;
  }
  .form-row {
    display: flex;
    align-items: center;
    margin-bottom: 5px;
  }
  .label-col {
    width: 20%;
    font-weight: bold;
  }
  .input-col {
    width: 80%;
  }
  .header-cell {
    text-align: center;
    font-weight: bold;
  }
</style>

<div class="page">
  <header style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px;">
    <div>
      <h1 style="font-size: 18pt; margin: 0;">SCHEDULE A</h1>
      <h2 style="font-size: 14pt; margin: 0;">(Form 8995-A)</h2>
    </div>
    <div style="text-align: right;">
      <div style="font-size: 10pt;">OMB No. 1543-023</div>
      <div style="font-size: 10pt;">2019</div>
      <div style="font-size: 10pt;">Annual</div>
      <div style="font-size: 10pt;">Sequence No. 55B</div>
    </div>
  </header>

  <div style="margin-bottom: 20px;">
    <p style="font-size: 10pt;">Department of the Treasury</p>
    <p style="font-size: 10pt;">Internal Revenue Service</p>
  </div>

  <div style="margin-bottom: 30px;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
      <div style="font-size: 10pt;">Name(s) shown on return:</div>
      <div style="font-size: 10pt;">Your taxpayer identification number</div>
    </div>
    <div style="margin-top: 5px;">
      <span data-field="full_name" style="border-bottom: 1px solid #000; display: inline-block; min-width: 300px;">{{ full_name }}</span>
    </div>
  </div>

  <div style="margin-bottom: 30px; font-size: 10pt;">
    <p>Complete Schedule A only if your trade or business is a specified service trade or business (see instructions) and your taxable income is more than <span data-field="threshold_amount_1">{{ threshold_amount_1 }}</span>. If your taxable income is less than <span data-field="threshold_amount_1">{{ threshold_amount_1 }}</span>, you do not need to complete this schedule. If you have more than one trade or business, attach as many Schedules A as needed. See instructions.</p>
    <p style="margin-top: 10px;">Go to <a href="#" style="color: #000;">www.irs.gov/Forms/8995A</a> for instructions and the latest information.</p>
  </div>

  <h3 style="font-size: 12pt; margin-bottom: 10px;">Part I Other Than Publicly Traded Partnerships (PTP)</h3>

  <table style="margin-top: 15px;">
    <thead>
      <tr>
        <th style="width: 5%; text-align: center;">Part</th>
        <th style="width: 55%; text-align: left;">Other Than Publicly Traded Partnerships (PTP)</th>
        <th style="width: 10%; text-align: center;">A</th>
        <th style="width: 10%; text-align: center;">B</th>
        <th style="width: 10%; text-align: center;">C</th>
      </tr>
    </thead>
    <tbody>
      <!-- Line 1a -->
      <tr>
        <td style="text-align: center;">1a</td>
        <td>Trade or business name</td>
        <td><span data-field="trade_name_1a" style="display: block; border-bottom: 1px solid #000;">{{ trade_name_1a }}</span></td>
        <td></td>
        <td></td>
      </tr>
      <!-- Line 1b -->
      <tr>
        <td style="text-align: center;">1b</td>
        <td>Taxpayer identification number</td>
        <td><span data-field="tin_1b" style="display: block; border-bottom: 1px solid #000;">{{ tin_1b }}</span></td>
        <td></td>
        <td></td>
      </tr>
      <!-- Line 2 -->
      <tr>
        <td style="text-align: center;">2</td>
        <td>Qualified business income or (loss) from the trade or business</td>
        <td><span data-field="qb_income_2" style="display: block; border-bottom: 1px solid #000;">{{ qb_income_2 }}</span></td>
        <td></td>
        <td></td>
      </tr>
      <!-- Line 3 -->
      <tr>
        <td style="text-align: center;">3</td>
        <td>Allocable share of W-2 wages from the trade or business</td>
        <td><span data-field="w2_wages_3" style="display: block; border-bottom: 1px solid #000;">{{ w2_wages_3 }}</span></td>
        <td></td>
        <td></td>
      </tr>
      <!-- Line 4 -->
      <tr>
        <td style="text-align: center;">4</td>
        <td>Allocable share of the unadjusted basis immediately after acquisition (UBIA) of all qualified property</td>
        <td><span data-field="ubia_4" style="display: block; border-bottom: 1px solid #000;">{{ ubia_4 }}</span></td>
        <td></td>
        <td></td>
      </tr>
      <!-- Line 5 -->
      <tr>
        <td style="text-align: center;">5</td>
        <td>Taxable income before qualified business income deduction</td>
        <td><span data-field="taxable_income_5" style="display: block; border-bottom: 1px solid #000;">{{ taxable_income_5 }}</span></td>
        <td></td>
        <td></td>
      </tr>
      <!-- Line 6 -->
      <tr>
        <td style="text-align: center;">6</td>
        <td>Threshold. Enter <span data-field="threshold_amount_6">{{ threshold_amount_6 }}</span> ($160,700 ($160,725 if married filing separately); $321,400 if married filing jointly)</td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
      <!-- Line 7 -->
      <tr>
        <td style="text-align: center;">7</td>
        <td>Subtract line 6 from line 5</td>
        <td><span data-field="subtraction_7" style="display: block; border-bottom: 1px solid #000;">{{ subtraction_7 }}</span></td>
        <td></td>
        <td></td>
      </tr>
      <!-- Line 8 -->
      <tr>
        <td style="text-align: center;">8</td>
        <td>Phase-in range. Enter <span data-field="phase_in_amount_8">{{ phase_in_amount_8 }}</span> ($50,000 ($100,000 if married filing jointly))</td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
      <!-- Line 9 -->
      <tr>
        <td style="text-align: center;">9</td>
        <td>Divide line 7 by line 8</td>
        <td><span data-field="division_9" style="display: block; border-bottom: 1px solid #000;">{{ division_9 }}</span></td>
        <td></td>
        <td></td>
      </tr>
      <!-- Line 10 -->
      <tr>
        <td style="text-align: center;">10</td>
        <td>Applicable percentage. Subtract line 9 from 100%</td>
        <td><span data-field="percentage_10" style="display: block; border-bottom: 1px solid #000;">{{ percentage_10 }}</span></td>
        <td></td>
        <td></td>
      </tr>
      <!-- Line 11 -->
      <tr>
        <td style="text-align: center;">11</td>
        <td>Applicable percentage of qualified business income or (loss). Multiply line 2 by line 10. Enter this amount on Schedule C (Form 8995-A) or on Form 8995-A, line 2, for the corresponding trade or business, as appropriate. See instructions</td>
        <td><span data-field="applicable_percentage_11" style="display: block; border-bottom: 1px solid #000;">{{ applicable_percentage_11 }}</span></td>
        <td></td>
        <td></td>
      </tr>
      <!-- Line 12 -->
      <tr>
        <td style="text-align: center;">12</td>
        <td>Applicable percentage of W-2 wages. Multiply line 3 by line 10. Enter this amount on Form 8995-A, line 4, for the corresponding trade or business, as appropriate. See instructions</td>
        <td><span data-field="applicable_percentage_12" style="display: block; border-bottom: 1px solid #000;">{{ applicable_percentage_12 }}</span></td>
        <td></td>
        <td></td>
      </tr>
      <!-- Line 13 -->
      <tr>
        <td style="text-align: center;">13</td>
        <td>Applicable percentage of the UBIA of qualified property. Multiply line 4 by line 10. Enter this amount on Form 8995-A, line 7, for the corresponding trade or business, as appropriate. See instructions</td>
        <td><span data-field="applicable_percentage_13" style="display: block; border-bottom: 1px solid #000;">{{ applicable_percentage_13 }}</span></td>
        <td></td>
        <td></td>
      </tr>
    </tbody>
  </table>

  <h3 style="font-size: 12pt; margin-top: 30px; margin-bottom: 10px;">Part II Publicly Traded Partnership</h3>

  <table style="margin-top: 15px;">
    <thead>
      <tr>
        <th style="width: 5%; text-align: center;">Part</th>
        <th style="width: 55%; text-align: left;">Publicly Traded Partnership</th>
        <th style="width: 10%; text-align: center;">A</th>
        <th style="width: 10%; text-align: center;">B</th>
        <th style="width: 10%; text-align: center;">C</th>
      </tr>
    </thead>
    <tbody>
      <!-- Line 14 -->
      <tr>
        <td style="text-align: center;">14</td>
        <td>Trade or business name</td>
        <td><span data-field="trade_name_14" style="display: block; border-bottom: 1px solid #000;">{{ trade_name_14 }}</span></td>
        <td></td>
        <td></td>
      </tr>
      <!-- Line 15 -->
      <tr>
        <td style="text-align: center;">15</td>
        <td>Taxpayer identification number</td>
        <td><span data-field="tin_15" style="display: block; border-bottom: 1px solid #000;">{{ tin_15 }}</span></td>
        <td></td>
        <td></td>
      </tr>
      <!-- Line 16 -->
      <tr>
        <td style="text-align: center;">16</td>
        <td>Qualified PTP income or (loss)</td>
        <td><span data-field="ptp_income_16" style="display: block; border-bottom: 1px solid #000;">{{ ptp_income_16 }}</span></td>
        <td></td>
        <td></td>
      </tr>
      <!-- Line 17 -->
      <tr>
        <td style="text-align: center;">17</td>
        <td>Total PTP specified service trade or business (SSTB) income or (loss). Combine all amounts on line 16</td>
        <td><span data-field="total_ptp_income_17" style="display: block; border-bottom: 1px solid #000;">{{ total_ptp_income_17 }}</span></td>
        <td></td>
        <td></td>
      </tr>
      <!-- Line 18 -->
      <tr>
        <td style="text-align: center;">18</td>
        <td>Taxable income before qualified business income deduction</td>
        <td><span data-field="taxable_income_18" style="display: block; border-bottom: 1px solid #000;">{{ taxable_income_18 }}</span></td>
        <td></td>
        <td></td>
      </tr>
      <!-- Line 19 -->
      <tr>
        <td style="text-align: center;">19</td>
        <td>Threshold. Enter <span data-field="threshold_amount_19">{{ threshold_amount_19 }}</span> ($160,700 ($160,725 if married filing separately); $321,400 if married filing jointly)</td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
      <!-- Line 20 -->
      <tr>
        <td style="text-align: center;">20</td>
        <td>Subtract line 19 from line 18</td>
        <td><span data-field="subtraction_20" style="display: block; border-bottom: 1px solid #000;">{{ subtraction_20 }}</span></td>
        <td></td>
        <td></td>
      </tr>
      <!-- Line 21 -->
      <tr>
        <td style="text-align: center;">21</td>
        <td>Phase-in range. Enter <span data-field="phase_in_amount_21">{{ phase_in_amount_21 }}</span> ($50,000 ($100,000 if married filing jointly))</td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
      <!-- Line 22 -->
      <tr>
        <td style="text-align: center;">22</td>
        <td>Divide line 20 by line 21</td>
        <td><span data-field="division_22" style="display: block; border-bottom: 1px solid #000;">{{ division_22 }}</span></td>
        <td></td>
        <td></td>
      </tr>
      <!-- Line 23 -->
      <tr>
        <td style="text-align: center;">23</td>
        <td>Applicable percentage. Subtract line 22 from 100%</td>
        <td><span data-field="percentage_23" style="display: block; border-bottom: 1px solid #000;">{{ percentage_23 }}</span></td>
        <td></td>
        <td><span data-field="percent_symbol_23">{{ percent_symbol_23 }}</span></td>
      </tr>
      <!-- Line 24 -->
      <tr>
        <td style="text-align: center;">24</td>
        <td>Applicable percentage of qualified PTP income or (loss). Multiply line 17 by line 23. Include this amount on Form 8995-A, line 28</td>
        <td><span data-field="applicable_percentage_24" style="display: block; border-bottom: 1px solid #000;">{{ applicable_percentage_24 }}</span></td>
        <td></td>
        <td></td>
      </tr>
    </tbody>
  </table>

  <footer style="margin-top: 50px; font-size: 9pt; display: flex; justify-content: space-between;">
    <p>For Privacy Act and Paperwork Reduction Act Notice, see separate instructions.</p>
    <p>Cat. No. 72681D Schedule A (Form 8995-A) 2019</p>
  </footer>
</div>