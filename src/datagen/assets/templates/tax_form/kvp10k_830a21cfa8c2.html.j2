<!DOCTYPE html>
<html>
<head>
    <title>Form 1040-NR-EZ</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        .form-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px; }
        .form-title { font-size: 18pt; font-weight: bold; }
        .section-header { font-size: 12pt; font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
        .line-item-row { display: flex; margin-bottom: 5px; }
        .label { width: 200px; font-size: 10pt; }
        .input-area { flex-grow: 1; }
        .grid-container { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 20px; }
        .grid-item { display: flex; align-items: center; }
        .checkbox-group label { margin-right: 15px; font-size: 10pt; }
        .signature-block { display: flex; justify-content: space-between; margin-top: 40px; }
        .signature-box { width: 45%; border-top: 1px solid #000; padding-top: 5px; font-size: 10pt; }
        .table-header { font-weight: bold; border-bottom: 1px solid #000; padding: 5px 0; }
        .table-row { display: flex; border-bottom: 1px solid #000; }
        .table-cell { flex: 1; padding: 5px; border-right: 1px solid #000; }
        .table-cell:last-child { border-right: none; }
    </style>
</head>
<body>

<div class="page">
    <div class="form-header">
        <div>
            <div class="form-title">Form 1040-NR-EZ</div>
            <div style="font-size: 10pt;">Department of the Treasury</div>
            <div style="font-size: 10pt;">Internal Revenue Service</div>
        </div>
        <div>
            <div style="font-size: 12pt; font-weight: bold;">OMB No. 1545-0074</div>
            <div style="font-size: 20pt; font-weight: bold;">2019</div>
        </div>
    </div>

    <p style="font-size: 10pt;">
        <span style="font-weight: bold;">►</span> Go to <a href="#" style="text-decoration: underline;">irs.gov/Form1040NREZ</a> for instructions and the latest information.
    </p>

    <div style="margin-top: 20px;">
        <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
            <div style="width: 45%;">
                <label style="font-size: 10pt;">Your first name and middle initial</label><br>
                <span data-field="full_name_first_name" style="border-bottom: 1px solid #000; display: inline-block; width: 300px;">{{ full_name_first_name }}</span>
                <label style="font-size: 10pt;">Last name</label><br>
                <span data-field="full_name_last_name" style="border-bottom: 1px solid #000; display: inline-block; width: 300px;">{{ full_name_last_name }}</span>
            </div>
            <div style="width: 45%; text-align: right;">
                <label style="font-size: 10pt;">Identifying number (see instructions)</label><br>
                <span data-field="identification_number" style="border-bottom: 1px solid #000; display: inline-block; width: 300px;">{{ identification_number }}</span>
            </div>
        </div>

        <div style="margin-top: 20px;">
            <label style="font-size: 10pt;">Please print or type. See separate instructions.</label>
            <div style="margin-top: 10px;">
                <label style="font-size: 10pt;">Foreign country name</label>
                <span data-field="foreign_country_name" style="border-bottom: 1px solid #000; display: inline-block; width: 300px;">{{ foreign_country_name }}</span>
                <label style="font-size: 10pt;">Foreign province/state/country</label>
                <span data-field="foreign_province_state_country" style="border-bottom: 1px solid #000; display: inline-block; width: 300px;">{{ foreign_province_state_country }}</span>
                <label style="font-size: 10pt;">Foreign postal code</label>
                <span data-field="foreign_postal_code" style="border-bottom: 1px solid #000; display: inline-block; width: 300px;">{{ foreign_postal_code }}</span>
            </div>
        </div>
    </div>

    <div class="section-header">Filing Status</div>
    <div style="display: flex; align-items: center; margin-bottom: 15px;">
        <div style="width: 150px;">1. Single nonresident alien</div>
        <div style="flex-grow: 1; text-align: center;">
            <input type="radio" name="filing_status" value="single" style="margin-right: 5px;">
            <label>2. Married nonresident alien</label>
        </div>
        <div style="width: 50px;"></div>
    </div>

    <div class="section-header">Attach Form(s)</div>
    <div style="display: flex; align-items: center; margin-bottom: 15px;">
        <div style="width: 150px;">Attach Form(s) W-2 or other.</div>
        <div style="flex-grow: 1;">
            <div class="line-item-row">
                <div class="label" style="width: 100px;">3. Wages, salaries, tips, etc. Attach Form(s) W-2</div>
                <div class="input-area" style="width: 100px;">3</div>
                <div class="input-area" style="width: 100px;">4</div>
                <div class="input-area" style="width: 100px;">5</div>
            </div>
            <div class="line-item-row">
                <div class="label" style="width: 100px;">4. Taxable refunds, credits, or offsets of state and local income taxes</div>
                <div class="input-area" style="width: 100px;">4</div>
                <div class="input-area" style="width: 100px;">5</div>
                <div class="input-area" style="width: 100px;">6</div>
            </div>
            <div class="line-item-row">
                <div class="label" style="width: 100px;">5. Scholarship and fellowship grants. Attach Form(s) 1042-S or required statement.</div>
                <div class="input-area" style="width: 100px;">4</div>
                <div class="input-area" style="width: 100px;">5</div>
                <div class="input-area" style="width: 100px;">6</div>
            </div>
            <div class="line-item-row">
                <div class="label" style="width: 100px;">6. Total income exempt by a treaty from page 2, Item I(j)(E)</div>
                <div class="input-area" style="width: 100px;">6</div>
                <div class="input-area" style="width: 100px;">7</div>
                <div class="input-area" style="width: 100px;"></div>
            </div>
            <div class="line-item-row">
                <div class="label" style="width: 100px;">7. Add lines 3, 4, and 5</div>
                <div class="input-area" style="width: 100px;">7</div>
                <div class="input-area" style="width: 100px;">8</div>
                <div class="input-area" style="width: 100px;"></div>
            </div>
            <div class="line-item-row">
                <div class="label" style="width: 100px;">8. Scholarship and fellowship grants excluded</div>
                <div class="input-area" style="width: 100px;">8</div>
                <div class="input-area" style="width: 100px;">9</div>
                <div class="input-area" style="width: 100px;"></div>
            </div>
            <div class="line-item-row">
                <div class="label" style="width: 100px;">9. Student loan interest deduction</div>
                <div class="input-area" style="width: 100px;">9</div>
                <div class="input-area" style="width: 100px;">10</div>
                <div class="input-area" style="width: 100px;"></div>
            </div>
            <div class="line-item-row">
                <div class="label" style="width: 100px;">10. Itemized deductions. See the instructions for limitation</div>
                <div class="input-area" style="width: 100px;">11</div>
                <div class="input-area" style="width: 100px;">11</div>
                <div class="input-area" style="width: 100px;"></div>
            </div>
            <div class="line-item-row">
                <div class="label" style="width: 100px;">11. Reserved.</div>
                <div class="input-area" style="width: 100px;">12</div>
                <div class="input-area" style="width: 100px;">12</div>
                <div class="input-area" style="width: 100px;"></div>
            </div>
            <div class="line-item-row">
                <div class="label" style="width: 100px;">12. Taxable income. Subtract line 11 from line 10. If line 11 is more than line 10, enter 0-</div>
                <div class="input-area" style="width: 100px;">14</div>
                <div class="input-area" style="width: 100px;">15</div>
                <div class="input-area" style="width: 100px;"></div>
            </div>
            <div class="line-item-row">
                <div class="label" style="width: 100px;">13. Tax. Find your tax in the tax tables in the instructions</div>
                <div class="input-area" style="width: 100px;">14</div>
                <div class="input-area" style="width: 100px;">15</div>
                <div class="input-area" style="width: 100px;"></div>
            </div>
            <div class="line-item-row">
                <div class="label" style="width: 100px;">14a. Federal income tax withheld from Form(s) W-2 and 1099-R</div>
                <div class="input-area" style="width: 100px;">18a</div>
                <div class="input-area" style="width: 100px;">18b</div>
                <div class="input-area" style="width: 100px;"></div>
            </div>
            <div class="line-item-row">
                <div class="label" style="width: 100px;">14b. Federal income tax withheld from Form(s) 1042-S</div>
                <div class="input-area" style="width: 100px;">18b</div>
                <div class="input-area" style="width: 100px;">19</div>
                <div class="input-area" style="width: 100px;"></div>
            </div>
            <div class="line-item-row">
                <div class="label" style="width: 100px;">19. 2019 estimated tax payments and amount applied from 2018 return</div>
                <div class="input-area" style="width: 100px;">20</div>
                <div class="input-area" style="width: 100px;">21</div>
                <div class="input-area" style="width: 100px;"></div>
            </div>
            <div class="line-item-row">
                <div class="label" style="width: 100px;">20. Credit for amount paid with Form 1040-C</div>
                <div class="input-area" style="width: 100px;">20</div>
                <div class="input-area" style="width: 100px;">21</div>
                <div class="input-area" style="width: 100px;"></div>
            </div>
            <div class="line-item-row">
                <div class="label" style="width: 100px;">21. Add lines 18a through 20. These are your total payments</div>
                <div class="input-area" style="width: 100px;">21</div>
                <div class="input-area" style="width: 100px;">22</div>
                <div class="input-area" style="width: 100px;"></div>
            </div>
        </div>
    </div>

    <div class="section-header">Refund</div>
    <div style="display: flex; align-items: center; margin-bottom: 15px;">
        <div style="width: 150px;">22. If line 21 is more than line 17, subtract line 17 from line 21. This is the amount you overpaid</div>
        <div style="flex-grow: 1;">
            <div class="line-item-row">
                <div class="label" style="width: 100px;">23a. Amount of line 22 you want refunded to you. If Form 10488 is attached, check here ►</div>
                <div class="input-area" style="width: 100px;">23a</div>
            </div>
            <div class="line-item-row">
                <div class="label" style="width: 100px;">b Routing number</div>
                <div class="input-area" style="width: 100px;"></div>
                <div class="input-area" style="width: 100px;">c Type <span data-field="routing_type">{{ routing_type }}</span> Checking <span data-field="routing_type_2">{{ routing_type_2 }}</span> Savings</div>
            </div>
            <div class="line-item-row">
                <div class="label" style="width: 100px;">d Account number</div>
                <div class="input-area" style="width: 100px;"></div>
            </div>
            <div class="line-item-row">
                <div class="label" style="width: 100px;">e If you want your refund checked mail to an address outside the United States not shown above, enter that address here:</div>
                <div class="input-area" style="width: 100px;"></div>
            </div>
        </div>
    </div>

    <div class="section-header">Amount You Owe</div>
    <div style="display: flex; align-items: center; margin-bottom: 15px;">
        <div style="width: 150px;">24. Amount of line 22 you want applied to your 2020 estimated tax ►</div>
        <div style="flex-grow: 1;">
            <div class="line-item-row">
                <div class="label" style="width: 100px;">25. Amount you owe. Subtract line 21 from line 17. Or details on how to pay, see instructions ►</div>
                <div class="input-area" style="width: 100px;">25</div>
            </div>
            <div class="line-item-row">
                <div class="label" style="width: 100px;">26. Estimated tax penalty (see instructions)</div>
                <div class="input-area" style="width: 100px;">26</div>
            </div>
        </div>
    </div>

    <div class="section-header">Third Party Designee</div>
    <div style="display: flex; align-items: flex-start; margin-bottom: 20px;">
        <div style="width: 200px;">
            <label style="font-size: 10pt;">Do you want to allow another person to discuss this return with the IRS? See instructions.</label>
            <div style="margin-top: 10px;">
                <label style="font-size: 10pt;">No</label>
                <input type="checkbox" style="margin-left: 5px;">
                <label style="font-size: 10pt;">Yes</label>
                <input type="checkbox" style="margin-left: 5px;">
            </div>
        </div>
        <div style="flex-grow: 1;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                <div style="width: 30%;">
                    <label style="font-size: 10pt;">Designee's name</label><br>
                    <span data-field="third_party_designee_name" style="border-bottom: 1px solid #000; display: inline-block; width: 250px;">{{ third_party_designee_name }}</span>
                </div>
                <div style="width: 30%;">
                    <label style="font-size: 10pt;">Phone no.</label><br>
                    <span data-field="third_party_designee_phone" style="border-bottom: 1px solid #000; display: inline-block; width: 250px;">{{ third_party_designee_phone }}</span>
                </div>
                <div style="width: 30%;">
                    <label style="font-size: 10pt;">Personal identification number (PIN)</label><br>
                    <span data-field="third_party_designee_pin" style="border-bottom: 1px solid #000; display: inline-block; width: 250px;">{{ third_party_designee_pin }}</span>
                </div>
            </div>
        </div>
    </div>

    <div class="section-header">Sign Here</div>
    <div style="margin-bottom: 20px;">
        <p style="font-size: 10pt;">Under penalties of perjury, I declare that I have examined this return and accompanying schedules and statements, and to the best of my knowledge and belief, the information contained herein is true, correct, and complete. I received during the tax year. Declaration of</p>
    </div>

    <div class="signature-block">
        <div style="width: 45%;">
            <label style="font-size: 10pt;">Print/Type preparer's name</label><br>
            <span data-field="preparer_name" style="border-bottom: 1px solid #000; display: inline-block; width: 300px;">{{ preparer_name }}</span>
            <label style="font-size: 10pt;">Preparer's signature</label><br>
            <span data-field="preparer_signature" style="border-bottom: 1px solid #000; display: inline-block; width: 300px;">{{ preparer_signature }}</span>
            <label style="font-size: 10pt;">Date</label><br>
            <span data-field="preparer_date" style="border-bottom: 1px solid #000; display: inline-block; width: 300px;">{{ preparer_date }}</span>
        </div>
        <div style="width: 45%;">
            <label style="font-size: 10pt;">Your signature</label><br>
            <span data-field="filer_signature" style="border-bottom: 1px solid #000; display: inline-block; width: 300px;">{{ filer_signature }}</span>
            <label style="font-size: 10pt;">Date</label><br>
            <span data-field="filer_date" style="border-bottom: 1px solid #000; display: inline-block; width: 300px;">{{ filer_date }}</span>
            <div style="margin-top: 20px;">
                <label style="font-size: 10pt;">Your occupation in the United States</label><br>
                <span data-field="filer_occupation" style="border-bottom: 1px solid #000; display: inline-block; width: 300px;">{{ filer_occupation }}</span>
            </div>
        </div>
    </div>

    <div style="margin-top: 40px; font-size: 9pt;">
        <label style="font-size: 10pt;">Keep a copy of this return for your records.</label>
    </div>

    <div style="display: flex; justify-content: space-between; margin-top: 30px;">
        <div style="width: 45%;">
            <label style="font-size: 10pt;">Paid Preparer Use Only</label>
            <div style="display: flex; justify-content: space-between; margin-top: 10px;">
                <div style="width: 30%;">
                    <label style="font-size: 10pt;">Firm's name</label><br>
                    <span data-field="paid_preparer_firm_name" style="border-bottom: 1px solid #000; display: inline-block; width: 250px;">{{ paid_preparer_firm_name }}</span>
                </div>
                <div style="width: 30%;">
                    <label style="font-size: 10pt;">Firm's EIN</label><br>
                    <span data-field="paid_preparer_ein" style="border-bottom: 1px solid #000; display: inline-block; width: 250px;">{{ paid_preparer_ein }}</span>
                </div>
            </div>
            <div style="display: flex; justify-content: space-between; margin-top: 10px;">
                <div style="width: 30%;">
                    <label style="font-size: 10pt;">Firm's address</label><br>
                    <span data-field="paid_preparer_address" style="border-bottom: 1px solid #000; display: inline-block; width: 250px;">{{ paid_preparer_address }}</span>
                </div>
                <div style="width: 30%;">
                    <label style="font-size: 10pt;">Phone no.</label><br>
                    <span data-field="paid_preparer_phone" style="border-bottom: 1px solid #000; display: inline-block; width: 250px;">{{ paid_preparer_phone }}</span>
                </div>
            </div>
        </div>
        <div style="width: 45%; text-align: right;">
            <div style="font-size: 9pt;">For Disclosure, Privacy Act, and Paperwork Reduction Act Notice, see instructions.</div>
            <div style="margin-top: 10px;">
                <span data-field="form_id" style="font-weight: bold;">{{ form_id }}</span> (2019)
            </div>
        </div>
    </div>
</div>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
        <div style="font-size: 12pt; font-weight: bold;">Schedule OI—Other Information (see instructions)</div>
        <div style="font-size: 10pt;">Page 2</div>
    </div>

    <div class="section-header">Answer all questions</div>

    <div style="margin-top: 20px;">
        <div style="display: flex; align-items: center; margin-bottom: 15px;">
            <div style="width: 10px;">A</div>
            <div style="flex-grow: 1;">
                <label style="font-size: 10pt;">Of what country or countries were you a citizen or national during the tax year?</label>
            </div>
        </div>
    </div>

    <div style="margin-top: 20px;">
        <div style="display: flex; align-items: center; margin-bottom: 15px;">
            <div style="width: 10px;">B</div>
            <div style="flex-grow: 1;">
                <label style="font-size: 10pt;">In what country did you claim residence for tax purposes during the tax year?</label>
            </div>
        </div>
    </div>

    <div style="margin-top: 20px;">
        <div style="display: flex; align-items: center; margin-bottom: 15px;">
            <div style="width: 10px;">C</div>
            <div style="flex-grow: 1;">
                <label style="font-size: 10pt;">Have you ever applied to be a green card holder (lawful permanent resident) of the United States?</label>
            </div>
            <div class="checkbox-group" style="margin-left: 20px;">
                <label><input type="checkbox"> Yes</label>
                <label><input type="checkbox"> No</label>
            </div>
        </div>
    </div>

    <div style="margin-top: 20px;">
        <div style="display: flex; align-items: center; margin-bottom: 15px;">
            <div style="width: 10px;">D</div>
            <div style="flex-grow: 1;">
                <label style="font-size: 10pt;">Were you ever:</label>
            </div>
            <div style="margin-left: 20px;">
                <div style="display: flex; align-items: center; margin-bottom: 5px;">
                    <label style="font-size: 10pt;"><input type="checkbox"> A U.S. citizen?</label>
                    <label style="font-size: 10pt;"><input type="checkbox"> No</label>
                </div>
                <div style="display: flex; align-items: center;">
                    <label style="font-size: 10pt;"><input type="checkbox"> A green card holder (lawful permanent resident) of the United States?</label>
                    <label style="font-size: 10pt;"><input type="checkbox"> No</label>
                </div>
            </div>
        </div>
        <div style="margin-top: 5px; font-size: 9pt;">
            If you answer "Yes" to (1) or (2), see Pub. 519, chapter 4, for expatriation rules that may apply to you.
        </div>
    </div>

    <div style="margin-top: 20px;">
        <div style="display: flex; align-items: center; margin-bottom: 15px;">
            <div style="width: 10px;">E</div>
            <div style="flex-grow: 1;">
                <label style="font-size: 10pt;">If you had a visa on the last day of the tax year, enter your visa type. If you did not have a visa, enter your U.S. immigration status on the last day of the tax year.</label>
            </div>
        </div>
    </div>

    <div style="margin-top: 20px;">
        <div style="display: flex; align-items: center; margin-bottom: 15px;">
            <div style="width: 10px;">F</div>
            <div style="flex-grow: 1;">
                <label style="font-size: 10pt;">Have you ever changed your visa type (nonimmigrant status) or U.S. immigration status?</label>
            </div>
            <div class="checkbox-group" style="margin-left: 20px;">
                <label><input type="checkbox"> Yes</label>
                <label><input type="checkbox"> No</label>
            </div>
        </div>
        <div style="margin-top: 5px; font-size: 9pt;">
            If "Yes", indicate the date and nature of the change. ►
        </div>
    </div>

    <div style="margin-top: 20px;">
        <div style="display: flex; align-items: center; margin-bottom: 15px;">
            <div style="width: 10px;">G</div>
            <div style="flex-grow: 1;">
                <label style="font-size: 10pt;">List all dates you entered and left the United States during 2019. See instructions.</label>
            </div>
        </div>
        <div style="margin-top: 10px;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                <div style="width: 30%;">
                    <label style="font-size: 10pt;">Date entered United States</label><br>
                    <span data-field="entry_date_us" style="border-bottom: 1px solid #000; display: inline-block; width: 150px;">{{ entry_date_us }}</span>
                </div>
                <div style="width: 30%;">
                    <label style="font-size: 10pt;">Date departed United States</label><br>
                    <span data-field="departure_date_us" style="border-bottom: 1px solid #000; display: inline-block; width: 150px;">{{ departure_date_us }}</span>
                </div>
                <div style="width: 30%;">
                    <label style="font-size: 10pt;">Date entered United States</label><br>
                    <span data-field="entry_date_us_2" style="border-bottom: 1px solid #000; display: inline-block; width: 150px;">{{ entry_date_us_2 }}</span>
                </div>
                <div style="width: 30%;">
                    <label style="font-size: 10pt;">Date departed United States</label><br>
                    <span data-field="departure_date_us_2" style="border-bottom: 1px solid #000; display: inline-block; width: 150px;">{{ departure_date_us_2 }}</span>
                </div>
            </div>
        </div>
        <div style="margin-top: 10px; font-size: 9pt;">
            If you are a resident of Canada or Mexico AND commute to work in the United States at frequent intervals, check the box for Canada or Mexico and skip to item H.
        </div>
    </div>

    <div style="margin-top: 20px;">
        <div style="display: flex; align-items: center; margin-bottom: 15px;">
            <div style="width: 10px;">H</div>
            <div style="flex-grow: 1;">
                <label style="font-size: 10pt;">Give number of days (including vacation, non-workdays, and partial days) you were present in the United States during: <span data-field="year_2017">{{ year_2017 }}</span>, <span data-field="year_2018">{{ year_2018 }}</span>, and <span data-field="year_2019">{{ year_2019 }}</span>.</label>
            </div>
        </div>
    </div>

    <div style="margin-top: 20px;">
        <div style="display: flex; align-items: center; margin-bottom: 15px;">
            <div style="width: 10px;">I</div>
            <div style="flex-grow: 1;">
                <label style="font-size: 10pt;">Did you file a U.S. income tax return for any prior year?</label>
            </div>
            <div class="checkbox-group" style="margin-left: 20px;">
                <label><input type="checkbox"> Yes</label>
                <label><input type="checkbox"> No</label>
            </div>
        </div>
        <div style="margin-top: 5px; font-size: 9pt;">
            If "Yes", give the latest year and form number you filed ►
        </div>
    </div>

    <div style="margin-top: 20px;">
        <div style="display: flex; align-items: center; margin-bottom: 15px;">
            <div style="width: 10px;">J</div>
            <div style="flex-grow: 1;">
                <label style="font-size: 10pt;">Income Exempt from Tax—If you are claiming exemption from income tax under a U.S. income tax treaty with a foreign country, complete (1) through (3) below. See Pub. 901 for more information on tax treaties.</label>
            </div>
        </div>
    </div>

    <div style="margin-top: 20px;">
        <div style="display: flex; align-items: center; margin-bottom: 15px;">
            <div style="width: 10px;">1.</div>
            <div style="flex-grow: 1;">
                <label style="font-size: 10pt;">Enter the name of the country, the applicable tax treaty article, the number of months in prior years you claimed the treaty benefit, and the amount of exempt income in the columns below. Attach Form 8833 if required. See instructions.</label>
            </div>
        </div>
    </div>

    <div style="margin-top: 10px;">
        <div style="display: flex; justify-content: space-between;">
            <div style="width: 25%;">
                <div class="table-header"> (a) Country </div>
                <div class="table-row"><div class="table-cell"><span data-field="treaty_country">{{ treaty_country }}</span></div></div>
            </div>
            <div style="width: 25%;">
                <div class="table-header"> (b) Tax treaty article </div>
                <div class="table-row"><div class="table-cell"><span data-field="treaty_article">{{ treaty_article }}</span></div></div>
            </div>
            <div style="width: 25%;">
                <div class="table-header"> (c) Number of months claimed in prior tax years </div>
                <div class="table-row"><div class="table-cell"><span data-field="treaty_months">{{ treaty_months }}</span></div></div>
            </div>
            <div style="width: 25%;">
                <div class="table-header"> (d) Amount of exempt income in current tax year </div>
                <div class="table-row"><div class="table-cell"><span data-field="treaty_exempt_amount">{{ treaty_exempt_amount }}</span></div></div>
            </div>
        </div>
    </div>

    <div style="margin-top: 20px;">
        <div style="display: flex; align-items: center; margin-bottom: 15px;">
            <div style="width: 10px;">2.</div>
            <div style="flex-grow: 1;">
                <label style="font-size: 10pt;">Were you subject to tax in a foreign country on any of the income shown in (1) above?</label>
            </div>
            <div class="checkbox-group" style="margin-left: 20px;">
                <label><input type="checkbox"> Yes</label>
                <label><input type="checkbox"> No</label>
            </div>
        </div>
    </div>

    <div style="margin-top: 20px;">
        <div style="display: flex; align-items: center; margin-bottom: 15px;">
            <div style="width: 10px;">3.</div>
            <div style="flex-grow: 1;">
                <label style="font-size: 10pt;">Are you claiming treaty benefits pursuant to a Competent Authority determination?</label>
            </div>
            <div class="checkbox-group" style="margin-left: 20px;">
                <label><input type="checkbox"> Yes</label>
                <label><input type="checkbox"> No</label>
            </div>
        </div>
        <div style="margin-top: 5px; font-size: 9pt;">
            If "Yes", attach a copy of the Competent Authority determination letter to your return.
        </div>
    </div>
</div>

</body>
</html>