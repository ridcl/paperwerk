<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  /* Basic styling to mimic document structure */
  .form-group {
    margin-bottom: 20px;
  }
  .input-field {
    border-bottom: 1px solid #000;
    display: inline-block;
    width: 100%;
    min-width: 200px;
    padding: 2px 0;
  }
  .section-title {
    font-weight: bold;
    margin-top: 30px;
    margin-bottom: 15px;
  }
</style>

<div class="page">
  <header style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px;">
    <div>
      <h1 style="font-size: 24pt; margin: 0;">Kenyon College</h1>
      <h2 style="font-size: 14pt; margin: 5px 0 0 0;">City of Mount Vernon Tax Form</h2>
    </div>
    <div style="text-align: right;">
      <!-- Placeholder for logo/seal -->
      <div style="width: 50px; height: 50px; border: 1px solid #ccc;"></div>
    </div>
  </header>

  <div class="form-group" style="display: flex; justify-content: space-between; margin-bottom: 30px;">
    <div style="width: 48%;">
      <label for="name">Name: Last, First, M.I.</label>
      <div style="border-bottom: 1px solid #000; margin-top: 2px;">
        <span data-field="full_name" style="display: block; height: 1em;">{{ full_name }}</span>
      </div>
    </div>
    <div style="width: 48%;">
      <label for="ssn">Social Security Number</label>
      <div style="border-bottom: 1px solid #000; margin-top: 2px;">
        <span data-field="social_security_number" style="display: block; height: 1em;">{{ social_security_number }}</span>
      </div>
    </div>
  </div>

  <div class="form-group">
    <label style="display: block; margin-bottom: 5px;">Current Home Address (If you are in the process of moving, please provide your address at this time, then provide an update to HR one your new address is established). List Street Address, P.O. Box if applicable, City, State, Zip.</label>
    <div style="border-bottom: 1px solid #000; margin-top: 2px;">
      <span data-field="home_address" style="display: block; height: 1.5em;">{{ home_address }}</span>
    </div>
  </div>

  <div class="section-title">Payroll Information: Mount Vernon City Taxes</div>

  <div class="form-group" style="margin-top: 20px;">
    <p>Please check your preference in box below.</p>
    <div style="margin-top: 10px;">
      <label style="display: block; margin-bottom: 5px;">
        <input type="radio" name="tax_preference" value="yes" style="margin-right: 5px;">
        Yes, Please Withhold Tax at 1% of my taxable gross earnings as required by the City of Mount Vernon for Income Tax.
      </label>
      <label style="display: block; margin-bottom: 5px;">
        <input type="radio" name="tax_preference" value="no" style="margin-right: 5px;">
        No, I do not wish to participate
      </label>
      <label style="display: block; margin-bottom: 5px;">
        <input type="radio" name="tax_preference" value="none" style="margin-right: 5px;">
        No, Mount Vernon City Income Taxes are not applicable to me as I do not live within Mount Vernon City Limits
      </label>
    </div>
  </div>

  <div class="form-group" style="margin-top: 40px;">
    <p>City of Mount Vernon, Division of Income Tax, Mount Vernon, Ohio: Employee's Withholding Certificate</p>
    <p>Under penalties of perjury, I declare that I have examined this certificate and to the best of my knowledge and believe, it is true, correct, and complete.</p>
  </div>

  <div class="form-group" style="display: flex; justify-content: space-between; margin-top: 40px;">
    <div style="width: 48%;">
      <label for="signature">Signature:</label>
      <div style="border-bottom: 1px solid #000; margin-top: 2px;">
        <span data-field="signature" style="display: block; height: 1em;">{{ signature }}</span>
      </div>
    </div>
    <div style="width: 48%;">
      <label for="date">Date:</label>
      <div style="border-bottom: 1px solid #000; margin-top: 2px;">
        <span data-field="date" style="display: block; height: 1em;">{{ date }}</span>
      </div>
    </div>
  </div>

  <div class="form-group" style="margin-top: 50px;">
    <p>If your software does not allow for signatures, please type your initials here</p>
    <div style="border-bottom: 1px solid #000; margin-top: 2px;">
      <span data-field="initials" style="display: block; height: 1em;">{{ initials }}</span>
    </div>
  </div>
</div>