<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
  }
  td {
    padding: 5px 0;
  }
  .header-row td {
    font-weight: bold;
  }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      <h1 style="font-size: 24pt; margin: 0;">Form 1094-B</h1>
      <p style="margin: 5px 0 0 0;">Department of the Treasury</p>
      <p style="margin: 0;">Internal Revenue Service</p>
    </div>
    <div style="text-align: right;">
      <p style="font-size: 10pt; margin: 0;">OMB No. 1545-2252</p>
      <div style="font-size: 24pt; font-weight: bold; margin-top: 5px;">{{ year }}</div>
    </div>
  </div>

  <div style="margin-top: 30px;">
    <p style="font-size: 14pt; font-weight: bold;">Transmittal of Health Coverage Information Returns</p>
    <p style="margin: 5px 0 20px 0;">
      <span style="font-weight: bold;">&gt;</span> Go to <a href="https://www.irs.gov/Form1094B" style="text-decoration: none; color: black;">www.irs.gov/Form1094B</a> for instructions and the latest information.
    </p>
  </div>

  <table style="width: 100%;">
    <tbody>
      <tr class="header-row">
        <td style="width: 10%;">1. <span data-field="filer_name">{{ filer_name }}</span></td>
        <td style="width: 20%;">2. <span data-field="employer_identification_number">{{ employer_identification_number }}</span></td>
      </tr>
      <tr>
        <td>3. <span data-field="person_name">{{ person_name }}</span></td>
        <td>4. <span data-field="contact_telephone_number">{{ contact_telephone_number }}</span></td>
      </tr>
      <tr>
        <td>5. <span data-field="street_address">{{ street_address }}</span></td>
        <td>6. <span data-field="city_or_town">{{ city_or_town }}</span></td>
      </tr>
      <tr>
        <td>7. <span data-field="state_or_province">{{ state_or_province }}</span></td>
        <td>8. <span data-field="country_and_zip_code">{{ country_and_zip_code }}</span></td>
      </tr>
    </tbody>
  </table>

  <div style="margin-top: 30px;">
    <table style="width: 100%;">
      <tbody>
        <tr>
          <td style="width: 10%;">9. Total number of Forms 1095-B submitted with this transmittal</td>
          <td style="width: 50%; text-align: center;">
            {% for i in range(10) %}
              <span style="border-bottom: 1px solid black; display: inline-block; width: 15px; text-align: center;">&nbsp;</span>
            {% endfor %}
          </td>
          <td style="width: 20%; text-align: right;">&gt;</td>
        </tr>
      </tbody>
    </table>
  </div>

  <p style="margin-top: 40px; font-size: 10pt;">
    Under penalties of perjury, I declare that I have examined this return and accompanying documents, and to the best of my knowledge and belief, they are true, correct, and complete.
  </p>

  <div style="display: flex; justify-content: space-between; margin-top: 80px;">
    <div style="width: 30%;">
      <p style="font-size: 10pt;">Signature</p>
      <div style="border-top: 1px solid black; margin-top: 30px;"></div>
    </div>
    <div style="width: 30%;">
      <p style="font-size: 10pt;">Title</p>
      <div style="border-top: 1px solid black; margin-top: 30px;"></div>
    </div>
    <div style="width: 30%;">
      <p style="font-size: 10pt;">Date</p>
      <div style="border-top: 1px solid black; margin-top: 30px;"></div>
    </div>
  </div>

  <p style="margin-top: 100px; font-size: 8pt;">
    For Privacy Act and Paperwork Reduction Act Notice, see separate instructions.
  </p>

  <div style="display: flex; justify-content: space-between; margin-top: 20px; font-size: 8pt;">
    <p>Cat. No. 61570P</p>
    <p>Form 1094-B ({{ year }})</p>
  </div>
</div>