<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  table { width: 100%; border-collapse: collapse; margin-top: 15px; }
  td { padding: 8px 0; border: 1px solid #000; }
  .header-row td { border: none; }
</style>
<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      <h1 style="font-size: 24pt; margin: 0;">8275</h1>
      <p style="font-size: 10pt; margin: 5px 0 0 0;">(Rev. August 2013)</p>
      <p style="font-size: 10pt; margin: 0;">Department of the Treasury</p>
      <p style="font-size: 10pt; margin: 0;">Internal Revenue Service</p>
    </div>
    <div style="text-align: right;">
      <p style="font-size: 10pt; margin: 0;">OMB No. 1545-0889</p>
      <p style="font-size: 10pt; margin: 0;">Attachment</p>
      <p style="font-size: 10pt; margin: 0;">Sequence No. 92</p>
    </div>
  </div>

  <div style="margin-top: 20px;">
    <p style="font-size: 11pt;">Do not use this form to disclose items or positions that are contrary to Treasury regulations. Instead, use Form 8275-R, Regulation Disclosure Statement.</p>
    <p style="font-size: 11pt;">&bull; <span data-field="link_to_form_8275_r">{{ link_to_form_8275_r }}</span></p>
    <p style="font-size: 11pt;">&bull; <span data-field="link_to_tax_return">{{ link_to_tax_return }}</span></p>
  </div>

  <div style="margin-top: 30px;">
    <p style="font-size: 11pt;">Identifying number shown on return</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 20px;">
      <span data-field="identifying_number">{{ identifying_number }}</span>
    </div>
  </div>

  <div style="margin-top: 20px;">
    <p style="font-size: 11pt;">If Form 8275 relates to an information return for a foreign entity (for example, Form 5471), enter:</p>
    <p style="font-size: 11pt;">Name of foreign entity <span data-field="foreign_entity_name">{{ foreign_entity_name }}</span></p>
    <p style="font-size: 11pt;">Employer identification number, if any <span data-field="ein">{{ ein }}</span></p>
    <p style="font-size: 11pt;">Reference ID number (see instructions) <span data-field="reference_id">{{ reference_id }}</span></p>
  </div>

  <h2 style="font-size: 12pt; margin-top: 30px; margin-bottom: 10px;">Part I General Information (see instructions)</h2>
  <table>
    <thead>
      <tr class="header-row">
        <td style="width: 10%;"> (a) Rev. Rule, Rev. Proc., etc. </td>
        <td style="width: 30%;"> (b) Item or Group of Items </td>
        <td style="width: 30%;"> (c) Detailed Description of Items </td>
        <td style="width: 15%;"> (d) Form or Schedule No. </td>
        <td style="width: 10%;"> (e) Line No. </td>
        <td style="width: 15%;"> (f) Amount </td>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td style="width: 10%; border: none;">1</td>
        <td style="width: 30%; border: none;"></td>
        <td style="width: 30%; border: none;"></td>
        <td style="width: 15%; border: none;"></td>
        <td style="width: 10%; border: none;"></td>
        <td style="width: 15%; border: none;"></td>
      </tr>
      <tr>
        <td style="width: 10%; border: none;">2</td>
        <td style="width: 30%; border: none;"></td>
        <td style="width: 30%; border: none;"></td>
        <td style="width: 15%; border: none;"></td>
        <td style="width: 10%; border: none;"></td>
        <td style="width: 15%; border: none;"></td>
      </tr>
      <tr>
        <td style="width: 10%; border: none;">3</td>
        <td style="width: 30%; border: none;"></td>
        <td style="width: 30%; border: none;"></td>
        <td style="width: 15%; border: none;"></td>
        <td style="width: 10%; border: none;"></td>
        <td style="width: 15%; border: none;"></td>
      </tr>
      <tr>
        <td style="width: 10%; border: none;">4</td>
        <td style="width: 30%; border: none;"></td>
        <td style="width: 30%; border: none;"></td>
        <td style="width: 15%; border: none;"></td>
        <td style="width: 10%; border: none;"></td>
        <td style="width: 15%; border: none;"></td>
      </tr>
      <tr>
        <td style="width: 10%; border: none;">5</td>
        <td style="width: 30%; border: none;"></td>
        <td style="width: 30%; border: none;"></td>
        <td style="width: 15%; border: none;"></td>
        <td style="width: 10%; border: none;"></td>
        <td style="width: 15%; border: none;"></td>
      </tr>
      <tr>
        <td style="width: 10%; border: none;">6</td>
        <td style="width: 30%; border: none;"></td>
        <td style="width: 30%; border: none;"></td>
        <td style="width: 15%; border: none;"></td>
        <td style="width: 10%; border: none;"></td>
        <td style="width: 15%; border: none;"></td>
      </tr>
    </tbody>
  </table>

  <h2 style="font-size: 12pt; margin-top: 30px; margin-bottom: 10px;">Part II Detailed Explanation (see instructions)</h2>
  <div style="border-bottom: 1px solid #000; margin-bottom: 20px;">
    <p style="margin: 0;">1</p>
  </div>
  <div style="border-bottom: 1px solid #000; margin-bottom: 20px;">
    <p style="margin: 0;">2</p>
  </div>
  <div style="border-bottom: 1px solid #000; margin-bottom: 20px;">
    <p style="margin: 0;">3</p>
  </div>
  <div style="border-bottom: 1px solid #000; margin-bottom: 20px;">
    <p style="margin: 0;">4</p>
  </div>
  <div style="border-bottom: 1px solid #000; margin-bottom: 20px;">
    <p style="margin: 0;">5</p>
  </div>
  <div style="border-bottom: 1px solid #000; margin-bottom: 20px;">
    <p style="margin: 0;">6</p>
  </div>

  <h2 style="font-size: 12pt; margin-top: 30px; margin-bottom: 10px;">Part III Information About Pass-Through Entity. To be completed by partners, shareholders, beneficiaries, or residual interest holders.</h2>
  <p style="font-size: 11pt; margin-bottom: 15px;">Complete this part only if you are making adequate disclosure for a pass-through item.</p>
  <p style="font-size: 10pt; margin-bottom: 15px;">Note: A pass-through entity is a partnership, S corporation, estate, trust, regulated investment company (RIC), real estate investment trust (REIT), or real estate mortgage investment conduit (REMIC).</p>

  <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
    <div style="width: 48%;">
      <p style="font-size: 11pt;">1 Name, address, and ZIP code of pass-through entity</p>
      <div style="border-bottom: 1px solid #000; margin-top: 5px;">
        <span data-field="pass_through_entity_name">{{ pass_through_entity_name }}</span>
      </div>
    </div>
    <div style="width: 48%;">
      <p style="font-size: 11pt;">2 Identifying number of pass-through entity</p>
      <div style="border-bottom: 1px solid #000; margin-top: 5px;">
        <span data-field="pass_through_entity_id">{{ pass_through_entity_id }}</span>
      </div>
    </div>
  </div>

  <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
    <div style="width: 48%;">
      <p style="font-size: 11pt;">3 Tax year of pass-through entity</p>
      <div style="display: flex; gap: 10px; margin-top: 5px;">
        <div style="flex: 1; border-bottom: 1px solid #000;">
          <span data-field="tax_year_start">{{ tax_year_start }}</span>
        </div>
        <div style="flex: 1; border-bottom: 1px solid #000;">
          <span data-field="tax_year_end">{{ tax_year_end }}</span>
        </div>
        <div style="flex: 1; border-bottom: 1px solid #000;">
          <span data-field="tax_year_end_2">{{ tax_year_end_2 }}</span>
        </div>
      </div>
    </div>
    <div style="width: 48%;">
      <p style="font-size: 11pt;">4 Internal Revenue Service Center where the pass-through entity filed its return</p>
      <div style="border-bottom: 1px solid #000; margin-top: 5px;">
        <span data-field="irs_center">{{ irs_center }}</span>
      </div>
    </div>
  </div>

  <div style="margin-top: 50px; display: flex; justify-content: space-between;">
    <p style="font-size: 10pt;">For Paperwork Reduction Act Notice, see separate instructions.</p>
    <p style="font-size: 10pt;">Cat. No. 6193M</p>
    <p style="font-size: 10pt;">Form 8275 (Rev. 8-2013)</p>
  </div>
</div>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      <h2 style="font-size: 12pt; margin-top: 0; margin-bottom: 10px;">Part IV Explanations (continued from Parts I and/or II)</h2>
    </div>
    <div style="text-align: right;">
      <p style="font-size: 10pt;">Page 2</p>
    </div>
  </div>

  <div style="margin-top: 30px;">
    <div style="border-bottom: 1px solid #000; margin-bottom: 20px;">
      <p style="margin: 0;">1</p>
    </div>
    <div style="border-bottom: 1px solid #000; margin-bottom: 20px;">
      <p style="margin: 0;">2</p>
    </div>
    <div style="border-bottom: 1px solid #000; margin-bottom: 20px;">
      <p style="margin: 0;">3</p>
    </div>
    <div style="border-bottom: 1px solid #000; margin-bottom: 20px;">
      <p style="margin: 0;">4</p>
    </div>
    <div style="border-bottom: 1px solid #000; margin-bottom: 20px;">
      <p style="margin: 0;">5</p>
    </div>
