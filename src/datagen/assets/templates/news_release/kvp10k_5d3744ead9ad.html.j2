<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    color: #333;
  }
  h1, h2, h3 {
    font-weight: bold;
  }
  .header-section {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 40px;
  }
  .logo-area {
    display: flex;
    align-items: center;
  }
  .logo-area img {
    height: 60px; /* Placeholder for USDA logo size */
    margin-right: 15px;
  }
  .title-area h1 {
    font-size: 36pt;
    margin: 0;
    line-height: 1;
  }
  .contact-info {
    text-align: right;
    font-size: 10pt;
  }
  .content-section {
    line-height: 1.5;
    margin-bottom: 30px;
  }
  .divider {
    border-top: 1px solid #ccc;
    margin: 30px 0;
  }
</style>

<div class="page">
  <div class="header-section">
    <div class="logo-area">
      <!-- Placeholder for USDA Logo -->
      <div style="width: 60px; height: 60px; background-color: #eee; border: 1px solid #ccc;"></div>
      <div>
        <h2 style="font-size: 14pt; margin: 0;">USDA</h2>
        <p style="font-size: 10pt; margin: 0;">United States Department of Agriculture</p>
      </div>
    </div>
    <div class="contact-info">
      <p>Contact:</p>
      <p><span data-field="contact.phone">{{ contact.phone }}</span></p>
      <p><span data-field="contact.email">{{ contact.email }}</span></p>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <h2 style="font-size: 18pt; margin-bottom: 5px;">Risk Management Agency</h2>
    <p style="font-size: 10pt; margin: 0;">
      <span data-field="rma.address_line1">{{ rma.address_line1 }}</span><br>
      <span data-field="rma.address_line2">{{ rma.address_line2 }}</span><br>
      <span data-field="rma.city_state_zip">{{ rma.city_state_zip }}</span>
    </p>
  </div>

  <h1 style="font-size: 48pt; margin-top: 0; margin-bottom: 10px;">News Release</h1>

  <div style="margin-bottom: 30px;">
    <p>Release No.: <span data-field="release_number">{{ release_number }}</span></p>
  </div>

  <div class="content-section">
    <h2 style="font-size: 16pt; margin-top: 0;">Crop Insurance Deadline Nears in Vermont</h2>
    <p>
      <span data-field="article_summary_intro">{{ article_summary_intro }}</span>
    </p>
  </div>

  <div class="divider"></div>

  <div class="content-section">
    <p>
      <span data-field="main_body_paragraph_1">{{ main_body_paragraph_1 }}</span>
    </p>
    <p>
      <span data-field="main_body_paragraph_2">{{ main_body_paragraph_2 }}</span>
    </p>
    <p>
      <span data-field="main_body_paragraph_3">{{ main_body_paragraph_3 }}</span>
    </p>
    <p>
      <span data-field="main_body_paragraph_4">{{ main_body_paragraph_4 }}</span>
    </p>
  </div>

  <div class="divider"></div>

  <div class="content-section" style="font-size: 10pt;">
    <p>
      <span data-field="disclaimer_text">{{ disclaimer_text }}</span>
    </p>
  </div>
</div>