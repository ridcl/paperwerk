<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Library Account Setup Guide</title>
<style>
  @page { size: A4; margin: 0; }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: "Liberation Sans", "DejaVu Sans", Arial, Helvetica, sans-serif;
    font-size: 13px;
    color: #222;
  }

  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }

  /* Header banner */
  .header-banner {
    width: 100%;
    height: 58px;
    background: linear-gradient(to right, #1a1a1a 0%, #3a3a3a 20%, #888 60%, #bbb 100%);
    display: flex;
    align-items: center;
    margin-bottom: 22px;
    border-radius: 2px;
    overflow: hidden;
    position: relative;
  }
  .header-banner .logo-box {
    background: #fff;
    height: 100%;
    display: flex;
    align-items: center;
    padding: 0 10px;
    min-width: 44px;
  }
  .header-banner .logo-box .logo-o {
    font-family: Georgia, "Liberation Serif", serif;
    font-size: 22px;
    font-weight: bold;
    color: #c8102e;
    border: 2px solid #c8102e;
    padding: 0 4px;
    line-height: 1;
  }
  .header-banner .library-name {
    color: #fff;
    font-weight: bold;
    font-size: 13px;
    letter-spacing: 0.5px;
    padding-left: 10px;
    text-transform: uppercase;
  }
  .header-banner .banner-photos {
    position: absolute;
    right: 0;
    top: 0;
    height: 100%;
    width: 320px;
    background: linear-gradient(to right, transparent, #aaa 30%, #ccc 60%, #999 100%);
    opacity: 0.7;
  }

  /* Page title */
  .page-title {
    text-align: center;
    font-weight: bold;
    font-size: 15px;
    line-height: 1.5;
    margin-bottom: 18px;
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
  }

  /* Body text */
  .body-text {
    font-size: 13px;
    line-height: 1.55;
    margin-bottom: 14px;
  }

  a {
    color: #1155cc;
    text-decoration: underline;
  }

  /* Screenshot mock boxes */
  .screenshot-box {
    border: 1px solid #bbb;
    background: #f9f9f9;
    padding: 10px 14px;
    margin-bottom: 16px;
    font-size: 11.5px;
    color: #333;
    font-family: "Liberation Sans", Arial, sans-serif;
  }

  /* Nav bar mock */
  .nav-bar {
    display: flex;
    gap: 0;
    margin-bottom: 6px;
    font-size: 11px;
  }
  .nav-bar .nav-item {
    background: #e8e8e8;
    border: 1px solid #bbb;
    padding: 2px 8px;
    cursor: default;
  }
  .nav-bar .nav-item.active {
    background: #fff;
    border-bottom: 1px solid #fff;
  }

  .my-account-btn {
    display: inline-block;
    background: #e0e0e0;
    border: 1px solid #999;
    padding: 2px 8px;
    font-size: 10.5px;
    font-weight: bold;
    margin-bottom: 6px;
    color: #333;
  }

  .find-items-label {
    font-weight: bold;
    font-size: 12px;
    margin-bottom: 5px;
  }

  .search-row {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 5px;
  }
  .search-input {
    border: 1px solid #999;
    height: 20px;
    width: 200px;
    background: #fff;
  }
  .go-btn {
    background: #ddd;
    border: 1px solid #999;
    padding: 1px 8px;
    font-size: 11px;
    font-weight: bold;
  }

  .limit-row {
    font-size: 11px;
    margin-bottom: 3px;
    color: #555;
  }

  .limit-select {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    margin-bottom: 4px;
  }
  .limit-select select-mock {
    border: 1px solid #999;
    background: #fff;
    padding: 1px 4px;
    font-size: 11px;
  }

  .adv-search-link {
    color: #1155cc;
    font-size: 11px;
    text-decoration: underline;
  }

  /* Sign in box */
  .signin-box {
    border: 1px solid #ccc;
    background: #f5f5f5;
    padding: 12px 16px;
    margin-bottom: 16px;
    font-size: 12px;
    width: 380px;
  }
  .signin-box .signin-title {
    font-size: 12px;
    color: #555;
    margin-bottom: 8px;
  }
  .form-row {
    display: flex;
    align-items: center;
    margin-bottom: 7px;
    gap: 8px;
  }
  .form-label {
    width: 110px;
    font-size: 11.5px;
    color: #333;
  }
  .form-input {
    border: 1px solid #999;
    height: 18px;
    width: 180px;
    background: #fff;
  }
  .btn-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: 118px;
    margin-bottom: 6px;
  }
  .mock-btn {
    background: #e0e0e0;
    border: 1px solid #888;
    padding: 2px 10px;
    font-size: 11px;
    cursor: default;
  }
  .mock-btn.outlined {
    background: #fff;
    border: 1.5px solid #555;
    border-radius: 2px;
  }
  .cancel-link {
    color: #1155cc;
    font-size: 11px;
    text-decoration: underline;
  }

  /* Reset password box */
  .reset-box {
    border: 1px solid #ccc;
    background: #f5f5f5;
    padding: 12px 16px;
    margin-bottom: 16px;
    font-size: 11.5px;
    width: 460px;
    color: #333;
    line-height: 1.5;
  }
  .reset-box .reset-desc {
    margin-bottom: 10px;
    font-size: 11px;
    color: #444;
  }
  .reset-form-row {
    display: flex;
    align-items: center;
    margin-bottom: 8px;
    gap: 8px;
  }
  .reset-label {
    font-weight: bold;
    font-size: 11.5px;
    width: 100px;
  }
  .reset-input {
    border: 1px solid #999;
    height: 18px;
    width: 220px;
    background: #fff;
  }
  .reset-btn-row {
    margin-left: 108px;
  }

  /* Change password box */
  .change-pwd-box {
    border: 1px solid #ccc;
    background: #f5f5f5;
    padding: 12px 16px;
    margin-bottom: 16px;
    font-size: 11.5px;
    width: 460px;
    color: #333;
  }
  .change-pwd-title {
    font-weight: bold;
    font-size: 12px;
    margin-bottom: 5px;
    color: #555;
  }
  .change-pwd-desc {
    font-size: 10.5px;
    color: #555;
    margin-bottom: 10px;
    line-height: 1.4;
  }
  .change-form-row {
    display: flex;
    align-items: center;
    margin-bottom: 7px;
    gap: 8px;
  }
  .change-label {
    font-weight: bold;
    font-size: 11.5px;
    width: 140px;
  }
  .change-input {
    border: 1px solid #999;
    height: 18px;
    width: 180px;
    background: #fff;
  }
  .change-btn-row {
    margin-left: 148px;
    margin-top: 4px;
  }

  em { font-style: italic; }
  strong { font-weight: bold; }
</style>
</head>
<body>
<div class="page">

  <!-- Header Banner -->
  <div class="header-banner">
    <div class="logo-box">
      <span class="logo-o">O</span>
    </div>
    <span class="library-name">
      <span data-field="library.name">{{ library.name }}</span>
    </span>
    <div class="banner-photos"></div>
  </div>

  <!-- Page Title -->
  <div class="page-title">
    Create Your Account with <span data-field="library.short_name">{{ library.short_name }}</span> for Access to<br>
    Journal Article Databases and Electronic Books
  </div>

  <!-- Intro paragraph -->
  <p class="body-text">
    Point your Internet browser to the <span data-field="library.short_name">{{ library.short_name }}</span> website at
    <a href="{{ library.website_url }}"><span data-field="library.website_url">{{ library.website_url }}</span></a>
    and click the account login link in the upper right corner of the homepage:
  </p>

  <!-- Screenshot 1: Homepage nav mock -->
  <div class="screenshot-box">
    <div class="nav-bar">
      <div class="nav-item">Books &amp; More</div>
      <div class="nav-item">Databases</div>
      <div class="nav-item">eJournals</div>
      <div class="nav-item">DigitalCommons</div>
    </div>
    <div class="my-account-btn">MY LIBRARY ACCOUNT LOGIN!</div>
    <div class="find-items-label">Find items at <span data-field="library.institution_name">{{ library.institution_name }}</span> and beyond</div>
    <div class="search-row">
      <div class="search-input"></div>
      <div class="go-btn">Go</div>
    </div>
    <div class="limit-row">Limit results to:</div>
    <div class="limit-select">
      <span data-field="library.institution_full_name">{{ library.institution_full_name }}</span> ▼
    </div>
    <br>
    <span class="adv-search-link">Advanced Search</span>
    &nbsp;&nbsp; Search with 🌐 WorldCat®
  </div>

  <!-- Step 2 instruction -->
  <p class="body-text">
    Click the link to set/reset your Library account password:
  </p>

  <!-- Screenshot 2: Sign in box mock -->
  <div class="signin-box">
    <div class="signin-title">Sign in</div>
    <div class="form-row">
      <div class="form-label"><span data-field="signin.id_label">{{ signin.id_label }}</span>:</div>
      <div class="form-input"></div>
    </div>
    <div class="form-row">
      <div class="form-label">Password:</div>
      <div class="form-input"></div>
    </div>
    <div class="btn-row">
      <div class="mock-btn">Sign In</div>
      <span class="cancel-link">Cancel</span>
    </div>
    <div style="margin-left:118px;">
      <div class="mock-btn outlined">Set/reset password</div>
    </div>
  </div>

  <!-- Step 3 instruction -->
  <p class="body-text">
    Follow the instructions to set/rest your Library account password:
  </p>

  <!-- Screenshot 3: Reset password box mock -->
  <div class="reset-box">
    <div class="reset-desc">
      <span data-field="reset_password.instructions">{{ reset_password.instructions }}</span>
    </div>
    <div class="reset-form-row">
      <div class="reset-label"><span data-field="signin.id_label">{{ signin.id_label }}</span>:</div>
      <div class="reset-input"></div>
    </div>
    <div class="reset-btn-row">
      <div class="mock-btn">Request new password</div>
    </div>
  </div>

  <!-- Email paragraph -->
  <p class="body-text">
    The <em>e-mail account listed in your Library patron record</em> is your
    <span data-field="library.institution_abbr">{{ library.institution_abbr }}</span> e-mail available at
    <a href="{{ library.email_portal_url }}"><span data-field="library.email_portal_url">{{ library.email_portal_url }}</span></a>.
    &nbsp;Once you open the e-mail, click the provided link to retrieve the
    <em>change password</em> template. &nbsp;<strong>The username for your library account is your <span data-field="signin.id_label">{{ signin.id_label }}</span></strong>.
  </p>

  <!-- Screenshot 4: Change password box mock -->
  <div class="change-pwd-box">
    <div class="change-pwd-title">Change Password</div>
    <div class="change-pwd-desc">
      <span data-field="change_password.instructions">{{ change_password.instructions }}</span>
    </div>
    <div class="change-form-row">
      <div class="change-label">User Name:</div>
      <div class="change-input"></div>
    </div>
    <div class="change-form-row">
      <div class="change-label">New Password:</div>
      <div class="change-input"></div>
    </div>
    <div class="change-form-row">
      <div class="change-label">Confirm New Password:</div>
      <div class="change-input"></div>
    </div>
    <div class="change-btn-row">
      <div class="mock-btn">Change Password</div>
    </div>
  </div>

  <!-- Help paragraph -->
  <p class="body-text">
    If you need help with your Library account, please call the
    <span data-field="library.help_desk_name">{{ library.help_desk_name }}</span> at
    <span data-field="library.help_desk_phone">{{ library.help_desk_phone }}</span>.
  </p>

</div>
</body>
</html>