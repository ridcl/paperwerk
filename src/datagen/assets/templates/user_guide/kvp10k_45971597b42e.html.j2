        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial; }
        .header-logo { float: right; }
        .footer { position: absolute; bottom: 50px; right: 60px; font-size: 10pt; color: #555; }
        .toc-entry { display: flex; justify-content: space-between; margin-bottom: 5px; }
        .toc-entry span:first-child { flex-grow: 1; }
        .toc-entry span:last-child { width: 20px; text-align: right; }
    </style>

<style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial; }
        p, span { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial; }
        .header-logo { font-size: 24pt; font-weight: bold; }
        .section-title { font-size: 14pt; font-weight: bold; margin-bottom: 10px; }
        .note { font-style: italic; margin-top: 15px; }
        .step-number { font-weight: bold; margin-right: 10px; }
        .image-placeholder { width: 100%; height: 300px; background-color: #f0f0f0; border: 1px solid #ccc; margin-top: 15px; display: flex; align-items: center; justify-content: center; color: #666; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        td { padding: 8px; text-align: left; }
        .footer { position: absolute; bottom: 50px; right: 60px; font-size: 10pt; color: #666; }
