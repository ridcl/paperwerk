<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Account Creation Guide</title>
<style>
  @page { size: A4; margin: 0; }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: "Liberation Sans", Arial, Helvetica, sans-serif;
    font-size: 13px;
    color: #000;
  }

  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }

  /* PAGE 1 */
  .top-section {
    display: flex;
    flex-direction: row;
    gap: 20px;
    margin-bottom: 10px;
  }

  .left-col {
    flex: 1;
  }

  .logo-area {
    margin-bottom: 6px;
  }

  .logo-text {
    font-family: "Liberation Serif", Georgia, serif;
    font-size: 42px;
    font-weight: 900;
    color: #E87722;
    letter-spacing: 2px;
    line-height: 1;
  }

  .logo-paw {
    color: #E87722;
    font-size: 36px;
  }

  .college-name {
    color: #522D80;
    font-weight: 700;
    font-size: 13px;
    border-top: 2px solid #522D80;
    padding-top: 3px;
    margin-top: 2px;
    text-align: center;
  }

  .main-title {
    font-size: 26px;
    font-weight: 900;
    margin-top: 14px;
    line-height: 1.2;
  }

  .qualtrics-logo-area {
    text-align: center;
    margin-top: 6px;
  }

  .qualtrics-wordmark {
    font-family: "Liberation Serif", Georgia, serif;
    font-size: 28px;
    color: #8B0000;
    font-style: italic;
    letter-spacing: 1px;
  }

  .qualtrics-icon {
    font-size: 70px;
    color: #8B0000;
    line-height: 1;
    display: block;
    margin-top: -10px;
  }

  .important-box {
    border: 2px solid #000;
    padding: 12px 14px;
    width: 310px;
    font-size: 12px;
    line-height: 1.5;
  }

  .important-box h3 {
    font-size: 14px;
    font-weight: 900;
    text-align: center;
    margin-bottom: 8px;
  }

  .important-box p {
    font-weight: 700;
    text-align: justify;
    margin-bottom: 6px;
  }

  /* Middle section: Go to + screenshot */
  .mid-section {
    display: flex;
    flex-direction: row;
    gap: 20px;
    margin-top: 10px;
    align-items: flex-start;
  }

  .mid-left {
    flex: 1;
    padding-top: 10px;
  }

  .mid-left p {
    font-size: 16px;
    margin-bottom: 4px;
  }

  .mid-left a {
    color: #1155CC;
    font-size: 16px;
    text-decoration: underline;
  }

  .click-instruction {
    font-size: 16px;
    margin-top: 30px;
  }

  .click-instruction .highlight {
    color: #CC0000;
    font-weight: 900;
    font-style: italic;
  }

  .screenshot-box {
    width: 290px;
    border: 2px solid #1155CC;
    padding: 10px;
    font-size: 10px;
    background: #fff;
  }

  .screenshot-logo {
    text-align: center;
    margin-bottom: 4px;
  }

  .screenshot-logo .s-logo-text {
    font-family: "Liberation Serif", Georgia, serif;
    font-size: 22px;
    font-weight: 900;
    color: #E87722;
    letter-spacing: 1px;
  }

  .screenshot-logo .s-college {
    color: #522D80;
    font-weight: 700;
    font-size: 9px;
    border-top: 1px solid #522D80;
    padding-top: 2px;
    text-align: center;
  }

  .screenshot-field {
    border: 1px solid #ccc;
    padding: 4px 6px;
    margin: 4px 0;
    color: #888;
    font-size: 10px;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .forgot-link {
    color: #1155CC;
    font-size: 9px;
    margin: 2px 0;
  }

  .sign-in-btn {
    background: #2E8B57;
    color: #fff;
    text-align: center;
    padding: 5px;
    font-size: 11px;
    font-weight: 700;
    margin: 4px 0;
  }

  .or-divider {
    text-align: center;
    color: #888;
    font-size: 9px;
    margin: 3px 0;
  }

  .google-btn {
    border: 1px solid #ccc;
    padding: 4px 6px;
    font-size: 10px;
    text-align: center;
    margin: 3px 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
  }

  .create-account-btn {
    border: 2px solid #CC0000;
    padding: 4px 6px;
    font-size: 9px;
    text-align: center;
    margin: 3px 0;
    color: #333;
  }

  .arrow-right {
    display: inline-block;
    color: #CC0000;
    font-size: 20px;
    margin-left: 10px;
    vertical-align: middle;
  }

  /* Bottom section: email instructions + screenshot */
  .bottom-section {
    display: flex;
    flex-direction: row;
    gap: 20px;
    margin-top: 18px;
    align-items: flex-start;
  }

  .bottom-left {
    flex: 1;
    font-size: 15px;
    line-height: 1.5;
  }

  .bottom-left .highlight {
    color: #CC0000;
    font-weight: 900;
    font-style: italic;
  }

  .screenshot-box2 {
    width: 290px;
    border: 2px solid #888;
    padding: 10px;
    font-size: 10px;
    background: #fff;
  }

  .form-label {
    font-weight: 700;
    font-size: 10px;
    margin-top: 6px;
    margin-bottom: 2px;
  }

  .form-label span {
    font-weight: 400;
    font-size: 9px;
    color: #555;
  }

  .form-input {
    border: 1px solid #ccc;
    height: 18px;
    width: 100%;
    margin-bottom: 4px;
  }

  .get-started-btn {
    background: #2E8B57;
    color: #fff;
    padding: 5px 12px;
    font-size: 11px;
    font-weight: 700;
    border: 2px solid #CC0000;
    display: inline-block;
    float: right;
    margin-top: 4px;
  }

  .or-google {
    font-size: 9px;
    color: #555;
    margin-top: 6px;
  }

  .updated-line {
    position: absolute;
    bottom: 30px;
    right: 60px;
    font-size: 11px;
  }

  .updated-line strong {
    font-weight: 700;
  }

  /* PAGE 2 */
  .p2-top {
    display: flex;
    flex-direction: row;
    gap: 20px;
    margin-bottom: 20px;
    align-items: flex-start;
  }

  .p2-left {
    flex: 1;
    font-size: 15px;
    line-height: 1.5;
    padding-top: 10px;
  }

  .p2-left .highlight {
    color: #CC0000;
    font-weight: 900;
    font-style: italic;
  }

  .screenshot-box3 {
    width: 370px;
    border: 2px solid #888;
    padding: 12px;
    font-size: 10px;
    background: #fff;
  }

  .name-row {
    display: flex;
    gap: 10px;
    margin-bottom: 6px;
  }

  .name-col {
    flex: 1;
  }

  .finish-btn {
    background: #1155CC;
    color: #fff;
    padding: 5px 14px;
    font-size: 11px;
    font-weight: 700;
    border: 2px solid #CC0000;
    display: inline-block;
    float: right;
    margin-top: 8px;
  }

  .p2-mid {
    display: flex;
    flex-direction: row;
    gap: 20px;
    margin-bottom: 20px;
    align-items: flex-start;
  }

  .p2-mid-left {
    flex: 1;
    font-size: 15px;
    line-height: 1.5;
    padding-top: 10px;
  }

  .p2-mid-left .highlight {
    color: #CC0000;
    font-weight: 900;
    font-style: italic;
  }

  .screenshot-box4 {
    width: 370px;
    border: 2px solid #888;
    padding: 12px;
    font-size: 10px;
    background: #fff;
  }

  .all-finished-bar {
    background: #e0e0e0;
    padding: 8px 10px;
    font-size: 10px;
    margin-bottom: 10px;
  }

  .all-finished-bar p {
    font-weight: 700;
    margin-bottom: 2px;
  }

  .all-finished-bar span {
    font-weight: 400;
    font-size: 9px;
  }

  .sign-me-up-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 8px;
  }

  .sign-me-up-btn {
    background: #1155CC;
    color: #fff;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 700;
    border: 2px solid #CC0000;
    display: inline-block;
  }

  .access-code-area {
    font-size: 10px;
  }

  .access-code-area p {
    font-weight: 700;
    margin-bottom: 4px;
  }

  .access-code-input {
    border: 1px solid #ccc;
    height: 18px;
    width: 80px;
    display: inline-block;
  }

  .go-btn {
    background: #888;
    color: #fff;
    padding: 2px 6px;
    font-size: 10px;
    display: inline-block;
    margin-left: 4px;
  }

  .bullet-section {
    margin-top: 16px;
  }

  .bullet-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 10px;
    font-size: 14px;
    line-height: 1.5;
  }

  .paw-bullet {
    color: #E87722;
    font-size: 18px;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .bullet-item a {
    color: #1155CC;
    text-decoration: underline;
  }

  .p2-footer {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: 10px;
  }

  .contact-section {
    font-size: 14px;
    line-height: 1.6;
  }

  .contact-section .paw-bullet {
    display: inline;
    margin-right: 4px;
  }

  .lrc-box {
    text-align: right;
    font-size: 12px;
  }

  .lrc-box .lrc-title {
    font-size: 16px;
    font-weight: 700;
    color: #E87722;
  }

  .lrc-box .lrc-sub {
    font-size: 11px;
    color: #555;
  }

  .lrc-box .lrc-updated {
    font-size: 10px;
    font-weight: 700;
    margin-top: 4px;
  }

  .clearfix::after {
    content: "";
    display: table;
    clear: both;
  }
</style>
</head>
<body>

<!-- PAGE 1 -->
<div class="page">

  <!-- Top: Logo + Important Note -->
  <div class="top-section">
    <div class="left-col">
      <div class="logo-area">
        <div class="logo-text">CLEMS<span style="color:#E87722;">🐾</span>N</div>
        <div class="college-name">
          <span data-field="college_name">{{ college_name }}</span>
        </div>
      </div>
      <div class="main-title">
        <span data-field="document_title">{{ document_title }}</span>
      </div>
      <div class="qualtrics-logo-area">
        <div class="qualtrics-wordmark">qualtrics</div>
        <span class="qualtrics-icon">&#x1D410;</span>
      </div>
    </div>

    <div class="important-box">
      <h3>IMPORTANT NOTE:</h3>
      <p><span data-field="important_note_text">{{ important_note_text }}</span></p>
      <p><span data-field="student_note_text">{{ student_note_text }}</span></p>
    </div>
  </div>

  <!-- Middle: Go to URL + Login Screenshot -->
  <div class="mid-section">
    <div class="mid-left">
      <p>Go to</p>
      <p><a href="#"><span data-field="portal_url">{{ portal_url }}</span></a></p>

      <div class="click-instruction" style="margin-top: 40px;">
        Click on <span class="highlight">create an account</span> link
        <span class="arrow-right">&#10148;</span>
      </div>
    </div>

    <div class="screenshot-box">
      <div class="screenshot-logo">
        <div class="s-logo-text">CLEMS🐾N</div>
        <div class="s-college"><span data-field="college_name_short">{{ college_name_short }}</span></div>
      </div>
      <div class="screenshot-field">&#128100; Email / Username</div>
      <div class="screenshot-field">&#128274; Password</div>
      <div class="forgot-link">Forgot your password?</div>
      <div class="sign-in-btn">Sign In</div>
      <div class="or-divider">— or —</div>
      <div class="google-btn">G &nbsp; Sign in with Google</div>
      <div class="create-account-btn">Please click here to create an account</div>
    </div>
  </div>

  <!-- Bottom: Email instructions + Registration Screenshot -->
  <div class="bottom-section">
    <div class="bottom-left">
      <span data-field="email_instruction_text">{{ email_instruction_text }}</span>
      Click on the <span class="highlight">Get Started</span> button.
    </div>

    <div class="screenshot-box2">
      <div class="screenshot-logo">
        <div class="s-logo-text">CLEMS🐾N</div>
        <div class="s-college"><span data-field="college_name_short2">{{ college_name_short2 }}</span></div>
      </div>
      <div class="form-label">Email Address <span>(This will be your user name)</span></div>
      <div class="form-input"></div>
      <div class="form-label">Password</div>
      <div class="form-input"></div>
      <div class="form-label">Re-Type Password</div>
      <div class="form-input"></div>
      <div class="clearfix">
        <div class="or-google">Or sign up with<br>&#x1F534; Google</div>
        <div class="get-started-btn">Get Started!</div>
      </div>
    </div>
  </div>

  <div class="updated-line"><strong>Updated</strong>: <span data-field="updated_date_page1">{{ updated_date_page1 }}</span></div>
</div>

<!-- PAGE 2 -->
<div class="page">

  <!-- Top: Optional fields + Finish screenshot -->
  <div class="p2-top">
    <div class="p2-left">
      These fields are optional, but recommended.<br><br>
      Click on <span class="highlight">Finish</span> to continue.
      <span style="font-size:20px; color:#CC0000; margin-left:8px;">&#10148;</span>
    </div>

    <div class="screenshot-box3">
      <div class="screenshot-logo">
        <div class="s-logo-text">CLEMS🐾N</div>
        <div class="s-college"><span data-field="college_name_short3">{{ college_name_short3 }}</span></div>
      </div>
      <div class="name-row">
        <div class="name-col">
          <div class="form-label">First Name <span>(Optional)</span></div>
          <div class="form-input"></div>
        </div>
        <div class="name-col">
          <div class="form-label">Last Name <span>(Optional)</span></div>
          <div class="form-input"></div>
        </div>
      </div>
      <div class="form-label">Phone Number <span>(Optional)</span></div>
      <div class="form-input"></div>
      <div class="clearfix">
        <div class="finish-btn">Finish</div>
      </div>
    </div>
  </div>

  <!-- Mid: Access Code + Sign Me Up screenshot -->
  <div class="p2-mid">
    <div class="p2-mid-left">
      No Access Code required.<br>
      Simply click on the<br>
      <span class="highlight">Sign Me Up</span> button.
      <span style="font-size:20px; color:#CC0000; margin-left:8px;">&#10148;</span>
    </div>

    <div class="screenshot-box4">
      <div class="screenshot-logo">
        <div class="s-logo-text">CLEMS🐾N</div>
        <div class="s-college"><span data-field="college_name_short4">{{ college_name_short4 }}</span></div>
      </div>
      <div class="all-finished-bar">
        <p>All Finished!</p>
        <span>If you have been provided an access code, enter it now. Otherwise click Sign Me Up to continue.</span>
      </div>
      <div class="sign-me-up-row">
        <div class="sign-me-up-btn">Sign Me Up</div>
        <span style="font-size:11px;">or</span>
        <div class="access-code-area">
          <p>I Have An Access Code</p>
          <div class="access-code-input"></div>
          <span class="go-btn">Go</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Bullet points -->
  <div class="bullet-section">
    <div class="bullet-item">
      <span class="paw-bullet">🐾</span>
      <span><span data-field="bullet_verify_text">{{ bullet_verify_text }}</span></span>
    </div>
    <div class="bullet-item">
      <span class="paw-bullet">🐾</span>
      <span>
        <span data-field="bullet_login_text">{{ bullet_login_text }}</span><br>
        <a href="#"><span data-field="portal_url_page2">{{ portal_url_page2 }}</span></a>
      </span>
    </div>
  </div>

  <!-- Footer: Contact + LRC -->
  <div class="p2-footer" style="margin-top: 16px;">
    <div class="contact-section">
      <div class="bullet-item" style="margin-bottom:4px;">
        <span class="paw-bullet">🐾</span>
        <span>Questions? Contact:</span>
      </div>
      <div style="margin-left: 26px;">
        <span data-field="contact_name">{{ contact_name }}</span> |
        <span data-field="contact_email">{{ contact_email }}</span> |
        <span data-field="contact_phone">{{ contact_phone }}</span>
      </div>
    </div>

    <div class="lrc-box">
      <span class="paw-bullet" style="font-size:22px;">🐾</span>
      <span class="lrc-title"> <span data-field="lrc_name">{{ lrc_name }}</span></span><br>
      <span class="lrc-sub"><span data-field="lrc_tagline">{{ lrc_tagline }}</span></span><br>
      <div class="lrc-updated"><strong>Updated</strong>: <span data-field="updated_date_page2">{{ updated_date_page2 }}</span></div>
    </div>
  </div>

</div>

</body>
</html>