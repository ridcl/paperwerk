<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  td, th {
    padding: 8px 0;
    border: 1px solid #ccc;
    text-align: left;
  }
  .form-field {
    border-bottom: 1px solid black;
    display: inline-block;
    width: calc(100% - 2px);
    padding: 0 5px;
  }
  .section-title {
    font-weight: bold;
    margin-bottom: 10px;
  }
</style>

