  <h2 style="text-align: center; margin-bottom: 20px;">Examination Form</h2>
  <p style="text-align: center; margin-bottom: 30px;">Term-End Exam Jan / Dec.</p>

  <div style="margin-bottom: 30px;">
    <p>Programme: <span class="form-field">{{ exam.programme }}</span></p>
    <p>Enrollment Number: <span class="form-field">{{ exam.enrollment_number }}</span></p>
    <p>Exam Centre Code: <span class="form-field">{{ exam.exam_centre_code }}</span></p>
    <p>Name: <span class="form-field">{{ exam.student_name }}</span></p>
    <p style="margin-top: 15px;">Please indicate correct course code and complete course title in which you intend to take the examination. The course(s) which you have already passed should not be mentioned since improvement of score grade is not permissible.</p>
  </div>

  <table style="width: 100%;">
    <thead>
      <tr>
        <th style="width: 10%;">S. No.</th>
        <th style="width: 30%;">Course Code</th>
        <th style="width: 40%;">Course Title</th>
        <th style="width: 15%;">Fee Details:</th>
      </tr>
    </thead>
    <tbody>
      {% for item in exam_subjects %}
      <tr>
        <td>{{ loop.index }}</td>
        <td><span data-field="exam_subjects[{{ loop.index0 }}].course_code">{{ item.course_code }}</span></td>
        <td><span data-field="exam_subjects[{{ loop.index0 }}].course_title">{{ item.course_title }}</span></td>
        <td style="width: 15%;">
          <p>DD No. <span data-field="exam_subjects[{{ loop.index0 }}].dd_no">{{ exam_subjects[loop.index0].dd_no }}</span></p>
          <p>Bank: <span data-field="exam_subjects[{{ loop.index0 }}].bank">{{ exam_subjects[loop.index0].bank }}</span></p>
          <p>D.D. Amount: <span data-field="exam_subjects[{{ loop.index0 }}].dd_amount">{{ exam_subjects[loop.index0].dd_amount }}</span></p>
          <p>Date: <span data-field="exam_subjects[{{ loop.index0 }}].date">{{ exam_subjects[loop.index0].date }}</span></p>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div style="margin-top: 80px;">
    <p>Signature of the candidate</p>
    <div class="form-field" style="width: 300px;"></div>
  </div>
