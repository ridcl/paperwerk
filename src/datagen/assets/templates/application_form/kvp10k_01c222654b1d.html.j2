  </table>

  <div class="section-title">Reason(s) for non-acceptance of application:</div>
  <table>
    <tr>
      <td><input type="checkbox" name="reason"> 1. Did not meet all necessary criteria for acceptance</td>
      <td><input type="checkbox" name="reason"> 4. Application received after required number was attained</td>
      <td><input type="checkbox" name="reason"> 5. Application not complete</td>
    </tr>
