<style>
    @page { size: A4; margin: 0; }
    .page {
        width: 794px; height: 1123px;
        padding: 50px 60px; box-sizing: border-box;
        overflow: hidden; page-break-after: always;
        position: relative;
        font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
    }
    .page:last-child { page-break-after: auto; }
    h1 { text-align: center; font-weight: bold; }
    .contact-info { text-align: center; font-size: 0.9em; margin-bottom: 30px; }
    .section { margin-bottom: 20px; }
    .form-row { display: flex; justify-content: space-between; margin-bottom: 15px; }
    .form-group { flex: 1; margin-right: 20px; }
    .form-group:last-child { margin-right: 0; }
    .signature-line { margin-top: 50px; border-top: 1px solid #000; padding-top: 5px; }
    .checkbox-group label { margin-right: 15px; }
</style>

<div class="page">
    <h1>Dickinson</h1>
    <div class="contact-info">
        Office of Admissions • PO Box {{ postal_box }} • {{ city }}, {{ state }} {{ zip_code }} (800) {{ phone_number_prefix }}-{{ phone_number_suffix }} • Fax (717) {{ fax_area_code }}-{{ fax_number }} • <a href="mailto:{{ email_address }}">{{ email_address }}</a>
    </div>

    <div class="section">
        <h2>Payment of Dickinson's Application Fee or Enrollment Deposit</h2>
        <p>We would be pleased to accept payment for the application fee or enrollment deposit by either VISA, MasterCard, Discover Card, American Express or Electronic Funds Transfer. Please fully complete the information below and return it with the student portion of the Common Application. This information will be forwarded to our Student Accounts Office for processing.</p>
        <p>Other payment options include check or money order (payable to Dickinson College).</p>
        <p>If you have any questions regarding this procedure, please contact the Office of Admissions at {{ phone_number }}.</p>
    </div>

    <div class="section">
        <div class="form-row">
            <div class="form-group">
                Student Name (no nicknames please):
                <br><br>
                <span data-field="student_full_name">{{ student_full_name }}</span>
            </div>
        </div>
    </div>

    <div class="section">
        <h3>I have enclosed:</h3>
        <div class="form-row">
            <div class="checkbox-group">
                <label><input type="checkbox"> check</label>
                <label><input type="checkbox"> money order</label>
                <label><input type="checkbox"> credit card/electronic funds transfer information</label>
                <label><input type="checkbox"> debit card</label>
            </div>
        </div>
        <p>For credit card/electronic funds transfer processing, please complete the following or call us with your information at {{ phone_number }}.</p>
    </div>

    <div class="section">
        <div class="form-row">
            <div class="form-group">
                Cardholder Name
            </div>
            <div class="form-group">
                Cardholder Telephone Number
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                Cardholder Home Address
            </div>
            <div class="form-group">
                <!-- Placeholder for second address field if needed, otherwise leave blank -->
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                Cardholder E-mail Address
            </div>
            <div class="form-group">
                <!-- Placeholder for second email field if needed, otherwise leave blank -->
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                Credit Card Number
            </div>
            <div class="form-group">
                Expiration Date
                <br>
                Security Code
            </div>
        </div>
    </div>

    <div class="section">
        <div class="form-row">
            <div class="form-group" style="flex: 1;">
                Cardholder Signature
                <div class="signature-line"></div>
            </div>
        </div>
    </div>

    <div class="section">
        <p>Card Type (check one):</p>
        <div class="checkbox-group">
            <label><input type="checkbox"> VISA</label>
            <label><input type="checkbox"> MasterCard</label>
            <label><input type="checkbox"> Discover Card</label>
            <label><input type="checkbox"> American Express</label>
            <label><input type="checkbox"> Electronic Funds Transfer</label>
        </div>
    </div>

    <div class="section">
        <p>Dollar amount to be charged:</p>
        <div class="checkbox-group">
            <label><input type="checkbox"> ${{ application_fee_amount }} application fee</label>
            <label><input type="checkbox"> ${{ enrollment_deposit_amount }} enrollment deposit</label>
        </div>
    </div>

    <div style="text-align: center; margin-top: 100px; font-size: 0.8em;">
        2016-2017
    </div>
</div>