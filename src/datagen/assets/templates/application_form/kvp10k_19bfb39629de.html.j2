<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; }
  .form-label { font-weight: bold; display: inline-block; width: 150px; }
  .form-field { border-bottom: 1px solid #000; display: inline-block; width: calc(100% - 160px); }
  .section-header { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
  .signature-line { border-bottom: 1px solid #000; width: 40%; margin-top: 50px; }
</style>

<div class="page">
  <div style="text-align: center; margin-bottom: 30px;">
    <h1 style="font-size: 24pt; margin: 0;">Department of Geology &amp; Geophysics</h1>
    <h2 style="font-size: 18pt; margin: 5px 0;">APPLICATION FOR UNDERGRADUATE RESEARCH</h2>
    <h3 style="font-size: 16pt; margin: 5px 0;">GEOL 3909</h3>
  </div>

  <p style="font-size: 10pt;">NOTE: A separate application needs to be filled out for each semester enrolled</p>

  <div style="margin-top: 20px;">
    <p>REQUEST DATE: <span data-field="request_date">{{ request_date }}</span></p>
  </div>

  <div class="section-header">STUDENT INFORMATION</div>

  <div style="margin-top: 15px;">
    <p>NAME: <span data-field="full_name">{{ full_name }}</span></p>
    <p>MAJOR(S): <span data-field="major">{{ major }}</span></p>
    <p>MINOR(S): <span data-field="minor">{{ minor }}</span></p>
    <p>LSU ID NUMBER: <span data-field="lsu_id_number">{{ lsu_id_number }}</span></p>
    <p>LSU GPA: <span data-field="lsu_gpa">{{ lsu_gpa }}</span></p>
    <p>LOCAL PHONE #: <span data-field="local_phone">{{ local_phone }}</span></p>
    <p>OVERALL GPA: <span data-field="overall_gpa">{{ overall_gpa }}</span></p>
    <p>CELL #: <span data-field="cell_phone">{{ cell_phone }}</span></p>
    <p>EMAIL: <span data-field="email">{{ email }}</span></p>
  </div>

  <div class="section-header" style="margin-top: 30px;">COURSE REQUEST</div>

  <div style="margin-top: 15px;">
    <p>SEMESTER (FALL, SPRING, SUMMER): <span data-field="semester">{{ semester }}</span> YEAR: <span data-field="year">{{ year }}</span></p>
    <p>COURSE: GEOL 3909 CREDIT HOURS: <span data-field="credit_hours">{{ credit_hours }}</span></p>
    <p style="font-size: 10pt;">NOTE: GEOL 3909, may be taken for up to 9 credits; variable credits; pre-requisite for GEOL 3999</p>
  </div>

  <div class="section-header" style="margin-top: 30px;">BACKGROUND</div>

  <div style="margin-top: 15px;">
    <p>COURSEWORK PERTINENT TO RESEARCH AREA:</p>
    <div style="height: 80px; border-bottom: 1px solid #000;" data-field="coursework_pertinent_to_research_area">{{ coursework_pertinent_to_research_area }}</div>
  </div>

  <div class="section-header" style="margin-top: 20px;">PRIOR RESEARCH EXPERIENCE:</div>
  <div style="height: 80px; border-bottom: 1px solid #000;" data-field="prior_research_experience">{{ prior_research_experience }}</div>

  <div class="section-header" style="margin-top: 20px;">INTERNSHIPS:</div>
  <div style="height: 80px; border-bottom: 1px solid #000;" data-field="internships">{{ internships }}</div>

  <div class="section-header" style="margin-top: 20px;">OTHER:</div>
  <div style="height: 80px; border-bottom: 1px solid #000;" data-field="other">{{ other }}</div>

  <div class="section-header" style="margin-top: 30px;">CONTRACT SIGNATURES:</div>

  <div style="margin-top: 20px;">
    <p>STUDENT NAME (PRINT): <span data-field="student_name_print">{{ student_name_print }}</span></p>
    <p>STUDENT SIGNATURE: <span data-field="student_signature_line">{{ student_signature_line }}</span> DATE: <span data-field="student_date">{{ student_date }}</span></p>
    <div style="margin-top: 10px;">
      <span data-field="student_signature_line" style="display: inline-block; width: 40%;">{{ student_signature_line }}</span>
      <span data-field="student_date" style="display: inline-block; width: 15%;">{{ student_date }}</span>
    </div>
  </div>

  <div style="margin-top: 30px;">
    <p>PROFESSOR NAME (PRINT): <span data-field="professor_name_print">{{ professor_name_print }}</span></p>
    <p>PROFESSOR SIGNATURE: <span data-field="professor_signature_line">{{ professor_signature_line }}</span> DATE: <span data-field="professor_date">{{ professor_date }}</span></p>
    <div style="margin-top: 10px;">
      <span data-field="professor_signature_line" style="display: inline-block; width: 40%;">{{ professor_signature_line }}</span>
      <span data-field="professor_date" style="display: inline-block; width: 15%;">{{ professor_date }}</span>
    </div>
  </div>
</div>

<div class="page">
  <div style="text-align: center; margin-bottom: 50px;">
    <h2 style="font-size: 18pt; margin: 0;">DO NOT FILL OUT</h2>
    <h3 style="font-size: 24pt; margin: 5px 0;">FOR OFFICE USE ONLY</h3>
  </div>

  <div style="margin-top: 50px;">
    <p>By signing below, I agree that this student has met all requirements to enroll in this course, and therefore, is able to participate in the research acknowledged above.</p>
  </div>

  <div style="margin-top: 100px;">
    <p>Signature of Undergraduate Advisor or Chair: <span data-field="advisor_signature_line">{{ advisor_signature_line }}</span> DATE: <span data-field="advisor_date">{{ advisor_date }}</span></p>
    <div style="margin-top: 10px;">
      <span data-field="advisor_signature_line" style="display: inline-block; width: 40%;">{{ advisor_signature_line }}</span>
      <span data-field="advisor_date" style="display: inline-block; width: 15%;">{{ advisor_date }}</span>
    </div>
  </div>
</div>