        </div>
        <div class="form-row">
          <label>Date:</label>
          <span data-field="cc_signature_date">{{ cc_signature_date }}</span>
        </div>
      </div>
    </div>

    <p class="small-text" style="margin-top: 30px;">
      This signature authorizes Josef Silny & Associates, Inc. (JS&A) to charge the amount for the requested services in U.S. dollars and the cardholder agrees to be bound by all Terms and Conditions (including that all fees are <strong>non-refundable</strong>) as stated in the JS&A application.
    </p>
  </div>
