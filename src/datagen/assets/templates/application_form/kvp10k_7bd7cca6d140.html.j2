      <label><input type="radio" name="payment_method" data-field="payment_method.mastercard" value="{{ payment_method.mastercard }}"> MASTERCARD</label>
      <label><input type="radio" name="payment_method" data-field="payment_method.discover" value="{{ payment_method.discover }}"> DISCOVER</label>
    </div>

    <div class="form-row" style="margin-top: 20px;">
      <label>in the total amount of $</label>
      <span data-field="total_amount">{{ total_amount }}</span>
      <span style="margin-left: 30px;">(total amount must be filled in order to process your order).</span>
    </div>

    <div class="form-row" style="margin-top: 20px;">
      <label>CREDIT CARD NUMBER:</label>
      <span data-field="cc_number">{{ cc_number }}</span>
    </div>

    <div class="two-column-form" style="margin-top: 20px;">
