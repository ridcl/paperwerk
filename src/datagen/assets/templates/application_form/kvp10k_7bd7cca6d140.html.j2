<div class="page">
  <h2 style="text-align: center; margin-bottom: 30px;">PERSONAL INFORMATION</h2>

  <div class="form-row">
    <label>If you have the UM Cane ID list it here:</label>
    <span data-field="um_cane_id">{{ um_cane_id }}</span>
  </div>

  <div class="form-row">
    <label>Which UM Graduate Department are you applying to:</label>
    <span data-field="um_department">{{ um_department }}</span>
  </div>

  <p class="small-text" style="margin-top: 20px;">
    Please use your name exactly as it appears on your passport.
  </p>

  <div class="two-column-form">
    <div>
      <div class="form-row">
        <label>Full name:</label>
        <span data-field="full_name">{{ full_name }}</span>
      </div>
      <div class="form-row">
        <label>Address:</label>
        <span data-field="address.street">{{ address.street }}</span>
      </div>
      <div class="form-row">
        <label>City:</label>
        <span data-field="address.city">{{ address.city }}</span>
      </div>
      <div class="form-row">
        <label>State:</label>
        <span data-field="address.state">{{ address.state }}</span>
      </div>
      <div class="form-row">
        <label>Country (if not US):</label>
        <span data-field="address.country">{{ address.country }}</span>
      </div>
      <div class="form-row">
        <label>Zip Code:</label>
        <span data-field="address.zip_code">{{ address.zip_code }}</span>
      </div>
    </div>
    <div>
      <div class="form-row">
        <label>First name:</label>
        <span data-field="first_name">{{ first_name }}</span>
      </div>
      <div class="form-row">
        <label>Middle name:</label>
        <span data-field="middle_name">{{ middle_name }}</span>
      </div>
      <div class="form-row">
        <label>Maiden name:</label>
        <span data-field="maiden_name">{{ maiden_name }}</span>
      </div>
      <div class="form-row">
        <label>Date of birth:</label>
        <span data-field="dob">{{ dob }}</span>
      </div>
      <div class="form-row">
        <label>Country of citizenship:</label>
        <span data-field="citizenship">{{ citizenship }}</span>
      </div>
      <div class="form-row">
        <label>Country of birth:</label>
        <span data-field="birth_country">{{ birth_country }}</span>
      </div>
    </div>
  </div>

  <div class="form-row" style="margin-top: 20px;">
    <label>Telephone:</label>
    <span data-field="phone.area_code">{{ phone.area_code }}</span> - <span data-field="phone.number">{{ phone.number }}</span>
    <span style="margin-left: 30px;">Fax:</span>
    <span data-field="fax_number">{{ fax_number }}</span>
  </div>

  <div class="form-row">
    <label>Area code and number:</label>
    <span data-field="area_code_number">{{ area_code_number }}</span>
    <span style="margin-left: 30px;">E-mail:</span>
    <span data-field="email_address">{{ email_address }}</span>
  </div>

  <div class="section-title" style="margin-top: 40px;">Type of Professional Service Requested:</div>
  <div style="display: flex; flex-wrap: wrap; gap: 20px; margin-bottom: 30px;">
    <div style="width: 48%;">
      <label><input type="checkbox" data-field="service_type.course_by_course_gpa" value="{{ service_type.course_by_course_gpa }}"> University Course-by-Course + GPA (US $180 basic fee)</label>
      <label><input type="checkbox" data-field="service_type.document_by_document_gpa" value="{{ service_type.document_by_document_gpa }}"> University Document-by-Document + GPA (US $120 basic fee)</label>
      <label><input type="checkbox" data-field="service_type.24_hour_evaluation" value="{{ service_type.24_hour_evaluation }}"> 24-Hour Evaluation (US $150 + basic fee)</label>
      <label><input type="checkbox" data-field="service_type.2_day_evaluation" value="{{ service_type.2_day_evaluation }}"> 2-Day Evaluation (US $100 + basic fee)</label>
      <label><input type="checkbox" data-field="service_type.5_day_evaluation" value="{{ service_type.5_day_evaluation }}"> 5-Day Evaluation (US $50 + basic fee)</label>
    </div>
    <div style="width: 48%;">
      <label><input type="checkbox" data-field="additional_services.extra_evaluation_report" value="{{ additional_services.extra_evaluation_report }}"> Extra Evaluation Report (US $20 per report) How many?</label>
      <span data-field="additional_services.extra_report_count">{{ additional_services.extra_report_count }}</span>
      <label><input type="checkbox" data-field="additional_services.translation" value="{{ additional_services.translation }}"> Translation (quote provided upon request)</label>
      <label><input type="checkbox" data-field="additional_services.other" value="{{ additional_services.other }}"> Other</label>
    </div>
  </div>

  <div class="form-row" style="margin-top: 20px;">
    <label>Have you used JS&A services previously?</label>
    <span data-field="previous_use.yes_no">{{ previous_use.yes_no }}</span>
    <span style="margin-left: 30px;">Evaluation:</span>
    <span data-field="previous_use.evaluation_type">{{ previous_use.evaluation_type }}</span>
    <span style="margin-left: 30px;">Date:</span>
    <span data-field="previous_use.date">{{ previous_use.date }}</span>
  </div>

  <div style="text-align: center; margin-top: 50px;">
    <p class="small-text" style="font-weight: bold;">ONE EVALUATION MUST BE SENT TO UM. LIST BELOW THE COMPLETE E-MAIL OR PHYSICAL ADDRESS FOR UM (AT US $20 PER REPORT):</p>
  </div>

  <div class="section-title" style="margin-top: 40px;">ACADEMIC HISTORY</div>
  <p class="small-text">
    Educational Institutions Attended (You must list all educational institutions you have attended. Begin with the first year of elementary school and include any school you are now attending.)
  </p>

  <table class="full-width-table">
    <thead>
      <tr class="table-header">
        <td class="table-cell" style="width: 20%;">Name of Institution</td>
        <td class="table-cell" style="width: 20%;">City, Country</td>
        <td class="table-cell" style="width: 20%;">Attendance From - To</td>
        <td class="table-cell" style="width: 20%;">Diplomas or Certificates</td>
        <td class="table-cell" style="width: 20%;">Year of Graduation</td>
      </tr>
    </thead>
    <tbody>
      {% for item in academic_history %}
      <tr class="table-row">
        <td class="table-cell"><span data-field="academic_history[{{ loop.index0 }}].institution_name">{{ academic_history[loop.index0].institution_name }}</span></td>
        <td class="table-cell"><span data-field="academic_history[{{ loop.index0 }}].city_country">{{ academic_history[loop.index0].city_country }}</span></td>
        <td class="table-cell"><span data-field="academic_history[{{ loop.index0 }}].attendance_period">{{ academic_history[loop.index0].attendance_period }}</span></td>
        <td class="table-cell"><span data-field="academic_history[{{ loop.index0 }}].diplomas_certificates">{{ academic_history[loop.index0].diplomas_certificates }}</span></td>
        <td class="table-cell"><span data-field="academic_history[{{ loop.index0 }}].graduation_year">{{ academic_history[loop.index0].graduation_year }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <p class="small-text" style="margin-top: 30px;">
    I certify that all information provided in this application is complete, factually accurate, and honestly presented. I certify that I have read the instructions and conditions (including that all fees are non-refundable) and agree to the terms stated herein. I understand that the evaluation is advisory and is not binding upon any agency or institution that uses it. I release Josef Silny & Associates, Inc. from any liability for damages resulting from the use to which this evaluation is put. I understand that the evaluation is based on the documents provided by me and that I am responsible for the accuracy of those documents. I understand that the evaluation is not a guarantee of admission to any school or program.
  </p>

  <div class="signature-line">
    <div class="signature-box">Signature of the applicant:</div>
    <div class="signature-box">Date:</div>
  </div>
</div>

