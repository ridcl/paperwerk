<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  /* Basic styling to mimic document structure */
  .form-section {
    margin-bottom: 20px;
  }
  .line-item {
    display: flex;
    margin-bottom: 10px;
  }
  .label-group {
    display: flex;
    justify-content: space-between;
    margin-bottom: 10px;
  }
  .field-row {
    display: flex;
    margin-bottom: 15px;
  }
  .field-row > div {
    flex: 1;
  }
  .input-line {
    border-bottom: 1px solid #000;
    min-width: 100px;
    display: inline-block;
  }
</style>

<div class="page">
  <header>
    <h1 style="text-align: center; font-size: 24pt; margin-bottom: 5px;">TEACHERS COLLEGE</h1>
    <h2 style="text-align: center; font-size: 18pt; margin-top: 0;">COLUMBIA UNIVERSITY</h2>
  </header>

  <div class="form-section" style="margin-top: 30px;">
    <p style="font-size: 11pt;">Application for College Tuition Grant for Baccalaureate Degree Candidates</p>
    <p style="font-size: 11pt;">This tuition benefit applies to Full-time Professional Staff and Members of Unions 2110 and 707 who have met their respective three (3) years or five (5) years of service. The benefit applies only if the student is enrolled in a degree program. A copy of the specific semester's bill must accompany this application each semester for which a grant is being requested. It is the responsibility of the eligible employee to submit the application and bill to Human Resources, 120 Whittier.</p>
  </div>

  <div class="form-section">
    <p style="font-size: 11pt;">Please type or print. This entire form must be completed. Use a separate application for each student.</p>
  </div>

  <!-- Section 1: Personal Information -->
  <div class="form-section">
    <div class="label-group">
      <div style="width: 30%;">1. NAME OF ELIGIBLE PARENT:</div>
      <div style="width: 60%; text-align: right;">TCID: <span data-field="tcid">{{ tcid }}</span></div>
    </div>

    <div class="field-row">
      <div style="width: 33%;">DEPARTMENT:</div>
      <div style="width: 33%;"><span class="input-line" style="border-bottom: 1px solid #000;"></span></div>
      <div style="width: 34%; text-align: right;">BOX: <span class="input-line" style="border-bottom: 1px solid #000;"></span> EXT: <span class="input-line" style="border-bottom: 1px solid #000;"></span></div>
    </div>

    <div class="field-row">
      <div style="width: 33%;">DATE OF HIRE:</div>
      <div style="width: 33%;"><span class="input-line" style="border-bottom: 1px solid #000;"></span></div>
      <div style="width: 34%; text-align: right;">EMAIL: <span class="input-line" style="border-bottom: 1px solid #000;"></span></div>
    </div>

    <div class="field-row">
      <div style="width: 33%;">2. FULL NAME OF STUDENT:</div>
      <div style="width: 33%;"><span class="input-line" style="border-bottom: 1px solid #000;"></span></div>
      <div style="width: 34%; text-align: right;">SSN: <span class="input-line" style="border-bottom: 1px solid #000;"></span></div>
    </div>

    <div class="field-row">
      <div style="width: 33%;">RELATIONSHIP:</div>
      <div style="width: 33%;"><span class="input-line" style="border-bottom: 1px solid #000;"></span></div>
      <div style="width: 34%; text-align: right;">DATE OF BIRTH: <span class="input-line" style="border-bottom: 1px solid #000;"></span></div>
    </div>

    <div class="field-row">
      <div style="width: 33%;">3. NAME OF UNIVERSITY OR COLLEGE:</div>
      <div style="width: 33%;"><span class="input-line" style="border-bottom: 1px solid #000;"></span></div>
      <div style="width: 34%;"></div>
    </div>

    <div class="field-row">
      <div style="width: 33%;">4. COLLEGE ADDRESS:</div>
      <div style="width: 67%;"><span class="input-line" style="border-bottom: 1px solid #000;"></span></div>
    </div>
  </div>

  <!-- Section 2: Enrollment Details -->
  <div class="form-section">
    <div class="label-group">
      <div style="width: 30%;">5. CLASS:</div>
      <div style="width: 60%; display: flex; gap: 15px; align-items: center;">
        <label><input type="checkbox"> Freshman</label>
        <label><input type="checkbox"> Sophomore</label>
        <label><input type="checkbox"> Junior</label>
        <label><input type="checkbox"> Senior</label>
      </div>
    </div>

    <div class="label-group">
      <div style="width: 30%;">6. TUITION EXCLUSIVE OF ALL OTHER FEES $</div>
      <div style="width: 70%; text-align: right;">PER SEMESTER <span class="input-line" style="border-bottom: 1px solid #000; width: 100px;"></span></div>
    </div>

    <div class="label-group">
      <div style="width: 30%;">7. WHAT SEMESTER IS THIS APPLICATION FOR?</div>
      <div style="width: 70%; display: flex; gap: 20px; align-items: center;">
        <label><input type="checkbox"> Summer</label>
        <label><input type="checkbox"> Fall</label>
        <label><input type="checkbox"> Winter</label>
        <label><input type="checkbox"> Spring</label>
        <label><input type="checkbox"> Year</label>
        <label><input type="checkbox"> Trimester</label>
      </div>
    </div>
  </div>

  <!-- Section 3: Remarks and Certification -->
  <div class="form-section">
    <div class="label-group">
      <div style="width: 30%;">8. REMARKS</div>
      <div style="width: 70%;"></div>
    </div>
    <div style="margin-bottom: 20px;">
      <div style="border: 1px solid #000; min-height: 80px; padding: 10px;">
        <span class="input-line" style="border-bottom: 1px solid #000; display: block; min-height: 70px;"></span>
      </div>
    </div>
  </div>

  <div class="form-section" style="margin-top: 30px;">
    <p style="font-size: 11pt;">I certify that the individual for whom I am requesting this benefit has one of the following relationships to me:</p>
    <div style="display: flex; gap: 30px; margin-top: 10px;">
      <label><input type="checkbox"> Natural or legally adopted child who has not reached the age of 27</label>
      <label><input type="checkbox"> Stepchild who lives in the same household for more than half the past year of the eligible staff member and has not reached the age of 24</label>
    </div>
    <p style="font-size: 11pt; margin-top: 20px;">I also certify that this individual <span data-field="is_dependent">{{ is_dependent }}</span> (is) <span data-field="is_not_dependent">{{ is_not_dependent }}</span> (is not) a dependent as defined by the IRS. If this person is not your dependent these payments will be treated as income and subject to tax. (Taxes are generally withheld in a series of equal amounts during the year such benefit is used.)</p>
  </div>

  <!-- Signature and Date -->
  <div class="form-section" style="margin-top: 50px;">
    <div style="display: flex; justify-content: space-between;">
      <div>
        <p style="font-size: 11pt;">Signature of Parent</p>
        <div style="border-bottom: 1px solid #000; margin-top: 5px; width: 200px;"></div>
      </div>
      <div>
        <p style="font-size: 11pt;">Date</p>
        <div style="border-bottom: 1px solid #000; margin-top: 5px; width: 200px;"></div>
      </div>
    </div>
  </div>

  <!-- Disclaimer -->
  <div class="form-section" style="margin-top: 50px;">
    <p style="font-size: 10pt;">PLEASE NOTE: According to Teachers College Policy 501.2 Section 4.1.10: An employee who leaves an eligible position prior to the end of the semester will receive a prorated benefit and may be subject to repayment, based on the time elapsed since the semester begins.</p>
  </div>

  <footer style="text-align: right; font-size: 9pt; margin-top: 50px;">
    Revised: March 2013
  </footer>
</div>