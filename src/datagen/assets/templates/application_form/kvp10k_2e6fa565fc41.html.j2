<!DOCTYPE html>
<html>
<head>
    <title>Study Abroad Award Application</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 {
            font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif;
        }
        .header-logo {
            text-align: center;
            margin-bottom: 20px;
        }
        .header-logo img {
            max-width: 150px;
        }
        .section-title {
            text-align: center;
            font-weight: bold;
            margin-bottom: 30px;
        }
        .form-row {
            display: flex;
            margin-bottom: 15px;
            align-items: flex-start;
        }
        .form-row > div {
            flex: 1;
        }
        .label {
            font-weight: bold;
            display: block;
            margin-bottom: 5px;
        }
        .input-area {
            border-bottom: 1px solid #000;
            min-height: 20px;
        }
        .signature-line {
            margin-top: 50px;
            border-top: 1px solid #000;
            padding-top: 5px;
            width: 50%;
        }
        .footer-note {
            font-size: 0.8em;
            margin-top: 40px;
            text-align: center;
        }
    </style>
</head>
<body>

<div class="page">
    <div class="header-logo">
        <!-- Placeholder for University Seal/Logo -->
        <img src="" alt="University Seal">
        <h1 style="font-size: 24pt; margin-top: 10px;">WESTERN MICHIGAN UNIVERSITY</h1>
    </div>

    <h2 class="section-title">MARY UPJOHN MEADER STUDY ABROAD AWARD</h2>

    <p>
        <span data-field="award_description_summary">{{ award_description_summary }}</span>
    </p>

    <p>
        <span data-field="award_details">{{ award_details }}</span>
    </p>

    <p>
        <span data-field="award_criteria">{{ award_criteria }}</span>
    </p>

    <ol>
        <li><span data-field="criteria_1">{{ criteria_1 }}</span></li>
        <li><span data-field="criteria_2">{{ criteria_2 }}</span></li>
        <li><span data-field="criteria_3">{{ criteria_3 }}</span></li>
    </ol>

    <p>
        <span data-field="award_funding_details">For the traditional study abroad experience up to five (5) awards at $2000 each may be given. For the geography field experience course up to twelve (12) awards at $1000 each may be given. All of these awards are contingent on the availability of the funds and qualified applicants. The award is credited directly to the student's account for tuition only. To apply for this scholarship please submit the following by <span data-field="application_deadline">{{ award_funding_details">For the traditional study abroad experience up to five (5) awards at $2000 each may be given. For the geography field experience course up to twelve (12) awards at $1000 each may be given. All of these awards are contingent on the availability of the funds and qualified applicants. The award is credited directly to the student's account for tuition only. To apply for this scholarship please submit the following by <span data-field= }}</span></span>
    </p>

    <h3 style="margin-top: 30px;">1. Application Form</h3>

    <p>
        <span data-field="application_requirements">{{ application_requirements }}</span>
    </p>
    <ol>
        <li><span data-field="statement_focus_1">{{ statement_focus_1 }}</span></li>
        <li><span data-field="statement_focus_2">{{ statement_focus_2 }}</span></li>
        <li><span data-field="statement_focus_3">{{ statement_focus_3 }}</span></li>
        <li><span data-field="statement_focus_4">{{ statement_focus_4 }}</span></li>
    </ol>

    <p>
        <span data-field="additional_requirements">{{ additional_requirements }}</span>
    </p>

    <p>
        <span data-field="final_report_requirement">{{ final_report_requirement }}</span>
    </p>

    <p>
        <span data-field="submission_method">{{ submission_method }}</span>
    </p>
</div>

<div class="page">
    <div style="text-align: center; margin-bottom: 40px;">
        <h3 style="font-size: 14pt;">Department of Geography</h3>
        <h1 style="font-size: 20pt;">Western Michigan University</h1>
        <p>1903 W. Michigan Ave. MS 5424</p>
        <p>Kalamazoo, MI 49008-5424</p>
        <p>E-mail: <span data-field="department_email">{{ department_email }}</span></p>
        <p>Phone: <span data-field="department_phone">{{ department_phone }}</span></p>
    </div>

    <div style="text-align: center; margin-bottom: 30px;">
        <p style="font-size: 0.9em;">* Be sure to check out the Arts & Sciences International Studies Scholarships at: <a href="http://wmich.edu/cas/academics/international/international-scholarship.html" style="color: blue;">wmich.edu/cas/academics/international/international-scholarship.html</a></p>
    </div>
</div>

<div class="page">
    <div style="text-align: center;">
        <p>(To be completed by the Department) Date of Submission: <span data-field="submission_date_placeholder">{{ submission_date_placeholder }}</span></p>
        <div class="header-logo" style="margin-top: 20px;">
            <!-- Placeholder for University Seal/Logo -->
            <img src="" alt="University Seal">
            <h1 style="font-size: 24pt;">WESTERN MICHIGAN UNIVERSITY</h1>
        </div>
    </div>

    <h2 class="section-title" style="margin-top: 40px;">MARY UPJOHN MEADER STUDY ABROAD AWARD</h2>
    <h3 style="text-align: center;">APPLICATION FORM</h3>
    <p style="text-align: center; margin-bottom: 30px;">All materials due by <span data-field="application_deadline_form">{{ application_deadline_form }}</span></p>

    <div class="form-row">
        <div style="flex: 1;">
            <label class="label">Name:</label>
            <div class="input-area"><span data-field="applicant_full_name">{{ applicant_full_name }}</span></div>
        </div>
        <div style="flex: 1;">
            <label class="label">WIN:</label>
            <div class="input-area"><span data-field="applicant_win">{{ applicant_win }}</span></div>
        </div>
    </div>

    <div class="form-row">
        <div style="flex: 1;">
            <label class="label">Local Address:</label>
            <div class="input-area"><span data-field="applicant_local_address">{{ applicant_local_address }}</span></div>
        </div>
        <div style="flex: 1;">
            <label class="label">GPA:</label>
            <div class="input-area"><span data-field="applicant_gpa">{{ applicant_gpa }}</span></div>
        </div>
    </div>

    <div class="form-row">
        <div style="flex: 1;">
            <label class="label">Permanent Address:</label>
            <div class="input-area"><span data-field="applicant_permanent_address">{{ applicant_permanent_address }}</span></div>
        </div>
        <div style="flex: 1;">
            <label class="label">Phone #: </label>
            <div class="input-area"><span data-field="applicant_phone">{{ applicant_phone }}</span></div>
        </div>
    </div>

    <div class="form-row" style="margin-top: 30px;">
        <div style="flex: 1;">
            <label class="label">Personal Statement (please mark to indicate that it is included with the application):</label>
            <div class="input-area" style="width: 80%;"><input type="checkbox"></div>
        </div>
    </div>

    <div class="form-row" style="margin-top: 30px;">
        <div style="flex: 1;">
            <label class="label">Letter of Enrollment/Commitment:</label>
            <div class="input-area"><span data-field="enrollment_letter_name">{{ enrollment_letter_name }}</span></div>
        </div>
    </div>

    <div style="margin-top: 80px;">
        <div class="signature-line">
            Name:
        </div>
    </div>
</div>

</body>
</html>