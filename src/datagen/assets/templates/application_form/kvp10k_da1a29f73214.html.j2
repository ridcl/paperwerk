<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  table { width: 100%; border-collapse: collapse; margin-bottom: 15px; }
  td { padding: 5px; border: 1px solid #ccc; }
  .form-row td { padding: 2px 0; }
</style>

<div class="page">
  <div style="text-align: center; margin-bottom: 20px;">
    <h1 style="font-size: 18pt; margin: 0;">AMITY LAW SCHOOL, DELHI</h1>
    <p style="font-size: 10pt; margin: 2px 0;">An Institution of Ritnand Balved Education Foundation (RBEF)</p>
    <p style="font-size: 10pt; margin: 2px 0;">Affiliated to <span data-field="university_name">{{ university_name }}</span>, Delhi</p>
    <p style="font-size: 10pt; margin: 2px 0;">Amity Campus, F-1 Block, Sector-125, Noida (U.P.)</p>
    <p style="font-size: 9pt; margin: 5px 0;">Tel. No. <span data-field="phone_number">{{ phone_number }}</span> Fax: <span data-field="fax_number">{{ fax_number }}</span> E-mail: <span data-field="email_address">{{ email_address }}</span></p>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Application form for Management Seats for B.A. LL.B (H) of</p>
    <p style="font-weight: bold;">Amity Law School for the Academic session <span data-field="academic_session">{{ academic_session }}</span></p>
  </div>

  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px;">
    <div>
      <p style="font-weight: bold;">1. Name of the programme applied for</p>
      <p style="font-weight: bold;">B.A. LL.B (H)</p>
    </div>
    <div>
      <p style="font-weight: bold;">Affix Photograph</p>
      <div style="width: 100px; height: 100px; border: 1px solid #000;"></div>
    </div>
  </div>

  <form>
    <table style="margin-bottom: 15px;">
      <tr class="form-row">
        <td style="width: 25%;">2. GGSIPU* CET ROLL NO.</td>
        <td style="width: 75%;">
          <span style="font-size: 9pt;">* Guru Gobind Singh Indraprastha University (GGSIPU)</span>
          <br>
          <div style="display: flex; gap: 10px;">
            <div style="flex-grow: 1;"><input type="text" style="width: 100%; border: 1px solid #000;" data-field="guru_gobind_singh_indraprastha_universit" value="{{ guru_gobind_singh_indraprastha_universit }}"></div>
          </div>
        </td>
      </tr>
    </table>

    <table style="margin-bottom: 15px;">
      <tr class="form-row">
        <td style="width: 25%;">3. CANDIDATE'S 1st NAME (in capitals)</td>
        <td style="width: 25%;">MIDDLE NAME</td>
        <td style="width: 50%;">SURNAME</td>
      </tr>
      <tr class="form-row">
        <td><div style="display: flex; gap: 5px;"><input type="text" style="width: 100%; border: 1px solid #000;" data-field="surname" value="{{ surname }}"></div></td>
        <td><div style="display: flex; gap: 5px;"><input type="text" style="width: 100%; border: 1px solid #000;" data-field="surname_2" value="{{ surname_2 }}"></div></td>
        <td><div style="display: flex; gap: 5px;"><input type="text" style="width: 100%; border: 1px solid #000;" data-field="surname_3" value="{{ surname_3 }}"></div></td>
      </tr>
    </table>

    <table style="margin-bottom: 15px;">
      <tr class="form-row">
        <td style="width: 25%;">4. NAME OF FATHER (in capitals)</td>
        <td style="width: 25%;">MIDDLE NAME</td>
        <td style="width: 50%;">SURNAME</td>
      </tr>
      <tr class="form-row">
        <td><div style="display: flex; gap: 5px;"><input type="text" style="width: 100%; border: 1px solid #000;" data-field="surname_4" value="{{ surname_4 }}"></div></td>
        <td><div style="display: flex; gap: 5px;"><input type="text" style="width: 100%; border: 1px solid #000;" data-field="surname_5" value="{{ surname_5 }}"></div></td>
        <td><div style="display: flex; gap: 5px;"><input type="text" style="width: 100%; border: 1px solid #000;" data-field="surname_6" value="{{ surname_6 }}"></div></td>
      </tr>
    </table>

    <table style="margin-bottom: 15px;">
      <tr class="form-row">
        <td style="width: 25%;">5. NAME OF MOTHER (in capitals)</td>
        <td style="width: 25%;">MIDDLE NAME</td>
        <td style="width: 50%;">SURNAME</td>
      </tr>
      <tr class="form-row">
        <td><div style="display: flex; gap: 5px;"><input type="text" style="width: 100%; border: 1px solid #000;" data-field="surname_7" value="{{ surname_7 }}"></div></td>
        <td><div style="display: flex; gap: 5px;"><input type="text" style="width: 100%; border: 1px solid #000;" data-field="surname_8" value="{{ surname_8 }}"></div></td>
        <td><div style="display: flex; gap: 5px;"><input type="text" style="width: 100%; border: 1px solid #000;" data-field="surname_9" value="{{ surname_9 }}"></div></td>
      </tr>
    </table>

    <table style="margin-bottom: 15px;">
      <tr class="form-row">
        <td style="width: 25%;">6. COMPLETE POSTAL ADDRESS (in capitals) (Do not repeat name)</td>
        <td style="width: 75%;">
          <div style="display: flex; gap: 5px;">
            <input type="text" style="width: 100%; border: 1px solid #000;" data-field="field_1" value="{{ field_1 }}">
          </div>
        </td>
      </tr>
      <tr class="form-row">
        <td style="width: 25%;">STATE</td>
        <td style="width: 25%;">PIN CODE</td>
        <td style="width: 50%;"></td>
      </tr>
      <tr class="form-row">
        <td><div style="display: flex; gap: 5px;"><input type="text" style="width: 100%; border: 1px solid #000;" data-field="pin_code" value="{{ pin_code }}"></div></td>
        <td><div style="display: flex; gap: 5px;"><input type="text" style="width: 100%; border: 1px solid #000;" data-field="pin_code_2" value="{{ pin_code_2 }}"></div></td>
        <td><div style="display: flex; gap: 5px;"><input type="text" style="width: 100%; border: 1px solid #000;" data-field="pin_code_3" value="{{ pin_code_3 }}"></div></td>
      </tr>
    </table>

    <table style="margin-bottom: 15px;">
      <tr class="form-row">
        <td style="width: 25%;">TELEPHONE/MOBILE</td>
        <td style="width: 25%;">E-MAIL</td>
        <td style="width: 50%;"></td>
      </tr>
      <tr class="form-row">
        <td><div style="display: flex; gap: 5px;"><input type="text" style="width: 100%; border: 1px solid #000;" data-field="e_mail" value="{{ e_mail }}"></div></td>
        <td><div style="display: flex; gap: 5px;"><input type="text" style="width: 100%; border: 1px solid #000;" data-field="e_mail_2" value="{{ e_mail_2 }}"></div></td>
        <td></td>
      </tr>
    </table>

    <table style="margin-bottom: 15px;">
      <tr class="form-row">
        <td style="width: 25%;">7. DATE OF BIRTH (in Christian era)</td>
        <td style="width: 25%;">DAY</td>
        <td style="width: 25%;">MONTH</td>
        <td style="width: 25%;">YEAR</td>
      </tr>
      <tr class="form-row">
        <td></td>
        <td><div style="display: flex; gap: 10px;"><input type="radio" name="day" style="width: 10px;"></div></td>
        <td><div style="display: flex; gap: 10px;"><input type="radio" name="month" style="width: 10px;"></div></td>
        <td><div style="display: flex; gap: 10px;"><input type="radio" name="year" style="width: 10px;"></div></td>
      </tr>
    </table>

    <table style="margin-bottom: 15px;">
      <tr class="form-row">
        <td style="width: 25%;">8. SEX (Tick / in appropriate box)</td>
        <td style="width: 25%;">M</td>
        <td style="width: 25%;">F</td>
      </tr>
      <tr class="form-row">
        <td></td>
        <td><div style="display: flex; gap: 10px;"><input type="radio" name="sex" style="width: 10px;"></div></td>
        <td><div style="display: flex; gap: 10px;"><input type="radio" name="sex" style="width: 10px;"></div></td>
      </tr>
    </table>
  </form>
</div>

<div class="page">
  <h2 style="font-size: 14pt; margin-bottom: 15px;">9. DETAILS OF QUALIFYING EXAMINATION PASSED :</h2>

  <table style="margin-bottom: 20px;">
    <thead>
      <tr>
        <th style="width: 10%;">Exam</th>
        <th style="width: 15%;">Board</th>
        <th style="width: 10%;">Roll No./Year</th>
        <th style="width: 35%;">Name / Address of School Institution attended</th>
        <th style="width: 20%;">Subjects studies</th>
        <th style="width: 20%;">Percentage of marks in each subject</th>
      </tr>
    </thead>
    <tbody>
      {% for item in qualifying_exams %}
      <tr>
        <td><span data-field="qualifying_exams[{{ loop.index0 }}].exam_name">{{ item.exam_name }}</span></td>
        <td><span data-field="qualifying_exams[{{ loop.index0 }}].board_name">{{ item.board_name }}</span></td>
        <td><span data-field="qualifying_exams[{{ loop.index0 }}].roll_year">{{ item.roll_year }}</span></td>
        <td><span data-field="qualifying_exams[{{ loop.index0 }}].school_details">{{ item.school_details }}</span></td>
        <td><span data-field="qualifying_exams[{{ loop.index0 }}].subjects">{{ item.subjects }}</span></td>
        <td><span data-field="qualifying_exams[{{ loop.index0 }}].percentage">{{ item.percentage }}</span></td>
      </tr>
      {% endfor %}
      <tr>
        <td colspan="6" style="padding-top: 10px;">
          <div style="display: flex; gap: 10px;">
            <div style="flex-grow: 1;"><input type="text" style="width: 100%; border: 1px solid #000;" data-field="field_2" value="{{ field_2 }}"></div>
          </div>
        </td>
      </tr>
    </tbody>
  </table>

  <div style="text-align: right; margin-bottom: 30px;">
    <p style="font-weight: bold;">Percentage of best of four subjects:</p>
    <div style="width: 300px; border-bottom: 1px solid #000;" data-field="percentage_of_best_of_four_subjects">{{ percentage_of_best_of_four_subjects }}</div>
  </div>

  <div style="margin-top: 40px;">
    <p style="font-weight: bold;">DECLARATION</p>
    <p style="margin-top: 10px;">I hereby solemnly and sincerely affirm that I fulfill the eligibility conditions prescribed by the GGS IP University and that the statements made and information furnished by me in this application form are true and correct. Also I have not withheld any information. If it is found that any information furnished herein is fraudulent, incorrect or untrue in material particulars, I realize that I am liable to prosecution and that the admission to the programme is liable to be cancelled.</p>

    <table style="margin-top: 40px;">
      <tr>
        <td style="width: 50%;">Date: <span data-field="declaration_date">{{ declaration_date }}</span></td>
        <td style="width: 50%; text-align: right;">Signature of the Candidate</td>
      </tr>
      <tr>
        <td style="width: 50%;">I have carefully read and verified the information furnished by me as parent and by my son/daughter/ward and affirm that it is true and correct.</td>
        <td style="width: 50%; text-align: right;">Signature of the Father/Mother</td>
      </tr>
    </table>
  </div>

  <div style="margin-top: 50px; font-size: 9pt;">
    <p>Eligibility Conditions : Please see Chapter 2(4) Professional Programmes Chapter (2.4.2) Programme of Studies at Graduation Level (121) and (2) of the Part of Admission Brochure for Academic Session 2015-16 Page No. 19 & 21. The candidate must have passed the 10+2 examination with a minimum of 50% marks in aggregate and marks in each subject. Aggregate of 50% marks in the 12th class for the purpose of eligibility will be calculated on the aggregate of best four subjects. The candidate must have passed the qualifying examination as per the University norms. The details of compulsory subject(s) whatever applicable will be notified on university website before start of the counseling.</p>
  </div>
</div>