<div class="page">
  <div style="text-align: center; margin-bottom: 40px;">
    <img src="placeholder_logo.png" alt="Shoreline Community College Logo" style="height: 60px;">
    <h2 style="margin-top: 10px;">Request for International Transfer Credit</h2>
  </div>

  <h3 style="margin-bottom: 20px;">Student Information</h3>
  <table style="margin-bottom: 30px;">
    <tr>
      <td style="width: 15%;">Student Name:</td>
      <td style="width: 25%;">Last: <span data-field="student_last">{{ student_last }}</span></td>
      <td style="width: 25%;">First: <span data-field="student_first">{{ student_first }}</span></td>
      <td style="width: 15%;">Middle: <span data-field="student_middle">{{ student_middle }}</span></td>
      <td style="width: 20%;">Student ID #: <span data-field="student_id">{{ student_id }}</span></td>
    </tr>
    <tr>
      <td>Address:</td>
      <td colspan="4">
        <div class="inline-fields">
          <div style="width: 30%;">Street Address: <span data-field="address_street">{{ address_street }}</span></div>
          <div style="width: 20%;">Apt. #: <span data-field="address_apt">{{ address_apt }}</span></div>
        </div>
        <div class="inline-fields" style="margin-top: 5px;">
          <div style="width: 25%;">City: <span data-field="address_city">{{ address_city }}</span></div>
          <div style="width: 15%;">State: <span data-field="address_state">{{ address_state }}</span></div>
          <div style="width: 15%;">Zip: <span data-field="address_zip">{{ address_zip }}</span></div>
          <div style="width: 25%;">Phone: <span data-field="address_phone">{{ address_phone }}</span></div>
        </div>
      </td>
    </tr>
    <tr>
      <td>Email Address: <span data-field="student_email">{{ student_email }}</span></td>
      <td>Today's Date: <span data-field="today_date">{{ today_date }}</span></td>
    </tr>
  </table>

  <h3 style="margin-bottom: 20px;">Which Transfer Degree Do You Intend To Complete At Shoreline? (select one)</h3>
  <div style="border: 1px solid #ccc; padding: 15px;">
    <div class="form-group">
      <input type="checkbox" id="aa_dta" name="degree_option">
      <label for="aa_dta">AA-DTA Associate of Arts transfer degree</label>
    </div>
    <div class="form-group">
      <input type="checkbox" id="as_track1" name="degree_option">
      <label for="as_track1">AS-Track 1 Associate in Science transfer degree</label>
    </div>
    <div class="form-group">
      <input type="checkbox" id="as_track2" name="degree_option">
      <label for="as_track2">AS-Track 2 Associate in Science transfer degree</label>
    </div>
    <div class="form-group">
      <input type="checkbox" id="aa_ip" name="degree_option">
      <label for="aa_ip">AA-IP Associate of Arts Individualized Plan</label>
    </div>
    <div class="form-group">
      <input type="checkbox" id="aa_dta_as1_as2" name="degree_option">
      <label for="aa_dta_as1_as2">AA DTA, AS-T1, AS-T2 MRP:</label>
    </div>
  </div>

  <p style="margin-top: 20px; font-size: 0.9em;">Note: This service is available only to degree seeking, academic transfer students. All other requests should be directed to the specific program or area of study.</p>

  <h3 style="margin-top: 30px;">I Would Like To Request An Evaluation Of My Transcripts From:</h3>
  <table style="margin-bottom: 30px;">
    <tr>
      <td style="width: 15%;">Name of School:</td>
      <td colspan="3"><span data-field="school_name">{{ school_name }}</span></td>
    </tr>
    <tr>
      <td>Address:</td>
      <td style="width: 25%;">City: <span data-field="school_city">{{ school_city }}</span></td>
      <td style="width: 25%;">Country: <span data-field="school_country">{{ school_country }}</span></td>
    </tr>
    <tr>
      <td>Dates Attended:</td>
      <td style="width: 25%;">From: <span data-field="school_from_date">{{ school_from_date }}</span></td>
      <td style="width: 25%;">To: <span data-field="school_to_date">{{ school_to_date }}</span></td>
    </tr>
  </table>

  <div class="form-group">
    <input type="checkbox" id="professional_evaluation" name="professional_evaluation">
    <label for="professional_evaluation">My professional evaluation (original copy) is attached to this form:</label>
  </div>

  <h3 style="margin-top: 30px;">My professional evaluation is being sent from:</h3>
  <p>Please return this form to Enrollment Services on the second floor of the FOSS/5000 building or via email: <span data-field="enrollment_services_email_2">{{ enrollment_services_email_2 }}</span></p>
</div>

