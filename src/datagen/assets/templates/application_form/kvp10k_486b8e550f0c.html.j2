<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; }
  .form-label { font-weight: bold; display: inline-block; width: 150px; }
  .form-field { border-bottom: 1px solid #000; display: inline-block; width: calc(100% - 160px); }
  .signature-line { border-bottom: 1px solid #000; margin-top: 50px; margin-bottom: 50px; width: 80%; }
  .text-area { border: 1px solid #000; height: 150px; width: 100%; padding: 10px; box-sizing: border-box; font-family: inherit; }
</style>

<div class="page">
  <div style="text-align: center; margin-bottom: 40px;">
    <img src="logo_placeholder.png" alt="Drury University Logo" style="height: 60px;">
    <h1 style="font-size: 18pt; margin-top: 10px;">DRURY UNIVERSITY</h1>
    <p style="font-size: 10pt; margin-top: 5px;">900 N. Benton Avenue Springfield, MO 65802 417-873-7879</p>
  </div>

  <div style="margin-bottom: 30px;">
    <p>Application: <span data-field="application_type">{{ application_type }}</span></p>
  </div>

  <div style="margin-bottom: 20px;">
    <p>Date: <span data-field="date_submitted">{{ date_submitted }}</span></p>
    <p>Student Number: <span data-field="student_number">{{ student_number }}</span></p>
  </div>

  <div style="margin-bottom: 20px;">
    <p>Legal Name (please print): <span data-field="full_name">{{ full_name }}</span></p>
  </div>

  <div style="margin-bottom: 20px;">
    <p>Drury History Adviser: <span data-field="adviser_name">{{ adviser_name }}</span></p>
  </div>

  <div style="margin-bottom: 20px;">
    <p>Current GPA: <span data-field="current_gpa">{{ current_gpa }}</span></p>
  </div>

  <div style="margin-bottom: 20px;">
    <p>Current GPA in History: <span data-field="history_gpa">{{ history_gpa }}</span></p>
  </div>

  <div style="margin-bottom: 20px;">
    <p>Total Hours Completed in History: <span data-field="total_hours_completed">{{ total_hours_completed }}</span></p>
  </div>

  <div style="margin-bottom: 20px;">
    <p>Date of anticipated graduation: <span data-field="graduation_date">{{ graduation_date }}</span> (mm/dd/year)</p>
  </div>

  <div style="margin-bottom: 20px;">
    <p>Signature, Director, Honors Thesis in History: <span data-field="director_signature_line">{{ director_signature_line }}</span></p>
  </div>

  <div style="margin-bottom: 20px;">
    <p>
      <input type="checkbox" style="margin-right: 5px;"> I have attached transcript
    </p>
  </div>

  <div style="margin-bottom: 20px;">
    <p>Signature of Student: <span data-field="student_signature_line">{{ student_signature_line }}</span></p>
  </div>

  <div style="margin-bottom: 20px;">
    <p>Signature, Chair of Department: <span data-field="chair_signature_line">{{ chair_signature_line }}</span></p>
  </div>

  <div style="margin-bottom: 30px;">
    <p>Expected panel of history faculty:</p>
    <div class="text-area" style="height: 150px;">
      <!-- Placeholder for expected panel names -->
    </div>
  </div>

  <div style="margin-top: 50px; font-size: 10pt;">
    Must be turned by April 15 of the <span data-field="semester_name">{{ semester_name }}</span> before you enroll in HIST 494, Senior Seminar.
  </div>
</div>