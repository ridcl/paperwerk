<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif; }
  h1, h2 { font-weight: bold; }
  .form-row { display: flex; margin-bottom: 10px; }
  .form-row > div { flex: 1; padding: 5px 0; }
  .input-field { border-bottom: 1px solid #000; padding: 0 5px; min-width: 100px; }
  .grid-table { width: 100%; border-collapse: collapse; margin-top: 15px; }
  .grid-table th, .grid-table td { border: 1px solid #000; padding: 8px; text-align: left; }
  .grid-table th { background-color: #f0f0f0; }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
    <h1 style="font-size: 24pt; margin: 0;">West Chester University</h1>
    <div>
      <p style="font-weight: bold;">For Office Use Only</p>
      <div style="display: flex; gap: 30px;">
        <div>Session I</div>
        <div>Session II</div>
        <div>Post-Session</div>
      </div>
      <div style="margin-top: 10px;">
        <label>Date Rec'd:</label>
        <div class="input-field" style="width: 150px;">{{ date_received }}</div>
      </div>
    </div>
  </div>

  <h2 style="font-size: 18pt; margin-top: 30px;">Weekly Application for Meal Plan Only (NO HOUSING)</h2>
  <h3 style="font-size: 16pt; margin-top: 10px;">Summer {{ current_year }}</h3>

  <!-- Name Section -->
  <div style="margin-top: 30px;">
    <div style="display: flex; align-items: center; margin-bottom: 10px;">
      <span style="width: 80px; font-weight: bold;">Name</span>
      <div style="flex-grow: 1; display: flex; gap: 20px;">
        <div style="width: 33%;">
          <span style="font-weight: bold;">Last</span>
          <div class="input-field" style="width: 100%;">{{ last_name }}</div>
        </div>
        <div style="width: 33%;">
          <span style="font-weight: bold;">First</span>
          <div class="input-field" style="width: 100%;">{{ first_name }}</div>
        </div>
        <div style="width: 33%;">
          <span style="font-weight: bold;">Middle Initial</span>
          <div class="input-field" style="width: 100%;">{{ middle_initial }}</div>
        </div>
      </div>
    </div>
  </div>

  <!-- WCU ID -->
  <div style="margin-top: 20px;">
    <span style="font-weight: bold;">WCU ID</span>
    <div class="input-field" style="width: 300px; margin-left: 10px;">{{ wcu_id }}</div>
  </div>

  <!-- Permanent Address -->
  <div style="margin-top: 30px;">
    <span style="font-weight: bold;">Permanent Address</span>
    <div style="display: flex; gap: 20px; margin-top: 10px;">
      <div style="flex: 2;">
        <span style="font-weight: bold;">Street</span>
        <div class="input-field" style="width: 100%;">{{ permanent_address_street }}</div>
      </div>
      <div style="flex: 1;">
        <span style="font-weight: bold;">City/Town</span>
        <div class="input-field" style="width: 100%;">{{ permanent_address_city }}</div>
      </div>
      <div style="flex: 1;">
        <span style="font-weight: bold;">State</span>
        <div class="input-field" style="width: 100%;">{{ permanent_address_state }}</div>
      </div>
      <div style="flex: 1;">
        <span style="font-weight: bold;">Zip Code</span>
        <div class="input-field" style="width: 100%;">{{ permanent_address_zip }}</div>
      </div>
      <div style="flex: 2;">
        <span style="font-weight: bold;">Home Phone</span>
        <div class="input-field" style="width: 100%;">{{ permanent_address_phone }}</div>
      </div>
    </div>
  </div>

  <!-- Current Local Address -->
  <div style="margin-top: 30px;">
    <span style="font-weight: bold;">Current Local Address (on campus)</span>
    <div style="display: flex; gap: 20px; margin-top: 10px;">
      <div style="flex: 2;">
        <span style="font-weight: bold;">Street</span>
        <div class="input-field" style="width: 100%;">{{ local_address_street }}</div>
      </div>
      <div style="flex: 1;">
        <span style="font-weight: bold;">City/Town</span>
        <div class="input-field" style="width: 100%;">{{ local_address_city }}</div>
      </div>
      <div style="flex: 1;">
        <span style="font-weight: bold;">State</span>
        <div class="input-field" style="width: 100%;">{{ local_address_state }}</div>
      </div>
      <div style="flex: 1;">
        <span style="font-weight: bold;">Zip Code</span>
        <div class="input-field" style="width: 100%;">{{ local_address_zip }}</div>
      </div>
      <div style="flex: 2;">
        <span style="font-weight: bold;">Local Phone</span>
        <div class="input-field" style="width: 100%;">{{ local_address_phone }}</div>
      </div>
    </div>
  </div>

  <!-- Email Preference -->
  <div style="margin-top: 30px;">
    <span style="font-weight: bold;">PREFERRED EMAIL ADDRESS:</span>
    <div class="input-field" style="width: 600px; margin-left: 10px;">{{ preferred_email }}</div>
  </div>

  <!-- Student Status Checkboxes -->
  <div style="margin-top: 30px;">
    <span style="font-weight: bold;">Check one:</span>
    <div style="margin-top: 10px;">
      <label><input type="radio" name="status" value="graduate"> Graduate Student</label>
      <label style="margin-left: 20px;"><input type="radio" name="status" value="senior"> Senior</label>
      <label style="margin-left: 20px;"><input type="radio" name="status" value="junior"> Junior</label>
      <label style="margin-left: 20px;"><input type="radio" name="status" value="sophomore"> Sophomore</label>
      <label style="margin-left: 20px;"><input type="radio" name="status" value="freshman"> Freshman</label>
    </div>
  </div>

  <!-- Courses Registered For -->
  <div style="margin-top: 30px;">
    <span style="font-weight: bold;">Courses you are registered for:</span>
    <table class="grid-table">
      <thead>
        <tr>
          <th style="width: 10%;">#</th>
          <th style="width: 40%;">Course Name</th>
          <th style="width: 15%;">Course No #</th>
          <th style="width: 15%;">Credits</th>
          <th style="width: 20%;">Dates</th>
        </tr>
      </thead>
      <tbody>
        {% for i in range(1, 5) %}
        <tr>
          <td>{{ i }}</td>
          <td><div class="input-field" style="width: 100%;">{{ course_name[i-1] }}</div></td>
          <td><div class="input-field" style="width: 100%;">{{ course_number[i-1] }}</div></td>
          <td><div class="input-field" style="width: 100%;">{{ credits[i-1] }}</div></td>
          <td><div class="input-field" style="width: 100%;">{{ course_dates[i-1] }}</div></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <!-- Meal Plan Options -->
  <div style="margin-top: 40px;">
    <table class="grid-table">
      <thead>
        <tr>
          <th style="width: 25%;">Meal Plan Option</th>
          <th style="width: 15%;">Fee Per Week</th>
          <th style="width: 35%;">Please Check the Meal Plan That You Wish to Sign Up For</th>
          <th style="width: 25%;">Please Choose the Session(s) That You Wish to Sign Up For</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>14 Meal Plan</td>
          <td>$72.00</td>
          <td><input type="checkbox" name="plan_14" value="yes"> 14 Meal Plan</td>
          <td><input type="checkbox" name="session_i" value="yes"> Session I</td>
        </tr>
        <tr>
          <td>19 Meal Plan</td>
          <td>$82.00</td>
          <td><input type="checkbox" name="plan_19" value="yes"> 19 Meal Plan</td>
          <td><input type="checkbox" name="session_ii" value="yes"> Session II</td>
        </tr>
        <tr>
          <td></td>
          <td></td>
          <td></td>
          <td><input type="checkbox" name="session_post" value="yes"> Post-Session</td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- Disclaimer -->
  <div style="margin-top: 50px; font-size: 10pt;">
    <p>Please sign me up for the meal plan and sessions checked above. I understand that cancellations must be received by the Office of Residence Life and Housing Services three working days prior to the beginning of the session to guarantee a full refund. I understand that my account will be billed and that payment arrangements are to be made at the Office of the Bursar. Submission of this form states that you have completed and agreed with all information in this form.</p>
  </div>

  <!-- Signature Block -->
  <div style="margin-top: 60px; padding: 20px; border: 1px solid #000; text-align: center;">
    <p style="font-weight: bold;">Click Here to submit via e-mail, OR print completed form and return to Residence Life and Housing Services, West Chester University of Pennsylvania, 202 Lawrence Center, West Chester, PA, 19383</p>
  </div>
</div>