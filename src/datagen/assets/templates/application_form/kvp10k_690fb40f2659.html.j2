        <td style="width: 20%; padding-top: 10px;">State: _________</td>
        <td style="width: 20%; padding-top: 10px;">Zip Code: _________</td>
      </tr>
      <tr>
        <td style="width: 30%; padding-top: 10px;">Tel. #: _________________________</td>
        <td style="width: 20%; padding-top: 10px;">Cell #: _________________________</td>
      </tr>
    </table>
  </div>
</div>

<div class="page">
  <h3 style="font-size: 14pt; margin-top: 0;">Educational Background:</h3>
  <div style="margin-bottom: 20px;">
    <table style="width: 100%;">
      <tr>
        <td style="width: 30%; padding-top: 10px;">Highest Level of Education: _________________________</td>
        <td style="width: 70%; padding-top: 10px;">College / University: _________________________</td>
      </tr>
