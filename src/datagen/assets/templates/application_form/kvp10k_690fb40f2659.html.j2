  <h3 style="font-size: 14pt; margin-top: 30px;">3.) Continuing Education Courses: Please select the course(s) you would like to enroll.</h3>
  <table style="width: 100%; margin-top: 15px;">
    <thead>
      <tr>
        <th style="width: 5%;"></th>
        <th style="width: 45%;">Course Details</th>
        <th style="width: 15%;">Fee / CEU Credit</th>
      </tr>
    </thead>
    <tbody>
      {% for item in courses %}
