<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
  }
  td, th {
    padding: 8px;
    text-align: left;
  }
  .header-bar {
    display: flex;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px solid #ccc;
  }
  .logo-area {
    display: flex;
    align-items: center;
    margin-top: 30px;
  }
  .logo-text {
    text-align: center;
    margin-bottom: 20px;
  }
  .signature-box {
    border: 1px solid #ccc;
    padding: 20px;
    margin-top: 20px;
  }
</style>

<div class="page">
  <div class="header-bar">
    <div style="margin-right: 15px;">&#9776;</div>
    <h1 style="font-size: 18pt; margin: 0;">Office of Continuing Education and Service-Learning</h1>
  </div>

  <div style="background-color: #f9b300; padding: 40px; margin-top: 40px; border-radius: 5px;">
    <p style="font-size: 14pt; margin: 0;">
      <span style="color: #333;">&gt;</span> The Office of Continuing Education and Service-Learning is pleased to announce its <span data-field="schedule_year">{{ schedule_year }}</span> spring schedule of classes...
    </p>
  </div>

  <div style="background-color: #333; color: white; padding: 40px; border-radius: 5px; margin-top: 40px;">
    <div class="logo-area">
      <div style="flex-grow: 1;">
        <div class="logo-text">
          <h2 style="font-size: 24pt; margin: 0;">GRAMBLING</h2>
          <p style="font-size: 10pt; margin: 2px 0;">STATE UNIVERSITY</p>
          <p style="font-size: 10pt; margin: 2px 0;">WHERE EVERYBODY IS SOMEBODY</p>
        </div>
      </div>
      <div style="width: 150px; text-align: right;">
        <!-- Placeholder for University Logo -->
        <svg width="100%" height="100%" viewBox="0 0 100 100" style="display: block;">
          <circle cx="50" cy="50" r="45" fill="#FFD700"/>
          <path d="M 50 5 L 50 95 M 5 50 L 95 50" stroke="black" stroke-width="5" fill="none"/>
        </svg>
      </div>
    </div>
    <div style="margin-top: 20px; text-align: center; font-size: 10pt;">
      <p>Office of Continuing Education and Service-Learning</p>
      <p>GSU Box <span data-field="box_number">{{ box_number }}</span></p>
      <p><span data-field="street_address">{{ street_address }}</span>, <span data-field="city">{{ city }}</span>, <span data-field="state">{{ state }}</span> <span data-field="zip_code">{{ zip_code }}</span></p>
      <p>Phone: <span data-field="phone_number">{{ phone_number }}</span> / <span data-field="phone_number_2">{{ phone_number_2 }}</span></p>
      <p>Fax: <span data-field="fax_number">{{ fax_number }}</span></p>
      <p>E-mail: <span data-field="email_address">{{ email_address }}</span></p>
    </div>
    <p style="text-align: center; margin-top: 20px; font-style: italic;">"Where Everybody is Somebody"</p>
  </div>
</div>

<div class="page">
  <div style="text-align: center; margin-bottom: 30px;">
    <h1 style="font-size: 18pt;">APPLICATION TO ENROLL IN CONTINUING EDUCATION COURSE(S)</h1>
  </div>

  <div style="border: 1px solid #000; padding: 15px; margin-bottom: 20px;">
    <table style="width: 100%;">
      <tr>
        <th style="width: 15%;">ID NUMBER</th>
        <th style="width: 25%;">PAYMENT TYPE ACCEPTED</th>
        <th style="width: 25%;">RECEIPT NO.</th>
        <th style="width: 35%;">DATE REGISTERED (mm/dd/yy)</th>
