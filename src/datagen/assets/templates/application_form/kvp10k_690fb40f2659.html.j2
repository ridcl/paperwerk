          <p style="font-size: 10pt; margin: 5px 0;">Location: <span data-field="course_location">{{ item.location }}</span></p>
          <p style="font-size: 10pt; margin: 5px 0;">Time: <span data-field="course_time">{{ item.time }}</span></p>
        </td>
        <td style="text-align: right; font-weight: bold;">
