        <td><input type="checkbox"></td>
        <td>
          <div style="font-weight: bold;">{{ item.course_code }} - {{ item.course_title }}</div>
          <p style="font-size: 10pt; margin: 5px 0;">{{ item.description }}</p>
          <p style="font-size: 10pt; margin: 5px 0;">Instructor: <span data-field="course_instructor">{{ item.instructor }}</span></p>
          <p style="font-size: 10pt; margin: 5px 0;">Dates: <span data-field="course_dates">{{ item.dates }}</span></p>
          <p style="font-size: 10pt; margin: 5px 0;">Location: <span data-field="course_location">{{ item.location }}</span></p>
          <p style="font-size: 10pt; margin: 5px 0;">Time: <span data-field="course_time">{{ item.time }}</span></p>
        </td>
        <td style="text-align: right; font-weight: bold;">
