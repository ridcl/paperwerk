<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 15px; }
  .form-group { display: flex; flex-direction: column; }
  .label { font-weight: bold; margin-bottom: 5px; }
  .input-line { border-bottom: 1px solid #000; padding-bottom: 2px; margin-top: 2px; }
  .signature-line { border-bottom: 1px solid #000; width: 100%; margin-top: 30px; }
</style>

<div class="page">
  <div style="text-align: center; margin-bottom: 40px;">
    <h1 style="font-size: 48px; margin: 0;">W</h1>
    <h2 style="font-size: 24px; margin-top: 10px;">Graduate College</h2>
    <h3 style="font-size: 20px; margin-top: 5px;">Admission to Doctoral Candidacy</h3>
    <p style="font-size: 12px; margin-top: 10px;">(submit via email to <span data-field="email_address">{{ email_address }}</span> paper copies not accepted)</p>
  </div>

  <div class="form-row">
    <div class="form-group" style="width: 30%;">
      <div class="label">Date:</div>
      <div class="input-line"><span data-field="date_of_submission">{{ date_of_submission }}</span></div>
    </div>
    <div class="form-group" style="width: 30%;">
      <div class="label">Firstname</div>
      <div class="input-line"><span data-field="full_name_first">{{ full_name_first }}</span></div>
    </div>
    <div class="form-group" style="width: 30%;">
      <div class="label">Last name</div>
      <div class="input-line"><span data-field="full_name_last">{{ full_name_last }}</span></div>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group" style="width: 30%;">
      <div class="label">WIN#:</div>
      <div class="input-line"><span data-field="win_number">{{ win_number }}</span></div>
    </div>
    <div class="form-group" style="width: 30%;">
      <div class="label">Middle name</div>
      <div class="input-line"><span data-field="full_name_middle">{{ full_name_middle }}</span></div>
    </div>
    <div class="form-group" style="width: 30%;">
      <div class="label">WMU email:</div>
      <div class="input-line"><span data-field="wmu_email">{{ wmu_email }}</span></div>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group" style="width: 30%;">
      <div class="label">Date of admission to your doctoral program:</div>
      <div class="input-line"><span data-field="admission_date">{{ admission_date }}</span></div>
    </div>
    <div class="form-group" style="width: 20%;">
      <div class="label">Term:</div>
      <div class="input-line"><span data-field="admission_term">{{ admission_term }}</span></div>
    </div>
    <div class="form-group" style="width: 30%;">
      <div class="label">Year:</div>
      <div class="input-line"><span data-field="admission_year">{{ admission_year }}</span></div>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group" style="width: 30%;">
      <div class="label">Anticipated graduation term and year:</div>
      <div class="input-line"><span data-field="graduation_term_year">{{ graduation_term_year }}</span></div>
    </div>
    <div class="form-group" style="width: 20%;">
      <div class="label">Term:</div>
      <div class="input-line"><span data-field="graduation_term">{{ graduation_term }}</span></div>
    </div>
    <div class="form-group" style="width: 30%;">
      <div class="label">Year:</div>
      <div class="input-line"><span data-field="graduation_year">{{ graduation_year }}</span></div>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group" style="width: 30%;">
      <div class="label">Graduate Program:</div>
      <div class="input-line"><span data-field="graduate_program">{{ graduate_program }}</span></div>
    </div>
    <div class="form-group" style="width: 30%;">
      <div class="label">Department:</div>
      <div class="input-line"><span data-field="department">{{ department }}</span></div>
    </div>
    <div class="form-group" style="width: 30%;">
      <div class="label">College:</div>
      <div class="input-line"><span data-field="college">{{ college }}</span></div>
    </div>
  </div>

  <div class="form-row" style="margin-bottom: 30px;">
    <div class="form-group" style="width: 100%;">
      <div class="label">Dissertation Title:</div>
      <div class="input-line"><span data-field="dissertation_title">{{ dissertation_title }}</span></div>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-size: 12px; line-height: 1.5;">Date dissertation proposal, prospectus, concept paper approved: _________________________</p>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-size: 12px; line-height: 1.5;">Does this project require review for research compliance? (HSIRB; DNA; Hazardous Materials; Animals). If unsure contact research compliance officer at 269.387.8293</p>
    <div style="margin-top: 10px;">
      <label style="font-weight: normal; margin-right: 20px;"><input type="checkbox"> Yes</label>
      <label style="font-weight: normal;"><input type="checkbox"> No</label>
    </div>
  </div>

  <div style="margin-bottom: 30px;">
    <p style="font-size: 12px; line-height: 1.5;">If yes, then attach the letter of approval/or assurance declaration from the Office of Research Compliance.</p>
  </div>

  <div style="margin-bottom: 30px;">
    <p style="font-size: 12px; line-height: 1.5;">Comprehensive Exams required? <span data-field="comprehensive_exams_required_yes">{{ comprehensive_exams_required_yes }}</span> Yes <span data-field="comprehensive_exams_required_no">{{ comprehensive_exams_required_no }}</span> No</p>
    <p style="font-size: 12px; line-height: 1.5;">Date of first exam: _________________________ Date last exam passed: _________________________</p>
  </div>

  <div style="margin-bottom: 30px;">
    <p style="font-size: 12px; line-height: 1.5;">The student named above has earned or satisfactorily completed the following requirements for admission to Doctoral Candidacy:</p>
    <ul style="list-style-type: disc; padding-left: 20px; margin-top: 10px;">
      <li>Degree program grade point average of 3.0 or better</li>
      <li>Completed and approved doctoral dissertation committee (attach approval form)</li>
      <li>All courses (excluding dissertation credit) and program requirements</li>
      <li>All research tool requirements</li>
    </ul>
  </div>

  <div class="form-row" style="margin-top: 60px;">
    <div class="form-group" style="width: 50%;">
      <div class="label">Student Signature</div>
      <div class="signature-line" data-field="student_signature">{{ student_signature }}</div>
    </div>
    <div class="form-group" style="width: 50%; text-align: right;">
      <div class="label">Date</div>
      <div class="input-line" style="width: 200px; margin-left: auto;"><span data-field="signature_date">{{ signature_date }}</span></div>
    </div>
  </div>
</div>

<div class="page">
  <div style="text-align: center; margin-bottom: 40px;">
    <p style="font-size: 14px;">We support above student's application for admission to Doctoral Candidacy and acknowledge all requirements have been met:</p>
  </div>

  <div style="margin-bottom: 40px;">
    <div class="form-row" style="margin-bottom: 20px;">
      <div class="form-group" style="width: 40%;">
        <div class="label">Committee Chair Name (print)</div>
        <div class="input-line"><span data-field="committee_chair_name">{{ committee_chair_name }}</span></div>
      </div>
      <div class="form-group" style="width: 20%; text-align: center;">
        <div class="label">Signature</div>
        <div class="signature-line" style="width: 100%;" data-field="signature">{{ signature }}</div>
      </div>
      <div class="form-group" style="width: 40%; text-align: right;">
        <div class="label">Date</div>
        <div class="input-line" style="width: 150px; margin-left: auto;"><span data-field="committee_chair_date">{{ committee_chair_date }}</span></div>
      </div>
    </div>
  </div>

  {% for i in range(4) %}
  <div style="margin-bottom: 40px;">
    <div class="form-row" style="margin-bottom: 20px;">
      <div class="form-group" style="width: 40%;">
        <div class="label">Committee Member Name (print)</div>
        <div class="input-line"><span data-field="committee_member_name_{{ i }}">{{ committee_member_name[i] }}</span></div>
      </div>
      <div class="form-group" style="width: 20%; text-align: center;">
        <div class="label">Signature</div>
        <div class="signature-line" style="width: 100%;" data-field="signature_2">{{ signature_2 }}</div>
      </div>
      <div class="form-group" style="width: 40%; text-align: right;">
        <div class="label">Date</div>
        <div class="input-line" style="width: 150px; margin-left: auto;"><span data-field="committee_member_date_{{ i }}">{{ committee_member_date[i] }}</span></div>
      </div>
    </div>
  </div>
  {% endfor %}

  <div style="margin-top: 100px; text-align: right; font-size: 12px;">
    Revised May 2018
  </div>
</div>