<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
    margin-bottom: 10px;
  }
  td {
    padding: 5px 0;
    vertical-align: top;
  }
  .form-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 15px;
  }
  .form-group {
    width: 48%;
  }
  .full-width-field {
    width: 100%;
    border-bottom: 1px solid #000;
    margin-top: 5px;
  }
</style>

<div class="page">
  <div style="text-align: center; margin-bottom: 30px;">
    <!-- Placeholder for University Logo/Header -->
    <div style="height: 60px; width: 150px; margin: 0 auto;"></div>
    <h2 style="font-size: 14pt; margin-top: 10px;">UNIVERSITY OF MARYLAND<br>EASTERN SHORE</h2>
  </div>

  <div style="text-align: center; margin-bottom: 20px;">
    <h3 style="font-size: 12pt; font-weight: bold;">OFFICE OF ADMISSIONS AND RECRUITMENT</h3>
    <p style="font-size: 10pt;">1 Backbone Road, Princess Anne, MD 21853</p>
    <p style="font-size: 10pt;">Phone: {{ contact.phone }} Fax: {{ contact.fax }} E-mail: <a href="mailto:{{ contact.email }}">{{ contact.email }}</a></p>
  </div>

  <h1 style="text-align: center; font-size: 16pt; margin-bottom: 30px;">NON-DEGREE TO DEGREE SEEKING STATUS CHANGE</h1>
  <p style="text-align: center; margin-bottom: 30px;">Please complete this form and return with supporting documentation, if required, to the Office of Admissions & Recruitment.</p>

  <table style="width: 100%;">
    <tr>
      <td style="width: 30%;">Student ID</td>
      <td style="width: 30%;">Date of Request</td>
    </tr>
    <tr>
      <td><span data-field="student_id">{{ student_id }}</span></td>
      <td><span data-field="date_of_request">{{ date_of_request }}</span></td>
    </tr>
  </table>

  <table style="width: 100%; margin-top: 30px;">
    <tr>
      <td style="width: 33%;">Last Name</td>
      <td style="width: 33%;">First Name</td>
      <td style="width: 34%;">Middle Initial</td>
    </tr>
    <tr>
      <td><span data-field="personal_info.last_name" class="full-width-field">{{ personal_info.last_name }}</span></td>
      <td><span data-field="personal_info.first_name" class="full-width-field">{{ personal_info.first_name }}</span></td>
      <td><span data-field="personal_info.middle_initial" class="full-width-field">{{ personal_info.middle_initial }}</span></td>
    </tr>
  </table>

  <div style="margin-top: 40px;">
    <table style="width: 100%;">
      <tr>
        <td style="width: 20%; vertical-align: top;">Major:</td>
        <td style="width: 80%;"><span data-field="major_field" class="full-width-field">{{ major_field }}</span></td>
      </tr>
      <tr>
        <td style="width: 20%; vertical-align: top; margin-top: 20px;">Term:</td>
        <td style="width: 80%;"><span data-field="term_field" class="full-width-field">{{ term_field }}</span></td>
      </tr>
    </table>
  </div>

  <div style="margin-top: 30px;">
    <table style="width: 100%;">
      <tr>
        <td style="width: 25%; vertical-align: top;">Final Transcript Received</td>
        <td style="width: 15%; text-align: center;">YES</td>
        <td style="width: 15%; text-align: center;">NO</td>
        <td style="width: 45%;">SAT or ACT Received</td>
        <td style="width: 15%; text-align: center;">YES</td>
        <td style="width: 15%; text-align: center;">NO</td>
        <td style="width: 15%;">NOT REQUIRED</td>
      </tr>
      <tr>
        <td><span data-field="final_transcript_received_yes" style="border-bottom: 1px solid #000; display: inline-block; width: 15px;">{{ final_transcript_received_yes }}</span></td>
        <td><span data-field="final_transcript_received_no" style="border-bottom: 1px solid #000; display: inline-block; width: 15px;">{{ final_transcript_received_no }}</span></td>
        <td></td>
        <td><span data-field="sat_act_received_yes" style="border-bottom: 1px solid #000; display: inline-block; width: 15px;">{{ sat_act_received_yes }}</span></td>
        <td><span data-field="sat_act_received_no" style="border-bottom: 1px solid #000; display: inline-block; width: 15px;">{{ sat_act_received_no }}</span></td>
        <td><span data-field="sat_act_not_required" style="border-bottom: 1px solid #000; display: inline-block; width: 15px;">{{ sat_act_not_required }}</span></td>
      </tr>
    </table>
  </div>

  <div style="margin-top: 30px;">
    <table style="width: 100%;">
      <tr>
        <td style="width: 20%; vertical-align: top;">GPA</td>
        <td style="width: 80%;"><span data-field="gpa_field" class="full-width-field">{{ gpa_field }}</span></td>
      </tr>
    </table>
  </div>

  <div style="margin-top: 30px;">
    <table style="width: 100%;">
      <tr>
        <td style="width: 20%; vertical-align: top;">College Transcripts Received</td>
        <td style="width: 15%; text-align: center;">YES</td>
        <td style="width: 15%; text-align: center;">NO</td>
        <td style="width: 50%;">Score</td>
      </tr>
      <tr>
        <td><span data-field="college_transcripts_received_yes" style="border-bottom: 1px solid #000; display: inline-block; width: 15px;">{{ college_transcripts_received_yes }}</span></td>
        <td><span data-field="college_transcripts_received_no" style="border-bottom: 1px solid #000; display: inline-block; width: 15px;">{{ college_transcripts_received_no }}</span></td>
        <td></td>
        <td><span data-field="score_field" class="full-width-field">{{ score_field }}</span></td>
      </tr>
    </table>
  </div>

  <div style="margin-top: 50px;">
    <p style="font-weight: bold;">*Office Use Only</p>
  </div>

  <div style="margin-top: 30px;">
    <table style="width: 100%;">
      <tr>
        <td style="width: 30%;">Approval Signature:</td>
        <td style="width: 70%;"><span data-field="approval_signature_line" class="full-width-field">{{ approval_signature_line }}</span></td>
      </tr>
    </table>
  </div>

  <div style="margin-top: 30px;">
    <table style="width: 100%;">
      <tr>
        <td style="width: 30%;">Processed New Application:</td>
        <td style="width: 15%; text-align: center;">YES</td>
        <td style="width: 15%; text-align: center;">NO</td>
        <td style="width: 40%;">Application #:</td>
      </tr>
      <tr>
        <td><span data-field="processed_new_application_yes" style="border-bottom: 1px solid #000; display: inline-block; width: 15px;">{{ processed_new_application_yes }}</span></td>
        <td><span data-field="processed_new_application_no" style="border-bottom: 1px solid #000; display: inline-block; width: 15px;">{{ processed_new_application_no }}</span></td>
        <td><span data-field="application_number" class="full-width-field">{{ application_number }}</span></td>
      </tr>
    </table>
  </div>

  <div style="margin-top: 30px;">
    <p style="font-weight: bold;">*Please make NDS row INACTIVE & Degree-seeking row ACTIVE</p>
  </div>

  <div style="margin-top: 30px;">
    <table style="width: 100%;">
      <tr>
        <td style="width: 30%;">Registrar Use Only:</td>
        <td style="width: 70%;"><span data-field="registrar_processor_line" class="full-width-field">{{ registrar_processor_line }}</span></td>
      </tr>
    </table>
  </div>
</div>