<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
</style>
<div class="page">
  <div style="text-align: center; margin-bottom: 40px;">
    <div style="font-size: 48px; font-weight: bold; margin-bottom: -10px;">GRACEU</div>
    <div style="font-size: 12px; letter-spacing: 1px;">BE THE LIGHT</div>
    <h1 style="font-size: 24px; margin-top: 10px;">Grace University</h1>
    <div style="font-size: 12px;">27611 La Paz Rd, Suite A2</div>
    <div style="font-size: 12px;">Laguna Niguel, CA 92677</div>
    <div style="font-size: 12px;">949-215-3963</div>
    <div style="font-size: 12px;">www.graceu.edu</div>
  </div>

  <h2 style="font-size: 18px; font-weight: bold; margin-bottom: 20px;">Application Form</h2>

  <p style="font-size: 14px; line-height: 1.5;">Please provide the information requested. You may submit this application in person, by mail or email. Admission is granted without regard to race, gender, handicap or nationality.</p>

  <h3 style="font-size: 14px; font-weight: bold; margin-top: 25px; margin-bottom: 15px;">Personal Information</h3>

  <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
    <div style="width: 45%;">
      <label style="font-size: 12px; display: block; margin-bottom: 5px;">Last Name</label>
      <div style="border-bottom: 1px solid #000; padding-bottom: 2px;">
        <span data-field="full_name">{{ full_name }}</span>
      </div>
    </div>
    <div style="width: 45%; text-align: right;">
      <label style="font-size: 12px; display: block; margin-bottom: 5px;">AKA</label>
      <div style="border-bottom: 1px solid #000; padding-bottom: 2px;">
        <span data-field="full_name_alias">{{ full_name_alias }}</span>
      </div>
    </div>
  </div>

  <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
    <div style="width: 45%;">
      <label style="font-size: 12px; display: block; margin-bottom: 5px;">Birthdate</label>
      <div style="border-bottom: 1px solid #000; padding-bottom: 2px;">
        <span data-field="birth_date">{{ birth_date }}</span> (mm/dd/yyyy)
      </div>
    </div>
    <div style="width: 45%; display: flex; align-items: center; gap: 20px;">
      <label style="font-size: 12px; display: block; margin-bottom: 5px;">Sex:</label>
      <label style="font-size: 12px;"><input type="radio" name="sex" value="female"> Female</label>
      <label style="font-size: 12px;"><input type="radio" name="sex" value="male"> Male</label>
    </div>
  </div>

  <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
    <div style="width: 45%;">
      <label style="font-size: 12px; display: block; margin-bottom: 5px;">City of Birth</label>
      <div style="border-bottom: 1px solid #000; padding-bottom: 2px;">
        <span data-field="city_of_birth">{{ city_of_birth }}</span>
      </div>
    </div>
    <div style="width: 45%;">
      <label style="font-size: 12px; display: block; margin-bottom: 5px;">Country of Birth</label>
      <div style="border-bottom: 1px solid #000; padding-bottom: 2px;">
        <span data-field="country_of_birth">{{ country_of_birth }}</span>
      </div>
    </div>
  </div>

  <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
    <div style="width: 45%;">
      <label style="font-size: 12px; display: block; margin-bottom: 5px;">Home Phone</label>
      <div style="border-bottom: 1px solid #000; padding-bottom: 2px;">
        <span data-field="home_phone">{{ home_phone }}</span>
      </div>
    </div>
    <div style="width: 45%;">
      <label style="font-size: 12px; display: block; margin-bottom: 5px;">Cell Phone</label>
      <div style="border-bottom: 1px solid #000; padding-bottom: 2px;">
        <span data-field="cell_phone">{{ cell_phone }}</span>
      </div>
    </div>
  </div>

  <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
    <div style="width: 45%;">
      <label style="font-size: 12px; display: block; margin-bottom: 5px;">Email</label>
      <div style="border-bottom: 1px solid #000; padding-bottom: 2px;">
        <span data-field="email">{{ email }}</span>
      </div>
    </div>
    <div style="width: 45%;">
      <label style="font-size: 12px; display: block; margin-bottom: 5px;">Other</label>
      <div style="border-bottom: 1px solid #000; padding-bottom: 2px;">
        <span data-field="other_contact">{{ other_contact }}</span>
      </div>
    </div>
  </div>

  <h3 style="font-size: 14px; font-weight: bold; margin-top: 25px; margin-bottom: 15px;">Current Address</h3>
  <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 15px;">
    <div>
      <label style="font-size: 12px; display: block; margin-bottom: 5px;">No.</label>
      <div style="border-bottom: 1px solid #000; padding-bottom: 2px;">
        <span data-field="address_number">{{ address_number }}</span>
      </div>
    </div>
    <div>
      <label style="font-size: 12px; display: block; margin-bottom: 5px;">Street</label>
      <div style="border-bottom: 1px solid #000; padding-bottom: 2px;">
        <span data-field="address_street">{{ address_street }}</span>
      </div>
    </div>
    <div>
      <label style="font-size: 12px; display: block; margin-bottom: 5px;">Apt/Unit #</label>
      <div style="border-bottom: 1px solid #000; padding-bottom: 2px;">
        <span data-field="address_unit">{{ address_unit }}</span>
      </div>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 15px;">
    <div>
      <label style="font-size: 12px; display: block; margin-bottom: 5px;">City</label>
      <div style="border-bottom: 1px solid #000; padding-bottom: 2px;">
        <span data-field="address_city">{{ address_city }}</span>
      </div>
    </div>
    <div>
      <label style="font-size: 12px; display: block; margin-bottom: 5px;">State</label>
      <div style="border-bottom: 1px solid #000; padding-bottom: 2px;">
        <span data-field="address_state">{{ address_state }}</span>
      </div>
    </div>
    <div>
      <label style="font-size: 12px; display: block; margin-bottom: 5px;">Zip Code</label>
      <div style="border-bottom: 1px solid #000; padding-bottom: 2px;">
        <span data-field="address_zip">{{ address_zip }}</span>
      </div>
    </div>
  </div>

  <div style="margin-bottom: 25px;">
    <label style="font-size: 12px; display: block; margin-bottom: 5px;">Address in home country (if different from above)</label>
    <div style="border-bottom: 1px solid #000; padding-bottom: 2px; margin-top: 5px;">
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;">
        <div>
          <label style="font-size: 12px; display: block; margin-bottom: 5px;">Street</label>
          <div style="border-bottom: 1px solid #000; padding-bottom: 2px;">
            <span data-field="home_address_street">{{ home_address_street }}</span>
          </div>
        </div>
        <div>
          <label style="font-size: 12px; display: block; margin-bottom: 5px;">City</label>
          <div style="border-bottom: 1px solid #000; padding-bottom: 2px;">
            <span data-field="home_address_city">{{ home_address_city }}</span>
          </div>
        </div>
        <div>
          <label style="font-size: 12px; display: block; margin-bottom: 5px;">Province</label>
          <div style="border-bottom: 1px solid #000; padding-bottom: 2px;">
            <span data-field="home_address_province">{{ home_address_province }}</span>
          </div>
        </div>
      </div>
    </div>
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 15px;">
      <div>
        <label style="font-size: 12px; display: block; margin-bottom: 5px;">Zip Code</label>
        <div style="border-bottom: 1px solid #000; padding-bottom: 2px;">
          <span data-field="home_address_zip">{{ home_address_zip }}</span>
        </div>
      </div>
      <div>
        <label style="font-size: 12px; display: block; margin-bottom: 5px;">Country</label>
        <div style="border-bottom: 1px solid #000; padding-bottom: 2px;">
          <span data-field="home_address_country">{{ home_address_country }}</span>
        </div>
      </div>
    </div>
  </div>

  <h3 style="font-size: 14px; font-weight: bold; margin-top: 25px; margin-bottom: 15px;">Program Information</h3>

  <p style="font-size: 14px; line-height: 1.5;">Program I want to apply</p>
  <div style="border-bottom: 1px solid #000; padding-bottom: 2px; margin-bottom: 20px;">
    <span data-field="program_name">{{ program_name }}</span>
  </div>

  <p style="font-size: 14px; line-height: 1.5;">Planned Starting Quarter (indicate term and year):</p>
  <div style="display: flex; gap: 30px; margin-bottom: 20px;">
    <div style="display: flex; align-items: center; gap: 10px;">
      <label style="font-size: 12px;"><input type="checkbox"> Winter (January)</label>
      <span data-field="start_quarter_winter">{{ start_quarter_winter }}</span> year
    </div>
    <div style="display: flex; align-items: center; gap: 10px;">
      <label style="font-size: 12px;"><input type="checkbox"> Spring (April)</label>
      <span data-field="start_quarter_spring">{{ start_quarter_spring }}</span> year
    </div>
    <div style="display: flex; align-items: center; gap: 10px;">
      <label style="font-size: 12px;"><input type="checkbox"> Summer (July)</label>
      <span data-field="start_quarter_summer">{{ start_quarter_summer }}</span> year
    </div>
    <div style="display: flex; align-items: center; gap: 10px;">
      <label style="font-size: 12px;"><input type="checkbox"> Fall (September)</label>
      <span data-field="start_quarter_fall">{{ start_quarter_fall }}</span> year
    </div>
  </div>

  <p style="font-size: 14px; line-height: 1.5;">Planned Program Completion Term/Year:</p>
  <div style="border-bottom: 1px solid #000; padding-bottom: 2px; margin-bottom: 25px;">
    <span data-field="completion_term_year">{{ completion_term_year }}</span>
  </div>

  <p style="font-size: 14px; line-height: 1.5;">How did you learn of our program at Grace University?</p>
  <div style="display: flex; gap: 30px; margin-bottom: 25px;">
    <div style="display: flex; align-items: center; gap: 10px;">
      <label style="font-size: 12px;"><input type="checkbox"> Friend or Family</label>
    </div>
    <div style="display: flex; align-items: center; gap: 10px;">
      <label style="font-size: 12px;"><input type="checkbox"> Website</label>
    </div>
    <div style="display: flex; align-items: center; gap: 10px;">
      <label style="font-size: 12px;"><input type="checkbox"> Advertisement</label>
    </div>
    <div style="display: flex; align-items: center; gap: 10px;">
      <label style="font-size: 12px;"><input type="checkbox"> Other</label>
    </div>
  </div>

  <p style="font-size: 14px; line-height: 1.5; margin-bottom: 30px;">I hereby certify the information submitted on this form is true and complete and authorize the verification of all information herein recorded by Grace University in processing my application. I also authorize Grace University to release this information to any credit evaluation agency it deems necessary in completing my application.</p>

  <div style="display: flex; justify-content: space-between; margin-top: 50px;">
    <div style="width: 45%;">
      <label style="font-size: 12px; display: block; margin-bottom: 5px;">Applicant's Signature</label>
      <div style="border-bottom: 1px solid #000; padding-bottom: 2px;">
        <span data-field="signature_line">{{ signature_line }}</span>
      </div>
    </div>
    <div style="width: 45%;">
      <label style="font-size: 12px; display: block; margin-bottom: 5px;">Date</label>
      <div style="border-bottom: 1px solid #000; padding-bottom: 2px;">
        <span data-field="date_signed">{{ date_signed }}</span>
      </div>
    </div>
  </div>

  <div style="text-align: center; margin-top: 80px;">
    <div style="border-top: 1px solid #000; padding-top: 10px; display: inline-block;">
      <span style="font-size: 14px; font-weight: bold;">For School Use Only</span>
    </div>
    <div style="display: flex; justify-content: space-around; margin-top: 40px;">
      <div style="width: 40%;">
        <label style="font-size: 12px; display: block; margin-bottom: 5px;">Signature</label>
        <div style="border-bottom: 1px solid #000; padding-bottom: 2px;">
          <span data-field="school_signature_line">{{ school_signature_line }}</span>
        </div>
      </div>
      <div style="width: 40%;">
        <label style="font-size: 12px; display: block; margin-bottom: 5px;">Student ID</label>
        <div style="border-bottom: 1px solid #000; padding-bottom: 2px;">
          <span data-field="student_id">{{ student_id }}</span>
        </div>
      </div>
    </div>
  </div>
</div>