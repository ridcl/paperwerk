<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  /* Basic styling to mimic document structure */
  h1 {
    text-align: center;
    font-size: 24pt;
    margin-bottom: 10px;
  }
  .header-logo {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 30px;
  }
  .logo-text {
    text-align: center;
    font-size: 10pt;
    line-height: 1.2;
  }
  .form-section {
    margin-bottom: 20px;
    line-height: 1.5;
  }
  .form-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 15px;
  }
  .form-row > div {
    width: 48%;
  }
  .form-label {
    font-weight: bold;
    display: inline-block;
    width: 150px; /* Adjust as needed for alignment */
  }
  .input-line {
    border-bottom: 1px solid black;
    min-width: 200px;
    display: inline-block;
  }
  .checkbox-group label {
    font-weight: normal;
    margin-right: 15px;
  }
  .signature-line {
    margin-top: 50px;
    border-top: 1px solid black;
    width: 40%;
    display: inline-block;
  }
</style>

<div class="page">
  <div class="header-logo">
    <!-- Placeholder for FAMU Logo/Branding -->
    <div style="margin-right: 20px;">
      <h1 style="font-size: 36pt; margin: 0;">FAMU</h1>
    </div>
    <div class="logo-text">
      <p style="font-size: 12pt; margin: 0;">FLORIDA AGRICULTURAL AND MECHANICAL UNIVERSITY</p>
    </div>
  </div>

  <h2 style="text-align: center; font-size: 16pt; margin-bottom: 30px;">APPLICATION FOR REFUND OF TUITION AND FEES FORM</h2>

  <div class="form-section">
    <div class="form-row">
      <div>
        <span style="font-weight: bold;">Print Full Name:</span> <span class="input-line" style="display: inline-block; width: 60%;">{{ full_name }}</span>
      </div>
      <div>
        <span style="font-weight: bold;">Student ID:</span> <span class="input-line" style="display: inline-block; width: 60%;">{{ student_id }}</span>
      </div>
    </div>

    <div class="form-row">
      <div>
        <span style="font-weight: bold;">Term/Year:</span> <span class="input-line" style="display: inline-block; width: 60%;">{{ term_year }}</span>
      </div>
      <div>
        <span style="font-weight: bold;">Email Address:</span> <span class="input-line" style="display: inline-block; width: 60%;">{{ email_address }}</span>
      </div>
    </div>

    <div class="form-row">
      <div>
        <span style="font-weight: bold;">Phone Number:</span> <span class="input-line" style="display: inline-block; width: 60%;">{{ phone_number }}</span>
      </div>
      <div>
        <span style="font-weight: bold;">Financial Aid Received?:</span>
        <div style="margin-top: 10px;">
          <input type="checkbox" id="yes" name="aid_yes"> <label for="yes">YES</label>
          <input type="checkbox" id="no" name="aid_no"> <label for="no">NO</label>
        </div>
      </div>
    </div>
  </div>

  <div class="form-section">
    <p style="font-weight: bold;">Reason for Refund Request (please check one):</p>
    <div class="checkbox-group" style="margin-top: 10px;">
      <label><input type="checkbox"> Illness of a student of such severity or duration, as confirmed in writing by a physician, to preclude completion of the course(s).</label><br>
      <label><input type="checkbox"> Death of the student or death in the immediate family (parent, spouse, child, or sibling).</label><br>
      <label><input type="checkbox"> Involuntary call to active military duty.</label><br>
      <label><input type="checkbox"> A situation in which the University in error.</label><br>
      <label><input type="checkbox"> Other:</label>
    </div>
  </div>

  <div class="form-section" style="margin-top: 30px;">
    <p style="font-weight: bold;">Formal application must be made for a refund or other appeal action. This form must be submitted (with supporting documentation) to Student Financial Services at <span data-field="student_financial_services_email">{{ student_financial_services_email }}</span> within six (6) months of the close of the semester in which the refund or other appeal action is applicable.</p>
    <p style="font-weight: bold;">Please note: A separate committee from the Retroactive Withdrawal Committee will consider your application for tuition refund. You will be notified via mail upon the decision of the committee.</p>
  </div>

  <div class="form-section" style="margin-top: 50px;">
    <div class="form-row">
      <div>
        <span style="font-weight: bold;">Student's Signature:</span>
        <div class="signature-line">{{ student_signature }}</div>
      </div>
      <div>
        <span style="font-weight: bold;">Date:</span>
        <div class="signature-line">{{ date_signed }}</div>
      </div>
    </div>
  </div>

  <div class="form-section" style="margin-top: 80px;">
    <p style="font-weight: bold; text-align: center;">FOR OFFICIAL USE ONLY</p>
    <div class="form-row" style="justify-content: space-around;">
      <div>
        <span style="font-weight: bold;">Approved</span>
        <div class="signature-line" style="width: 30%;"></div>
      </div>
      <div>
        <span style="font-weight: bold;">Denied</span>
        <div class="signature-line" style="width: 30%;"></div>
      </div>
    </div>
    <div class="form-row" style="margin-top: 40px;">
      <div>
        <span style="font-weight: bold;">Committee Signature:</span>
        <div class="signature-line">{{ committee_signature }}</div>
      </div>
      <div>
        <span style="font-weight: bold;">Date:</span>
        <div class="signature-line">{{ committee_date }}</div>
      </div>
    </div>
  </div>
</div>