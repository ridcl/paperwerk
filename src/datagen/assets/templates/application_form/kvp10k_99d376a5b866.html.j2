<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
</style>
<div class="page">
  <div style="text-align: center; margin-bottom: 40px;">
    <h1 style="font-size: 36px; margin: 0;">LS Lake Shore Savings</h1>
    <h2 style="font-size: 24px; margin: 5px 0 0 0;">Putting People First.</h2>
    <p style="margin-top: 10px; font-size: 14px;">HSA Customer Verification</p>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Eligibility Certification:</p>
    <div style="margin-top: 10px;">
      <label style="font-weight: normal;"><input type="radio" name="eligibility_1"> True</label>
      <label style="font-weight: normal;"><input type="radio" name="eligibility_1"> False</label> I am covered under a qualifying High Deductible Health Plan (HDHP).
    </div>
    <div style="margin-top: 10px;">
      <label style="font-weight: normal;"><input type="radio" name="eligibility_2"> True</label>
      <label style="font-weight: normal;"><input type="radio" name="eligibility_2"> False</label> I am not covered under any other insurance plans that are not HDHP.
    </div>
    <div style="margin-top: 10px;">
      <label style="font-weight: normal;"><input type="radio" name="eligibility_3"> True</label>
      <label style="font-weight: normal;"><input type="radio" name="eligibility_3"> False</label> I am not enrolled in Medicare.
    </div>
    <div style="margin-top: 10px;">
      <label style="font-weight: normal;"><input type="radio" name="eligibility_4"> True</label>
      <label style="font-weight: normal;"><input type="radio" name="eligibility_4"> False</label> I am not able to be claimed as a dependent on anyone's income tax returns.
    </div>
    <p style="margin-top: 20px; font-size: 14px;">If you answer false to any of these statements you will not be eligible to open a Health Savings Account.</p>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Name:</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 15px;">
      <span data-field="full_name">{{ full_name }}</span>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Address (Physical address no PO Box):</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 15px;">
      <span data-field="address">{{ address }}</span>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Email Address (required):</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 15px;">
      <span data-field="email_address">{{ email_address }}</span>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Date of Birth:</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 15px;">
      <span data-field="date_of_birth">{{ date_of_birth }}</span>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Social Security Number:</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 15px;">
      <span data-field="ssn">{{ ssn }}</span>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Driver's License #:</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 15px;">
      <span data-field="driver_license_number">{{ driver_license_number }}</span>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">State of Issuance:</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 15px;">
      <span data-field="state_of_issuance">{{ state_of_issuance }}</span>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Issue Date:</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 15px;">
      <span data-field="issue_date">{{ issue_date }}</span>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Expiration Date:</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 15px;">
      <span data-field="expiration_date">{{ expiration_date }}</span>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Copy of Driver's License needs to be <a href="#" style="text-decoration: underline;">UPLOADED to the SECURE PORTAL</a> on Employee Engagement's</p>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Benefit Website:</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 15px;">
      <span data-field="benefit_website">{{ benefit_website }}</span>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Primary Phone Number:</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 15px;">
      <span data-field="phone_number">{{ phone_number }}</span>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Marital Status:</p>
    <div style="margin-top: 10px;">
      <label style="font-weight: normal;"><input type="radio" name="marital_status"> Married</label>
      <label style="font-weight: normal;"><input type="radio" name="marital_status"> Single</label>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Occupation:</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 15px;">
      <span data-field="occupation">{{ occupation }}</span>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Insurance Plan Type:</p>
    <div style="margin-top: 10px;">
      <label style="font-weight: normal;"><input type="radio" name="insurance_plan_type"> Individual</label>
      <label style="font-weight: normal;"><input type="radio" name="insurance_plan_type"> Family</label>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Are you transferring your current HAS Plan to Lake Shore Savings? <input type="checkbox" name="transfer_has"> Yes <input type="checkbox" name="transfer_has"> No</p>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">If yes, from where: Account Number:</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 15px;">
      <span data-field="account_number">{{ account_number }}</span>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Address:</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 15px;">
      <span data-field="address_transfer">{{ address_transfer }}</span>
    </div>
  </div>
</div>

<div class="page">
  <div style="text-align: center; margin-bottom: 40px;">
    <h1 style="font-size: 36px; margin: 0;">LS Lake Shore Savings</h1>
    <h2 style="font-size: 24px; margin: 5px 0 0 0;">Putting People First.</h2>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Yes, I would like a HSA Debit Card issued to me <input type="checkbox" name="debit_card_self"> No, I do not want a HSA Debit Card</p>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Yes, I would like HSA Checks <input type="checkbox" name="hsa_checks_self"> No, I do not want Checks</p>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Yes, I want a Beneficiary <input type="checkbox" name="beneficiary_self"> No, I do not want a Beneficiary</p>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">If yes, Beneficiary Info:</p>
    <div style="margin-top: 10px;">
      <p style="font-weight: bold;">Name:</p>
      <div style="border-bottom: 1px solid #000; margin-bottom: 15px;">
        <span data-field="beneficiary_name">{{ beneficiary_name }}</span>
      </div>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Address:</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 15px;">
      <span data-field="beneficiary_address">{{ beneficiary_address }}</span>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Email Address (Required):</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 15px;">
      <span data-field="beneficiary_email">{{ beneficiary_email }}</span>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Social Security Number:</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 15px;">
      <span data-field="beneficiary_ssn">{{ beneficiary_ssn }}</span>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Date of Birth:</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 15px;">
      <span data-field="beneficiary_dob">{{ beneficiary_dob }}</span>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Phone Number:</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 15px;">
      <span data-field="beneficiary_phone">{{ beneficiary_phone }}</span>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Occupation:</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 15px;">
      <span data-field="beneficiary_occupation">{{ beneficiary_occupation }}</span>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Relationship to HSA owner:</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 15px;">
      <span data-field="beneficiary_relationship">{{ beneficiary_relationship }}</span>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">(If more than one Beneficiary is designated, please write additional Beneficiaries information on the back of this form)</p>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Yes, I would like a Spousal Authorized Signer <input type="checkbox" name="spousal_signer_self"> No, I do not want an Authorized Signer</p>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">If yes, UPLOAD copy of Driver's License to SECURE PORTAL on EE Website.</p>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Spousal Authorized Signer Name:</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 15px;">
      <span data-field="spousal_signer_name">{{ spousal_signer_name }}</span>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Address:</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 15px;">
      <span data-field="spousal_signer_address">{{ spousal_signer_address }}</span>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Email Address (Required):</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 15px;">
      <span data-field="spousal_signer_email">{{ spousal_signer_email }}</span>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Social Security Number:</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 15px;">
      <span data-field="spousal_signer_ssn">{{ spousal_signer_ssn }}</span>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Date of Birth:</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 15px;">
      <span data-field="spousal_signer_dob">{{ spousal_signer_dob }}</span>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Phone Number:</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 15px;">
      <span data-field="spousal_signer_phone">{{ spousal_signer_phone }}</span>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Occupation:</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 15px;">
      <span data-field="spousal_signer_occupation">{{ spousal_signer_occupation }}</span>
    </div>
  </div>

  <div style="margin-top: 50px;">
    <p style="font-weight: bold;">Yes, I want a HSA Debit Card issued to my authorized signer.</p>
    <p style="font-weight: bold;">No, I do not want a HSA Debit Card issued to my authorized signer.</p>
  </div>

  <div style="margin-top: 50px;">
    <p style="font-weight: bold;">All signature cards and required documents will be sent out through DocuSign in order for account to be opened.</p>
    <p style="margin-top: 30px;">Signature:</p>
    <div style="border-bottom: 1px solid #000; margin-top: 50px;" data-field="signature">{{ signature }}</div>
  </div>
</div>