<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif; }
  h1, h2 { font-weight: bold; }
  table { width: 100%; border-collapse: collapse; margin-bottom: 15px; }
  td { padding: 5px 0; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 10px; }
  .form-group { width: 33.33%; }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px;">
    <div>
      <div style="font-size: 10pt;">MDOT MARYLAND DEPARTMENT OF TRANSPORTATION</div>
      <div style="font-size: 10pt;">MOTOR VEHICLE ADMINISTRATION</div>
    </div>
    <div style="text-align: right;">
      <div style="font-size: 10pt;">6601 Ritchie Highway, N.E.</div>
      <div style="font-size: 10pt;">Glen Burnie, Maryland 21062</div>
      <div style="font-size: 10pt;">VR-124 (09-24)</div>
    </div>
  </div>

  <h1 style="font-size: 16pt; margin-bottom: 20px;">Application/Certification for Organizational License Plates</h1>

  <div style="margin-bottom: 20px;">
    <p>Instructions: Please complete the entire application (owner and/or co-owner). Submit appropriate fees with application.</p>
  </div>

  <div style="margin-bottom: 20px;">
    <p>Name of Organization:</p>
    <div style="border-bottom: 1px solid #000; padding-bottom: 3px;">
      <span data-field="organization_name">{{ organization_name }}</span>
    </div>
  </div>

  <div style="margin-bottom: 30px;">
    <p>I certify that the individual below is a bona fide member of the above organization:</p>
    <div style="height: 50px; border-bottom: 1px solid #000; margin-top: 10px;" data-field="name_of_organization">{{ name_of_organization }}</div>
  </div>

  <div style="margin-bottom: 30px;">
    <p>Signature of Authorized Representative</p>
    <div style="height: 50px; border-bottom: 1px solid #000; margin-top: 10px;" data-field="signature_of_authorized_representative">{{ signature_of_authorized_representative }}</div>
  </div>

  <table style="margin-bottom: 30px;">
    <thead>
      <tr>
        <th style="text-align: left; width: 25%;">Owner's First Name</th>
        <th style="text-align: left; width: 25%;">Middle</th>
        <th style="text-align: left; width: 25%;">Last</th>
        <th style="text-align: left; width: 25%;">Co-Owner's First Name</th>
        <th style="text-align: left; width: 25%;">Middle</th>
        <th style="text-align: left; width: 25%;">Last</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="owner.first_name">{{ owner.first_name }}</span></td>
        <td><span data-field="owner.middle_name">{{ owner.middle_name }}</span></td>
        <td><span data-field="owner.last_name">{{ owner.last_name }}</span></td>
        <td><span data-field="co_owner.first_name">{{ co_owner.first_name }}</span></td>
        <td><span data-field="co_owner.middle_name">{{ co_owner.middle_name }}</span></td>
        <td><span data-field="co_owner.last_name">{{ co_owner.last_name }}</span></td>
      </tr>
    </tbody>
  </table>

  <table style="margin-bottom: 30px;">
    <thead>
      <tr>
        <th style="text-align: left;">Owner's Driver's License Number</th>
        <th style="text-align: left;">Co-Owner's Driver's License Number</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="owner.license_number">{{ owner.license_number }}</span></td>
        <td><span data-field="co_owner.license_number">{{ co_owner.license_number }}</span></td>
      </tr>
    </tbody>
  </table>

  <table style="margin-bottom: 30px;">
    <thead>
      <tr>
        <th style="text-align: left;">Owner's Email Address</th>
        <th style="text-align: left;">Owner's Phone No.</th>
        <th style="text-align: left;">Co-Owner's Email Address</th>
        <th style="text-align: left;">Co-Owner's Phone No.</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="owner.email">{{ owner.email }}</span></td>
        <td><span data-field="owner.phone">{{ owner.phone }}</span></td>
        <td><span data-field="co_owner.email">{{ co_owner.email }}</span></td>
        <td><span data-field="co_owner.phone">{{ co_owner.phone }}</span></td>
      </tr>
    </tbody>
  </table>

  <table style="margin-bottom: 30px;">
    <thead>
      <tr>
        <th style="text-align: left;">Owner's Street Address</th>
        <th style="text-align: left;">City</th>
        <th style="text-align: left;">Co-Owner's Street Address</th>
        <th style="text-align: left;">City</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="owner.address">{{ owner.address }}</span></td>
        <td><span data-field="owner.city">{{ owner.city }}</span></td>
        <td><span data-field="co_owner.address">{{ co_owner.address }}</span></td>
        <td><span data-field="co_owner.city">{{ co_owner.city }}</span></td>
      </tr>
    </tbody>
  </table>

  <table style="margin-bottom: 30px;">
    <thead>
      <tr>
        <th style="text-align: left;">County</th>
        <th style="text-align: left;">State</th>
        <th style="text-align: left;">Zip Code</th>
        <th style="text-align: left;">County</th>
        <th style="text-align: left;">State</th>
        <th style="text-align: left;">Zip Code</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="owner.county">{{ owner.county }}</span></td>
        <td><span data-field="owner.state">{{ owner.state }}</span></td>
        <td><span data-field="owner.zip_code">{{ owner.zip_code }}</span></td>
        <td><span data-field="co_owner.county">{{ co_owner.county }}</span></td>
        <td><span data-field="co_owner.state">{{ co_owner.state }}</span></td>
        <td><span data-field="co_owner.zip_code">{{ co_owner.zip_code }}</span></td>
      </tr>
    </tbody>
  </table>

  <div style="margin-bottom: 30px;">
    <p>I hereby authorize the representative of my organization to review/release my personal information for official purposes:</p>
    <div style="height: 50px; border-bottom: 1px solid #000; margin-top: 10px;" data-field="field_1">{{ field_1 }}</div>
  </div>

  <h2 style="margin-top: 30px; margin-bottom: 15px;">Vehicle Information</h2>

  <table style="margin-bottom: 30px;">
    <thead>
      <tr>
        <th style="text-align: left;">Year</th>
        <th style="text-align: left;">Make</th>
        <th style="text-align: left;">Sticker Number</th>
        <th style="text-align: left;">Title Number</th>
        <th style="text-align: left;">Tag Number</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="vehicle.year">{{ vehicle.year }}</span></td>
        <td><span data-field="vehicle.make">{{ vehicle.make }}</span></td>
        <td><span data-field="vehicle.sticker_number">{{ vehicle.sticker_number }}</span></td>
        <td><span data-field="vehicle.title_number">{{ vehicle.title_number }}</span></td>
        <td><span data-field="vehicle.tag_number">{{ vehicle.tag_number }}</span></td>
      </tr>
    </tbody>
  </table>

  <table style="margin-bottom: 30px;">
    <thead>
      <tr>
        <th style="text-align: left;">Vehicle Identification Number</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="vehicle.vin">{{ vehicle.vin }}</span></td>
      </tr>
    </tbody>
  </table>

  <table style="margin-bottom: 30px;">
    <thead>
      <tr>
        <th style="text-align: left;">Insurance Company</th>
        <th style="text-align: left;">Policy/Binder Number</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="insurance.company">{{ insurance.company }}</span></td>
        <td><span data-field="insurance.policy_number">{{ insurance.policy_number }}</span></td>
      </tr>
    </tbody>
  </table>

  <table style="margin-bottom: 30px;">
    <thead>
      <tr>
        <th style="text-align: left;">Organizational Member: (Check One)</th>
        <th style="text-align: left;">Owner</th>
        <th style="text-align: left;">Co-Owner</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><input type="checkbox"> Passenger Car</td>
        <td><input type="checkbox"> Owner</td>
        <td><input type="checkbox"> Co-Owner</td>
      </tr>
    </tbody>
  </table>

  <table style="margin-bottom: 30px;">
    <thead>
      <tr>
        <th style="text-align: left;">Check Class:</th>
        <th style="text-align: left;">Passenger Car</th>
        <th style="text-align: left;">Multi-Purpose Vehicle</th>
        <th style="text-align: left;">Truck 1 ton or less</th>
        <th style="text-align: left;">Motorcycle</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td></td>
        <td><input type="checkbox"></td>
        <td><input type="checkbox"></td>
        <td><input type="checkbox"></td>
        <td><input type="checkbox"></td>
      </tr>
    </tbody>
  </table>

  <table style="margin-bottom: 30px;">
    <thead>
      <tr>
        <th style="text-align: left;">Fees:</th>
        <th style="text-align: left;">Non Logo Organizational Tags: $20.00</th>
        <th style="text-align: left;">Logo: $30.00</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td></td>
        <td></td>
        <td></td>
      </tr>
    </tbody>
  </table>

  <div style="margin-bottom: 30px;">
    <p>I certify, under penalty of perjury, that the above information is true and correct to the best of my knowledge:</p>
    <div style="height: 50px; border-bottom: 1px solid #000; margin-top: 10px;" data-field="logo_30_00">{{ logo_30_00 }}</div>
  </div>

  <table style="margin-bottom: 30px;">
    <thead>
      <tr>
        <th style="text-align: left;">Owner's Signature</th>
        <th style="text-align: left;">Date</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><div style="height: 50px; border-bottom: 1px solid #000;" data-field="date">{{ date }}</div></td>
        <td><span data-field="owner_signature_date">{{ owner_signature_date }}</span></td>
      </tr>
    </tbody>
  </table>

  <table style="margin-bottom: 30px;">
    <thead>
      <tr>
        <th style="text-align: left;">Co-Owner's Signature</th>
        <th style="text-align: left;">Date</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><div style="height: 50px; border-bottom: 1px solid #000;" data-field="date_2">{{ date_2 }}</div></td>
        <td><span data-field="co_owner_signature_date">{{ co_owner_signature_date }}</span></td>
      </tr>
    </tbody>
  </table>

  <div style="margin-bottom: 30px;">
    <p>MVA Use Only:</p>
    <table style="width: 100%;">
      <tr>
        <td style="width: 20%;"><input type="radio" name="mva_use" value="new"><span data-field="mva_use_new">{{ mva_use_new }}</span></td>
        <td style="width: 20%;"><input type="radio" name="mva_use" value="substitute"><span data-field="mva_use_substitute">{{ mva_use_substitute }}</span></td>
        <td style="width: 20%;"><input type="radio" name="mva_use" value="surviving"><span data-field="mva_use_surviving">{{ mva_use_surviving }}</span></td>
        <td style="width: 20%;"><input type="radio" name="mva_use" value="s_n"><span data-field="mva_use_s_n">{{ mva_use_s_n }}</span></td>
      </tr>
      <tr>
        <td><input type="radio" name="mva_use" value="gratis"><span data-field="mva_use_gratis">{{ mva_use_gratis }}</span></td>
        <td><input type="radio" name="mva_use" value="paid"><span data-field="mva_use_paid">{{ mva_use_paid }}</span></td>
        <td>Approved by: </td>
        <td>Tag Issued: <span data-field="tag_issued_date">{{ tag_issued_date }}</span></td>
      </tr>
    </table>
  </div>

  <div style="margin-top: 40px; font-size: 9pt;">
    <p>You may either mail your application and the appropriate fees to:</p>
    <p style="margin-top: 5px;">Motor Vehicle Administration, Vehicle Registration Organizational Unit; 6601 Ritchie Highway, Glen Burnie, MD 21062;</p>
    <p style="margin-top: 5px;">or visit the MVA Full Service Office in Glen Burnie and have your plates issued to you.</p>
    <p style="margin-top: 15px;">6601 Ritchie Highway, N.E., Glen Burnie, Maryland 21062</p>
    <p style="font-size: 8pt;">For more information visit our website at <a href="#" style="color: #000;">www.mva.maryland.gov</a>, call 410-768-7000 or TTY for the hearing impaired: 1-800-492-4575.</p>
  </div>
</div>