<!DOCTYPE html>
<html>
<head>
    <title>Application Form</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        .header { text-align: center; margin-bottom: 40px; }
        .logo { height: 60px; margin-bottom: 10px; }
        .title { font-size: 24pt; font-weight: bold; text-align: center; margin-bottom: 30px; }
        .section-title { font-size: 14pt; font-weight: bold; margin-top: 20px; margin-bottom: 15px; }
        .form-row { display: flex; justify-content: space-between; margin-bottom: 15px; }
        .form-group { display: flex; flex-direction: column; width: 48%; }
        .form-label { font-size: 10pt; margin-bottom: 5px; font-weight: normal; }
        .form-input { border-bottom: 1px solid #000; padding-bottom: 2px; width: 100%; }
        .signature-line { border-bottom: 1px solid #000; width: 40%; margin-top: 50px; }
        .checkbox-group { display: flex; gap: 20px; margin-top: 10px; }
        .checkbox-group label { font-size: 10pt; }
        .divider { border-top: 1px solid #000; margin: 30px 0; }
        .table-container { width: 100%; border-collapse: collapse; margin-top: 20px; }
        .table-container td { padding: 8px 0; border-bottom: 1px solid #ccc; }
        .table-container tr:last-child td { border-bottom: none; }
        .small-text { font-size: 8pt; margin-top: 10px; }
    </style>
</head>
<body>

<div class="page">
    <div class="header">
        <img src="" alt="Logo" class="logo">
        <div style="font-size: 12pt; font-weight: bold;">PETROLEUM CLUB OF HOUSTON</div>
    </div>
    <div class="title">APPLICATION FOR MEMBERSHIP</div>

    <p style="font-size: 10pt; line-height: 1.4;">I hereby apply for membership in your Club. If I should be accepted, I agree to comply with and observe the By-laws, House Rules and Regulations, and further agree that my membership will be subject to all By-laws, House Rules and Regulations now in force and those which may be legally adopted and for infraction thereof the Board of Directors may terminate such membership.</p>

    <div class="form-row" style="margin-top: 40px;">
        <div class="form-group" style="width: 50%;">
            <div class="form-label">Applicant's Signature</div>
            <div class="signature-line" data-field="applicant_s_signature">{{ applicant_s_signature }}</div>
        </div>
        <div class="form-group" style="width: 50%; text-align: right;">
            <div class="form-label">Date</div>
            <div class="form-input" style="width: 150px; text-align: right;" data-field="date">{{ date }}</div>
        </div>
    </div>

    <div class="section-title">Applicant Information (please print clearly)</div>

    <div class="form-row">
        <div class="form-group">
            <div class="form-label">Full Name:</div>
            <div class="form-input">{{ applicant_info.full_name }}</div>
        </div>
        <div class="form-group">
            <div class="form-label">Date of Birth:</div>
            <div class="form-input">{{ applicant_info.date_of_birth }}</div>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <div class="form-label">Company Name (in full):</div>
            <div class="form-input">{{ applicant_info.company_name }}</div>
        </div>
        <div class="form-group">
            <div class="form-label">Title:</div>
            <div class="form-input">{{ applicant_info.title }}</div>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <div class="form-label">Company Address, City, State, Zip:</div>
            <div class="form-input">{{ applicant_info.company_address }}</div>
        </div>
        <div class="form-group">
            <div class="form-label">Company Email:</div>
            <div class="form-input">{{ applicant_info.company_email }}</div>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <div class="form-label">Home Address, City, State, Zip:</div>
            <div class="form-input">{{ applicant_info.home_address }}</div>
        </div>
        <div class="form-group">
            <div class="form-label">Email:</div>
            <div class="form-input">{{ applicant_info.home_email }}</div>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <div class="form-label">Phone:</div>
            <div class="form-input">{{ applicant_info.phone }}</div>
        </div>
        <div class="form-group">
            <div class="form-label">Spouse's Date:</div>
            <div class="form-input">{{ applicant_info.spouse_date }}</div>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <div class="form-label">Please select where you would like billing and materials to be sent (select 1):</div>
            <div class="checkbox-group">
                <label><input type="checkbox"> Company</label>
                <label><input type="checkbox"> Home</label>
            </div>
        </div>
    </div>

    <div class="form-row">
        <div class="form-group">
            <div class="form-label">Spouse's Name:</div>
            <div class="form-input">{{ applicant_info.spouse_name }}</div>
        </div>
        <div class="form-group">
            <div class="form-label">Email:</div>
            <div class="form-input">{{ applicant_info.spouse_email }}</div>
        </div>
    </div>

    <div class="form-row" style="margin-top: 20px;">
        <div class="form-group" style="width: 100%;">
            <div class="form-label">Alma Mater and/or Professional and Social Affiliations:</div>
            <div class="form-input" style="height: 50px;">{{ applicant_info.alma_mater }}</div>
        </div>
    </div>

    <div class="section-title" style="margin-top: 40px;">Class of Membership:</div>

    <div class="form-row" style="margin-top: 10px;">
        <div class="form-group" style="width: 15%;">
            <div class="form-label">Active Individual</div>
            <div class="form-input" style="height: 20px;" data-field="active_individual">{{ active_individual }}</div>
        </div>
        <div class="form-group" style="width: 15%;">
            <div class="form-label">Senior</div>
            <div class="form-input" style="height: 20px;" data-field="senior">{{ senior }}</div>
        </div>
        <div class="form-group" style="width: 15%;">
            <div class="form-label">Junior</div>
            <div class="form-input" style="height: 20px;" data-field="junior">{{ junior }}</div>
        </div>
    </div>

    <div class="form-row" style="margin-top: 10px;">
        <div class="form-group" style="width: 15%;">
            <div class="form-label">Clergy</div>
            <div class="form-input" style="height: 20px;" data-field="clergy">{{ clergy }}</div>
        </div>
        <div class="form-group" style="width: 15%;">
            <div class="form-label">Diplomatic</div>
            <div class="form-input" style="height: 20px;" data-field="diplomatic">{{ diplomatic }}</div>
        </div>
        <div class="form-group" style="width: 15%;">
            <div class="form-label">Non-Resident</div>
            <div class="form-input" style="height: 20px;" data-field="non_resident">{{ non_resident }}</div>
        </div>
    </div>

    <div class="form-row" style="margin-top: 10px;">
        <div class="form-group" style="width: 15%;">
            <div class="form-label">Premier Company</div>
            <div class="form-input" style="height: 20px;" data-field="premier_company">{{ premier_company }}</div>
        </div>
        <div class="form-group" style="width: 15%;">
            <div class="form-label">Secondary Company</div>
            <div class="form-input" style="height: 20px;" data-field="secondary_company">{{ secondary_company }}</div>
        </div>
        <div class="form-group" style="width: 15%;">
            <div class="form-label">Junior Secondary Company</div>
            <div class="form-input" style="height: 20px;" data-field="junior_secondary_company">{{ junior_secondary_company }}</div>
        </div>
    </div>

    <div class="form-row" style="margin-top: 10px;">
        <div class="form-group" style="width: 15%;">
            <div class="form-label">MBA Program</div>
            <div class="form-input" style="height: 20px;" data-field="mba_program">{{ mba_program }}</div>
        </div>
        <div class="form-group" style="width: 15%;">
            <div class="form-label">Primary Premier Company to be owned by</div>
            <div class="form-input" style="height: 20px;" data-field="mba_program_2">{{ mba_program_2 }}</div>
        </div>
        <div class="form-group" style="width: 15%;">
            <div class="form-label">Company Transfer from</div>
            <div class="form-input" style="height: 20px;" data-field="company_transfer_from">{{ company_transfer_from }}</div>
        </div>
    </div>

    <div class="small-text" style="text-align: center; margin-top: 50px;">Return to {{ contact_address }} | {{ contact_email }} | Fax {{ fax_number }}</div>
</div>

<div class="page">
    <div class="section-title">If selected MBA Program Class of Membership please complete and initial the following:</div>

    <div class="form-row" style="margin-top: 20px;">
        <div class="form-group">
            <div class="form-label">School Name (in full):</div>
            <div class="form-input">{{ mba_details.school_name }}</div>
        </div>
        <div class="form-group">
            <div class="form-label">Graduation Year:</div>
            <div class="form-input">{{ mba_details.graduation_year }}</div>
        </div>
    </div>

    <div class="form-row" style="margin-top: 20px;">
        <div class="form-group">
            <div class="form-label">MBA Program Title: (i.e. Full Time, Professional, Online etc.)</div>
            <div class="form-input">{{ mba_details.program_title }}</div>
        </div>
    </div>

    <p style="font-size: 10pt; line-height: 1.4; margin-top: 30px;">I am aware a my monthly membership dues will be waived for 12 months from approval date. I would be required to keep a credit card on file to pay for any food and beverages charges and/or attendance of events etc. incurred during the month. At the 12-month anniversary, I have the option to continue membership by paying the current monthly dues or trial membership will end.</p>

    <div class="form-row" style="margin-top: 20px;">
        <div class="form-group">
            <div class="form-label">Initial Here</div>
            <div class="form-input" style="width: 100px;" data-field="initial_here">{{ initial_here }}</div>
        </div>
    </div>

    <div class="section-title" style="margin-top: 40px;">If selected Junior Class of Membership, please note and initial the following:</div>

    <p style="font-size: 10pt; line-height: 1.4;">Any Junior Member upon reaching forty (40) years of age shall as a matter of right be entitled to all the rights and privileges of an Individual Active Member upon the payment in full of the initiation fee and/or transfer fee then required for Individual Active Membership, less all initiation fees or transfer fees heretofore paid by such Junior Member.</p>

    <div class="form-row" style="margin-top: 20px;">
        <div class="form-group">
            <div class="form-label">Initial Here</div>
            <div class="form-input" style="width: 100px;" data-field="initial_here_2">{{ initial_here_2 }}</div>
        </div>
    </div>

    <div class="form-row" style="margin-top: 30px;">
        <div class="form-group" style="width: 50%;">
            <div class="form-label">Have you ever been a member of the Petroleum Club of Houston?</div>
            <div class="checkbox-group">
                <label><input type="checkbox"> Yes</label>
                <label><input type="checkbox"> No</label>
            </div>
        </div>
    </div>

    <div class="form-row" style="margin-top: 20px;">
        <div class="form-group" style="width: 100%;">
            <div class="form-label">If yes, please provide date:</div>
            <div class="form-input">{{ applicant_info.previous_membership_date }}</div>
        </div>
    </div>

    <div class="form-row" style="margin-top: 30px;">
        <div class="form-group" style="width: 50%;">
            <div class="form-label">I/my spouse would like to sign up for the Ladies Association. Please charge my membership account the $35 annual dues.</div>
            <div class="checkbox-group">
                <label><input type="checkbox"> Yes</label>
                <label><input type="checkbox"> No</label>
            </div>
        </div>
    </div>

    <div class="form-row" style="margin-top: 20px;">
        <div class="form-group" style="width: 50%;">
            <div class="form-label">I/my spouse would like to join the Professional Women's Networking Group.</div>
            <div class="checkbox-group">
                <label><input type="checkbox"> Yes</label>
                <label><input type="checkbox"> No</label>
            </div>
        </div>
    </div>

    <div class="form-row" style="margin-top: 30px;">
        <div class="form-group" style="width: 100%;">
            <div class="form-label">Do you qualify for our Legacy Membership Program (parents or grandparents must be current members)?</div>
            <div class="checkbox-group">
                <label><input type="checkbox"> Yes</label>
                <label><input type="checkbox"> No</label>
            </div>
        </div>
    </div>

    <div class="small-text" style="text-align: center; margin-top: 50px;">Return to {{ contact_address }} | {{ contact_email }} | Fax {{ fax_number }}</div>
</div>

<div class="page">
    <div class="section-title" style="text-align: center;">Recommendation of Sponsors</div>

    <div style="margin-top: 30px;">
        <div class="form-row">
            <div class="form-group" style="width: 50%;">
                <div class="form-label">Sponsor Name #1</div>
                <div class="form-input">{{ sponsor_1.name }}</div>
            </div>
            <div class="form-group" style="width: 50%;">
                <div class="form-label">Member Number</div>
                <div class="form-input">{{ sponsor_1.member_number }}</div>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group" style="width: 100%;">
                <div class="form-label">Dear Board of Trustees and Membership Committee of the Petroleum Club of Houston,</div>
                <div class="form-input" style="height: 30px;">The aforementioned applicant is personally known by me to be of good character and would be an excellent Petroleum Club of Houston member. I recommend that he/she be approved for Membership.</div>
            </div>
        </div>
        <div class="form-row" style="margin-top: 20px;">
            <div class="form-group" style="width: 50%;">
                <div class="form-label">Signature</div>
                <div class="signature-line" data-field="signature">{{ signature }}</div>
            </div>
            <div class="form-group" style="width: 50%;">
                <div class="form-label">Additional Comments:</div>
                <div class="form-input" style="height: 60px;" data-field="additional_comments">{{ additional_comments }}</div>
            </div>
        </div>
    </div>

    <div style="margin-top: 60px;">
        <div class="form-row">
            <div class="form-group" style="width: 50%;">
                <div class="form-label">Sponsor Name #2</div>
                <div class="form-input">{{ sponsor_2.name }}</div>
            </div>
            <div class="form-group" style="width: 50%;">
                <div class="form-label">Member Number</div>
                <div class="form-input">{{ sponsor_2.member_number }}</div>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group" style="width: 100%;">
                <div class="form-label">Dear Board of Trustees and Membership Committee of the Petroleum Club of Houston,</div>
                <div class="form-input" style="height: 30px;">The aforementioned applicant is personally known by me to be of good character and would be an excellent Petroleum Club of Houston member. I recommend that he/she be approved for Membership.</div>
            </div>
        </div>
        <div class="form-row" style="margin-top: 20px;">
            <div class="form-group" style="width: 50%;">
                <div class="form-label">Signature</div>
                <div class="signature-line" data-field="signature_2">{{ signature_2 }}</div>
            </div>
            <div class="form-group" style="width: 50%;">
                <div class="form-label">Additional Comments:</div>
                <div class="form-input" style="height: 60px;" data-field="additional_comments_2">{{ additional_comments_2 }}</div>
            </div>
        </div>
    </div>

    <div class="small-text" style="text-align: center; margin-top: 80px;">Note: Sponsors may provide a separate letter if appropriate</div>

    <div class="small-text" style="text-align: center; margin-top: 50px;">Return to {{ contact_address }} | {{ contact_email }} | Fax {{ fax_number }}</div>
</div>

<div class="page">
    <div class="section-title" style="text-align: center;">DISCLOSURE AND AUTHORIZATION</div>

    <p style="font-size: 10pt; line-height: 1.4; margin-top: 20px;">In connection with my application for membership, I UNDERSTAND that CONSUMER REPORTS, WHICH MAY CONTAIN PUBLIC RECORD INFORMATION, MAY BE REQUESTED BY THE ORGANIZATION FROM ASSOCIATED SERVICES EMPLOYMENT CHECK (ASEC). ASEC is a division of Associated Background Inc. I FURTHER UNDERSTAND that these reports provided by ASEC may contain public record information such as my criminal records history (if any) from county, federal, state, and other agencies which maintain such records.</p>

    <p style="font-size: 10pt; line-height: 1.4; margin-top: 15px;">I AUTHORIZE WITHOUT RESERVATION, ANY PARTY OR AGENCY CONTACTED BY ASSOCIATED SERVICES TO FURNISH THE ABOVE MENTIONED INFORMATION.</p>

    <p style="font-size: 10pt; line-height: 1.4; margin-top: 15px;">I have the right to make a request to ASEC upon proper identification, to request the nature and substance of all information in its files on me at the time of my request, including the sources of information and the recipients of any reports on me which ASEC has previously furnished within the two year period preceding my request.</p>

    <p style="font-size: 10pt; line-height: 1.4; margin-top: 20px;">I HEREBY AUTHORIZE PROCUREMENT OF CONSUMER REPORT(S). If membership is approved, this authorization shall remain on file and shall serve as ongoing authorization for you to obtain consumer reports at any time during my membership period.</p>

    <p style="font-size: 10pt; line-height: 1.4; margin-top: 20px;">PLEASE SIGN/DATE HERE, AND THEN FILL OUT THE IDENTIFICATION INFORMATION IN BOX BELOW:</p>

    <div class="form-row" style="margin-top: 30px;">
        <div class="form-group" style="width: 50%;">
            <div class="form-label">APPLICANT'S SIGNATURE</div>
            <div class="signature-line" data-field="applicant_s_signature_2">{{ applicant_s_signature_2 }}</div>
        </div>
        <div class="form-group" style="width: 50%; text-align: right;">
            <div class="form-label">DATE</div>
            <div class="form-input" style="width: 150px; text-align: right;" data-field="date_2">{{ date_2 }}</div>
        </div>
    </div>

    <div class="section-title" style="margin-top: 40px;">The information below is required for identification and background screening purposes only:</div>

    <div class="form-row" style="margin-top: 20px;">
        <div class="form-group" style="width: 25%;">
            <div class="form-label">SOCIAL SECURITY NUMBER</div>
            <div class="form-input">{{ applicant_info.ssn }}</div>
        </div>
        <div class="form-group" style="width: 25%;">
            <div class="form-label">COUNTY OF RESIDENCE</div>
            <div class="form-input">{{ applicant_info.county_of_residence }}</div>
        </div>
        <div class="form-group" style="width: 25%;">
            <div class="form-label">DATE OF BIRTH (mm/dd/yyyy)</div>
            <div class="form-input">{{ applicant_info.dob }}</div>
        </div>
        <div class="form-group" style="width: 25%;">
            <div class="form-label">OTHER LAST NAMES (INDICATE IF MAIDEN)</div>
            <div class="form-input">{{ applicant_info.other_last_names }}</div>
        </div>
    </div>

    <div class="form-row" style="margin-top: 20px;">
        <div class="form-group" style="width: 25%;">
            <div class="form-label">CURRENT ADDRESS</div>
            <div class="form-input">{{ applicant_info.current_address }}</div>
        </div>
        <div class="form-group" style="width: 25%;">
            <div class="form-label">PREVIOUS ADDRESS</div>
            <div class="form-input">{{ applicant_info.previous_address }}</div>
        </div>
    </div>

    <div class="form-row" style="margin-top: 20px;">
        <div class="form-group" style="width: 25%;">
            <div class="form-label">CITY, STATE, AND ZIP CODE</div>
            <div class="form-input">{{ applicant_info.city_state_zip }}</div>
        </div>
        <div class="form-group" style="width: 25%;">
            <div class="form-label">CITY, STATE, AND ZIP CODE</div>
            <div class="form-input">{{ applicant_info.previous_city_state_zip }}</div>
        </div>
    </div>

    <div class="form-row" style="margin-top: 20px;">
        <div class="form-group" style="width: 25%;">
            <div class="form-label">PRINT NAME (First / Middle / Last)</div>
            <div class="form-input">{{ applicant_info.full_name_print }}</div>
        </div>
        <div class="form-group" style="width: 25%;">
            <div class="form-label">DRIVERS LICENSE NUMBER & STATE</div>
            <div class="form-input">{{ applicant_info.driver_license }}</div>
        </div>
    </div>

    <div class="form-row" style="margin-top: 20px;">
        <div class="form-group" style="width: 100%;">
            <div class="form-label">ADDITIONAL FORMER RESIDENCES FOR LAST SEVEN (7) YEARS IF APPLICABLE:</div>
            <div class="form-input" style="height: 50px;">
                (1) {{ applicant_info.former_residence_1 }}
                (2) {{ applicant_info.former_residence_2 }}
            </div>
        </div>
    </div>

    <div class="small-text" style="text-align: center; margin-top: 50px;">Applicants in CA, MN, OK, ME, NY: You have the right to receive a copy of the consumer report. Please indicate if you would like to be furnished with one: Yes No</div>
    <div class="small-text" style="text-align: center; margin-top: 10px;">Return to {{ contact_address }} | {{ contact_email }} | Fax {{ fax_number }}</div>
</div>

<div class="page">
    <div class="section-title" style="text-align: center;">CREDIT CARD AUTHORIZATION FORM</div>

    <div class="form-row" style="margin-top: 30px;">
        <div class="form-group" style="width: 50%;">
            <div class="form-label">CURRENT DATE:</div>
            <div class="form-input">{{ cc_auth.current_date }}</div>
        </div>
        <div class="form-group" style="width: 50%;">
            <div class="form-label">APPLICANT'S NAME E:</div>
            <div class="form-input">{{ cc_auth.applicant_name }}</div>
        </div>
    </div>

    <div class="form-row" style="margin-top: 20px;">
        <div class="form-group" style="width: 50%;">
            <div class="form-label">MEMBER NUMBER: (office use only)</div>
            <div class="form-input">{{ cc_auth.member_number }}</div>
        </div>
        <div class="form-group" style="width: 50%;">
            <div class="form-label">TYPEOF CARD:</div>
            <div class="form-input">{{ cc_auth.type_of_card }}</div>
        </div>
    </div>

    <div class="form-row" style="margin-top: 20px;">
        <div class="form-group" style="width: 50%;">
            <div class="form-label">CARD NUMBER:</div>
            <div class="form-input">{{ cc_auth.card_number }}</div>
        </div>
        <div class="form-group" style="width: 50%;">
            <div class="form-label">CARD EXPIRATION DATE:</div>
            <div class="form-input">{{ cc_auth.card_expiration_date }}</div>
        </div>
    </div>

    <div class="form-row" style="margin-top: 20px;">
        <div class="form-group" style="width: 100%;">
            <div class="form-label">CREDIT CARD BILLING ADDRESS:</div>
            <div class="form-input" style="height: 40px;">{{ cc_auth.billing_address }}</div>
        </div>
    </div>

    <div class="form-row" style="margin-top: 20px;">
        <div class="form-group" style="width: 50%;">
            <div class="form-label">CARD HOLDER'S NAME AS IT APPEARS ON THE CARD:</div>
            <div class="form-input">{{ cc_auth.card_holder_name }}</div>
        </div>
        <div class="form-group" style="width: 50%;">
            <div class="form-label">CARD HOLDER'S SIGNATURE</div>
            <div class="signature-line" data-field="card_holder_s_signature">{{ card_holder_s_signature }}</div>
        </div>
    </div>

    <div class="form-row" style="margin-top: 40px;">
        <div class="form-group" style="width: 100%;">
