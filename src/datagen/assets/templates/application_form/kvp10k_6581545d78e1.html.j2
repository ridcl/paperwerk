<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; }
  h1, h2, h3 { text-align: center; margin-bottom: 0.5em; }
  .header-block { text-align: center; margin-bottom: 30px; }
  .section-title { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 15px; }
  .form-row > div { flex: 1; }
  .full-width-field { width: 100%; border-bottom: 1px solid #000; margin-bottom: 15px; }
  .signature-block { margin-top: 50px; }
  .signature-line { border-bottom: 1px solid #000; margin-bottom: 5px; }
</style>

<div class="page">
  <div class="header-block">
    <h1>GRADUATE SCHOOL</h1>
    <h2>OF ARTS AND SCIENCES</h2>
    <h3>BRYN MAWR</h3>
    <p>COLLEGE</p>
  </div>

  <div class="section-title">APPLICATION FOR CANDIDACY FOR THE DEGREE OF MASTER OF ARTS</div>

  <div class="section-title">BIOGRAPHICAL INFORMATION</div>

  <div class="form-row">
    <div>
      Name of Candidate: <span class="full-width-field">{{ full_name }}</span>
    </div>
    <div>
      ID Number: <span class="full-width-field">{{ id_number }}</span>
    </div>
  </div>

  <div class="form-row">
    <div>
      Home state to be listed on Commencement Program: <span class="full-width-field">{{ home_state }}</span>
    </div>
    <div>
      <!-- Empty space or placeholder if needed -->
    </div>
  </div>

  <div class="form-row">
    <div>
      Department: <span class="full-width-field">{{ department }}</span>
    </div>
    <div>
      <!-- Empty space or placeholder if needed -->
    </div>
  </div>

  <div class="section-title">CHECKLIST FOR DEPARTMENT CHAIR</div>

  <div class="form-row">
    <div>
      I. State languages or other skills required by major department
    </div>
    <div>
      <!-- Placeholder for skills list if applicable, otherwise static text -->
      {% for skill in skills %}
        <span data-field="skills[{{ loop.index0 }}]">{{ skill }}</span>
      {% endfor %}
    </div>
  </div>

  <div class="form-row">
    <div>
      II. Unit requirements met by course or USWs
    </div>
    <div>
      <!-- Placeholder for unit requirements -->
    </div>
  </div>

  <div class="form-row">
    <div>
      6 units completed to date Or
    </div>
    <div>
      <!-- Checkbox simulation -->
      <input type="checkbox">
    </div>
  </div>

  <div class="form-row">
    <div>
      Number of units completed: <span class="full-width-field">{{ units_completed }}</span>
    </div>
    <div>
      Number of units to be complete: <span class="full-width-field">{{ units_to_complete }}</span>
    </div>
  </div>

  <div class="section-title">III. Title of paper to be presented by the candidate in partial fulfillment of the requirements for the M.A.</div>
  <div class="full-width-field" style="height: 150px;">
    <!-- Placeholder for paper title -->
  </div>

  <div class="signature-block">
    <div class="signature-line" data-field="field_1">{{ field_1 }}</div>
    <p>Signature of Faculty Member Directing Student's Work:</p>
    <div class="signature-line" style="margin-top: 40px;" data-field="field_2">{{ field_2 }}</div>
    <p>Director of Graduate Studies in Department:</p>
    <div class="signature-line" style="margin-top: 40px;" data-field="director_of_graduate_studies_in_departme">{{ director_of_graduate_studies_in_departme }}</div>
  </div>
</div>