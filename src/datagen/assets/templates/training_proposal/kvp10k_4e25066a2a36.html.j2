<div class="page">
  <div style="text-align: center;">
    <h1 style="font-size: 18pt; margin-bottom: 5px;">THIAGARAJAR COLLEGE OF ENGINEERING, MADURAI</h1>
    <h2 style="font-size: 14pt; margin-top: 0;">Skill Development Program</h2>
    <h3 style="text-align: center; margin-top: 30px;">Registration Form</h3>
  </div>
  <div style="margin-top: 40px;">
    <p>Name: <span data-field="reg_name">{{ reg_name }}</span></p>
    <p>Designation: <span data-field="reg_designation">{{ reg_designation }}</span></p>
    <p>Name of the Industry : <span data-field="reg_industry_name">{{ reg_industry_name }}</span></p>
    <p>Mailing Address: <span data-field="reg_mailing_address">{{ reg_mailing_address }}</span></p>
    <p>Telephone: <span data-field="reg_telephone">{{ reg_telephone }}</span></p>
    <p>Mobile: <span data-field="reg_mobile">{{ reg_mobile }}</span></p>
    <p>Fax: <span data-field="reg_fax">{{ reg_fax }}</span></p>
    <p>E-mail: <span data-field="reg_email">{{ reg_email }}</span></p>

    <h4 style="margin-top: 30px;">Registration Fee Details:</h4>
    <table>
      <thead>
        <tr>
          <td style="width: 25%;">Registration Fees</td>
          <td style="width: 25%;">DD Number</td>
          <td style="width: 25%;">Date of Issue</td>
          <td style="width: 25%;">Issuing Bank</td>
        </tr>
      </thead>
      <tbody>
        {% for fee in registration_fees %}
        <tr>
          <td><span data-field="registration_fees[{{ loop.index0 }}]">{{ registration_fees[loop.index0] }}</span></td>
          <td><span data-field="registration_fees[{{ loop.index0 }}].dd_number">{{ registration_fees[loop.index0].dd_number }}</span></td>
          <td><span data-field="registration_fees[{{ loop.index0 }}].date_of_issue">{{ registration_fees[loop.index0].date_of_issue }}</span></td>
          <td><span data-field="registration_fees[{{ loop.index0 }}].issuing_bank">{{ registration_fees[loop.index0].issuing_bank }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  <div style="margin-top: 100px;">
    <p>Signature of the participant:</p>
  </div>
  <p style="text-align: center; margin-top: 50px; font-size: 10pt;">Office use only</p>
</div>

