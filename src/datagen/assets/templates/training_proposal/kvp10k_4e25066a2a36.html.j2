<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
  }
  td {
    padding: 5px 0;
  }
</style>

<div class="page">
  <div style="text-align: center;">
    <h1 style="font-size: 18pt; margin-bottom: 5px;">THIAGARAJAR COLLEGE OF ENGINEERING, MADURAI</h1>
    <h2 style="font-size: 14pt; margin-top: 0;">Skill Development Program</h2>
  </div>
  <h3 style="text-align: center; margin-top: 30px;">Requirements of Training Needs by Industry</h3>
  <div style="display: flex; justify-content: space-between; margin-top: 40px;">
    <div>
      <p>Name of the Industry : <span data-field="industry_name">{{ industry_name }}</span></p>
      <p>Type of Industry : <span data-field="industry_type">{{ industry_type }}</span></p>
      <p>Address : <span data-field="industry_address">{{ industry_address }}</span></p>
      <p>Target audience : <span data-field="target_audience">{{ target_audience }}</span></p>
      <p>Domain in which Skill Development Training required : <span data-field="training_domain">{{ training_domain }}</span></p>
      <p>List of requirements :</p>
      <p>Number of Persons can be deputed : <span data-field="number_of_persons">{{ number_of_persons }}</span></p>
      <p>Duration / Number of Days : <span data-field="duration_days">{{ duration_days }}</span></p>
    </div>
    <div style="text-align: right;">
      <p>Ref.No.: III/SD/xx</p>
    </div>
  </div>
  <div style="margin-top: 80px;">
    <p>Signature</p>
  </div>
</div>

