<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1, h2, h3 { text-align: center; margin-bottom: 0.5em; }
  .section { margin-bottom: 20px; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 15px; }
  .form-group { flex: 1; margin-right: 20px; }
  .form-group:last-child { margin-right: 0; }
  .label { font-weight: bold; display: block; margin-bottom: 5px; }
  .input-line { border-bottom: 1px solid #000; min-width: 200px; }
</style>

<div class="page">
  <div style="text-align: center;">
    <span data-field="organization.name">{{ organization.name }}</span>
    <div style="font-size: 0.9em;">
      Department Purchasing Credit Card Request Form
    </div>
    <div style="margin-top: 20px;">
      PLEASE RETURN TO THE PURCHASING OFFICE
    </div>
  </div>

  <div class="section" style="margin-top: 40px;">
    <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
      <div style="width: 45%;">
        <span class="label">Name</span>
        <div class="input-line" style="height: 20px;" data-field="name">{{ name }}</div>
      </div>
      <div style="width: 45%;">
        <span class="label">Department</span>
        <div class="input-line" style="height: 20px;" data-field="department">{{ department }}</div>
      </div>
    </div>

    <div style="margin-bottom: 20px;">
      <div style="display: flex; justify-content: space-between;">
        <div style="flex: 1; margin-right: 20px;">
          <label style="font-weight: normal;">OR</label>
        </div>
        <div style="flex: 1;"></div>
      </div>
    </div>

    <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
      <div style="flex: 1;">
        <label style="font-weight: normal;">(If card is to be issued in the name of an employee)</label>
        <div style="margin-top: 5px;">
          <input type="checkbox" style="margin-right: 5px;">
          <span data-field="employee_status.faculty">{{ employee_status.faculty }}</span>
          <input type="checkbox" style="margin-left: 20px; margin-right: 5px;">
          <span data-field="employee_status.staff">{{ employee_status.staff }}</span>
        </div>
      </div>
      <div style="flex: 1;">
        <label style="font-weight: normal;">(If card is to be issued in the name of a department)</label>
        <div style="margin-top: 5px;">
          <!-- Placeholder for department checkbox if needed, based on layout -->
        </div>
      </div>
    </div>
  </div>

  <div class="section">
    <div class="form-row">
      <div class="form-group" style="flex: 1;">
        <span class="label">Work Phone #:</span>
        <div class="input-line" style="height: 20px;" data-field="work_phone">{{ work_phone }}</div>
      </div>
      <div class="form-group" style="flex: 1;">
        <span class="label">Cell Phone #:</span>
        <div class="input-line" style="height: 20px;" data-field="cell_phone">{{ cell_phone }}</div>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group" style="flex: 1;">
        <span class="label">Date of Birth:</span>
        <div class="input-line" style="height: 20px;" data-field="date_of_birth">{{ date_of_birth }}</div>
      </div>
      <div class="form-group" style="flex: 1;">
        <span class="label">Employee Saints ID#:</span>
        <div class="input-line" style="height: 20px;" data-field="employee_saints_id">{{ employee_saints_id }}</div>
        <div style="font-size: 0.8em; margin-top: 2px;">(as shown on SLU identification card)</div>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group" style="flex: 1;">
        <span class="label">Email Address:</span>
        <div class="input-line" style="height: 20px;" data-field="email_address">{{ email_address }}</div>
      </div>
      <div class="form-group" style="flex: 1;">
        <span class="label">Employee Who Will Be Authorizing Transactions On-line:</span>
        <div class="input-line" style="height: 20px;" data-field="email_address_2">{{ email_address_2 }}</div>
      </div>
    </div>
  </div>

  <div class="section" style="margin-top: 30px;">
    <p style="font-size: 0.9em;">
      Cost Center Expenses will be charged to: 
      <div class="input-line" style="width: 50%; margin-top: 5px;" data-field="field_1">{{ field_1 }}</div>
    </p>
    <p style="font-size: 0.9em;">
      All information needs to be filled out to prevent a delay in processing the card.
    </p>
    <p style="font-size: 0.9em; margin-top: 15px;">
      I request a Corporate Card for Purchasing issued under <span data-field="organization.name">{{ organization.name }}</span> agreement with <span data-field="vendor.name">{{ vendor.name }}</span>. I have read the Cardholder Agreement form attached and agree to comply with the terms and conditions as set out therein. I understand that the card will be revoked if I fail to comply.
    </p>
  </div>

  <div class="section" style="margin-top: 40px;">
    <div class="form-row">
      <div class="form-group" style="flex: 1;">
        <span class="label">Cardholder Name (printed):</span>
        <div class="input-line" style="height: 20px;" data-field="cardholder_name">{{ cardholder_name }}</div>
      </div>
      <div class="form-group" style="flex: 1;">
        <span class="label">Date:</span>
        <div class="input-line" style="height: 20px;" data-field="date">{{ date }}</div>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group" style="flex: 1;">
        <span class="label">VP or Dean or Chair Signature:</span>
        <div class="input-line" style="height: 20px;" data-field="vp_or_dean_or_chair_signature">{{ vp_or_dean_or_chair_signature }}</div>
      </div>
      <div class="form-group" style="flex: 1;">
        <span class="label">Date:</span>
        <div class="input-line" style="height: 20px;" data-field="date_2">{{ date_2 }}</div>
      </div>
    </div>
  </div>

  <div style="text-align: center; margin-top: 50px;">
    PLEASE RETURN TO THE PURCHASING OFFICE
  </div>

  <div class="section" style="margin-top: 40px;">
    <p style="font-weight: bold;">For Internal Use:</p>
    <ul style="list-style-type: none; padding-left: 0; font-size: 0.9em;">
      <li>Create New Account</li>
      <li>Set Card Owner</li>
      <li>Set Allocation Code</li>
      <li>Send Account Creation Email</li>
      <li>Send Card Has Arrived Email</li>
    </ul>
  </div>

  <div class="form-row" style="margin-top: 30px;">
    <div class="form-group" style="flex: 1;">
      <span class="label">Initials:</span>
      <div class="input-line" style="height: 20px;" data-field="initials">{{ initials }}</div>
    </div>
    <div class="form-group" style="flex: 1;">
      <span class="label">Date:</span>
      <div class="input-line" style="height: 20px;" data-field="date_3">{{ date_3 }}</div>
    </div>
  </div>
</div>