<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
  }
  td {
    padding: 5px 0;
  }
  .header {
    font-weight: bold;
    text-align: center;
  }
</style>

<div class="page">
  <div style="text-align: center; margin-bottom: 20px;">
    <h1 style="font-size: 18pt;">HISTORIC RESOURCE SURVEY FORM</h1>
    <p>University of Oregon Cultural Resources Survey</p>
    <p>Eugene, Lane County, Oregon</p>
    <p>Summer 2006</p>
  </div>

  <h2 style="font-weight: bold; border-bottom: 1px solid #000; padding-bottom: 3px;">RESOURCE IDENTIFICATION</h2>
  <table>
    <tr>
      <td>Current building name: <span data-field="current_building_name">{{ current_building_name }}</span></td>
    </tr>
    <tr>
      <td>Historic building name: <span data-field="historic_building_name">{{ historic_building_name }}</span></td>
    </tr>
    <tr>
      <td>Building address: <span data-field="building_address">{{ building_address }}</span></td>
    </tr>
    <tr>
      <td>Ranking: <span data-field="ranking">{{ ranking }}</span></td>
    </tr>
  </table>

  <h2 style="font-weight: bold; border-bottom: 1px solid #000; padding-bottom: 3px; margin-top: 20px;">ARCHITECTURAL DESCRIPTION</h2>
  <table>
    <tr>
      <td>Architectural style classification: <span data-field="architectural_style">{{ architectural_style }}</span></td>
    </tr>
    <tr>
      <td>Building plan (footprint shape): <span data-field="building_plan_shape">{{ building_plan_shape }}</span></td>
    </tr>
    <tr>
      <td>Number of stories: <span data-field="number_of_stories">{{ number_of_stories }}</span></td>
    </tr>
    <tr>
      <td>Foundation material(s): <span data-field="foundation_material">{{ foundation_material }}</span></td>
    </tr>
    <tr>
      <td>Primary exterior wall material: <span data-field="primary_exterior_wall_material">{{ primary_exterior_wall_material }}</span></td>
    </tr>
    <tr>
      <td>Secondary exterior wall material: <span data-field="secondary_exterior_wall_material">{{ secondary_exterior_wall_material }}</span></td>
    </tr>
    <tr>
      <td>Roof configuration/type: <span data-field="roof_configuration_type">{{ roof_configuration_type }}</span></td>
    </tr>
    <tr>
      <td>Primary roof material: <span data-field="primary_roof_material">{{ primary_roof_material }}</span></td>
    </tr>
    <tr>
      <td>Primary window type: <span data-field="primary_window_type">{{ primary_window_type }}</span></td>
    </tr>
    <tr>
      <td>Primary window material: <span data-field="primary_window_material">{{ primary_window_material }}</span></td>
    </tr>
    <tr>
      <td>Decorative features and materials: <span data-field="decorative_features_materials">{{ decorative_features_materials }}</span></td>
    </tr>
    <tr>
      <td>Landscape features: <span data-field="landscape_features">{{ landscape_features }}</span></td>
    </tr>
    <tr>
      <td>Associated resources: <span data-field="associated_resources">{{ associated_resources }}</span></td>
    </tr>
    <tr>
      <td>Comments: <span data-field="comments">{{ comments }}</span></td>
    </tr>
  </table>
</div>

<div class="page">
  <div style="text-align: center; margin-bottom: 20px;">
    <h2 style="font-size: 14pt;">Survey Form Page 2</h2>
    <h2 style="font-size: 14pt;">Building Name: <span data-field="building_name_page2">{{ building_name_page2 }}</span></h2>
  </div>

  <h2 style="font-weight: bold; border-bottom: 1px solid #000; padding-bottom: 3px;">HISTORICAL ASSOCIATIONS & SIGNIFICANCE</h2>
  <table>
    <tr>
      <td>Original use(s) or function(s): <span data-field="original_use_function">{{ original_use_function }}</span></td>
    </tr>
    <tr>
      <td>Current use(s) or function(s): <span data-field="current_use_function">{{ current_use_function }}</span></td>
    </tr>
    <tr>
      <td>Area(s) of significance: <span data-field="area_of_significance">{{ area_of_significance }}</span></td>
    </tr>
    <tr>
      <td>Period of significance: <span data-field="period_of_significance">{{ period_of_significance }}</span></td>
    </tr>
    <tr>
      <td>Statement of Significance (use continuation sheet if necessary):</td>
    </tr>
    <tr>
      <td colspan="2" style="text-align: justify; font-size: 10pt;">
        <span data-field="statement_of_significance">{{ statement_of_significance }}</span>
      </td>
    </tr>
  </table>
</div>

<div class="page">
  <div style="text-align: center; margin-bottom: 20px;">
    <h2 style="font-size: 14pt;">Survey Form Page 3</h2>
    <h2 style="font-size: 14pt;">Building Name: <span data-field="building_name_page3">{{ building_name_page3 }}</span></h2>
  </div>

  <h2 style="font-weight: bold; border-bottom: 1px solid #000; padding-bottom: 3px;">DOCUMENTATION</h2>
  <table>
    <tr>
      <td>Indicate resources consulted when researching this building (check all that apply):</td>
    </tr>
    <tr>
      <td>
        <input type="checkbox"> University archives &nbsp;&nbsp;&nbsp;
        <input type="checkbox"> State Archives &nbsp;&nbsp;&nbsp;
        <input type="checkbox"> Local Historic Society &nbsp;&nbsp;&nbsp;
        <input type="checkbox"> Biographical encyclopedias &nbsp;&nbsp;&nbsp;
      </td>
      <td>
        <input type="checkbox"> UO Planning office files &nbsp;&nbsp;&nbsp;
        <input type="checkbox"> State Library &nbsp;&nbsp;&nbsp;
        <input type="checkbox"> Personal interviews &nbsp;&nbsp;&nbsp;
        <input type="checkbox"> Obituary indexes &nbsp;&nbsp;&nbsp;
      </td>
      <td>
        <input type="checkbox"> Newspapers &nbsp;&nbsp;&nbsp;
        <input type="checkbox"> SHPO files &nbsp;&nbsp;&nbsp;
        <input type="checkbox"> State Historic Society &nbsp;&nbsp;&nbsp;
        <input type="checkbox"> Historic photographs &nbsp;&nbsp;&nbsp;
        <input type="checkbox"> Other: <span data-field="other_documentation">{{ other_documentation }}</span>
      </td>
    </tr>
  </table>

  <h2 style="font-weight: bold; border-bottom: 1px solid #000; padding-bottom: 3px; margin-top: 20px;">BIBLIOGRAPHICAL REFERENCES</h2>
  <table>
    <tr>
      <td><span data-field="reference_1_citation">{{ reference_1_citation }}</span></td>
    </tr>
    <tr>
      <td><span data-field="reference_2_citation">{{ reference_2_citation }}</span></td>
    </tr>
  </table>

  <h2 style="font-weight: bold; border-bottom: 1px solid #000; padding-bottom: 3px; margin-top: 20px;">RECORDING INFORMATION</h2>
  <table>
    <tr>
      <td>Researched: <span data-field="researched_by">{{ researched_by }}</span>, <span data-field="researched_date">{{ researched_date }}</span></td>
    </tr>
    <tr>
      <td>Recorded: <span data-field="recorded_by">{{ recorded_by }}</span>, <span data-field="recorded_date">{{ recorded_date }}</span></td>
    </tr>
    <tr>
      <td>Photo number or name: <span data-field="photo_number_name">{{ photo_number_name }}</span></td>
    </tr>
  </table>
</div>

<div class="page">
  <div style="text-align: center; margin-bottom: 20px;">
    <h2 style="font-size: 14pt;">Survey Form Page 4</h2>
    <h2 style="font-size: 14pt;">Building Name: <span data-field="building_name_page4">{{ building_name_page4 }}</span></h2>
  </div>

  <h2 style="font-weight: bold; border-bottom: 1px solid #000; padding-bottom: 3px;">PHOTOGRAPH</h2>
  <!-- Placeholder for image -->
  <div style="text-align: center; margin-top: 20px;">
    <img src="placeholder_image.jpg" alt="Photograph of the building" style="max-width: 100%; height: auto;">
  </div>

  <h2 style="font-weight: bold; border-bottom: 1px solid #000; padding-bottom: 3px; margin-top: 40px;">SITE PLAN</h2>
  <!-- Placeholder for site plan image -->
  <div style="text-align: center; margin-top: 20px;">
    <img src="placeholder_site_plan.jpg" alt="Site Plan" style="max-width: 100%; height: auto;">
  </div>
</div>