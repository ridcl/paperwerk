<!DOCTYPE html>
<html>
<head>
    <title>Historic Resource Survey Form</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 { font-weight: bold; margin-top: 0; }
        .section-header { font-weight: bold; margin-bottom: 10px; }
        .data-row { display: flex; margin-bottom: 5px; }
        .data-row > div { flex: 1; }
        .label { font-weight: normal; }
        .value { font-weight: normal; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        td { padding: 5px 0; }
        .two-column { display: flex; justify-content: space-between; }
        .two-column > div { width: 48%; }
    </style>
</head>
<body>
    <div class="page">
        <div style="text-align: center; margin-bottom: 30px;">
            <h1 style="font-size: 18pt;">HISTORIC RESOURCE SURVEY FORM</h1>
            <p>University of Oregon Cultural Resources Survey</p>
            <p>Eugene, Lane County, Oregon</p>
            <p>Summer 2006</p>
        </div>

        <div class="section-header">RESOURCE IDENTIFICATION</div>
        <div class="data-row">
            <div class="label">Current building name:</div>
            <div class="value"><span data-field="current_building_name">{{ current_building_name }}</span></div>
        </div>
        <div class="data-row">
            <div class="label">Historic building name:</div>
            <div class="value"><span data-field="historic_building_name">{{ historic_building_name }}</span></div>
        </div>
        <div class="data-row">
            <div class="label">Building address:</div>
            <div class="value"><span data-field="building_address">{{ building_address }}</span></div>
        </div>
        <div class="data-row">
            <div class="label">Ranking:</div>
            <div class="value"><span data-field="ranking">{{ ranking }}</span></div>
        </div>

        <div class="section-header" style="margin-top: 20px;">ARCHITECTURAL DESCRIPTION</div>
        <div class="data-row">
            <div class="label">Architectural style classification:</div>
            <div class="value"><span data-field="architectural_style_classification">{{ architectural_style_classification }}</span></div>
        </div>
        <div class="data-row">
            <div class="label">Building plan (footprint shape):</div>
            <div class="value"><span data-field="building_plan_shape">{{ building_plan_shape }}</span></div>
        </div>
        <div class="data-row">
            <div class="label">Number of stories:</div>
            <div class="value"><span data-field="number_of_stories">{{ number_of_stories }}</span></div>
        </div>
        <div class="data-row">
            <div class="label">Foundation material(s):</div>
            <div class="value"><span data-field="foundation_material">{{ foundation_material }}</span></div>
        </div>
        <div class="data-row">
            <div class="label">Primary exterior wall material:</div>
            <div class="value"><span data-field="primary_exterior_wall_material">{{ primary_exterior_wall_material }}</span></div>
        </div>
        <div class="data-row">
            <div class="label">Secondary exterior wall material:</div>
            <div class="value"><span data-field="secondary_exterior_wall_material">{{ secondary_exterior_wall_material }}</span></div>
        </div>
        <div class="data-row">
            <div class="label">Roof configuration/type:</div>
            <div class="value"><span data-field="roof_configuration_type">{{ roof_configuration_type }}</span></div>
        </div>
        <div class="data-row">
            <div class="label">Primary roof material:</div>
            <div class="value"><span data-field="primary_roof_material">{{ primary_roof_material }}</span></div>
        </div>
        <div class="data-row">
            <div class="label">Primary window type:</div>
            <div class="value"><span data-field="primary_window_type">{{ primary_window_type }}</span></div>
        </div>
        <div class="data-row">
            <div class="label">Decorative features and materials:</div>
            <div class="value"><span data-field="decorative_features_materials">{{ decorative_features_materials }}</span></div>
        </div>
        <div class="data-row">
            <div class="label">Landscape features:</div>
            <div class="value"><span data-field="landscape_features">{{ landscape_features }}</span></div>
        </div>
        <div class="data-row">
            <div class="label">Associated resources:</div>
            <div class="value"><span data-field="associated_resources">{{ associated_resources }}</span></div>
        </div>
        <div class="data-row">
            <div class="label">Comments:</div>
            <div class="value"><span data-field="architectural_comments">{{ architectural_comments }}</span></div>
        </div>
    </div>

    <div class="page">
        <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
            <h2 style="font-size: 14pt;">HISTORICAL ASSOCIATIONS & SIGNIFICANCE</h2>
            <h2 style="font-size: 14pt;">Building Name: <span data-field="building_name_page2">{{ building_name_page2 }}</span></h2>
        </div>

        <div class="data-row">
            <div class="label">Original use(s) or function(s):</div>
            <div class="value"><span data-field="original_use_function">{{ original_use_function }}</span></div>
        </div>
        <div class="data-row">
            <div class="label">Current use(s) or function(s):</div>
            <div class="value"><span data-field="current_use_function">{{ current_use_function }}</span></div>
        </div>
        <div class="data-row">
            <div class="label">Area(s) of significance:</div>
            <div class="value"><span data-field="area_of_significance">{{ area_of_significance }}</span></div>
        </div>
        <div class="data-row">
            <div class="label">Period of significance:</div>
            <div class="value"><span data-field="period_of_significance">{{ period_of_significance }}</span></div>
        </div>
        <div class="data-row">
            <div class="label">Statement of Significance (use continuation sheet if necessary):</div>
            <div class="value"><span data-field="statement_of_significance">{{ statement_of_significance }}</span></div>
        </div>

        <div class="section-header" style="margin-top: 20px;">NATIONAL REGISTER ELIGIBILITY ASSESSMENT</div>
        <div class="two-column">
            <div>
                <div class="data-row">
                    <div class="label">Historic Significance (check one):</div>
                    <div class="value"><span data-field="historic_significance_check">{{ historic_significance_check }}</span></div>
                </div>
                <div class="data-row">
                    <div class="label">Integrity (check one):</div>
                    <div class="value"><span data-field="integrity_check">{{ integrity_check }}</span></div>
                </div>
                <div class="data-row">
                    <div class="label">Condition (check one):</div>
                    <div class="value"><span data-field="condition_check">{{ condition_check }}</span></div>
                </div>
            </div>
            <div>
                <div class="data-row">
                    <div class="label">High</div>
                    <div class="value"><span data-field="high_value">{{ high_value }}</span></div>
                </div>
                <div class="data-row">
                    <div class="label">Medium</div>
                    <div class="value"><span data-field="medium_value">{{ medium_value }}</span></div>
                </div>
                <div class="data-row">
                    <div class="label">Low</div>
                    <div class="value"><span data-field="low_value">{{ low_value }}</span></div>
                </div>
            </div>
        </div>

        <div class="data-row" style="margin-top: 15px;">
            <div class="label">Building designation:</div>
            <div class="value"><span data-field="building_designation">{{ building_designation }}</span></div>
        </div>
        <div class="data-row">
            <div class="label">Preliminary National Register eligibility findings:</div>
            <div class="value"><span data-field="preliminary_eligibility_findings">{{ preliminary_eligibility_findings }}</span></div>
        </div>
        <div class="data-row">
            <div class="label">If eligible individually, applicable criteria (check all that apply):</div>
            <div class="value"><span data-field="applicable_criteria">{{ applicable_criteria }}</span></div>
        </div>
        <div class="data-row">
            <div class="label">If applicable, building qualifies under NR Criterion Considerations:</div>
            <div class="value"><span data-field="nr_criterion_considerations">{{ nr_criterion_considerations }}</span></div>
        </div>
        <div class="data-row">
            <div class="label">Building is NOT eligible:</div>
            <div class="value"><span data-field="not_eligible_reason">{{ not_eligible_reason }}</span></div>
        </div>
    </div>

    <div class="page">
        <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
            <h2 style="font-size: 14pt;">DOCUMENTATION</h2>
            <h2 style="font-size: 14pt;">Building Name: <span data-field="building_name_page3">{{ building_name_page3 }}</span></h2>
        </div>

        <div class="section-header">Indicate resources consulted when researching this building (check all that apply):</div>
        <div class="two-column">
            <div>
                <div class="data-row">
                    <div class="label">X University archives</div>
                    <div class="value"><span data-field="consulted_university_archives">{{ consulted_university_archives }}</span></div>
                </div>
                <div class="data-row">
                    <div class="label">X Sanborn maps</div>
                    <div class="value"><span data-field="consulted_sanborn_maps">{{ consulted_sanborn_maps }}</span></div>
                </div>
                <div class="data-row">
                    <div class="label">X Local Historic Society</div>
                    <div class="value"><span data-field="consulted_local_historic_society">{{ consulted_local_historic_society }}</span></div>
                </div>
                <div class="data-row">
                    <div class="label">X Biographical encyclopedias</div>
                    <div class="value"><span data-field="consulted_biographical_encyclopedias">{{ consulted_biographical_encyclopedias }}</span></div>
                </div>
            </div>
            <div>
                <div class="data-row">
                    <div class="label">X UO Planning Office files</div>
                    <div class="value"><span data-field="consulted_uo_planning_office_files">{{ consulted_uo_planning_office_files }}</span></div>
                </div>
                <div class="data-row">
                    <div class="label">X State Library</div>
                    <div class="value"><span data-field="consulted_state_library">{{ consulted_state_library }}</span></div>
                </div>
                <div class="data-row">
                    <div class="label">X Personal interviews</div>
                    <div class="value"><span data-field="consulted_personal_interviews">{{ consulted_personal_interviews }}</span></div>
                </div>
                <div class="data-row">
                    <div class="label">X Obituary indexes</div>
                    <div class="value"><span data-field="consulted_obituary_indexes">{{ consulted_obituary_indexes }}</span></div>
                </div>
            </div>
        </div>

        <div class="section-header" style="margin-top: 20px;">BIBLIOGRAPHICAL REFERENCES</div>
        <div class="data-row">
            <div class="label">Daily Emerald. "Science Building work started; total cost to be over $2 million." <span data-field="daily_emerald_reference">{{ daily_emerald_reference }}</span>.</div>
        </div>
        <div class="data-row">
            <div class="label">Facilities Services. "University of Oregon Building Records, Projects and Improvements." [CD-ROM] Eugene, OR: University of Oregon, 2006.</div>
        </div>
        <div class="data-row">
            <div class="label">Lawrence, Tucker and Wallmann Architects. "Science Building - First Addition." Drawings, Portland, OR: Lawrence, Tucker and Wallmann Architects, March 1960.</div>
        </div>
        <div class="data-row">
            <div class="label">Lawrence, Tucker and Wallmann Architects. "Science Building - First Addition, Reported As-Built." Drawings, Portland, OR: Lawrence, Tucker and Wallmann Architects, October 1960.</div>
        </div>
        <div class="data-row">
            <div class="label">Old Oregon. Eugene, OR: University of Oregon Alumni Association, April-May 1960.</div>
        </div>
        <div class="data-row">
            <div class="label">Old Oregon. Eugene, OR: University of Oregon Alumni Association, June-July 1958.</div>
        </div>
        <div class="data-row">
            <div class="label">Oregana. Eugene, OR: University of Oregon, 1960.</div>
        </div>
        <div class="data-row">
            <div class="label">Oregana. Eugene, OR: University of Oregon, 1975.</div>
        </div>
        <div class="data-row">
            <div class="label">Pigger's Guide. Eugene, OR: University of Oregon, 1960-61.</div>
        </div>
        <div class="data-row">
            <div class="label">Sanborn Map Company, Sanborn Library, LLC. Digital Sanborn Maps. ProQuest Information and Learning Company, 2001. Accessed 26 February 2005 from <span data-field="sanborn_map_url">{{ sanborn_map_url }}</span>.</div>
        </div>
        <div class="data-row">
            <div class="label">University of Oregon 125th Anniversary at <span data-field="anniversary_url">{{ anniversary_url }}</span>.</div>
        </div>
        <div class="data-row">
            <div class="label">University Planning Office. "Getty Foundation Campus Heritage Grant 2005." Eugene, OR: University of Oregon, 2005.</div>
        </div>
        <div class="data-row">
            <div class="label">University Planning Office. University of Oregon Northeast Central Campus Diagnosis. Eugene, OR: University of Oregon, 1999.</div>
        </div>
        <div class="data-row">
            <div class="label">Wright, Sally and Pinyard, David. Eugene Modernism 1935-1965. Eugene, OR: Eugene Planning and Development, 2003.</div>
        </div>

        <div class="section-header" style="margin-top: 20px;">RECORDING INFORMATION</div>
        <div class="data-row">
            <div class="label">Researched:</div>
            <div class="value"><span data-field="researched_by">{{ researched_by }}</span></div>
        </div>
        <div class="data-row">
            <div class="label">Recorded:</div>
            <div class="value"><span data-field="recorded_by">{{ recorded_by }}</span></div>
        </div>
        <div class="data-row">
            <div class="label">Photo number or name:</div>
            <div class="value"><span data-field="photo_number_name">{{ photo_number_name }}</span></div>
        </div>
    </div>

    <div class="page">
        <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
            <h2 style="font-size: 14pt;">PHOTOGRAPH</h2>
            <h2 style="font-size: 14pt;">Building Name: <span data-field="building_name_page4">{{ building_name_page4 }}</span></h2>
        </div>

        <div style="text-align: center; margin-bottom: 30px;">
            <!-- Placeholder for image -->
            <img src="placeholder_image.jpg" alt="Photograph of the building" style="max-width: 100%; height: auto; border: 1px solid #ccc;">
        </div>

        <div class="section-header" style="margin-top: 20px;">SITE PLAN</div>
        <div style="text-align: center;">
            <!-- Placeholder for site plan -->
            <img src="placeholder_site_plan.png" alt="Site plan of the building" style="max-width: 100%; height: auto; border: 1px solid #ccc;">
        </div>
    </div>
</body>
</html>