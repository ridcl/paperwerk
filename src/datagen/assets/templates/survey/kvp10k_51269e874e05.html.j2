      </div>
      <div>
        <p>Some need</p>
        <div class="radio-group"><input type="radio" name="getting_older_need_b" data-field="getting_older_need_b_value" value="{{ getting_older_need_b_value }}"></div>
      </div>
      <div>
        <p>Little or No need</p>
        <div class="radio-group"><input type="radio" name="getting_older_need_c" data-field="getting_older_need_c_value" value="{{ getting_older_need_c_value }}"></div>
      </div>
    </div>
  </div>

  <div class="question-block">
    <div class="question-text">2b. When thinking about <strong>getting older</strong>, what is most important? (Please select only one response)</div>
    <div class="radio-options">
      <label><input type="radio" name="getting_older_importance_a" data-field="getting_older_importance_a_value" value="{{ getting_older_importance_a_value }}"> Services and supports for people with I/DD who are aging</label>
      <label><input type="radio" name="getting_older_importance_b" data-field="getting_older_importance_b_value" value="{{ getting_older_importance_b_value }}"> Understanding how age-related disorders (for example, memory loss or poor vision) impact people with I/DD</label>
      <label><input type="radio" name="getting_older_importance_c" data-field="getting_older_importance_c_value" value="{{ getting_older_importance_c_value }}"> Other, please specify: <input type="text" data-field="getting_older_other_specify" value="{{ getting_older_other_specify }}"></label>
