<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Sans", "Liberation Sans", Arial, Helvetica, sans-serif;
    color: #000;
  }
  h1, h2, h3 {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, serif;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  td {
    padding: 4px 0;
  }
  .header-title {
    font-size: 24pt;
    font-weight: bold;
    margin-bottom: 5px;
  }
  .model-number {
    font-size: 18pt;
    font-weight: bold;
    margin-bottom: 30px;
  }
  .section-header {
    font-size: 14pt;
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
  }
  .spec-table td:first-child {
    font-weight: normal;
    width: 60%;
  }
  .spec-table td:last-child {
    font-weight: normal;
    width: 40%;
    text-align: right;
  }
  .footer-text {
    font-size: 9pt;
    color: #555;
    text-align: center;
    margin-top: 50px;
  }
</style>

<div class="page">
  <div style="text-align: left;">
    <div class="header-title">Product data sheet</div>
    <div class="model-number">Surge Protective Devices<br>OVRT21N40150PTSU</div>
  </div>

  <div style="margin-top: 40px;">
    <div class="section-header">Electrical Characteristics</div>
    <table class="spec-table">
      <tr>
        <td>Protection mode</td>
        <td><span data-field="protection_mode">{{ protection_mode }}</span></td>
      </tr>
      <tr>
        <td>Number of poles / Type of current</td>
        <td><span data-field="number_of_poles">{{ number_of_poles }}</span> / <span data-field="type_of_current">{{ type_of_current }}</span></td>
      </tr>
      <tr>
        <td>Type / Test class</td>
        <td><span data-field="type_test_class">{{ type_test_class }}</span></td>
      </tr>
      <tr>
        <td>Nominal voltage (Ue) (L-N)</td>
        <td><span data-field="nominal_voltage_ln">{{ nominal_voltage_ln }}</span></td>
      </tr>
      <tr>
        <td>Frequency</td>
        <td><span data-field="frequency">{{ frequency }}</span></td>
      </tr>
      <tr>
        <td>Maximum continuous operating voltage (Ue) (L-N)</td>
        <td><span data-field="max_continuous_operating_voltage_ln">{{ max_continuous_operating_voltage_ln }}</span></td>
      </tr>
      <tr>
        <td>Voltage protection level (U_p) 3 kA (L-N)</td>
        <td><span data-field="voltage_protection_level_3ka_ln">{{ voltage_protection_level_3ka_ln }}</span></td>
      </tr>
      <tr>
        <td>Voltage protection level (U_p) 5 kA (L-N)</td>
        <td><span data-field="voltage_protection_level_5ka_ln">{{ voltage_protection_level_5ka_ln }}</span></td>
      </tr>
      <tr>
        <td>Voltage protection level (U_p) 10 kA (L-N/L-G)</td>
        <td><span data-field="voltage_protection_level_10ka_lnlg">{{ voltage_protection_level_10ka_lnlg }}</span></td>
      </tr>
      <tr>
        <td>Voltage protection rating (VPR - UL 3rd Ed.) (L-N/L-G)</td>
        <td><span data-field="voltage_protection_rating_vpr">{{ voltage_protection_rating_vpr }}</span></td>
      </tr>
      <tr>
        <td>Nominal discharge current (I_n) @ 8/20</td>
        <td><span data-field="nominal_discharge_current_in">{{ nominal_discharge_current_in }}</span></td>
      </tr>
      <tr>
        <td>Maximum discharge current (I_m) @ 8/20</td>
        <td><span data-field="maximum_discharge_current_im">{{ maximum_discharge_current_im }}</span></td>
      </tr>
      <tr>
        <td>Follow current interrupt rating (I_n/L-N/G)</td>
        <td><span data-field="follow_current_interrupt_rating">{{ follow_current_interrupt_rating }}</span></td>
      </tr>
      <tr>
        <td>Response time</td>
        <td><span data-field="response_time">{{ response_time }}</span></td>
      </tr>
      <tr>
        <td>Operating current (I_op)</td>
        <td><span data-field="operating_current_iop">{{ operating_current_iop }}</span></td>
      </tr>
      <tr>
        <td><span style="font-weight: bold;"></span></td>
        <td><span data-field="placeholder_field_1">{{ placeholder_field_1 }}</span></td>
      </tr>
    </table>
  </div>

  <div style="margin-top: 30px;">
    <div class="section-header">Mechanical Characteristics</div>
    <table class="spec-table">
      <tr>
        <td>Wire range - Solid wire</td>
        <td><span data-field="wire_range_solid">{{ wire_range_solid }}</span></td>
      </tr>
      <tr>
        <td>Wire range - Stranded wire</td>
        <td><span data-field="wire_range_stranded">{{ wire_range_stranded }}</span></td>
      </tr>
      <tr>
        <td>Stripping length</td>
        <td><span data-field="stripping_length">{{ stripping_length }}</span></td>
      </tr>
      <tr>
        <td>Tightening torque</td>
        <td><span data-field="tightening_torque">{{ tightening_torque }}</span></td>
      </tr>
      <tr>
        <td>Degree of protection</td>
        <td><span data-field="degree_of_protection">{{ degree_of_protection }}</span></td>
      </tr>
      <tr>
        <td>Remote indicator</td>
        <td><span data-field="remote_indicator">{{ remote_indicator }}</span></td>
      </tr>
      <tr>
        <td>Disconnector circuit breaker B or C curve</td>
        <td><span data-field="disconnector_circuit_breaker_curve">{{ disconnector_circuit_breaker_curve }}</span></td>
      </tr>
      <tr>
        <td>Disconnector J class fuse</td>
        <td><span data-field="disconnector_j_class_fuse">{{ disconnector_j_class_fuse }}</span></td>
      </tr>
    </table>
  </div>

  <div style="margin-top: 30px;">
    <div class="section-header">Miscellaneous Characteristics</div>
    <table class="spec-table">
      <tr>
        <td>Operating temperature / Storing temperature</td>
        <td><span data-field="operating_temperature">{{ operating_temperature }}</span></td>
      </tr>
      <tr>
        <td>Maximum altitude</td>
        <td><span data-field="maximum_altitude">{{ maximum_altitude }}</span></td>
      </tr>
      <tr>
        <td>Weight</td>
        <td><span data-field="weight">{{ weight }}</span></td>
      </tr>
      <tr>
        <td>Color of housing / Fire resistance according to UL94</td>
        <td><span data-field="color_of_housing">{{ color_of_housing }}</span></td>
      </tr>
      <tr>
        <td>Reference standards</td>
        <td><span data-field="reference_standards">{{ reference_standards }}</span></td>
      </tr>
      <tr>
        <td>Replacement Cartridges</td>
        <td><span data-field="replacement_cartridges">{{ replacement_cartridges }}</span></td>
      </tr>
      <tr>
        <td>Phase</td>
        <td><span data-field="phase">{{ phase }}</span></td>
      </tr>
      <tr>
        <td>Neutral</td>
        <td><span data-field="neutral">{{ neutral }}</span></td>
      </tr>
    </table>
  </div>

  <div style="position: absolute; bottom: 50px; right: 60px; text-align: right;">
    <div style="font-size: 10pt; line-height: 1.4;">
      <div style="font-weight: bold;">Power and productivity</div>
      <div style="font-size: 12pt; font-weight: bold;">for a better world™</div>
      <img src="placeholder_abb_logo.png" alt="ABB Logo" style="width: 150px; margin-top: 10px;">
    </div>
  </div>
</div>

<div class="page">
  <div style="text-align: left;">
    <h2 style="font-size: 18pt; margin-bottom: 10px;">Contact us</h2>
    <div style="margin-top: 20px;">
      <p><strong>Canada</strong></p>
      <p><span data-field="company_name">{{ company_name }}</span></p>
      <p><span data-field="address_line_1">{{ address_line_1 }}</span></p>
      <p><span data-field="address_line_2">{{ address_line_2 }}</span></p>
      <p>Tel.: <span data-field="phone_number_tel">{{ phone_number_tel }}</span></p>
      <p>Fax: <span data-field="phone_number_fax">{{ phone_number_fax }}</span></p>
      <p>Toll Free: 1-800-<span data-field="toll_free_number">{{ toll_free_number }}</span></p>
      <p><span data-field="website_url">{{ website_url }}</span></p>
    </div>
  </div>

  <div style="position: absolute; top: 50px; right: 60px; text-align: right;">
    <div style="font-size: 10pt; line-height: 1.4;">
      <p>While all care has been taken to ensure that the information contained in this publication is correct, no responsibility can be accepted for any inaccuracy. The Company reserves the right to alter or modify the information contained herein without notice. The Company does not warrant that the information contained herein is accurate or complete, and the Company shall not be liable for any loss or damage arising from the use of this information.</p>
      <p>© Copyright <span data-field="copyright_year">{{ copyright_year }}</span> <span data-field="copyright_holder">{{ copyright_holder }}</span>. All rights reserved.</p>
      <img src="placeholder_ul_logo.png" alt="UL Logo" style="width: 50px; margin-top: 10px;">
    </div>
  </div>

  <div style="position: absolute; bottom: 50px; right: 60px; text-align: right;">
    <div style="font-size: 10pt; line-height: 1.4;">
      <div style="font-weight: bold;">Power and productivity</div>
      <div style="font-size: 12pt; font-weight: bold;">for a better world™</div>
      <img src="placeholder_abb_logo_footer.png" alt="ABB Logo" style="width: 150px; margin-top: 10px;">
    </div>
  </div>
</div>