<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  .header-title { font-size: 24pt; font-weight: bold; }
  .header-info { font-size: 10pt; }
  .section-title { font-size: 12pt; font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 15px; }
  .form-label { font-weight: normal; }
  .form-input-group { display: flex; align-items: center; }
  .form-input { border-bottom: 1px solid #000; padding: 2px 5px; flex-grow: 1; }
  .divider { border-top: 1px solid #000; margin: 30px 0; }
  .address-block { margin-top: 20px; font-size: 10pt; }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      <div class="header-title">CAL POLY HUMBOLDT</div>
    </div>
    <div class="header-info" style="text-align: right;">
      Office of the Registrar • SBS 133 • <span data-field="city">{{ city }}</span>, <span data-field="state">{{ state }}</span> <span data-field="zip_code">{{ zip_code }}</span> | <span data-field="phone">{{ phone }}</span>
      <div style="margin-top: 10px;">
        <strong>SOCIAL SECURITY NUMBER CHANGE</strong>
      </div>
    </div>
  </div>

  <p style="margin-top: 20px;">This form is used to update or change an incorrect Social Security number in the University's database. A <span data-field="copy_of_ssn_required">{{ copy_of_ssn_required }}</span></p>

  <div class="form-row">
    <div class="form-label" style="width: 100px;">Date</div>
    <div class="form-input-group" style="flex-grow: 1;">
      <span data-field="date" class="form-input" style="width: 200px;">{{ date }}</span>
    </div>
  </div>

  <div class="form-row">
    <div class="form-label" style="width: 100px;">Name</div>
    <div class="form-input-group" style="flex-grow: 1;">
      <span data-field="full_name" class="form-input" style="width: 300px;">{{ full_name }}</span>
    </div>
  </div>

  <div class="form-row">
    <div class="form-label" style="width: 100px;">Humboldt ID:</div>
    <div class="form-input-group" style="flex-grow: 1;">
      {% for i in range(10) %}
        <span data-field="humboldt_id_digit_{{ loop.index }}">{{ "" }}</span>
      {% endfor %}
    </div>
  </div>

  <div class="form-row">
    <div class="form-label" style="width: 100px;">Humboldt Email:</div>
    <div class="form-input-group" style="flex-grow: 1;">
      <span data-field="humboldt_email" class="form-input" style="width: 300px;">{{ humboldt_email }}</span>
    </div>
  </div>

  <div class="form-row">
    <div class="form-label" style="width: 100px;">Phone</div>
    <div class="form-input-group" style="flex-grow: 1;">
      <span data-field="phone_number" class="form-input" style="width: 300px;">{{ phone_number }}</span>
    </div>
  </div>

  <p style="font-size: 9pt; margin-top: -10px; margin-bottom: 20px;">* If you will not be checking your university email account, please go to your <a href="#" style="color: #000;">Account Center</a> to forward your university email to your personal email account.</p>

  <div class="divider"></div>

  <div class="form-row" style="margin-top: 0;">
    <div style="width: 48%;">
      <div class="section-title">OLD or Incorrect Social Security Number</div>
      <div class="form-input-group">
        <span data-field="old_ssn" class="form-input" style="width: 100%;">{{ old_ssn }}</span>
      </div>
    </div>
    <div style="width: 48%;">
      <div class="section-title">NEW or correct Social Security Number</div>
      <div class="form-input-group">
        <span data-field="new_ssn" class="form-input" style="width: 100%;">{{ new_ssn }}</span>
      </div>
    </div>
  </div>

  <p style="margin-top: 30px;">Return your completed form and a copy of your social security card:</p>

  <div class="address-block">
    <p>In person to SBS 133 or</p>
    <p>Mail to:</p>
    <p>Office of the Registrar</p>
    <p>Cal Poly Humboldt</p>
    <p><span data-field="street_address_line_1">{{ street_address_line_1 }}</span></p>
    <p><span data-field="city">{{ city }}</span>, <span data-field="state">{{ state }}</span> <span data-field="zip_code">{{ zip_code }}</span></p>
  </div>

  <div style="position: absolute; bottom: 50px; right: 60px; font-size: 9pt;">
    social-security-number-change<br>
    <span data-field="document_date">{{ document_date }}</span>
  </div>
</div>