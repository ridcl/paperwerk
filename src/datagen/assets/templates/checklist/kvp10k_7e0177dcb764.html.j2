<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child {
    page-break-after: auto;
  }
  h1, h2, h3 {
    font-weight: bold;
  }
  .checklist-item {
    margin-bottom: 10px;
  }
  .checklist-item input[type="checkbox"] {
    margin-right: 10px;
  }
</style>

<div class="page">
  <h1>CHARGER CHECKLIST</h1>
  <h2>Congratulations on your admission to {{ institution_name }}!</h2>

  <div style="margin-top: 30px;">
    <h3>FINANCES & SCHOLARSHIPS</h3>
    <div class="checklist-item">
      <input type="checkbox">
      Review Scholarship Eligibility: <span data-field="scholarship_link">{{ scholarship_link }}</span>
    </div>
    <div class="checklist-item">
      <input type="checkbox">
      Freshman Academic Scholarships are awarded based on high school work, test scores, and residency. View more information about these scholarships, upgrade opportunities, and important deadlines at <span data-field="scholarship_info_link">{{ scholarship_info_link }}</span>.
    </div>
    <div class="checklist-item">
      <input type="checkbox">
      Apply for Financial Aid: <span data-field="financial_aid_link">{{ financial_aid_link }}</span>
    </div>
    <div class="checklist-item">
      <input type="checkbox">
      To be considered for federal aid, U.S. citizens and permanent residents should submit the Free Application for Federal Student Aid (FAFSA) at <span data-field="fafsa_link">{{ fafsa_link }}</span>.
    </div>
    <div class="checklist-item">
      <input type="checkbox">
      Students planning to utilize VA educational benefits should contact the Military and Veterans Programs Office at <span data-field="va_office_contact">{{ va_office_contact }}</span>.
    </div>
  </div>

  <div style="margin-top: 30px;">
    <h3>STUDENT SERVICES & HOUSING</h3>
    <div class="checklist-item">
      <input type="checkbox">
      Access Your Online Services: <span data-field="myuh_link">{{ myuh_link }}</span>
    </div>
    <div class="checklist-item">
      <input type="checkbox">
      Register for Housing: <span data-field="housing_link">{{ housing_link }}</span>
    </div>
    <div class="checklist-item">
      <input type="checkbox">
      If an emergency occurs, please contact <span data-field="emergency_contact_info">{{ emergency_contact_info }}</span>.
    </div>
    <div class="checklist-item">
      <input type="checkbox">
      Access Your Email: <span data-field="email_link">{{ email_link }}</span>
    </div>
    <div class="checklist-item">
      <input type="checkbox">
      To access your UAH email account (<span data-field="email_address_placeholder">{{ email_address_placeholder }}</span>), visit <span data-field="email_login_url">{{ email_login_url }}</span> and enter your Charger email address as the username and your <span data-field="password_placeholder">{{ password_placeholder }}</span>.
    </div>
  </div>

  <div style="margin-top: 30px;">
    <h3>ACADEMICS</h3>
    <div class="checklist-item">
      <input type="checkbox">
      Apply for Housing: <span data-field="housing_application_link">{{ housing_application_link }}</span>
    </div>
    <div class="checklist-item">
      <input type="checkbox">
      Review Meal Plan Options: <span data-field="meal_plan_link">{{ meal_plan_link }}</span>
    </div>
    <div class="checklist-item">
      <input type="checkbox">
      Submit Your Immunization Records: <span data-field="immunization_records_link">{{ immunization_records_link }}</span>
    </div>
  </div>

  <div style="margin-top: 30px;">
    <h3>ORIENTATION</h3>
    <div class="checklist-item">
      <input type="checkbox">
      Register for New Student Orientation: <span data-field="orientation_link">{{ orientation_link }}</span>
    </div>
    <div class="checklist-item">
      <input type="checkbox">
      Orientation provides you the opportunity to meet with an academic advisor, register for classes, meet other new students, and more.
    </div>
    <div class="checklist-item">
      <input type="checkbox">
      Look for registration information to be sent in early April for the summer and fall semesters in November for the spring semester.
    </div>
  </div>

  <div style="margin-top: 30px;">
    <h3>ACADEMICS (Continued)</h3>
    <div class="checklist-item">
      <input type="checkbox">
      Submit Your Final Transcript:
      <p style="margin-left: 20px; font-size: 0.9em;">Send your final high school transcript to the Office of Admissions after graduation.</p>
    </div>
    <div class="checklist-item">
      <input type="checkbox">
      Submit Dual Enrollment/AP/IB/CLEP Credit:
      <p style="margin-left: 20px; font-size: 0.9em;">To receive credit for dual enrollment courses, you will need to submit an official final college transcript once all coursework has been completed.</p>
      <p style="margin-left: 20px; font-size: 0.9em;">If you are taking courses through UAH school college, please visit <span data-field="dual_enrollment_link">{{ dual_enrollment_link }}</span>.</p>
      <p style="margin-left: 20px; font-size: 0.9em;">Once official transcripts and test scores have been received and evaluated, you may view your credit on your Academic Transcript through your myUAH account.</p>
    </div>
    <div class="checklist-item">
      <input type="checkbox">
      Determine Your Academic Placement: <span data-field="placement_link">{{ placement_link }}</span>
    </div>
    <div class="checklist-item">
      <input type="checkbox">
      Academic placement for new students is determined by your ACT/SAT test results and/or high school GPA. Determine your academic placement at <span data-field="placement_details_link">{{ placement_details_link }}</span>.
    </div>
  </div>

  <div style="margin-top: 50px; border-top: 1px solid #ccc; padding-top: 20px;">
    <p>Questions? Contact the Office of Admissions</p>
    <p>
      <span data-field="phone_number_1">{{ phone_number_1 }}</span> | 
      <span data-field="phone_number_2">{{ phone_number_2 }}</span> | 
      <span data-field="admissions_email">{{ admissions_email }}</span> | 
      <span data-field="uah_admissions_link">{{ uah_admissions_link }}</span>
    </p>
  </div>
</div>