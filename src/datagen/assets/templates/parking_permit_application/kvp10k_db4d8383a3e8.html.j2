      <p style="font-size: 0.9em;">* Indicates required fields</p>
    </div>

    <h2 style="border-bottom: 1px solid #eee; padding-bottom: 5px;">Payment Information</h2>
    <form>
      <div class="form-group">
        <label for="card_number">Card Number *</label>
        <input type="text" id="card_number" name="card_number" data-field="payment_card_number" value="{{ payment_card_number }}">
      </div>
      <div class="form-group" style="display: flex; gap: 15px;">
        <div style="flex: 1;">
          <label for="expiry_month">Expiration Month *</label>
          <input type="text" id="expiry_month" name="expiry_month" data-field="payment_expiry_month" value="{{ payment_expiry_month }}">
        </div>
        <div style="flex: 1;">
          <label for="expiry_year">Expiration Year *</label>
          <input type="text" id="expiry_year" name="expiry_year" data-field="payment_expiry_year" value="{{ payment_expiry_year }}">
        </div>
      </div>
      <div class="form-group" style="display: flex; gap: 15px;">
        <div style="flex: 1;">
          <label for="cvv">CVV *</label>
          <input type="text" id="cvv" name="cvv" data-field="payment_cvv" value="{{ payment_cvv }}">
        </div>
      </div>

      <h2 style="border-bottom: 1px solid #eee; padding-bottom: 5px; margin-top: 40px;">Billing Information</h2>
      <div class="form-group">
        <label for="billing_address">Street Address *</label>
        <input type="text" id="billing_address" name="billing_address" data-field="billing_address" value="{{ billing_address }}">
      </div>
      <div class="form-group" style="display: flex; gap: 15px;">
        <div style="flex: 1;">
          <label for="billing_city">City *</label>
          <input type="text" id="billing_city" name="billing_city" data-field="billing_city" value="{{ billing_city }}">
        </div>
        <div style="flex: 1;">
          <label for="billing_state">State *</label>
          <input type="text" id="billing_state" name="billing_state" data-field="billing_state" value="{{ billing_state }}">
        </div>
      </div>
      <div class="form-group">
        <label for="billing_zip">Zip Code *</label>
        <input type="text" id="billing_zip" name="billing_zip" data-field="billing_zip" value="{{ billing_zip }}">
      </div>

      <h2 style="border-bottom: 1px solid #eee; padding-bottom: 5px; margin-top: 40px;">Contact Information</h2>
      <div class="form-group">
        <label for="phone">Phone *</label>
        <input type="text" id="phone" name="phone" data-field="contact_phone" value="{{ contact_phone }}">
      </div>
      <div class="form-group">
        <label for="email_contact">Email *</label>
        <input type="email" id="email_contact" name="email_contact" data-field="contact_email" value="{{ contact_email }}">
      </div>

      <div class="form-group" style="margin-top: 30px;">
        <input type="checkbox" id="terms" data-field="terms_agreement" value="{{ terms_agreement }}">
        <label for="terms">By clicking Continue, I agree to the above Policy.</label>
      </div>

      <div style="text-align: right; margin-top: 40px;">
        <button type="submit" class="button" style="background-color: #dc3545;">Cancel Transaction</button>
        <button type="submit" class="button" style="background-color: green;">Continue</button>
      </div>
    </form>
  </div>
</div>

