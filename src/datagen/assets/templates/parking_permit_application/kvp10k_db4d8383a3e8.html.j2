<!DOCTYPE html>
<html>
<head>
<title>Synthetic Document</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic layout structure */
  h1, h2, h3 { margin-top: 0; }
  .header-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
  .nav-tabs { display: flex; border-bottom: 1px solid #ccc; margin-bottom: 20px; }
  .nav-tabs a { padding: 10px 15px; text-decoration: none; color: #333; }
  .content-section { margin-bottom: 30px; }
  .form-group { margin-bottom: 15px; }
  .form-group label { display: block; margin-bottom: 5px; font-weight: bold; }
  .form-group input[type="text"], .form-group input[type="email"], .form-group input[type="password"], .form-group select { width: 100%; padding: 8px; box-sizing: border-box; border: 1px solid #ccc; }
  .button { padding: 10px 20px; background-color: #0056b3; color: white; border: none; cursor: pointer; margin-top: 10px; }
  .table-container { margin-top: 20px; }
  table { width: 100%; border-collapse: collapse; margin-top: 15px; }
  th, td { border: 1px solid #ddd; padding: 10px; text-align: left; }
  th { background-color: #f2f2f2; }
  .text-center { text-align: center; }
</style>
</head>
<body>

<div class="page">
  <div style="text-align: center; margin-bottom: 40px;">
    <p>Follow this link to the <span data-field="link_text">{{ link_text }}</span> or navigate to <span data-field="url_path">{{ url_path }}</span> and click the <span data-field="button_text">{{ button_text }}</span> link.</p>
  </div>
  
  <!-- Header Section Mimic -->
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #333; padding-bottom: 10px; margin-bottom: 20px;">
    <div style="display: flex; align-items: center;">
      <img src="placeholder_logo.png" alt="University Logo" style="height: 50px; margin-right: 15px;">
      <h2 style="margin: 0;">The University of Memphis</h2>
    </div>
    <div style="display: flex; align-items: center;">
      <span style="font-weight: bold; margin-right: 15px;">PARKING AND TRANSPORTATION SERVICES</span>
      <button style="padding: 5px 10px; background-color: #eee; border: 1px solid #ccc;">Menu</button>
    </div>
  </div>

  <!-- Navigation Tabs -->
  <div class="nav-tabs">
    <a href="#" data-field="nav_link_1">{{ nav_link_1 }}</a>
    <a href="#" data-field="nav_link_2">{{ nav_link_2 }}</a>
    <a href="#" data-field="nav_link_3">{{ nav_link_3 }}</a>
    <a href="#" data-field="nav_link_4">{{ nav_link_4 }}</a>
    <a href="#" data-field="nav_link_5">{{ nav_link_5 }}</a>
  </div>

  <!-- Breadcrumb -->
  <div style="margin-bottom: 30px; font-size: 0.9em;">
    <span data-field="breadcrumb_home">{{ breadcrumb_home }}</span> &gt; <span data-field="breadcrumb_parking">{{ breadcrumb_parking }}</span> &gt; <span data-field="breadcrumb_current">{{ breadcrumb_current }}</span>
  </div>

  <!-- Page 1 Content: Guest Login -->
  <div class="content-section">
    <h1 style="font-size: 2em;">Don't wait in line. Go online!</h1>
    <p>Now taking care of parking is easier than ever. Our new online store, TigerPark, is up and running — giving you easy access to view or pay permits, submit online appeals and manage your parking account online.</p>

    <h2 style="margin-top: 40px;">Accessing TigerPark</h2>
    <p>Students, faculty/staff and employees of <span data-field="university_name">{{ university_name }}</span>. TigerPark through the <span data-field="portal_name">{{ portal_name }}</span>.</p>
    <p>Guests may login through the <span data-field="guest_login_link">{{ guest_login_link }}</span>.</p>
    <p><a href="#" data-field="pdf_link">{{ pdf_link }}</a></p>

    <div style="margin-top: 50px; display: flex; justify-content: space-between; font-size: 0.9em;">
      <a href="#" data-field="footer_link_1">{{ footer_link_1 }}</a> |
      <a href="#" data-field="footer_link_2">{{ footer_link_2 }}</a> |
      <a href="#" data-field="footer_link_3">{{ footer_link_3 }}</a> |
      <a href="#" data-field="footer_link_4">{{ footer_link_4 }}</a> |
      <a href="#" data-field="footer_link_5">{{ footer_link_5 }}</a> |
      <a href="#" data-field="footer_link_6">{{ footer_link_6 }}</a> |
      <a href="#" data-field="footer_link_7">{{ footer_link_7 }}</a> |
      <a href="#" data-field="footer_link_8">{{ footer_link_8 }}</a> |
      <a href="#" data-field="footer_link_9">{{ footer_link_9 }}</a>
    </div>
  </div>

  <!-- Guest Login Form -->
  <div class="content-section" style="border: 1px solid #ccc; padding: 30px; max-width: 500px; margin: 40px auto;">
    <h2 style="text-align: center;">Login with guest information or create an account if you are a new user.</h2>
    <div style="text-align: center; margin-bottom: 20px;">
      <p><strong>Guest Login</strong></p>
      <p>Enter your ID and Password. If you do not have an ID and password you may create one or you may retrieve your old information if you have lost it.</p>
    </div>
    <form>
      <div class="form-group">
        <label for="email">Email Address *</label>
        <input type="text" id="email" name="email" data-field="guest_email_input" value="{{ guest_email_input }}">
      </div>
      <div class="form-group">
        <label for="password">Password *</label>
        <input type="password" id="password" name="password" data-field="guest_password_input" value="{{ guest_password_input }}">
      </div>
      <div class="form-group">
        <label for="remember">Remember Me</label>
        <input type="checkbox" id="remember" name="remember">
      </div>
      <button type="submit" class="button" style="width: 100%;">Log In</button>
    </form>
  </div>
</div>

<div class="page">
  <!-- Page 2 Content: Get Permits -->
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #ccc; padding-bottom: 10px; margin-bottom: 20px;">
    <div style="display: flex; align-items: center;">
      <img src="placeholder_logo.png" alt="University Logo" style="height: 50px; margin-right: 15px;">
      <h2 style="margin: 0;">The University of Memphis</h2>
    </div>
    <div style="display: flex; align-items: center;">
      <span style="font-weight: bold; margin-right: 15px;">PARKING AND TRANSPORTATION SERVICES</span>
      <button style="padding: 5px 10px; background-color: #eee; border: 1px solid #ccc;">Menu</button>
    </div>
  </div>

  <!-- Navigation Tabs -->
  <div class="nav-tabs">
    <a href="#" data-field="nav_link_1">{{ nav_link_1 }}</a>
    <a href="#" data-field="nav_link_2">{{ nav_link_2 }}</a>
    <a href="#" data-field="nav_link_3">{{ nav_link_3 }}</a>
    <a href="#" data-field="nav_link_4">{{ nav_link_4 }}</a>
  </div>

  <!-- Breadcrumb -->
  <div style="margin-bottom: 30px; font-size: 0.9em;">
    <span data-field="breadcrumb_home">{{ breadcrumb_home }}</span> &gt; <span data-field="breadcrumb_parking">{{ breadcrumb_parking }}</span> &gt; <span data-field="breadcrumb_current">{{ breadcrumb_current }}</span>
  </div>

  <!-- Parking Portal Header -->
  <div style="text-align: center; margin-bottom: 30px;">
    <h1 style="font-size: 2em;">Parking Portal</h1>
    <p>Welcome! Use your Parking Portal to make purchases in the parking system and manage your parking account.</p>
    <p><strong>Location:</strong> <span data-field="location_address">{{ location_address }}</span></p>
  </div>

  <!-- Citations Section -->
  <div class="content-section">
    <h2 style="border-bottom: 1px solid #ccc; padding-bottom: 5px;">CITATIONS</h2>
    <div style="display: flex; gap: 20px;">
      <div style="flex: 1;">
        <p>View Your Citations</p>
        <button class="button" style="width: 100%;">View Citations</button>
      </div>
      <div style="flex: 1;">
        <p>View Your Appeals</p>
        <button class="button" style="width: 100%;">View Appeals</button>
      </div>
      <div style="flex: 1;">
        <p>View Your Letters</p>
        <button class="button" style="width: 100%;">View Letters</button>
      </div>
    </div>
  </div>

  <!-- Permits Section -->
  <div class="content-section">
    <h2 style="border-bottom: 1px solid #ccc; padding-bottom: 5px;">PERMITS</h2>
    <div style="display: flex; gap: 20px;">
      <div style="flex: 1;">
        <p>View Your Permits</p>
        <button class="button" style="width: 100%;">View Permits</button>
      </div>
      <div style="flex: 1;">
        <p>Add/Edit Vehicles</p>
        <button class="button" style="width: 100%;">Add/Edit Vehicles</button>
      </div>
    </div>
  </div>

  <!-- Click Next Section -->
  <div style="text-align: center; margin: 50px 0;">
    <h2 style="font-size: 1.5em;">Click Next</h2>
    <img src="placeholder_banner.png" alt="Banner" style="max-width: 100%; height: auto; margin-top: 20px;">
  </div>
</div>

<div class="page">
  <!-- Page 3 Content: Purchase Permit -->
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #ccc; padding-bottom: 10px; margin-bottom: 20px;">
    <div style="display: flex; align-items: center;">
      <img src="placeholder_logo.png" alt="University Logo" style="height: 50px; margin-right: 15px;">
      <h2 style="margin: 0;">The University of Memphis</h2>
    </div>
    <div style="display: flex; align-items: center;">
      <span style="font-weight: bold; margin-right: 15px;">PARKING AND TRANSPORTATION SERVICES</span>
      <button style="padding: 5px 10px; background-color: #eee; border: 1px solid #ccc;">Menu</button>
    </div>
  </div>

  <!-- Navigation Tabs -->
  <div class="nav-tabs">
    <a href="#" data-field="nav_link_1">{{ nav_link_1 }}</a>
    <a href="#" data-field="nav_link_2">{{ nav_link_2 }}</a>
    <a href="#" data-field="nav_link_3">{{ nav_link_3 }}</a>
    <a href="#" data-field="nav_link_4">{{ nav_link_4 }}</a>
  </div>

  <!-- Click Next Section -->
  <div style="text-align: center; margin: 50px 0;">
    <h2 style="font-size: 1.5em;">Click Next</h2>
    <img src="placeholder_banner.png" alt="Banner" style="max-width: 100%; height: auto; margin-top: 20px;">
  </div>

  <!-- Purchase Permit Section -->
  <div class="content-section">
    <h1 style="font-size: 2em;">Purchase a Permit</h1>
    <p>You have been authorized to purchase a permit. Please read the instructions on each page carefully!!</p>
    <p><strong>Parking & Transportation Services</strong></p>
    <p><strong>Location:</strong> <span data-field="location_address">{{ location_address }}</span></p>
    <button class="button" style="width: 200px; margin: 30px auto;">Next</button>
  </div>
</div>

<div class="page">
  <!-- Page 4 Content: Agreement -->
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #ccc; padding-bottom: 10px; margin-bottom: 20px;">
    <div style="display: flex; align-items: center;">
      <img src="placeholder_logo.png" alt="University Logo" style="height: 50px; margin-right: 15px;">
      <h2 style="margin: 0;">The University of Memphis</h2>
    </div>
    <div style="display: flex; align-items: center;">
      <span style="font-weight: bold; margin-right: 15px;">PARKING AND TRANSPORTATION SERVICES</span>
      <button style="padding: 5px 10px; background-color: #eee; border: 1px solid #ccc;">Menu</button>
    </div>
  </div>

  <!-- Navigation Tabs -->
  <div class="nav-tabs">
    <a href="#" data-field="nav_link_1">{{ nav_link_1 }}</a>
    <a href="#" data-field="nav_link_2">{{ nav_link_2 }}</a>
    <a href="#" data-field="nav_link_3">{{ nav_link_3 }}</a>
    <a href="#" data-field="nav_link_4">{{ nav_link_4 }}</a>
  </div>

  <!-- Agreement Section -->
  <div class="content-section" style="max-width: 800px; margin: 40px auto;">
    <h1 style="font-size: 2em; text-align: center;">**You must check all agreement boxes before proceeding to the next step**</h1>
    
    <h2 style="margin-top: 40px;">Select Permit and Permit Agreement</h2>
    <p>Students Only - General parking is included in your Parking Fees. If you require gated parking please select one from the available options below. Fall 2021 parking permit sales begin August 10th.</p>

    <div style="margin-top: 30px;">
      <table style="width: 100%;">
        <thead>
          <tr>
            <th style="width: 10%;">Select</th>
            <th style="width: 30%;">Permit</th>
            <th style="width: 30%;">Permit Description</th>
            <th style="width: 15%;">Permit Effective</th>
            <th style="width: 15%;">Permit Expires</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><input type="checkbox"></td>
            <td><span data-field="permit_type_1">{{ permit_type_1 }}</span></td>
            <td><span data-field="permit_desc_1">{{ permit_desc_1 }}</span></td>
            <td><span data-field="permit_eff_1">{{ permit_eff_1 }}</span></td>
            <td><span data-field="permit_exp_1">{{ permit_exp_1 }}</span></td>
          </tr>
        </tbody>
      </table>
    </div>

    <div style="margin-top: 40px; border: 1px solid #ccc; padding: 20px;">
      <p>I agree to follow the rules and regulations as outlined in the Parking Handbook.</p>
      <div style="margin-top: 15px;">
        <input type="checkbox" id="agree_1" data-field="agreement_check_1" value="{{ agreement_check_1 }}">
        <label for="agree_1">I agree to abide by parking rules and regulations.</label>
      </div>
      <div style="margin-top: 15px;">
        <input type="checkbox" id="agree_2" data-field="agreement_check_2" value="{{ agreement_check_2 }}">
        <label for="agree_2">I agree to pay all associated fees and fines.</label>
      </div>
      <div style="margin-top: 15px;">
        <input type="checkbox" id="agree_3" data-field="agreement_check_3" value="{{ agreement_check_3 }}">
        <label for="agree_3">I agree that my parking rights may be revoked at any time.</label>
      </div>
    </div>

    <div style="text-align: center; margin-top: 30px;">
      <button class="button" style="background-color: green;">Next</button>
    </div>
  </div>
</div>

<div class="page">
  <!-- Page 5 Content: Select Dates -->
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #ccc; padding-bottom: 10px; margin-bottom: 20px;">
    <div style="display: flex; align-items: center;">
      <img src="placeholder_logo.png" alt="University Logo" style="height: 50px; margin-right: 15px;">
      <h2 style="margin: 0;">The University of Memphis</h2>
    </div>
    <div style="display: flex; align-items: center;">
      <span style="font-weight: bold; margin-right: 15px;">PARKING AND TRANSPORTATION SERVICES</span>
      <button style="padding: 5px 10px; background-color: #eee; border: 1px solid #ccc;">Menu</button>
    </div>
  </div>

  <!-- Navigation Tabs -->
  <div class="nav-tabs">
    <a href="#" data-field="nav_link_1">{{ nav_link_1 }}</a>
    <a href="#" data-field="nav_link_2">{{ nav_link_2 }}</a>
    <a href="#" data-field="nav_link_3">{{ nav_link_3 }}</a>
    <a href="#" data-field="nav_link_4">{{ nav_link_4 }}</a>
  </div>

  <!-- Content Section -->
  <div class="content-section" style="max-width: 800px; margin: 40px auto;">
    <h1 style="font-size: 2em; text-align: center;">Select Date for Permit</h1>
    <p style="text-align: center; margin-bottom: 30px;">This permit is only authorized to park in General Parking Lots on campus for the dates that you select.</p>

    <!-- Effective Date Calendar -->
    <div style="margin-bottom: 40px; border: 1px solid #ccc; padding: 20px;">
      <h3 style="text-align: center;">Effective Date</h3>
      <div style="text-align: center; margin-bottom: 15px;">
        <button>&lt;</button>
        <span data-field="effective_month">{{ effective_month }}</span>
        <button>&gt;</button>
      </div>
      <table style="width: 100%; text-align: center;">
        <thead>
          <tr>
            <th>Sun</th><th>Mon</th><th>Tue</th><th>Wed</th><th>Thu</th><th>Fri</th><th>Sat</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>1</td><td>2</td><td>3</td><td>4</td><td>5</td><td>6</td><td>7</td>
          </tr>
          <tr>
            <td>8</td><td>9</td><td>10</td><td>11</td><td>12</td><td>13</td><td>14</td>
          </tr>
          <tr>
            <td>15</td><td>16</td><td>17</td><td>18</td><td>19</td><td>20</td><td>21</td>
          </tr>
          <tr>
            <td>22</td><td>23</td><td>24</td><td>25</td><td>26</td><td>27</td><td>28</td>
          </tr>
          <tr>
            <td>29</td><td>30</td><td>31</td><td>1</td><td>2</td><td>3</td><td>4</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Expiration Date Calendar -->
    <div style="border: 1px solid #ccc; padding: 20px;">
      <h3 style="text-align: center;">Expiration Date</h3>
      <div style="text-align: center; margin-bottom: 15px;">
        <button>&lt;</button>
        <span data-field="expiration_month">{{ expiration_month }}</span>
        <button>&gt;</button>
      </div>
      <table style="width: 100%; text-align: center;">
        <thead>
          <tr>
            <th>Sun</th><th>Mon</th><th>Tue</th><th>Wed</th><th>Thu</th><th>Fri</th><th>Sat</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>1</td><td>2</td><td>3</td><td>4</td><td>5</td><td>6</td><td>7</td>
          </tr>
          <tr>
            <td>8</td><td>9</td><td>10</td><td>11</td><td>12</td><td>13</td><td>14</td>
          </tr>
          <tr>
            <td>15</td><td>16</td><td>17</td><td>18</td><td>19</td><td>20</td><td>21</td>
          </tr>
          <tr>
            <td>22</td><td>23</td><td>24</td><td>25</td><td>26</td><td>27</td><td>28</td>
          </tr>
          <tr>
            <td>29</td><td>30</td><td>31</td><td>1</td><td>2</td><td>3</td><td>4</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div style="text-align: center; margin-top: 40px;">
      <button class="button" style="background-color: green;">Next</button>
    </div>
  </div>
</div>

<div class="page">
  <!-- Page 6 Content: Add Vehicle -->
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #ccc; padding-bottom: 10px; margin-bottom: 20px;">
    <div style="display: flex; align-items: center;">
      <img src="placeholder_logo.png" alt="University Logo" style="height: 50px; margin-right: 15px;">
      <h2 style="margin: 0;">The University of Memphis</h2>
    </div>
    <div style="display: flex; align-items: center;">
      <span style="font-weight: bold; margin-right: 15px;">PARKING AND TRANSPORTATION SERVICES</span>
      <button style="padding: 5px 10px; background-color: #eee; border: 1px solid #ccc;">Menu</button>
    </div>
  </div>

  <!-- Navigation Tabs -->
  <div class="nav-tabs">
    <a href="#" data-field="nav_link_1">{{ nav_link_1 }}</a>
    <a href="#" data-field="nav_link_2">{{ nav_link_2 }}</a>
    <a href="#" data-field="nav_link_3">{{ nav_link_3 }}</a>
    <a href="#" data-field="nav_link_4">{{ nav_link_4 }}</a>
  </div>

  <!-- Content Section -->
  <div class="content-section" style="max-width: 800px; margin: 40px auto;">
    <h1 style="font-size: 2em;">To add a vehicle, please click <span data-field="add_vehicle_link">{{ add_vehicle_link }}</span>.</h1>
    <p>Previously added vehicles will be displayed here. One vehicle's selection box must be checked before proceeding.</p>

    <div style="margin-top: 40px; border: 1px solid #ccc; padding: 20px;">
      <h2 style="margin-top: 0;">Select your Vehicles for Permit</h2>
      <p>Select the vehicles that are currently on your record that you want to use with your permit. If you need to add new vehicles, please click <span data-field="add_new_vehicle_link">{{ add_new_vehicle_link }}</span>.</p>
      
      <table style="width: 100%;">
        <thead>
          <tr>
            <th>Select</th>
            <th>State</th>
            <th>Plate Number</th>
            <th>Year</th>
            <th>Make</th>
            <th>Model</th>
            <th>Color</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><input type="checkbox"></td>
            <td><span data-field="vehicle_state_1">{{ vehicle_state_1 }}</span></td>
            <td><span data-field="vehicle_plate_1">{{ vehicle_plate_1 }}</span></td>
            <td><span data-field="vehicle_year_1">{{ vehicle_year_1 }}</span></td>
            <td><span data-field="vehicle_make_1">{{ vehicle_make_1 }}</span></td>
            <td><span data-field="vehicle_model_1">{{ vehicle_model_1 }}</span></td>
            <td><span data-field="vehicle_color_1">{{ vehicle_color_1 }}</span></td>
          </tr>
          <!-- Loop for multiple vehicles -->
          {% for vehicle in vehicle_list %}
          <tr>
            <td><input type="checkbox"></td>
            <td><span data-field="vehicle_state_{{ loop.index0 + 1 }}">{{ vehicle.state }}</span></td>
            <td><span data-field="vehicle_plate_{{ loop.index0 + 1 }}">{{ vehicle.plate_number }}</span></td>
            <td><span data-field="vehicle_year_{{ loop.index0 + 1 }}">{{ vehicle.year }}</span></td>
            <td><span data-field="vehicle_make_{{ loop.index0 + 1 }}">{{ vehicle.make }}</span></td>
            <td><span data-field="vehicle_model_{{ loop.index0 + 1 }}">{{ vehicle.model }}</span></td>
            <td><span data-field="vehicle_color_{{ loop.index0 + 1 }}">{{ vehicle.color }}</span></td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      <div style="text-align: right; margin-top: 20px;">
        <button class="button" style="background-color: #007bff;">Next</button>
      </div>
    </div>
  </div>
</div>

<div class="page">
  <!-- Page 7 Content: View Cart -->
  <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #ccc; padding-bottom: 10px; margin-bottom: 20px;">
    <div style="display: flex; align-items: center;">
      <img src="placeholder_logo.png" alt="University Logo" style="height: 50px; margin-right: 15px;">
      <h2 style="margin: 0;">The University of Memphis</h2>
    </div>
    <div style="display: flex; align-items: center;">
      <span style="font-weight: bold; margin-right: 15px;">PARKING AND TRANSPORTATION SERVICES</span>
      <button style="padding: 5px 10px; background-color: #eee; border: 1px solid #ccc;">Menu</button>
    </div>
  </div>

  <!-- Navigation Tabs -->
  <div class="nav-tabs">
    <a href="#" data-field="nav_link_1">{{ nav_link_1 }}</a>
