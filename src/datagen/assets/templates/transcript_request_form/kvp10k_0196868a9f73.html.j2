<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<style>
  @page { size: A4; margin: 0; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: "Liberation Sans", Arial, Helvetica, sans-serif; font-size: 11px; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }

  .header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 6px;
  }
  .header-left { flex: 1; }
  .header-right {
    text-align: right;
    font-size: 10px;
    line-height: 1.5;
    min-width: 160px;
  }
  h1 {
    font-family: "Liberation Sans", Arial, Helvetica, sans-serif;
    font-size: 15px;
    font-weight: bold;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
  }
  .instructions {
    font-size: 10px;
    line-height: 1.5;
    margin-bottom: 6px;
  }
  .instructions strong { font-weight: bold; }
  .instructions u { text-decoration: underline; }
  .important-section {
    font-size: 10px;
    margin-bottom: 4px;
    line-height: 1.6;
  }
  .important-section strong { font-weight: bold; }
  .bullet-row {
    display: flex;
    gap: 20px;
    margin-bottom: 2px;
  }
  .bullet-col { flex: 1; }

  hr.divider {
    border: none;
    border-top: 1px solid #000;
    margin: 6px 0;
  }
  hr.thick-divider {
    border: none;
    border-top: 2px solid #000;
    margin: 6px 0;
  }

  .fields-row {
    display: flex;
    gap: 10px;
    margin-bottom: 2px;
    align-items: flex-end;
  }
  .field-group {
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .field-group.narrow { flex: 0.4; }
  .field-group.wide { flex: 1.5; }
  .field-label {
    font-size: 9px;
    color: #333;
    margin-top: 2px;
  }
  .field-value {
    border-bottom: 1px solid #000;
    min-height: 18px;
    font-size: 11px;
    padding-bottom: 1px;
  }

  .bold-label {
    font-weight: bold;
    font-size: 11px;
  }

  .ferpa-text {
    font-size: 9.5px;
    line-height: 1.5;
    margin: 6px 0;
  }
  .ferpa-text strong { font-weight: bold; }
  .ferpa-text em { font-style: italic; }

  .signature-row {
    display: flex;
    gap: 30px;
    align-items: flex-end;
    margin: 4px 0 6px 0;
  }
  .sig-field {
    flex: 2;
    border-bottom: 1px solid #000;
    min-height: 20px;
  }
  .sig-date {
    flex: 1;
    border-bottom: 1px solid #000;
    min-height: 20px;
  }
  .sig-label {
    font-size: 12px;
    font-weight: bold;
    margin-bottom: 2px;
  }
  .sig-sublabel {
    font-size: 10px;
    font-style: italic;
    font-weight: bold;
  }
  .date-label {
    font-size: 12px;
    font-weight: bold;
    margin-bottom: 2px;
  }

  .service-section { margin-bottom: 6px; }
  .service-title {
    font-size: 10px;
    font-weight: bold;
    margin-bottom: 4px;
  }
  .service-option {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    margin-bottom: 4px;
    font-size: 10px;
    line-height: 1.4;
  }
  .checkbox {
    width: 12px;
    height: 12px;
    border: 1px solid #000;
    display: inline-block;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .calculate-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: bold;
    margin: 6px 0;
  }
  .calc-field {
    border-bottom: 1px solid #000;
    min-width: 50px;
    display: inline-block;
  }
  .calc-label { font-weight: bold; }
  .calc-normal { font-weight: normal; font-size: 10px; }

  .payment-section {
    font-size: 10px;
    margin-bottom: 6px;
  }
  .payment-section strong { font-weight: bold; }

  .credit-row {
    display: flex;
    gap: 10px;
    align-items: flex-end;
    border-top: 1px solid #000;
    border-bottom: 1px solid #000;
    padding: 4px 0;
    margin-bottom: 6px;
  }
  .credit-group {
    display: flex;
    flex-direction: column;
    flex: 2;
  }
  .credit-group.medium { flex: 1; }
  .credit-group.small { flex: 0.8; }
  .credit-label {
    font-weight: bold;
    font-size: 11px;
    margin-bottom: 2px;
  }
  .credit-value {
    border-bottom: 1px solid #000;
    min-height: 16px;
    font-size: 11px;
  }

  .options-current {
    font-size: 10px;
    font-weight: bold;
    margin-bottom: 4px;
  }
  .options-current span { font-weight: normal; }
  .options-checkboxes {
    display: flex;
    gap: 20px;
    align-items: center;
    margin-bottom: 6px;
    font-size: 10px;
  }

  .bottom-section {
    display: flex;
    gap: 10px;
    margin-top: 4px;
  }
  .send-to-left {
    flex: 1.8;
    font-size: 9.5px;
    line-height: 1.5;
  }
  .send-to-left strong { font-weight: bold; }
  .send-lines {
    margin-top: 10px;
  }
  .send-line {
    border-bottom: 1px solid #000;
    min-height: 20px;
    margin-bottom: 12px;
    width: 85%;
  }

  .do-not-write {
    flex: 1.2;
    border: 1px dotted #aaa;
    background: repeating-linear-gradient(
      45deg,
      #f5f5f5,
      #f5f5f5 4px,
      #e8e8e8 4px,
      #e8e8e8 8px
    );
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: bold;
    text-align: center;
    color: #555;
    min-height: 120px;
  }

  .office-use {
    flex: 0.9;
    border: 1px solid #000;
    padding: 8px;
    font-size: 10px;
    line-height: 1.8;
  }
  .office-use-title {
    font-weight: bold;
    font-size: 11px;
    margin-bottom: 6px;
  }
  .office-row {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 4px;
  }
  .office-checkbox {
    width: 11px;
    height: 11px;
    border: 1px solid #000;
    display: inline-block;
  }
  .office-line {
    border-bottom: 1px solid #000;
    min-width: 50px;
    display: inline-block;
  }

  .revised-note {
    position: absolute;
    bottom: 20px;
    left: 60px;
    font-size: 9px;
    color: #555;
  }
</style>
</head>
<body>
<div class="page">

  <!-- Header -->
  <div class="header-row">
    <div class="header-left">
      <h1>UW OSHKOSH OFFICIAL TRANSCRIPT REQUEST FORM</h1>
      <div class="instructions">
        <strong>Instructions:</strong> Legibly complete the entire form and submit by mail or in person. <strong>We <u>do not</u> accept emailed or faxed requests</strong>. <strong>Payment</strong> is<br>
        required at time of request. Transcripts may also be ordered online via Titan Web or at <span data-field="online_order_url">{{ online_order_url }}</span>
      </div>
    </div>
    <div class="header-right">
      Records Office<br>
      <span data-field="office_address_line1">{{ office_address_line1 }}</span><br>
      <span data-field="office_address_line2">{{ office_address_line2 }}</span><br>
      <span data-field="office_phone">{{ office_phone }}</span>
    </div>
  </div>

  <!-- Important bullets -->
  <div class="important-section">
    <strong>IMPORTANT:</strong>
    <div class="bullet-row">
      <div class="bullet-col">&#8226; Outstanding debt to the University prevents the release of transcripts</div>
      <div class="bullet-col">&#8226; Faxed transcripts are <strong>not</strong> official</div>
    </div>
    <div class="bullet-row">
      <div class="bullet-col">&#8226; Transcripts released to student are stamped "Issued to Student"</div>
      <div class="bullet-col">&#8226; Name changes require documentation (i.e. driver's license, state-issued ID card or legal document; legible photocopy is acceptable)</div>
    </div>
  </div>

  <hr class="divider">

  <!-- Name / Phone row -->
  <div class="fields-row">
    <div class="field-group wide">
      <div class="field-value"><span data-field="last_name">{{ last_name }}</span></div>
      <div class="field-label">Last Name</div>
    </div>
    <div class="field-group wide">
      <div class="field-value"><span data-field="first_name">{{ first_name }}</span></div>
      <div class="field-label">First Name</div>
    </div>
    <div class="field-group narrow">
      <div class="field-value"><span data-field="middle_initial">{{ middle_initial }}</span></div>
      <div class="field-label">MI</div>
    </div>
    <div class="field-group wide">
      <div class="field-value"><span data-field="former_names">{{ former_names }}</span></div>
      <div class="field-label">Former Name(s)</div>
    </div>
    <div class="field-group wide">
      <div class="field-value"><span data-field="phone_number">{{ phone_number }}</span></div>
      <div class="field-label">10-Digit Phone Number</div>
    </div>
  </div>

  <div style="margin-top:8px;"></div>

  <!-- Address row -->
  <div class="fields-row">
    <div class="field-group" style="flex:2;">
      <div class="field-value"><span data-field="street_address">{{ street_address }}</span></div>
      <div class="field-label">Current Street Address</div>
    </div>
    <div class="field-group">
      <div class="field-value"><span data-field="city">{{ city }}</span></div>
      <div class="field-label">City</div>
    </div>
    <div class="field-group narrow">
      <div class="field-value"><span data-field="state">{{ state }}</span></div>
      <div class="field-label">State</div>
    </div>
    <div class="field-group narrow">
      <div class="field-value"><span data-field="zip">{{ zip }}</span></div>
      <div class="field-label">Zip</div>
    </div>
    <div class="field-group wide">
      <div class="field-value"><span data-field="email_address">{{ email_address }}</span></div>
      <div class="field-label">Email address</div>
    </div>
  </div>

  <hr class="divider">

  <!-- Student ID / DOB / Attendance row -->
  <div class="fields-row" style="align-items:flex-end;">
    <div class="field-group" style="flex:2.5;">
      <div class="field-value"><span data-field="student_id_or_ssn">{{ student_id_or_ssn }}</span></div>
      <div class="field-label"><strong>Student ID Number OR SSN (required for use in locating your academic record)</strong></div>
    </div>
    <div class="field-group">
      <div class="field-value"><span data-field="date_of_birth">{{ date_of_birth }}</span></div>
      <div class="field-label">Date of Birth</div>
    </div>
    <div class="field-group wide">
      <div class="field-value"><span data-field="attendance_dates">{{ attendance_dates }}</span></div>
      <div class="field-label">Approx. Attendance Dates</div>
    </div>
  </div>

  <!-- FERPA text -->
  <div class="ferpa-text">
    <strong>AS A PERSON REQUESTING TRANSCRIPT(S), YOU ARE RESPONSIBLE FOR PROVIDING ACCURATE INFORMATION.</strong> Federal law (FERPA) requires that the student's signature accompany any request for the student's transcript. <em>I attest that I am the person whose grades are reflected on the transcript requested, that the information provided on the request is accurate, and that all name changes have been legally documented.</em>
  </div>

  <!-- Signature row -->
  <div class="signature-row">
    <div style="flex:2;">
      <div class="sig-label">Student Signature <span class="sig-sublabel">(typed signature NOT acceptable)</span></div>
      <div class="sig-field"><span data-field="student_signature">{{ student_signature }}</span></div>
    </div>
    <div style="flex:1;">
      <div class="date-label">Date</div>
      <div class="sig-date"><span data-field="signature_date">{{ signature_date }}</span></div>
    </div>
  </div>

  <hr class="thick-divider">

  <!-- Service Options -->
  <div class="service-section">
    <div class="service-title">
      SERVICE OPTIONS AND FEES (Select 1 of the options below. <strong>Prices are subject to change; current fees are listed on our website, <u>www.uwosh.edu/registrar/transcripts</u></strong>)
    </div>
    <div class="service-option">
      <span class="checkbox"></span>
      <span><strong>Standard Service:</strong> $10 per transcript – Processed within 2 business days of receipt; transcript mailed 1<sup>st</sup> class USPS mail or available for pick up within 2 business days.</span>
    </div>
    <div class="service-option">
      <span class="checkbox"></span>
      <span><strong>Expedited Service:</strong> $10 per transcript + $20 per recipient delivery fee – Processed within 1 business day of receipt; transcript sent via UPS Next Day (excluding Saturdays &amp; holidays).</span>
    </div>
    <div class="service-option">
      <span class="checkbox"></span>
      <span><strong>In-Person Immediate Service:</strong> $12 per transcript – Transcript printed while you wait.</span>
    </div>
  </div>

  <!-- Calculate Cost -->
  <div class="calculate-row">
    <span class="calc-label">CALCULATE COST</span>
    <span class="calc-normal">Number of transcripts</span>
    <span class="calc-field"><span data-field="num_transcripts">{{ num_transcripts }}</span></span>
    <span style="font-size:14px; font-weight:bold;">X</span>
    <span class="calc-normal">Transcript fee</span>
    <span style="font-size:12px;">$</span>
    <span class="calc-field"><span data-field="transcript_fee">{{ transcript_fee }}</span></span>
    <span style="font-size:14px; font-weight:bold;">+</span>
    <span class="calc-normal" style="text-align:center;">Expedited<br>Delivery Fee<br>(if applicable)</span>
    <span style="font-size:12px;">$</span>
    <span class="calc-field"><span data-field="delivery_fee">{{ delivery_fee }}</span></span>
    <span style="font-size:14px; font-weight:bold;">=</span>
    <span style="font-size:12px;">$</span>
    <span class="calc-field" style="min-width:70px;"><span data-field="total_cost">{{ total_cost }}</span></span>
  </div>

  <!-- Payment Options -->
  <div class="payment-section">
    <strong>PAYMENT OPTIONS</strong> (Payment must accompany request)<br>
    We accept: Cash, Check (payable to UW Oshkosh), Money Order, Cashier's Check, Visa, MasterCard, and American Express
  </div>

  <!-- Credit Card row -->
  <div class="credit-row">
    <div class="credit-group">
      <div class="credit-label">Credit Card Number</div>
      <div class="credit-value"><span data-field="credit_card_number">{{ credit_card_number }}</span></div>
    </div>
    <div class="credit-group medium">
      <div class="credit-label">Expiration Date</div>
      <div class="credit-value"><span data-field="expiration_date">{{ expiration_date }}</span></div>
    </div>
    <div class="credit-group small">
      <div class="credit-label">3-Digit CVV</div>
      <div class="credit-value"><span data-field="cvv">{{ cvv }}</span></div>
    </div>
  </div>

  <!-- Options for Current Students -->
  <div class="options-current">
    OPTIONS FOR CURRENT STUDENTS ONLY <span>- If not applicable, do not check either box.</span>
  </div>
  <div class="options-checkboxes">
    <span class="checkbox"></span>
    <span>Hold for current semester grades</span>
    <span style="margin-left:40px;"></span>
    <span class="checkbox"></span>
    <span>Hold for Degree (posting of degree may take up to 6 weeks after official graduation date)</span>
  </div>

  <hr class="divider">

  <!-- Bottom section -->
  <div class="bottom-section">
    <div class="send-to-left">
      <strong>SEND TRANSCRIPT(S) TO</strong> (If needed, use back of form or separate sheet)<br>
      <strong>You are responsible for providing complete &amp; accurate address.</strong> If you chose <strong>Expedited Delivery (UPS)</strong>, a physical street address is required; UPS will not deliver to a P.O Box. If you choose to have transcript faxed rather than mailed, enter recipient name <strong>and</strong> fax number. If left blank, transcript will be mailed to you at the address you provided above.
      <div class="send-lines">
        {% for entry in send_to_entries %}
        <div class="send-line"><span data-field="send_to_entries[{{ loop.index0 }}].address_line">{{ entry.address_line }}</span></div>
        {% endfor %}
      </div>
    </div>

    <div class="do-not-write">
      DO NOT WRITE IN THIS SPACE
    </div>

    <div class="office-use">
      <div class="office-use-title">OFFICE USE ONLY</div>
      <div class="office-row">
        PS <span class="office-checkbox"></span>
        &nbsp;&nbsp; Vault <span class="office-checkbox"></span>
      </div>
      <div class="office-row">
        Stops &nbsp;&nbsp; Yes <span class="office-line" data-field="nbsp_nbsp_vault">{{ nbsp_nbsp_vault }}</span> &nbsp; No
      </div>
      <div class="office-row">
        Address Change &nbsp; Yes &nbsp;&nbsp; No
      </div>
      <div class="office-row">
        Name Change &nbsp; Yes &nbsp;&nbsp; No
      </div>
      <div class="office-row">
        JJ &nbsp;&nbsp; DS &nbsp;&nbsp; Other <span class="office-line" data-field="nbsp_no">{{ nbsp_no }}</span>
      </div>
      <div class="office-row" style="margin-top:6px;">
        Tracking # <span class="office-line" style="min-width:80px;" data-field="field_1">{{ field_1 }}</span>
      </div>
    </div>
  </div>

  <div class="revised-note">Revised <span data-field="revised_date">{{ revised_date }}</span></div>

</div>
</body>
</html>