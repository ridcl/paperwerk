        <label>Select Biller</label>
        <button class="button primary-button" style="width: 100%;">Select Biller</button>
      </div>

      <div class="section-title" style="margin-top: 30px;">Biller List</div>
      <div class="form-group">
        <label>Search</label>
        <input type="text" placeholder="Search billers...">
      </div>

      <table class="table-container">
        <thead>
          <tr>
            <th>Biller Name</th>
            <th>Details</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><span data-field="biller_list[0].name">{{ biller_list[0].name }}</span></td>
            <td><span data-field="biller_list[0].details">{{ biller_list[0].details }}</span></td>
