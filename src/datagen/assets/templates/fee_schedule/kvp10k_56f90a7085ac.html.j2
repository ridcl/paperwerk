        <input type="text" value="<span data-field="student_name_payment">{{ student_name_payment }}</span>">
      </div>
      <div class="form-group">
        <label>OP Code</label>
        <input type="text" value="<span data-field="op_code_payment">{{ op_code_payment }}</span>">
      </div>
      <div class="form-group">
        <label>Contact Number</label>
        <input type="text" value="<span data-field="contact_number_payment">{{ contact_number_payment }}</span>">
      </div>
    </div>

    <div style="flex: 1;">
      <div class="section-title">Pay From Which Account?</div>
      <div class="form-group">
        <label>Select Account</label>
        <select>
          <option value="1"><span data-field="account_1_name">{{ account_1_name }}</span></option>
          <option value="2"><span data-field="account_2_name">{{ account_2_name }}</span></option>
        </select>
      </div>
      <div class="form-group">
        <label>Account Number</label>
        <input type="text" value="<span data-field="account_number_selected">{{ account_number_selected }}</span>">
      </div>
    </div>
  </div>
</div>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
    <div class="section-title">Payment Details</div>
    <button class="secondary-button">NEXT</button>
  </div>

  <div style="display: flex; gap: 30px;">
    <div style="flex: 1;">
      <div class="form-group">
        <label>Biller</label>
        <input type="text" value="<span data-field="biller_name_review">{{ biller_name_review }}</span>">
      </div>
      <div class="form-group">
        <label>Date</label>
        <input type="text" value="<span data-field="payment_date_review">{{ payment_date_review }}</span>">
      </div>
      <div class="form-group">
        <label>Amount</label>
        <input type="text" value="<span data-field="payment_amount_review">{{ payment_amount_review }}</span>">
      </div>
      <div class="form-group">
        <label>Repeat</label>
        <input type="checkbox" checked>
      </div>
      <div class="form-group">
        <label>Frequency</label>
        <select>
          <option value="Monthly">Monthly</option>
        </select>
      </div>
      <div class="form-group">
        <label>End Date</label>
        <input type="text" value="<span data-field="end_date_review">{{ end_date_review }}</span>">
      </div>
      <button class="button primary-button" style="width: 100%; margin-top: 20px;">PAY PHP 100.00</button>
    </div>

    <div style="flex: 1;">
      <div class="section-title">Review and Pay</div>
      <div class="form-group">
        <label>From Account</label>
        <input type="text" value="<span data-field="from_account_review">{{ from_account_review }}</span>">
      </div>
      <div class="form-group">
        <label>To Biller</label>
        <input type="text" value="<span data-field="to_biller_review">{{ to_biller_review }}</span>">
      </div>
      <div class="form-group">
        <label>Amount</label>
        <input type="text" value="<span data-field="amount_review">{{ amount_review }}</span>">
      </div>
      <button class="button primary-button" style="width: 100%; margin-top: 20px;">PAY PHP 100.00</button>
    </div>
  </div>
</div>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
    <div class="section-title">With Scheduled Payments</div>
    <div class="section-title">One-Time Payment</div>
  </div>

  <div style="display: flex; gap: 30px;">
    <div style="flex: 1;">
      <div class="section-title">Review and Pay</div>
      <div class="form-group">
        <label>From Account</label>
        <input type="text" value="<span data-field="from_account_otp">{{ from_account_otp }}</span>">
      </div>
      <div class="form-group">
        <label>To Biller</label>
        <input type="text" value="<span data-field="to_biller_otp">{{ to_biller_otp }}</span>">
      </div>
      <div class="form-group">
        <label>Amount</label>
        <input type="text" value="<span data-field="amount_otp">{{ amount_otp }}</span>">
      </div>
      <button class="button primary-button" style="width: 100%; margin-top: 20px;">PAY PHP 100.00</button>
    </div>

    <div style="flex: 1;">
      <div class="section-title">Transaction Receipt and SMS Notification</div>
      <div style="text-align: center; margin-top: 50px;">
        <div style="border: 1px solid #ccc; padding: 20px; width: 80%;">
          <p><strong>UnionBank</strong></p>
          <p>You paid <span data-field="transaction_amount">{{ transaction_amount }}</span> to <span data-field="transaction_biller">{{ transaction_biller }}</span></p>
          <p>Reference No.: <span data-field="transaction_reference_no">{{ transaction_reference_no }}</span></p>
          <p>Date: <span data-field="transaction_date">{{ transaction_date }}</span></p>
          <div style="margin-top: 20px;">
            <button class="button secondary-button">Share</button>
            <button class="button secondary-button">NEW PAYMENT</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="page">
