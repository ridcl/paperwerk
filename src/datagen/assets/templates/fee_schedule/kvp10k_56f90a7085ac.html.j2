<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
    <div class="section-title">Payment Details</div>
    <button class="secondary-button">NEXT</button>
  </div>

  <div style="display: flex; gap: 30px;">
    <div style="flex: 1;">
      <div class="section-title">Biller Information</div>
      <div class="form-group">
        <label>Biller Name</label>
        <input type="text" value="<span data-field="biller_name_payment">{{ biller_name_payment }}</span>">
      </div>
      <div class="form-group">
        <label>Student ID</label>
        <input type="text" value="<span data-field="student_id_payment">{{ student_id_payment }}</span>">
      </div>
      <div class="form-group">
