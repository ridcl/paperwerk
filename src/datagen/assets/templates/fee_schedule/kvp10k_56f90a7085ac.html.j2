            <th>Date</th>
            <th>Amount</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><span data-field="recent_payments[0].biller_name">{{ recent_payments[0].biller_name }}</span></td>
            <td><span data-field="recent_payments[0].date">{{ recent_payments[0].date }}</span></td>
            <td><span data-field="recent_payments[0].amount">{{ recent_payments[0].amount }}</span></td>
