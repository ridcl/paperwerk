        <label>Select Biller</label>
        <button class="button primary-button" style="width: 100%;">Select Biller</button>
      </div>
      <div class="form-group">
        <label>Scan To Pay</label>
        <button class="button secondary-button" style="width: 100%;">Scan To Pay</button>
      </div>

      <div class="section-title" style="margin-top: 30px;">Recent Payments</div>
