<!DOCTYPE html>
<html>
<head>
<title>Synthetic Document</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, Helvetica, Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { font-weight: bold; }
  .header-section { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
  .logo { font-weight: bold; font-size: 24px; }
  .title { font-size: 36px; font-weight: bold; }
  .section-title { font-size: 20px; font-weight: bold; margin-bottom: 20px; border-bottom: 1px solid #ccc; padding-bottom: 5px; }
  .form-group { margin-bottom: 15px; }
  .form-group label { display: block; margin-bottom: 5px; font-weight: normal; }
  .form-group input, .form-group select { width: 100%; padding: 10px; border: 1px solid #ccc; box-sizing: border-box; }
  .button { padding: 10px 20px; border: none; border-radius: 5px; cursor: pointer; font-weight: bold; }
  .primary-button { background-color: #007bff; color: white; }
  .secondary-button { background-color: #f0f0f0; color: #333; }
  .table-container { width: 100%; border-collapse: collapse; margin-top: 20px; }
  .table-container th, .table-container td { border: 1px solid #ddd; padding: 12px; text-align: left; }
  .table-container th { background-color: #f2f2f2; font-weight: bold; }
  .flex-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; }
  .flex-item { flex: 1; }
</style>
</head>
<body>
<div class="page">
  <div style="text-align: center; margin-top: 100px;">
    <div class="title">Bills Payment</div>
    <div class="logo" style="margin-top: 10px;">UnionBank</div>
  </div>
</div>

<div class="page">
  <div class="header-section">
    <div class="logo">Pay Bills</div>
    <div style="display: flex; gap: 10px;">
      <button class="secondary-button">My Billers</button>
      <button class="secondary-button">Favorites</button>
      <button class="secondary-button">Biller List</button>
    </div>
  </div>

  <div style="display: flex; gap: 40px;">
    <div style="flex: 1;">
      <div class="section-title">Select Biller</div>
