<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; }
  h1, h2, h3 { font-weight: bold; }
  .section-header { margin-top: 20px; margin-bottom: 10px; }
  .form-row { display: flex; margin-bottom: 10px; }
  .form-row > div { flex: 1; }
  .signature-line { border-bottom: 1px solid #000; margin-top: 50px; }
</style>

<div class="page">
  <header style="text-align: center; margin-bottom: 30px;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
      <div style="font-size: 24px; font-weight: bold;">[Logo Placeholder]</div>
      <div style="text-align: right;">
        <h1 style="font-size: 18px; margin: 0;">For International Students Transferring From Another U.S. Institution To American University</h1>
      </div>
    </div>
  </header>

  <div class="section-header">
    <h2 style="font-size: 14px; margin: 0;">INSTRUCTIONS FOR STUDENTS</h2>
    <p style="font-size: 12px; margin: 5px 0 0 0;">PLEASE COMPLETE THE FOLLOWING STEPS TO OBTAIN YOUR TRANSFER I-20</p>
  </div>

  <ol style="font-size: 12px; line-height: 1.5;">
    <li>
      <span style="font-weight: bold;">Step 1:</span> Submit a completed Certification of Finances for International Students (CFIS) Form along with liquidable financial proof in English. Financial proof must be dated within the last three months to demonstrate your ability to cover at least one year of academic and living expenses at American University. Please fax or email these documents to your Admissions' contact account at <span data-field="admissions_contact_email">{{ admissions_contact_email }}</span>.
    </li>
    <li>
      <span style="font-weight: bold;">Step 2:</span> For CFIS form, visit <span data-field="cfis_url">{{ cfis_url }}</span>.
    </li>
    <li>
      <span style="font-weight: bold;">Step 3:</span> Complete SECTION I of this form below, sign and take it to the International Student and Scholar Services (ISSS) office at American University by fax at <span data-field="iss_fax_number">{{ iss_fax_number }}</span> or email at <span data-field="iss_email">{{ iss_email }}</span> after your admission to AU has been confirmed.
    </li>
  </ol>

  <div class="section-header" style="margin-top: 30px;">
    <h3 style="font-size: 12px; margin: 0;">SECTION I TO BE COMPLETED BY STUDENT</h3>
  </div>

  <div class="form-row" style="margin-bottom: 15px;">
    <div style="flex: 2;">Name (Mr./Ms): <span data-field="full_name">{{ full_name }}</span></div>
    <div style="flex: 1;">Last: <span data-field="last_name">{{ last_name }}</span></div>
    <div style="flex: 1;">First: <span data-field="first_name">{{ first_name }}</span></div>
    <div style="flex: 1;">Middle: <span data-field="middle_name">{{ middle_name }}</span></div>
  </div>

  <div class="form-row" style="margin-bottom: 15px;">
    <div style="flex: 1;">COUNTRY OF CITIZENSHIP: <span data-field="country_of_citizenship">{{ country_of_citizenship }}</span></div>
    <div style="flex: 1;">DOB: <span data-field="date_of_birth">{{ date_of_birth }}</span></div>
    <div style="flex: 1;">AU ID #: <span data-field="au_id">{{ au_id }}</span></div>
  </div>

  <div class="form-row" style="margin-bottom: 15px;">
    <div style="flex: 1;">TELEPHONE: <span data-field="phone_number">{{ phone_number }}</span></div>
    <div style="flex: 1;">EMAIL: <span data-field="email_address">{{ email_address }}</span></div>
    <div style="flex: 1;">PROGRAM:
      <span style="margin-left: 10px;">
        <input type="checkbox" data-field="program_cas" value="{{ program_cas }}"> CAS
        <input type="checkbox" data-field="program_kogod" value="{{ program_kogod }}"> KOGOD
        <input type="checkbox" data-field="program_sis" value="{{ program_sis }}"> SIS
        <input type="checkbox" data-field="program_soc" value="{{ program_soc }}"> SOC
        <input type="checkbox" data-field="program_spa" value="{{ program_spa }}"> SPA
        <input type="checkbox" data-field="program_wcl" value="{{ program_wcl }}"> WCL
      </span>
    </div>
  </div>

  <div class="form-row" style="margin-bottom: 20px;">
    <div style="flex: 1;">U.S. ADDRESS (REQUIRED): <span data-field="us_address">{{ us_address }}</span></div>
    <div style="flex: 1;">STATE: <span data-field="state">{{ state }}</span></div>
    <div style="flex: 1;">ZIPCODE: <span data-field="zipcode">{{ zipcode }}</span></div>
    <div style="flex: 1;">COUNTRY: USA</div>
  </div>

  <div class="section-header" style="margin-top: 30px;">
    <h3 style="font-size: 12px; margin: 0;">ADDRESS TO MAIL YOUR I-20 (PLACE AN "X" IN THE APPROPRIATE BOX):</h3>
  </div>

  <div style="margin-top: 10px;">
    <div style="margin-bottom: 5px;">
      <input type="checkbox" data-field="mail_permanent" value="{{ mail_permanent }}"> PERMANENT MAILING ADDRESS
    </div>
    <div style="margin-bottom: 5px;">
      <input type="checkbox" data-field="mail_us_address" value="{{ mail_us_address }}"> U.S. MAILING ADDRESS
    </div>
    <div style="margin-bottom: 5px;">
      <input type="checkbox" data-field="mail_student_pickup" value="{{ mail_student_pickup }}"> STUDENT PICK-UP
    </div>
    <div style="margin-bottom: 5px;">
      <input type="checkbox" data-field="mail_other" value="{{ mail_other }}"> OTHER
    </div>
  </div>

  <div class="form-row" style="margin-top: 30px;">
    <div style="flex: 1;">SIGNATURE: 
      <div class="signature-line" style="width: 100%;" data-field="other">{{ other }}</div>
    </div>
    <div style="flex: 1;">DATE: <span data-field="signature_date">{{ signature_date }}</span></div>
  </div>

  <div class="section-header" style="margin-top: 40px;">
    <h3 style="font-size: 12px; margin: 0;">SECTION II TO BE COMPLETED BY AN INTERNATIONAL STUDENT ADVISOR AT YOUR CURRENT SCHOOL</h3>
  </div>

  <p style="font-size: 12px; margin-bottom: 20px;">Please indicate the date of when you plan to transfer the student's SEVIS immigration record to American University:</p>

  <div class="form-row" style="margin-bottom: 20px;">
    <div style="flex: 1;">SEVIS RELEASE DATE (REQUIRED)*: <span data-field="sevis_release_date">{{ sevis_release_date }}</span></div>
    <div style="flex: 1;">NOTE: To transfer an immigration record to AU in SEVIS, please look under "I" for <span data-field="american_university_sevis_code">{{ american_university_sevis_code }}</span>. School Code is: <span data-field="school_code">{{ school_code }}</span>.</div>
  </div>

  <div class="section-header" style="margin-top: 30px;">
    <h3 style="font-size: 12px; margin: 0;">DECLARATIONS</h3>
  </div>

  <div style="font-size: 12px; margin-bottom: 10px;">
    <p>HAS THE STUDENT ACCEPTED IN ACCORDANCE WITH THE USCIS REGULATIONS?</p>
    <div style="margin-left: 20px;">
      <input type="checkbox" data-field="declaration_accepted_yes" value="{{ declaration_accepted_yes }}"> YES
      <input type="checkbox" data-field="declaration_accepted_no" value="{{ declaration_accepted_no }}"> NO. Please explain: <span data-field="declaration_explanation">{{ declaration_explanation }}</span>
    </div>
  </div>

  <div style="font-size: 12px; margin-bottom: 10px;">
    <p>HAS THE STUDENT MET HIS/HER FINANCIAL OBLIGATIONS TO YOUR INSTITUTION?</p>
    <div style="margin-left: 20px;">
      <input type="checkbox" data-field="financial_obligations_met_yes" value="{{ financial_obligations_met_yes }}"> YES
      <input type="checkbox" data-field="financial_obligations_met_no" value="{{ financial_obligations_met_no }}"> NO. Please explain: <span data-field="financial_explanation">{{ financial_explanation }}</span>
    </div>
  </div>

  <div style="font-size: 12px; margin-bottom: 10px;">
    <p>HAS THE STUDENT APPLIED FOR OR RECEIVED AUTHORIZATION FOR OFF-CAMPUS EMPLOYMENT?</p>
    <div style="margin-left: 20px;">
      <input type="checkbox" data-field="employment_authorized_yes" value="{{ employment_authorized_yes }}"> YES. Please specify the type of employment: <span data-field="employment_type">{{ employment_type }}</span>
      <input type="checkbox" data-field="employment_authorized_no" value="{{ employment_authorized_no }}"> NO
    </div>
  </div>

  <div class="form-row" style="margin-top: 40px;">
    <div style="flex: 1;">U.S. INSTITUTION: <span data-field="current_institution_name">{{ current_institution_name }}</span></div>
    <div style="flex: 1;">NAME & TITLE OF DSO: <span data-field="dso_name">{{ dso_name }}</span></div>
  </div>

  <div class="form-row" style="margin-top: 10px;">
    <div style="flex: 1;">TELEPHONE: <span data-field="dso_phone">{{ dso_phone }}</span></div>
    <div style="flex: 1;">EMAIL: <span data-field="dso_email">{{ dso_email }}</span></div>
  </div>

  <div class="form-row" style="margin-top: 10px;">
    <div style="flex: 1;">SIGNATURE OF DSO: 
      <div class="signature-line" style="width: 100%;" data-field="email">{{ email }}</div>
    </div>
    <div style="flex: 1;">DATE: <span data-field="dso_signature_date">{{ dso_signature_date }}</span></div>
  </div>
</div>