<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; }
  h1, h2 { text-align: center; font-weight: bold; }
  .header-logo { text-align: center; margin-bottom: 30px; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 15px; }
  .form-label { width: 150px; text-align: left; }
  .form-input-area { flex-grow: 1; border-bottom: 1px solid #000; }
  .signature-line { display: flex; justify-content: space-between; margin-top: 50px; }
  .signature-block { width: 30%; text-align: center; }
  .signature-block div { border-bottom: 1px solid #000; margin-bottom: 5px; }
</style>

<div class="page">
  <div class="header-logo">
    <h1 style="font-size: 36px; margin: 0;">HARRIET L. WILKES</h1>
    <h2 style="font-size: 24px; margin: 5px 0 0 0;">HONORS COLLEGE</h2>
    <h3 style="font-size: 18px; margin: 5px 0 0 0;">FLORIDA ATLANTIC UNIVERSITY</h3>
  </div>

  <p style="text-align: center; margin-bottom: 30px;">PROPOSAL FOR DIRECTED INDEPENDENT STUDY/DIRECTED INDEPENDENT RESEARCH</p>

  <div class="form-row">
    <div class="form-label">NAME:</div>
    <div class="form-input-area"><span data-field="full_name">{{ full_name }}</span></div>
  </div>

  <div class="form-row">
    <div class="form-label">EMAIL:</div>
    <div class="form-input-area"><span data-field="email">{{ email }}</span></div>
  </div>

  <div class="form-row">
    <div class="form-label">Z NUMBER:</div>
    <div class="form-input-area"><span data-field="z_number">{{ z_number }}</span></div>
    <div class="form-label" style="margin-left: 30%;">DATE:</div>
    <div class="form-input-area" style="width: 150px;"><span data-field="date">{{ date }}</span></div>
  </div>

  <div class="form-row">
    <div class="form-label">ADVISOR:</div>
    <div class="form-input-area"><span data-field="advisor_name">{{ advisor_name }}</span></div>
  </div>

  <p style="margin-top: 20px; font-size: 14px;">NOTE: STUDENTS ARE LIMITED TO 6 CREDITS OF D.I.S./D.I.R. COURSEWORK. EXCEPTIONS ARE MADE ONLY BY PETITION. INDICATE THE NUMBER OF DIS/DIR COURSES AND TOTAL CREDIT HOURS OF THESE COURSES:</p>

  <div class="form-row" style="margin-top: 10px;">
    <div class="form-label"># OF PRIOR DIS/DIR COURSES:</div>
    <div class="form-input-area"><span data-field="prior_dis_dir_courses_count">{{ prior_dis_dir_courses_count }}</span></div>
    <div class="form-label" style="margin-left: 30%;">TOTAL CREDITS OF THESE COURSES:</div>
    <div class="form-input-area" style="width: 150px;"><span data-field="total_credits_prior">{{ total_credits_prior }}</span></div>
  </div>

  <div class="form-row" style="margin-top: 20px;">
    <div class="form-label">PROPOSED COURSE #:</div>
    <div class="form-input-area"><span data-field="proposed_course_number">{{ proposed_course_number }}</span></div>
    <div class="form-label" style="margin-left: 30%;">CREDIT HRS:</div>
    <div class="form-input-area" style="width: 150px;"><span data-field="proposed_credit_hours">{{ proposed_credit_hours }}</span></div>
  </div>

  <div class="form-row" style="margin-top: 10px;">
    <div class="form-label">SEMESTER:</div>
    <div class="form-input-area" style="width: 150px;"><span data-field="proposed_semester">{{ proposed_semester }}</span></div>
    <div class="form-label" style="margin-left: 30%;">YEAR:</div>
    <div class="form-input-area" style="width: 150px;"><span data-field="proposed_year">{{ proposed_year }}</span></div>
  </div>

  <div class="form-row" style="margin-top: 20px;">
    <div class="form-label">INSTRUCTOR:</div>
    <div class="form-input-area"><span data-field="instructor_name">{{ instructor_name }}</span></div>
  </div>

  <div class="form-row" style="margin-top: 20px;">
    <div class="form-label">PROPOSED TITLE OF COURSE (FOR TRANSCRIPT):</div>
    <div class="form-input-area" style="width: 70%;">
      {% for i in range(10) %}
        <span style="border-bottom: 1px solid #000; display: inline-block; width: 20px;">&nbsp;</span>
      {% endfor %}
    </div>
  </div>

  <div class="form-row" style="margin-top: 20px;">
    <div class="form-label">H</div>
    <div class="form-input-area" style="width: 70%;">
      {% for i in range(10) %}
        <span style="border-bottom: 1px solid #000; display: inline-block; width: 20px;">&nbsp;</span>
      {% endfor %}
    </div>
  </div>

  <p style="margin-top: 30px; font-size: 14px;">BRIEF DESCRIPTION OF STUDY: (YOU MUST ALSO APPEND A SYLLABUS/OUTLINE PROVIDED BY THE INSTRUCTOR)</p>
  <div class="form-input-area" style="border-bottom: 1px solid #000; height: 100px; margin-bottom: 50px;"></div>


  <div class="signature-line">
    <div class="signature-block">
      Student
      <div></div>
      <div style="font-size: 12px;">DATE</div>
    </div>
    <div class="signature-block">
      DIS/DIR Instructor
      <div></div>
      <div style="font-size: 12px;">DATE</div>
    </div>
  </div>

  <div class="signature-line" style="margin-top: 50px;">
    <div class="signature-block">
      Chair
      <div></div>
      <div style="font-size: 12px;">DATE</div>
    </div>
    <div class="signature-block">
      Associate Dean or Dean
      <div></div>
      <div style="font-size: 12px;">DATE</div>
    </div>
  </div>

  <p style="text-align: right; font-size: 10px; margin-top: 100px;">Updated 2-10-2017</p>
</div>