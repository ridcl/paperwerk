                            <td style="width: 70%;">Red - R: 211 G: 35 B: 45</td>
                        </div>
                        <div class="table-row">
                            <td style="width: 30%;">HEX</td>
                            <td style="width: 70%;">Red - #c8102e</td>
                        </div>
                        <div class="table-row">
