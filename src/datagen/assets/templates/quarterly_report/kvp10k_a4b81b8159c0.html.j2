<!DOCTYPE html>
<html>
<head>
    <title>Report Template</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 { font-weight: bold; }
        .header-title { font-size: 24pt; }
        .sub-header { font-size: 14pt; }
        .content-section { margin-bottom: 30px; }
        .table-container { width: 100%; border-collapse: collapse; margin-top: 20px; }
        .table-container th, .table-container td { padding: 10px; text-align: left; border-bottom: 1px solid #ccc; }
        .chart-placeholder { height: 300px; background-color: #f0f0f0; display: flex; align-items: center; justify-content: center; color: #888; margin-top: 20px; }
    </style>

<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, Helvetica, Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { font-weight: bold; }
  .chart-container {
    display: flex;
    align-items: flex-end;
    height: 300px; /* Approximate height for visualization */
    border-left: 1px solid #ccc;
    border-bottom: 1px solid #ccc;
    padding-left: 10px;
    padding-bottom: 10px;
    position: relative;
  }
  .bar-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 12%; /* Adjust width based on number of categories */
    margin: 0 1%;
    position: relative;
    height: 100%;
  }
  .bar {
    width: 80%;
    transition: height 0.5s;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    font-size: 10px;
    color: #333;
  }
  .bar-fy18 { background-color: #003366; } /* Dark Blue */
  .bar-fy19 { background-color: #FFC300; } /* Gold/Yellow */
  .bar-label {
    position: absolute;
    top: -20px;
    font-size: 10px;
    font-weight: bold;
  }
  .category-label {
    margin-top: 10px;
    font-size: 10px;
    text-align: center;
    width: 100%;
  }
  .total-header {
    font-weight: bold;
    margin-bottom: 15px;
  }
</style>
