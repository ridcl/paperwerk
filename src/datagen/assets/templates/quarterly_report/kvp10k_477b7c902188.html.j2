<!DOCTYPE html>
<html>
<head>
    <title>Report</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 {
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .header-title {
            font-size: 24pt;
            font-weight: bold;
        }
        .header-subtitle {
            font-size: 14pt;
            font-weight: normal;
        }
        .section-title {
            font-size: 16pt;
            font-weight: bold;
            margin-bottom: 15px;
        }
        .toc-entry {
            display: flex;
            justify-content: space-between;
            padding: 3px 0;
            font-size: 12pt;
        }
        .toc-entry span:first-child {
            flex-grow: 1;
        }
        .toc-entry span:last-child {
            font-weight: normal;
        }
        .intro-text {
            font-size: 11pt;
            line-height: 1.6;
        }
        .chart-container {
            width: 100%;
            height: 300px; /* Placeholder for chart visualization */
            margin-top: 20px;
            border: 1px solid #ccc;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10pt;
            color: #555;
        }
        .bar-chart-container {
            width: 100%;
            height: 350px;
            margin-top: 20px;
        }
        .bar-row {
            display: flex;
            align-items: center;
            margin-bottom: 10px;
            font-size: 11pt;
        }
        .bar-label {
            width: 250px;
            flex-shrink: 0;
        }
        .bar-visual {
            flex-grow: 1;
            height: 20px;
            background-color: #eee;
            position: relative;
            margin-right: 10px;
        }
        .bar-fill {
            height: 100%;
            position: absolute;
            top: 0;
            left: 0;
        }
        .bar-value {
            font-size: 10pt;
            min-width: 100px;
            text-align: right;
        }
    </style>
</head>
<body>

<div class="page">
    <div style="text-align: center; margin-bottom: 30px;">
        <h1 class="header-title">UNIVERSITY OF TENNESSEE AT CHATTANOOGA</h1>
        <div style="width: 60%; height: 2px; background-color: #003366; margin: 10px auto;"></div>
    </div>
    <h2 class="section-title" style="text-align: center; margin-top: 0;">SPONSORED PROGRAM ACTIVITY</h2>
    <p class="header-subtitle" style="text-align: center;">QUARTERLY REPORT</p>
</div>

<div class="page">
    <h2 class="section-title">TABLE OF CONTENTS</h2>
    <div class="toc-entry">
        <span>Introduction</span>
        <span>3</span>
    </div>
    <div class="toc-entry">
        <span>UTC Sponsored Programs – Quarterly Award Comparison</span>
        <span>4</span>
    </div>
    <div class="toc-entry">
        <span>UTC Sponsored Programs – Quarterly Proposal Comparison</span>
        <span>5</span>
    </div>
    <div class="toc-entry">
        <span>UTC Sponsored Programs – Awards FY18/FY19 Comparison</span>
        <span>6</span>
    </div>
    <div class="toc-entry">
        <span>College of Arts & Sciences – Awards & Proposals FY18/FY19 Comparison</span>
        <span>8</span>
    </div>
    <div class="toc-entry">
        <span>Gary W. Rollins College of Business – Awards & Proposals FY19</span>
        <span>9</span>
    </div>
    <div class="toc-entry">
        <span>College of Engineering & Computer Science – Awards & Proposals FY18/FY19 Comparison</span>
        <span>10</span>
    </div>
    <div class="toc-entry">
        <span>College of Health, Education, & Professional Studies – Awards & Proposals FY18/FY19 Comparison</span>
        <span>11</span>
    </div>
    <div class="toc-entry">
        <span>Admin Units – Awards & Proposals FY18/FY19 Comparison</span>
        <span>12</span>
    </div>
    <div class="toc-entry">
        <span>Listing of Awards & Proposals By Investigator*</span>
        <span>13</span>
    </div>
    <div class="toc-entry">
        <span>Office of Research and Sponsored Programs</span>
        <span>18</span>
    </div>
</div>

<div class="page">
    <h2 class="section-title">INTRODUCTION</h2>
    <p style="font-size: 10pt; margin-bottom: 20px;">SECOND QUARTER: {{ report_period_start }} – {{ report_period_end }}</p>
    <div style="display: flex; gap: 40px;">
        <div style="flex: 2;">
            <p class="intro-text">The information contained in this report is drawn from the {{ data_source }} database and provides comparisons of the amounts of external funding for the second quarter of FY {{ fiscal_year_1 }} and FY {{ fiscal_year_2 }}. This report includes all proposals and awards that were reported and approved by {{ approval_date }}. Proposals submitted for internal routing but not yet approved and awards not fully processed as of that date will be included in future quarterly reports. If any of the information in this report does not correspond to your records or you have general questions, please notify {{ contact_email }}.</p>
        </div>
        <div style="flex: 1; text-align: center;">
            <!-- Placeholder for image -->
            <div style="height: 250px; background-color: #ccc; border: 1px solid #999;"></div>
        </div>
    </div>
</div>

<div class="page">
    <h2 class="section-title">UTC SPONSORED PROGRAMS – QUARTERLY AWARD COMPARISON</h2>
    <div class="chart-container">
        <!-- Placeholder for chart -->
        <p>Chart comparing Quarterly Awards for Quarter 1 and Quarter 2 (2018 vs 2019)</p>
    </div>
</div>

<div class="page">
    <h2 class="section-title">UTC SPONSORED PROGRAMS – QUARTERLY PROPOSAL COMPARISON</h2>
    <div class="chart-container">
        <!-- Placeholder for chart -->
        <p>Chart comparing Quarterly Proposals for Quarter 1 and Quarter 2 (2018 vs 2019)</p>
    </div>
</div>

<div class="page">
    <h2 class="section-title">UTC SPONSORED PROGRAMS – AWARDS FY18/FY19 COMPARISON</h2>
    <div class="bar-chart-container">
        {% for category in award_categories %}
        <div class="bar-row">
            <div class="bar-label">{{ category.name }}</div>
            <div class="bar-visual">
                <!-- FY18 Bar -->
                <div class="bar-fill" style="width: {{ category.fy18_percentage }}%;"></div>
                <!-- FY19 Bar -->
                <div class="bar-fill" style="width: {{ category.fy19_percentage }}%; background-color: #f0ad4e;"></div>
            </div>
            <div class="bar-value">
                FY18: ${{ category.fy18_amount | intcomma }}<br>
                FY19: ${{ category.fy19_amount | intcomma }}
            </div>
        </div>
        {% endfor %}
    </div>
</div>

<div class="page">
    <h2 class="section-title">UTC SPONSORED PROGRAMS – PROPOSALS FY18/FY19 COMPARISON</h2>
    <div class="bar-chart-container">
        {% for category in proposal_categories %}
        <div class="bar-row">
            <div class="bar-label">{{ category.name }}</div>
            <div class="bar-visual">
                <!-- FY18 Bar -->
                <div class="bar-fill" style="width: {{ category.fy18_percentage }}%;"></div>
                <!-- FY19 Bar -->
                <div class="bar-fill" style="width: {{ category.fy19_percentage }}%; background-color: #f0ad4e;"></div>
            </div>
            <div class="bar-value">
                FY18: ${{ category.fy18_amount | intcomma }}<br>
                FY19: ${{ category.fy19_amount | intcomma }}
            </div>
        </div>
        {% endfor %}
    </div>
</div>

<div class="page">
    <h2 class="section-title">COLLEGE OF ARTS & SCIENCES – AWARDS & PROPOSALS FY18/FY19 COMPARISON</h2>
    <div style="display: flex; gap: 40px;">
        <div style="flex: 1;">
            <h3 style="font-size: 14pt; margin-bottom: 10px;">Awards</h3>
            <div class="bar-chart-container" style="height: 300px;">
                {% for discipline in arts_sciences_awards %}
                <div class="bar-row">
                    <div class="bar-label">{{ discipline.name }}</div>
                    <div class="bar-visual">
                        <div class="bar-fill" style="width: {{ discipline.fy18_percentage }}%;"></div>
                        <div class="bar-fill" style="width: {{ discipline.fy19_percentage }}%; background-color: #f0ad4e;"></div>
                    </div>
                    <div class="bar-value">
                        FY18: ${{ discipline.fy18_amount | intcomma }}<br>
                        FY19: ${{ discipline.fy19_amount | intcomma }}
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
        <div style="flex: 1;">
            <h3 style="font-size: 14pt; margin-bottom: 10px;">Proposals</h3>
            <div class="bar-chart-container" style="height: 300px;">
                {% for discipline in arts_sciences_proposals %}
                <div class="bar-row">
                    <div class="bar-label">{{ discipline.name }}</div>
                    <div class="bar-visual">
                        <div class="bar-fill" style="width: {{ discipline.fy18_percentage }}%;"></div>
                        <div class="bar-fill" style="width: {{ discipline.fy19_percentage }}%; background-color: #f0ad4e;"></div>
                    </div>
                    <div class="bar-value">
                        FY18: ${{ discipline.fy18_amount | intcomma }}<br>
                        FY19: ${{ discipline.fy19_amount | intcomma }}
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>

<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
  }
  th, td {
    padding: 8px 12px;
    text-align: left;
  }
  .header {
    font-weight: bold;
    font-size: 1.2em;
    margin-bottom: 15px;
  }
</style>

<div class="page">
  <div style="text-align: center; margin-bottom: 40px;">
    <h1 style="font-size: 1.5em; margin: 0;">GARY W. ROLLINS COLLEGE OF BUSINESS – AWARDS & PROPOSALS FY19</h1>
  </div>
  <div style="display: flex; justify-content: space-between;">
    <div style="width: 48%;">
      <div class="header">Awards (Total: <span data-field="awards.total_amount">{{ awards.total_amount }}</span>)</div>
      <div style="height: 300px; display: flex; align-items: flex-end; border-left: 1px solid #ccc; border-bottom: 1px solid #ccc; padding-left: 10px;">
        <div style="width: 100%; background-color: #f0ad4e; height: 60%; display: flex; align-items: flex-end; justify-content: center;">
          <span data-field="awards.value">{{ awards.value }}</span>
        </div>
        <div style="width: 100%; display: flex; flex-direction: column; justify-content: space-between; padding-right: 10px;">
          <div style="height: 10%; border-bottom: 1px dotted #ccc;">$2,000</div>
          <div style="height: 20%; border-bottom: 1px dotted #ccc;">$4,000</div>
          <div style="height: 30%; border-bottom: 1px dotted #ccc;">$6,000</div>
          <div style="height: 40%; border-bottom: 1px dotted #ccc;">$8,000</div>
          <div style="height: 50%; border-bottom: 1px dotted #ccc;">$10,000</div>
          <div style="height: 60%; border-bottom: 1px dotted #ccc;">$12,000</div>
        </div>
      </div>
      <div style="margin-top: 20px; text-align: center;">
        <span data-field="awards.category">{{ awards.category }}</span>
      </div>
    </div>
    <div style="width: 48%;">
      <div class="header">Proposals (Total: <span data-field="proposals.total_amount">{{ proposals.total_amount }}</span>)</div>
      <div style="height: 300px; display: flex; align-items: flex-end; border-left: 1px solid #ccc; border-bottom: 1px solid #ccc; padding-left: 10px;">
        <div style="width: 100%; background-color: #f0ad4e; height: 80%; display: flex; align-items: flex-end; justify-content: center;">
          <span data-field="proposals.value">{{ proposals.value }}</span>
        </div>
        <div style="width: 100%; display: flex; flex-direction: column; justify-content: space-between; padding-right: 10px;">
          <div style="height: 0%; border-bottom: 1px dotted #ccc;">$0</div>
          <div style="height: 10%; border-bottom: 1px dotted #ccc;">$100,000</div>
          <div style="height: 20%; border-bottom: 1px dotted #ccc;">$200,000</div>
          <div style="height: 30%; border-bottom: 1px dotted #ccc;">$300,000</div>
          <div style="height: 40%; border-bottom: 1px dotted #ccc;">$400,000</div>
          <div style="height: 50%; border-bottom: 1px dotted #ccc;">$500,000</div>
          <div style="height: 60%; border-bottom: 1px dotted #ccc;">$600,000</div>
          <div style="height: 70%; border-bottom: 1px dotted #ccc;">$700,000</div>
          <div style="height: 80%; border-bottom: 1px dotted #ccc;">$800,000</div>
        </div>
      </div>
      <div style="margin-top: 20px; text-align: center;">
        <span data-field="proposals.category">{{ proposals.category }}</span>
      </div>
    </div>
  </div>
  <div style="text-align: right; margin-top: 50px;">
    <span data-field="page_number">{{ page_number }}</span>
  </div>
</div>

