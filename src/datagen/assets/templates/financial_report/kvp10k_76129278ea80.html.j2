<!DOCTYPE html>
<html>
<head>
<title>Live Cattle Put Options</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  th, td {
    padding: 8px;
    text-align: left;
    border-bottom: 1px solid #ccc;
  }
  .header-row th {
    background-color: #f0f0f0;
    font-weight: bold;
  }
  .text-right {
    text-align: right;
  }
  .text-center {
    text-align: center;
  }
</style>
</head>
<body>
<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px;">
    <div>
      <h1 style="font-size: 24pt; margin: 0;">LIVE CATTLE PUT OPTIONS</h1>
      <p style="font-size: 10pt; margin-top: 10px;">
        <span data-field="document_title">{{ document_title }}</span> - http://www.cnigroup.com/bullbyte/cme. CME Group Inc. A.
        <span data-field="contact_info">{{ contact_info }}</span>
      </p>
    </div>
    <div style="text-align: right;">
      <p style="font-size: 10pt;">16</p>
      <p style="font-size: 10pt;">Sid 01</p>
    </div>
  </div>

  <h2 style="font-size: 14pt; margin-top: 30px; margin-bottom: 15px;">FINAL</h2>

  <table style="margin-top: 20px;">
    <thead>
      <tr class="header-row">
        <th style="width: 10%;">Strike</th>
        <th style="width: 10%;">Open Range</th>
        <th style="width: 10%;">High</th>
        <th style="width: 10%;">Low</th>
        <th style="width: 10%;">Closing Range</th>
        <th style="width: 10%;">Sett. Price</th>
        <th style="width: 10%;">Delta</th>
        <th style="width: 10%;">Circled</th>
        <th style="width: 10%;">Volume</th>
        <th style="width: 10%;">Open</th>
        <th style="width: 10%;">Interest</th>
        <th style="width: 10%;">High</th>
        <th style="width: 10%;">Low</th>
      </tr>
    </thead>
    <tbody>
      {% for item in put_options_data %}
      <tr>
        <td><span data-field="put_options_data[{{ loop.index0 }}].strike">{{ put_options_data[loop.index0].strike }}</span></td>
        <td><span data-field="put_options_data[{{ loop.index0 }}].open_range">{{ put_options_data[loop.index0].open_range }}</span></td>
        <td><span data-field="put_options_data[{{ loop.index0 }}].high">{{ put_options_data[loop.index0].high }}</span></td>
        <td><span data-field="put_options_data[{{ loop.index0 }}].low">{{ put_options_data[loop.index0].low }}</span></td>
        <td><span data-field="put_options_data[{{ loop.index0 }}].closing_range">{{ put_options_data[loop.index0].closing_range }}</span></td>
        <td class="text-right"><span data-field="put_options_data[{{ loop.index0 }}].settle_price">{{ put_options_data[loop.index0].settle_price }}</span></td>
        <td class="text-right"><span data-field="put_options_data[{{ loop.index0 }}].delta">{{ put_options_data[loop.index0].delta }}</span></td>
        <td class="text-center"><span data-field="put_options_data[{{ loop.index0 }}].circled">{{ put_options_data[loop.index0].circled }}</span></td>
        <td class="text-right"><span data-field="put_options_data[{{ loop.index0 }}].volume">{{ put_options_data[loop.index0].volume }}</span></td>
        <td class="text-right"><span data-field="put_options_data[{{ loop.index0 }}].open">{{ put_options_data[loop.index0].open }}</span></td>
        <td class="text-right"><span data-field="put_options_data[{{ loop.index0 }}].interest">{{ put_options_data[loop.index0].interest }}</span></td>
        <td class="text-right"><span data-field="put_options_data[{{ loop.index0 }}].high_int">{{ put_options_data[loop.index0].high_int }}</span></td>
        <td class="text-right"><span data-field="put_options_data[{{ loop.index0 }}].low_int">{{ put_options_data[loop.index0].low_int }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <h2 style="font-size: 14pt; margin-top: 30px; margin-bottom: 15px;">LIVE CATTLE PUTS</h2>

  <table style="margin-top: 20px;">
    <thead>
      <tr class="header-row">
        <th style="width: 10%;">Strike</th>
        <th style="width: 10%;">Open Range</th>
        <th style="width: 10%;">High</th>
        <th style="width: 10%;">Low</th>
        <th style="width: 10%;">Closing Range</th>
        <th style="width: 10%;">Sett. Price</th>
        <th style="width: 10%;">Delta</th>
        <th style="width: 10%;">Circled</th>
        <th style="width: 10%;">Volume</th>
        <th style="width: 10%;">Open</th>
        <th style="width: 10%;">Interest</th>
        <th style="width: 10%;">High</th>
        <th style="width: 10%;">Low</th>
      </tr>
    </thead>
    <tbody>
      {% for item in live_cattle_puts %}
      <tr>
        <td><span data-field="live_cattle_puts[{{ loop.index0 }}].strike">{{ live_cattle_puts[loop.index0].strike }}</span></td>
        <td><span data-field="live_cattle_puts[{{ loop.index0 }}].open_range">{{ live_cattle_puts[loop.index0].open_range }}</span></td>
        <td><span data-field="live_cattle_puts[{{ loop.index0 }}].high">{{ live_cattle_puts[loop.index0].high }}</span></td>
        <td><span data-field="live_cattle_puts[{{ loop.index0 }}].low">{{ live_cattle_puts[loop.index0].low }}</span></td>
        <td><span data-field="live_cattle_puts[{{ loop.index0 }}].closing_range">{{ live_cattle_puts[loop.index0].closing_range }}</span></td>
        <td class="text-right"><span data-field="live_cattle_puts[{{ loop.index0 }}].settle_price">{{ live_cattle_puts[loop.index0].settle_price }}</span></td>
        <td class="text-right"><span data-field="live_cattle_puts[{{ loop.index0 }}].delta">{{ live_cattle_puts[loop.index0].delta }}</span></td>
        <td class="text-center"><span data-field="live_cattle_puts[{{ loop.index0 }}].circled">{{ live_cattle_puts[loop.index0].circled }}</span></td>
        <td class="text-right"><span data-field="live_cattle_puts[{{ loop.index0 }}].volume">{{ live_cattle_puts[loop.index0].volume }}</span></td>
        <td class="text-right"><span data-field="live_cattle_puts[{{ loop.index0 }}].open">{{ live_cattle_puts[loop.index0].open }}</span></td>
        <td class="text-right"><span data-field="live_cattle_puts[{{ loop.index0 }}].interest">{{ live_cattle_puts[loop.index0].interest }}</span></td>
        <td class="text-right"><span data-field="live_cattle_puts[{{ loop.index0 }}].high_int">{{ live_cattle_puts[loop.index0].high_int }}</span></td>
        <td class="text-right"><span data-field="live_cattle_puts[{{ loop.index0 }}].low_int">{{ live_cattle_puts[loop.index0].low_int }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div style="margin-top: 50px; border-top: 1px solid #ccc; padding-top: 10px;">
    <p style="font-size: 10pt;">
      <span data-field="disclaimer_text">{{ disclaimer_text }}</span>
    </p>
  </div>
</div>
</body>
</html>