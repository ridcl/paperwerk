<!DOCTYPE html>
<html>
<head>
<title>Agricultural Futures Template</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  th, td {
    padding: 8px;
    text-align: left;
    border: 1px solid #ddd;
  }
  .header-title {
    font-size: 18pt;
    font-weight: bold;
    text-align: center;
    margin-bottom: 10px;
  }
  .metadata {
    display: flex;
    justify-content: space-between;
    font-size: 10pt;
    margin-bottom: 20px;
  }
  .metadata div {
    display: flex;
    gap: 20px;
  }
  .section-header {
    font-size: 12pt;
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
    border-bottom: 1px solid #000;
  }
  .sub-header {
    font-size: 10pt;
    font-weight: bold;
    margin-top: 15px;
    margin-bottom: 5px;
  }
</style>
</head>
<body>

<div class="page">
  <div class="metadata">
    <div>
      <span data-field="document_id">{{ document_id }}</span>
      <span data-field="document_title">{{ document_title }}</span>
    </div>
    <div>
      <span data-field="date_generated">{{ date_generated }}</span>
      <span data-field="page_number">{{ page_number }}</span>
    </div>
  </div>
  <div class="header-title">AGRICULTURAL FUTURES</div>
  <div style="margin-bottom: 20px;">
    <p>
      <span data-field="broker_name">{{ broker_name }}</span><br>
      <span data-field="broker_address">{{ broker_address }}</span><br>
      Customer Since: <span data-field="customer_since">{{ customer_since }}</span>
    </p>
  </div>

  <div class="section-header">PGO3 BULLETIN #1150</div>

  <table>
    <thead>
      <tr>
        <th style="width: 10%;">GLOBEX</th>
        <th style="width: 10%;">OPEN</th>
        <th style="width: 10%;">HIGH/LOW</th>
        <th style="width: 10%;">CLOSE</th>
        <th style="width: 10%;">SETTLEMENT</th>
        <th style="width: 10%;">PRICE</th>
        <th style="width: 10%;">VOLUME</th>
        <th style="width: 10%;">INTEREST</th>
        <th style="width: 10%;">VOL. INT. PRICE</th>
      </tr>
    </thead>
    <tbody>
      {% for row in futures_data %}
      <tr>
        <td><span data-field="futures_data[{{ loop.index0 }}].globex">{{ futures_data[loop.index0].globex }}</span></td>
        <td><span data-field="futures_data[{{ loop.index0 }}].open">{{ futures_data[loop.index0].open }}</span></td>
        <td><span data-field="futures_data[{{ loop.index0 }}].high_low">{{ futures_data[loop.index0].high_low }}</span></td>
        <td><span data-field="futures_data[{{ loop.index0 }}].close">{{ futures_data[loop.index0].close }}</span></td>
        <td><span data-field="futures_data[{{ loop.index0 }}].settlement">{{ futures_data[loop.index0].settlement }}</span></td>
        <td><span data-field="futures_data[{{ loop.index0 }}].price">{{ futures_data[loop.index0].price }}</span></td>
        <td><span data-field="futures_data[{{ loop.index0 }}].volume">{{ futures_data[loop.index0].volume }}</span></td>
        <td><span data-field="futures_data[{{ loop.index0 }}].interest">{{ futures_data[loop.index0].interest }}</span></td>
        <td><span data-field="futures_data[{{ loop.index0 }}].vol_int_price">{{ futures_data[loop.index0].vol_int_price }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="section-header">TOTAL</div>
  <table>
    <tr>
      <td style="font-weight: bold;">TOTAL</td>
      <td style="font-weight: bold;"><span data-field="total_open">{{ total_open }}</span></td>
      <td style="font-weight: bold;"><span data-field="total_high_low">{{ total_high_low }}</span></td>
      <td style="font-weight: bold;"><span data-field="total_close">{{ total_close }}</span></td>
      <td style="font-weight: bold;"><span data-field="total_settlement">{{ total_settlement }}</span></td>
      <td style="font-weight: bold;"><span data-field="total_price">{{ total_price }}</span></td>
      <td style="font-weight: bold;"><span data-field="total_volume">{{ total_volume }}</span></td>
      <td style="font-weight: bold;"><span data-field="total_interest">{{ total_interest }}</span></td>
      <td style="font-weight: bold;"><span data-field="total_vol_int_price">{{ total_vol_int_price }}</span></td>
    </tr>
  </table>

</div>

