<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1, h2 { text-align: center; margin-bottom: 0.5em; }
  .header-logo { text-align: center; font-size: 2em; margin-bottom: 10px; }
  .form-section { margin-bottom: 20px; }
  .field-row { display: flex; justify-content: space-between; margin-bottom: 10px; }
  .field-label { width: 30%; font-weight: bold; }
  .field-value { width: 65%; border-bottom: 1px solid #000; }
  .signature-line { margin-top: 50px; border-top: 1px solid #000; padding-top: 5px; }
  .footer-info { margin-top: 40px; font-size: 0.9em; }
</style>

<div class="page">
  <div class="header-logo">
    BOSTON COLLEGE
  </div>
  <h1>Direct Deposit for Savings Form</h1>
  <p style="text-align: center; font-size: 0.9em;">Version 2.1</p>
  <p style="text-align: center; margin-bottom: 30px;">This form is to be completed by a Bank Representative.</p>

  <div class="form-section">
    <div class="field-row">
      <div class="field-label">Employee Name:</div>
      <div class="field-value"><span data-field="employee_name">{{ employee_name }}</span></div>
    </div>
    <div class="field-row">
      <div class="field-label">Social Security Number:</div>
      <div class="field-value"><span data-field="ssn">{{ ssn }}</span></div>
    </div>
    <div class="field-row">
      <div class="field-label">Bank Name:</div>
      <div class="field-value"><span data-field="bank_name">{{ bank_name }}</span></div>
    </div>
    <div class="field-row">
      <div class="field-label">Bank Transit Number:</div>
      <div class="field-value"><span data-field="transit_number">{{ transit_number }}</span></div>
    </div>
    <div class="field-row">
      <div class="field-label">Employee Account Number:</div>
      <div class="field-value"><span data-field="account_number">{{ account_number }}</span></div>
    </div>
    <div class="field-row">
      <div class="field-label">The Account was opened in the state of:</div>
      <div class="field-value"><span data-field="state_of_account">{{ state_of_account }}</span></div>
    </div>
    <div class="field-row">
      <div class="field-label">Bank Representative Name:</div>
      <div class="field-value"><span data-field="bank_rep_name">{{ bank_rep_name }}</span></div>
    </div>
    <div class="field-row">
      <div class="field-label">Branch Address (street, city):</div>
      <div class="field-value"><span data-field="branch_address">{{ branch_address }}</span></div>
    </div>
    <div class="field-row">
      <div class="field-label">Telephone Number:</div>
      <div class="field-value"><span data-field="phone_number">{{ phone_number }}</span></div>
    </div>
  </div>

  <div class="signature-line">
    Bank Representative Signature: _________________________ Date: <span data-field="signature_date">{{ signature_date }}</span>
  </div>

  <div class="footer-info">
    <p>Please hand deliver this completed form to:</p>
    <p>Boston College</p>
    <p>Human Resources Service Center</p>
    <p>More Hall 370</p>
    <p>140 Commonwealth Avenue</p>
    <p>Chestnut Hill, MA 02467-3819</p>
    <p>Phone: <span data-field="office_phone">{{ office_phone }}</span> Fax: <span data-field="office_fax">{{ office_fax }}</span></p>
  </div>
</div>