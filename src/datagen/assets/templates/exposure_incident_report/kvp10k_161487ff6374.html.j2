<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  .form-group { margin-bottom: 15px; }
  .line { border-bottom: 1px solid #000; margin-top: 5px; margin-bottom: 5px; }
  .label-row { display: flex; justify-content: space-between; margin-bottom: 10px; }
  .full-width-line { width: 100%; border-bottom: 1px solid #000; margin-top: 5px; margin-bottom: 5px; }
</style>
<div class="page">
  <div style="font-family: DejaVu Serif, Liberation Serif, Georgia, Helvetica, Arial;">
    <h2 style="font-size: 16pt; font-weight: bold; margin-bottom: 10px;">EXPOSURE INCIDENT REPORT</h2>
    <p style="margin-top: 0;">(ROUTES AND CIRCUMSTANCES OF EXPOSURE INCIDENT)</p>
    <p style="margin-top: 0;">Please Print</p>

    <div class="form-group">
      <div class="label-row">
        <label style="width: 30%;">DATE COMPLETED</label>
        <div class="full-width-line"></div>
      </div>
    </div>

    <div class="form-group">
      <div class="label-row">
        <label style="width: 30%;">EMPLOYEE'S NAME</label>
        <div class="full-width-line" style="width: 60%;"></div>
        <label style="width: 10%;">SS#</label>
      </div>
    </div>

    <div class="form-group">
      <div class="label-row">
        <label style="width: 30%;">HOME PHONE</label>
        <div class="full-width-line" style="width: 35%;"></div>
        <label style="width: 30%;">BUSINESS PHONE</label>
        <div class="full-width-line" style="width: 35%;"></div>
      </div>
    </div>

    <div class="form-group">
      <div class="label-row">
        <label style="width: 30%;">DOB</label>
        <div class="full-width-line" style="width: 35%;"></div>
        <label style="width: 30%;">JOB TITLE</label>
        <div class="full-width-line" style="width: 35%;"></div>
      </div>
    </div>

    <div class="form-group">
      <div class="label-row">
        <label style="width: 30%;">EMPLOYEE VACCINATION STATUS</label>
        <div class="full-width-line" style="width: 70%;"></div>
      </div>
    </div>

    <div class="form-group">
      <div class="label-row">
        <label style="width: 30%;">DATE OF EXPOSURE</label>
        <div class="full-width-line" style="width: 30%;"></div>
        <label style="width: 30%;">TIME OF EXPOSURE</label>
        <div class="full-width-line" style="width: 30%;"></div>
        <label style="width: 10%;">AM/PM</label>
      </div>
    </div>

    <div class="form-group">
      <label style="display: block; margin-bottom: 5px;">LOCATION OF INCIDENT (BUILDING, STREET, ETC. – BE SPECIFIC):</label>
      <div class="full-width-line"></div>
    </div>

    <div class="form-group">
      <label style="display: block; margin-bottom: 5px;">NATURE OF INCIDENT (ACCIDENT WHILE CLEANING, SPORTS, TRAUMA, MEDICAL EMERGENCY) BE SPECIFIC:</label>
      <div class="full-width-line"></div>
    </div>

    <div class="form-group">
      <label style="display: block; margin-bottom: 5px;">DESCRIBE WHAT TASK (S) YOU WERE PERFORMING WHEN THE EXPOSURE OCCURRED (BE SPECIFIC):</label>
      <div class="full-width-line"></div>
    </div>

    <div class="form-group">
      <label style="display: block; margin-bottom: 5px;">WHERE YOU WEARING PERSONAL PROTECTIVE EQUIPMENT (PPE)?</label>
      <div style="display: flex; gap: 30px; margin-bottom: 10px;">
        <label>YES</label>
        <div class="full-width-line" style="width: 100px;"></div>
        <label>NO</label>
        <div class="full-width-line" style="width: 100px;"></div>
      </div>
    </div>

    <div class="form-group">
      <label style="display: block; margin-bottom: 5px;">IF YES, LIST</label>
      <div class="full-width-line"></div>
    </div>

    <div class="form-group">
      <label style="display: block; margin-bottom: 5px;">DID THE PPE FAIL? YES ____ NO ____</label>
      <div style="display: flex; gap: 40px; margin-top: 5px;">
        <label>YES</label>
        <div class="full-width-line" style="width: 100px;"></div>
        <label>NO</label>
        <div class="full-width-line" style="width: 100px;"></div>
      </div>
    </div>

    <div class="form-group">
      <label style="display: block; margin-bottom: 5px;">IF YES, EXPLAIN HOW:</label>
      <div class="full-width-line"></div>
    </div>

    <div class="form-group">
      <label style="display: block; margin-bottom: 5px;">WHAT BODY FLUIDS WERE YOU EXPOSED TO (BLOOD OR OTHER POTENTIALLY INFECTIOUS MATERIAL)? (BE SPECIFIC):</label>
      <div class="full-width-line"></div>
    </div>

    <div class="form-group">
      <label style="display: block; margin-bottom: 5px;">WHAT PARTS OF YOUR BODY BECAME EXPOSED? BE SPECIFIC.</label>
      <div class="full-width-line"></div>
    </div>
  </div>
</div>
<div class="page">
  <div style="font-family: DejaVu Serif, Liberation Serif, Georgia, Helvetica, Arial;">
    <div class="form-group">
      <label style="display: block; margin-bottom: 5px;">ESTIMATE THE SIZE OF THE AREA OF YOUR BODY THAT WAS EXPOSED.</label>
      <div class="full-width-line"></div>
    </div>

    <div class="form-group">
      <label style="display: block; margin-bottom: 5px;">FOR HOW LONG?</label>
      <div class="full-width-line"></div>
    </div>

    <div class="form-group">
      <label style="display: block; margin-bottom: 5px;">DID A FOREIGN BODY (NEEDLE, NAIL, OR OTHER SHARPS ETC.) PENETRATE YOUR BODY? YES ____ NO ____</label>
      <div style="display: flex; gap: 40px; margin-top: 5px;">
        <label>YES</label>
        <div class="full-width-line" style="width: 100px;"></div>
        <label>NO</label>
        <div class="full-width-line" style="width: 100px;"></div>
      </div>
    </div>

    <div class="form-group">
      <label style="display: block; margin-bottom: 5px;">IF YES, WHAT WAS THE OBJECT?</label>
      <div class="full-width-line"></div>
    </div>

    <div class="form-group">
      <label style="display: block; margin-bottom: 5px;">WHERE DID IT PENETRATE YOUR BODY?</label>
      <div class="full-width-line"></div>
    </div>

    <div class="form-group">
      <label style="display: block; margin-bottom: 5px;">WAS ANY FLUID INJECTED INTO YOUR BODY? YES ____ NO ____</label>
      <div style="display: flex; gap: 40px; margin-top: 5px;">
        <label>YES</label>
        <div class="full-width-line" style="width: 100px;"></div>
        <label>NO</label>
        <div class="full-width-line" style="width: 100px;"></div>
      </div>
    </div>

    <div class="form-group">
      <label style="display: block; margin-bottom: 5px;">IF YES, WHAT FLUID?</label>
      <div class="full-width-line"></div>
    </div>

    <div class="form-group">
      <label style="display: block; margin-bottom: 5px;">HOW MUCH?</label>
      <div class="full-width-line"></div>
    </div>

    <div class="form-group">
      <label style="display: block; margin-bottom: 5px;">DID YOU RECEIVE MEDICAL ATTENTION? YES ____ NO ____</label>
      <div style="display: flex; gap: 40px; margin-top: 5px;">
        <label>YES</label>
        <div class="full-width-line" style="width: 100px;"></div>
        <label>NO</label>
        <div class="full-width-line" style="width: 100px;"></div>
      </div>
    </div>

    <div class="form-group">
      <label style="display: block; margin-bottom: 5px;">IF YES, WHERE?</label>
      <div class="full-width-line"></div>
    </div>

    <div class="form-group">
      <label style="display: block; margin-bottom: 5px;">WHEN?</label>
      <div class="full-width-line"></div>
    </div>

    <div class="form-group">
      <label style="display: block; margin-bottom: 5px;">BY WHOM?</label>
      <div class="full-width-line"></div>
    </div>

    <div class="form-group">
      <label style="display: block; margin-bottom: 5px;">IDENTIFICATION OF SOURCE INDIVIDUAL(S)</label>
      <div class="full-width-line"></div>
    </div>

    <div class="form-group">
      <label style="display: block; margin-bottom: 5px;">NAME(S)</label>
      <div class="full-width-line"></div>
    </div>

    <div class="form-group">
      <label style="display: block; margin-bottom: 5px;">DID YOU TREAT THE PATIENT DIRECTLY? YES ____ NO ____</label>
      <div style="display: flex; gap: 40px; margin-top: 5px;">
        <label>YES</label>
        <div class="full-width-line" style="width: 100px;"></div>
        <label>NO</label>
        <div class="full-width-line" style="width: 100px;"></div>
      </div>
    </div>

    <div class="form-group">
      <label style="display: block; margin-bottom: 5px;">IF YES, WHAT TREATMENT DID YOU PROVIDE, BE SPECIFIC:</label>
      <div class="full-width-line"></div>
    </div>

    <div class="form-group">
      <label style="display: block; margin-bottom: 5px;">OTHER PERTINENT INFORMATION</label>
      <div class="full-width-line"></div>
    </div>

    <div class="form-group" style="margin-top: 60px;">
      <label style="display: block; margin-bottom: 5px;">Signature of Supervisor or person preparing this report / Date</label>
      <div class="full-width-line"></div>
    </div>

    <div class="form-group" style="margin-top: 40px;">
      <label style="display: block; margin-bottom: 5px;">Signature of the Employee / Date</label>
      <div class="full-width-line"></div>
    </div>
  </div>
</div>