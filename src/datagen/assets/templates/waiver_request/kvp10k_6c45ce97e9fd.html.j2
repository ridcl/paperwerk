<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  /* Basic styling to mimic document structure */
  h1 {
    font-size: 24pt;
    font-weight: bold;
    text-align: center;
    margin-bottom: 5px;
  }
  h2 {
    font-size: 14pt;
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
  }
  .header-info {
    text-align: center;
    margin-bottom: 30px;
  }
  .contact-info p {
    margin: 2px 0;
    font-size: 10pt;
  }
  .section {
    margin-bottom: 25px;
  }
  .form-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 15px;
    font-size: 11pt;
  }
  .form-row > div {
    width: 48%;
  }
  .form-row label {
    display: block;
    margin-bottom: 5px;
    font-weight: normal;
  }
  .form-row input[type="text"], .form-row textarea {
    width: 100%;
    border-bottom: 1px solid #000;
    padding: 2px 0;
    box-sizing: border-box;
    font-size: 11pt;
  }
  .radio-group label {
    font-weight: normal;
    display: inline-block;
    margin-right: 15px;
  }
  .divider {
    border-top: 1px solid #000;
    margin: 20px 0;
  }
  .signature-line {
    display: flex;
    justify-content: space-between;
    margin-top: 50px;
    font-size: 11pt;
  }
</style>

<div class="page">
  <div class="header-info">
    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
      <div style="text-align: left;">
        <h1 style="font-size: 28pt; margin: 0;">UAF</h1>
        <div style="font-size: 12pt; font-weight: bold;">UNIVERSITY OF ALASKA</div>
        <div style="font-size: 12pt;">FAIRBANKS</div>
      </div>
      <div style="text-align: right;">
        <h1 style="font-size: 24pt; margin: 0;">Royalty Waiver Request</h1>
      </div>
    </div>
    <div style="text-align: center; margin-top: 10px;">
      <div style="font-size: 12pt; font-weight: bold;">UAF Dining Services and Contract Operations</div>
      <div class="contact-info" style="margin-top: 5px;">
        <p>PO Box {{ employer.address_line_1 }}, {{ employer.city }} {{ employer.state }} {{ employer.zip }}</p>
        <p>Phone: {{ employer.phone }} | Fax: {{ employer.fax }}</p>
        <p>E-Mail: <a href="mailto:{{ employer.email }}">{{ employer.email }}</a></p>
      </div>
    </div>
  </div>

  <div class="section" style="font-size: 10pt; line-height: 1.5;">
    <p>A royalty waiver is only granted for those items produced as giveaways to be used to promote UAF programs or events. All other uses of trademarks on products resulting in a profit gain are subject to royalty charges. This includes sales for fundraising projects, sales to individual members of an organization, or if the price of an item is built into a fee (i.e. event registration). A royalty waiver request must be submitted each time an order is made with a vendor.</p>
  </div>

  <div class="section">
    <div class="form-row">
      <div>
        <label for="requester_name">Requestor:</label>
        <input type="text" id="requester_name" value="{{ requester.full_name }}">
      </div>
      <div>
        <label for="phone">Phone:</label>
        <input type="text" id="phone" value="{{ requester.phone }}">
      </div>
    </div>
  </div>

  <div class="section">
    <div class="form-row">
      <div>
        <label for="department">Department/Club/Organization:</label>
        <input type="text" id="department" value="{{ requester.department }}">
      </div>
      <div>
        <label for="email">Email:</label>
        <input type="text" id="email" value="{{ requester.email }}">
      </div>
    </div>
  </div>

  <div class="section">
    <div class="form-row">
      <div>
        <label for="event_name">Event:</label>
        <input type="text" id="event_name" value="{{ event_name }}">
      </div>
      <div>
        <label for="date_range">Date(s):</label>
        <input type="text" id="date_range" value="{{ event_date }}">
      </div>
    </div>
  </div>

  <div class="section">
    <div class="form-row">
      <div>
        <label>Product Used For:</label>
        <div class="radio-group">
          <label><input type="radio" name="product_use" value="internal" {% if product_use == 'internal' %}checked{% endif %}> Internal Employee/Organizational Use</label>
          <label><input type="radio" name="product_use" value="fundraiser" {% if product_use == 'fundraiser' %}checked{% endif %}> Fund Raiser</label>
          <label><input type="radio" name="product_use" value="giveaway" {% if product_use == 'giveaway' %}checked{% endif %}> Promotional Giveaway</label>
          <label><input type="radio" name="product_use" value="other" {% if product_use == 'other' %}checked{% endif %}> Other</label>
        </div>
      </div>
    </div>
  </div>

  <div class="section">
    <div class="form-row">
      <div>
        <label for="product_description">Product Description and Quantity:</label>
        <textarea id="product_description" rows="3" style="width: 100%; border-bottom: 1px solid #000; padding: 5px; box-sizing: border-box;">{{ product_description }}</textarea>
        <p style="font-size: 9pt; margin-top: 5px;">Note: Artwork must be electronically submitted to <a href="mailto:{{ artwork_submission_email }}">{{ artwork_submission_email }}</a> for approval.</p>
      </div>
    </div>
  </div>

  <div class="section">
    <div class="form-row">
      <div>
        <label for="vendor_name">Name of Vendor:</label>
        <input type="text" id="vendor_name" value="{{ vendor_name }}">
      </div>
      <div>
        <label for="vendor_contact_info">Vendor Contact Information:</label>
        <input type="text" id="vendor_contact_info" value="{{ vendor_contact_info }}">
      </div>
    </div>
  </div>

  <div class="section">
    <div class="form-row">
      <div>
        <label for="fax_number">Fax Number:</label>
        <input type="text" id="fax_number" value="{{ vendor_fax }}">
      </div>
      <div>
        <label for="vendor_email">Email:</label>
        <input type="text" id="vendor_email" value="{{ vendor_email }}">
      </div>
    </div>
    <p style="font-size: 9pt; margin-top: 10px;">NOTE: Vendor must be a licensed vendor with University of Alaska Fairbanks. For a list of licensed vendors please visit <a href="{{ vendor_list_url }}">{{ vendor_list_url }}</a>. Questions: email uaf.aux@alaska.edu</p>
  </div>

  <div class="divider"></div>

  <div class="section">
    <div class="form-row">
      <div>
        <label for="requester_signature">Requestor Signature:</label>
        <div style="height: 50px; border-bottom: 1px solid #000; margin-top: 5px;" data-field="requestor_signature">{{ requestor_signature }}</div>
      </div>
      <div>
        <label for="date_signed">Date:</label>
        <div style="height: 50px; border-bottom: 1px solid #000; margin-top: 5px;" data-field="date">{{ date }}</div>
      </div>
    </div>
  </div>

  <div class="section" style="margin-top: 40px;">
    <h2 style="font-size: 14pt; text-align: center; margin-bottom: 20px;">OFFICIAL USE ONLY</h2>
    <div class="form-row" style="justify-content: center;">
      <div style="width: 20%;">
        <label style="display: inline-block; margin-right: 20px;">
          <input type="radio" name="approval_status" value="approved" {% if approval_status == 'approved' %}checked{% endif %}> Approved
        </label>
      </div>
      <div style="width: 20%;">
        <label style="display: inline-block; margin-right: 20px;">
          <input type="radio" name="approval_status" value="denied" {% if approval_status == 'denied' %}checked{% endif %}> Denied
        </label>
      </div>
      <div style="width: 60%;">
        <label for="comments">Comments:</label>
        <textarea id="comments" rows="3" style="width: 100%; border-bottom: 1px solid #000; padding: 5px; box-sizing: border-box;"></textarea>
      </div>
    </div>
  </div>

  <div class="divider" style="margin-top: 50px;"></div>

  <div class="section">
    <div class="signature-line">
      <div>
        <label for="dsco_signature">DSCO Representative Signature:</label>
        <div style="height: 50px; border-bottom: 1px solid #000; margin-top: 5px;" data-field="dsco_representative_signature">{{ dsco_representative_signature }}</div>
      </div>
      <div>
        <label for="dsco_date">Date:</label>
        <div style="height: 50px; border-bottom: 1px solid #000; margin-top: 5px;" data-field="date_2">{{ date_2 }}</div>
      </div>
    </div>
  </div>
</div>