        <th style="width: 10%;">HSGPA</th>
        <th style="width: 10%;">UW 1st Sem GPA</th>
        <th style="width: 10%;">Cont</th>
        <th style="width: 10%;">Left</th>
        <th style="width: 10%;">Fall to Fall Ret</th>
      </tr>
    </thead>
    <tbody>
      {% for year_data in table_2a_overall_data %}
      <tr>
        <td>{{ year_data.term }}</td>
        <td><span data-field="t2a_overall_students[{{ loop.index0 }}]]">{{ year_data.students }}</span></td>
        <td><span data-field="t2a_overall_mean[{{ loop.index0 }}]]">{{ year_data.mean }}</span></td>
        <td><span data-field="t2a_overall_act[{{ loop.index0 }}]]">{{ year_data.act }}</span></td>
        <td><span data-field="t2a_overall_hsgpa[{{ loop.index0 }}]]">{{ year_data.hsgpa }}</span></td>
        <td><span data-field="t2a_overall_uw_gpa[{{ loop.index0 }}]]">{{ year_data.uw_gpa }}</span></td>
        <td><span data-field="t2a_overall_cont[{{ loop.index0 }}]]">{{ year_data.cont }}</span></td>
        <td><span data-field="t2a_overall_left[{{ loop.index0 }}]]">{{ year_data.left }}</span></td>
        <td><span data-field="t2a_overall_fall_to_fall_ret[{{ loop.index0 }}]]">{{ year_data.fall_to_fall_ret }}%</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <h3 style="font-size: 14pt; margin-top: 30px;">Overall</h3>
  <table>
    <thead>
      <tr>
        <th style="width: 10%;">Term</th>
        <th style="width: 10%;">% Grads in 4 Years or Less</th>
        <th style="width: 10%;">Grad</th>
        <th style="width: 10%;">Cont</th>
        <th style="width: 10%;">Left</th>
        <th style="width: 10%;">% Grads in 5 Years or Less</th>
        <th style="width: 10%;">Grad</th>
        <th style="width: 10%;">Cont</th>
        <th style="width: 10%;">Left</th>
        <th style="width: 10%;">% Grads in 6 Years or Less</th>
        <th style="width: 10%;">Grad</th>
        <th style="width: 10%;">Cont</th>
        <th style="width: 10%;">Left</th>
      </tr>
    </thead>
    <tbody>
      {% for year_data in table_2a_summary_data %}
      <tr>
        <td>{{ year_data.term }}</td>
        <td><span data-field="t2a_summary_4yr_grad[{{ loop.index0 }}]]">{{ year_data.percent_4yr_grad }}%</span></td>
        <td><span data-field="t2a_summary_4yr_grad_count[{{ loop.index0 }}]]">{{ year_data.count_4yr_grad }}</span></td>
        <td><span data-field="t2a_summary_4yr_cont[{{ loop.index0 }}]]">{{ year_data.count_4yr_cont }}</span></td>
        <td><span data-field="t2a_summary_4yr_left[{{ loop.index0 }}]]">{{ year_data.count_4yr_left }}</span></td>
        <td><span data-field="t2a_summary_5yr_grad[{{ loop.index0 }}]]">{{ year_data.percent_5yr_grad }}%</span></td>
        <td><span data-field="t2a_summary_5yr_grad_count[{{ loop.index0 }}]]">{{ year_data.count_5yr_grad }}</span></td>
        <td><span data-field="t2a_summary_5yr_cont[{{ loop.index0 }}]]">{{ year_data.count_5yr_cont }}</span></td>
        <td><span data-field="t2a_summary_5yr_left[{{ loop.index0 }}]]">{{ year_data.count_5yr_left }}</span></td>
        <td><span data-field="t2a_summary_6yr_grad[{{ loop.index0 }}]]">{{ year_data.percent_6yr_grad }}%</span></td>
        <td><span data-field="t2a_summary_6yr_grad_count[{{ loop.index0 }}]]">{{ year_data.count_6yr_grad }}</span></td>
        <td><span data-field="t2a_summary_6yr_cont[{{ loop.index0 }}]]">{{ year_data.count_6yr_cont }}</span></td>
        <td><span data-field="t2a_summary_6yr_left[{{ loop.index0 }}]]">{{ year_data.count_6yr_left }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <p style="font-size: 10pt;">ACT: ACT Composite Score</p>
  <p style="font-size: 10pt;">HSGPA: High School Grade Point Average</p>
  <p style="font-size: 10pt;">UW 1st Sem GPA: First Semester Grade Point Average at UW</p>
  <p style="font-size: 8pt; text-align: right;">Source: UW Student Information System (Banner)</p>
</div>

