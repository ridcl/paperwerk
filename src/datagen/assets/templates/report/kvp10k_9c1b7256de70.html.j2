<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  th, td {
    padding: 8px;
    text-align: left;
  }
  .center {
    text-align: center;
  }
</style>

<div class="page">
  <div class="center">
    <span data-field="university_logo">{{ university_logo }}</span>
    <h1 style="font-size: 36pt; margin-top: 10px;">Wyoming High School Graduates at UW</h1>
    <h2 style="font-size: 24pt; margin-top: 10px;">{{ high_school_name }}</h2>
    <h3 style="font-size: 18pt; margin-top: 20px;">Fall {{ year }}</h3>
    <div style="margin-top: 50px;">
      <span data-field="oia_logo">{{ oia_logo }}</span>
      <p style="font-size: 10pt; margin-top: 10px;">Office of Institutional Analysis</p>
      <p style="font-size: 10pt;">{{ oia_website }}</p>
    </div>
  </div>
</div>

<div class="page">
  <h2 style="font-size: 16pt;">Wyoming High School Graduates at the University of Wyoming</h2>
  <p>Prepared by the Office of Institutional Analysis at UW</p>

  <h3 style="font-size: 14pt; margin-top: 30px;">This file contains:</h3>
  <ul>
    <li><span data-field="table_1_ref">{{ table_1_ref }}</span> Admission Status of First-Time, First-Year Applicants to UW, Summer and Fall {{ year }}</li>
    <li><span data-field="table_2a_ref">{{ table_2a_ref }}</span> Retention/Graduation for First-Time, First-Year, Full-Time Students, 2003 - 2012</li>
    <li><span data-field="table_3_ref">{{ table_3_ref }}</span> Participation and Achievement of First-Time, First-Year Students at UW, Fall {{ year }}</li>
    <li><span data-field="table_4_ref">{{ table_4_ref }}</span> List of Students from Wyoming High Schools, Fall {{ year }}</li>
  </ul>

  <p style="margin-top: 40px;">For additional information, contact:</p>
  <p>Tammy Scott</p>
  <p>Office of Institutional Analysis</p>
  <p>Dept 3314 - Old Main 414</p>
  <p>Laramie, WY {{ zip_code }}</p>
  <p>Phone (307) {{ phone_area_code }}-{{ phone_local }} FAX (307) {{ fax_area_code }}-{{ fax_local }}</p>
  <p><a href="{{ oia_email }}">{{ oia_email }}</a></p>
  <p><a href="{{ oia_website }}">{{ oia_website }}</a></p>
</div>

<div class="page">
  <h2 style="font-size: 16pt; text-align: center;">Table 1. Admission Status of First-Time, First-Year Applicants to UW Summer and Fall {{ year }}</h2>
  <h3 style="font-size: 14pt; text-align: center;">{{ high_school_name }}</h3>

  <table>
    <thead>
      <tr>
        <th style="width: 15%;">Admit</th>
        <th style="width: 15%;">Status</th>
        <th style="width: 20%;">Overall</th>
        <th style="width: 20%;">Out-of-State</th>
        <th style="width: 20%;">Wyoming</th>
        <th style="width: 10%;">Sample High School</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Admitted</td>
        <td>Assured</td>
        <td><span data-field="t1_overall_assured_num">{{ t1_overall_assured_num }}</span></td>
        <td><span data-field="t1_oos_assured_num">{{ t1_oos_assured_num }}</span></td>
        <td><span data-field="t1_wyoming_assured_num">{{ t1_wyoming_assured_num }}</span></td>
        <td><span data-field="t1_shs_assured_num">{{ t1_shs_assured_num }}</span></td>
      </tr>
      <tr>
        <td></td>
        <td>Admitted with Support</td>
        <td><span data-field="t1_overall_support_num">{{ t1_overall_support_num }}</span></td>
        <td><span data-field="t1_oos_support_num">{{ t1_oos_support_num }}</span></td>
        <td><span data-field="t1_wyoming_support_num">{{ t1_wyoming_support_num }}</span></td>
        <td><span data-field="t1_shs_support_num">{{ t1_shs_support_num }}</span></td>
      </tr>
      <tr>
        <td></td>
        <td>Not Declined</td>
        <td><span data-field="t1_overall_not_declined_num">{{ t1_overall_not_declined_num }}</span></td>
        <td><span data-field="t1_oos_not_declined_num">{{ t1_oos_not_declined_num }}</span></td>
        <td><span data-field="t1_wyoming_not_declined_num">{{ t1_wyoming_not_declined_num }}</span></td>
        <td><span data-field="t1_shs_not_declined_num">{{ t1_shs_not_declined_num }}</span></td>
      </tr>
      <tr>
        <td></td>
        <td>Incomplete</td>
        <td><span data-field="t1_overall_incomplete_num">{{ t1_overall_incomplete_num }}</span></td>
        <td><span data-field="t1_oos_incomplete_num">{{ t1_oos_incomplete_num }}</span></td>
        <td><span data-field="t1_wyoming_incomplete_num">{{ t1_wyoming_incomplete_num }}</span></td>
        <td><span data-field="t1_shs_incomplete_num">{{ t1_shs_incomplete_num }}</span></td>
      </tr>
      <tr>
        <td></td>
        <td>Unknown</td>
        <td><span data-field="t1_overall_unknown_num">{{ t1_overall_unknown_num }}</span></td>
        <td><span data-field="t1_oos_unknown_num">{{ t1_oos_unknown_num }}</span></td>
        <td><span data-field="t1_wyoming_unknown_num">{{ t1_wyoming_unknown_num }}</span></td>
        <td><span data-field="t1_shs_unknown_num">{{ t1_shs_unknown_num }}</span></td>
      </tr>
    </tbody>
  </table>
  <p style="font-size: 10pt;">Assured: Student meets minimum admission requirements.</p>
  <p style="font-size: 10pt;">Admitted with Support: Student participates in Synergy program or other academic transition programs to foster academic success.</p>
  <p style="font-size: 10pt;">Declined: Student may take hours at another school and reapply later (does not meet admit criteria).</p>
  <p style="font-size: 8pt; text-align: right;">Source: UW Student Information System (Banner)</p>
</div>

<div class="page">
  <h2 style="font-size: 16pt; text-align: center;">Table 2a. Retention & Graduation for First-Time, First-Year Full-Time Students 2003 - 2012</h2>

  <h3 style="font-size: 14pt; margin-top: 20px;">Overall</h3>
  <table>
    <thead>
      <tr>
        <th style="width: 10%;">Term</th>
        <th style="width: 10%;"># of Students</th>
        <th style="width: 10%;">Mean</th>
