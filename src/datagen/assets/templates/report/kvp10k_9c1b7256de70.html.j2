<div class="page">
  <h2 style="font-size: 16pt; text-align: center;">Table 4. List of Students from Wyoming High Schools, Fall {{ year }}</h2>
  <p style="font-size: 10pt;">All currently enrolled students at UW who are graduates of {{ high_school_name }}, their class, and their program.</p>
  <p style="font-size: 10pt;">Note: This list is not exclusively first-time, first-year students. It may contain upper-class students as well as graduate students.</p>

  <table>
    <thead>
      <tr>
        <th style="width: 15%;">Student Name</th>
        <th style="width: 15%;">Class</th>
        <th style="width: 20%;">Program</th>
        <th style="width: 50%;">Other Details</th>
      </tr>
    </thead>
    <tbody>
      {% for student in table_4_students %}
      <tr>
        <td><span data-field="t4_student_name[{{ loop.index0 }}]]">{{ student.name }}</span></td>
        <td><span data-field="t4_student_class[{{ loop.index0 }}]]">{{ student.class }}</span></td>
        <td><span data-field="t4_student_program[{{ loop.index0 }}]]">{{ student.program }}</span></td>
        <td><span data-field="t4_student_details[{{ loop.index0 }}]]">{{ student.details }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

<div class="page">
  <div class="center">
    <p>Produced by</p>
    <div style="margin-top: 20px;">
      <span data-field="oia_logo_footer">{{ oia_logo_footer }}</span>
    </div>
    <p style="margin-top: 50px;">May {{ year_month }}</p>
  </div>
</div>