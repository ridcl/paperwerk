                <p style="font-size: 14px; text-align: right; margin-top: 5px;">UNIVERSITY OF THE DISTRICT OF COLUMBIA</p>
                <p style="font-size: 10px; text-align: right;">1851</p>
            </div>
        </div>
    </div>
    <div style="text-align: center; margin-top: 40px;">
        <p style="font-size: 18px; font-weight: bold;">ASPIRE. ACCOMPLISH. TAKE ON THE WORLD.</p>
    </div>
</div>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
        <div style="width: 30%;">
            <img src="placeholder_image_5.jpg" alt="Student" style="width: 100%; height: auto;">
        </div>
        <div style="width: 70%;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                <div style="width: 45%;">
                    <h2 style="font-size: 24px; margin-bottom: 10px;">Contents</h2>
                    <div style="font-size: 14px;">
                        <p><span data-field="contents.message_from_president">{{ contents.message_from_president }}</span> . . . <span data-field="contents.page_1">{{ contents.page_1 }}</span></p>
