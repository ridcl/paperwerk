<!DOCTYPE html>
<html>
<head>
    <title>Document Conversion</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3, h4 { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif; }
        .header-image { width: 100%; height: auto; }
        .section-title { font-weight: bold; }
        .content-box { margin-top: 20px; }
        .two-column { display: flex; justify-content: space-between; }
        .column { width: 48%; }
        .centered-text { text-align: center; }
        .footer { margin-top: 50px; text-align: center; font-size: 0.9em; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        td { padding: 8px 0; }
    </style>

<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { font-weight: bold; }
  .header-title { font-size: 24pt; margin-bottom: 10px; }
  .subtitle { font-size: 14pt; margin-bottom: 30px; }
  .section-title { font-size: 16pt; font-weight: bold; margin-top: 30px; margin-bottom: 15px; }
  .data-point { font-size: 12pt; margin-bottom: 5px; }
  .chart-container { margin-top: 20px; }
  .legend-item { display: inline-block; margin-right: 20px; }
  .bar-chart-wrapper { height: 150px; margin-top: 20px; }
  .bar { height: 100%; transition: width 0.5s; }
  .text-block { font-size: 11pt; line-height: 1.5; }
  .footer { position: absolute; bottom: 50px; width: 100%; text-align: center; font-size: 10pt; color: #555; }
  .two-column-layout { display: flex; justify-content: space-between; margin-top: 40px; }
  .col-left { width: 48%; }
  .col-right { width: 48%; }
  .quote-box { border-left: 4px solid #ccc; padding-left: 20px; margin: 40px 0; font-style: italic; font-size: 14pt; }
  .financial-summary { display: flex; justify-content: space-around; margin-top: 30px; text-align: center; }
  .financial-box { padding: 20px; border: 1px solid #ddd; width: 45%; }
</style>
</head>
<body>

<div class="page">
    <img src="placeholder_image_1.jpg" alt="Building a National Model" class="header-image">
    <div style="padding-top: 30px;">
        <h1 style="font-size: 36px; margin-bottom: 5px;">Building a National Model</h1>
