<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child {
    page-break-after: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
    margin-bottom: 20px;
  }
  th, td {
    border: 1px solid #ccc;
    padding: 10px;
    text-align: left;
  }
  th {
    background-color: #f2f2f2;
    font-weight: bold;
  }
  h1, h2, h3 {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    font-weight: bold;
  }
  .chart-container {
    width: 100%;
    height: 300px; /* Placeholder for chart visualization */
    margin-top: 20px;
    display: flex;
    align-items: flex-end;
    border-left: 1px solid #ccc;
    border-bottom: 1px solid #ccc;
    padding-left: 10px;
  }
  .bar {
    width: 15%; /* Adjust based on number of categories */
    background-color: #4682b4; /* Example color */
    margin: 0 2%;
    transition: height 0.5s;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }
  .bar-label {
    position: absolute;
    bottom: -20px;
    font-size: 12px;
  }
  .pie-chart-container {
    width: 100%;
    height: 300px; /* Placeholder for chart visualization */
    margin-top: 20px;
    display: flex;
    justify-content: center;
    align-items: center;
  }
</style>

