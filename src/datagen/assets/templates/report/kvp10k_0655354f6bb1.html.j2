<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child {
    page-break-after: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  td, th {
    padding: 8px;
    text-align: left;
  }
  .header-title {
    font-size: 18pt;
    font-weight: bold;
    text-align: center;
    margin-bottom: 5px;
  }
  .sub-header {
    font-size: 12pt;
    font-weight: normal;
    text-align: center;
    margin-bottom: 20px;
  }
  .section-title {
    font-size: 14pt;
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  .data-table td {
    padding: 5px 10px;
  }
  .right-aligned {
    text-align: right;
  }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      <div class="header-title">OSHA's Form 300A (Rev. 01/2004)</div>
      <div class="sub-header">Summary of Work-Related Injuries and Illnesses</div>
    </div>
    <div style="text-align: right;">
      <div style="font-size: 12pt; font-weight: bold;">Year {{ year }}</div>
      <div style="font-size: 10pt;">U.S. Department of Labor</div>
      <div style="font-size: 10pt;">Occupational Safety and Health Administration</div>
      <div style="font-size: 9pt; margin-top: 10px;">Form approved OMB no. {{ omb_number }}</div>
    </div>
  </div>

  <p style="font-size: 10pt; margin-top: 20px;">All establishments covered by Part 1904 must complete this Summary page, even if no work-related injuries or illnesses occurred during the year. Using the Log, count the individual entries you made in each category. Then write the total below, making sure you've added the entries from every page of the Log. If you had no cases write "0".</p>
  <p style="font-size: 10pt;">Using the Log, count the individual entries you made in each category. Then write the total below, making sure you've added the entries from every page of the Log. If you had no cases write "0".</p>

  <div style="display: flex; justify-content: space-between; margin-top: 30px;">
    <div style="width: 48%;">
      <div class="section-title">Number of Cases</div>
      <table class="data-table">
        <thead>
          <tr>
            <th style="width: 25%;">Total number of deaths</th>
            <th style="width: 25%;">Total number of cases away from work</th>
            <th style="width: 25%;">Total number of cases with days transfer or restriction</th>
            <th style="width: 25%;">Total number of other recordable cases</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><span data-field="number_of_cases.deaths">{{ number_of_cases.deaths }}</span></td>
            <td><span data-field="number_of_cases.away_from_work">{{ number_of_cases.away_from_work }}</span></td>
            <td><span data-field="number_of_cases.transfer_restriction">{{ number_of_cases.transfer_restriction }}</span></td>
            <td><span data-field="number_of_cases.other_recordable">{{ number_of_cases.other_recordable }}</span></td>
          </tr>
        </tbody>
      </table>
    </div>
    <div style="width: 48%;">
      <div class="section-title">Establishment Information</div>
      <table class="data-table">
        <tr>
          <td style="width: 20%;">Establishment name</td>
          <td style="width: 80%;"><span data-field="establishment.name">{{ establishment.name }}</span></td>
        </tr>
        <tr>
          <td>Address</td>
          <td><span data-field="establishment.address">{{ establishment.address }}</span></td>
        </tr>
        <tr>
          <td>City</td>
          <td><span data-field="establishment.city">{{ establishment.city }}</span></td>
        </tr>
        <tr>
          <td>State</td>
          <td><span data-field="establishment.state">{{ establishment.state }}</span></td>
        </tr>
        <tr>
          <td>Zip</td>
          <td><span data-field="establishment.zip">{{ establishment.zip }}</span></td>
        </tr>
        <tr>
          <td>Industry Description</td>
          <td><span data-field="establishment.industry_description">{{ establishment.industry_description }}</span></td>
        </tr>
        <tr>
          <td>Standard Industry Classification (SIC)</td>
          <td><span data-field="establishment.sic">{{ establishment.sic }}</span></td>
        </tr>
        <tr>
          <td>North American Industrial Classification (NAICS), if known</td>
          <td><span data-field="establishment.naics">{{ establishment.naics }}</span></td>
        </tr>
      </table>
    </div>
  </div>

  <div style="display: flex; justify-content: space-between; margin-top: 30px;">
    <div style="width: 48%;">
      <div class="section-title">Number of Days</div>
      <table class="data-table">
        <thead>
          <tr>
            <th style="width: 25%;">Total number of days away from work</th>
            <th style="width: 25%;">Total number of days with job transfer or restriction</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><span data-field="number_of_days.away_from_work">{{ number_of_days.away_from_work }}</span></td>
            <td><span data-field="number_of_days.transfer_restriction">{{ number_of_days.transfer_restriction }}</span></td>
          </tr>
        </tbody>
      </table>
    </div>
    <div style="width: 48%;">
      <div class="section-title">Employment Information</div>
      <table class="data-table">
        <tr>
          <td>Annual average number of employees</td>
          <td class="right-aligned"><span data-field="employment.average_employees">{{ employment.average_employees }}</span></td>
        </tr>
        <tr>
          <td>Total hours worked by all employees last year</td>
          <td class="right-aligned"><span data-field="employment.total_hours_worked">{{ employment.total_hours_worked }}</span></td>
        </tr>
      </table>
    </div>
  </div>

  <div style="margin-top: 30px;">
    <div class="section-title">Injury and Illness Types</div>
    <table class="data-table">
      <thead>
        <tr>
          <th style="width: 25%;">Total number of ...</th>
          <th style="width: 25%;"></th>
          <th style="width: 25%;"></th>
          <th style="width: 25%;"></th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><span data-field="injury_illness_types.total_number">{{ injury_illness_types.total_number }}</span> (M)</td>
          <td><span data-field="injury_illness_types.injuries">{{ injury_illness_types.injuries }}</span> (1) Injuries</td>
          <td><span data-field="injury_illness_types.poisonings">{{ injury_illness_types.poisonings }}</span> (4) Poisonings</td>
          <td><span data-field="injury_illness_types.hearing_loss">{{ injury_illness_types.hearing_loss }}</span> (5) Hearing loss</td>
        </tr>
        <tr>
          <td><span data-field="injury_illness_types.skin_disorders">{{ injury_illness_types.skin_disorders }}</span> (2) Skin disorders</td>
          <td><span data-field="injury_illness_types.other_illnesses">{{ injury_illness_types.other_illnesses }}</span> (6) All other illnesses</td>
          <td></td>
          <td></td>
        </tr>
        <tr>
          <td><span data-field="injury_illness_types.respiratory_conditions">{{ injury_illness_types.respiratory_conditions }}</span> (3) Respiratory conditions</td>
          <td></td>
          <td></td>
          <td></td>
        </tr>
      </tbody>
    </table>
  </div>

  <div style="display: flex; justify-content: space-between; margin-top: 40px;">
    <div style="width: 48%;">
      <div class="section-title">Sign Here</div>
      <p style="font-size: 10pt;">I certify that I have examined this document and that to the best of my knowledge the entries are true, accurate and complete</p>
      <div style="margin-top: 40px;">
        <div style="width: 40%; float: left;">
          <p style="font-size: 10pt;">Company Executive</p>
          <div style="height: 50px; border-bottom: 1px solid #000; margin-top: 5px;"></div>
        </div>
        <div style="width: 40%; float: right;">
          <p style="font-size: 10pt;">Workers' Compensation Coordinator</p>
          <div style="height: 50px; border-bottom: 1px solid #000; margin-top: 5px;"></div>
        </div>
      </div>
    </div>
    <div style="width: 48%; text-align: right;">
      <p style="font-size: 10pt;">Date:</p>
      <div style="font-size: 10pt;">{{ date_executive }}</div>
      <p style="font-size: 10pt;">Date:</p>
      <div style="font-size: 10pt;">{{ date_coordinator }}</div>
    </div>
  </div>

  <div style="margin-top: 50px; display: flex; justify-content: space-between; font-size: 9pt;">
    <div>
      <span data-field="document_footer_text">{{ document_footer_text }}</span>
    </div>
    <div>
      <div style="text-align: right;">
        <span data-field="document_footer_page_info">{{ document_footer_page_info }}</span>
      </div>
    </div>
  </div>
</div>