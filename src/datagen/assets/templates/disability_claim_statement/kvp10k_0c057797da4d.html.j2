    <div class="contact-box">
      <p><strong>By fax</strong></p>
      <p>Short-Term Disability Claims: <span data-field="fax_number_std">{{ fax_number_std }}</span><br>
      Long-Term Disability Claims: <span data-field="fax_number_ltd">{{ fax_number_ltd }}</span></p>
