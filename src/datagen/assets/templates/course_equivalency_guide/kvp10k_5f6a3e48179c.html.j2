<!DOCTYPE html>
<html>
<head>
<title>Course Equivalency Guide</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
    margin-bottom: 15px;
  }
  th, td {
    border: 1px solid #ccc;
    padding: 8px;
    text-align: left;
  }
  th {
    background-color: #f2f2f2;
    font-weight: bold;
  }
  .header-title {
    text-align: center;
    font-size: 24pt;
    margin-bottom: 10px;
    font-weight: bold;
  }
  .subtitle {
    text-align: center;
    font-size: 12pt;
    margin-bottom: 30px;
  }
  .section-title {
    font-size: 16pt;
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
  }
  .note {
    font-size: 10pt;
    margin-bottom: 15px;
    color: #555;
  }
</style>

<style>
