    </tbody>
  </table>

  <div class="section-title">THEA</div>
  <table>
    <thead>
      <tr class="header-row">
        <th style="width: 20%;">THEA</th>
        <th style="width: 50%;">Theater</th>
        <th style="width: 30%;">Eureka College Equivalent</th>
        <th style="width: 20%;">Credits</th>
      </tr>
    </thead>
    <tbody>
      {% for item in thea_courses %}
      <tr>
        <td><span data-field="thea_courses[{{ loop.index0 }}].code">{{ item.code }}</span></td>
        <td><span data-field="thea_courses[{{ loop.index0 }}].description">{{ item.description }}</span></td>
        <td><span data-field="thea_courses[{{ loop.index0 }}].equivalent">{{ item.equivalent }}</span></td>
        <td><span data-field="thea_courses[{{ loop.index0 }}].credits">{{ item.credits }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="section-title">WELD</div>
  <p style="font-size: 10pt;">The following courses are not transferable: <span data-field="weld_courses">{{ weld_courses }}</span></p>

</div>
<div class="page">
  <div style="text-align: right; font-size: 10pt;">10 | Page</div>
</div>
<div class="page">
  <div style="text-align: right; font-size: 10pt;">11 | Page</div>
</div>
</body>
</html>