<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    color: #000;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  td, th {
    padding: 8px 0;
    text-align: left;
  }
  .header-section {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 30px;
  }
  .logo-area {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .title-area {
    text-align: right;
  }
  .form-group {
    margin-bottom: 15px;
  }
  .full-width-box {
    width: 100%;
    height: 150px;
    border: 1px solid #ccc;
    padding: 10px;
    box-sizing: border-box;
    margin-top: 10px;
  }
</style>

<div class="page">
  <div class="header-section">
    <div class="logo-area">
      <div>
        <span style="font-size: 24px; font-weight: bold;">LSU</span>
        <div style="margin-top: 5px;">College of Science</div>
        <div style="font-size: 16px;">Department of Physics & Astronomy</div>
      </div>
    </div>
    <div class="title-area">
      <h2 style="font-size: 18px;">Peer Teaching Evaluation Form</h2>
      <div class="form-group">
        Evaluation: <span data-field="evaluation_type">{{ evaluation_type }}</span>
      </div>
      <div class="form-group">
        Date: <span data-field="evaluation_date">{{ evaluation_date }}</span>
      </div>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <div style="display: flex; justify-content: space-between;">
      <div>
        Instructor Name: <span data-field="instructor_name">{{ instructor_name }}</span>
      </div>
      <div>
        Course Number/Section: <span data-field="course_number_section">{{ course_number_section }}</span>
      </div>
    </div>
  </div>

  <table>
    <thead>
      <tr>
        <th style="width: 50%;">Criterion</th>
        <th style="width: 25%; text-align: center;">Meets Expectation</th>
        <th style="width: 25%;">Comments</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Syllabus provides course policies, grading scale, office hours, and other information</td>
        <td></td>
        <td></td>
      </tr>
      <tr>
        <td>Provides class announcements, as needed (e.g., updates to lecture schedule)</td>
        <td></td>
        <td></td>
      </tr>
      <tr>
        <td>Provides lecture content in a logical order, at an appropriate level that should be easily understood</td>
        <td></td>
        <td></td>
      </tr>
      <tr>
        <td>Demonstrates command of the material, e.g., answers questions knowledgeably</td>
        <td></td>
        <td></td>
      </tr>
      <tr>
        <td>Appears familiar with lecture content, e.g., familiar with sequence of PPT slides</td>
        <td></td>
        <td></td>
      </tr>
      <tr>
        <td>Lecture materials, e.g., PowerPoint or handouts, are generally appropriate and free from errors</td>
        <td></td>
        <td></td>
      </tr>
      <tr>
        <td>Makes an effort to engage students (questions, demos, discussion, etc.)</td>
        <td></td>
        <td></td>
      </tr>
      <tr>
        <td>Makes an effort to keep students' attention (e.g., eye contact, speaks towards students rather than towards board/screen)</td>
        <td></td>
        <td></td>
      </tr>
      <tr>
        <td>Handles interruptions effectively</td>
        <td></td>
        <td></td>
      </tr>
      <tr>
        <td>Handles time constraints effectively; keeps the lecture on pace</td>
        <td></td>
        <td></td>
      </tr>
    </tbody>
  </table>

  <div style="margin-top: 30px;">
    <h3 style="font-size: 16px; font-weight: bold;">Overall Assessment</h3>
    <div class="full-width-box">
      <!-- Placeholder for overall assessment content -->
    </div>
  </div>

  <div style="margin-top: 30px;">
    <h3 style="font-size: 16px; font-weight: bold;">Additional items to note:</h3>
    <ul style="list-style-type: disc; padding-left: 20px;">
      <li><span data-field="additional_note_1">{{ additional_note_1 }}</span></li>
      <li><span data-field="additional_note_2">{{ additional_note_2 }}</span></li>
      <li><span data-field="additional_note_3">{{ additional_note_3 }}</span></li>
    </ul>
  </div>

  <div style="margin-top: 30px;">
    <h3 style="font-size: 16px; font-weight: bold;">General Comments:</h3>
    <div class="full-width-box">
      <!-- Placeholder for general comments -->
    </div>
  </div>

  <div style="margin-top: 50px; text-align: right; font-size: 12px;">
    Rev. <span data-field="revision_date">{{ revision_date }}</span>
  </div>
</div>