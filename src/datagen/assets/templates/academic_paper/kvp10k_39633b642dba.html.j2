<!DOCTYPE html>
<html>
<head>
<title>Document</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    line-height: 1.5;
  }
</style>
</head>
<body>
<div class="page">
  <header style="text-align: center; margin-bottom: 20px;">
    <h1 style="font-size: 24pt; margin: 0;">{{ full_name }}</h1>
    <p style="font-size: 12pt; margin-top: 5px;">{{ title }}</p>
    <p style="font-size: 10pt; margin-top: 2px;">({{ date_of_document }})</p>
  </header>

  <section style="margin-bottom: 30px;">
    <h2 style="font-size: 14pt; font-weight: bold; margin-bottom: 10px;">BUSINESS ADDRESS</h2>
    <p style="margin: 0;">Department of Information Technology and Operations Management</p>
    <p style="margin: 0;">{{ employer.name }}</p>
    <p style="margin: 0;">{{ employer.address_line_1 }}</p>
    <p style="margin: 0;">{{ employer.address_line_2 }}</p>
    <p style="margin: 0;">{{ employer.zip_code }}</p>
    <p style="margin: 0;">{{ employer.city_state }}</p>
    <p style="margin: 0;">Phone: {{ employer.phone }}</p>
    <p style="margin: 0;">Email: {{ employer.email }}</p>
  </section>

  <section style="margin-bottom: 30px;">
    <h2 style="font-size: 14pt; font-weight: bold; margin-bottom: 10px;">EDUCATION</h2>
    <ul style="list-style-type: none; padding-left: 0;">
      {% for edu in education %}
      <li style="margin-bottom: 10px;">
        <span style="font-weight: bold;">{{ edu.degree }}</span>, {{ edu.major }}, {{ edu.institution }}, {{ edu.graduation_year }}.
      </li>
      {% endfor %}
    </ul>
  </section>

  <section style="margin-bottom: 30px;">
    <h2 style="font-size: 14pt; font-weight: bold; margin-bottom: 10px;">REFEREED JOURNAL ARTICLES</h2>
    <ul style="list-style-type: disc; padding-left: 20px;">
      {% for article in publications %}
      <li style="margin-bottom: 10px;">
        "{{ article.title }}" with {{ article.co_authors }}. {{ article.journal }}, Vol. {{ article.volume }}, No. {{ article.issue }}, pp. {{ article.pages }} ({{ article.year }}).
        {% if article.doi %}
        <br><span style="font-size: 9pt;">({{ article.doi }})</span>
        {% endif %}
      </li>
      {% endfor %}
    </ul>
  </section>

  <section style="margin-bottom: 30px;">
    <h2 style="font-size: 14pt; font-weight: bold; margin-bottom: 10px;">WORK IN PROGRESS</h2>
    <ul style="list-style-type: disc; padding-left: 20px;">
      {% for wip in work_in_progress %}
      <li style="margin-bottom: 10px;">"{{ wip.title }}"</li>
      {% endfor %}
    </ul>
  </section>

  <section style="margin-bottom: 30px;">
    <h2 style="font-size: 14pt; font-weight: bold; margin-bottom: 10px;">EDITORIAL BOARDS</h2>
    <ul style="list-style-type: disc; padding-left: 20px;">
      {% for board in editorial_boards %}
      <li style="margin-bottom: 5px;">{{ board.role }} at {{ board.journal }} ({{ board.years }}).</li>
      {% endfor %}
    </ul>
  </section>

  <section style="margin-bottom: 30px;">
    <h2 style="font-size: 14pt; font-weight: bold; margin-bottom: 10px;">ACADEMIC POSITIONS AND EMPLOYMENT</h2>
    <ul style="list-style-type: none; padding-left: 0;">
      {% for position in employment_history %}
      <li style="margin-bottom: 15px;">
        <span style="font-weight: bold;">{{ position.title }}</span>, {{ position.institution }} ({{ position.years }}).
        {% if position.details %}
        <p style="margin: 2px 0 0 15px; font-size: 10pt;">{{ position.details }}</p>
        {% endif %}
      </li>
      {% endfor %}
    </ul>
  </section>

  <section style="margin-bottom: 30px;">
    <h2 style="font-size: 14pt; font-weight: bold; margin-bottom: 10px;">HONORS, AWARDS, FELLOWSHIPS (SMU)</h2>
    <ul style="list-style-type: disc; padding-left: 20px;">
      {% for honor in honors_awards %}
      <li style="margin-bottom: 5px;">{{ honor.year }}: {{ honor.description }}</li>
      {% endfor %}
    </ul>
  </section>

  <section style="margin-bottom: 30px;">
    <h2 style="font-size: 14pt; font-weight: bold; margin-bottom: 10px;">COMMITTEES AND SERVICE</h2>
    <ul style="list-style-type: disc; padding-left: 20px;">
      {% for service in service_history %}
      <li style="margin-bottom: 5px;">{{ service.description }} ({{ service.years }}).</li>
      {% endfor %}
    </ul>
  </section>

</div>
<div class="page">
  <div style="text-align: center; margin-top: 50px;">
    <p style="font-size: 10pt;">1</p>
  </div>
</div>
</body>
</html>