<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 15px; }
  .form-group { display: flex; align-items: center; margin-bottom: 10px; }
  .form-group label { margin-right: 10px; font-weight: bold; }
  .input-field { border-bottom: 1px solid #000; flex-grow: 1; margin-left: 10px; }
  .checkbox-group { display: flex; gap: 20px; }
  .signature-line { border-bottom: 1px solid #000; margin-top: 50px; width: 300px; }
</style>

<div class="page">
  <div style="text-align: center; margin-bottom: 40px;">
    <h1 style="font-size: 36pt; margin: 0;">Augustana College</h1>
    <h2 style="font-size: 20pt; margin-top: 10px;">ACH Authorization Form</h2>
  </div>

  <p style="margin-bottom: 30px; font-size: 11pt;">
    I authorize and request Augustana to deposit funds due me to my bank account identified below. This authorization will remain in effect unless canceled in writing. <span style="font-weight: bold;">I understand that a pre-note must be initiated at least ten (10) days in advance of my first payroll deposit.</span>
  </p>

  <div class="form-row">
    <div style="width: 45%;">
      <p style="margin-bottom: 5px;">Name (Please Print):</p>
      <div class="input-field" style="border-bottom: 1px solid #000;">
        <span data-field="full_name">{{ full_name }}</span>
      </div>
    </div>
    <div style="width: 45%; text-align: right;">
      <p style="margin-bottom: 5px;">Augustana ID Number</p>
      <div class="input-field" style="border-bottom: 1px solid #000; width: 200px; text-align: right;">
        <span data-field="augustana_id">{{ augustana_id }}</span>
      </div>
    </div>
  </div>

  <h3 style="margin-top: 30px; margin-bottom: 15px;">Purpose of Authorization</h3>
  <div class="form-row" style="margin-bottom: 20px;">
    <div class="checkbox-group">
      <div class="form-group">
        <input type="checkbox" id="new_auth" name="purpose" value="new">
        <label for="new_auth">New Authorization</label>
      </div>
      <div class="form-group">
        <input type="checkbox" id="change_auth" name="purpose" value="change">
        <label for="change_auth">Changes to existing Authorization</label>
      </div>
      <div class="form-group">
        <input type="checkbox" id="cancel_auth" name="purpose" value="cancel">
        <label for="cancel_auth">Cancellation</label>
      </div>
    </div>
  </div>

  <h3 style="margin-top: 30px; margin-bottom: 15px;">Primary Account</h3>
  <div class="form-row">
    <div class="form-group">
      <label>Select one:</label>
      <div class="checkbox-group">
        <div class="form-group">
          <input type="checkbox" id="primary_checking" name="primary_type" value="checking">
          <label for="primary_checking">Checking</label>
        </div>
        <div class="form-group">
          <input type="checkbox" id="primary_savings" name="primary_type" value="savings">
          <label for="primary_savings">Savings</label>
        </div>
      </div>
    </div>
  </div>

  <div style="display: flex; justify-content: space-between; margin-top: 20px;">
    <div style="width: 45%;">
      <p style="margin-bottom: 5px;">Name of Financial Institution</p>
      <div class="input-field" style="border-bottom: 1px solid #000;">
        <span data-field="primary_bank_name">{{ primary_bank_name }}</span>
      </div>
    </div>
    <div style="width: 45%; text-align: right;">
      <p style="margin-bottom: 5px;">Account No.</p>
      <div class="input-field" style="border-bottom: 1px solid #000; width: 200px; text-align: right;">
        <span data-field="primary_account_number">{{ primary_account_number }}</span>
      </div>
    </div>
  </div>

  <div class="form-row" style="margin-top: 15px;">
    <div style="width: 45%;">
      <p style="margin-bottom: 5px;">Bank Routing No.</p>
      <div class="input-field" style="border-bottom: 1px solid #000;">
        <span data-field="primary_routing_number">{{ primary_routing_number }}</span>
      </div>
    </div>
    <div style="width: 45%; text-align: right;">
      <p style="margin-bottom: 5px;">Check Number</p>
      <div class="input-field" style="border-bottom: 1px solid #000; width: 200px; text-align: right;">
        <span data-field="primary_check_number">{{ primary_check_number }}</span>
      </div>
    </div>
  </div>

  <p style="margin-top: 20px; font-size: 11pt;">
    Payroll Deposits Only: If you want your check divided into two separate accounts clarify allocation to Primary Account. Amount: $ <span data-field="primary_split_amount">{{ primary_split_amount }}</span>
  </p>

  <h3 style="margin-top: 30px; margin-bottom: 15px;">Secondary Account (Optional for remainder of payroll check.)</h3>
  <div class="form-row">
    <div class="form-group">
      <label>Select one:</label>
      <div class="checkbox-group">
        <div class="form-group">
          <input type="checkbox" id="secondary_checking" name="secondary_type" value="checking">
          <label for="secondary_checking">Checking</label>
        </div>
        <div class="form-group">
          <input type="checkbox" id="secondary_savings" name="secondary_type" value="savings">
          <label for="secondary_savings">Savings</label>
        </div>
      </div>
    </div>
  </div>

  <div style="display: flex; justify-content: space-between; margin-top: 20px;">
    <div style="width: 45%;">
      <p style="margin-bottom: 5px;">Name of Financial Institution</p>
      <div class="input-field" style="border-bottom: 1px solid #000;">
        <span data-field="secondary_bank_name">{{ secondary_bank_name }}</span>
      </div>
    </div>
    <div style="width: 45%; text-align: right;">
      <p style="margin-bottom: 5px;">Account No.</p>
      <div class="input-field" style="border-bottom: 1px solid #000; width: 200px; text-align: right;">
        <span data-field="secondary_account_number">{{ secondary_account_number }}</span>
      </div>
    </div>
  </div>

  <div class="form-row" style="margin-top: 15px;">
    <div style="width: 45%;">
      <p style="margin-bottom: 5px;">Bank Routing No.</p>
      <div class="input-field" style="border-bottom: 1px solid #000;">
        <span data-field="secondary_routing_number">{{ secondary_routing_number }}</span>
      </div>
    </div>
    <div style="width: 45%; text-align: right;">
      <p style="margin-bottom: 5px;">Account No.</p>
      <div class="input-field" style="border-bottom: 1px solid #000; width: 200px; text-align: right;">
        <span data-field="secondary_account_number_2">{{ secondary_account_number_2 }}</span>
      </div>
    </div>
  </div>

  <div style="margin-top: 60px;">
    <div style="display: flex; justify-content: space-between;">
      <div style="width: 50%;">
        <p style="margin-bottom: 5px;">Signature</p>
        <div class="signature-line" data-field="signature">{{ signature }}</div>
      </div>
      <div style="width: 50%; text-align: right;">
        <p style="margin-bottom: 5px;">Date</p>
        <div class="signature-line" style="width: 150px;" data-field="date">{{ date }}</div>
      </div>
    </div>
  </div>

  <p style="margin-top: 50px; font-size: 10pt;">
    *Please attach a voided check or a copy of a voided check if possible.*
  </p>
  <p style="font-size: 10pt;">
    Return to: Augustana College Payroll Office, Sorenson Hall, 639 38th Street, Rock Island, IL 61265
  </p>
  <p style="text-align: right; font-size: 9pt; margin-top: 50px;">
    Revised 4.21.21
  </p>
</div>