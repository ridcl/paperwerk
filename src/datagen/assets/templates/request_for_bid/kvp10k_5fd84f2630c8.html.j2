<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RFB Bid Document</title>
<style>
  @page { size: A4; margin: 0; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: "Liberation Sans", Arial, Helvetica, sans-serif; font-size: 10px; color: #000; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }

  /* Page 1 */
  .header-center { text-align: center; margin-bottom: 10px; }
  .org-logo-text { font-family: "Liberation Serif", Georgia, serif; font-size: 22px; font-weight: bold; color: #1a3a6b; letter-spacing: 1px; }
  .org-tagline { font-size: 9px; letter-spacing: 2px; color: #333; margin-bottom: 4px; }
  .org-dept { font-weight: bold; font-size: 10px; margin-bottom: 2px; }
  .org-address { font-size: 10px; line-height: 1.5; }
  .org-link { color: #1a3a6b; text-decoration: underline; font-size: 10px; }

  .info-table { width: 100%; border-collapse: collapse; margin: 14px 0; }
  .info-table td { border: 1px solid #999; padding: 4px 8px; font-size: 10px; }
  .info-table td:first-child { background-color: #f5e642; font-weight: bold; width: 38%; }
  .info-table td:last-child { font-weight: bold; }

  .section-title { font-weight: bold; text-align: center; font-size: 11px; margin: 14px 0 6px 0; text-decoration: underline; }
  .body-text { font-size: 9.5px; line-height: 1.5; margin-bottom: 8px; text-align: justify; }
  .body-text-underline { text-decoration: underline; }
  .red-text { color: #cc0000; font-size: 9.5px; line-height: 1.5; text-align: justify; }

  .page-footer { position: absolute; bottom: 30px; left: 60px; right: 60px; display: flex; justify-content: space-between; font-size: 9px; }

  /* Pages 2-5 Terms */
  .terms-title { font-weight: bold; font-size: 10px; margin-bottom: 10px; }
  .two-col { display: flex; gap: 24px; }
  .col { flex: 1; }
  .term-item { margin-bottom: 10px; font-size: 9.5px; line-height: 1.5; text-align: justify; }
  .term-item .term-label { font-weight: bold; }

  /* Insurance table */
  .ins-table { width: 100%; font-size: 9.5px; margin: 6px 0 10px 0; border-collapse: collapse; }
  .ins-table td { padding: 1px 4px; vertical-align: top; }
  .ins-table td:first-child { width: 55%; }

  /* Page 6 - Bid Response */
  .bid-response-title { text-align: center; font-size: 11px; font-weight: bold; margin-bottom: 2px; }
  .bid-response-sub { text-align: center; font-size: 10px; margin-bottom: 2px; }
  .bid-response-note { text-align: center; font-size: 9.5px; font-style: italic; margin-bottom: 14px; }
  .field-line { display: inline-block; border-bottom: 1px solid #000; min-width: 200px; }
  .vendor-field-row { margin-bottom: 10px; font-size: 10px; }
  .delivery-note { color: #cc0000; font-size: 10px; margin: 10px 0; }
  .delivery-note span { text-decoration: underline; }

  .line-items-title { text-align: center; font-weight: bold; font-size: 11px; margin: 10px 0 4px 0; }
  .line-items-table { width: 100%; border-collapse: collapse; font-size: 9.5px; }
  .line-items-table th { border: 1px solid #000; padding: 4px 6px; font-style: italic; font-weight: bold; text-align: left; }
  .line-items-table td { border: 1px solid #000; padding: 4px 6px; vertical-align: top; }
  .line-items-table .total-row td { font-weight: bold; }

  /* Page 7 - Acknowledgment */
  .ack-text { font-size: 10px; line-height: 1.5; margin-bottom: 16px; }
  .addendum-row { display: flex; gap: 20px; margin-bottom: 16px; font-size: 10px; }
  .addendum-item { display: flex; align-items: center; gap: 4px; }
  .sig-row { display: flex; gap: 40px; margin-bottom: 14px; font-size: 10px; }
  .sig-field { flex: 1; }
  .sig-line { border-bottom: 1px solid #000; min-width: 180px; display: inline-block; }
  .sig-label { font-size: 10px; margin-top: 2px; }

  /* Page 8 - Attachment A */
  .att-title { text-align: center; font-weight: bold; font-size: 12px; margin-bottom: 10px; }
  .att-subtitle { text-align: center; font-size: 11px; margin-bottom: 2px; }
  .att-note { text-align: center; font-size: 9.5px; font-style: italic; margin-bottom: 14px; }
  .att-section { margin-bottom: 12px; font-size: 9.5px; line-height: 1.5; text-align: justify; }
  .att-section .att-label { font-weight: bold; }
  .sig-block { margin-top: 30px; }
  .sig-block-row { display: flex; gap: 40px; margin-bottom: 20px; }
  .sig-block-field { flex: 1; border-bottom: 1px solid #000; padding-bottom: 2px; }
  .sig-block-label { font-size: 10px; margin-top: 2px; }
  .sig-full-line { border-bottom: 1px solid #000; margin-bottom: 4px; }
</style>

<style>
  @page { size: A4; margin: 0; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: "Liberation Sans", "DejaVu Sans", Arial, Helvetica, sans-serif; font-size: 9px; color: #000; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  .page-header-title {
    text-align: center;
    font-weight: bold;
    font-size: 12px;
    margin-bottom: 6px;
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
  }
  .page-sub-title {
    text-align: center;
    font-weight: bold;
    font-size: 12px;
    margin-bottom: 20px;
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
  }
  .section-heading {
    text-align: center;
    font-weight: bold;
    font-size: 9.5px;
    margin-bottom: 8px;
  }
  .intro-text {
    font-size: 8.8px;
    text-align: justify;
    line-height: 1.45;
    margin-bottom: 14px;
  }
  .provisions-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 4px;
  }
  .provisions-table th {
    font-weight: bold;
    font-size: 9.5px;
    text-align: left;
    padding: 2px 4px 4px 0;
    vertical-align: bottom;
  }
  .provisions-table td {
    font-size: 8.8px;
    text-align: left;
    padding: 1px 4px 1px 0;
    vertical-align: top;
    line-height: 1.35;
  }
  .col-title { width: 38%; }
  .col-applicability { width: 35%; }
