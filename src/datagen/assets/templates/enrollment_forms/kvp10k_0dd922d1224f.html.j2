<!DOCTYPE html>
<html>
<head>
<title>RSA-1 Forms</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  .header-logo { text-align: center; margin-bottom: 20px; }
  .header-logo img { max-width: 200px; height: auto; }
  .title { text-align: center; font-size: 24pt; margin-bottom: 10px; }
  .subtitle { text-align: center; font-size: 14pt; margin-bottom: 30px; }
  .section-title { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
  .form-row { display: flex; margin-bottom: 10px; }
  .form-row > div { flex: 1; padding: 5px 0; }
  .form-label { font-weight: normal; display: block; margin-bottom: 3px; font-size: 10pt; }
  .input-field { border-bottom: 1px solid #000; width: 100%; box-sizing: border-box; }
  .signature-area { margin-top: 50px; }
  .signature-line { border-bottom: 1px solid #000; width: 50%; margin-top: 30px; }
  .checkbox-group label { margin-right: 15px; }
  .disclaimer { font-size: 9pt; margin-top: 20px; line-height: 1.4; }
</style>
</head>
<body>

<div class="page">
  <div class="header-logo">
    <!-- Placeholder for RSA-I Logo -->
    <span style="font-size: 40pt; font-weight: bold;">RSA-I</span>
    <div style="font-size: 18pt; font-weight: normal;">OF ALABAMA</div>
  </div>
  <div class="title">RSA-I Deferred Compensation Plan</div>
  <div class="subtitle">
    P.O. Box {{ employer.address_line_1 }}<br>
    {{ employer.city }}, {{ employer.state }} {{ employer.zip_code }}<br>
    {{ employer.phone }} or {{ employer.phone_alt }}<br>
    <span data-field="employer.website">{{ employer.website }}</span>
  </div>

  <div class="section-title">Enrollment Forms</div>
  <ul>
    <li>RSA-1 Enrollment (Submit to RSA-1)</li>
    <li>Beneficiary Designation (Submit to RSA-1) — Can also be used for change of beneficiary.</li>
    <li>Investment Option Election For New Accounts (Submit to RSA-1)</li>
    <li>Authorization to Defer Compensation (Submit to your payroll office)</li>
  </ul>
</div>

<div class="page">
  <div class="header-logo">
    <!-- Placeholder for RSA-I Logo -->
    <span style="font-size: 40pt; font-weight: bold;">RSA-I</span>
    <div style="font-size: 18pt; font-weight: normal;">OF ALABAMA</div>
  </div>
  <div class="section-title">RSA-1 Deferred Compensation Plan Enrollment</div>

  <div class="section-title">Your Information</div>
  <div class="form-row">
    <div style="flex: 2;">
      <label class="form-label">Name</label>
      <div class="form-row">
        <div style="flex: 1;"><label class="form-label">First</label><div class="input-field"></div></div>
        <div style="flex: 1;"><label class="form-label">Middle/Maiden</label><div class="input-field"></div></div>
        <div style="flex: 1;"><label class="form-label">Last</label><div class="input-field"></div></div>
      </div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">City</label><div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">State</label><div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">ZIP Code</label><div class="input-field"></div>
    </div>
  </div>

  <div class="form-row">
    <div style="flex: 1;">
      <label class="form-label">Address</label>
      <div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">Street or P.O. Box</label>
      <div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">City</label><div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">State</label><div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">ZIP Code</label><div class="input-field"></div>
    </div>
  </div>

  <div class="form-row">
    <div style="flex: 1;">
      <label class="form-label">Telephone Number</label>
      <div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">Email Address</label>
      <div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">Date of Birth</label>
      <div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">Sex</label>
      <div class="checkbox-group">
        <label><input type="radio" name="sex"> Male</label>
        <label><input type="radio" name="sex"> Female</label>
      </div>
    </div>
  </div>

  <div class="section-title">Employer Information</div>
  <div class="form-row">
    <div style="flex: 1;">
      <label class="form-label">Employer</label>
      <div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">Agency Name</label>
      <div class="input-field"></div>
    </div>
  </div>

  <div class="form-row">
    <div style="flex: 1;">
      <label class="form-label">Address</label>
      <div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">Street or P.O. Box</label>
      <div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">City</label><div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">State</label><div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">ZIP Code</label><div class="input-field"></div>
    </div>
  </div>

  <div class="form-row">
    <div style="flex: 1;">
      <label class="form-label">Telephone Number</label>
      <div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">Email Address</label>
      <div class="input-field"></div>
    </div>
  </div>

  <div class="section-title">My current status is:</div>
  <div class="checkbox-group" style="margin-bottom: 20px;">
    <label><input type="checkbox"> Employees' Retirement System (ERS) member</label>
    <label><input type="checkbox"> Teachers' Retirement System (TRS) member</label>
    <label><input type="checkbox"> Judicial Retirement Fund (JRF) member</label>
    <label><input type="checkbox"> I am not a member of ERS, TRS, or JRF</label>
  </div>

  <div class="signature-area">
    <div class="form-row">
      <div style="flex: 1;">
        <label class="form-label">Signature Certification</label>
        <div class="input-field" style="height: 80px;"></div>
      </div>
      <div style="flex: 1; text-align: right;">
        <label class="form-label">Date</label>
        <div class="input-field" style="width: 150px;"></div>
      </div>
    </div>
    <div class="disclaimer">
      Please read carefully as the following statements will apply to your RSA-1 account:
      <br><br>
      I have designated my beneficiaries on the separate BENEFICIARY DESIGNATION form (return to RSA-1).
      <br>
      I have completed an INVESTMENT OPTION ELECTION form (return to RSA-1).
      <br>
      I will complete an AUTHORIZATION TO DEFER COMPENSATION form and deliver it to my payroll officer to begin deferrals. It takes at least two weeks to process the RSA-1 ENROLLMENT, BENEFICIARY DESIGNATION, and INVESTMENT OPTION ELECTION forms.
      <br>
      I understand that I may not withdraw this account unless I meet one of the following conditions:
      <ol>
        <li>Separation from service through retirement or termination from employment</li>
        <li>The attainment of age 72</li>
        <li>Unforeseeable emergency (must be approved by Plan Administrator)</li>
        <li>Small Balance Distribution</li>
      </ol>
      <br>
      Your signature affirms your understanding of each of these statements and is your agreement to be bound by the terms and conditions set forth in the amended and restated RSA-1 Plan Document, which is located on the RSA website.
    </div>
    <div class="form-row" style="margin-top: 40px;">
      <div style="flex: 1;">
        <label class="form-label">Sign Here</label>
        <div class="signature-line"></div>
      </div>
      <div style="flex: 1; text-align: right;">
        <label class="form-label">Your Signature</label>
        <div class="signature-line" style="width: 150px;"></div>
      </div>
    </div>
  </div>
</div>

<div class="page">
  <div class="header-logo">
    <!-- Placeholder for RSA-I Logo -->
    <span style="font-size: 40pt; font-weight: bold;">RSA-I</span>
    <div style="font-size: 18pt; font-weight: normal;">OF ALABAMA</div>
  </div>
  <div class="section-title">RSA-1 and PEIRAF Beneficiary Designation</div>

  <div class="form-row">
    <div style="flex: 1;">
      <label class="form-label">Your SSN</label>
      <div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">Type of Account:</label>
      <div class="checkbox-group">
        <label><input type="radio" name="account_type"> PEIRAF</label>
        <label><input type="radio" name="account_type"> RSA-1</label>
      </div>
    </div>
  </div>

  <div class="section-title">Your Information</div>
  <div class="form-row">
    <div style="flex: 2;">
      <label class="form-label">Name</label>
      <div class="form-row">
        <div style="flex: 1;"><label class="form-label">First</label><div class="input-field"></div></div>
        <div style="flex: 1;"><label class="form-label">Middle/Maiden</label><div class="input-field"></div></div>
        <div style="flex: 1;"><label class="form-label">Last</label><div class="input-field"></div></div>
      </div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">City</label><div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">State</label><div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">ZIP Code</label><div class="input-field"></div>
    </div>
  </div>

  <div class="form-row">
    <div style="flex: 1;">
      <label class="form-label">Address</label>
      <div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">Street or P.O. Box</label>
      <div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">Telephone Number</label>
      <div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">Email Address</label>
      <div class="input-field"></div>
    </div>
  </div>

  <div class="form-row">
    <div style="flex: 1;">
      <label class="form-label">Date of Birth</label>
      <div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">Sex</label>
      <div class="checkbox-group">
        <label><input type="radio" name="sex"> Male</label>
        <label><input type="radio" name="sex"> Female</label>
      </div>
    </div>
  </div>

  <div class="section-title">Designation of Primary Beneficiary(ies)</div>
  <div class="disclaimer">
    I hereby designate the following person(s) as my <span data-field="beneficiary_type">{{ beneficiary_type }}</span> to receive any benefit that may become due at or after my death according to the terms of the Plan.
  </div>

  {% for i in 1..3 %}
  <div class="form-row" style="margin-top: 20px;">
    <div style="flex: 1;">
      <label class="form-label">Name</label>
      <div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">Relationship</label>
      <div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">Date of Birth</label>
      <div class="input-field"></div>
    </div>
  </div>
  {% endfor %}

  <div class="section-title">Designation of Contingent Beneficiary(ies)</div>
  <div class="disclaimer">
    In the event the primary beneficiary(ies) designated above does not survive me, I hereby designate the following person(s) as my <span data-field="contingent_beneficiary_type">{{ contingent_beneficiary_type }}</span> to receive any benefit that may become due at or after my death according to the terms of the Plan.
  </div>

  {% for i in 1..3 %}
  <div class="form-row" style="margin-top: 20px;">
    <div style="flex: 1;">
      <label class="form-label">Name</label>
      <div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">Relationship</label>
      <div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">Date of Birth</label>
      <div class="input-field"></div>
    </div>
  </div>
  {% endfor %}

  <div class="signature-area" style="margin-top: 60px;">
    <div class="form-row">
      <div style="flex: 1;">
        <label class="form-label">Sign Here</label>
        <div class="signature-line"></div>
      </div>
      <div style="flex: 1; text-align: right;">
        <label class="form-label">Date</label>
        <div class="input-field" style="width: 150px;"></div>
      </div>
    </div>
    <div class="disclaimer" style="margin-top: 30px;">
      *Page two must be signed if any contingent beneficiary information is submitted on this side of the form.
    </div>
  </div>
</div>

<div class="page">
  <div class="header-logo">
    <!-- Placeholder for RSA-I Logo -->
    <span style="font-size: 40pt; font-weight: bold;">RSA-I</span>
    <div style="font-size: 18pt; font-weight: normal;">OF ALABAMA</div>
  </div>
  <div class="section-title">RSA-1 Investment Option Election for New Accounts</div>

  <div class="section-title">Your Information</div>
  <div class="form-row">
    <div style="flex: 2;">
      <label class="form-label">Name</label>
      <div class="form-row">
        <div style="flex: 1;"><label class="form-label">First</label><div class="input-field"></div></div>
        <div style="flex: 1;"><label class="form-label">Middle/Maiden</label><div class="input-field"></div></div>
        <div style="flex: 1;"><label class="form-label">Last</label><div class="input-field"></div></div>
      </div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">City</label><div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">State</label><div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">ZIP Code</label><div class="input-field"></div>
    </div>
  </div>

  <div class="form-row">
    <div style="flex: 1;">
      <label class="form-label">Telephone Number</label>
      <div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">Email Address</label>
      <div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">Date of Birth</label>
      <div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">PID (optional)</label>
      <div class="input-field"></div>
    </div>
  </div>

  <div class="section-title">RSA-1 Accounts Only</div>
  <div class="disclaimer">
    I elect the following investment option for future deferrals. You can elect to have 100% in the bond, stock, or short-term investment option election or split the percentages between the investment options, but they must add up to 100%.
  </div>

  <div class="form-row" style="margin-top: 15px;">
    <div style="flex: 1;">
      <label class="form-label">Invest</label>
      <div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">% of new deferrals in the RSA-1 BOND investment option. The bond portfolio is invested in various debt instruments with maturities greater than one year such as corporate bonds, U.S. agency obligations, mortgage obligations, and commercial paper.</label>
      <div class="input-field"></div>
    </div>
  </div>

  <div class="form-row" style="margin-top: 15px;">
    <div style="flex: 1;">
      <label class="form-label">Invest</label>
      <div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">% of new deferrals in the RSA-1 STOCK investment option. The stock portfolio is invested in an S&P 500 Index Fund.</label>
      <div class="input-field"></div>
    </div>
  </div>

  <div class="section-title">DROP/PLOP/ERIP Accounts Only</div>
  <div class="disclaimer">
    I elect the following investment option for:
    <div class="checkbox-group">
      <label><input type="checkbox"> DROP</label>
      <label><input type="checkbox"> PLOP</label>
      <label><input type="checkbox"> ERIP</label>
    </div>
    You can elect to have 100% in the bond, stock, or short-term investment option election or split the percentages between the investment options, but they must add up to 100%.
  </div>

  <div class="form-row" style="margin-top: 15px;">
    <div style="flex: 1;">
      <label class="form-label">Invest</label>
      <div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">% of funds in the RSA-1 BOND investment option. The bond portfolio is invested in various debt instruments with maturities greater than one year such as corporate bonds, U.S. agency obligations, mortgage obligations, and commercial paper.</label>
      <div class="input-field"></div>
    </div>
  </div>

  <div class="form-row" style="margin-top: 15px;">
    <div style="flex: 1;">
      <label class="form-label">Invest</label>
      <div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">% of funds in the RSA-1 STOCK investment option. The stock portfolio is invested in an S&P 500 Index Fund.</label>
      <div class="input-field"></div>
    </div>
  </div>

  <div class="form-row" style="margin-top: 15px;">
    <div style="flex: 1;">
      <label class="form-label">Invest</label>
      <div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">% of funds in the RSA-1 SHORT-TERM investment option. The short-term investment fund (STIF) could include high-quality money market securities, U.S. Treasury bills or notes, and U.S. government agency notes with a maturity of one year or less.</label>
      <div class="input-field"></div>
    </div>
  </div>

  <div class="disclaimer" style="margin-top: 40px;">
    I understand the following regarding this investment option election:
    <br><br>
    My election must be made prior to the funds being submitted or transferred. My election can be made once every 90 days. My election will remain in effect until a subsequent election is made, but it must remain in effect for 90 days.
  </div>

  <div class="signature-area" style="margin-top: 50px;">
    <div class="form-row">
      <div style="flex: 1;">
        <label class="form-label">Sign Here</label>
        <div class="signature-line"></div>
      </div>
      <div style="flex: 1; text-align: right;">
        <label class="form-label">Date</label>
        <div class="input-field" style="width: 150px;"></div>
      </div>
    </div>
  </div>
</div>

<div class="page">
  <div class="header-logo">
    <!-- Placeholder for RSA-I Logo -->
    <span style="font-size: 40pt; font-weight: bold;">RSA-I</span>
    <div style="font-size: 18pt; font-weight: normal;">OF ALABAMA</div>
  </div>
  <div class="section-title">RSA-1 Authorization to Defer Compensation</div>

  <div class="section-title">Your Information</div>
  <div class="form-row">
    <div style="flex: 2;">
      <label class="form-label">Name</label>
      <div class="form-row">
        <div style="flex: 1;"><label class="form-label">First</label><div class="input-field"></div></div>
        <div style="flex: 1;"><label class="form-label">Middle/Maiden</label><div class="input-field"></div></div>
        <div style="flex: 1;"><label class="form-label">Last</label><div class="input-field"></div></div>
      </div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">City</label><div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">State</label><div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">ZIP Code</label><div class="input-field"></div>
    </div>
  </div>

  <div class="form-row">
    <div style="flex: 1;">
      <label class="form-label">Address</label>
      <div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">Street or P.O. Box</label>
      <div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">Telephone Number</label>
      <div class="input-field"></div>
    </div>
    <div style="flex: 1;">
      <label class="form-label">Email Address</label>
      <div class="input-field"></div>
    </div>
  </div>

  <div class="form-row">
    <div style="flex: 1;">
      <label class="form-label">Date of Birth</label>
      <div class="input-field"></div>
