<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child { page-break-after: auto; }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  td {
    padding: 5px 0;
    vertical-align: top;
  }
  .header-title {
    font-size: 24pt;
    font-weight: bold;
    text-align: center;
    margin-bottom: 10px;
  }
  .section-heading {
    font-size: 14pt;
    font-weight: bold;
    margin-top: 25px;
    margin-bottom: 10px;
    border-bottom: 1px solid #ccc;
    padding-bottom: 3px;
  }
  .data-row {
    display: flex;
    margin-bottom: 10px;
  }
  .data-label {
    width: 200px;
    font-weight: normal;
  }
  .data-value {
    flex-grow: 1;
  }
  .metadata-table td {
    padding: 5px 10px;
  }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px;">
    <div>
      <div style="font-size: 10pt; font-weight: bold;">TOOLIK FIELD STATION</div>
      <div style="font-size: 10pt;">GIS</div>
    </div>
    <div style="text-align: right;">
      <div style="font-size: 10pt;">Toolik Field Station GIS</div>
      <div style="font-size: 10pt;">IAB, 311 Irving I</div>
      <div style="font-size: 10pt;">University of Alaska Fairbanks</div>
      <div style="font-size: 10pt;">Fairbanks, AK 99775-7000</div>
      <div style="font-size: 10pt;">(907) 474-2468</div>
      <div style="font-size: 10pt;">Andrew.Balser@ual.edu</div>
    </div>
  </div>

  <div style="text-align: center; margin-bottom: 40px;">
    <div style="font-size: 20pt; font-weight: bold;">GPS Data Collection Documentation</div>
    <div style="font-size: 14pt; font-weight: normal;">(Metadata)</div>
  </div>

  <div class="section-heading">Basis of Bearings and Coordinates</div>

  <table class="metadata-table">
    <tr>
      <td style="width: 20%;">Linear unit:</td>
      <td style="width: 30%;"><span data-field="linear_unit">{{ linear_unit }}</span></td>
      <td style="width: 50%;"></td>
    </tr>
    <tr>
      <td>Geodetic datum:</td>
      <td><span data-field="geodetic_datum">{{ geodetic_datum }}</span></td>
      <td></td>
    </tr>
    <tr>
      <td>Vertical datum:</td>
      <td><span data-field="vertical_datum">{{ vertical_datum }}</span></td>
      <td></td>
    </tr>
    <tr>
      <td>Coordinate System:</td>
      <td><span data-field="coordinate_system">{{ coordinate_system }}</span></td>
      <td></td>
    </tr>
    <tr>
      <td>Feature Description:</td>
      <td><span data-field="feature_description">{{ feature_description }}</span></td>
      <td></td>
    </tr>
    <tr>
      <td>Rover File Name:</td>
      <td><span data-field="rover_file_name">{{ rover_file_name }}</span></td>
      <td>Base File Name: <span data-field="base_file_name">{{ base_file_name }}</span></td>
    </tr>
    <tr>
      <td>Field Technician(who collected data):</td>
      <td><span data-field="field_technician">{{ field_technician }}</span></td>
      <td></td>
    </tr>
    <tr>
      <td>PI Name:</td>
      <td><span data-field="pi_name">{{ pi_name }}</span></td>
      <td></td>
    </tr>
    <tr>
      <td>GPS Receiver:</td>
      <td><span data-field="gps_receiver">{{ gps_receiver }}</span></td>
      <td></td>
    </tr>
    <tr>
      <td>Antenna:</td>
      <td><span data-field="antenna">{{ antenna }}</span></td>
      <td></td>
    </tr>
    <tr>
      <td>GPS & Mapping Software:</td>
      <td><span data-field="gps_mapping_software">{{ gps_mapping_software }}</span></td>
      <td>Version: <span data-field="software_version">{{ software_version }}</span></td>
    </tr>
  </table>

  <div class="section-heading">Mapping Conditions:</div>
  <div style="border: 1px solid #ccc; padding: 10px;">
    <span data-field="mapping_conditions">{{ mapping_conditions }}</span>
  </div>

  <div class="section-heading">Mapping Process:</div>
  <div style="border: 1px solid #ccc; padding: 10px;">
    <span data-field="mapping_process">{{ mapping_process }}</span>
  </div>

  <div class="section-heading">GPS Quality Settings:</div>
  <table class="metadata-table">
    <tr>
      <td>HDOP:</td>
      <td><span data-field="hdop">{{ hdop }}</span></td>
    </tr>
    <tr>
      <td>SNR:</td>
      <td><span data-field="snr">{{ snr }}</span></td>
    </tr>
    <tr>
      <td>Satellite Elevation Mask:</td>
      <td><span data-field="satellite_elevation_mask">{{ satellite_elevation_mask }}</span></td>
    </tr>
    <tr>
      <td>Logging Rate:</td>
      <td><span data-field="logging_rate">{{ logging_rate }}</span></td>
    </tr>
  </table>

  <div class="section-heading">Post-Processing Technician:</div>
  <div style="border: 1px solid #ccc; padding: 10px;">
    <span data-field="post_processing_technician">{{ post_processing_technician }}</span>
  </div>

  <div class="section-heading">GPS Data Processing:</div>
  <div style="border: 1px solid #ccc; padding: 10px;">
    <span data-field="gps_data_processing">{{ gps_data_processing }}</span>
  </div>

  <div style="margin-top: 40px;">
    <p style="font-size: 10pt;">Coordinates:</p>
    <p style="font-size: 10pt;">Latitude: <span data-field="latitude">{{ latitude }}</span></p>
    <p style="font-size: 10pt;">Longitude: <span data-field="longitude">{{ longitude }}</span></p>
    <p style="font-size: 10pt;">Elevation: <span data-field="elevation">{{ elevation }}</span></p>
    <p style="font-size: 10pt;">Adjustment Report: <span data-field="adjustment_report">{{ adjustment_report }}</span></p>
  </div>
</div>