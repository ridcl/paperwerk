<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1, h2, h3 { font-weight: bold; }
  table { width: 100%; border-collapse: collapse; margin-top: 20px; }
  td { padding: 8px 0; }
  .header-info { display: flex; justify-content: space-between; margin-bottom: 30px; }
</style>

<div class="page">
  <!-- Assuming this is a document header/personal info section -->
  <div class="header-info">
    <div>
      <h1 style="margin: 0;">Curriculum Vitae</h1>
      <p style="margin: 5px 0 0 0;">
        <span data-field="full_name">{{ full_name }}</span>
      </p>
    </div>
    <div>
      <p style="margin: 0;">Email: <span data-field="email">{{ email }}</span></p>
      <p style="margin: 0;">Phone: <span data-field="phone">{{ phone }}</span></p>
      <p style="margin: 0;">Location: <span data-field="location">{{ location }}</span></p>
    </div>
  </div>

  <!-- Experience Section -->
  <h2 style="margin-top: 40px;">Work Experience</h2>
  {% for job in work_experience %}
    <div style="margin-bottom: 25px;">
      <h3 style="margin: 0;">
        <span data-field="work_experience[{{ loop.index0 }}].job_title">{{ work_experience[loop.index0].job_title }}</span> at <span data-field="work_experience[{{ loop.index0 }}].employer.name">{{ work_experience[loop.index0].employer.name }}</span>
      </h3>
      <p style="margin: 5px 0;">
        <span data-field="work_experience[{{ loop.index0 }}].dates">{{ work_experience[loop.index0].dates }}</span>
      </p>
      <ul style="margin-top: 10px; padding-left: 20px;">
        {% for duty in job.responsibilities %}
          <li><span data-field="work_experience[{{ loop.index0 }}].responsibilities[{{ loop.index }}]">{{ work_experience[loop.index0].responsibilities[loop.index] }}</span></li>
        {% endfor %}
      </ul>
    </div>
  {% endfor %}

  <!-- Education Section -->
  <h2 style="margin-top: 40px;">Education</h2>
  {% for edu in education %}
    <div style="margin-bottom: 20px;">
      <h3 style="margin: 0;">
        <span data-field="education[{{ loop.index0 }}].degree">{{ education[loop.index0].degree }}</span>
      </h3>
      <p style="margin: 5px 0;">
        <span data-field="education[{{ loop.index0 }}].institution">{{ education[loop.index0].institution }}</span>, <span data-field="education[{{ loop.index0 }}].location">{{ education[loop.index0].location }}</span>
      </p>
      <p style="margin: 5px 0;">
        <span data-field="education[{{ loop.index0 }}].dates">{{ education[loop.index0].dates }}</span>
      </p>
    </div>
  {% endfor %}

  <!-- Skills Section -->
  <h2 style="margin-top: 40px;">Skills</h2>
  <div style="margin-top: 10px;">
    {% for skill in skills %}
      <span data-field="skills[{{ loop.index0 }}]">{{ skill }}</span>
      {% if not loop.last %}
        <span style="margin-left: 15px;">|</span>
      {% endif %}
    {% endfor %}
  </div>

</div></body>
</html>