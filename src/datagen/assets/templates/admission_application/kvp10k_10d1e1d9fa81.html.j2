<!DOCTYPE html>
<html>
<head>
    <title>Admission Application</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 {
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .header-title {
            font-size: 24pt;
            font-weight: bold;
            margin-bottom: 5px;
        }
        .header-subtitle {
            font-size: 12pt;
            margin-bottom: 30px;
        }
        .logo-container {
            text-align: center;
            margin: 50px 0;
        }
        .logo {
            width: 200px;
            height: auto;
        }
        .section-title {
            font-size: 14pt;
            font-weight: bold;
            margin-top: 20px;
            margin-bottom: 10px;
            border-bottom: 1px solid #ccc;
            padding-bottom: 5px;
        }
        .form-row {
            display: flex;
            margin-bottom: 15px;
            align-items: center;
        }
        .form-row-full {
            display: flex;
            margin-bottom: 15px;
            align-items: center;
        }
        .form-label {
            width: 200px;
            font-weight: normal;
        }
        .form-input-group {
            flex-grow: 1;
        }
        .form-input {
            border-bottom: 1px solid #000;
            padding: 2px 5px;
            width: 100%;
            box-sizing: border-box;
        }
        .radio-group label {
            margin-right: 15px;
        }
        .checkbox-group label {
            margin-right: 20px;
        }
        .table-header {
            font-weight: bold;
            border-bottom: 1px solid #000;
            padding: 5px;
            text-align: left;
        }
        .table-row td {
            padding: 5px;
            border-bottom: 1px dotted #ccc;
        }
        .signature-block {
            margin-top: 50px;
            display: flex;
            justify-content: space-between;
        }
        .signature-area {
            width: 45%;
            text-align: center;
        }
        .signature-line {
            border-top: 1px solid #000;
            margin-top: 50px;
            padding-top: 5px;
        }
        .footer-note {
            font-size: 9pt;
            margin-top: 40px;
            line-height: 1.4;
        }
        .section-divider {
            border-top: 2px solid #000;
            margin: 30px 0;
        }
    </style>

<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  .header-title { font-size: 24pt; font-weight: bold; margin-bottom: 10px; }
  .header-subtitle { font-size: 14pt; font-weight: normal; margin-bottom: 30px; }
  .logo { position: absolute; top: 50px; right: 60px; }
  .section-title { font-size: 14pt; font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 20px; }
  .form-label { width: 30%; }
  .form-input { width: 65%; border-bottom: 1px solid #000; }
  .signature-area { margin-top: 80px; display: flex; justify-content: space-between; }
  .signature-box { width: 45%; text-align: center; }
  .signature-line { border-top: 1px solid #000; margin-top: 50px; }
  .table-container { width: 100%; margin-top: 20px; }
  .rating-table { width: 100%; border-collapse: collapse; margin-top: 15px; }
  .rating-table th, .rating-table td { border: 1px solid #000; padding: 8px; text-align: center; }
  .rating-table th { background-color: #f0f0f0; }
  .footer-section { margin-top: 100px; display: flex; justify-content: space-between; }
  .address-box { width: 45%; border: 1px solid #000; padding: 20px; }
  .address-box h4 { margin-top: 0; font-size: 12pt; }
  .address-box p { margin: 5px 0; font-size: 10pt; }
</style>
</head>
<body>

<div class="page">
    <div style="text-align: center;">
        <div class="header-title">SOLICITUD DE ADMISIÓN</div>
        <div class="header-subtitle">ADMISSION APPLICATION</div>
    </div>

    <div class="logo-container">
        <!-- Placeholder for University Logo -->
        <div style="width: 200px; height: 150px; border: 1px dashed #aaa; text-align: center; line-height: 150px;">[University Seal Placeholder]</div>
    </div>

    <div style="text-align: center; margin-bottom: 40px;">
        <div style="font-size: 12pt; margin-bottom: 5px;">PROGRAMA DE MAESTRÍA / Master's Program</div>
        <div style="font-size: 12pt; margin-bottom: 5px;">PROGRAMA DE DOCTORADO / Doctoral Program</div>
        <div style="font-size: 12pt;">CERTIFICADO PROFESIONAL POST BACHILLERATO O POST MAESTRÍA / Post-Baccalaureate or Post-Master's Professional Certificate</div>
    </div>

    <div class="section-title">REQUISITOS DE ADMISIÓN / ADMISSION REQUIREMENTS</div>
    <div style="display: flex; justify-content: space-between; margin-bottom: 30px;">
        <div style="width: 48%;">
            <h3 style="font-size: 12pt; margin-top: 0;">PROGRAMAS DE MAESTRÍA / MASTER'S PROGRAMS</h3>
            <ol style="font-size: 10pt; line-height: 1.5;">
                <li><span data-field="master_req_1">{{ master_req_1 }}</span></li>
                <li><span data-field="master_req_2">{{ master_req_2 }}</span></li>
                <li><span data-field="master_req_3">{{ master_req_3 }}</span></li>
                <li><span data-field="master_req_4">{{ master_req_4 }}</span></li>
                <li><span data-field="master_req_5">{{ master_req_5 }}</span></li>
            </ol>
        </div>
        <div style="width: 48%;">
            <h3 style="font-size: 12pt; margin-top: 0;">PROFESSIONAL CERTIFICATE PROGRAMS</h3>
            <p style="font-size: 10pt; line-height: 1.5;">For admission requirements to a Professional Certificate you should contact the Admissions Director of the Campus authorized to offer the program.</p>
        </div>
    </div>

    <div class="section-title">PROGRAMAS DE DOCTORADO / DOCTORAL PROGRAMS</div>
    <div style="width: 100%;">
        <ol style="font-size: 10pt; line-height: 1.5;">
            <li><span data-field="doctoral_req_1">{{ doctoral_req_1 }}</span></li>
            <li><span data-field="doctoral_req_2">{{ doctoral_req_2 }}</span></li>
            <li><span data-field="doctoral_req_3">{{ doctoral_req_3 }}</span></li>
            <li><span data-field="doctoral_req_4">{{ doctoral_req_4 }}</span></li>
            <li><span data-field="doctoral_req_5">{{ doctoral_req_5 }}</span></li>
            <li><span data-field="doctoral_req_6">{{ doctoral_req_6 }}</span></li>
            <li><span data-field="doctoral_req_7">{{ doctoral_req_7 }}</span></li>
            <li><span data-field="doctoral_req_8">{{ doctoral_req_8 }}</span></li>
        </ol>
    </div>

    <div class="section-divider"></div>

    <div class="section-title">SOLICITUD DE ADMISIÓN / ADMISSION APPLICATION</div>

    <div class="section-title" style="margin-top: 30px;">Información personal / Personal Information</div>
    <div class="form-row">
        <div class="form-label">1. Primer apellido / Father's surname</div>
        <div class="form-input-group"><input type="text" class="form-input" data-field="personal.first_surname" value="{{ personal.first_surname }}"></div>
        <div class="form-label">Segundo apellido / Mother's maiden surname</div>
        <div class="form-input-group"><input type="text" class="form-input" data-field="personal.second_surname" value="{{ personal.second_surname }}"></div>
        <div class="form-label">Nombre / First Name</div>
        <div class="form-input-group"><input type="text" class="form-input" data-field="personal.first_name" value="{{ personal.first_name }}"></div>
    </div>

    <div class="form-row">
        <div class="form-label">2. Fecha de nacimiento / Date of birth:</div>
        <div class="form-input-group" style="display: flex; gap: 10px;">
            <input type="text" class="form-input" style="width: 33%;" placeholder="Mes/Month" data-field="personal.dob.month" value="{{ personal.dob.month }}">
            <input type="text" class="form-input" style="width: 33%;" placeholder="Día/Day" data-field="personal.dob.day" value="{{ personal.dob.day }}">
            <input type="text" class="form-input" style="width: 33%;" placeholder="Año/Year" data-field="personal.dob.year" value="{{ personal.dob.year }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-label">2a. Lugar de nacimiento / Birthplace:</div>
        <div class="form-input-group"><input type="text" class="form-input" data-field="personal.birthplace" value="{{ personal.birthplace }}"></div>
    </div>

    <div class="form-row">
        <div class="form-label">2b. Género / Gender:</div>
        <div class="form-input-group radio-group">
            <label><input type="radio" name="gender" data-field="personal.gender.male" value="{{ personal.gender.male }}"> M</label>
            <label><input type="radio" name="gender" data-field="personal.gender.female" value="{{ personal.gender.female }}"> F</label>
            <label><input type="radio" name="gender" data-field="personal.gender.other" value="{{ personal.gender.other }}"> O</label>
        </div>
    </div>

    <div class="form-row">
        <div class="form-label">3. Ciudadanía / Citizenship:</div>
        <div class="form-input-group radio-group">
            <label><input type="radio" name="citizenship" data-field="personal.citizenship.american" value="{{ personal.citizenship.american }}"> Americana / US citizen</label>
            <label><input type="radio" name="citizenship" data-field="personal.citizenship.resident" value="{{ personal.citizenship.resident }}"> Residente EE.UU. / US resident</label>
            <label><input type="radio" name="citizenship" data-field="personal.citizenship.other" value="{{ personal.citizenship.other }}"> Otra / Other</label>
        </div>
    </div>

    <div class="form-row">
        <div class="form-label">4. Dirección postal / Postal Address</div>
        <div class="form-input-group"><input type="text" class="form-input" data-field="personal.address.street" value="{{ personal.address.street }}"></div>
    </div>

    <div class="form-row">
        <div class="form-label">Ciudad / City</div>
        <div class="form-input-group"><input type="text" class="form-input" data-field="personal.address.city" value="{{ personal.address.city }}"></div>
        <div class="form-label">Estado o País / State or Country</div>
        <div class="form-input-group"><input type="text" class="form-input" data-field="personal.address.state_country" value="{{ personal.address.state_country }}"></div>
        <div class="form-label">Zona Postal / Zip Code</div>
        <div class="form-input-group"><input type="text" class="form-input" data-field="personal.address.zip_code" value="{{ personal.address.zip_code }}"></div>
    </div>

    <div class="form-row">
        <div class="form-label">5. Teléfono celular / Mobile Phone Number</div>
        <div class="form-input-group"><input type="text" class="form-input" data-field="personal.phone_mobile" value="{{ personal.phone_mobile }}"></div>
        <div class="form-label">5a. Teléfono trabajo / Work Telephone</div>
        <div class="form-input-group"><input type="text" class="form-input" data-field="personal.phone_work" value="{{ personal.phone_work }}"></div>
        <div class="form-label">5b. Teléfono residencial / Home Telephone</div>
        <div class="form-input-group"><input type="text" class="form-input" data-field="personal.phone_home" value="{{ personal.phone_home }}"></div>
    </div>

    <div class="form-row">
        <div class="form-label">6. Correo electrónico / Email</div>
        <div class="form-input-group"><input type="text" class="form-input" data-field="personal.email" value="{{ personal.email }}"></div>
    </div>

    <div class="section-divider"></div>

    <div class="section-title">Información de admisión / Admission information</div>

    <div class="form-row">
        <div class="form-label">7. Tipo de admisión / Admission Type</div>
        <div class="form-input-group radio-group">
            <label><input type="radio" name="admission_type" data-field="admission.new_student" value="{{ admission.new_student }}"> Nuevo ingreso / New student</label>
            <label><input type="radio" name="admission_type" data-field="admission.transfer" value="{{ admission.transfer }}"> Transferido / Transfer</label>
        </div>
    </div>

    <div class="form-row">
        <div class="form-label">8. Seleccione el nivel del programa académico / Select academic program level</div>
        <div class="form-input-group radio-group">
            <label><input type="radio" name="program_level" data-field="admission.program_master" value="{{ admission.program_master }}"> PROGRAMA DE MAESTRÍA / Master's Program</label>
            <label><input type="radio" name="program_level" data-field="admission.program_doctoral" value="{{ admission.program_doctoral }}"> PROGRAMA DE DOCTORADO / Doctoral Program</label>
            <label><input type="radio" name="program_level" data-field="admission.program_certificate" value="{{ admission.program_certificate }}"> CERTIFICADO PROFESIONAL POST BACHILLERATO O POST MAESTRÍA / Post-Baccalaureate or Post-Master's Professional Certificate</label>
        </div>
    </div>

    <div class="form-row">
        <div class="form-label">9. Indique el código del programa académico que desea estudiar / Indicate the Academic Program Code of interest:</div>
        <div class="form-input-group" style="display: flex; gap: 5px;">
            <input type="text" class="form-input" style="width: 15%;" data-field="admission.program_code_1" value="{{ admission.program_code_1 }}">
            <input type="text" class="form-input" style="width: 15%;" data-field="admission.program_code_2" value="{{ admission.program_code_2 }}">
            <input type="text" class="form-input" style="width: 15%;" data-field="admission.program_code_3" value="{{ admission.program_code_3 }}">
            <input type="text" class="form-input" style="width: 15%;" data-field="admission.program_code_4" value="{{ admission.program_code_4 }}">
            <input type="text" class="form-input" style="width: 15%;" data-field="admission.program_code_5" value="{{ admission.program_code_5 }}">
        </div>
    </div>

    <div class="form-row">
        <div class="form-label">10. Indique el término en el que espera comenzar a estudiar. / Indicate the term when you expect to initiate your studies.</div>
        <div class="form-input-group" style="display: flex; gap: 10px;">
            <div style="flex: 1;">
                <label><input type="radio" name="term" data-field="admission.term.august" value="{{ admission.term.august }}"> Agosto / August</label><br>
                <label><input type="radio" name="term" data-field="admission.term.january" value="{{ admission.term.january }}"> Enero / January</label>
            </div>
            <div style="flex: 1;">
                <label><input type="radio" name="term" data-field="admission.term.october" value="{{ admission.term.october }}"> Octubre / October</label><br>
                <label><input type="radio" name="term.february"> Febrero / February</label>
            </div>
            <div style="flex: 1;">
                <label><input type="radio" name="term" data-field="admission.term.june" value="{{ admission.term.june }}"> Junio / June</label><br>
                <label><input type="radio" name="term.july"> Julio / July</label>
            </div>
        </div>
    </div>

    <div class="form-row">
        <div class="form-label">11. Indique el recinto al que solicita admisión / Indicate the Campus you are applying to:</div>
        <div class="form-input-group" style="display: flex; flex-wrap: wrap; gap: 10px;">
            <label><input type="radio" name="campus" data-field="admission.campus.aguadilla" value="{{ admission.campus.aguadilla }}"> Aguadilla Campus</label>
            <label><input type="radio" name="campus" data-field="admission.campus.barranquitas" value="{{ admission.campus.barranquitas }}"> Barranquitas Campus</label>
            <label><input type="radio" name="campus" data-field="admission.campus.meyaman" value="{{ admission.campus.meyaman }}"> Meyaman Campus</label>
            <label><input type="radio" name="campus" data-field="admission.campus.fajardo" value="{{ admission.campus.fajardo }}"> Fajardo Campus</label>
            <label><input type="radio" name="campus" data-field="admission.campus.ceiba" value="{{ admission.campus.ceiba }}"> Ceiba Campus</label>
            <label><input type="radio" name="campus" data-field="admission.campus.san_german" value="{{ admission.campus.san_german }}"> San Germán Campus</label>
            <label><input type="radio" name="campus" data-field="admission.campus.ceiba_english" value="{{ admission.campus.ceiba_english }}"> Ceiba Metro in English</label>
        </div>
    </div>

    <div class="form-row">
        <div class="form-label">12. Experiencia académica previa / Previous academic experience</div>
        <div class="form-input-group" style="display: flex; gap: 10px;">
            <div style="flex: 1;">
                <label>Desde/From:</label><input type="text" class="form-input" data-field="academic_history.start_date" value="{{ academic_history.start_date }}">
                <label>Hasta/To:</label><input type="text" class="form-input" data-field="academic_history.end_date" value="{{ academic_history.end_date }}">
            </div>
            <div style="flex: 1;">
                <label>Grado obtenido o total de créditos aprobados / Degree obtained or amount of credits taken:</label><input type="text" class="form-input" data-field="academic_history.degree_credits" value="{{ academic_history.degree_credits }}">
            </div>
        </div>
    </div>

    <div class="form-row">
        <div class="form-label">13. Indique los exámenes para solicitar admisión a programas de nivel graduado que haya tomado o planifique tomar próximamente / Indicate the exams taken or planning to take for admission to graduate level:</div>
        <div class="form-input-group" style="display: flex; gap: 20px;">
            <div>
                <label>EXADEP:</label><input type="text" class="form-input" data-field="exam_scores.exadep.taken" value="{{ exam_scores.exadep.taken }}">
                <label>Mes/Month:</label><input type="text" class="form-input" data-field="exam_scores.exadep.month" value="{{ exam_scores.exadep.month }}">
                <label>Día/Day:</label><input type="text" class="form-input" data-field="exam_scores.exadep.day" value="{{ exam_scores.exadep.day }}">
                <label>Año/Year:</label><input type="text" class="form-input" data-field="exam_scores.exadep.year" value="{{ exam_scores.exadep.year }}">
            </div>
            <div>
                <label>GMAT:</label><input type="text" class="form-input" data-field="exam_scores.gmat.taken" value="{{ exam_scores.gmat.taken }}">
                <label>Mes/Month:</label><input type="text" class="form-input" data-field="exam_scores.gmat.month" value="{{ exam_scores.gmat.month }}">
                <label>Día/Day:</label><input type="text" class="form-input" data-field="exam_scores.gmat.day" value="{{ exam_scores.gmat.day }}">
                <label>Año/Year:</label><input type="text" class="form-input" data-field="exam_scores.gmat.year" value="{{ exam_scores.gmat.year }}">
            </div>
            <div>
                <label>GRE:</label><input type="text" class="form-input" data-field="exam_scores.gre.taken" value="{{ exam_scores.gre.taken }}">
                <label>Mes/Month:</label><input type="text" class="form-input" data-field="exam_scores.gre.month" value="{{ exam_scores.gre.month }}">
                <label>Día/Day:</label><input type="text" class="form-input" data-field="exam_scores.gre.day" value="{{ exam_scores.gre.day }}">
                <label>Año/Year:</label><input type="text" class="form-input" data-field="exam_scores.gre.year" value="{{ exam_scores.gre.year }}">
            </div>
            <div>
                <label>MAT:</label><input type="text" class="form-input" data-field="exam_scores.mat.taken" value="{{ exam_scores.mat.taken }}">
                <label>Mes/Month:</label><input type="text" class="form-input" data-field="exam_scores.mat.month" value="{{ exam_scores.mat.month }}">
                <label>Día/Day:</label><input type="text" class="form-input" data-field="exam_scores.mat.day" value="{{ exam_scores.mat.day }}">
                <label>Año/Year:</label><input type="text" class="form-input" data-field="exam_scores.mat.year" value="{{ exam_scores.mat.year }}">
            </div>
        </div>
    </div>

    <div class="form-row">
        <div class="form-label">14. Indique su experiencia de trabajo / Indicate your work experience</div>
        <div class="form-input-group" style="display: flex; gap: 10px;">
            <div style="flex: 1;">
                <label>Nombre de la Empresa/Company Name:</label><input type="text" class="form-input" data-field="work_experience.company_name" value="{{ work_experience.company_name }}">
                <label>Desde/From:</label><input type="text" class="form-input" data-field="work_experience.start_date" value="{{ work_experience.start_date }}">
                <label>Hasta/To:</label><input type="text" class="form-input" data-field="work_experience.end_date" value="{{ work_experience.end_date }}">
                <label>Posición/Position:</label><input type="text" class="form-input" data-field="work_experience.position" value="{{ work_experience.position }}">
            </div>
        </div>
    </div>

    <div class="section-title" style="margin-top: 30px;">Experiencia de investigación previa (para solicitantes de nivel doctoral) / Previous research experience (for doctoral level applicants)</div>
    <div class="form-input-group" style="height: 150px; border: 1px solid #000; padding: 10px;">
        <textarea class="form-input" rows="5" data-field="research_experience_description">{{ research_experience_description }}</textarea>
    </div>

    <div class="section-divider"></div>

    <div style="text-align: center; margin-bottom: 20px;">
        <div style="font-size: 12pt; font-weight: bold;">COSTOS DEL TRÁMITE DE LA SOLICITUD DE ADMISIÓN / ADMISSION APPLICATION FEES</div>
        <div style="font-size: 11pt;">NIVEL DE MAESTRÍA / MASTER'S LEVEL: <span data-field="fee.master">{{ fee.master }}</span></div>
        <div style="font-size: 11pt;">NIVEL DOCTORAL / DOCTORAL LEVEL: <span data-field="fee.doctoral">{{ fee.doctoral }}</span></div>
    </div>

    <div class="section-divider"></div>

    <div class="section-title">Para uso de la Oficina de Admisión / For Admissions Office use</div>
    <table style="width: 100%; font-size: 10pt;">
        <thead>
            <tr>
                <th style="width: 15%;">EXADEP:</th>
                <th style="width: 15%;">Verbal</th>
                <th style="width: 15%;">Matemática</th>
                <th style="width: 15%;">Inglés</th>
                <th style="width: 15%;">Matemática</th>
                <th style="width: 15%;">Total</th>
            </tr>
        </thead>
        <tbody>
            <tr class="table-row">
                <td>GRE:</td>
                <td><span data-field="office_use.gre.verbal">{{ office_use.gre.verbal }}</span></td>
                <td><span data-field="office_use.gre.quantitative">{{ office_use.gre.quantitative }}</span></td>
                <td><span data-field="office_use.gre.english">{{ office_use.gre.english }}</span></td>
                <td><span data-field="office_use.gre.analytical">{{ office_use.gre.analytical }}</span></td>
                <td><span data-field="office_use.gre.total">{{ office_use.gre.total }}</span></td>
            </tr>
            <tr class="table-row">
                <td>GMAT:</td>
                <td><span data-field="office_use.gmat.verbal">{{ office_use.gmat.verbal }}</span></td>
                <td><span data-field="office_use.gmat.quantitative">{{ office_use.gmat.quantitative }}</span></td>
                <td><span data-field="office_use.gmat.english">{{ office_use.gmat.english }}</span></td>
                <td><span data-field="office_use.gmat.analytical">{{ office_use.gmat.analytical }}</span></td>
