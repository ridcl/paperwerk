<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  /* Basic styling to mimic document structure */
  h1, h2, h3 {
    font-weight: bold;
    margin-top: 0;
  }
  .form-row {
    margin-bottom: 20px;
  }
  .label {
    display: inline-block;
    width: 150px; /* Approximation for alignment */
    vertical-align: top;
  }
  .input-line {
    border-bottom: 1px solid #000;
    display: inline-block;
    width: calc(100% - 160px); /* Approximation */
    min-width: 500px;
  }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      <div style="font-size: 40px; font-weight: bold;">G</div>
      <div style="font-size: 24px; font-weight: bold;">UNIVERSITY OF GUAM</div>
      <div style="font-size: 14px;">UNIBETSEDAT GUAHAN</div>
    </div>
    <div style="text-align: right;">
      <div style="font-weight: bold;">ADMINISTRATION & FINANCE</div>
      <div style="font-size: 12px;">Business Office</div>
    </div>
  </div>

  <h2 style="margin-top: 40px;">VENDOR AUTHORIZATION FOR DIRECT DEPOSIT</h2>

  <div class="form-row">
    <div style="display: flex;">
      <div style="width: 150px; font-weight: bold;">Vendor Name:</div>
      <div style="flex-grow: 1;"><span class="input-line">{{ vendor_name }}</span></div>
    </div>
  </div>

  <div class="form-row">
    <div style="display: flex;">
      <div style="width: 150px; font-weight: bold;">Mailing Address:</div>
      <div style="flex-grow: 1;"><span class="input-line">{{ mailing_address }}</span></div>
    </div>
  </div>

  <div class="form-row">
    <div style="display: flex;">
      <div style="width: 150px; font-weight: bold;">City, State, Zip:</div>
      <div style="flex-grow: 1;"><span class="input-line">{{ city_state_zip }}</span></div>
    </div>
  </div>

  <div class="form-row">
    <div style="display: flex;">
      <div style="width: 150px; font-weight: bold;">Email Address:</div>
      <div style="flex-grow: 1;"><span class="input-line">{{ email_address }}</span></div>
    </div>
  </div>

  <div class="form-row">
    <div style="display: flex;">
      <div style="width: 150px; font-weight: bold;">Point of Contact Name:</div>
      <div style="flex-grow: 1;"><span class="input-line">{{ point_of_contact_name }}</span></div>
    </div>
  </div>

  <div class="form-row">
    <div style="display: flex;">
      <div style="width: 150px; font-weight: bold;">Contact Number (Include Area Code):</div>
      <div style="flex-grow: 1;"><span class="input-line">{{ contact_number }}</span></div>
    </div>
  </div>

  <h3 style="margin-top: 30px;">Bank (ACH) Information</h3>

  <div class="form-row">
    <div style="display: flex;">
      <div style="width: 150px; font-weight: bold;">Bank Name:</div>
      <div style="flex-grow: 1;"><span class="input-line">{{ bank_name }}</span></div>
    </div>
  </div>

  <div class="form-row">
    <div style="display: flex;">
      <div style="width: 150px; font-weight: bold;">Bank Routing Number:</div>
      <div style="flex-grow: 1;"><span class="input-line">{{ bank_routing_number }}</span></div>
    </div>
  </div>

  <div class="form-row">
    <div style="display: flex;">
      <div style="width: 150px; font-weight: bold;">Bank Account Number:</div>
      <div style="flex-grow: 1;"><span class="input-line">{{ bank_account_number }}</span></div>
    </div>
  </div>

  <div style="margin-top: 20px;">
    <div style="display: flex; align-items: center; margin-bottom: 10px;">
      <div style="width: 150px; font-weight: bold;">Account Type:</div>
      <div style="flex-grow: 1; display: flex; align-items: center;">
        <input type="checkbox" name="checking" style="margin-right: 5px;">
        <label style="font-weight: normal;">Checking</label>
        <span style="margin-left: 20px; font-size: 10px;">*Required document to submit: Canceled check or deposit slip.</span>
      </div>
    </div>
    <div style="display: flex; align-items: center;">
      <div style="width: 150px; font-weight: bold;">Savings:</div>
      <div style="flex-grow: 1; display: flex; align-items: center;">
        <input type="checkbox" name="savings" style="margin-right: 5px;">
        <label style="font-weight: normal;">Savings</label>
        <span style="margin-left: 20px; font-size: 10px;">*Required document to submit: Bank verification or any document showing full account number.</span>
      </div>
    </div>
  </div>

  <div class="form-row" style="margin-top: 40px;">
    <div style="display: flex;">
      <div style="width: 150px; font-weight: bold;">Authorize Representative Name:</div>
      <div style="flex-grow: 1;"><span class="input-line">{{ authorized_representative_name }}</span></div>
    </div>
  </div>

  <div class="form-row">
    <div style="display: flex;">
      <div style="width: 150px; font-weight: bold;">Date:</div>
      <div style="flex-grow: 1;"><span class="input-line">{{ authorization_date }}</span></div>
    </div>
  </div>

  <div class="form-row" style="margin-top: 50px;">
    <div style="display: flex; justify-content: space-between;">
      <div style="width: 45%; text-align: center;">
        <div style="border-bottom: 1px solid #000; margin-top: 50px;" data-field="date">{{ date }}</div>
        <div style="margin-top: 5px;">Signature:</div>
      </div>
      <div style="width: 45%; text-align: center;">
        <div style="border-bottom: 1px solid #000; margin-top: 50px;" data-field="signature">{{ signature }}</div>
        <div style="margin-top: 5px;">Date:</div>
      </div>
    </div>
  </div>

  <div style="margin-top: 60px; font-size: 10px; text-align: center;">
    <p>Please send via email to <span data-field="email_contact">{{ email_contact }}</span></p>
    <p>T: <span data-field="phone_number_1">{{ phone_number_1 }}</span> F: <span data-field="phone_number_2">{{ phone_number_2 }}</span> W: <span data-field="website_url">{{ website_url }}</span></p>
    <p>or mail to <span data-field="mailing_address_full">{{ mailing_address_full }}</span></p>
    <p style="margin-top: 20px;">The University of Guam is a U.S. Land Grant Institution accredited by the Western Association of Schools and Colleges Senior College and University Commission and is an equal opportunity provider and employer.</p>
  </div>
</div>