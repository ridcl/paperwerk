<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    color: #000;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  th, td {
    padding: 8px 10px;
    text-align: left;
  }
  .header-table th {
    background-color: #f0f0f0;
  }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px;">
    <div>
      <img src="placeholder_logo.png" alt="University Logo" style="height: 70px;">
      <h1 style="font-size: 24pt; margin-top: 10px;">BILLINGS</h1>
    </div>
    <div style="text-align: right;">
      <h2 style="font-size: 16pt; margin: 0;">ADVISING WORKSHEET</h2>
      <h3 style="font-size: 12pt; margin: 5px 0;">MINOR IN PSYCHOLOGY</h3>
      <h3 style="font-size: 12pt; margin: 5px 0;">GENERAL BULLETIN 2020-2021</h3>
      <div style="margin-top: 40px;">
        <p style="margin: 0;">TRANSFER INSTITUTION(S):</p>
        <div style="border-bottom: 1px solid #000; width: 300px;" data-field="transfer_institution">{{ transfer_institution }}</div>
      </div>
    </div>
  </div>

  <div style="display: flex; justify-content: space-between; margin-bottom: 30px;">
    <div>
      <p>Montana State University Billings</p>
      <p>Advising and Career Services</p>
      <p>Phone: <span data-field="phone">{{ phone }}</span></p>
      <p>Fax: <span data-field="fax">{{ fax }}</span></p>
      <p>Email: <span data-field="email">{{ email }}</span></p>
      <p>www.<span data-field="website">{{ website }}</span></p>
    </div>
    <div>
      <p>Name: <span data-field="name">{{ name }}</span></p>
      <p>Student ID #: <span data-field="student_id">{{ student_id }}</span></p>
    </div>
  </div>

  <!-- Required Courses -->
  <h3 style="font-size: 14pt; margin-top: 30px; margin-bottom: 10px;">Required Courses</h3>
  <table>
    <thead>
      <tr class="header-table">
        <th style="width: 10%;">Course</th>
        <th style="width: 10%;">Credits</th>
        <th style="width: 60%;">Description</th>
        <th style="width: 10%;">Grade</th>
        <th style="width: 10%;">Semester</th>
        <th style="width: 10%;">Equivalent</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>PSYX <span data-field="course_code_1">{{ course_code_1 }}</span></td>
        <td><span data-field="credits_1">{{ credits_1 }}</span></td>
        <td><span data-field="description_1">{{ description_1 }}</span></td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
      <tr>
        <td>PSYX <span data-field="course_code_2">{{ course_code_2 }}</span></td>
        <td><span data-field="credits_2">{{ credits_2 }}</span></td>
        <td><span data-field="description_2">{{ description_2 }}</span></td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
      <tr>
        <td>PSYX <span data-field="course_code_3">{{ course_code_3 }}</span></td>
        <td><span data-field="credits_3">{{ credits_3 }}</span></td>
        <td><span data-field="description_3">{{ description_3 }}</span></td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
      <tr>
        <td>PSYX <span data-field="course_code_4">{{ course_code_4 }}</span></td>
        <td><span data-field="credits_4">{{ credits_4 }}</span></td>
        <td><span data-field="description_4">{{ description_4 }}</span></td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
    </tbody>
  </table>

  <!-- Restricted Elective Courses -->
  <h3 style="font-size: 14pt; margin-top: 30px; margin-bottom: 10px;">Restricted Elective Courses – select four courses with at least one course from Group 1</h3>
  
  <!-- Group 1 -->
  <h4 style="font-size: 12pt; margin-top: 20px; margin-bottom: 5px;">Group 1:</h4>
  <table>
    <thead>
      <tr class="header-table">
        <th style="width: 10%;">Course</th>
        <th style="width: 10%;">Credits</th>
        <th style="width: 60%;">Description</th>
        <th style="width: 10%;">Grade</th>
        <th style="width: 10%;">Semester</th>
        <th style="width: 10%;">Equivalent</th>
      </tr>
    </thead>
    <tbody>
      {% for item in restricted_electives_group1 %}
      <tr>
        <td>PSYX <span data-field="restricted_electives_group1[{{ loop.index0 }}].course_code">{{ item.course_code }}</span></td>
        <td><span data-field="restricted_electives_group1[{{ loop.index0 }}].credits">{{ item.credits }}</span></td>
        <td><span data-field="restricted_electives_group1[{{ loop.index0 }}].description">{{ item.description }}</span></td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <!-- Group 2 -->
  <h4 style="font-size: 12pt; margin-top: 20px; margin-bottom: 5px;">Group 2:</h4>
  <table>
    <thead>
      <tr class="header-table">
        <th style="width: 10%;">Course</th>
        <th style="width: 10%;">Credits</th>
        <th style="width: 60%;">Description</th>
        <th style="width: 10%;">Grade</th>
        <th style="width: 10%;">Semester</th>
        <th style="width: 10%;">Equivalent</th>
      </tr>
    </thead>
    <tbody>
      {% for item in restricted_electives_group2 %}
      <tr>
        <td>PSYX <span data-field="restricted_electives_group2[{{ loop.index0 }}].course_code">{{ item.course_code }}</span></td>
        <td><span data-field="restricted_electives_group2[{{ loop.index0 }}].credits">{{ item.credits }}</span></td>
        <td><span data-field="restricted_electives_group2[{{ loop.index0 }}].description">{{ item.description }}</span></td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <!-- Total Credits -->
  <div style="margin-top: 40px;">
    <p style="font-weight: bold;">Total credits required for minor: <span data-field="total_credits">{{ total_credits }}</span></p>
  </div>

  <p style="font-size: 10pt; margin-top: 50px;">*May satisfy General Education requirements.</p>
  <p style="font-size: 10pt;">Certain courses in this program have prerequisites; students should check the course descriptions in the General Bulletin for required prerequisites.</p>
</div>