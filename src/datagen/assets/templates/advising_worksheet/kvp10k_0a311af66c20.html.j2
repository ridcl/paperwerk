<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child { page-break-after: auto; }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
  }
  td {
    padding: 8px 10px;
    border: 1px solid #ccc;
    text-align: left;
  }
  .header-row td {
    font-weight: bold;
    background-color: #f0f0f0;
  }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px;">
    <div>
      <div style="font-size: 30px; font-weight: bold;">MSU BILLINGS</div>
    </div>
    <div>
      <h1 style="font-size: 18px; font-weight: bold;">ADVISING WORKSHEET</h1>
      <p style="font-size: 14px;">MINOR IN SPANISH</p>
      <p style="font-size: 14px;">GENERAL BULLETIN 2015-2017</p>
      <div style="margin-top: 50px;">
        <label style="font-size: 12px;">TRANSFER INSTITUTION(S):</label>
        <div style="border-bottom: 1px solid #000; width: 300px;" data-field="transfer_institution">{{ transfer_institution }}</div>
      </div>
    </div>
  </div>

  <div style="display: flex; justify-content: space-between; margin-bottom: 30px;">
    <div>
      <p style="font-size: 14px;">Montana State University Billings</p>
      <p style="font-size: 14px;">Advising and Career Services</p>
      <p style="font-size: 14px;">Phone: {{ contact_phone }}</p>
      <p style="font-size: 14px;">Fax: {{ contact_fax }}</p>
      <p style="font-size: 14px;">advising@msubillings.edu</p>
      <p style="font-size: 14px;">www.msubillings.edu/advice/</p>
    </div>
    <div style="text-align: right;">
      <p style="font-size: 14px;">Name: <span style="border-bottom: 1px solid #000; display: inline-block; width: 200px;">{{ student_name }}</span></p>
      <p style="font-size: 14px;">Student ID #: <span style="border-bottom: 1px solid #000; display: inline-block; width: 150px;">{{ student_id }}</span></p>
    </div>
  </div>

  <table>
    <thead>
      <tr class="header-row">
        <td style="width: 15%;">Course</td>
        <td style="width: 15%;">Credits</td>
        <td style="width: 15%;">Grade</td>
        <td style="width: 15%;">Semester</td>
        <td style="width: 40%;">Equivalent</td>
      </tr>
    </thead>
    <tbody>
      {% for item in required_courses %}
      <tr>
        <td><span data-field="required_courses[{{ loop.index0 }}].course_code">{{ item.course_code }}</span></td>
        <td><span data-field="required_courses[{{ loop.index0 }}].credits">{{ item.credits }}</span></td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
      {% endfor %}
      <tr>
        <td colspan="2" style="text-align: right; font-weight: bold;">Total credits required for minor</td>
        <td></td>
        <td></td>
        <td><span data-field="total_credits">{{ total_credits }}</span></td>
      </tr>
    </tbody>
  </table>

  <p style="margin-top: 40px; font-size: 12px;">
    &amp;Students with fluency may receive credit for these courses through the challenge mechanism.
  </p>
  <p style="font-size: 12px;">
    Certain courses in this program have prerequisites; students should check the course descriptions in the General Bulletin for required prerequisites.
  </p>
</div>