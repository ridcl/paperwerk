<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1, h2, h3 { font-weight: bold; }
  table { width: 100%; border-collapse: collapse; margin-top: 10px; margin-bottom: 20px; }
  th, td { padding: 8px; text-align: left; border-bottom: 1px solid #ccc; }
  .header-info { display: flex; justify-content: space-between; margin-bottom: 30px; }
  .section-title { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      <h1 style="font-size: 24px; margin: 0;">MSU BILLINGS</h1>
      <p style="margin: 5px 0 0 0;">Montana State University Billings</p>
      <p style="margin: 0;">Advising and Career Services</p>
      <p style="margin: 0;">Phone: <span data-field="phone_number">{{ phone_number }}</span></p>
      <p style="margin: 0;">Fax: <span data-field="fax_number">{{ fax_number }}</span></p>
      <p style="margin: 0;">advising@msubillings.edu</p>
      <p style="margin: 0;">www.msubillings.edu/advise/</p>
    </div>
    <div style="text-align: right;">
      <p style="font-weight: bold;">ADVISING WORKSHEET</p>
      <p style="font-size: 14px;">MINOR IN NATIVE AMERICAN STUDIES</p>
      <p style="font-size: 14px;">GENERAL BULLETIN 2015-2017</p>
      <div style="margin-top: 50px;">
        <p style="font-weight: bold;">TRANSFER INSTITUTION(S):</p>
        <p><span data-field="transfer_institution">{{ transfer_institution }}</span></p>
      </div>
    </div>
  </div>

  <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
    <div>
      <p style="font-weight: bold;">Name:</p>
      <p><span data-field="full_name">{{ full_name }}</span></p>
    </div>
    <div>
      <p style="font-weight: bold;">Student ID #:</p>
      <p><span data-field="student_id">{{ student_id }}</span></p>
    </div>
  </div>

  <div class="section-title">Required Courses</div>
  <table>
    <thead>
      <tr>
        <th style="width: 10%;">Course</th>
        <th style="width: 15%;">Credits</th>
        <th style="width: 60%;">Description</th>
        <th style="width: 15%;">Grade</th>
        <th style="width: 10%;">Semester</th>
        <th style="width: 10%;">Equivalent</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="required_courses[0].course_code">{{ required_courses[0].course_code }}</span></td>
        <td><span data-field="required_courses[0].credits">{{ required_courses[0].credits }}</span></td>
        <td><span data-field="required_courses[0].description">{{ required_courses[0].description }}</span></td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
      <tr>
        <td><span data-field="required_courses[1].course_code">{{ required_courses[1].course_code }}</span></td>
        <td><span data-field="required_courses[1].credits">{{ required_courses[1].credits }}</span></td>
        <td><span data-field="required_courses[1].description">{{ required_courses[1].description }}</span></td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
      <tr>
        <td><span data-field="required_courses[2].course_code">{{ required_courses[2].course_code }}</span></td>
        <td><span data-field="required_courses[2].credits">{{ required_courses[2].credits }}</span></td>
        <td><span data-field="required_courses[2].description">{{ required_courses[2].description }}</span></td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
    </tbody>
  </table>

  <div class="section-title">At least 3 credits chosen from the following:</div>
  <table>
    <thead>
      <tr>
        <th style="width: 10%;">Course</th>
        <th style="width: 15%;">Credits</th>
        <th style="width: 60%;">Description</th>
        <th style="width: 15%;">Grade</th>
        <th style="width: 10%;">Semester</th>
        <th style="width: 10%;">Equivalent</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="elective_group_1[0].course_code">{{ elective_group_1[0].course_code }}</span></td>
        <td><span data-field="elective_group_1[0].credits">{{ elective_group_1[0].credits }}</span></td>
        <td><span data-field="elective_group_1[0].description">{{ elective_group_1[0].description }}</span></td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
      <tr>
        <td><span data-field="elective_group_1[1].course_code">{{ elective_group_1[1].course_code }}</span></td>
        <td><span data-field="elective_group_1[1].credits">{{ elective_group_1[1].credits }}</span></td>
        <td><span data-field="elective_group_1[1].description">{{ elective_group_1[1].description }}</span></td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
      <tr>
        <td><span data-field="elective_group_1[2].course_code">{{ elective_group_1[2].course_code }}</span></td>
        <td><span data-field="elective_group_1[2].credits">{{ elective_group_1[2].credits }}</span></td>
        <td><span data-field="elective_group_1[2].description">{{ elective_group_1[2].description }}</span></td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
    </tbody>
  </table>

  <div class="section-title">Restricted Electives</div>
  <p style="font-size: 12px;">At least 9 credits from among the following courses chosen in consultation with Native American Studies staff/advisor:</p>
  <table>
    <thead>
      <tr>
        <th style="width: 10%;">Course</th>
        <th style="width: 15%;">Credits</th>
        <th style="width: 60%;">Description</th>
        <th style="width: 15%;">Grade</th>
        <th style="width: 10%;">Semester</th>
        <th style="width: 10%;">Equivalent</th>
      </tr>
    </thead>
    <tbody>
      {% for item in restricted_electives %}
      <tr>
        <td><span data-field="restricted_electives[{{ loop.index0 }}].course_code">{{ item.course_code }}</span></td>
        <td><span data-field="restricted_electives[{{ loop.index0 }}].credits">{{ item.credits }}</span></td>
        <td><span data-field="restricted_electives[{{ loop.index0 }}].description">{{ item.description }}</span></td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div style="margin-top: 40px;">
    <p style="font-weight: bold;">Total minimum credits required for minor</p>
    <p style="font-size: 1.2em;"><span data-field="total_credits">{{ total_credits }}</span></p>
  </div>

  <p style="font-size: 10px; margin-top: 50px;">*May satisfy General Education requirements.</p>
  <p style="font-size: 10px;">Certain courses in this program have prerequisites; students should check the course descriptions for required prerequisites.</p>
</div>