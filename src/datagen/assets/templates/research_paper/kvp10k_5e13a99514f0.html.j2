<!DOCTYPE html>
<html>
<head>
    <title>Document</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3, h4 {
            font-family: "DejaVu Sans", "Liberation Sans", Arial, Helvetica, sans-serif;
        }
        p {
            line-height: 1.5;
            text-align: justify;
        }
        .abstract {
            margin-top: 20px;
            margin-bottom: 20px;
        }
        .figure-caption {
            font-size: 0.9em;
            text-align: center;
            margin-top: 5px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
            margin-bottom: 15px;
        }
        td {
            padding: 8px;
            text-align: left;
        }
        .center-text {
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="page">
        <h1 style="text-align: center; font-size: 18pt; margin-bottom: 10px;">Multiple camera, laser rangefinder, and encoder data fusion for navigation of a differentially steered 3-wheeled autonomous vehicle</h1>
        <div style="text-align: center; margin-bottom: 30px;">
            <span data-field="author_name_1">{{ author_name_1 }}</span>, <span data-field="author_name_2">{{ author_name_2 }}</span>, <span data-field="author_name_3">{{ author_name_3 }}</span>
            <div style="font-size: 0.9em; margin-top: 5px;">
                <span data-field="affiliation_1">{{ affiliation_1 }}</span>, <span data-field="affiliation_2">{{ affiliation_2 }}</span>
            </div>
        </div>

        <div class="abstract">
            <h2>ABSTRACT</h2>
            <p>
                <span data-field="abstract_content">{{ abstract_content }}</span>
            </p>
        </div>
    </div>

    <div class="page">
        <h2>1. INTRODUCTION</h2>
        <p>
            <span data-field="intro_content_1">{{ intro_content_1 }}</span>
        </p>

        <div style="text-align: center; margin-top: 20px;">
            <img src="placeholder_image_1.png" alt="Figure 1" style="max-width: 80%; height: auto;">
            <p class="figure-caption">Figure 1. Navigator – a 3-wheeled differentially driven autonomous vehicle</p>
        </div>

        <h2>2. VEHICLE DESIGN</h2>
        <p>
            <span data-field="vehicle_design_content_1">{{ vehicle_design_content_1 }}</span>
        </p>
        <p>
            <span data-field="vehicle_design_content_2">{{ vehicle_design_content_2 }}</span>
        </p>
    </div>

    <div class="page">
        <h2>3. SENSORS AND SENSOR FUSION</h2>
        <p>
            <span data-field="sensor_fusion_content_1">{{ sensor_fusion_content_1 }}</span>
        </p>

        <h3>3.1 Charge Coupled Device cameras and Frame Grabbers</h3>
        <p>
            <span data-field="ccd_camera_content">{{ ccd_camera_content }}</span>
        </p>

        <div style="text-align: center; margin-top: 20px;">
            <img src="placeholder_image_2.png" alt="Figure 2" style="max-width: 80%; height: auto;">
            <p class="figure-caption">Figure 2. Camera projections relative to the vehicle</p>
        </div>

        <h3>3.2 Laser Rangefinder</h3>
        <p>
            <span data-field="laser_rangefinder_content">{{ laser_rangefinder_content }}</span>
        </p>

        <div style="text-align: center; margin-top: 20px;">
            <img src="placeholder_image_3.png" alt="Figure 3" style="max-width: 80%; height: auto;">
            <p class="figure-caption">Figure 3. Laser rangefinder data (range in meters)</p>
        </div>

        <h3>3.3 Encoders</h3>
        <p>
            <span data-field="encoder_content">{{ encoder_content }}</span>
        </p>
    </div>

    <div class="page">
        <h3>3.4 Evidence Grids</h3>
        <p>
            <span data-field="evidence_grid_content_1">{{ evidence_grid_content_1 }}</span>
        </p>

        <div style="text-align: center; margin-top: 20px;">
            <img src="placeholder_image_4.png" alt="Figure 4" style="max-width: 80%; height: auto;">
            <p class="figure-caption">Figure 4. Image of line to evidence grid representation</p>
        </div>

        <p>
            <span data-field="evidence_grid_content_2">{{ evidence_grid_content_2 }}</span>
        </p>

        <h3>3.5 Vector Field Histograms</h3>
        <p>
            <span data-field="vfh_content_1">{{ vfh_content_1 }}</span>
        </p>
        <p>
            <span data-field="vfh_content_2">{{ vfh_content_2 }}</span>
        </p>
        <div style="text-align: center; margin-top: 10px;">
            <p>POD = k(a b d)</p>
        </div>
    </div>

    <div class="page">
        <p>
            <span data-field="vfh_content_3">{{ vfh_content_3 }}</span>
        </p>
        <p>
            <span data-field="vfh_content_4">{{ vfh_content_4 }}</span>
        </p>
        <p>
            <span data-field="vfh_content_5">{{ vfh_content_5 }}</span>
        </p>

        <div style="text-align: center; margin-top: 20px;">
            <img src="placeholder_image_5.png" alt="Figure 5" style="max-width: 80%; height: auto;">
            <p class="figure-caption">Figure 5. Evidence grid with polar sector shown.</p>
        </div>

        <p>
            <span data-field="vfh_content_6">{{ vfh_content_6 }}</span>
        </p>

        <h2>4. NAVIGATION</h2>
        <p>
            <span data-field="navigation_content_1">{{ navigation_content_1 }}</span>
        </p>
    </div>

    <div class="page">
        <p>
            <span data-field="navigation_content_2">{{ navigation_content_2 }}</span>
        </p>

        <h3>4.1 Passability Representation</h3>
        <p>
            <span data-field="passability_content_1">{{ passability_content_1 }}</span>
        </p>
        <div style="text-align: center; margin-top: 10px;">
            <p>pass = 1 / (1 + POD)</p>
        </div>
        <p>
            <span data-field="passability_content_2">{{ passability_content_2 }}</span>
        </p>

        <h3>4.2 Alleyway Selection</h3>
        <p>
            <span data-field="alleyway_content_1">{{ alleyway_content_1 }}</span>
        </p>
    </div>

    <div class="page">
        <p>
            <span data-field="navigation_content_3">{{ navigation_content_3 }}</span>
        </p>

        <div style="text-align: center; margin-top: 20px;">
            <img src="placeholder_image_6.png" alt="Figure 6" style="max-width: 80%; height: auto;">
            <p class="figure-caption">Figure 6. Polar passability plot showing raw, filtered, and scaled values</p>
        </div>

        <h2>5. CONCLUSION</h2>
        <p>
            <span data-field="conclusion_content_1">{{ conclusion_content_1 }}</span>
        </p>

        <h3>5.1 Vehicle Performance</h3>
        <p>
            <span data-field="performance_content_1">{{ performance_content_1 }}</span>
        </p>

        <h3>5.2 Future Work</h3>
        <p>
            <span data-field="future_work_content_1">{{ future_work_content_1 }}</span>
        </p>
        <p>
            <span data-field="future_work_content_2">{{ future_work_content_2 }}</span>
        </p>
        <p>
            <span data-field="future_work_content_3">{{ future_work_content_3 }}</span>
        </p>
    </div>

    <div class="page">
        <h2>ACKNOWLEDGEMENTS</h2>
        <p>
            <span data-field="acknowledgements_content_1">{{ acknowledgements_content_1 }}</span>
        </p>
        <ul style="list-style-type: disc; padding-left: 40px;">
            <li><span data-field="sponsor_1">{{ sponsor_1 }}</span> - industrial computer</li>
            <li><span data-field="sponsor_2">{{ sponsor_2 }}</span> - electric motors</li>
            <li><span data-field="sponsor_3">{{ sponsor_3 }}</span> - programmable logic controller</li>
            <li><span data-field="sponsor_4">{{ sponsor_4 }}</span> - laser rangefinder</li>
            <li><span data-field="sponsor_5">{{ sponsor_5 }}</span> - tools and financial support</li>
            <li><span data-field="sponsor_6">{{ sponsor_6 }}</span> - tools</li>
            <li><span data-field="sponsor_7">{{ sponsor_7 }}</span> - financial support</li>
        </ul>

        <h2>REFERENCES</h2>
        <ol>
            <li><span data-field="ref_1">{{ reference_1 }}</span></li>
            <li><span data-field="ref_2">{{ reference_2 }}</span></li>
            <li><span data-field="ref_3">{{ reference_3 }}</span></li>
            <li><span data-field="ref_4">{{ reference_4 }}</span></li>
            <li><span data-field="ref_5">{{ reference_5 }}</span></li>
            <li><span data-field="ref_6">{{ reference_6 }}</span></li>
            <li><span data-field="ref_7">{{ reference_7 }}</span></li>
            <li><span data-field="ref_8">{{ reference_8 }}</span></li>
            <li><span data-field="ref_9">{{ reference_9 }}</span></li>
            <li><span data-field="ref_10">{{ reference_10 }}</span></li>
        </ol>
    </div>
</body>
</html>