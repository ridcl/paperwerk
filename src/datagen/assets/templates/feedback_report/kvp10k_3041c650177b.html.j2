        <th style="width: 10%;">Total</th>
        <th style="width: 10%;">AUR</th>
      </tr>
    </thead>
    <tbody>
      {% for item in parents_feedback_items %}
      <tr>
        <td>{{ loop.index }}</td>
        <td><span data-field="parents_feedback_items[{{ loop.index0 }}].parameter">{{ item.parameter }}</span></td>
        {% for dept in departments %}
        <td><span data-field="parents_feedback_items[{{ loop.index0 }}].scores[{{ dept.id }}]">{{ item.scores[dept.id] }}</span></td>
        {% endfor %}
        <td><span data-field="parents_feedback_items[{{ loop.index0 }}].total">{{ item.total }}</span></td>
        <td><span data-field="parents_feedback_items[{{ loop.index0 }}].aur">{{ item.aur }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
