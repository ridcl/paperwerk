<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  /* Basic styling to mimic document structure */
  .header-info {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 30px;
  }
  .company-logo {
    /* Placeholder for logo visual */
    font-size: 40px;
    line-height: 1;
  }
  .contact-details {
    text-align: right;
  }
  .section-title {
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
    border-bottom: 1px solid #ccc;
    padding-bottom: 5px;
  }
  .form-row {
    display: flex;
    margin-bottom: 15px;
    align-items: flex-start;
  }
  .form-row > div {
    flex: 1;
  }
  .label-col {
    flex-basis: 30%;
    padding-right: 20px;
  }
  .input-col {
    flex-basis: 70%;
  }
  .full-width-field {
    width: 100%;
    border-bottom: 1px solid #000;
    margin-top: 5px;
    padding-bottom: 2px;
  }
  .checkbox-group {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 10px;
  }
  .checkbox-item {
    display: flex;
    align-items: center;
    margin-bottom: 10px;
  }
  .checkbox-item input[type="checkbox"] {
    margin-right: 8px;
  }
</style>

<div class="page">
  <p>Please complete this Vendor Information Request along with the attached W-9 form.</p>
  <p>Email, mail, or fax to the <span data-field="organization.name">{{ organization.name }}</span> Purchasing Department, using the information below.</p>
  <div style="text-align: right; margin-bottom: 20px;">
    <button style="padding: 8px 15px; border: 1px solid #000; background-color: #fff;">Print Form</button>
  </div>

  <div class="header-info">
    <div class="company-logo">
      <!-- Placeholder for logo -->
      <span style="font-size: 50px;">U</span>
    </div>
    <div class="contact-details">
      <p>Phone: <span data-field="organization.phone">{{ organization.phone }}</span></p>
      <p>Fax: <span data-field="organization.fax">{{ organization.fax }}</span></p>
      <p>E-Mail: <span data-field="organization.email">{{ organization.email }}</span></p>
    </div>
  </div>

  <h2 class="section-title">SECTION 1: VENDOR INFORMATION</h2>

  <div class="form-row">
    <div class="label-col">Your Company Identification Number (FEIN):</div>
    <div class="input-col"><span class="full-width-field">{{ vendor_ein }}</span></div>
  </div>

  <div class="form-row">
    <div class="label-col">Legal Business or Individual Name</div>
    <div class="input-col"><span class="full-width-field">{{ vendor_legal_name }}</span></div>
  </div>

  <div class="form-row">
    <div class="label-col">Parent Company Name (if different than above)</div>
    <div class="input-col"><span class="full-width-field">{{ vendor_parent_name }}</span></div>
  </div>

  <div class="form-row">
    <div class="label-col">Physical Address</div>
    <div class="input-col">
      <div style="display: flex; justify-content: space-between;">
        <div style="flex-basis: 30%;">
          <span class="full-width-field">{{ vendor_address.street }}</span>
        </div>
        <div style="flex-basis: 20%;">
          <span class="full-width-field">{{ vendor_address.city }}</span>
        </div>
        <div style="flex-basis: 20%;">
          <span class="full-width-field">{{ vendor_address.state }}</span>
        </div>
        <div style="flex-basis: 15%;">
          <span class="full-width-field">{{ vendor_address.zip }}</span>
        </div>
      </div>
    </div>
  </div>

  <div class="form-row">
    <div class="label-col">Purchasing Contact Name</div>
    <div class="input-col"><span class="full-width-field">{{ vendor_contact_name }}</span></div>
  </div>

  <div class="form-row">
    <div class="label-col">PO Telephone:</div>
    <div class="input-col"><span class="full-width-field">{{ vendor_po_phone }}</span></div>
  </div>

  <div class="form-row">
    <div class="label-col">Remittance Address, if different than above</div>
    <div class="input-col">
      <div style="display: flex; justify-content: space-between;">
        <div style="flex-basis: 30%;">
          <span class="full-width-field">{{ vendor_remittance_address.street }}</span>
        </div>
        <div style="flex-basis: 20%;">
          <span class="full-width-field">{{ vendor_remittance_address.city }}</span>
        </div>
        <div style="flex-basis: 20%;">
          <span class="full-width-field">{{ vendor_remittance_address.state }}</span>
        </div>
        <div style="flex-basis: 15%;">
          <span class="full-width-field">{{ vendor_remittance_address.zip }}</span>
        </div>
      </div>
    </div>
  </div>

  <div class="form-row">
    <div class="label-col">Accounts Receivable Contact Name</div>
    <div class="input-col"><span class="full-width-field">{{ vendor_ar_contact_name }}</span></div>
  </div>

  <div class="form-row">
    <div class="label-col">Type of product or services your company provides:</div>
    <div class="input-col"><span class="full-width-field">{{ vendor_services_description }}</span></div>
  </div>

  <div class="form-row">
    <div class="label-col">Name of person at IVCC requesting this information:</div>
    <div class="input-col"><span class="full-width-field">{{ ivcc_requester_name }}</span></div>
  </div>

  <h2 class="section-title" style="margin-top: 40px;">SECTION 2: ILLINOIS DEPARTMENT OF CENTRAL MANAGEMENT SERVICES BUSINESS ENTERPRISE PROGRAM CLASSIFICATION</h2>

  <div class="checkbox-group">
    <div class="checkbox-item">
      <input type="checkbox">
      <label><span data-field="classification.african_american_male_business">{{ classification.african_american_male_business }}</span></label>
    </div>
    <div class="checkbox-item">
      <input type="checkbox">
      <label><span data-field="classification.native_american_asian_male_business">{{ classification.native_american_asian_male_business }}</span></label>
    </div>
    <div class="checkbox-item">
      <input type="checkbox">
      <label><span data-field="classification.african_american_female_business">{{ classification.african_american_female_business }}</span></label>
    </div>
    <div class="checkbox-item">
      <input type="checkbox">
      <label><span data-field="classification.native_american_asian_female_business">{{ classification.native_american_asian_female_business }}</span></label>
    </div>
    <div class="checkbox-item">
      <input type="checkbox">
      <label><span data-field="classification.hispanic_american_male_business">{{ classification.hispanic_american_male_business }}</span></label>
    </div>
    <div class="checkbox-item">
      <input type="checkbox">
      <label><span data-field="classification.caucasian_female_business">{{ classification.caucasian_female_business }}</span></label>
    </div>
    <div class="checkbox-item">
      <input type="checkbox">
      <label><span data-field="classification.hispanic_american_female_business">{{ classification.hispanic_american_female_business }}</span></label>
    </div>
    <div class="checkbox-item">
      <input type="checkbox">
      <label><span data-field="classification.persons_with_disabilities_enterprise">{{ classification.persons_with_disabilities_enterprise }}</span></label>
    </div>
    <div class="checkbox-item">
      <input type="checkbox">
      <label><span data-field="classification.asian_american_male_business">{{ classification.asian_american_male_business }}</span></label>
    </div>
    <div class="checkbox-item">
      <input type="checkbox">
      <label><span data-field="classification.veteran_owned_business">{{ classification.veteran_owned_business }}</span></label>
    </div>
    <div class="checkbox-item">
      <input type="checkbox">
      <label><span data-field="classification.asian_american_female_business">{{ classification.asian_american_female_business }}</span></label>
    </div>
    <div class="checkbox-item">
      <input type="checkbox">
      <label><span data-field="classification.sheltered_workshop">{{ classification.sheltered_workshop }}</span></label>
    </div>
  </div>

  <h2 class="section-title" style="margin-top: 40px;">SECTION 3: VENDOR CLASSIFICATION</h2>

  <div class="checkbox-group">
    <div class="checkbox-item">
      <input type="checkbox">
      <label><span data-field="vendor_classification.us_citizen">{{ vendor_classification.us_citizen }}</span></label>
    </div>
    <div class="checkbox-item">
      <input type="checkbox">
      <label><span data-field="vendor_classification.foreign_vendor_us_presence">{{ vendor_classification.foreign_vendor_us_presence }}</span></label>
    </div>
    <div class="checkbox-item">
      <input type="checkbox">
      <label><span data-field="vendor_classification.non_resident_alien">{{ vendor_classification.non_resident_alien }}</span></label>
    </div>
  </div>

  <div class="checkbox-group" style="margin-top: 20px;">
    <div class="checkbox-item">
      <input type="checkbox">
      <label><span data-field="vendor_classification.please_attach_w9_form">{{ vendor_classification.please_attach_w9_form }}</span></label>
    </div>
    <div class="checkbox-item">
      <input type="checkbox">
      <label><span data-field="vendor_classification.please_attach_w8ben_form">{{ vendor_classification.please_attach_w8ben_form }}</span></label>
    </div>
    <div class="checkbox-item">
      <input type="checkbox">
      <label><span data-field="vendor_classification.please_attach_w8ben_e_w_w8exp_form">{{ vendor_classification.please_attach_w8ben_e_w_w8exp_form }}</span></label>
    </div>
  </div>

</div>