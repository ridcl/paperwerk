<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; }
  h1, h2, h3 { text-align: center; margin-bottom: 0.5em; }
  .header-info { text-align: center; margin-bottom: 30px; }
  .section { margin-bottom: 25px; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 15px; }
  .form-label { flex-basis: 30%; }
  .form-input { flex-basis: 65%; border-bottom: 1px solid #000; }
  .table-container { width: 100%; border-collapse: collapse; margin-top: 15px; }
  .table-container th, .table-container td { border: 1px solid #000; padding: 8px; text-align: left; }
  .table-container th { background-color: #f0f0f0; }
  .signature-line { display: flex; justify-content: space-between; margin-top: 50px; }
</style>
<div class="page">
  <div class="header-info">
    <img src="placeholder_logo.png" alt="Logo" style="width: 100px; height: auto; margin-bottom: 10px;">
    <h1>Recommendation Form for Middle Level Education</h1>
    <h2>School of Education</h2>
    <h3><span data-field="institution_name">{{ institution_name }}</span></h3>
  </div>

  <div class="section" style="text-align: justify; font-size: 0.9em;">
    <p>Note: It is important for the student to supply the professor(s) with this form. A stamped envelope addressed to: <span data-field="recipient_name">{{ recipient_name }}</span> should be included for professors not teaching on the Clayton State campus. Those teaching on campus may return the form to the student in a sealed/signed envelope or send it through campus mail. (This form can be found at <a href="http://www.clayton.edu/teached/Application-info">http://www.clayton.edu/teached/Application-info</a>).</p>
  </div>

  <div class="section">
    <p>STUDENT COMPLETES TOP PORTION</p>
    <div class="form-row">
      <div class="form-label">Student's Full Name:</div>
      <div class="form-input"><span data-field="full_name">{{ full_name }}</span></div>
    </div>
    <div class="form-row">
      <div class="form-label">Student's Lake No.:</div>
      <div class="form-input"><span data-field="student_id">{{ student_id }}</span></div>
    </div>
    <div class="form-row">
      <div class="form-label">Concentrations (2 – list both):</div>
      <div class="form-input"><span data-field="concentrations">{{ concentrations }}</span></div>
    </div>
  </div>

  <div class="section">
    <p>FACULTY MEMBER COMPLETES PORTION BELOW</p>
    <div class="form-row">
      <div class="form-label">Semester/Year Professor Taught You:</div>
      <div class="form-input"><span data-field="teaching_period">{{ teaching_period }}</span></div>
    </div>
  </div>

  <div class="section">
    <p>Student Attribute</p>
    <table class="table-container">
      <thead>
        <tr>
          <th style="width: 5%;">#</th>
          <th style="width: 60%;">Attribute</th>
          <th style="width: 15%;">Below Average</th>
          <th style="width: 15%;">Average</th>
          <th style="width: 15%;">Above Average</th>
          <th style="width: 10%;">N/A</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>1.</td>
          <td>Student takes responsibility for own actions and consequences of those actions.</td>
          <td><input type="checkbox"></td>
          <td><input type="checkbox"></td>
          <td><input type="checkbox"></td>
          <td><input type="checkbox"></td>
        </tr>
        <tr>
          <td>2.</td>
          <td>Oral communication skills – correct standard English – usage & socially appropriate skills.</td>
          <td><input type="checkbox"></td>
          <td><input type="checkbox"></td>
          <td><input type="checkbox"></td>
          <td><input type="checkbox"></td>
        </tr>
        <tr>
          <td>3.</td>
          <td>Written communication skills – correct standard English usage</td>
          <td><input type="checkbox"></td>
          <td><input type="checkbox"></td>
          <td><input type="checkbox"></td>
          <td><input type="checkbox"></td>
        </tr>
        <tr>
          <td>4.</td>
          <td>Knows and practices socially appropriate interpersonal skills; interacts well with peers.</td>
          <td><input type="checkbox"></td>
          <td><input type="checkbox"></td>
          <td><input type="checkbox"></td>
          <td><input type="checkbox"></td>
        </tr>
        <tr>
          <td>5.</td>
          <td>Initiative and industriousness – takes responsibility for work; works hard but efficiently; uses time efficiently; meets deadlines; has organizational skills.</td>
          <td><input type="checkbox"></td>
          <td><input type="checkbox"></td>
          <td><input type="checkbox"></td>
          <td><input type="checkbox"></td>
        </tr>
        <tr>
          <td>6.</td>
          <td>Attendance – is punctual and has regular attendance.</td>
          <td><input type="checkbox"></td>
          <td><input type="checkbox"></td>
          <td><input type="checkbox"></td>
          <td><input type="checkbox"></td>
        </tr>
        <tr>
          <td>7.</td>
          <td>Honest, has integrity</td>
          <td><input type="checkbox"></td>
          <td><input type="checkbox"></td>
          <td><input type="checkbox"></td>
          <td><input type="checkbox"></td>
        </tr>
        <tr>
          <td>8.</td>
          <td>Knowledge of content</td>
          <td><input type="checkbox"></td>
          <td><input type="checkbox"></td>
          <td><input type="checkbox"></td>
          <td><input type="checkbox"></td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="section">
    <p>Please indicate your overall recommendation for this potential teacher candidate.</p>
    <div class="form-row" style="margin-bottom: 10px;">
      <label style="flex-basis: auto; margin-right: 20px;">&nbsp;&nbsp;&nbsp;&nbsp; <input type="checkbox"> I strongly recommend</label>
      <div style="flex-basis: 100%; border-bottom: 1px solid #000; margin-top: 5px;"><span data-field="comments_strong_recommendation">{{ comments_strong_recommendation }}</span></div>
    </div>
    <div class="form-row" style="margin-bottom: 10px;">
      <label style="flex-basis: auto; margin-right: 20px;">&nbsp;&nbsp;&nbsp;&nbsp; <input type="checkbox"> I recommend</label>
      <div style="flex-basis: 100%; border-bottom: 1px solid #000; margin-top: 5px;"><span data-field="comments_recommendation">{{ comments_recommendation }}</span></div>
    </div>
    <div class="form-row" style="margin-bottom: 10px;">
      <label style="flex-basis: auto; margin-right: 20px;">&nbsp;&nbsp;&nbsp;&nbsp; <input type="checkbox"> I recommend with reservations</label>
      <div style="flex-basis: 100%; border-bottom: 1px solid #000; margin-top: 5px;"><span data-field="comments_reservations">{{ comments_reservations }}</span></div>
    </div>
    <div class="form-row" style="margin-bottom: 10px;">
      <label style="flex-basis: auto; margin-right: 20px;">&nbsp;&nbsp;&nbsp;&nbsp; <input type="checkbox"> I do not recommend</label>
      <div style="flex-basis: 100%; border-bottom: 1px solid #000; margin-top: 5px;"><span data-field="comments_do_not_recommend">{{ comments_do_not_recommend }}</span></div>
    </div>
  </div>

  <div class="section">
    <p>How well do you know the candidate (circle one):</p>
    <div style="text-align: center; margin-top: 10px;">
      <span style="margin: 0 15px;">Not Well</span>
      <span style="margin: 0 15px;">Well</span>
      <span style="margin: 0 15px;">Very Well</span>
    </div>
  </div>

  <div class="signature-line">
    <div>
      <p>Print Name: _________________________</p>
      <p>Institution: _________________________</p>
    </div>
    <div>
      <p>Signature: _________________________</p>
      <p>Department: _________________________</p>
      <p>Date: _________________________</p>
    </div>
  </div>
</div>