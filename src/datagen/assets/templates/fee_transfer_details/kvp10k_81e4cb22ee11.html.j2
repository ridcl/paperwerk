<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
  }
  td {
    padding: 8px 0;
    vertical-align: top;
  }
  .header {
    text-align: center;
    margin-bottom: 30px;
  }
  .header h1 {
    font-size: 18pt;
    margin: 0;
    font-weight: bold;
  }
  .header h2 {
    font-size: 14pt;
    margin: 5px 0 0 0;
    font-weight: normal;
  }
  .section-label {
    font-weight: bold;
    display: inline-block;
    width: 150px; /* Adjust as needed for alignment */
  }
</style>

<div class="page">
  <div class="header">
    <h1>BHARATI VIDYAPEETH</h1>
    <h2>(Deemed to be University)</h2>
    <h2>DENTAL COLLEGE AND HOSPITAL, SANGLI</h2>
    <h3>NEFT / RTGS STUDENT FEE TRANSFERRED DETAILS</h3>
  </div>

  <table>
    <tr>
      <td>Account Name -</td>
      <td><span data-field="account_name">{{ account_name }}</span></td>
    </tr>
    <tr>
      <td>Bank Name -</td>
      <td><span data-field="bank_name">{{ bank_name }}</span></td>
    </tr>
    <tr>
      <td>Sub. Member -</td>
      <td><span data-field="sub_member">{{ sub_member }}</span></td>
    </tr>
    <tr>
      <td>Account No. -</td>
      <td><span data-field="account_number">{{ account_number }}</span></td>
    </tr>
    <tr>
      <td>IFSC Code -</td>
      <td><span data-field="ifsc_code">{{ ifsc_code }}</span></td>
    </tr>
    <tr>
      <td>Fee</td>
      <td><span data-field="fee_amount">{{ fee_amount }}</span></td>
    </tr>
  </table>

  <table>
    <thead>
      <tr>
        <td style="width: 10%;">No.</td>
        <td style="width: 40%;">Detail</td>
        <td style="width: 50%;">Value</td>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>1</td>
        <td>Student Name -</td>
        <td><span data-field="student_name">{{ student_name }}</span></td>
      </tr>
      <tr>
        <td>2</td>
        <td>Current Year -</td>
        <td><span data-field="current_year">{{ current_year }}</span></td>
      </tr>
      <tr>
        <td>3</td>
        <td>Admission Year -</td>
        <td><span data-field="admission_year">{{ admission_year }}</span></td>
      </tr>
      <tr>
        <td>4</td>
        <td>Fee Deposited Amount -</td>
        <td><span data-field="fee_deposited_amount">{{ fee_deposited_amount }}</span></td>
      </tr>
      <tr>
        <td>5</td>
        <td>NEFT / RTGS – UTR No. -</td>
        <td><span data-field="utr_number">{{ utr_number }}</span></td>
      </tr>
      <tr>
        <td>6</td>
        <td>Bank Name -</td>
        <td><span data-field="transaction_bank_name">{{ transaction_bank_name }}</span></td>
      </tr>
      <tr>
        <td>7</td>
        <td>Account Name & Number From Which Fee Transferred</td>
        <td><span data-field="source_account_details">{{ source_account_details }}</span></td>
      </tr>
      <tr>
        <td>8</td>
        <td>Transaction Date -</td>
        <td><span data-field="transaction_date">{{ transaction_date }}</span></td>
      </tr>
      <tr>
        <td>9</td>
        <td>Signature of Students -</td>
        <td></td>
      </tr>
      <tr>
        <td>10</td>
        <td>Student Mobile No. -</td>
        <td><span data-field="student_mobile_no">{{ student_mobile_no }}</span></td>
      </tr>
      <tr>
        <td>11</td>
        <td>Email :-</td>
        <td><span data-field="email">{{ email }}</span></td>
      </tr>
    </tbody>
  </table>
</div>