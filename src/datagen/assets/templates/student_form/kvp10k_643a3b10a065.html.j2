<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1, h2, h3 { font-weight: bold; }
  .form-row { display: flex; margin-bottom: 10px; }
  .form-label { width: 150px; display: inline-block; }
  .form-input { border-bottom: 1px solid #000; flex-grow: 1; }
  .section-divider { border-top: 1px solid #000; margin: 20px 0; }
</style>

<div class="page">
  <div style="text-align: center; margin-bottom: 40px;">
    <h1 style="font-size: 24pt; margin: 0;">UNIVERSITY OF THE</h1>
    <h1 style="font-size: 36pt; margin: 0;">DISTRICT OF COLUMBIA</h1>
    <h2 style="font-size: 14pt; margin: 0;">DAVID A. CLARKE SCHOOL OF LAW</h2>
  </div>

  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
    <h2 style="margin: 0;">Student Biographical Information Form</h2>
    <div style="text-align: right;">
      <h3 style="margin: 0;">Office of the Registrar</h3>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    Please PRINT clearly or type
  </div>

  <div style="margin-bottom: 20px;">
    <div class="form-row" style="margin-bottom: 15px;">
      <div class="form-label">Entering:</div>
      <div class="form-input" style="width: 30%;">
        <span data-field="enrollment_status_type">{{ enrollment_status_type }}</span>
      </div>
      <div class="form-input" style="width: 30%;">
        <span data-field="enrollment_status_type_2">{{ enrollment_status_type_2 }}</span>
      </div>
      <div class="form-input" style="width: 30%;">
        Student ID: <span data-field="student_id">{{ student_id }}</span>
      </div>
    </div>

    <div class="form-row" style="margin-bottom: 15px;">
      <div class="form-label">Name:</div>
      <div class="form-input" style="width: 30%;">
        Last: <span data-field="full_name_last">{{ full_name_last }}</span>
      </div>
      <div class="form-input" style="width: 30%;">
        First: <span data-field="full_name_first">{{ full_name_first }}</span>
      </div>
      <div class="form-input" style="width: 30%;">
        MI
      </div>
    </div>

    <div class="form-row" style="margin-bottom: 15px;">
      <div class="form-label">DOB:</div>
      <div class="form-input" style="width: 30%;">
        <span data-field="dob_day">{{ dob_day }}</span>
      </div>
      <div class="form-input" style="width: 30%;">
        <span data-field="dob_month">{{ dob_month }}</span>
      </div>
      <div class="form-input" style="width: 30%;">
        <span data-field="dob_year">{{ dob_year }}</span>
      </div>
    </div>

    <div class="form-row" style="margin-bottom: 15px;">
      <div class="form-label">Gender:</div>
      <div class="form-input" style="width: 15%;">
        Male <input type="radio" name="gender" value="Male">
      </div>
      <div class="form-input" style="width: 15%;">
        Female <input type="radio" name="gender" value="Female">
      </div>
      <div class="form-input" style="width: 15%;">
        Other <input type="radio" name="gender" value="Other">
      </div>
      <div class="form-label" style="margin-left: 30px;">Marital Status:</div>
      <div class="form-input" style="width: 15%;">
        Married <input type="radio" name="marital_status" value="Married">
      </div>
      <div class="form-input" style="width: 15%;">
        Single <input type="radio" name="marital_status" value="Single">
      </div>
      <div class="form-input" style="width: 15%;">
        Other <input type="radio" name="marital_status" value="Other">
      </div>
    </div>

    <div class="form-row" style="margin-bottom: 15px;">
      <div class="form-label">Phone Nos. (</div>
      <div class="form-input" style="width: 30%;">
        <span data-field="phone_number_primary">{{ phone_number_primary }}</span>
      </div>
      <div class="form-input" style="width: 15%;">
        (day)
      </div>
      <div class="form-input" style="width: 15%;">
        (evening)
      </div>
    </div>

    <div class="form-row" style="margin-bottom: 15px;">
      <div class="form-label">E-mail Address:</div>
      <div class="form-input" style="width: 80%;">
        <span data-field="email_address">{{ email_address }}</span>
      </div>
    </div>
  </div>

  <div class="section-divider"></div>

  <h3 style="margin-bottom: 15px;">LOCAL MAILING ADDRESS (If you do not have a local address, please leave blank; submit it to the Office of the Registrar as soon as possible after you have obtained it.)</h3>

  <div style="margin-bottom: 15px;">
    No., Street, Apt. #
  </div>
  <div style="margin-bottom: 15px;">
    <div class="form-row">
      <div class="form-label">City</div>
      <div class="form-input" style="width: 25%;">
        <span data-field="local_city">{{ local_city }}</span>
      </div>
      <div class="form-label">State</div>
      <div class="form-input" style="width: 25%;">
        <span data-field="local_state">{{ local_state }}</span>
      </div>
      <div class="form-label">Zip Code</div>
      <div class="form-input" style="width: 25%;">
        <span data-field="local_zip_code">{{ local_zip_code }}</span>
      </div>
    </div>
  </div>

  <div class="section-divider"></div>

  <h3 style="margin-bottom: 15px;">PERMANENT MAILING ADDRESS (if different)</h3>

  <div style="margin-bottom: 15px;">
    No., Street, Apt. #
  </div>
  <div style="margin-bottom: 15px;">
    <div class="form-row">
      <div class="form-label">City</div>
      <div class="form-input" style="width: 25%;">
        <span data-field="permanent_city">{{ permanent_city }}</span>
      </div>
      <div class="form-label">State</div>
      <div class="form-input" style="width: 25%;">
        <span data-field="permanent_state">{{ permanent_state }}</span>
      </div>
      <div class="form-label">Zip Code</div>
      <div class="form-input" style="width: 25%;">
        <span data-field="permanent_zip_code">{{ permanent_zip_code }}</span>
      </div>
    </div>
  </div>

  <div class="section-divider"></div>

  <h3 style="margin-bottom: 15px;">EMERGENCY CONTACT</h3>

  <div class="form-row" style="margin-bottom: 15px;">
    <div class="form-label">Name:</div>
    <div class="form-input" style="width: 60%;">
      <span data-field="emergency_contact_name">{{ emergency_contact_name }}</span>
    </div>
    <div class="form-label" style="margin-left: 30px;">Relationship:</div>
    <div class="form-input" style="width: 25%;">
      <span data-field="emergency_contact_relationship">{{ emergency_contact_relationship }}</span>
    </div>
  </div>

  <div class="form-row" style="margin-bottom: 15px;">
    <div class="form-label">Phone Nos. (</div>
    <div class="form-input" style="width: 30%;">
      <span data-field="emergency_phone_number">{{ emergency_phone_number }}</span>
    </div>
    <div class="form-input" style="width: 15%;">
      (day)
    </div>
    <div class="form-input" style="width: 15%;">
      (evening)
    </div>
  </div>

  <div style="margin-bottom: 15px;">
    No., Street, Apt. #
  </div>
  <div style="margin-bottom: 15px;">
    <div class="form-row">
      <div class="form-label">City</div>
      <div class="form-input" style="width: 25%;">
        <span data-field="emergency_city">{{ emergency_city }}</span>
      </div>
      <div class="form-label">State</div>
      <div class="form-input" style="width: 25%;">
        <span data-field="emergency_state">{{ emergency_state }}</span>
      </div>
      <div class="form-label">Zip Code</div>
      <div class="form-input" style="width: 25%;">
        <span data-field="emergency_zip_code">{{ emergency_zip_code }}</span>
      </div>
    </div>
  </div>

  <div class="section-divider"></div>

  <div class="form-row" style="margin-bottom: 20px;">
    <div class="form-label">Student Signature</div>
    <div class="form-input" style="width: 60%;">
      <!-- Signature line placeholder -->
    </div>
    <div class="form-label" style="margin-left: 30px;">Date</div>
    <div class="form-input" style="width: 25%;">
      <span data-field="signature_date">{{ signature_date }}</span>
    </div>
  </div>

  <div style="margin-top: 50px; font-size: 10pt;">
    ** Please submit updates to your email address, mailing address and phone number to the UDC Law Registrar's Office. **
  </div>

  <div style="text-align: center; margin-top: 80px; font-size: 10pt;">
    Practice Law. Promote Justice. Change Lives.
    <br>
    4340 Connecticut Avenue NW | Suite 208 | Washington, DC 20008 | 202.274.5114 | lawregistrar@udc.edu
  </div>
</div>