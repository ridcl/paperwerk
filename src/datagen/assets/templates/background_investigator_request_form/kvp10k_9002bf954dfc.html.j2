<style>
    @page { size: A4; margin: 0; }
    .page {
        width: 794px; height: 1123px;
        padding: 50px 60px; box-sizing: border-box;
        overflow: hidden; page-break-after: always;
        position: relative;
    }
    .page:last-child { page-break-after: auto; }
    /* Basic styling to mimic document structure */
    body { font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; }
    h1, h2 { text-align: center; margin-bottom: 20px; }
    .form-section { margin-bottom: 30px; }
    .line-item { display: flex; justify-content: space-between; margin-bottom: 15px; }
    .line-item div { width: 48%; }
    .signature-line { border-bottom: 1px solid #000; margin-top: 50px; margin-bottom: 50px; }
</style>

<div class="page">
    <header>
        <h1>Background Investigator Request Form</h1>
        <div style="text-align: center; margin-bottom: 30px;">
            <p><span data-field="organization.name">{{ organization.name }}</span></p>
            <p><span data-field="organization.address_line_1">{{ organization.address_line_1 }}</span></p>
            <p><span data-field="organization.address_line_2">{{ organization.address_line_2 }}</span></p>
            <p><span data-field="organization.phone">{{ organization.phone }}</span></p>
        </div>
    </header>

    <section class="form-section">
        <h2>Investigator Information</h2>
        <div class="line-item">
            <div>Investigator Name: <span class="signature-line" data-field="investigator_information">{{ investigator_information }}</span></div>
            <div>Date of Request: <span class="signature-line" data-field="investigator_name">{{ investigator_name }}</span></div>
        </div>
        <div class="line-item">
            <div>Signature: <span class="signature-line" data-field="date_of_request">{{ date_of_request }}</span></div>
            <div>Department: <span class="signature-line" data-field="signature">{{ signature }}</span></div>
        </div>
        <div class="line-item">
            <div>Badge/ID#: (required) <span class="signature-line" data-field="department">{{ department }}</span></div>
            <div>Phone: <span class="signature-line" data-field="badge_id">{{ badge_id }}</span></div>
        </div>
    </section>

    <section class="form-section">
        <h2>Information Requested</h2>
        <div class="line-item">
            <div>Student Name: <span class="signature-line" data-field="information_requested">{{ information_requested }}</span></div>
            <div>On-Campus Residence History: <span class="signature-line" data-field="student_name">{{ student_name }}</span></div>
        </div>
        <div class="line-item">
            <div>Disciplinary History: <span class="signature-line" data-field="on_campus_residence_history">{{ on_campus_residence_history }}</span></div>
            <div>Other (please specify): <span class="signature-line" data-field="disciplinary_history">{{ disciplinary_history }}</span></div>
        </div>
        <div style="height: 100px; border-bottom: 1px solid #000; margin-top: 20px;" data-field="other">{{ other }}</div>
    </section>

    <p style="text-align: center; margin-top: 50px;">Attach signed release form.</p>

    <div style="border-top: 1px solid #000; margin-top: 80px; margin-bottom: 20px;"></div>

    <section class="form-section">
        <h3 style="text-align: center;">Student Affairs Office Use Only</h3>
        <div class="line-item">
            <div>ID Verified and Release Received By: <span class="signature-line" data-field="student_affairs_office_use_only">{{ student_affairs_office_use_only }}</span></div>
            <div>Completion Date: <span class="signature-line" data-field="id_verified_and_release_received_by">{{ id_verified_and_release_received_by }}</span></div>
        </div>
        <div class="line-item">
            <div>Completed by: <span class="signature-line" data-field="completion_date">{{ completion_date }}</span></div>
            <div>Voice Mail: <span class="signature-line" data-field="completed_by">{{ completed_by }}</span> Fax: <span class="signature-line" data-field="voice_mail">{{ voice_mail }}</span> Email: <span class="signature-line" data-field="fax">{{ fax }}</span></div>
        </div>
        <div class="line-item" style="margin-top: 20px;">
            <div>Completed via: 
                <span style="display: inline-block; margin-right: 20px;">In Person</span>
                <span style="display: inline-block; margin-right: 20px;">Phone</span>
            </div>
        </div>
    </section>
</div>