<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  h1, h2, h3 { font-family: "DejaVu Serif", "Liberation Serif", Georgia, serif; }
  .form-label { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; font-weight: bold; }
  .line-field { border-bottom: 1px solid #000; margin-bottom: 15px; }
  .section-header { font-family: "DejaVu Serif", "Liberation Serif", Georgia, serif; font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px;">
    <div>
      <img src="" alt="Logo" style="height: 60px;">
      <div style="margin-top: 10px;">
        <span style="font-family: 'DejaVu Serif', serif;">OREGON</span><br>
        <span style="font-family: 'DejaVu Serif', serif;">HEALTH & SCIENCE</span><br>
        <span style="font-family: 'DejaVu Serif', serif;">UNIVERSITY</span>
      </div>
    </div>
    <div style="text-align: right;">
      <span data-field="quarter">{{ quarter }}</span>
    </div>
  </div>

  <h1 style="font-family: 'DejaVu Serif', serif; font-size: 24pt; margin-bottom: 10px;">NEXus Course Enrollment Request</h1>
  <div style="font-family: 'DejaVu Sans', sans-serif; font-size: 12pt; margin-bottom: 30px;">
    OHSU School of Nursing – Internal Tracking Form
  </div>

  <!-- Student Information Section -->
  <div class="section-header">Student Information</div>
  <div style="font-family: 'DejaVu Sans', sans-serif; font-size: 12pt;">
    <div style="margin-bottom: 10px;">
      <div class="form-label" style="display: inline-block; width: 150px;">Full Name:</div>
      <div class="line-field" style="display: inline-block; width: 60%;">
        <span data-field="full_name">{{ full_name }}</span>
      </div>
    </div>
    <div style="margin-bottom: 10px;">
      <div class="form-label" style="display: inline-block; width: 150px;">OHSU Student ID:</div>
      <div class="line-field" style="display: inline-block; width: 60%;">
        <span data-field="student_id">{{ student_id }}</span>
      </div>
    </div>
    <div style="margin-bottom: 10px;">
      <div class="form-label" style="display: inline-block; width: 150px;">Email:</div>
      <div class="line-field" style="display: inline-block; width: 60%;">
        <span data-field="email">{{ email }}</span>
      </div>
    </div>
    <div style="margin-bottom: 10px;">
      <div class="form-label" style="display: inline-block; width: 150px;">Faculty Advisor:</div>
      <div class="line-field" style="display: inline-block; width: 60%;">
        <span data-field="faculty_advisor">{{ faculty_advisor }}</span>
      </div>
    </div>
    <div style="margin-bottom: 10px;">
      <div class="form-label" style="display: inline-block; width: 150px;">Program:</div>
      <div style="display: flex; align-items: center; width: 60%;">
        <span data-field="program_type">{{ program_type }}</span>
        <span style="margin-left: 20px;">
          <input type="checkbox" data-field="is_dnp_checked" value="{{ is_dnp_checked }}"> DNP
          <input type="checkbox" data-field="is_other_checked" value="{{ is_other_checked }}"> Other (explain)
        </span>
      </div>
    </div>
  </div>

  <!-- Course Information Section -->
  <div class="section-header">Course Information</div>
  <div style="font-family: 'DejaVu Sans', sans-serif; font-size: 12pt;">
    <div style="margin-bottom: 10px;">
      <div class="form-label" style="display: inline-block; width: 150px;">Teaching Institution:</div>
      <div class="line-field" style="display: inline-block; width: 60%;">
        <span data-field="teaching_institution">{{ teaching_institution }}</span>
      </div>
    </div>
    <div style="margin-bottom: 10px;">
      <div class="form-label" style="display: inline-block; width: 150px;">Course Number:</div>
      <div class="line-field" style="display: inline-block; width: 60%;">
        <span data-field="course_number">{{ course_number }}</span>
      </div>
    </div>
    <div style="margin-bottom: 10px;">
      <div class="form-label" style="display: inline-block; width: 150px;">Course Title:</div>
      <div class="line-field" style="display: inline-block; width: 60%;">
        <span data-field="course_title">{{ course_title }}</span>
      </div>
    </div>
    <div style="margin-bottom: 10px;">
      <div class="form-label" style="display: inline-block; width: 150px;">Course Description/Objectives Attached:</div>
      <div style="display: flex; align-items: center; width: 60%;">
        <input type="checkbox" data-field="description_attached_checked" value="{{ description_attached_checked }}">
      </div>
    </div>
    <div style="margin-bottom: 10px;">
      <div class="form-label" style="display: inline-block; width: 150px;">Credit Hours:</div>
      <div class="line-field" style="display: inline-block; width: 60%;">
        <span data-field="credit_hours">{{ credit_hours }}</span>
      </div>
    </div>
    <div style="margin-top: 20px; display: flex; justify-content: space-between;">
      <div style="width: 45%;">
        <div class="form-label" style="display: inline-block; width: 150px;">Semester:</div>
        <div class="line-field" style="display: inline-block; width: 30%;">
          <span data-field="semester">{{ semester }}</span>
        </div>
      </div>
      <div style="width: 45%; text-align: right;">
        <div class="form-label" style="display: inline-block; width: 150px;">Quarter:</div>
        <div class="line-field" style="display: inline-block; width: 30%;">
          <span data-field="quarter_course">{{ quarter_course }}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Financial Aid Section -->
  <div class="section-header">Financial Aid</div>
  <div style="font-family: 'DejaVu Sans', sans-serif; font-size: 12pt;">
    <div style="margin-bottom: 10px;">
      <div class="form-label" style="display: inline-block; width: 150px;">Consortium Agreement Form Submitted:</div>
      <div style="display: flex; align-items: center; width: 60%;">
        <input type="checkbox" data-field="consortium_submitted_checked" value="{{ consortium_submitted_checked }}"> Yes
        <input type="checkbox" data-field="consortium_not_submitted_checked" value="{{ consortium_not_submitted_checked }}"> No (explain):
      </div>
    </div>
  </div>

  <!-- Signatures Section -->
  <div class="section-header" style="margin-top: 40px;">Signatures</div>
  <div style="font-family: 'DejaVu Sans', sans-serif; font-size: 12pt;">
    <p style="margin-bottom: 20px;">I request approval for enrollment in the above listed course for the term indicated. Student Signature:</p>
    <div style="margin-bottom: 30px;">
      <div class="line-field" style="display: inline-block; width: 50%;">
        <span data-field="student_signature">{{ student_signature }}</span>
      </div>
      <div style="float: right;">
        <div class="form-label" style="display: inline-block; width: 150px;">Date:</div>
        <div class="line-field" style="display: inline-block; width: 100px;">
          <span data-field="student_date">{{ student_date }}</span>
        </div>
      </div>
    </div>

    <p style="margin-bottom: 20px;">I have reviewed the student's program of study and approve of the student's request to enroll in this course. Faculty Advisor Signature:</p>
    <div style="margin-bottom: 30px;">
      <div class="line-field" style="display: inline-block; width: 50%;">
        <span data-field="faculty_advisor_signature">{{ faculty_advisor_signature }}</span>
      </div>
      <div style="float: right;">
        <div class="form-label" style="display: inline-block; width: 150px;">Date:</div>
        <div class="line-field" style="display: inline-block; width: 100px;">
          <span data-field="faculty_advisor_date">{{ faculty_advisor_date }}</span>
        </div>
      </div>
    </div>

    <div style="margin-bottom: 30px;">
      <div class="form-label" style="display: inline-block; width: 150px;">OHSU Faculty Coordinator:</div>
      <div class="line-field" style="display: inline-block; width: 50%;">
        <span data-field="faculty_coordinator_signature">{{ faculty_coordinator_signature }}</span>
      </div>
      <div style="float: right;">
        <div class="form-label" style="display: inline-block; width: 150px;">Date:</div>
        <div class="line-field" style="display: inline-block; width: 100px;">
          <span data-field="faculty_coordinator_date">{{ faculty_coordinator_date }}</span>
        </div>
      </div>
    </div>

    <div style="margin-bottom: 30px;">
      <div class="form-label" style="display: inline-block; width: 150px;">OHSU Staff Coordinator:</div>
      <div class="line-field" style="display: inline-block; width: 50%;">
        <span data-field="staff_coordinator_signature">{{ staff_coordinator_signature }}</span>
      </div>
      <div style="float: right;">
        <div class="form-label" style="display: inline-block; width: 150px;">Date:</div>
        <div class="line-field" style="display: inline-block; width: 100px;">
          <span data-field="staff_coordinator_date">{{ staff_coordinator_date }}</span>
        </div>
      </div>
    </div>
  </div>
</div>