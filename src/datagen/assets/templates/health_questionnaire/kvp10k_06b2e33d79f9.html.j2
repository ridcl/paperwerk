<!DOCTYPE html>
<html>
<head>
<title>Health Questionnaire</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  .header-title { font-size: 24pt; font-weight: bold; text-align: center; margin-bottom: 30px; }
  .section-title { font-size: 14pt; font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 10px; }
  .form-group { display: flex; align-items: center; }
  .form-group label { margin-right: 15px; }
  .input-field { border-bottom: 1px solid #000; flex-grow: 1; margin-left: 10px; }
  .checkbox-group label { margin-right: 15px; }
  .grid-2col { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 15px; }
  .grid-3col { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 15px; }
  .table-header { font-weight: bold; border-bottom: 1px solid #000; padding-bottom: 5px; }
  .table-row td { padding: 5px 0; border-bottom: 1px dotted #ccc; }
  .signature-line { margin-top: 80px; display: flex; justify-content: space-between; }
</style>
</head>
<body>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px;">
    <div>
      <div style="font-size: 18pt; font-weight: bold;">PALMER</div>
      <div style="font-size: 10pt;">Chiropractic Clinics</div>
    </div>
    <div style="text-align: right;">
      File #: <span class="input-field" style="width: 100px;">{{ file_number }}</span>
      <div style="margin-top: 50px;">Date: <span class="input-field" style="width: 150px;">{{ date }}</span></div>
    </div>
  </div>

  <div class="section-title">Patient Information</div>

  <div class="form-row">
    <div class="form-group">
      <label>Patient Title: (check one)</label>
      <div class="checkbox-group">
        <label><input type="checkbox"> Mr.</label>
        <label><input type="checkbox"> Mrs.</label>
        <label><input type="checkbox"> Ms.</label>
        <label><input type="checkbox"> Miss</label>
        <label><input type="checkbox"> Dr.</label>
        <label><input type="checkbox"> Prof.</label>
        <label><input type="checkbox"> Rev.</label>
      </div>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>First Name</label>
      <span class="input-field" style="width: 40%;">{{ first_name }}</span>
    </div>
    <div class="form-group">
      <label>Middle Name</label>
      <span class="input-field" style="width: 40%;">{{ middle_name }}</span>
    </div>
    <div class="form-group">
      <label>Nick Name</label>
      <span class="input-field" style="width: 40%;">{{ nick_name }}</span>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>Last Name</label>
      <span class="input-field" style="width: 40%;">{{ last_name }}</span>
    </div>
    <div class="form-group">
      <label>Suffix</label>
      <span class="input-field" style="width: 40%;">{{ suffix }}</span>
    </div>
    <div class="form-group">
      <label>Previous Name</label>
      <span class="input-field" style="width: 40%;">{{ previous_name }}</span>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>Address 1</label>
      <span class="input-field" style="width: 90%;">{{ address_1 }}</span>
    </div>
  </div>

  <div class="grid-2col">
    <div class="form-group">
      <label>City</label>
      <span class="input-field" style="width: 40%;">{{ city }}</span>
    </div>
    <div class="form-group">
      <label>State</label>
      <span class="input-field" style="width: 40%;">{{ state }}</span>
    </div>
  </div>

  <div class="grid-2col">
    <div class="form-group">
      <label>Primary Phone</label>
      <span class="input-field" style="width: 90%;">{{ primary_phone }}</span>
    </div>
    <div class="form-group">
      <label>Secondary/Mobile Phone</label>
      <span class="input-field" style="width: 90%;">{{ secondary_phone }}</span>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>Home Email</label>
      <span class="input-field" style="width: 90%;">{{ home_email }}</span>
    </div>
    <div class="form-group">
      <label>Work Email</label>
      <span class="input-field" style="width: 90%;">{{ work_email }}</span>
    </div>
  </div>

  <div class="section-title">Health Questionnaire</div>

  <div class="form-row">
    <div class="form-group">
      <label>Referred by:</label>
      <div class="checkbox-group">
        <label><input type="checkbox"> Patient/Friend</label>
        <label><input type="checkbox"> Physician</label>
        <label><input type="checkbox"> Advertisement</label>
        <label><input type="checkbox"> Student</label>
        <label><input type="checkbox"> Community Event</label>
        <label><input type="checkbox"> Sports Event</label>
      </div>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>Community Event</label>
      <div class="checkbox-group">
        <label><input type="checkbox"> Palmer's Reputation</label>
      </div>
    </div>
    <div class="form-group">
      <label>Name of person or event:</label>
      <span class="input-field" style="width: 90%;">{{ referral_name }}</span>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>Which email address would you like us to use to communicate with you? (check one)</label>
      <div class="checkbox-group">
        <label><input type="checkbox"> Home</label>
        <label><input type="checkbox"> Work</label>
        <label><input type="checkbox"> Contact Method</label>
        <label><input type="checkbox"> Primary Phone</label>
        <label><input type="checkbox"> Secondary Phone</label>
        <label><input type="checkbox"> Mobile Phone</label>
        <label><input type="checkbox"> Home Email</label>
        <label><input type="checkbox"> Work Email</label>
      </div>
    </div>
  </div>

  <div class="grid-2col">
    <div class="form-group">
      <label>Date of Birth</label>
      <span class="input-field" style="width: 20%;">{{ dob_day }}</span> / <span class="input-field" style="width: 20%;">{{ dob_month }}</span> / <span class="input-field" style="width: 20%;">{{ dob_year }}</span>
    </div>
    <div class="form-group">
      <label>Age</label>
      <span class="input-field" style="width: 20%;">{{ age }}</span>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>Marital Status (check one)</label>
      <div class="checkbox-group">
        <label><input type="checkbox"> Single</label>
        <label><input type="checkbox"> Married</label>
        <label><input type="checkbox"> Other Spouse's Name:</label>
        <span class="input-field" style="width: 30%;">{{ other_spouse_name }}</span>
      </div>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>Employment Status (check one)</label>
      <div class="checkbox-group">
        <label><input type="checkbox"> Employed</label>
        <label><input type="checkbox"> FT Student</label>
        <label><input type="checkbox"> PT Student</label>
        <label><input type="checkbox"> Other</label>
        <label><input type="checkbox"> Retired</label>
        <label><input type="checkbox"> Self Employed</label>
      </div>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>Race (check one)</label>
      <div class="checkbox-group">
        <label><input type="checkbox"> White</label>
        <label><input type="checkbox"> Black/African American</label>
        <label><input type="checkbox"> Hispanic</label>
        <label><input type="checkbox"> American Indian/Alaskan Native</label>
        <label><input type="checkbox"> Asian</label>
        <label><input type="checkbox"> Indian</label>
        <label><input type="checkbox"> Filipino</label>
        <label><input type="checkbox"> Japanese</label>
        <label><input type="checkbox"> Vietnamese</label>
        <label><input type="checkbox"> Native Hawaiian or other Pacific Island</label>
        <label><input type="checkbox"> Samoan</label>
        <label><input type="checkbox"> Guamanian or Chamorro</label>
        <label><input type="checkbox"> I choose not to specify</label>
      </div>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>Multi-Racial (check one)</label>
      <div class="checkbox-group">
        <label><input type="checkbox"> Yes</label>
        <label><input type="checkbox"> No</label>
        <label><input type="checkbox"> Unknown</label>
      </div>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>Ethnicity (check one)</label>
      <div class="checkbox-group">
        <label><input type="checkbox"> Hispanic or Latino</label>
        <label><input type="checkbox"> Not Hispanic or Latino</label>
        <label><input type="checkbox"> I choose not to specify</label>
      </div>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>Preferred Language (check one)</label>
      <div class="checkbox-group">
        <label><input type="checkbox"> Chinese</label>
        <label><input type="checkbox"> English</label>
        <label><input type="checkbox"> Spanish</label>
        <label><input type="checkbox"> American Sign Language</label>
        <label><input type="checkbox"> Korean</label>
        <label><input type="checkbox"> French</label>
        <label><input type="checkbox"> German</label>
      </div>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>Tagalog</label>
      <div class="checkbox-group">
        <label><input type="checkbox"> Vietnamese</label>
        <label><input type="checkbox"> Italian</label>
        <label><input type="checkbox"> Korean</label>
        <label><input type="checkbox"> Russian</label>
        <label><input type="checkbox"> Polish</label>
      </div>
    </div>
    <div class="form-group">
      <label>Arabic</label>
      <div class="checkbox-group">
        <label><input type="checkbox"> Portuguese</label>
        <label><input type="checkbox"> Japanese</label>
        <label><input type="checkbox"> French Creole</label>
        <label><input type="checkbox"> Greek</label>
        <label><input type="checkbox"> Hindi</label>
      </div>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>Verification Question (choose only one question by circling the question, then give the answer to that question)</label>
    </div>
  </div>

  <div class="grid-3col">
    <div class="form-group">
      <label><input type="checkbox"> What is the name of your favorite pet?</label>
    </div>
    <div class="form-group">
      <label><input type="checkbox"> In what city were you born?</label>
    </div>
    <div class="form-group">
      <label><input type="checkbox"> What high school did you attend?</label>
    </div>
  </div>

  <div class="grid-3col">
    <div class="form-group">
      <label><input type="checkbox"> What is your favorite movie?</label>
    </div>
    <div class="form-group">
      <label><input type="checkbox"> What is your mother's maiden name?</label>
    </div>
    <div class="form-group">
      <label><input type="checkbox"> On what street did you grow up?</label>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>Verification Answer to the Chosen Question:</label>
      <span class="input-field" style="width: 90%;">{{ verification_answer }}</span>
    </div>
  </div>

  <div class="section-title">Emergency Contact Information: Full Name</div>
  <div class="form-row">
    <div class="form-group">
      <label>Address:</label>
      <span class="input-field" style="width: 40%;">{{ emergency_address }}</span>
    </div>
    <div class="form-group">
      <label>Phone Number:</label>
      <span class="input-field" style="width: 40%;">{{ emergency_phone }}</span>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>City</label>
      <span class="input-field" style="width: 40%;">{{ emergency_city }}</span>
    </div>
    <div class="form-group">
      <label>State</label>
      <span class="input-field" style="width: 40%;">{{ emergency_state }}</span>
    </div>
  </div>

  <div class="signature-line">
    <div>
      <span style="border-bottom: 1px solid #000; padding-bottom: 5px;" data-field="state">{{ state }}</span>
      <div style="margin-top: 5px;">Health Questionnaire</div>
      <div style="margin-top: 5px;">{{ date_signature_1 }}</div>
    </div>
    <div>
      <span style="border-bottom: 1px solid #000; padding-bottom: 5px;" data-field="health_questionnaire">{{ health_questionnaire }}</span>
      <div style="margin-top: 5px;">Patient Initials</div>
    </div>
  </div>
</div>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px;">
    <div>
      <div style="font-size: 18pt; font-weight: bold;">PALMER</div>
      <div style="font-size: 10pt;">Chiropractic Clinics</div>
    </div>
    <div style="text-align: right;">
      File #: <span class="input-field" style="width: 100px;">{{ file_number_2 }}</span>
      <div style="margin-top: 50px;">Date: <span class="input-field" style="width: 150px;">{{ date_2 }}</span></div>
    </div>
  </div>

  <div class="section-title">Patient Condition</div>

  <div class="form-row">
    <div class="form-group">
      <label>Reason(s) for visit:</label>
      <div class="checkbox-group">
        <label><input type="checkbox"> Is this condition due to an accident?</label>
        <label><input type="checkbox"> Yes</label>
        <label><input type="checkbox"> No</label>
        <label><input type="checkbox"> Auto</label>
        <label><input type="checkbox"> Work</label>
        <label><input type="checkbox"> Home</label>
        <label><input type="checkbox"> Other</label>
        <label><input type="checkbox"> Date</label>
      </div>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>What was the mechanism of accident/injury?</label>
      <span class="input-field" style="width: 90%;">{{ mechanism_of_injury }}</span>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>When did your symptoms appear?</label>
      <span class="input-field" style="width: 40%;">{{ onset_date }}</span>
    </div>
    <div class="form-group">
      <label>How often do you have this problem?</label>
      <span class="input-field" style="width: 40%;">{{ frequency }}</span>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>How long does the pain last?</label>
      <span class="input-field" style="width: 90%;">{{ duration }}</span>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>Does it interfere with your:</label>
      <div class="checkbox-group">
        <label><input type="checkbox"> Work</label>
        <label><input type="checkbox"> Sleep</label>
        <label><input type="checkbox"> Daily Routine</label>
        <label><input type="checkbox"> Recreation</label>
      </div>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>Activities or movements that are difficult/painful to perform:</label>
      <div class="checkbox-group">
        <label><input type="checkbox"> Sitting</label>
        <label><input type="checkbox"> Standing</label>
        <label><input type="checkbox"> Walking</label>
        <label><input type="checkbox"> Bending</label>
        <label><input type="checkbox"> Lying Down</label>
      </div>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>Mark an "X" on the picture where you continue to have pain, numbness or tingling.</label>
      <div style="display: flex; align-items: center; margin-top: 10px;">
        <div style="width: 300px; height: 100px; border: 1px solid #000; position: relative;">
          <!-- Placeholder for pain map -->
        </div>
        <div style="margin-left: 20px;">
          <label>Pain Scale (0-10):</label>
          <div style="display: flex; gap: 5px; margin-top: 5px;">
            {% for i in range(11) %}
              <label style="font-size: 10pt;"><input type="radio" name="pain_scale_{{ i }}" value="{{ i }}"> {{ i }}</label>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>What time of day is your current pain/problem worse?</label>
      <div class="checkbox-group">
        <label><input type="checkbox"> Morning</label>
        <label><input type="checkbox"> Late in the day</label>
        <label><input type="checkbox"> Middle of night</label>
        <label><input type="checkbox"> As day progresses</label>
        <label><input type="checkbox"> N/A</label>
      </div>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>My current pain/problem seems to be:</label>
      <div class="checkbox-group">
        <label><input type="checkbox"> Getting better</label>
        <label><input type="checkbox"> Staying the same</label>
        <label><input type="checkbox"> Getting worse</label>
        <label><input type="checkbox"> N/A Explain:</label>
        <span class="input-field" style="width: 50%;">{{ pain_explanation }}</span>
      </div>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>My current pain/problem can be described as (check all that apply):</label>
      <div class="checkbox-group">
        <label><input type="checkbox"> Electric</label>
        <label><input type="checkbox"> Sharp</label>
        <label><input type="checkbox"> Stabbing</label>
        <label><input type="checkbox"> Knife-like</label>
        <label><input type="checkbox"> Piercing</label>
        <label><input type="checkbox"> Shooting</label>
        <label><input type="checkbox"> Achy</label>
        <label><input type="checkbox"> Gripping</label>
        <label><input type="checkbox"> Heavy</label>
        <label><input type="checkbox"> Cramp-like</label>
        <label><input type="checkbox"> Burning</label>
        <label><input type="checkbox"> Deep</label>
        <label><input type="checkbox"> Superficial</label>
        <label><input type="checkbox"> Stiffness (am > 1-2 hours or PM or Both)</label>
        <label><input type="checkbox"> Spasm</label>
        <label><input type="checkbox"> Tearing</label>
        <label><input type="checkbox"> N/A</label>
      </div>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>What treatment have you already received for your condition?</label>
      <div class="checkbox-group">
        <label><input type="checkbox"> Medications</label>
        <label><input type="checkbox"> Surgery</label>
        <label><input type="checkbox"> None</label>
        <label><input type="checkbox"> Physical Therapy</label>
        <label><input type="checkbox"> Chiropractic Care</label>
      </div>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>Name of other doctor(s) who have treated you for this condition and how</label>
      <span class="input-field" style="width: 90%;">{{ other_doctor_info }}</span>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>Were you satisfied with the results of your treatment?</label>
      <div class="checkbox-group">
        <label><input type="checkbox"> Yes</label>
        <label><input type="checkbox"> No</label>
        <label><input type="checkbox"> No Explain</label>
        <span class="input-field" style="width: 30%;">{{ satisfaction_explanation }}</span>
      </div>
    </div>
  </div>
</div>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px;">
    <div>
      <div style="font-size: 18pt; font-weight: bold;">PALMER</div>
      <div style="font-size: 10pt;">Chiropractic Clinics</div>
    </div>
    <div style="text-align: right;">
      File #: <span class="input-field" style="width: 100px;">{{ file_number_3 }}</span>
      <div style="margin-top: 50px;">Date: <span class="input-field" style="width: 150px;">{{ date_3 }}</span></div>
    </div>
  </div>

  <div class="section-title">Allergies</div>

  <div class="form-row">
    <div class="form-group">
      <label>Are you allergic to any medication(s)?</label>
      <div class="checkbox-group">
        <label><input type="checkbox"> Yes</label>
        <label><input type="checkbox"> No</label>
        <label><input type="checkbox"> If yes, which medications?</label>
        <span class="input-field" style="width: 60%;">{{ medication_allergies }}</span>
      </div>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>Are you allergic to any of the following?</label>
      <div class="checkbox-group">
        <label><input type="checkbox"> Bee Sting</label>
        <label><input type="checkbox"> Latex</label>
        <label><input type="checkbox"> Peanuts</label>
        <label><input type="checkbox"> Shellfish</label>
        <label><input type="checkbox"> Dairy</label>
        <label><input type="checkbox"> Mold</label>
        <label><input type="checkbox"> Pollen</label>
        <label><input type="checkbox"> Wheat</label>
        <label><input type="checkbox"> Eggs</label>
        <label><input type="checkbox"> Nuts</label>
        <label><input type="checkbox"> Other</label>
      </div>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>Describe the reaction:</label>
      <span class="input-field" style="width: 90%;">{{ allergy_reaction_description }}</span>
    </div>
  </div>

  <div class="section-title">Smoking History</div>

  <div class="form-row">
    <div class="form-group">
      <label>Do you currently smoke tobacco of any kind?</label>
      <div class="checkbox-group">
        <label><input type="checkbox"> Yes</label>
        <label><input type="checkbox"> No</label>
      </div>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>If yes, how often do you smoke:</label>
      <div class="checkbox-group">
        <label><input type="checkbox"> Current every day smoke</label>
        <label><input type="checkbox"> Current sometimes smoker</label>
        <label><input type="checkbox"> Never been a smoker</label>
      </div>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label>If yes, what is your level of interest in quitting smoking?</label>
      <div class="checkbox-group">
        <label><input type="checkbox"> 0</label>
        <label><input type="checkbox"> 1</label>
        <label><input type="checkbox"> 2</label>
        <label><input type="checkbox"> 3</label>
        <label><input type="checkbox"> 4</label>
        <label><input type="checkbox"> 5</label>
        <label><input type="checkbox"> 6</label>
        <label><input type="checkbox"> 7</label>
        <label><input type="checkbox"> 8</label>
        <label><input type="checkbox"> 9</label>
        <label><input type="checkbox"> 10</label>
        <label><input type="checkbox"> Very Interested</label>
      </div>
    </div>
  </div>
</div>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px;">
    <div>
      <div style="font-size: 18pt; font-weight: bold;">PALMER</div>
      <div style="font-size: 10pt;">Chiropractic Clinics</div>
    </div>
    <div style="text-align: right;">
      File #: <span class="input-field" style="width: 100px;">{{ file_number_4 }}</span>
