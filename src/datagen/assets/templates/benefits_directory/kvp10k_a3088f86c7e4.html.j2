<head>
<title>Benefits Directory</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 {
    font-weight: bold;
    margin-top: 0;
  }
  .section-title {
    text-align: center;
    font-weight: bold;
    margin-bottom: 20px;
  }
  .contact-info {
    display: flex;
    justify-content: space-between;
    margin-top: 20px;
    font-size: 0.9em;
  }
  .directory-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .entry {
    margin-bottom: 15px;
  }
  .entry strong {
    display: block;
    font-weight: bold;
  }
  .entry a {
    color: #000;
    text-decoration: underline;
  }
  .list-item {
    margin-bottom: 5px;
  }
</style>
</head>
