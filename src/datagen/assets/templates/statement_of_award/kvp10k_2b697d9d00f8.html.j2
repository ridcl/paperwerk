<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Statement of Award</title>
  <style>
    @page { size: A4; margin: 0; }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
      font-size: 14px;
      color: #000;
    }

    .page {
      width: 794px;
      height: 1123px;
      padding: 50px 60px;
      box-sizing: border-box;
      overflow: hidden;
      page-break-after: always;
      position: relative;
    }
    .page:last-child { page-break-after: auto; }

    .header {
      text-align: center;
      margin-bottom: 18px;
    }

    .header h1 {
      font-size: 28px;
      font-weight: bold;
      font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
    }

    .header .subheader {
      font-size: 15px;
      font-weight: bold;
      line-height: 1.6;
    }

    .doc-title {
      text-align: center;
      margin-bottom: 6px;
    }

    .doc-title h2 {
      font-size: 22px;
      font-weight: bold;
    }

    .posting-date {
      text-align: center;
      font-size: 15px;
      font-weight: bold;
      margin-bottom: 22px;
    }

    .posting-date span.blue {
      color: #1a56cc;
    }

    .intro-text {
      font-size: 13.5px;
      line-height: 1.55;
      margin-bottom: 14px;
    }

    .fields-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
      font-size: 13.5px;
    }

    .fields-table td {
      vertical-align: top;
      padding: 3px 0;
    }

    .fields-table td.label {
      font-weight: bold;
      white-space: nowrap;
      padding-right: 16px;
      width: 160px;
    }

    .fields-table td.value {
      color: #1a56cc;
    }

    .awarded-to-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 20px;
      font-size: 13.5px;
    }

    .awarded-to-table td {
      vertical-align: top;
      padding: 3px 0;
    }

    .awarded-to-table td.outer-label {
      font-weight: bold;
      white-space: nowrap;
      padding-right: 16px;
      width: 160px;
    }

    .awarded-to-table td.inner-label {
      font-weight: bold;
      white-space: nowrap;
      padding-right: 10px;
      width: 80px;
    }

    .awarded-to-table td.inner-value {
      color: #1a56cc;
    }

    .boxed {
      border: 1px solid #888;
      padding: 5px 8px;
      min-width: 340px;
      display: inline-block;
    }

    .evaluated-amount {
      font-size: 13.5px;
      margin-bottom: 40px;
    }

    .evaluated-amount strong {
      font-weight: bold;
    }

    .evaluated-amount span.blue {
      color: #1a56cc;
    }

    .signature-section {
      margin-top: 10px;
    }

    .signature-line {
      border-bottom: 1px solid #000;
      width: 280px;
      margin-bottom: 6px;
    }

    .signatory-name {
      font-size: 13.5px;
      font-weight: normal;
    }

    .signatory-title {
      font-size: 13.5px;
    }

    .signatory-org {
      font-size: 13.5px;
    }
  </style>
</head>
<body>
  <div class="page">

    <!-- University Header -->
    <div class="header">
      <h1><span data-field="university.name">{{ university.name }}</span></h1>
      <div class="subheader">
        <span data-field="university.department">{{ university.department }}</span><br/>
        <span data-field="university.po_box">{{ university.po_box }}</span><br/>
        <span data-field="university.city_state_zip">{{ university.city_state_zip }}</span>
      </div>
    </div>

    <!-- Document Title -->
    <div class="doc-title">
      <h2>Statement of Award</h2>
    </div>

    <!-- Posting Date -->
    <div class="posting-date">
      <strong>Posting Date:</strong>&nbsp;
      <span class="blue"><span data-field="posting_date">{{ posting_date }}</span></span>
    </div>

    <!-- Intro Paragraphs -->
    <p class="intro-text">This is a statement of award and serves as acceptance of your offer.</p>
    <p class="intro-text">
      Contractor should not perform work prior to the receipt of a purchase order from
      <span data-field="university.name">{{ university.name }}</span>.&nbsp; The University assumes no liability
      for any expenses incurred prior to the effective date of the contract and issuance of a purchase order.
    </p>

    <!-- Main Fields Table -->
    <table class="fields-table">
      <tbody>
        <tr>
          <td class="label">Solicitation:</td>
          <td class="value"><span data-field="solicitation_number">{{ solicitation_number }}</span></td>
        </tr>
        <tr>
          <td class="label">Description:</td>
          <td class="value"><span data-field="description">{{ description }}</span></td>
        </tr>
        <tr>
          <td class="label">Issue Date:</td>
          <td class="value"><span data-field="issue_date">{{ issue_date }}</span></td>
        </tr>
        <tr>
          <td class="label">Opening Date/Time:</td>
          <td class="value"><span data-field="opening_date_time">{{ opening_date_time }}</span></td>
        </tr>
        <tr>
          <td class="label">Award Date:</td>
          <td class="value"><span data-field="award_date">{{ award_date }}</span></td>
        </tr>
      </tbody>
    </table>

    <!-- Awarded To Section -->
    <table class="awarded-to-table">
      <tbody>
        <tr>
          <td class="outer-label" rowspan="2" style="vertical-align:top; padding-top:4px;">Awarded To:</td>
          <td class="inner-label">Name:</td>
          <td class="inner-value">
            <div class="boxed">
              <span data-field="awardee.name">{{ awardee.name }}</span>
            </div>
          </td>
        </tr>
        <tr>
          <td class="inner-label" style="padding-top:8px;">Address:</td>
          <td class="inner-value" style="padding-top:8px;">
            <div class="boxed">
              <span data-field="awardee.address_line1">{{ awardee.address_line1 }}</span><br/>
              <span data-field="awardee.address_line2">{{ awardee.address_line2 }}</span>
            </div>
          </td>
        </tr>
      </tbody>
    </table>

    <!-- Evaluated Amount -->
    <p class="evaluated-amount">
      <strong>Evaluated Amount:</strong>&nbsp;
      <span class="blue"><span data-field="evaluated_amount_description">{{ evaluated_amount_description }}</span></span>
    </p>

    <!-- Signature Section -->
    <div class="signature-section">
      <div class="signature-line"></div>
      <div class="signatory-name"><span data-field="signatory.name">{{ signatory.name }}</span></div>
      <div class="signatory-title"><span data-field="signatory.title">{{ signatory.title }}</span></div>
      <div class="signatory-org"><span data-field="signatory.organization">{{ signatory.organization }}</span></div>
    </div>

  </div>
</body>
</html>