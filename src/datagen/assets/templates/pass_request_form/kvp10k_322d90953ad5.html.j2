<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child { page-break-after: auto; }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  th, td {
    border: 1px solid #000;
    padding: 8px;
    text-align: left;
  }
  th {
    background-color: #f0f0f0;
  }
  .signature-line {
    border-bottom: 1px solid #000;
    width: 100%;
    margin-top: 50px;
    margin-bottom: 50px;
  }
</style>

<div class="page">
  <h1 style="text-align: center; font-weight: bold;">PASS REQUEST FORM</h1>
  <p style="color: red; font-weight: bold;">This form will not be accepted until your <span data-field="final_grade">{{ final_grade }}</span> is posted.</p>
  <p>I would like to request that the following course grades be changed to a graduate of "<span data-field="requested_grade">{{ requested_grade }}</span>" (pass).</p>
  <p>I have read and understand the policy and this request meets the criteria stated in the University bulletin - <a href="{{ bulletin_url }}">{{ bulletin_url }}</a></p>

  <table>
    <thead>
      <tr>
        <th>TERM</th>
        <th>COURSE ID</th>
        <th>COURSE TITLE</th>
        <th>GRADE</th>
      </tr>
    </thead>
    <tbody>
      {% for item in course_requests %}
      <tr>
        <td><span data-field="course_requests[{{ loop.index0 }}].term">{{ item.term }}</span></td>
        <td><span data-field="course_requests[{{ loop.index0 }}].course_id">{{ item.course_id }}</span></td>
        <td><span data-field="course_requests[{{ loop.index0 }}].course_title">{{ item.course_title }}</span></td>
        <td><span data-field="course_requests[{{ loop.index0 }}].grade">{{ item.grade }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <p>Student's Name (please print) ____________________________________________________</p>
  <p>Student's CWID ________________________________________________________________</p>
  <p>Student's Major _______________________________________________________________</p>

  <p>Student's Signature _________________________ Date: _________________________</p>

  <p>Please forward this form to the Office of Student Records for processing – <a href="mailto:{{ processing_email }}">{{ processing_email }}</a></p>
  <p>Please allow 3 days for processing from the date of your submission.</p>
</div>