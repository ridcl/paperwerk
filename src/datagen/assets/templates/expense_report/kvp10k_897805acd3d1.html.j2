<!DOCTYPE html>
<html>
<head>
    <title>Expense Report</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        td { padding: 5px; border: 1px solid #ccc; }
        .header { font-weight: bold; text-align: center; margin-bottom: 20px; }
        .section-title { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
        .form-row { display: flex; justify-content: space-between; margin-bottom: 10px; }
        .form-label { flex-basis: 30%; }
        .form-input { flex-basis: 65%; border-bottom: 1px solid #000; }
        .full-width-input { width: 100%; border-bottom: 1px solid #000; margin-bottom: 10px; }
    </style>
</head>
<body>
    <div class="page">
        <div style="text-align: center;">
            <h1 style="font-size: 18pt; margin-bottom: 5px;">BRYN MAWR COLLEGE</h1>
            <h2 style="font-size: 14pt; margin-top: 0;">Payment Request (Non E-Market)</h2>
        </div>
        <p style="font-size: 10pt; margin-bottom: 20px;">Must select one or more boxes:</p>
        <div style="display: flex; gap: 20px; margin-bottom: 30px;">
            <label><input type="checkbox"> Reimbursement</label>
            <label><input type="checkbox"> Honorarium</label>
            <label><input type="checkbox"> Foreign Wire Request</label>
            <label><input type="checkbox"> Advance $200 minimum</label>
            <label><input type="checkbox"> Advance Reporting Rec.</label>
        </div>

        <div class="section-title">SECTION I:</div>
        <div class="form-row">
            <div class="form-label">BMC ID:</div>
            <div class="form-input"><span data-field="bmc_id">{{ bmc_id }}</span></div>
        </div>
        <div class="form-row">
            <div class="form-label">Name of Payee:</div>
            <div class="form-input"><span data-field="payee.first_name">{{ payee.first_name }}</span></div>
            <div class="form-input" style="width: 20%;"></div> <!-- Middle -->
            <div class="form-input"><span data-field="payee.last_name">{{ payee.last_name }}</span></div>
        </div>
        <div class="form-row">
            <div class="form-label">Payee's Address:</div>
            <div class="form-input" style="flex-basis: 100%;"><span data-field="payee.street_address">{{ payee.street_address }}</span></div>
        </div>
        <div class="form-row">
            <div class="form-label">City:</div>
            <div class="form-input" style="flex-basis: 20%;"><span data-field="payee.city">{{ payee.city }}</span></div>
            <div class="form-label">State:</div>
            <div class="form-input" style="flex-basis: 15%;"><span data-field="payee.state">{{ payee.state }}</span></div>
            <div class="form-label">Zip:</div>
            <div class="form-input" style="flex-basis: 15%;"><span data-field="payee.zip">{{ payee.zip }}</span></div>
        </div>

        <div class="section-title">SECTION II:</div>
        <p style="font-size: 10pt; margin-bottom: 10px;">Employees (Faculty, Staff or Students) are paid by Direct Deposit to same bank account they chose for their paycheck. Non-Employees (Guests or Students not employed by BMC) are paid based on the default method in their vendor record.</p>
        <div class="form-row" style="margin-bottom: 20px;">
            <div class="form-label" style="flex-basis: 100%;">Mail check or notice of deposit to:</div>
            <div style="display: flex; gap: 30px; align-items: center;">
                <label><input type="radio"> US Mail to Payee's Address</label>
                <label><input type="radio"> Campus Mail</label>
                <label><input type="radio"> Check Pick up by:</label>
            </div>
        </div>

        <div style="margin-top: 30px;">
            <table style="width: 100%;">
                <thead>
                    <tr>
                        <th style="width: 25%;">Fund</th>
                        <th style="width: 25%;">Expense</th>
                        <th style="width: 25%;">Department</th>
                        <th style="width: 25%;">Project</th>
                        <th style="width: 10%;">AMOUNT</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span data-field="expense_details[0].fund">{{ expense_details[0].fund }}</span></td>
                        <td><span data-field="expense_details[0].expense">{{ expense_details[0].expense }}</span></td>
                        <td><span data-field="expense_details[0].department">{{ expense_details[0].department }}</span></td>
                        <td><span data-field="expense_details[0].project">{{ expense_details[0].project }}</span></td>
                        <td><span data-field="expense_details[0].amount">{{ expense_details[0].amount }}</span></td>
                    </tr>
                    <!-- Loop for multiple expense lines -->
                    {% for item in expense_details %}
                    <tr>
                        <td><span data-field="expense_details[{{ loop.index0 }}].fund">{{ item.fund }}</span></td>
                        <td><span data-field="expense_details[{{ loop.index0 }}].expense">{{ item.expense }}</span></td>
                        <td><span data-field="expense_details[{{ loop.index0 }}].department">{{ item.department }}</span></td>
                        <td><span data-field="expense_details[{{ loop.index0 }}].project">{{ item.project }}</span></td>
                        <td><span data-field="expense_details[{{ loop.index0 }}].amount">{{ item.amount }}</span></td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            <div style="text-align: right; margin-top: 10px;">
                <span data-field="total_amount">{{ total_amount }}</span>
            </div>
        </div>

        <div class="section-title" style="margin-top: 40px;">Business Purpose Expense(s) Description:</div>
        <div class="full-width-input" style="height: 60px;"></div>

        <div class="form-row" style="margin-top: 20px;">
            <div class="form-label">Date(s) of Expense(s) or If Travel, Date Range:</div>
            <div class="form-input" style="flex-basis: 70%;"><span data-field="date_range">{{ date_range }}</span></div>
        </div>

        <div class="form-row" style="margin-top: 20px;">
            <div class="form-label">Travel: City, State or Country:</div>
            <div class="form-input" style="flex-basis: 70%;"><span data-field="travel_location">{{ travel_location }}</span></div>
        </div>
        <p style="font-size: 10pt; margin-top: 5px;">(Must Complete BMC Travel Expense Summary)</p>

        <div class="form-row" style="margin-top: 20px;">
            <div class="form-label">Travelers:</div>
            <div style="display: flex; gap: 30px; align-items: center;">
                <label><input type="radio"> Same as payee</label>
                <label><input type="radio"> Other (indicate name)</label>
            </div>
        </div>

        <div class="form-row" style="margin-top: 20px;">
            <div class="form-label">Citizenship:</div>
            <div style="display: flex; gap: 30px; align-items: center;">
                <label><input type="radio"> U.S. or resident alien</label>
                <label><input type="radio"> Nonresident alien (country):</label>
            </div>
        </div>
        <p style="font-size: 10pt; margin-top: 5px;">(Honorarium Only)</p>
        <p style="font-size: 10pt;">(W-9 must be attached or on file) (Appropriate signed Glacier forms must be attached)</p>

    </div>

    <div class="page">
        <div style="text-align: center;">
            <h2 style="font-size: 14pt;">ITEMIZED PAID RECEIPTS/INVOICES FOR ALL EXPENSES MUST ACCOMPANY THIS REQUEST. If travel, attach BMC Travel Expense Summary. When receipts are unavailable, please use Section III and include the reason for the missing receipts. See page 2 for payment to a foreign vendor.</h2>
        </div>

        <div class="section-title" style="margin-top: 40px;">SECTION III: Certification and Authorization</div>
        <p style="font-size: 11pt;">We certify the following:</p>
        <ol style="font-size: 11pt; line-height: 1.5;">
            <li>The reported expenditures were incurred in connection with College business.</li>
            <li>No portion of the claimed expenses has been or will be reimbursed from other sources.</li>
            <li>Expenses adhere to the College's policies and guidelines.</li>
            <li>Expenses are substantiated by itemized receipts that indicate method and amount of payment.</li>
        </ol>
        <p style="font-size: 11pt; margin-top: 15px;">Exceptions to the policy, such as <span data-field="exception_reason">{{ exception_reason }}</span>, have been approved for the following reason(s) below:</p>
        <div class="full-width-input" style="height: 50px;"></div>

        <div class="section-title" style="margin-top: 40px;">Form Completed By:</div>
        <div class="form-row">
            <div class="form-label" style="flex-basis: 30%;">Authorizer's Printed Name:</div>
            <div class="form-input" style="flex-basis: 70%;"><span data-field="authorizer_printed_name">{{ authorizer_printed_name }}</span></div>
        </div>
        <div class="form-row">
            <div class="form-label" style="flex-basis: 30%;">Authorizing Signature:</div>
            <div class="form-input" style="flex-basis: 70%;"><span data-field="authorizing_signature">{{ authorizing_signature }}</span></div>
        </div>
        <div class="form-row" style="margin-top: 20px;">
            <div class="form-label" style="flex-basis: 30%;">Employee Payee Signature:</div>
            <div class="form-input" style="flex-basis: 70%;"><span data-field="employee_payee_signature">{{ employee_payee_signature }}</span></div>
        </div>
        <p style="font-size: 10pt; margin-top: 5px;">(Employee and Approver signature can be sent electronically with a BMC email)</p>
        <div class="form-row" style="margin-top: 10px;">
            <div class="form-label" style="flex-basis: 30%;">Phone ext.:</div>
            <div class="form-input" style="flex-basis: 30%;"><span data-field="phone_extension">{{ phone_extension }}</span></div>
            <div class="form-label" style="flex-basis: 30%;">Date:</div>
            <div class="form-input" style="flex-basis: 30%;"><span data-field="date_signed">{{ date_signed }}</span></div>
        </div>
    </div>

    <div class="page">
        <div style="text-align: center;">
            <h2 style="font-size: 14pt;">SECTION IV: Payment to a Foreign Vendor</h2>
        </div>

        <p style="font-size: 10pt; margin-bottom: 20px;">Attach invoice, foreign wire instructions received and fill in any additional information not provided on the attachment.</p>

        <div class="form-row">
            <div class="form-label">Payee:</div>
            <div class="form-input" style="flex-basis: 70%;"><span data-field="foreign_payee_name">{{ foreign_payee_name }}</span></div>
        </div>
        <div class="form-row">
            <div class="form-label">Payee Address (if different than above):</div>
            <div class="form-input" style="flex-basis: 70%;"><span data-field="foreign_payee_address">{{ foreign_payee_address }}</span></div>
        </div>
        <div class="form-row">
            <div class="form-label">Name on Bank Account:</div>
            <div class="form-input" style="flex-basis: 70%;"><span data-field="bank_account_name">{{ bank_account_name }}</span></div>
            <div class="form-label">Bank Account #:</div>
            <div class="form-input" style="flex-basis: 30%;"><span data-field="bank_account_number">{{ bank_account_number }}</span></div>
        </div>
        <div class="form-row">
            <div class="form-label">Wire in following currency (i.e. British Pounds, Euros, Yen):</div>
            <div class="form-input" style="flex-basis: 70%;"><span data-field="currency">{{ currency }}</span></div>
        </div>
        <div class="form-row">
            <div class="form-label">Name of Bank:</div>
            <div class="form-input" style="flex-basis: 70%;"><span data-field="bank_name">{{ bank_name }}</span></div>
        </div>
        <div class="form-row">
            <div class="form-label">Swift Code:</div>
            <div class="form-input" style="flex-basis: 70%;"><span data-field="swift_code">{{ swift_code }}</span></div>
        </div>
        <div class="form-row">
            <div class="form-label">Sort Code (Mandatory for U.K.):</div>
            <div class="form-input" style="flex-basis: 70%;"><span data-field="sort_code">{{ sort_code }}</span></div>
        </div>
        <div class="form-row">
            <div class="form-label">IBAN #:</div>
            <div class="form-input" style="flex-basis: 70%;"><span data-field="iban">{{ iban }}</span></div>
        </div>
        <div class="form-row">
            <div class="form-label">Any Further Instructions:</div>
            <div class="form-input" style="flex-basis: 70%;"><span data-field="further_instructions">{{ further_instructions }}</span></div>
        </div>
    </div>

    <div class="page">
        <div style="text-align: center;">
            <h2 style="font-size: 14pt;">Bryn Mawr College Travel Expense Summary</h2>
            <p style="font-size: 10pt;">ENTER TRAVEL COSTS IN THE APPROPRIATE SPACES BELOW. THE TOTALS WILL AUTOMATICALLY CALCULATE FOR YOU. If your travel period exceeded seven days or if you need more space to complete a category, please open a second form and only complete this section.</p>
            <p style="font-size: 10pt;">**See <span data-field="mileage_rate_link">{{ mileage_rate_link }}</span> webpage to get the per mile amount to enter below for dates traveled.</p>
        </div>

        <table style="margin-top: 20px;">
            <thead>
                <tr>
                    <th style="width: 40%;">Category</th>
                    <th style="width: 15%; text-align: right;">Date</th>
                    <th style="width: 15%; text-align: right;">TOTALS</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Airfare</td>
                    <td style="text-align: right;"><span data-field="airfare_date">{{ airfare_date }}</span></td>
                    <td style="text-align: right;"><span data-field="airfare_total">{{ airfare_total }}</span></td>
                </tr>
                <tr>
                    <td>Taxi / limo / shuttle</td>
                    <td style="text-align: right;"><span data-field="taxi_date">{{ taxi_date }}</span></td>
                    <td style="text-align: right;"><span data-field="taxi_total">{{ taxi_total }}</span></td>
                </tr>
                <tr>
                    <td>Rail / bus / subway / ferry</td>
                    <td style="text-align: right;"><span data-field="rail_date">{{ rail_date }}</span></td>
                    <td style="text-align: right;"><span data-field="rail_total">{{ rail_total }}</span></td>
                </tr>
                <tr>
                    <td>Parking/Tolls</td>
                    <td style="text-align: right;"><span data-field="parking_date">{{ parking_date }}</span></td>
                    <td style="text-align: right;"><span data-field="parking_total">{{ parking_total }}</span></td>
                </tr>
                <tr>
                    <td>Car rental</td>
                    <td style="text-align: right;"><span data-field="rental_date">{{ rental_date }}</span></td>
                    <td style="text-align: right;"><span data-field="rental_total">{{ rental_total }}</span></td>
                </tr>
                <tr>
                    <td>Gas: BMC or rentals only</td>
                    <td style="text-align: right;"><span data-field="gas_date">{{ gas_date }}</span></td>
                    <td style="text-align: right;"><span data-field="gas_total">{{ gas_total }}</span></td>
                </tr>
                <tr>
                    <td>Mileage @ <span data-field="mileage_rate">{{ mileage_rate }}</span> per mile</td>
                    <td style="text-align: right;"><span data-field="mileage_date">{{ mileage_date }}</span></td>
                    <td style="text-align: right;"><span data-field="mileage_total">{{ mileage_total }}</span></td>
                </tr>
                <tr>
                    <td>Personal vehicle only</td>
                    <td style="text-align: right;"><span data-field="personal_vehicle_date">{{ personal_vehicle_date }}</span></td>
                    <td style="text-align: right;"><span data-field="personal_vehicle_total">{{ personal_vehicle_total }}</span></td>
                </tr>
                <tr>
                    <td>Per Diem Meals</td>
                    <td style="text-align: right;"><span data-field="per_diem_date">{{ per_diem_date }}</span></td>
                    <td style="text-align: right;"><span data-field="per_diem_total">{{ per_diem_total }}</span></td>
                </tr>
                <tr>
                    <td>Lodging (room / taxes)</td>
                    <td style="text-align: right;"><span data-field="lodging_date">{{ lodging_date }}</span></td>
                    <td style="text-align: right;"><span data-field="lodging_total">{{ lodging_total }}</span></td>
                </tr>
                <tr>
                    <td>Total meals for self:</td>
                    <td></td>
                    <td style="text-align: right;"><span data-field="total_meals_self">{{ total_meals_self }}</span></td>
                </tr>
                <tr>
                    <td>Breakfast</td>
                    <td></td>
                    <td></td>
                </tr>
                <tr>
                    <td>Lunch</td>
                    <td></td>
                    <td></td>
                </tr>
                <tr>
                    <td>Dinner</td>
                    <td></td>
                    <td></td>
                </tr>
                <tr>
                    <td>Snacks</td>
                    <td></td>
                    <td></td>
                </tr>
                <tr>
                    <td>Total meals for guest(s):</td>
                    <td></td>
                    <td style="text-align: right;"><span data-field="total_meals_guest">{{ total_meals_guest }}</span></td>
                </tr>
                <tr>
                    <td>Name of guest(s)</td>
                    <td></td>
                    <td>Business reason for guest(s)</td>
                </tr>
            </tbody>
        </table>

        <div style="margin-top: 30px;">
            <table style="width: 100%;">
                <tr>
                    <td style="width: 50%;">Conf. Registration Fee</td>
                    <td style="width: 25%; text-align: right;"><span data-field="conf_fee_total">{{ conf_fee_total }}</span></td>
                    <td style="width: 25%;">Phone/Fax/Duplicating</td>
                    <td style="width: 25%; text-align: right;"><span data-field="phone_fax_total">{{ phone_fax_total }}</span></td>
                </tr>
                <tr>
                    <td style="width: 50%;">Tips</td>
                    <td style="width: 25%; text-align: right;"><span data-field="tips_total">{{ tips_total }}</span></td>
                    <td style="width: 25%;">Other:</td>
                    <td style="width: 25%; text-align: right;"><span data-field="other_total">{{ other_total }}</span></td>
                </tr>
            </table>
        </div>

        <div style="margin-top: 30px;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                <div style="width: 50%;">Total itemized travel expenses from above:</div>
                <div style="width: 25%; text-align: right;"><span data-field="total_itemized_expenses">{{ total_itemized_expenses }}</span></div>
            </div>
            <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                <div>Less travel advance:</div>
                <div style="text-align: right;"><span data-field="less_advance">{{ less_advance }}</span></div>
            </div>
            <div style="display: flex; justify-content: space-between;">
                <div>Reimbursement requested/(Excess funds due BMC):</div>
                <div style="text-align: right;"><span data-field="reimbursement_requested">{{ reimbursement_requested }}</span></div>
            </div>
        </div>
    </div>
</body>
</html>