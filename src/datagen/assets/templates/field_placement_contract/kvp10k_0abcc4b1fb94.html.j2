<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  .form-group {
    margin-bottom: 15px;
  }
  .form-group label {
    display: block;
    margin-bottom: 5px;
    font-weight: bold;
  }
  .form-group input[type="text"], .form-group textarea {
    width: 100%;
    padding: 8px;
    border: 1px solid #ccc;
    box-sizing: border-box;
    font-size: 14px;
  }
  .radio-group label {
    font-weight: normal;
    display: inline-block;
    margin-right: 15px;
  }
  .signature-line {
    display: flex;
    justify-content: space-between;
    margin-top: 80px;
    padding-bottom: 20px;
    border-top: 1px solid #000;
  }
  .signature-box {
    text-align: center;
    flex-grow: 1;
    padding: 0 20px;
  }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px;">
    <div style="width: 30%;">
      <h1 style="font-size: 24px; font-weight: bold;">UNIVERSITY OF WISCONSIN</h1>
      <h2 style="font-size: 36px; font-weight: bold; margin-top: -10px;">UWMILWAUKEE</h2>
    </div>
    <div style="width: 70%; text-align: right;">
      <h1 style="font-size: 24px; font-weight: bold;">Field Placement in Psychology Contract</h1>
    </div>
  </div>

  <div style="display: flex; justify-content: space-between;">
    <div style="width: 48%;">
      <div class="form-group">
        <label>Student Name</label>
        <input type="text" value="{{ student_name }}">
      </div>
      <div class="form-group">
        <label>Faculty Sponsor</label>
        <input type="text" value="{{ faculty_sponsor }}">
      </div>
      <div class="form-group">
        <label>Field Placement Supervisor</label>
        <input type="text" value="{{ field_placement_supervisor }}">
      </div>
      <div class="form-group">
        <label>Supervisor Email Address</label>
        <input type="text" value="{{ supervisor_email_address }}">
      </div>
      <div class="form-group">
        <label>Course Number</label>
        <div class="radio-group">
          <label><input type="radio" name="course_number" value="292" {% if course_number == 292 %}checked{% endif %}> 292</label>
          <label><input type="radio" name="course_number" value="692" {% if course_number == 692 %}checked{% endif %}> 692</label>
          <label><input type="radio" name="course_number" value="697" {% if course_number == 697 %}checked{% endif %}> 697</label>
        </div>
      </div>
    </div>

    <div style="width: 48%;">
      <div class="form-group">
        <label>Student Email Address</label>
        <input type="text" value="{{ student_email_address }}">
      </div>
      <div class="form-group">
        <label>Field Placement Site</label>
        <input type="text" value="{{ field_placement_site }}">
      </div>
      <div class="form-group">
        <label>Supervisor Title</label>
        <input type="text" value="{{ supervisor_title }}">
      </div>
      <div class="form-group">
        <label>Supervisor Phone Number</label>
        <input type="text" value="{{ supervisor_phone_number }}">
      </div>
      <div class="form-group">
        <label>Semester</label>
        <div class="radio-group">
          <label><input type="radio" name="semester" value="Fall" {% if semester == "Fall" %}checked{% endif %}> Fall</label>
          <label><input type="radio" name="semester" value="Spring" {% if semester == "Spring" %}checked{% endif %}> Spring</label>
          <label><input type="radio" name="semester" value="Summer" {% if semester == "Summer" %}checked{% endif %}> Summer</label>
        </div>
      </div>
      <div class="form-group">
        <label>Academic Year</label>
        <input type="text" value="{{ academic_year }}">
      </div>
    </div>
  </div>

  <div style="margin-top: 30px;">
    <label style="font-weight: bold;">Field Supervisor: Describe the field placement, responsibilities of the student and all expectations.</label>
    <textarea rows="8" style="width: 100%; margin-top: 5px;">{{ field_supervisor_description }}</textarea>
  </div>

  <div style="margin-top: 30px;">
    <label style="font-weight: bold;">Student: Describe your expectations of the field placement</label>
    <textarea rows="8" style="width: 100%; margin-top: 5px;">{{ student_expectations_description }}</textarea>
  </div>

  <div style="margin-top: 30px;">
    <label style="font-weight: bold;">List the days and times the student is scheduled to be on site. What are the start and end dates for the placement?</label>
    <textarea rows="4" style="width: 100%; margin-top: 5px;">{{ placement_schedule_details }}</textarea>
  </div>
</div>

<div class="page">
  <div class="signature-line">
    <div class="signature-box">
      <p>Supervisor Signature</p>
      <div style="height: 1px; width: 80%; margin: 0 auto;"></div>
    </div>
    <div class="signature-box">
      <p>Student Signature</p>
      <div style="height: 1px; width: 80%; margin: 0 auto;"></div>
    </div>
    <div class="signature-box">
      <p>Date</p>
      <div style="height: 1px; width: 80%; margin: 0 auto;"></div>
    </div>
  </div>
</div>