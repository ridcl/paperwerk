<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1, h2 { text-align: center; margin-bottom: 20px; }
  .header-info { display: flex; justify-content: space-between; margin-bottom: 40px; }
  .contact-info { text-align: right; font-size: 0.9em; }
  .form-section { margin-bottom: 30px; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 15px; }
  .form-row > div { width: 48%; }
  .form-label { font-weight: bold; display: block; margin-bottom: 5px; }
  .form-input-area { border-bottom: 1px solid #000; width: 100%; }
  .signature-block { margin-top: 50px; }
  .signature-row { display: flex; justify-content: space-between; margin-bottom: 20px; }
  .signature-label { width: 30%; }
  .signature-line { width: 65%; border-bottom: 1px solid #000; }
</style>
<body>
  <div class="page">
    <div style="text-align: center;">
      <img src="placeholder_logo.png" alt="University Logo" style="width: 100px; margin-bottom: 10px;">
      <h1 style="font-size: 1.5em; margin-bottom: 5px;">HONORS THESIS FORM</h1>
      <p style="font-size: 0.9em;">THE UNIVERSITY OF MEMPHIS.</p>
    </div>

    <div class="header-info">
      <div class="contact-info">
        <p>Honors Hall, <span data-field="address.street">{{ address.street }}</span></p>
        <p>Phone: <span data-field="contact.phone">{{ contact.phone }}</span></p>
        <p>Fax: <span data-field="contact.fax">{{ contact.fax }}</span></p>
      </div>
    </div>

    <h2 style="text-align: center;">Application Form for Honors Thesis</h2>
    <div style="text-align: right; margin-bottom: 30px;">
      Semester/Year: <span data-field="application_period">{{ application_period }}</span>
    </div>

    <div class="form-section">
      <div class="form-row">
        <div>
          <span class="form-label">Name of Student (please print)</span>
          <div class="form-input-area"><span data-field="full_name">{{ full_name }}</span></div>
        </div>
        <div>
          <span class="form-label">Major</span>
          <div class="form-input-area"><span data-field="major">{{ major }}</span></div>
        </div>
      </div>

      <div class="form-row">
        <div>
          <span class="form-label">Student ID ("U-Number")</span>
          <div class="form-input-area"><span data-field="student_id">{{ student_id }}</span></div>
        </div>
        <div>
          <span class="form-label">Email Address</span>
          <div class="form-input-area"><span data-field="email_address">{{ email_address }}</span></div>
        </div>
      </div>

      <div class="form-row">
        <div>
          <span class="form-label">Proposed Thesis Title</span>
          <div class="form-input-area"><span data-field="thesis_title">{{ thesis_title }}</span></div>
        </div>
        <div>
          <span class="form-label">Course #</span>
          <div class="form-input-area"><span data-field="course_number">{{ course_number }}</span></div>
        </div>
      </div>

      <div class="form-row">
        <div>
          <span class="form-label">Department</span>
          <div class="form-input-area"><span data-field="department">{{ department }}</span></div>
        </div>
        <div>
          <span class="form-label">Expected Completion Date</span>
          <div class="form-input-area"><span data-field="expected_completion_date">{{ expected_completion_date }}</span></div>
        </div>
      </div>
      
      <div class="form-row">
        <div>
          <span class="form-label">Thesis Advisor (please print)</span>
          <div class="form-input-area"><span data-field="thesis_advisor_name">{{ thesis_advisor_name }}</span></div>
        </div>
        <div>
          <span class="form-label">Graduation Date</span>
          <div class="form-input-area"><span data-field="graduation_date">{{ graduation_date }}</span></div>
        </div>
      </div>
    </div>

    <div class="form-section" style="border: 1px solid #000; padding: 20px;">
      <p style="font-weight: bold;">For this proposal approval, please obtain the following signatures:</p>

      <div class="signature-block">
        <div class="signature-row">
          <div class="signature-label">Student Signature</div>
          <div class="signature-line" data-field="student_signature">{{ student_signature }}</div>
          <div style="text-align: right;">Date: <span data-field="student_signature_date">{{ student_signature_date }}</span></div>
        </div>

        <div class="signature-row">
          <div class="signature-label">Honors Project Advisor</div>
          <div class="signature-line" data-field="honors_project_advisor">{{ honors_project_advisor }}</div>
          <div style="text-align: right;">Date: <span data-field="advisor_signature_date">{{ advisor_signature_date }}</span></div>
        </div>

        <div class="signature-row">
          <div class="signature-label">Departmental Honors Coordinator Advisor (if any)</div>
          <div class="signature-line" data-field="departmental_honors_coordinator_advisor">{{ departmental_honors_coordinator_advisor }}</div>
          <div style="text-align: right;">Date: <span data-field="coordinator_signature_date">{{ coordinator_signature_date }}</span></div>
        </div>

        <div class="signature-row">
          <div class="signature-label">Honors Program Director</div>
          <div class="signature-line" data-field="honors_program_director">{{ honors_program_director }}</div>
          <div style="text-align: right;">Date: <span data-field="director_signature_date">{{ director_signature_date }}</span></div>
        </div>
      </div>
    </div>

  </div>
</body>