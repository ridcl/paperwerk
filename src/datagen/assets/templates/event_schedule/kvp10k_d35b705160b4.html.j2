                    <img src="" alt="Mascot Logo" style="width: 100px;">
                    <h3 style="font-size: 20pt; margin: 10px 0;">DIVISION OF STUDENT AFFAIRS</h3>
                    <p style="font-size: 12pt;">Follow us on Instagram</p>
                    <p style="font-size: 12pt;">@{{ social_media_handle }}</p>
                </div>
            </div>
        </div>
