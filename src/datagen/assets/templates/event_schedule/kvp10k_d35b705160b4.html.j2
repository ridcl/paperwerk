                    <h1 style="font-size: 36pt; margin: 0;">FISK</h1>
                    <h2 style="font-size: 18pt; margin: 0;">UNIVERSITY</h2>
                    <p style="font-size: 10pt; margin: 2px 0 0 0;">ESTABLISHED 1866</p>
                </div>
            </div>
            <div class="header-title" style="width: 60%; text-align: right;">
                <h1 style="font-size: 60pt; margin: 0;">P.A.W.S</h1>
                <p style="font-size: 16pt; margin: 5px 0;">PREPARING, ADVISING, AND WELCOMING STUDENTS</p>
                <h2 style="font-size: 30pt; margin: 10px 0;">NEW STUDENT ORIENTATION</h2>
