<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; /* Using serif fonts as a safe default */
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic layout structure */
  .header-info { display: flex; justify-content: space-between; margin-bottom: 40px; }
  .logo-area { /* Placeholder for logo area */ }
  .title-area { text-align: center; margin-bottom: 40px; }
  .form-section { margin-bottom: 30px; }
  .form-row { display: flex; margin-bottom: 15px; }
  .form-row > div { flex: 1; padding-right: 20px; }
  .form-row .full-width { flex: 2; }
  .input-field { border: 1px solid #ccc; padding: 8px; width: 100%; box-sizing: border-box; }
  .signature-line { border-bottom: 1px solid #000; width: 100%; margin-top: 50px; }
</style>

<div class="page">
  <div class="header-info">
    <div class="logo-area">
      <!-- Placeholder for University Logo/Name -->
      <div style="font-size: 18pt; font-weight: bold;">SOUTHWESTERN CHRISTIAN UNIVERSITY</div>
    </div>
    <div style="text-align: right; font-size: 10pt;">
      Southwestern Christian University<br>
      PO Box 340<br>
      Bethany, OK 73008<br>
      Phone: {{ contact_phone }}<br>
      Fax: {{ contact_fax }}
    </div>
  </div>

  <div class="title-area">
    <h1 style="font-size: 24pt; font-weight: bold;">COLLEGE TRANSCRIPT REQUEST</h1>
  </div>

  <!-- APPLICANT SECTION -->
  <div class="form-section">
    <h2 style="font-size: 14pt; font-weight: bold; margin-bottom: 15px;">APPLICANT</h2>
    <p style="font-size: 10pt; margin-bottom: 20px;">After filling in information below, give this form to your registrar.</p>

    <!-- SSN Row -->
    <div class="form-row">
      <div style="flex: 1;">
        Social Security Number
        <div style="margin-top: 5px;"><span class="input-field">{{ applicant.ssn }}</span></div>
      </div>
      <div style="flex: 1; display: flex; align-items: center; margin-left: 20px;">
        Gender:
        <label style="margin-left: 15px;"><input type="radio" name="gender" value="Male"> Male</label>
        <label style="margin-left: 15px;"><input type="radio" name="gender" value="Female"> Female</label>
      </div>
    </div>

    <!-- Name Rows -->
    <div class="form-row">
      <div style="flex: 1;">
        Legal last name
        <div style="margin-top: 5px;"><span class="input-field">{{ applicant.last_name }}</span></div>
      </div>
      <div style="flex: 1;">
        Legal first name
        <div style="margin-top: 5px;"><span class="input-field">{{ applicant.first_name }}</span></div>
      </div>
      <div style="flex: 1;">
        Middle name
        <div style="margin-top: 5px;"><span class="input-field">{{ applicant.middle_name }}</span></div>
      </div>
    </div>

    <!-- Address/Location Rows -->
    <div class="form-row">
      <div style="flex: 1;">
        Address: PO Box / Physical street address
        <div style="margin-top: 5px;"><span class="input-field">{{ applicant.address }}</span></div>
      </div>
      <div style="flex: 1;">
        City
        <div style="margin-top: 5px;"><span class="input-field">{{ applicant.city }}</span></div>
      </div>
      <div style="flex: 1;">
        State
        <div style="margin-top: 5px;"><span class="input-field">{{ applicant.state }}</span></div>
      </div>
      <div style="flex: 1;">
        Zip
        <div style="margin-top: 5px;"><span class="input-field">{{ applicant.zip }}</span></div>
      </div>
    </div>

    <!-- Phone/Date Rows -->
    <div class="form-row">
      <div style="flex: 1;">
        Area code and telephone
        <div style="margin-top: 5px;"><span class="input-field">{{ applicant.phone }}</span></div>
      </div>
      <div style="flex: 1;">
        Date of birth
        <div style="margin-top: 5px;"><span class="input-field">{{ applicant.dob }}</span></div>
      </div>
    </div>

    <!-- Signature -->
    <div style="margin-top: 40px;">
      Signature: 
      <div class="signature-line" style="width: 300px; display: inline-block; margin-left: 10px;" data-field="date_of_birth">{{ date_of_birth }}</div>
      Date: 
      <div class="signature-line" style="width: 150px; display: inline-block; margin-left: 10px;" data-field="signature">{{ signature }}</div>
    </div>
  </div>

  <!-- ADMINISTRATOR SECTION -->
  <div class="form-section">
    <h2 style="font-size: 14pt; font-weight: bold; margin-bottom: 15px;">ADMINISTRATOR</h2>
    <p style="font-size: 10pt; margin-bottom: 20px;">Please attach the applicant's transcript and mail to: Southwestern Christian University, Office of Admissions, PO Box 340, Bethany, OK 73008. Please provide all information possible for this applicant.</p>

    <!-- Class Rank -->
    <div class="form-row" style="margin-bottom: 25px;">
      <div style="flex: 1;">
        Class rank is 
        <div style="margin-top: 5px;"><span class="input-field">{{ administrator.class_rank }}</span></div>
        out of 
        <div style="margin-top: 5px;"><span class="input-field">{{ administrator.total_students }}</span></div>
      </div>
      <div style="flex: 1; display: flex; align-items: center; margin-left: 20px;">
        Is this student in good standing at your school?
        <label style="margin-left: 15px;"><input type="radio" name="standing" value="Yes"> Yes</label>
        <label style="margin-left: 15px;"><input type="radio" name="standing" value="No"> No</label>
        <span style="margin-left: 15px; font-size: 10pt;">If no, please explain.</span>
      </div>
    </div>

    <!-- Administrator Name/Position -->
    <div class="form-row">
      <div style="flex: 1;">
        Administrator's Name
        <div style="margin-top: 5px;"><span class="input-field">{{ administrator.name }}</span></div>
      </div>
      <div style="flex: 1;">
        Administrator's Position
        <div style="margin-top: 5px;"><span class="input-field">{{ administrator.position }}</span></div>
      </div>
    </div>

    <!-- Administrator Address/Location -->
    <div class="form-row">
      <div style="flex: 1;">
        Address
        <div style="margin-top: 5px;"><span class="input-field">{{ administrator.address }}</span></div>
      </div>
      <div style="flex: 1;">
        City
        <div style="margin-top: 5px;"><span class="input-field">{{ administrator.city }}</span></div>
      </div>
      <div style="flex: 1;">
        State
        <div style="margin-top: 5px;"><span class="input-field">{{ administrator.state }}</span></div>
      </div>
      <div style="flex: 1;">
        Zip
        <div style="margin-top: 5px;"><span class="input-field">{{ administrator.zip }}</span></div>
      </div>
    </div>

    <!-- Administrator Phone/Fax -->
    <div class="form-row">
      <div style="flex: 1;">
        Area code and telephone
        <div style="margin-top: 5px;"><span class="input-field">{{ administrator.phone }}</span></div>
      </div>
      <div style="flex: 1;">
        Area code and fax
        <div style="margin-top: 5px;"><span class="input-field">{{ administrator.fax }}</span></div>
      </div>
    </div>

    <!-- Administrator Signature -->
    <div style="margin-top: 40px;">
      Administrator's Signature
      <div class="signature-line" style="width: 300px; display: inline-block; margin-left: 10px;" data-field="area_code_and_fax">{{ area_code_and_fax }}</div>
      Date
      <div class="signature-line" style="width: 150px; display: inline-block; margin-left: 10px;" data-field="administrator_s_signature">{{ administrator_s_signature }}</div>
    </div>
  </div>
</div>