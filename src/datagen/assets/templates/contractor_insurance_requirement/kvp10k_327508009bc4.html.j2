<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 {
    font-weight: bold;
  }
  .form-group {
    margin-bottom: 15px;
  }
  .field-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 10px;
  }
  .field-row > div {
    width: 48%;
  }
  .full-width-field {
    width: 100%;
    margin-bottom: 10px;
  }
  .line-item-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
  }
  .line-item-table th, .line-item-table td {
    border: 1px solid #ccc;
    padding: 8px;
    text-align: left;
  }
  .signature-line {
    border-bottom: 1px solid black;
    width: 100%;
    margin-top: 50px;
  }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      <img src="placeholder_logo.png" alt="FAU Logo" style="height: 80px;">
      <h1 style="margin-top: 10px;">BUILDING PERMIT APPLICATION</h1>
      <p style="font-size: 0.9em;">To be submitted by the Project Contractor or Construction Manager</p>
    </div>
    <div style="text-align: right; font-size: 0.9em;">
      <p>Office of Environmental Health and Safety</p>
      <p>Building Code Administration</p>
      <p>777 Glades Road, CO 69 - Suite 112 Boca Raton, FL 33431</p>
      <p>Phone: <span data-field="phone_number">{{ phone_number }}</span></p>
      <p>Email: <span data-field="email_address">{{ email_address }}</span></p>
      <p>www.<span data-field="website">{{ website }}</span></p>
    </div>
  </div>

  <div style="margin-top: 40px;">
    <div class="form-group">
      <p>Applicant:</p>
      <p>Name: <span data-field="applicant.full_name">{{ applicant.full_name }}</span></p>
      <p>Street Address: <span data-field="applicant.street_address">{{ applicant.street_address }}</span></p>
      <p>Mailing Address: <span data-field="applicant.mailing_address">{{ applicant.mailing_address }}</span></p>
      <p>Phone Number: <span data-field="applicant.phone_number">{{ applicant.phone_number }}</span></p>
      <p>Contractor Type/License No.: <span data-field="applicant.contractor_license_number">{{ applicant.contractor_license_number }}</span></p>
      <p>Qualifying Agent's Names: <span data-field="applicant.qualifying_agent_names">{{ applicant.qualifying_agent_names }}</span></p>
    </div>

    <div class="field-row">
      <div>
        <p>Qualifying Agent's Signature:</p>
        <div class="signature-line"></div>
        <p>Date:</p>
      </div>
      <div>
        <p>Type of Work: New - Remodeling - Addition - Renovation - Repair - Alteration - Demo</p>
        <p>Project:</p>
        <p>Name: <span data-field="project.name">{{ project.name }}</span></p>
        <p>Location: <span data-field="project.location">{{ project.location }}</span></p>
        <p>Value/Description of Work:</p>
        <div class="full-width-field"><span data-field="project.value_description">{{ project.value_description }}</span></div>
      </div>
    </div>

    <div class="field-row" style="margin-top: 20px;">
      <div>
        <p>FAU Project Number:</p>
        <div class="full-width-field"><span data-field="project.fau_project_number">{{ project.fau_project_number }}</span></div>
      </div>
      <div>
        <p>FAU Project Manager's Name:</p>
        <div class="full-width-field"><span data-field="project.fau_project_manager_name">{{ project.fau_project_manager_name }}</span></div>
      </div>
    </div>

    <h2 style="margin-top: 40px;">Occupancy Classification</h2>
    <table class="line-item-table">
      <thead>
        <tr>
          <th>Occupancy Classification</th>
          <th>Construction Type</th>
          <th>Floor Area Gross Square Feet</th>
          <th>Building Height (Feet)</th>
        </tr>
      </thead>
      <tbody>
        {% for item in occupancy_details %}
        <tr>
          <td><span data-field="occupancy_details[{{ loop.index0 }}].classification">{{ occupancy_details[loop.index0].classification }}</span></td>
          <td><span data-field="occupancy_details[{{ loop.index0 }}].construction_type">{{ occupancy_details[loop.index0].construction_type }}</span></td>
          <td><span data-field="occupancy_details[{{ loop.index0 }}].floor_area">{{ occupancy_details[loop.index0].floor_area }}</span></td>
          <td><span data-field="occupancy_details[{{ loop.index0 }}].building_height">{{ occupancy_details[loop.index0].building_height }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <h2 style="margin-top: 40px;">Architect/Engineer:</h2>
    <div class="form-group">
      <p>Name: <span data-field="architect_engineer.full_name">{{ architect_engineer.full_name }}</span></p>
      <p>Street Address: <span data-field="architect_engineer.street_address">{{ architect_engineer.street_address }}</span></p>
      <p>Mailing Address: <span data-field="architect_engineer.mailing_address">{{ architect_engineer.mailing_address }}</span></p>
      <p>Phone No.: <span data-field="architect_engineer.phone_number">{{ architect_engineer.phone_number }}</span></p>
      <p>A/E License No.: <span data-field="architect_engineer.license_number">{{ architect_engineer.license_number }}</span></p>
    </div>

    <div class="field-row">
      <div>
        <p>Email: <span data-field="architect_engineer.email">{{ architect_engineer.email }}</span></p>
        <p>Expiration Date: <span data-field="architect_engineer.expiration_date">{{ architect_engineer.expiration_date }}</span></p>
      </div>
    </div>
  </div>
</div>

<div class="page">
  <h2 style="text-align: center; margin-bottom: 30px;">FAU Contractor Insurance Requirement</h2>

  <p>The Contractor agrees to furnish to FAU, contemporaneously with the signing of this Agreement, a Certificate of Liability Insurance (COI), naming FAU as the Certificate Holder and issued in a form and by a company acceptable to the University, evidencing proof of:</p>

  <ol style="margin-left: 20px;">
    <li>
      <p>Commercial General Liability (CGL) insurance in an amount of at least $1,000,000 each occurrence and at least $2,000,000 general aggregate. Such insurance shall contain the following language and such language shall be evidenced on the COI: "The <span data-field="insurance_policy_holder">{{ insurance_policy_holder }}</span>, the State of Florida and their respective officers, agents, volunteers and employees are listed as Additional Insureds under this commercial general liability policy."</p>
    </li>
    <li>
      <p>Business Automobile (BA) insurance evidencing liability coverage for any auto in an amount of at least $1,000,000 each accident.</p>
    </li>
    <li>
      <p>Workers compensation (WC) insurance as required by Florida law.</p>
    </li>
  </ol>

  <p style="margin-top: 30px;">FAU reserves the right, in its sole discretion, to also require insurance coverage as set forth above from any of the Contractor's sub-contractors or others assisting Contractor in connection with this Agreement.</p>
</div>