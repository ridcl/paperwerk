<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "Liberation Serif", Georgia, serif; }
  h1, h2, h3 { text-align: center; margin-bottom: 20px; }
  .header-info { display: flex; justify-content: space-between; margin-bottom: 40px; }
  .section-title { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 15px; }
  .form-group { flex: 1; margin-right: 20px; }
  .full-width-section { margin-top: 30px; }
  table { width: 100%; border-collapse: collapse; margin-top: 15px; }
  td { padding: 8px; border: 1px solid #ccc; text-align: left; }
  .checkbox-group label { display: inline-block; margin-right: 15px; }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      <img src="logo_placeholder.png" alt="University Logo" style="height: 60px;">
      <h1 style="font-size: 18pt; margin-top: 10px;">LAWRENCE UNIVERSITY</h1>
      <p style="font-size: 10pt;">APPLETON, WISCONSIN</p>
    </div>
    <div style="text-align: right;">
      <p style="font-size: 10pt;">Financial Aid Office</p>
      <p style="font-size: 10pt;">{{ employer.address_line_1 }}</p>
      <p style="font-size: 10pt;">{{ employer.address_line_2 }}</p>
      <p style="font-size: 10pt;">PHONE: ({{ employer.phone_area_code }}) {{ employer.phone_prefix }}-{{ employer.phone_line }} | FAX: ({{ employer.fax_area_code }}) {{ employer.fax_prefix }}-{{ employer.fax_line }}</p>
      <p style="font-size: 10pt;">{{ employer.email }}</p>
    </div>
  </div>

  <h2 style="text-align: center; margin-top: 40px;">2022-2023 PARENT NON-TAX FILER FORM</h2>

  <!-- Section A -->
  <div class="full-width-section">
    <div class="section-title">A. 2020 INCOME FROM WORK</div>
    <p>Check the box that applies:</p>
    <div style="margin-top: 10px;">
      <div class="checkbox-group">
        <label><input type="checkbox"> I was not employed and had no income earned from work in 2020. Continue to Section C.</label>
      </div>
      <div class="checkbox-group" style="margin-top: 10px;">
        <label><input type="checkbox"> I was employed in 2020. Continue to Section B.</label>
      </div>
    </div>
  </div>

  <!-- Section B -->
  <div class="full-width-section">
    <div class="section-title">B. 2020 INCOME EARNED FROM WORK</div>
    <p>Complete this section and submit a copy of your 2020 W-2 Form(s) to the Financial Aid Office.</p>

    <table>
      <thead>
        <tr>
          <td style="width: 25%;">EMPLOYER'S NAME</td>
          <td style="width: 15%;">DID YOU RECEIVE A W-2 FORM?</td>
          <td style="width: 15%;">COPY OF W-2 FORM ATTACHED?</td>
          <td style="width: 25%;">AMOUNT REPORTED IN BOX 1 OF W-2 FORM</td>
        </tr>
      </thead>
      <tbody>
        {% for item in work_experience %}
        <tr>
          <td><span data-field="work_experience[{{ loop.index0 }}].employer_name">{{ item.employer_name }}</span></td>
          <td>
            <div class="checkbox-group">
              <label><input type="checkbox"> Yes</label>
              <label><input type="checkbox"> No</label>
            </div>
          </td>
          <td>
            <div class="checkbox-group">
              <label><input type="checkbox"> Yes</label>
              <label><input type="checkbox"> No</label>
            </div>
          </td>
          <td><span data-field="work_experience[{{ loop.index0 }}].box_1_amount">{{ item.box_1_amount }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <!-- Other Income Table -->
  <div class="full-width-section">
    <div class="section-title">OTHER INCOME</div>
    <table>
      <thead>
        <tr>
          <td style="width: 50%;">OTHER INCOME</td>
          <td style="width: 20%;">DID YOU RECEIVE A W-2 FORM?</td>
          <td style="width: 30%;">AMOUNT EARNED</td>
        </tr>
      </thead>
      <tbody>
        {% for item in other_income %}
        <tr>
          <td><span data-field="other_income[{{ loop.index0 }}].description">{{ item.description }}</span></td>
          <td>
            <div class="checkbox-group">
              <label><input type="checkbox"> Yes</label>
              <label><input type="checkbox"> No</label>
            </div>
          </td>
          <td><span data-field="other_income[{{ loop.index0 }}].amount">{{ item.amount }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <!-- Section C -->
  <div class="full-width-section">
    <div class="section-title">C. VERIFICATION OF NON-FILING LETTER</div>
    <p>Request a Verification of Non-filing Letter from the IRS at <a href="https://www.irs.gov/individuals/get-transcript">https://www.irs.gov/individuals/get-transcript</a>. After you receive a copy of the Verification of Non-filing Letter, please forward a copy of the letter to the Lawrence University Financial Aid Office.</p>
  </div>

  <!-- Section D -->
  <div class="full-width-section">
    <div class="section-title">D. CERTIFICATION AND SIGNATURE</div>
    <p>By signing this form, I certify that all information on this application is complete and correct.</p>
    <p>Please reach out to our office if you are not able to provide a handwritten signature. We will provide details on an alternative way to sign this form.</p>

    <div style="display: flex; justify-content: space-between; margin-top: 60px;">
      <div style="width: 45%;">
        <p>SIGNATURE OF NON-TAX FILER</p>
        <div style="border-bottom: 1px solid black; margin-top: 50px;" data-field="signature_of_non_tax_filer">{{ signature_of_non_tax_filer }}</div>
      </div>
      <div style="width: 45%; text-align: right;">
        <p>DATE</p>
        <div style="border-bottom: 1px solid black; margin-top: 50px;" data-field="date">{{ date }}</div>
      </div>
    </div>
  </div>
</div>