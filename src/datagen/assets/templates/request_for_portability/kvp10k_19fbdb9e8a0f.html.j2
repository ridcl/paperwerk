<!DOCTYPE html>
<html>
<head>
<title>Portability Request</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 15px;
  }
  td, th {
    padding: 8px;
    text-align: left;
  }
  .header {
    font-weight: bold;
    text-align: center;
  }
  .section-title {
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
  }
</style>
</head>
<body>
<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px;">
    <div>
      <h1 style="font-size: 18pt; margin: 0;">Request for Portability of 2018 Accident Insurance</h1>
      <p style="font-size: 10pt; margin-top: 5px;">Forms UHI-ACC-POL et al</p>
    </div>
    <div style="text-align: right;">
      <img src="placeholder_logo.png" alt="UnitedHealthcare Logo" style="height: 60px;">
    </div>
  </div>

  <p style="font-size: 10pt; margin-bottom: 20px;">
    <span style="font-weight: bold;">PLEASE NOTE:</span> This form must be received by <span data-field="date_of_termination_deadline">{{ date_of_termination_deadline }}</span> of Termination.
  </p>
  <p style="font-size: 10pt; margin-bottom: 20px;">
    All sections of this form must be complete for us to process your request.
  </p>
  <p style="font-size: 10pt; margin-bottom: 20px;">
    The Employee or applicable Dependent will not be eligible to port the Accident coverage if the Employee has not been insured under the policy for at least 6 months (time limit may vary by state). Refer to your COC for other eligibility requirements.
  </p>

  <div class="section-title">Sections A, B and C to be completed by Employer</div>

  <h3 style="font-weight: bold; margin-top: 15px;">A. Information about EMPLOYEE</h3>
  <table>
    <thead>
      <tr>
        <th style="width: 20%;">Employee Last Name</th>
        <th style="width: 20%;">First Name</th>
        <th style="width: 15%;">M.I.</th>
        <th style="width: 25%;">Date of Birth</th>
        <th style="width: 20%;">Date of Hire</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="employee.last_name">{{ employee.last_name }}</span></td>
        <td><span data-field="employee.first_name">{{ employee.first_name }}</span></td>
        <td><span data-field="employee.middle_initial">{{ employee.middle_initial }}</span></td>
        <td><span data-field="employee.dob">{{ employee.dob }}</span></td>
        <td><span data-field="employee.hire_date">{{ employee.hire_date }}</span></td>
      </tr>
    </tbody>
  </table>

  <table>
    <thead>
      <tr>
        <th style="width: 30%;">Monthly Premium</th>
        <th style="width: 30%;">Initial Effective Date</th>
        <th style="width: 40%;">Date premium paid to</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="monthly_premium">{{ monthly_premium }}</span></td>
        <td><span data-field="initial_effective_date">{{ initial_effective_date }}</span></td>
        <td><span data-field="premium_payment_date">{{ premium_payment_date }}</span></td>
      </tr>
    </tbody>
  </table>

  <table>
    <thead>
      <tr>
        <th style="width: 50%;">Date of Termination</th>
        <th style="width: 50%;">Reason for Termination</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="termination_date">{{ termination_date }}</span></td>
        <td><span data-field="termination_reason">{{ termination_reason }}</span></td>
      </tr>
    </tbody>
  </table>

  <h3 style="font-weight: bold; margin-top: 15px;">B. Information about Spouse and Dependent(s) (Complete only when the Dependent Portability option is available.)</h3>
  <table>
    <thead>
      <tr>
        <th style="width: 30%;">Dependent Name and Relationship</th>
        <th style="width: 15%;">SS#</th>
        <th style="width: 25%;">Date of Birth</th>
        <th style="width: 20%;">Benefit Plan (Plan A, B or C, if specified)</th>
        <th style="width: 10%;">Monthly Premium</th>
      </tr>
    </thead>
    <tbody>
      {% for item in dependents %}
      <tr>
        <td><span data-field="dependents[{{ loop.index0 }}].name">{{ item.name }}</span></td>
        <td><span data-field="dependents[{{ loop.index0 }}].ssn">{{ dependents[loop.index0].ssn }}</span></td>
        <td><span data-field="dependents[{{ loop.index0 }}].dob">{{ item.dob }}</span></td>
        <td><span data-field="dependents[{{ loop.index0 }}].benefit_plan">{{ item.benefit_plan }}</span></td>
        <td><span data-field="dependents[{{ loop.index0 }}].premium">{{ item.premium }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <h3 style="font-weight: bold; margin-top: 15px;">C. Employer Information</h3>
  <table>
    <thead>
      <tr>
        <th style="width: 50%;">Employer's Signature</th>
        <th style="width: 50%;">Printed Name</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="employer.signature_line">{{ employer.signature_line }}</span></td>
        <td><span data-field="employer.printed_name">{{ employer.printed_name }}</span></td>
      </tr>
    </tbody>
  </table>

  <table>
    <thead>
      <tr>
        <th style="width: 50%;">Company Phone Number</th>
        <th style="width: 50%;">Date</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="employer.phone_number">{{ employer.phone_number }}</span></td>
        <td><span data-field="employer.date">{{ employer.date }}</span></td>
      </tr>
    </tbody>
  </table>

  <table>
    <thead>
      <tr>
        <th style="width: 50%;">Group Name</th>
        <th style="width: 50%;">Group Policy Number</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="employer.group_name">{{ employer.group_name }}</span></td>
        <td><span data-field="employer.policy_number">{{ employer.policy_number }}</span></td>
      </tr>
    </tbody>
  </table>

  <p style="font-size: 10pt; margin-top: 10px;">Date this form given to Employee: <span data-field="form_given_date">{{ form_given_date }}</span></p>

  <div class="section-title">Sections D, E and F to be completed by Employee</div>

  <h3 style="font-weight: bold; margin-top: 15px;">D. Employee Information</h3>
  <table>
    <thead>
      <tr>
        <th style="width: 50%;">Address (Street, City, State and ZIP code)</th>
        <th style="width: 50%;">Phone Number:</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="employee.address">{{ employee.address }}</span></td>
        <td><span data-field="employee.phone">{{ employee.phone }}</span></td>
      </tr>
    </tbody>
  </table>

  <h3 style="font-weight: bold; margin-top: 15px;">E. Insurance Coverage You Are Requesting To Port</h3>
  <p style="font-size: 10pt; margin-bottom: 10px;">Check appropriate election (you may only port coverage that is shown above by your employer as being in force and portable per the Group policy):</p>
  <table>
    <thead>
      <tr>
        <th style="width: 33%;">Employee</th>
        <th style="width: 33%;">Employee and Dependent Spouse</th>
        <th style="width: 33%;">Employee and Dependent Children</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><input type="checkbox"></td>
        <td><input type="checkbox"></td>
        <td><input type="checkbox"></td>
      </tr>
    </tbody>
  </table>

  <h3 style="font-weight: bold; margin-top: 15px;">F. Quarterly or Annual Premium Calculation</h3>
  <p style="font-size: 10pt; margin-bottom: 10px;">Please choose either Quarterly or Annual billing:</p>
  <div style="margin-bottom: 20px;">
    <label><input type="radio" name="billing_frequency" value="quarterly"> Quarterly</label>
    <label style="margin-left: 20px;"><input type="radio" name="billing_frequency" value="annual"> Annual</label>
  </div>

  <p style="font-size: 10pt; margin-bottom: 10px;">Have you used tobacco of any kind during the last 12 months? <input type="radio" name="tobacco_use" value="yes"> Yes <input type="radio" name="tobacco_use" value="no"> No</p>

  <h4 style="font-weight: bold; margin-top: 20px;">Quarterly Premium Calculations</h4>
  <p style="font-size: 10pt; margin-bottom: 10px;">Employee's quarterly premium is calculated:</p>
  <p style="font-size: 10pt; margin-bottom: 10px;">Monthly premium x 3 = <span data-field="quarterly_premium_calc">{{ quarterly_premium_calc }}</span></p>
  <p style="font-size: 10pt; margin-bottom: 20px;">This is your new Quarterly Premium</p>

  <h4 style="font-weight: bold; margin-top: 20px;">Annual Premium Calculations</h4>
  <p style="font-size: 10pt; margin-bottom: 10px;">Employee's annual premium is calculated:</p>
  <p style="font-size: 10pt; margin-bottom: 10px;">Monthly premium x 12 = <span data-field="annual_premium_calc">{{ annual_premium_calc }}</span></p>
  <p style="font-size: 10pt; margin-bottom: 20px;">This is your new Annual Premium</p>

  <p style="font-size: 10pt; margin-bottom: 20px;">If you are requesting portability coverage for your spouse and/or dependents, a similar calculation should be done for your Spouse and Dependent Child(ren) and listed below.</p>

  <p style="font-size: 10pt; margin-bottom: 10px;">Employee's premium amount: $ <span data-field="employee_premium_amount">{{ employee_premium_amount }}</span></p>
  <p style="font-size: 10pt; margin-bottom: 10px;">Spouse's premium amount: $ <span data-field="spouse_premium_amount">{{ spouse_premium_amount }}</span></p>
  <p style="font-size: 10pt; margin-bottom: 10px;">Dependent's premium amount: $ <span data-field="dependent_premium_amount">{{ dependent_premium_amount }}</span></p>
  <p style="font-size: 10pt; margin-bottom: 20px;">Total payment required with this form (Employee + Spouse+ Dependents): $ <span data-field="total_payment_required">{{ total_payment_required }}</span></p>

  <h3 style="font-weight: bold; margin-top: 15px;">G. Employee Signature</h3>
  <p style="font-size: 10pt; margin-bottom: 10px;">Enclosed with this form is my first quarter or annual premium. I hereby authorize UnitedHealthcare Insurance Company to begin billing me directly for my 2018 Accident Insurance coverage.</p>

  <table>
    <thead>
      <tr>
        <th style="width: 50%;">Insured Employee</th>
        <th style="width: 50%;">Date</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="employee.signature_line">{{ employee.signature_line }}</span></td>
        <td><span data-field="employee.signature_date">{{ employee.signature_date }}</span></td>
      </tr>
    </tbody>
  </table>

  <p style="font-size: 10pt; margin-top: 30px;">Make your check payable to UnitedHealthcare. Mail this completed form with your premium to:</p>
  <p style="font-size: 10pt; margin-top: 5px;">UnitedHealthcare</p>
  <p style="font-size: 10pt; margin-top: 5px;">12700 Whitewater Drive</p>
  <p style="font-size: 10pt; margin-top: 5px;">MN022-0310</p>
  <p style="font-size: 10pt; margin-top: 5px;">Minnetonka, MN 55343</p>
  <p style="font-size: 10pt; margin-top: 5px;">1-877-683-8601</p>

</div>

<div class="page">
  <table style="width: 100%;">
    <thead>
      <tr>
        <th style="width: 33%;">UnitedHealthcare Use Only</th>
        <th style="width: 33%;">Date Acknowledgment Mailed</th>
        <th style="width: 33%;">Group Number</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="use_only.date_received">{{ use_only.date_received }}</span></td>
        <td><span data-field="use_only.date_mailed">{{ use_only.date_mailed }}</span></td>
        <td><span data-field="use_only.group_number">{{ use_only.group_number }}</span></td>
      </tr>
    </tbody>
  </table>

  <div style="text-align: center; margin-top: 50px;">
    <button style="padding: 10px 30px; font-size: 12pt; cursor: pointer;">RESET</button>
  </div>

  <p style="font-size: 9pt; text-align: right; margin-top: 50px;">2018 ACC-Port (Rev 04/2021)</p>
  <p style="font-size: 9pt; text-align: right;">UA 7.2020</p>
</div>

</body>
</html>