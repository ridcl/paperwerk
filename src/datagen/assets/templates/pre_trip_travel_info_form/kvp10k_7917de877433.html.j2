<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "Liberation Sans", "DejaVu Sans", Arial, sans-serif; }
  h1 { font-size: 24pt; font-weight: bold; margin-bottom: 10px; }
  h2 { font-size: 14pt; font-weight: bold; margin-top: 20px; margin-bottom: 5px; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 15px; }
  .form-row > div { width: 48%; }
  .line-item-table { width: 100%; border-collapse: collapse; margin-top: 10px; }
  .line-item-table td { padding: 5px 0; border-bottom: 1px solid #ccc; }
  .full-width-field { width: 100%; border-bottom: 1px solid #000; margin-bottom: 15px; }
</style>

<div class="page">
  <h1>Pre-Trip Travel Info Form</h1>
  <p>Complete all information and return to your advisor's admin assistant <span data-field="advisor_contact_info">{{ advisor_contact_info }}</span></p>

  <div class="form-row">
    <div>Traveler's Full Name:</div>
    <div><span data-field="full_name" class="full-width-field">{{ full_name }}</span></div>
  </div>

  <div class="form-row">
    <div>Phone:</div>
    <div><span data-field="phone" class="full-width-field">{{ phone }}</span></div>
  </div>

  <div class="form-row">
    <div>Email:</div>
    <div><span data-field="email" class="full-width-field">{{ email }}</span></div>
  </div>

  <div class="form-row">
    <div>CSU Employee ID Number:</div>
    <div><span data-field="employee_id" class="full-width-field">{{ employee_id }}</span></div>
  </div>

  <div class="form-row">
    <div>Destination - From:</div>
    <div>To:</div>
  </div>
  <div class="form-row">
    <div>Departure Date:</div>
    <div>Return Date:</div>
  </div>

  <div class="form-row">
    <div>If Multiple Destinations: Destination 2 - From:</div>
    <div>To:</div>
  </div>
  <div class="form-row">
    <div>Departure Date:</div>
    <div>Return Date:</div>
  </div>

  <div class="form-row">
    <div>Emergency Contact (s):</div>
    <div><span data-field="emergency_contact_details" class="full-width-field">{{ emergency_contact_details }}</span></div>
  </div>

  <div class="form-row">
    <div>Phone Number(s):</div>
    <div>Relationship:</div>
  </div>

  <div class="form-row">
    <div>If you are a non-US citizen: Country of Citizenship:</div>
    <div>Non-resident Alien:</div>
  </div>

  <p><strong>If International Travel,</strong> region familiarity and lodging information is required by the University.</p>

  <div class="form-row">
    <div>Region Familiarity (i.e. 60 miles north of Paris):</div>
    <div><span data-field="region_familiarity" class="full-width-field">{{ region_familiarity }}</span></div>
  </div>

  <div class="form-row">
    <div>Hotel Name, Address, and Phone:</div>
    <div><span data-field="lodging_details" class="full-width-field">{{ lodging_details }}</span></div>
  </div>

  <h2>Account Number(s):</h2>
  <div class="form-row">
    <div>Account Number(s):</div>
    <div>Indicate % if Split Funding:</div>
  </div>

  <h2>ESTIMATED EXPENSES:</h2>
  <table class="line-item-table">
    <thead>
      <tr>
        <td style="width: 50%;">Per Diem for <span data-field="per_diem_days">{{ per_diem_days }}</span> days</td>
        <td style="width: 50%;">Lodging for <span data-field="lodging_nights">{{ lodging_nights }}</span> nights @ $ <span data-field="lodging_rate">{{ lodging_rate }}</span> per night</td>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Mileage @ <span data-field="mileage_rate">{{ mileage_rate }}</span> miles</td>
        <td></td>
      </tr>
      <tr>
        <td>Parking $ <span data-field="parking_cost">{{ parking_cost }}</span></td>
        <td>Rental Car/Gas $ <span data-field="rental_car_gas_cost">{{ rental_car_gas_cost }}</span></td>
      </tr>
      <tr>
        <td>Ground Transportation $ <span data-field="ground_transport_cost">{{ ground_transport_cost }}</span></td>
        <td>Tolls $ <span data-field="tolls_cost">{{ tolls_cost }}</span></td>
      </tr>
      <tr>
        <td>Registration Fee $ <span data-field="registration_fee_cost">{{ registration_fee_cost }}</span></td>
        <td>Was Registration Fee Paid by PCard: <span data-field="paid_by_pcard">{{ paid_by_pcard }}</span></td>
      </tr>
      <tr>
        <td>Other Expenses (itemize) $ <span data-field="other_expenses_cost">{{ other_expenses_cost }}</span></td>
        <td>$ <span data-field="other_expenses_detail">{{ other_expenses_detail }}</span></td>
      </tr>
      <tr>
        <td>$ <span data-field="total_estimated_expenses">{{ total_estimated_expenses }}</span></td>
        <td>$ <span data-field="total_estimated_expenses_check">{{ total_estimated_expenses_check }}</span></td>
      </tr>
    </tbody>
  </table>

  <h2>Purpose and Justification:</h2>
  <div class="full-width-field" style="height: 100px;" data-field="purpose_and_justification">{{ purpose_and_justification }}</div>

  <p style="margin-top: 50px; font-size: 10pt;">Form Updated 7/28/2015</p>
</div>