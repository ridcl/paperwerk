<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "Liberation Serif", Georgia, serif; }
  h1, h2 { font-weight: bold; }
  table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
  td { padding: 8px 0; }
  .form-group { margin-bottom: 15px; }
  .checkbox-group label { display: inline-block; margin-right: 15px; }
  textarea { width: 100%; height: 150px; border: 1px solid #ccc; padding: 10px; box-sizing: border-box; margin-top: 5px; }
</style>

<div class="page">
  <div style="text-align: center; margin-bottom: 30px;">
    <img src="placeholder_logo.png" alt="University Logo" style="height: 60px; margin-bottom: 10px;">
    <h1 style="font-size: 24pt; margin: 0;">UNIVERSITY OF WYOMING</h1>
    <h2 style="font-size: 14pt; margin-top: 5px;">Safety Office</h2>
    <h3 style="font-size: 16pt; margin-top: 10px;">Indoor Air Quality Evaluation Request Form</h3>
  </div>

  <table style="width: 100%;">
    <tr>
      <td style="width: 50%; padding-right: 20px;">
        <div class="form-group">
          Name: <span data-field="full_name">{{ full_name }}</span>
        </div>
        <div class="form-group">
          Position Title: <span data-field="position_title">{{ position_title }}</span>
        </div>
        <div class="form-group">
          Supervisor's Name: <span data-field="supervisor_name">{{ supervisor_name }}</span>
        </div>
        <div class="form-group">
          Department: <span data-field="department">{{ department }}</span>
        </div>
      </td>
      <td style="width: 50%;">
        <div class="form-group">
          Phone: <span data-field="phone_number">{{ phone_number }}</span>
        </div>
        <div class="form-group">
          Date: <span data-field="date">{{ date }}</span>
        </div>
        <div class="form-group">
          Supervisor's Phone: <span data-field="supervisor_phone">{{ supervisor_phone }}</span>
        </div>
      </td>
    </tr>
  </table>

  <p>Please indicate why you are requesting an indoor air quality evaluation (check all that apply):</p>

  <div style="margin-bottom: 20px;">
    <div class="checkbox-group">
      <label><input type="checkbox"> Odor Concerns</label>
      <label><input type="checkbox"> Temperature Concerns (too hot or too cold)</label>
      <label><input type="checkbox"> Air Circulation Concerns</label>
      <label><input type="checkbox"> Dust/Particulates</label>
      <label><input type="checkbox"> Recent Water Intrusion</label>
      <label><input type="checkbox"> Health Symptoms (please describe below)</label>
      <label><input type="checkbox"> Other (bird feces, rodents, smoking, etc)</label>
    </div>
  </div>

  <div class="form-group">
    Please describe your health symptoms:
    <textarea data-field="health_symptoms_description">{{ health_symptoms_description }}</textarea>
  </div>

  <div style="margin-top: 50px; font-size: 10pt;">
    Please return this form to the UW Safety Office at <span data-field="safety_email_contact">{{ safety_email_contact }}</span> or <span data-field="alternative_email_contact">{{ alternative_email_contact }}</span>.
  </div>

  <div style="margin-top: 100px; font-size: 9pt; text-align: center;">
    UW Safety Office • Dept. 3227 • 262 Wyoming Hall • Laramie, WY 82071<br>
    (307) 766-3277 • e-mail: <span data-field="office_email">{{ office_email }}</span>
  </div>
</div>