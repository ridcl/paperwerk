    <h1 class="title">A1327</h1>
    <h1 class="title">Dynamic Modeling of Solid Oxide Fuel Cell Systems for Commercial Building Applications</h1>
    <div class="author-info">
        <p><span data-field="author_1_full_name">{{ author_1_full_name }}</span> and <span data-field="author_2_full_name">{{ author_2_full_name }}</span></p>
