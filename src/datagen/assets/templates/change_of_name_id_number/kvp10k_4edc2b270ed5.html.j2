<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; /* Defaulting to serif for formal look */
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic layout structure */
  .header-info { display: flex; justify-content: space-between; margin-bottom: 40px; }
  .logo-area { font-size: 24pt; font-weight: bold; }
  .contact-info { font-size: 10pt; line-height: 1.4; }
  .title-section { text-align: center; margin-bottom: 40px; }
  .title-section h1 { font-size: 18pt; font-weight: bold; }
  .form-section { margin-bottom: 30px; }
  .form-row { display: flex; margin-bottom: 15px; font-size: 11pt; }
  .form-row div { flex: 1; padding-right: 20px; }
  .form-row label { display: block; margin-bottom: 5px; font-weight: normal; }
  .form-row input[type="text"] { border-bottom: 1px solid #000; width: 100%; }
  .checkbox-group { margin-top: 10px; font-size: 11pt; }
  .checkbox-group label { font-weight: normal; display: inline-block; margin-right: 20px; }
  .divider { border-top: 1px solid #000; margin: 30px 0; }
  .footer-section { display: flex; justify-content: space-between; margin-top: 60px; font-size: 10pt; }
</style>

<div class="page">
  <div class="header-info">
    <div class="logo-area">The City College of New York</div>
    <div class="contact-info">
      Office of the Registrar<br>
      <span data-field="address.street">{{ address.street }}</span><br>
      <span data-field="address.city_state_zip">{{ address.city_state_zip }}</span><br>
      Tel: <span data-field="phone">{{ phone }}</span> / Fax: <span data-field="fax">{{ fax }}</span><br>
      Registrar@ccny.cuny.edu
    </div>
  </div>

  <div class="title-section">
    <h1>Change of Name/ID Number</h1>
  </div>

  <div class="form-section">
    <p>Please check the appropriate box(es):</p>
    <div class="checkbox-group">
      <label><input type="checkbox"> Change of Name</label>
      <label><input type="checkbox"> Change of ID Number</label>
    </div>
  </div>

  <div class="form-section">
    <div class="form-row">
      <div>
        <label>Last Name:</label>
        <input type="text">
      </div>
      <div>
        <label>First Name:</label>
        <input type="text">
      </div>
    </div>

    <div class="form-row">
      <div>
        <label>EmpID or Last 4 of SSN:</label>
        <input type="text">
      </div>
      <div>
        <label>Date of Birth:</label>
        <input type="text">
      </div>
    </div>

    <div class="form-row">
      <div>
        <label>Telephone:</label>
        <input type="text">
      </div>
      <div>
        <label>E-mail:</label>
        <input type="text">
      </div>
    </div>

    <div class="form-row">
      <div>
        <label>Address:</label>
        <input type="text">
      </div>
      <div>
        <label>City:</label>
        <input type="text">
      </div>
      <div>
        <label>State:</label>
        <input type="text">
      </div>
      <div>
        <label>Zip code:</label>
        <input type="text">
      </div>
    </div>
  </div>

  <div class="form-section">
    <p>INFORMATION TO BE CHANGED</p>
    <div class="form-row" style="margin-top: 10px;">
      <div style="flex: 1;">
        <label>New Name:</label>
        <input type="text">
      </div>
      <div style="flex: 1;">
        <label>New ID Number:</label>
        <input type="text">
      </div>
    </div>
  </div>

  <div class="form-section">
    <p>THESE DOCUMENTS ARE MANDATORY FOR ANY OF THE ABOVE CHANGES TO BE MADE:</p>
    <div class="checkbox-group">
      <label><input type="checkbox"> U.S. Social Security Card or Taxpayer ID Form</label>
      <label><input type="checkbox"> State ID or Driver's License</label>
    </div>
  </div>

  <div class="form-section">
    <p>SECONDARY DOCUMENTS (ONE OF THE FOLLOWING)</p>
    <div class="checkbox-group">
      <label><input type="checkbox"> Birth Certificate</label>
      <label><input type="checkbox"> Marriage Certificate</label>
      <label><input type="checkbox"> Permanent Resident Card</label>
      <br>
      <label><input type="checkbox"> Divorce Order</label>
      <label><input type="checkbox"> Naturalization Certificate</label>
      <label><input type="checkbox"> Current Valid Passport</label>
      <br>
      <label><input type="checkbox"> Court Order</label>
    </div>
  </div>

  <div class="divider"></div>

  <div class="form-section" style="margin-bottom: 0;">
    <p>FOR OFFICE USE ONLY</p>
    <div class="footer-section">
      <div>
        Received: <input type="text" style="border-bottom: 1px solid #000; width: 200px;">
      </div>
      <div>
        Processed: <input type="text" style="border-bottom: 1px solid #000; width: 200px;">
      </div>
      <div>
        Revised 11/18/2020
      </div>
    </div>
  </div>
</div>