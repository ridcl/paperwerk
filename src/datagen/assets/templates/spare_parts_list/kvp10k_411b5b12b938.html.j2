<!DOCTYPE html>
<html>
<head>
    <title>Spare Parts List</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 { font-weight: bold; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        td, th { padding: 8px; text-align: left; border-bottom: 1px solid #ddd; }
        .header-section { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        .logo { font-size: 24px; font-weight: bold; }
    </style>

<style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        td, th { padding: 8px 10px; text-align: left; border-bottom: 1px solid #ddd; }
        th { font-weight: bold; }
    </style>
</head>
<body>
    <div class="page">
        <div style="text-align: center; margin-bottom: 30px;">
            <p style="font-size: 12px; margin: 0;">Spare Parts List SPL/FV4000/FS4000-EN Rev. B</p>
            <h1 style="margin: 5px 0;">FV4000, FS4000</h1>
            <h2 style="margin: 5px 0;">Vortex Flowmeter / Swirl Flowmeter</h2>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div style="flex-grow: 1;">
                <h3 style="margin-top: 0;">Integral mount design VT4 / ST4 and remote mount design VR4 / SR4</h3>
            </div>
            <div style="margin-left: 40px;">
                <!-- Placeholder for images -->
                <div style="display: flex; flex-direction: column; gap: 15px;">
                    <div style="display: flex; gap: 20px;">
                        <img src="placeholder_image_1.png" alt="Diagram" style="width: 100px; height: auto;">
                        <img src="placeholder_image_2.png" alt="Diagram" style="width: 100px; height: auto;">
                        <img src="placeholder_image_3.png" alt="Diagram" style="width: 100px; height: auto;">
                    </div>
                    <div style="display: flex; gap: 20px;">
                        <img src="placeholder_image_4.png" alt="Diagram" style="width: 100px; height: auto;">
                        <img src="placeholder_image_5.png" alt="Diagram" style="width: 100px; height: auto;">
                    </div>
                    <div style="display: flex; gap: 20px;">
                        <img src="placeholder_image_6.png" alt="Diagram" style="width: 100px; height: auto;">
                        <img src="placeholder_image_7.png" alt="Diagram" style="width: 100px; height: auto;">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="page">
        <h2 style="border-bottom: 1px solid #000; padding-bottom: 5px;">Contents</h2>
        <table style="width: 100%;">
            <tr>
                <td style="width: 10%;"><span data-field="contents[0].number">{{ contents[0].number }}</span></td>
                <td style="width: 70%;"><span data-field="contents[0].title">{{ contents[0].title }}</span></td>
                <td style="width: 20%; text-align: right;">... <span data-field="contents[0].page_number">{{ contents[0].page_number }}</span></td>
            </tr>
            <tr>
                <td style="width: 10%;"><span data-field="contents[1].number">{{ contents[1].number }}</span></td>
                <td style="width: 70%;"><span data-field="contents[1].title">{{ contents[1].title }}</span></td>
                <td style="width: 20%; text-align: right;">... <span data-field="contents[1].page_number">{{ contents[1].page_number }}</span></td>
            </tr>
            <tr>
                <td style="width: 10%;"><span data-field="contents[2].number">{{ contents[2].number }}</span></td>
                <td style="width: 70%;"><span data-field="contents[2].title">{{ contents[2].title }}</span></td>
                <td style="width: 20%; text-align: right;">... <span data-field="contents[2].page_number">{{ contents[2].page_number }}</span></td>
            </tr>
            <tr>
                <td style="width: 10%;"><span data-field="contents[3].number">{{ contents[3].number }}</span></td>
                <td style="width: 70%;"><span data-field="contents[3].title">{{ contents[3].title }}</span></td>
                <td style="width: 20%; text-align: right;">... <span data-field="contents[3].page_number">{{ contents[3].page_number }}</span></td>
            </tr>
            <tr>
                <td style="width: 10%;"><span data-field="contents[4].number">{{ contents[4].number }}</span></td>
                <td style="width: 70%;"><span data-field="contents[4].title">{{ contents[4].title }}</span></td>
                <td style="width: 20%; text-align: right;">... <span data-field="contents[4].page_number">{{ contents[4].page_number }}</span></td>
            </tr>
            <tr>
                <td style="width: 10%;"><span data-field="contents[5].number">{{ contents[5].number }}</span></td>
                <td style="width: 70%;"><span data-field="contents[5].title">{{ contents[5].title }}</span></td>
                <td style="width: 20%; text-align: right;">... <span data-field="contents[5].page_number">{{ contents[5].page_number }}</span></td>
            </tr>
            <tr>
                <td style="width: 10%;"><span data-field="contents[6].number">{{ contents[6].number }}</span></td>
                <td style="width: 70%;"><span data-field="contents[6].title">{{ contents[6].title }}</span></td>
                <td style="width: 20%; text-align: right;">... <span data-field="contents[6].page_number">{{ contents[6].page_number }}</span></td>
            </tr>
        </table>
        <div style="margin-top: 50px; text-align: center; font-size: 10px;">
            <p>2 SPL/FV4000/FS4000-EN Rev. B | FV4000, FS4000</p>
        </div>
    </div>

    <div class="page">
        <h2 style="border-bottom: 1px solid #000; padding-bottom: 5px;">1 Name plate specifications for spare parts orders</h2>
        <p>The flowmeter version can be identified by referring to the name plate that is attached to the housing.</p>
        <p>When placing spare parts orders, always remember to state the order number as shown on the name plate.</p>

        <div style="display: flex; align-items: center; margin-top: 30px;">
            <img src="placeholder_diagram_nameplate.png" alt="Name Plate Diagram" style="width: 200px; height: auto; margin-right: 30px;">
            <div style="flex-grow: 1;">
                <p>Fig. 1: Name plate</p>
                <p>1 Order number</p>
            </div>
        </div>
    </div>

    <div class="page">
        <h2 style="border-bottom: 1px solid #000; padding-bottom: 5px;">2 Overview</h2>
        <div style="display: flex; justify-content: space-around; align-items: center; margin-top: 30px;">
            <!-- Diagram 2 -->
            <div style="display: flex; flex-direction: column; align-items: center;">
                <img src="placeholder_diagram_overview_left.png" alt="Overview Diagram" style="width: 150px; height: auto;">
                <p style="margin-top: 10px;">Fig. 2: Overview</p>
                <p>1 Flowmeter VT / ST | 2 Sensorboard | 3 Connection board VT | 4 Connection board VR | 5 Slide-in conv. | 6 Boards | 7 Flowmeter VR / SR</p>
            </div>

            <!-- Diagram 2 Right -->
            <div style="display: flex; flex-direction: column; align-items: center;">
                <img src="placeholder_diagram_overview_right.png" alt="Overview Diagram" style="width: 150px; height: auto;">
                <p style="margin-top: 10px;">G10286</p>
            </div>
        </div>
    </div>

    <div class="page">
        <h2 style="border-bottom: 1px solid #000; padding-bottom: 5px;">3 Overview</h2>
        <div style="display: flex; justify-content: space-around; align-items: center; margin-top: 30px;">
            <!-- Diagram 3 -->
            <div style="display: flex; flex-direction: column; align-items: center;">
                <img src="placeholder_diagram_overview_bottom_left.png" alt="Overview Diagram" style="width: 150px; height: auto;">
                <p style="margin-top: 10px;">Fig. 3: Overview</p>
                <p>1 Base complete | 2 Converter bracket | 3 Adapter for sensor | 4 Sensor | 5 Base</p>
            </div>

            <!-- Diagram 3 Right -->
            <div style="display: flex; flex-direction: column; align-items: center;">
                <img src="placeholder_diagram_overview_bottom_right.png" alt="Overview Diagram" style="width: 150px; height: auto;">
                <p style="margin-top: 10px;">G10287</p>
            </div>
        </div>
        <div style="margin-top: 40px; text-align: center;">
            <p style="font-weight: bold;">IMPORTANT (NOTE)</p>
            <p>All prices on inquiry!</p>
        </div>
    </div>

    <div class="page">
        <h2 style="border-bottom: 1px solid #000; padding-bottom: 5px;">2.1 Flowmeter V_4 / S_4</h2>
        <div style="display: flex; justify-content: space-around; align-items: center; margin-top: 30px;">
            <!-- Diagram 4 -->
            <div style="display: flex; flex-direction: column; align-items: center;">
                <img src="placeholder_diagram_flowmeter_v4.png" alt="Flowmeter V4 Diagram" style="width: 150px; height: auto;">
                <p style="margin-top: 10px;">Fig. 4</p>
            </div>
            <!-- Placeholder for other elements if any -->
        </div>

        <h3 style="margin-top: 40px;">Table: Flowmeter V_4 / S_4 Parts</h3>
        <table>
            <thead>
                <tr>
                    <th>Position</th>
                    <th>Name of part</th>
                    <th>Variant</th>
                    <th>Order number</th>
                    <th>Weight kg (lb)</th>
                    <th>Price (€)</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>1-3</td>
                    <td>Set includes position 1 ... 3</td>
                    <td>Standard</td>
                    <td><span data-field="parts_v4_s4[0].order_number">{{ parts_v4_s4[0].order_number }}</span></td>
                    <td>-</td>
                    <td>-</td>
                </tr>
                <tr>
                    <td>1-3</td>
                    <td>Set includes position 1 ... 3</td>
                    <td>Ex</td>
                    <td><span data-field="parts_v4_s4[1].order_number">{{ parts_v4_s4[1].order_number }}</span></td>
                    <td>-</td>
                    <td>-</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="page">
        <h2 style="border-bottom: 1px solid #000; padding-bottom: 5px;">2.2 Housing</h2>
        <div style="display: flex; justify-content: center; align-items: center; margin-top: 30px;">
            <img src="placeholder_diagram_housing.png" alt="Housing Diagram" style="width: 300px; height: auto;">
        </div>

        <h3 style="margin-top: 40px;">Table: Housing Parts</h3>
        <table>
            <thead>
                <tr>
                    <th>Position</th>
                    <th>Name of part</th>
                    <th>Variant</th>
                    <th>Order number</th>
                    <th>Weight kg (lb)</th>
                    <th>Price (€)</th>
                </tr>
            </thead>
            <tbody>
                {% for item in housing_parts %}
                <tr>
                    <td>{{ loop.index }}</td>
                    <td><span data-field="housing_parts[{{ loop.index0 }}].name_of_part">{{ housing_parts[loop.index0].name_of_part }}</span></td>
                    <td><span data-field="housing_parts[{{ loop.index0 }}].variant">{{ housing_parts[loop.index0].variant }}</span></td>
                    <td><span data-field="housing_parts[{{ loop.index0 }}].order_number">{{ housing_parts[loop.index0].order_number }}</span></td>
                    <td><span data-field="housing_parts[{{ loop.index0 }}].weight">{{ housing_parts[loop.index0].weight }}</span></td>
                    <td><span data-field="housing_parts[{{ loop.index0 }}].price">{{ housing_parts[loop.index0].price }}</span></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="page">
        <h2 style="border-bottom: 1px solid #000; padding-bottom: 5px;">2.3 Slide-in converter</h2>
        <div style="display: flex; justify-content: space-around; align-items: center; margin-top: 30px;">
            <!-- Diagram 6 -->
            <div style="display: flex; flex-direction: column; align-items: center;">
                <img src="placeholder_diagram_converter.png" alt="Converter Diagram" style="width: 250px; height: auto;">
                <p style="margin-top: 10px;">Fig. 6</p>
            </div>
            <!-- Placeholder for other elements if any -->
        </div>

        <h3 style="margin-top: 40px;">Table: Slide-in Converter Parts</h3>
        <table>
            <thead>
                <tr>
                    <th>Position</th>
                    <th>Name of part</th>
                    <th>Variant</th>
                    <th>Order number</th>
                    <th>Weight kg (lb)</th>
                    <th>Price (€)</th>
                </tr>
            </thead>
            <tbody>
                {% for item in converter_parts %}
                <tr>
                    <td>{{ loop.index }}</td>
                    <td><span data-field="converter_parts[{{ loop.index0 }}].name_of_part">{{ converter_parts[loop.index0].name_of_part }}</span></td>
                    <td><span data-field="converter_parts[{{ loop.index0 }}].variant">{{ converter_parts[loop.index0].variant }}</span></td>
                    <td><span data-field="converter_parts[{{ loop.index0 }}].order_number">{{ converter_parts[loop.index0].order_number }}</span></td>
                    <td><span data-field="converter_parts[{{ loop.index0 }}].weight">{{ converter_parts[loop.index0].weight }}</span></td>
                    <td><span data-field="converter_parts[{{ loop.index0 }}].price">{{ converter_parts[loop.index0].price }}</span></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        <div style="margin-top: 30px; text-align: center;">
            <p style="font-weight: bold;">IMPORTANT (NOTE)</p>
            <p>Ex approval (ATEX) has changed.</p>
            <p>With Ex, the plug-in modules are only supplied with a re-specification and a new housing.</p>
        </div>
    </div>



<div class="page">
    <h1 style="font-size: 18pt; margin-bottom: 20px;">2.4 Base complete</h1>
    
    <!-- Figure 7 -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px;">
        <div style="flex: 1; text-align: center;">
            <img src="placeholder_figure_7_image.png" alt="Figure 7" style="max-width: 45%; height: auto;">
            <p style="font-size: 10pt; margin-top: 10px;">Fig. 7</p>
        </div>
        <div style="flex: 1; text-align: right;">
            <p style="font-size: 10pt;">G10292-01</p>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th style="width: 10%;">Position</th>
                <th style="width: 35%;">Name of part</th>
                <th style="width: 15%;">Variant</th>
                <th style="width: 20%;">Order number</th>
                <th style="width: 10%;">Weight kg (lb)</th>
                <th style="width: 10%;">Price (€)</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>1</td>
                <td><span data-field="part_name_1">{{ part_name_1 }}</span></td>
                <td><span data-field="part_variant_1">{{ part_variant_1 }}</span></td>
                <td><span data-field="part_order_number_1">{{ part_order_number_1 }}</span></td>
                <td>-</td>
                <td>-</td>
            </tr>
            {% for item in part_list_7 %}
            <tr>
                <td>{{ loop.index }}</td>
                <td><span data-field="part_name_{{ loop.index }}">{{ item.name }}</span></td>
                <td><span data-field="part_variant_{{ loop.index }}">{{ item.variant }}</span></td>
                <td><span data-field="part_order_number_{{ loop.index }}">{{ item.order_number }}</span></td>
                <td>{{ item.weight }}</td>
                <td>{{ item.price }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<div class="page">
    <h1 style="font-size: 18pt; margin-bottom: 20px;">2.5 Converter bracket</h1>

    <!-- Figure 8 -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px;">
        <div style="flex: 1; text-align: center;">
            <img src="placeholder_figure_8_image.png" alt="Figure 8" style="max-width: 45%; height: auto;">
            <p style="font-size: 10pt; margin-top: 10px;">Fig. 8</p>
        </div>
        <div style="flex: 1; text-align: right;">
            <p style="font-size: 10pt;">G10293</p>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th style="width: 10%;">Position</th>
                <th style="width: 35%;">Name of part</th>
                <th style="width: 15%;">Variant</th>
                <th style="width: 20%;">Order number</th>
                <th style="width: 10%;">Weight kg (lb)</th>
                <th style="width: 10%;">Price (€)</th>
            </tr>
        </thead>
        <tbody>
            {% for item in part_list_8 %}
            <tr>
                <td>{{ loop.index }}</td>
                <td><span data-field="part_name_{{ loop.index }}">{{ item.name }}</span></td>
                <td><span data-field="part_variant_{{ loop.index }}">{{ item.variant }}</span></td>
                <td><span data-field="part_order_number_{{ loop.index }}">{{ item.order_number }}</span></td>
                <td>{{ item.weight }}</td>
                <td>{{ item.price }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<div class="page">
    <h2 style="font-size: 14pt; margin-bottom: 15px;">Notes</h2>
    <div style="padding: 20px; border: 1px solid #ccc; font-size: 10pt;">
        <p>Note:</p>
        <p>We reserve the right to make technical changes and changes affecting content to this document at any time without prior notice.</p>
        <p>Orders are subject to the agreed detailed terms and conditions. ABB cannot be held responsible for any errors or omissions in this document.</p>
        <p>We reserve all rights to this document and its content. This document must not be copied, shared with third parties, or its content reproduced in any way without the prior written permission of ABB.</p>
        <p>Copyright© 2013 ABB</p>
        <p>All rights reserved</p>
    </div>
</div>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-top: 50px;">
        <div style="flex-grow: 1;">
            <h2 style="font-size: 16pt; margin-bottom: 10px;">Contact us</h2>
            <p style="font-size: 10pt;">To find your local ABB branch, go to:</p>
            <p style="font-size: 10pt;"><span data-field="contact_url">{{ contact_url }}</span></p>
            <p style="font-size: 10pt;">Additional product information is available at:</p>
            <p style="font-size: 10pt;"><span data-field="info_url">{{ info_url }}</span></p>
        </div>
        <div style="width: 30%;">
            <div style="font-size: 10pt;">
                <p>ABB Automation GmbH</p>
                <p><span data-field="address_street">{{ address_street }}</span></p>
                <p><span data-field="address_zip_city">{{ address_zip_city }}</span></p>
                <p><span data-field="address_country">{{ address_country }}</span></p>
            </div>
        </div>
    </div>
    <div style="margin-top: 80px; display: flex; justify-content: space-between; align-items: center;">
        <div style="font-size: 10pt;">
            <p><span data-field="document_id">{{ document_id }}</span></p>
        </div>
        <div style="text-align: right;">
            <p style="font-size: 12pt;">Power and productivity</p>
            <p style="font-size: 10pt;">for a better world™</p>
            <img src="placeholder_abb_logo.png" alt="ABB Logo" style="height: 30px;">
        </div>
    </div>
</div>

</body>
</html>