<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; }
  h1, h2 { text-align: center; font-weight: bold; }
  .form-section { margin-bottom: 20px; }
  .line-item-table { width: 100%; border-collapse: collapse; margin-top: 10px; }
  .line-item-table th, .line-item-table td { border: 1px solid #ccc; padding: 8px; text-align: left; }
  .line-item-table th { background-color: #f0f0f0; }
</style>

<div class="page">
  <div style="text-align: center;">
    <h1 style="font-size: 18pt;">BARNARD COLLEGE</h1>
    <h2 style="font-size: 14pt;">PETTY CASH REPLENISHMENT or</h2>
    <h2 style="font-size: 14pt;">CLOSE REQUEST</h2>
  </div>

  <div class="form-section">
    <p>Payee/Custodian</p>
    <div style="border-bottom: 1px solid black; width: 50%;" data-field="payee_custodian">{{ payee_custodian }}</div>
  </div>

  <div class="form-section">
    <p>Department name</p>
    <div style="border-bottom: 1px solid black; width: 50%;" data-field="department_name">{{ department_name }}</div>
  </div>

  <div class="form-section">
    <p>Check here if requesting replenishment of your petty cash advance. Please check <span data-field="check_one">{{ check_one }}</span> only (for replenishment check):</p>
    <div style="margin-top: 10px;">
      <label style="display: block;">
        <input type="checkbox"> Hold at Office of the Bursar (<span data-field="bursar_location">{{ bursar_location }}</span>)
      </label>
      <label style="display: block;">
        <input type="checkbox"> Return to department
      </label>
    </div>
  </div>

  <div class="form-section">
    <p>Check here if closing your petty cash advance. Please complete this form and return all receipts via interoffice mail to the Finance Office (<span data-field="finance_office_location">{{ finance_office_location }}</span>) or via email to <span data-field="email_address">{{ email_address }}</span>. Please contact Victoria to turn in the unspent cash.</p>
  </div>

  <div class="form-section">
    <table class="line-item-table" style="width: 50%; float: left;">
      <tr>
        <td style="width: 50%;">Petty cash advance</td>
        <td style="text-align: right;"><span data-field="advance_amount">{{ advance_amount }}</span></td>
      </tr>
      <tr>
        <td>Less cash on hand as of</td>
        <td style="text-align: right;">(date)</td>
      </tr>
      <tr>
        <td>Expenses</td>
        <td style="text-align: right;"><span data-field="expenses_total">{{ expenses_total }}</span></td>
      </tr>
    </table>
    <table class="line-item-table" style="width: 45%; float: right;">
      <tr>
        <td style="text-align: right;">(A)</td>
        <td style="text-align: right;"><span data-field="amount_a">{{ amount_a }}</span></td>
      </tr>
    </table>
    <div style="clear: both;"></div>
  </div>

  <div style="text-align: center; margin-top: 30px;">
    <p style="font-weight: bold;">PLEASE ATTACH ORIGINAL RECEIPTS FOR EACH EXPENSE</p>
  </div>

  <div class="form-section">
    <p>Expenses to be charged as follows:</p>
    <table class="line-item-table">
      <thead>
        <tr>
          <th style="width: 10%;">FUND</th>
          <th style="width: 40%;">FUNCTION-UNIT-PROGRAM</th>
          <th style="width: 30%;">OBJECT CODE</th>
          <th style="width: 20%;">AMOUNT</th>
        </tr>
      </thead>
      <tbody>
        {% for item in line_items %}
        <tr>
          <td><span data-field="line_items[{{ loop.index0 }}].fund_code">{{ line_items[loop.index0].fund_code }}</span></td>
          <td><span data-field="line_items[{{ loop.index0 }}].function_unit_program">{{ line_items[loop.index0].function_unit_program }}</span></td>
          <td><span data-field="line_items[{{ loop.index0 }}].object_code">{{ line_items[loop.index0].object_code }}</span></td>
          <td style="text-align: right;"><span data-field="line_items[{{ loop.index0 }}].amount">{{ line_items[loop.index0].amount }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
      <tfoot>
        <tr>
          <td colspan="3" style="text-align: right; font-weight: bold;">Total expenses:</td>
          <td style="text-align: right; font-weight: bold;"><span data-field="total_expenses">{{ total_expenses }}</span></td>
        </tr>
      </tfoot>
    </table>
  </div>

  <div class="form-section" style="display: flex; justify-content: space-between; margin-top: 50px;">
    <div>
      <p>Approved by (sign)</p>
      <div style="border-bottom: 1px solid black; width: 30%;" data-field="approved_by">{{ approved_by }}</div>
      <p style="font-size: 10pt;">(employee authorized to approve expenditures)</p>
    </div>
    <div>
      <p>Date</p>
      <div style="border-bottom: 1px solid black; width: 30%;" data-field="date">{{ date }}</div>
    </div>
  </div>

  <div class="form-section" style="margin-top: 50px;">
    <p>Finance Office approval</p>
    <div style="border-bottom: 1px solid black; width: 30%;" data-field="finance_office_approval">{{ finance_office_approval }}</div>
    <p>Date</p>
    <div style="border-bottom: 1px solid black; width: 30%;" data-field="date_2">{{ date_2 }}</div>
  </div>

  <div class="form-section" style="margin-top: 50px;">
    <table class="line-item-table" style="width: 50%;">
      <tr>
        <td style="width: 50%;">Voucher No.</td>
        <td style="text-align: right;"><span data-field="voucher_no">{{ voucher_no }}</span></td>
      </tr>
      <tr>
        <td>A.R. No.</td>
        <td style="text-align: right;"><span data-field="ar_no">{{ ar_no }}</span></td>
      </tr>
    </table>
  </div>

  <div style="text-align: right; margin-top: 50px; font-size: 10pt;">
    PC-Request.<span data-field="date_generated">{{ date_generated }}</span>
  </div>
</div>