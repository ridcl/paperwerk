<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  h1, h2, h3 {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial;
  }
  .header-box {
    background-color: #f0f0f0;
    padding: 15px;
    text-align: center;
    margin-bottom: 20px;
  }
  .team-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: center;
    margin-top: 30px;
  }
  .team-member {
    text-align: center;
  }
  .team-member img {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 10px;
  }
  .section-title {
    text-align: center;
    margin-bottom: 30px;
    font-size: 24pt;
    font-weight: bold;
  }
  .process-container {
    display: flex;
    justify-content: space-between;
    margin-top: 40px;
  }
  .process-step {
    flex: 1;
    text-align: center;
    padding: 20px;
    border-radius: 10px;
    margin: 0 10px;
    box-shadow: 2px 2px 5px rgba(0,0,0,0.1);
  }
  .process-step h3 {
    margin-top: 0;
    font-size: 14pt;
  }
  .skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    margin-top: 20px;
  }
  .skills-item {
    padding: 8px 15px;
    border: 1px solid #ccc;
    border-radius: 5px;
    background-color: #f9f9f9;
  }
  .table-container {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
  }
  .table-container th, .table-container td {
    border: 1px solid #ddd;
    padding: 12px;
    text-align: left;
  }
  .table-container th {
    background-color: #f2f2f2;
    font-weight: bold;
  }
  .job-profile-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
    margin-top: 30px;
  }
  .job-category {
    border: 1px solid #ccc;
    padding: 20px;
    border-radius: 8px;
  }
  .recruiter-logos {
    display: flex;
    justify-content: space-around;
    align-items: center;
    margin-top: 30px;
  }
  .logo-group {
    display: flex;
    gap: 30px;
    align-items: center;
  }
  .feedback-section {
    margin-top: 50px;
    text-align: center;
  }
  .feedback-quote {
    border-left: 4px solid #0056b3;
    padding-left: 20px;
    margin: 20px 0;
    text-align: left;
  }
</style>

<div class="page">
  <h1 class="section-title">Our Team</h1>
  <div class="header-box">
    <p>Chairman Corporate Relations - Prof. <span data-field="chairman_name">{{ chairman_name }}</span></p>
    <p>Placement Executives</p>
  </div>

  <div class="section-title">Student Placecom Team - Selected via a rigorous interview process</div>
  <div class="team-grid">
    {% for i in range(12) %}
    <div class="team-member">
      <img src="placeholder.png" alt="Team Member {{ loop.index }}">
      <p><span data-field="team_member_name_{{ loop.index0 }}">{{ team_member_name_{{ loop.index0 }} }}</span></p>
    </div>
    {% endfor %}
  </div>

  <p style="margin-top: 40px;">Provided training to work with corporate recruitment teams leading to honing of their people skills</p>
</div>

<div class="page">
  <h1 class="section-title">Industry exposure through Inplant Training</h1>
  <div class="process-container">
    <div class="process-step" style="background-color: #f8d7da;">
      <h3>Effective hands on and real time exposure of industry processes to engineering students</h3>
    </div>
    <div class="process-step" style="background-color: #fff3cd;">
      <h3>Transformation of theoretical knowledge into practical solutions to real life challenges</h3>
    </div>
    <div class="process-step" style="background-color: #d1ecf1;">
      <h3>Builds behaviour aspects that develops a students leadership qualities</h3>
    </div>
    <div class="process-step" style="background-color: #d4edda;">
      <h3>Develops professional aptitude along with hands on skills and implementation knowledge of latest tools and technology required in industry</h3>
    </div>
  </div>
</div>

<div class="page">
  <h1 class="section-title">Preparation for Entry into the Corporate Sector</h1>

  <div style="margin-bottom: 30px;">
    <h3 style="font-family: 'DejaVu Sans', 'Liberation Sans', Arial;">Aptitude Training</h3>
    <div class="skills-list">
      {% for skill in ['Quantitative Reasoning', 'Data Interpretation', 'Verbal Reasoning', 'Reading', 'Comprehension', 'Analytical Reasoning'] %}
        <span class="skills-item">{{ skill }}</span>
      {% endfor %}
    </div>
  </div>

  <div style="margin-bottom: 30px;">
    <h3 style="font-family: 'DejaVu Sans', 'Liberation Sans', Arial;">Technical Training</h3>
    <ul style="list-style-type: disc; padding-left: 20px;">
      <li>
        <span data-field="technical_training_item_1">{{ technical_training_item_1 }}</span>
      </li>
      <li>
        <span data-field="technical_training_item_2">{{ technical_training_item_2 }}</span>
      </li>
    </ul>
  </div>

  <div>
    <h3 style="font-family: 'DejaVu Sans', 'Liberation Sans', Arial;">Employability Training</h3>
    <div class="skills-list">
      {% for skill in ['Effective Resume Building', 'Understanding Corporate Environment and Etiquettes', 'Interview Skills', 'Group Discussions', 'Presentation Skills'] %}
        <span class="skills-item">{{ skill }}</span>
      {% endfor %}
    </div>
  </div>
</div>

<div class="page">
  <h1 class="section-title">Inplant Training Process</h1>
  <div style="display: flex; flex-direction: column; gap: 15px; margin-top: 30px;">
    <div style="display: flex; align-items: center; border-bottom: 2px solid #ccc; padding-bottom: 10px;">
      <div style="width: 50px; height: 50px; background-color: #dc3545; color: white; display: flex; align-items: center; justify-content: center; font-weight: bold; border-radius: 5px;">01</div>
      <div style="flex-grow: 1; padding-left: 20px;">
        <strong style="font-size: 12pt;">Pre Hiring Preparation</strong>
        <div style="font-size: 10pt;">• Grooming and Employability Training</div>
      </div>
    </div>
    <div style="display: flex; align-items: center; border-bottom: 2px solid #ccc; padding-bottom: 10px;">
