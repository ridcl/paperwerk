      </tr>
    </thead>
    <tbody>
      <tr>
        <td style="padding: 10px; border: 1px solid #ccc;">Teachers' Mean ACT Composite Score</td>
        <td style="padding: 10px; border: 1px solid #ccc; text-align: right;"><span data-field="itac_weight_1">{{ itac_weight_1 }}</span></td>
