        <td style="padding: 10px; border: 1px solid #ccc; text-align: right;"><span data-field="itac_weight_3">{{ itac_weight_3 }}</span></td>
      </tr>
      <tr>
        <td style="padding: 10px; border: 1px solid #ccc;">% of Teachers with Emergency or Provisional Certification</td>
        <td style="padding: 10px; border: 1px solid #ccc; text-align: right;"><span data-field="itac_weight_4">{{ itac_weight_4 }}</span></td>
