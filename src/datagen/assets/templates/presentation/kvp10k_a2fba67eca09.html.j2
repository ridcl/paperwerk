    </tr>
    <tr>
      <td style="padding: 10px 0;">Electives</td>
      <td style="padding: 10px 0;">(9)</td>
    </tr>
    <tr>
      <td style="padding: 10px 0;">Experiential Learning</td>
      <td style="padding: 10px 0;">(12)</td>
    </tr>
    <tr>
      <td style="padding: 10px 0;">Research Foundation Dissertation</td>
      <td style="padding: 10px 0;">(12–15) (20)</td>
    </tr>
    <tr>
      <td style="padding: 10px 0; font-weight: bold;">Total:</td>
      <td style="padding: 10px 0; font-weight: bold;">83 credits required</td>
    </tr>
  </table>
</div>

