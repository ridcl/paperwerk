<!DOCTYPE html>
<html>
<head>
    <title>Synthetic Document</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
        }
        .page:last-child { page-break-after: auto; }
        body {
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
            margin: 0;
            padding: 0;
        }
        h1, h2, h3 {
            font-weight: bold;
        }
        .sidebar {
            position: absolute;
            right: 0;
            top: 0;
            bottom: 0;
            width: 50px; /* Approximation based on visual */
            background-color: #f0f0f0; /* Placeholder for visual element */
        }
        .content {
            margin-right: 70px; /* Space for sidebar */
        }
        .section-title {
            font-size: 24pt;
            margin-bottom: 15px;
        }
        .subsection-title {
            font-size: 18pt;
            margin-top: 30px;
            margin-bottom: 15px;
        }
        .list-item {
            margin-bottom: 8px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }
        th, td {
            padding: 8px;
            text-align: left;
            border-bottom: 1px solid #ccc;
        }
        th {
            font-weight: bold;
        }
    </style>

<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
