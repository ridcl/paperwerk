<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { margin-top: 0; }
  .header-banner {
    display: flex;
    align-items: center;
    margin-bottom: 20px;
  }
  .logo {
    /* Placeholder for logo styling */
    width: 50px;
    height: 50px;
    margin-right: 20px;
  }
  .title-area {
    flex-grow: 1;
  }
  .main-title {
    font-size: 36pt;
    font-weight: bold;
    text-align: center;
    margin: 20px 0;
  }
  .subtitle {
    font-size: 18pt;
    text-align: center;
    margin-bottom: 40px;
  }
  .content-section {
    margin-bottom: 40px;
  }
  ul {
    list-style-type: disc;
    padding-left: 40px;
  }
  li {
    margin-bottom: 10px;
    font-size: 12pt;
  }
  .outline-list {
    list-style-type: none;
    padding-left: 0;
  }
  .outline-list li {
    margin-bottom: 15px;
    font-size: 14pt;
  }
  .outline-list ul {
    padding-left: 20px;
    margin-top: 5px;
  }
  .graph-container {
    width: 100%;
    height: 350px;
    border: 1px solid #ccc;
    padding: 20px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .figure-caption {
    text-align: center;
    font-size: 10pt;
    margin-top: 10px;
  }
</style>

<div class="page">
  <div class="header-banner">
    <div class="logo"></div>
    <div class="title-area">
      <h1 style="font-size: 24pt; font-weight: bold;">Wisconsin Alliance for Minority Participation</h1>
      <h2 style="font-size: 24pt; font-weight: bold;">(WiscAMP)</h2>
    </div>
  </div>
  <div class="content-section">
    <h2 style="font-size: 20pt; font-weight: bold;">University of Wisconsin System</h2>
    <h3 style="font-size: 18pt; font-weight: bold;">Women & Science Opening Workshop</h3>
    <p style="text-align: right; font-size: 12pt;">{{ date }}</p>
  </div>
</div>

<div class="page">
  <div class="header-banner">
    <div class="logo"></div>
    <div class="title-area">
      <h1 style="font-size: 36pt; font-weight: bold;">Outline</h1>
    </div>
  </div>
  <div class="content-section">
    <ul class="outline-list">
      <li>Overview of WiscAMP</li>
      <li>Small Grants Program
        <ul>
          <li>Funding Opportunities</li>
          <li>Examples for Proposals</li>
        </ul>
      </li>
      <li>WiscAMP Academic Enrichment Program</li>
    </ul>
  </div>
</div>

<div class="page">
  <div class="header-banner">
    <div class="logo"></div>
    <div class="title-area">
      <h1 style="font-size: 36pt; font-weight: bold;">WiscAMP</h1>
    </div>
  </div>
  <div class="content-section">
    <p style="font-size: 14pt; font-weight: bold;">The Wisconsin Alliance for Minority Participation or WiscAMP is</p>
    <ul>
      <li>a consortium of <span data-field="number_of_colleges">{{ number_of_colleges }}</span> colleges and universities throughout Wisconsin</li>
      <li>funded by the National Science Foundation</li>
      <li>as part of the Louis Stokes Alliance for Minority Participation (LSAMP)</li>
      <li>there are <span data-field="number_of_lsamp_alliances">{{ number_of_lsamp_alliances }}</span> LSAMP alliances across the Nation</li>
    </ul>
  </div>
</div>

<div class="page">
  <div class="header-banner">
    <div class="logo"></div>
    <div class="title-area">
      <h1 style="font-size: 36pt; font-weight: bold;">WiscAMP Alliance – <span data-field="number_of_institutions">{{ number_of_institutions }}</span> Institutions</h1>
    </div>
  </div>
  <div class="content-section">
    <ul>
      <li><span data-field="uw_system_campuses">{{ uw_system_campuses }}</span> UW System Campuses</li>
      <li><span data-field="uw_campuses_type">{{ uw_campuses_type }}</span>, 4-year UW-Campuses</li>
      <li>UW-Colleges, <span data-field="uw_colleges_count">{{ uw_colleges_count }}</span>, 2-year campuses</li>
      <li><span data-field="private_colleges_count">{{ private_colleges_count }}</span> Private Colleges/Universities</li>
      <li><span data-field="private_college_examples">{{ private_college_examples }}</span></li>
      <li><span data-field="technical_colleges_count">{{ technical_colleges_count }}</span> Technical Colleges
        <ul>
          <li><span data-field="technical_college_examples">{{ technical_college_examples }}</span></li>
        </ul>
      </li>
      <li><span data-field="tribal_colleges_count">{{ tribal_colleges_count }}</span> Tribal College
        <ul>
          <li><span data-field="tribal_college_example">{{ tribal_college_example }}</span></li>
        </ul>
      </li>
    </ul>
  </div>
</div>

<div class="page">
  <div class="header-banner">
    <div class="logo"></div>
    <div class="title-area">
      <h1 style="font-size: 36pt; font-weight: bold;">NSF Goals</h1>
    </div>
  </div>
  <div class="content-section">
    <ul>
      <li>Double the number of baccalaureate awarded to underrepresented minority students in STEM disciplines within <span data-field="timeframe">{{ timeframe }}</span></li>
      <li>Forge a new academic alliance across institutions of higher education in the state of Wisconsin</li>
    </ul>
  </div>
</div>

