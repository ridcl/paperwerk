<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  h1, h2, h3 {
    font-weight: bold;
  }
  .header-box {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px 0;
    border: 2px solid #333;
    margin-bottom: 30px;
  }
  .header-text {
    font-size: 36px;
    font-weight: bold;
    text-align: center;
  }
  .footer-date {
    text-align: center;
    font-size: 18px;
    margin-top: 20px;
  }
  .section-title {
    font-size: 24px;
    font-weight: bold;
    text-align: center;
    margin-bottom: 30px;
  }
  .content-grid {
    display: flex;
    justify-content: space-between;
    gap: 40px;
  }
  .left-column, .right-column {
    flex: 1;
  }
  .info-box {
    border: 1px solid #ccc;
    padding: 20px;
    text-align: center;
    margin-bottom: 20px;
    background-color: #f9f9f9;
  }
  .info-box h3 {
    font-size: 20px;
  }
  .list-item {
    margin-bottom: 10px;
    line-height: 1.5;
  }
  .list-item ul {
    list-style-type: disc;
    margin-left: 20px;
    padding-left: 0;
  }
  .list-item li {
    margin-bottom: 5px;
  }
  .data-point {
    display: flex;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom: 1px dotted #ccc;
  }
  .data-point span:first-child {
    font-weight: bold;
  }
  .table-container {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
  }
  .table-container th, .table-container td {
    border: 1px solid #ddd;
    padding: 10px;
    text-align: left;
  }
  .table-container th {
    background-color: #eee;
    font-weight: bold;
  }
  .fines-table td:nth-child(1) {
    font-weight: bold;
  }
</style>

<div class="page">
