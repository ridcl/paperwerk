          <strong>Invoice Number:</strong> {{ invoice_details.invoice_number }}
        </div>
        <div>
          <strong>Invoice Date:</strong> {{ invoice_details.invoice_date }}
        </div>
      </div>
      <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
        <div>
          <strong>Order Number:</strong> {{ invoice_details.order_number }}
        </div>
        <div>
          <strong>Order Date:</strong> {{ invoice_details.order_date }}
        </div>
      </div>
      <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
        <div>
          <strong>Ship Via:</strong> {{ invoice_details.ship_via }}
        </div>
        <div>
          <strong>Page:</strong> Page 1 of 1
        </div>
      </div>

      <table style="margin-top: 20px;">
        <thead>
          <tr>
            <th>Date</th>
            <th>Item</th>
            <th>Unit</th>
            <th>Old/Shipped</th>
            <th>B/O</th>
            <th>Price (USD)</th>
            <th>Discount</th>
            <th>Amount</th>
          </tr>
        </thead>
        <tbody>
          {% for item in invoice_line_items %}
          <tr>
            <td>{{ item.date }}</td>
            <td>{{ item.description }}</td>
            <td>{{ item.unit }}</td>
            <td>{{ item.old_shipped }}</td>
            <td>{{ item.b_o }}</td>
            <td>{{ item.price }}</td>
            <td>{{ item.discount }}</td>
            <td>{{ item.amount }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>

      <div style="margin-top: 30px;">
        <p><strong>Terms of Sale:</strong> CREDIT CARD</p>
        <p><strong>Shipment Tracking No:</strong> {{ invoice_details.tracking_number }}</p>
        <p>Deposit paid by: {{ invoice_details.deposit_paid_by }}</p>
      </div>

      <div style="margin-top: 30px;">
        <table style="width: 50%; float: right;">
          <tr>
            <td>Net Invoice:</td>
            <td>{{ invoice_details.net_invoice }}</td>
          </tr>
          <tr>
            <td>Less Discount:</td>
            <td>{{ invoice_details.less_discount }}</td>
          </tr>
          <tr>
            <td>Sales Tax:</td>
            <td>{{ invoice_details.sales_tax }}</td>
          </tr>
          <tr>
            <td>Freight:</td>
            <td>{{ invoice_details.freight }}</td>
          </tr>
          <tr>
            <td><strong>Invoice Total:</strong></td>
            <td><strong>{{ invoice_details.invoice_total }}</strong></td>
          </tr>
          <tr>
            <td>Less Deposit:</td>
            <td>{{ invoice_details.less_deposit }}</td>
          </tr>
          <tr>
            <td>Less Payments:</td>
            <td>{{ invoice_details.less_payments }}</td>
          </tr>
          <tr>
            <td><strong>Invoice Balance:</strong></td>
            <td><strong>{{ invoice_details.invoice_balance }}</strong></td>
          </tr>
        </table>
      </div>
    </div>
  </div>
</div>

