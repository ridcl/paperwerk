<div class="page">
  <div class="section-title">FINES</div>
  <div class="table-container fines-table">
    <thead>
      <tr>
        <th>Violations</th>
        <th>1st Occurrence</th>
        <th>2nd Occurrence</th>
        <th>3rd Occurrence & there on.</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Failure to sign Liability prior to his/her participation (B2H)</td>
        <td>{{ fine_1_1 }}</td>
        <td>{{ fine_1_2 }}</td>
        <td>{{ fine_1_3 }}</td>
      </tr>
      <tr>
        <td>Failure to pick up the travel binder before a trip</td>
        <td>{{ fine_2_1 }}</td>
        <td>{{ fine_2_2 }}</td>
        <td>{{ fine_2_3 }}</td>
      </tr>
      <tr>
        <td>Late or Failure to submit Paperwork</td>
        <td>{{ fine_3_1 }}</td>
        <td>{{ fine_3_2 }}</td>
        <td>{{ fine_3_3 }}</td>
      </tr>
      <tr>
        <td>Not attending Monthly Officer Meeting</td>
        <td>{{ fine_4_1 }}</td>
        <td>{{ fine_4_2 }}</td>
        <td>{{ fine_4_3 }}</td>
      </tr>
      <tr>
        <td>Not attending Sport Club Officer Training</td>
        <td>{{ fine_5_1 }}</td>
        <td>{{ fine_5_2 }}</td>
        <td>{{ fine_5_3 }}</td>
      </tr>
      <tr>
        <td>Failing to notify Sport Clubs of home games, practices, or any other club function</td>
        <td>{{ fine_6_1 }}</td>
        <td>{{ fine_6_2 }}</td>
        <td>{{ fine_6_3 }}</td>
      </tr>
      <tr>
        <td>Failure to turn in Coaches Contract or CPR/1st Aid Cert</td>
        <td>{{ fine_7_1 }}</td>
        <td>{{ fine_7_2 }}</td>
        <td>{{ fine_7_3 }}</td>
      </tr>
      <tr>
        <td>Failure to represent UCD in a positive manner</td>
        <td>{{ fine_8_1 }}</td>
        <td>{{ fine_8_2 }}</td>
        <td>{{ fine_8_3 }}</td>
      </tr>
      <tr>
        <td>Misuse of University facilities or club property (When reported SCC will look into each situation)</td>
        <td>{{ fine_9_1 }}</td>
        <td>{{ fine_9_2 }}</td>
        <td>{{ fine_9_3 }}</td>
      </tr>
    </tbody>
  </div>
</div>

