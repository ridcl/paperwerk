</style>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px;">
        <div>
            <h1>Thank You</h1>
        </div>
        <div style="text-align: right;">
            <!-- Placeholder for logo image -->
            <div style="font-size: 40pt; line-height: 1;">[Logo Placeholder]</div>
        </div>
    </div>

    <div style="margin-bottom: 30px;">
        <h2 style="font-size: 28pt; margin-bottom: 5px;">
            <span data-field="full_name">{{ full_name }}</span>, MSFP, CFP®
        </h2>
        <p style="font-size: 14pt; font-weight: normal;">
            CERTIFIED FINANCIAL PLANNER™ practitioner
        </p>
        <p style="font-size: 14pt; font-weight: normal;">
            Financial Advisor
        </p>
    </div>

    <div class="contact-info" style="margin-bottom: 60px;">
        <p>
            <span data-field="address_line_1">{{ address_line_1 }}</span>, <span data-field="city">{{ city }}</span>, <span data-field="state">{{ state }}</span> <span data-field="zip_code">{{ zip_code }}</span>
        </p>
        <p>
            Website: <a href="{{ website_url }}">{{ website_url }}</a>
        </p>
        <p>
