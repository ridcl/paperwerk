<head>
    <title>Report Template</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif; }
        .title-large { font-size: 48pt; line-height: 1.1; text-align: center; margin-bottom: 10px; }
        .subtitle { font-size: 24pt; line-height: 1.2; text-align: center; margin-bottom: 40px; }
        .author { font-size: 18pt; text-align: center; margin-bottom: 80px; }
        .footer-info { display: flex; justify-content: space-between; align-items: flex-end; font-size: 10pt; }
        .logo-area { display: flex; align-items: center; }
        .logo-icon { width: 40px; height: 40px; margin-right: 10px; }
        .logo-text { font-size: 10pt; }
        .section-title { font-size: 24pt; margin-bottom: 30px; font-weight: bold; }
        .stat-block { margin-bottom: 30px; }
        .stat-number { font-size: 48pt; font-weight: bold; display: block; }
        .stat-label { font-size: 16pt; }
        .two-column-layout { display: flex; justify-content: space-between; gap: 40px; }
        .column { flex: 1; }
        .list-item { margin-bottom: 10px; line-height: 1.4; }
        .table-container { margin-top: 30px; }
        table { width: 100%; border-collapse: collapse; font-size: 10pt; }
        th, td { padding: 10px; text-align: left; border-bottom: 1px solid #ccc; }
        th { font-weight: bold; }
        .chart-placeholder { height: 300px; background-color: #f0f0f0; display: flex; align-items: center; justify-content: center; color: #888; margin-top: 20px; }
        .data-table-small td:nth-child(2), .data-table-small td:nth-child(3), .data-table-small td:nth-child(4) { text-align: center; }
    </style>

