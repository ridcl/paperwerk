  .legend-color { display: inline-block; width: 12px; height: 12px; margin-right: 5px; }
</style>
<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child {
    page-break-after: auto;
  }
  h1, h2, h3 {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .header-info {
    display: flex;
    justify-content: space-between;
    font-size: 10pt;
  }
  .chart-container {
    margin-top: 30px;
  }
  .bar-row {
    display: flex;
    align-items: center;
    margin-bottom: 10px;
    font-size: 10pt;
  }
  .label {
    width: 30%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .bar-wrapper {
    flex-grow: 1;
    height: 15px;
    background-color: #eee;
    border-radius: 3px;
    position: relative;
    margin-right: 10px;
  }
  .bar {
    height: 100%;
    border-radius: 3px;
    position: absolute;
    top: 0;
  }
  .value-label {
    width: 50px;
    text-align: right;
    font-size: 10pt;
  }
  .legend {
    display: flex;
    gap: 20px;
    margin-bottom: 20px;
    font-size: 10pt;
  }
  .legend-item {
    display: flex;
    align-items: center;
  }
  .legend-color {
    width: 15px;
    height: 15px;
    margin-right: 5px;
  }
  .table-container {
    margin-top: 30px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 10pt;
  }
  th, td {
    padding: 8px 0;
    text-align: left;
  }
  th {
    border-bottom: 1px solid #ccc;
  }
  .footer-text {
    font-size: 8pt;
    margin-top: 40px;
    text-align: right;
  }
  .section-title {
    font-size: 16pt;
    font-weight: bold;
    margin-bottom: 20px;
    text-align: center;
  }
  .list-item {
    margin-bottom: 15px;
    font-size: 11pt;
  }
  .list-item ul {
    list-style-type: disc;
    margin-left: 20px;
    padding-left: 0;
  }
  .list-item li {
    margin-bottom: 5px;
  }
</style>
</head>
