        .sub-header { font-size: 18pt; font-weight: bold; }
        .section-title { font-size: 14pt; font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
        .grid-container { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 20px; }
        .grid-item { flex: 1 1 calc(25% - 20px); min-width: 180px; text-align: center; padding: 15px; border: 1px solid #ccc; border-radius: 5px; }
        .grid-item-small { flex: 1 1 calc(20% - 20px); min-width: 150px; text-align: center; padding: 15px; border: 1px solid #ccc; border-radius: 5px; }
        .data-table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        .data-table th, .data-table td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        .data-table th { background-color: #f2f2f2; }
        .chart-container { width: 100%; height: 300px; margin-top: 20px; }
        .list-item { margin-bottom: 10px; }
        .list-item ul { list-style-type: disc; margin-left: 20px; padding-left: 0; }
        .list-item li { margin-bottom: 5px; }
    </style>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
