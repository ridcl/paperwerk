<!DOCTYPE html>
<html>
<head>
    <title>Presentation</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 { font-weight: bold; }
        .slide-title { font-size: 24pt; text-align: center; margin-bottom: 40px; }
        .subtitle { font-size: 14pt; text-align: center; margin-top: 10px; }
        .footer { position: absolute; bottom: 20px; right: 60px; font-size: 10pt; }
        .header { position: absolute; top: 20px; left: 60px; font-size: 10pt; }
        .content-section { margin-bottom: 40px; }
        ul { list-style-type: disc; margin-left: 40px; padding-left: 0; }
        li { margin-bottom: 10px; }
        .code-block { font-family: monospace; font-size: 10pt; }
    </style>

<style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
