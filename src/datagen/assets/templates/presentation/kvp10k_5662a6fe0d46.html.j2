    <div style="font-size: 12pt; font-weight: bold;">COLUMBIA UNIVERSITY LIBRARIES</div>
    <div style="font-size: 10pt;">code(4)lib 2020</div>
  </div>
  <h1 class="header-title">Geographic Subject Terms in Archival Collections</h1>

  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <div style="width: 40%;">
      <table style="font-size: 10pt;">
        <thead>
          <tr>
            <th style="width: 50%;">Country</th>
            <th style="width: 50%; text-align: right;">Count</th>
          </tr>
        </thead>
        <tbody>
          {% for item in geographic_counts %}
          <tr>
            <td><span data-field="geographic_counts[{{ loop.index0 }}].country">{{ item.country }}</span></td>
            <td style="text-align: right;"><span data-field="geographic_counts[{{ loop.index0 }}].count">{{ item.count }}</span></td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <div style="width: 55%;">
      <div class="chart-container" style="height: 350px;">
        <!-- Placeholder for the world map visualization -->
        <div style="height: 100%; display: flex; align-items: center; justify-content: center; color: #aaa;">World Map Visualization Area</div>
      </div>
    </div>
  </div>
</div>

