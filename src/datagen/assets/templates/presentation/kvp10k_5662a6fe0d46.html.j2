<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px;">
        <div style="font-size: 12pt; font-weight: bold;">{{ institution_name }}</div>
        <div style="font-size: 10pt;">code(4)lib 2020</div>
    </div>
    <h1 class="header-title">Getting Started: Connecting to Data</h1>

    <div class="grid-container">
        <div class="grid-item">
            <h3 style="font-size: 12pt;">Google Analytics</h3>
            <p style="font-size: 10pt;">Connect to Google Analytics reporting views.</p>
            <a href="#" style="font-size: 9pt;">Learn more</a>
        </div>
        <div class="grid-item">
            <h3 style="font-size: 12pt;">Google Ads</h3>
            <p style="font-size: 10pt;">Connect to Google Ads performance report data.</p>
            <a href="#" style="font-size: 9pt;">Learn more</a>
        </div>
        <div class="grid-item">
            <h3 style="font-size: 12pt;">Google Sheets</h3>
            <p style="font-size: 10pt;">Connect to Google Sheets.</p>
            <a href="#" style="font-size: 9pt;">Learn more</a>
        </div>
        <div class="grid-item">
            <h3 style="font-size: 12pt;">BigQuery</h3>
            <p style="font-size: 10pt;">Connect to BigQuery tables and custom queries.</p>
            <a href="#" style="font-size: 9pt;">Learn more</a>
        </div>
        <div class="grid-item">
            <h3 style="font-size: 12pt;">File Upload</h3>
            <p style="font-size: 10pt;">Connect to CSV (comma-separated values) files.</p>
            <a href="#" style="font-size: 9pt;">Learn more</a>
        </div>
        <div class="grid-item">
            <h3 style="font-size: 12pt;">Campaign Manager</h3>
            <p style="font-size: 10pt;">Connect to Campaign Manager data.</p>
            <a href="#" style="font-size: 9pt;">Learn more</a>
        </div>
        <div class="grid-item">
            <h3 style="font-size: 12pt;">Cloud Spanner</h3>
            <p style="font-size: 10pt;">Connect to Google Cloud Spanner databases.</p>
            <a href="#" style="font-size: 9pt;">Learn more</a>
        </div>
        <div class="grid-item">
            <h3 style="font-size: 12pt;">Cloud SQL for MySQL</h3>
            <p style="font-size: 10pt;">Connect to Google Cloud SQL for MySQL databases.</p>
            <a href="#" style="font-size: 9pt;">Learn more</a>
        </div>
        <div class="grid-item">
            <h3 style="font-size: 12pt;">Display & Video 360</h3>
            <p style="font-size: 10pt;">Connect to Display & Video 360 report data.</p>
            <a href="#" style="font-size: 9pt;">Learn more</a>
        </div>
        <div class="grid-item">
            <h3 style="font-size: 12pt;">Extract Data</h3>
            <p style="font-size: 10pt;">Connect to Extract Data.</p>
            <a href="#" style="font-size: 9pt;">Learn more</a>
        </div>
        <div class="grid-item">
            <h3 style="font-size: 12pt;">Google Ad Manager 360</h3>
            <p style="font-size: 10pt;">Connect to Google Ad Manager data.</p>
            <a href="#" style="font-size: 9pt;">Learn more</a>
        </div>
        <div class="grid-item">
            <h3 style="font-size: 12pt;">Google Cloud Storage</h3>
            <p style="font-size: 10pt;">See your files in Google Cloud Storage.</p>
            <a href="#" style="font-size: 9pt;">Learn more</a>
        </div>
        <div class="grid-item">
            <h3 style="font-size: 12pt;">MySQL</h3>
            <p style="font-size: 10pt;">Connect to MySQL databases.</p>
            <a href="#" style="font-size: 9pt;">Learn more</a>
        </div>
        <div class="grid-item">
            <h3 style="font-size: 12pt;">PostgreSQL</h3>
            <p style="font-size: 10pt;">Connect to PostgreSQL databases.</p>
            <a href="#" style="font-size: 9pt;">Learn more</a>
        </div>
        <div class="grid-item">
            <h3 style="font-size: 12pt;">Search Ads 360</h3>
            <p style="font-size: 10pt;">Connect to Search Ads 360 performance reports.</p>
            <a href="#" style="font-size: 9pt;">Learn more</a>
        </div>
        <div class="grid-item">
            <h3 style="font-size: 12pt;">Search Console</h3>
            <p style="font-size: 10pt;">Connect to Search Console data.</p>
            <a href="#" style="font-size: 9pt;">Learn more</a>
        </div>
        <div class="grid-item">
            <h3 style="font-size: 12pt;">YouTube Analytics</h3>
            <p style="font-size: 10pt;">Connect to YouTube Analytics data.</p>
            <a href="#" style="font-size: 9pt;">Learn more</a>
        </div>
    </div>
</div>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px;">
        <div style="font-size: 12pt; font-weight: bold;">{{ institution_name }}</div>
        <div style="font-size: 10pt;">code(4)lib 2020</div>
    </div>
    <h1 class="sub-header">Data Blending Basics</h1>

    <div style="display: flex; gap: 30px;">
        <!-- Left Panel: Data Source Selection -->
        <div style="flex: 1;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                <h3 style="font-size: 12pt;">Blend Data</h3>
                <div style="display: flex; gap: 10px;">
                    <span style="font-size: 10pt;">Data source:</span>
                    <select style="padding: 5px;">
                        <option>{{ left_data_source }}</option>
                    </select>
                    <span style="font-size: 10pt;">Join keys:</span>
                    <input type="text" placeholder="Type to search" style="padding: 5px;">
                </div>
            </div>
            <div style="border: 1px solid #ccc; padding: 10px; margin-bottom: 20px;">
                <h4 style="font-size: 11pt;">Dimensions</h4>
                <ul style="list-style: none; padding: 0;">
                    {% for dim in left_dimensions %}
                    <li style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px;">
                        <span>{{ dim.name }}</span>
                        <button style="font-size: 10pt;">Add dimension</button>
                    </li>
                    {% endfor %}
                </ul>
                <button style="margin-top: 10px; padding: 5px 10px; font-size: 10pt;">+ Add dimension</button>
            </div>
        </div>

        <!-- Right Panel: Data Source Selection -->
        <div style="flex: 1;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                <h3 style="font-size: 12pt;">Data source</h3>
                <div style="display: flex; gap: 10px;">
                    <span style="font-size: 10pt;">Finding Aids (EAD):</span>
                    <select style="padding: 5px;">
                        <option>{{ right_data_source }}</option>
                    </select>
                    <span style="font-size: 10pt;">Join keys:</span>
                    <input type="text" placeholder="Type to search" style="padding: 5px;">
                </div>
            </div>
            <div style="border: 1px solid #ccc; padding: 10px; margin-bottom: 20px;">
                <h4 style="font-size: 11pt;">Dimensions</h4>
                <ul style="list-style: none; padding: 0;">
                    {% for dim in right_dimensions %}
                    <li style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px;">
                        <span>{{ dim.name }}</span>
                        <button style="font-size: 10pt;">Add dimension</button>
                    </li>
                    {% endfor %}
                </ul>
                <button style="margin-top: 10px; padding: 5px 10px; font-size: 10pt;">+ Add dimension</button>
            </div>
        </div>
    </div>

    <div style="margin-top: 30px; text-align: center;">
        <button style="padding: 10px 20px; font-size: 12pt;">+ ADD ANOTHER DATA SOURCE</button>
    </div>
</div>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px;">
        <div style="font-size: 12pt; font-weight: bold;">{{ institution_name }}</div>
        <div style="font-size: 10pt;">code(4)lib 2020</div>
    </div>
    <h1 class="sub-header">Chart > Bar</h1>

    <div style="display: flex; gap: 30px;">
        <!-- Left Panel: Chart Configuration -->
        <div style="flex: 1;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                <h3 style="font-size: 12pt;">Data Source</h3>
                <select style="padding: 5px;">
                    <option>{{ chart_data_source }}</option>
                </select>
            </div>
            <div style="display: flex; gap: 20px; margin-bottom: 20px;">
                <div style="flex: 1;">
                    <label style="font-size: 10pt;">Dimension</label>
                    <select style="width: 100%; padding: 5px;">
                        <option>{{ chart_dimension }}</option>
                    </select>
                </div>
                <div style="flex: 1;">
                    <label style="font-size: 10pt;">Metric</label>
                    <select style="width: 100%; padding: 5px;">
                        <option>{{ chart_metric }}</option>
                    </select>
                </div>
            </div>
            <div style="border: 1px solid #ccc; padding: 10px;">
                <h4 style="font-size: 11pt;">Drill Down</h4>
                <ul style="list-style: none; padding: 0;">
                    {% for drill in chart_drill_downs %}
                    <li style="margin-bottom: 5px;">{{ drill.name }}</li>
