    height: 60px; /* Placeholder for logo size */
  }
  .title-area {
    text-align: right;
  }
  .title-area h1 {
    font-size: 24pt;
    margin: 0;
  }
  .section-title {
    font-size: 14pt;
    font-weight: bold;
    margin-top: 30px;
    margin-bottom: 15px;
  }
  .list-item {
    margin-bottom: 10px;
    line-height: 1.5;
  }
  .list-item ul {
    list-style-type: disc;
    margin-left: 20px;
    padding-left: 0;
  }
  .list-item li {
    margin-bottom: 5px;
  }
