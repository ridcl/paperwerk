<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, "Times New Roman", serif;
    color: #333;
  }
  h1, h2, h3 {
    font-family: "Liberation Sans", "DejaVu Sans", Arial, sans-serif;
    font-weight: bold;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  td, th {
    padding: 8px 0;
    text-align: left;
  }
  .header-table td {
    padding: 0;
  }
  .signature-line {
    border-bottom: 1px solid #000;
    display: inline-block;
    width: 200px;
    margin-top: 50px;
  }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px;">
    <div>
      <h1 style="font-size: 18pt; margin: 0;">2018-2019 BUILD Resource/Benefits Verification Form</h1>
    </div>
    <div style="text-align: right;">
      <img src="placeholder_logo.png" alt="University Logo" style="height: 60px;">
      <h2 style="font-size: 14pt; margin: 0;">BETHEL UNIVERSITY</h2>
    </div>
  </div>

  <p style="margin-bottom: 20px;">All students applying to, or enrolling in, the Bethel University Inclusive Learning and Development (BUILD) Program are asked to document the type and amount of third-party grants, scholarships and waivers students receive to help pay their college expenses. Resources paid directly to Bethel reduce the amount students need to pay out of pocket. Resources paid directly to the student may be used to help pay their portion of the school bill.</p>

  <h3 style="margin-top: 30px;">Instructions.</h3>
  <p style="margin-bottom: 20px;">Please complete this form and return it to the Financial Aid Office via mail, email or fax. List the type and amount of educational benefits you will receive from each program for the 2018-19 academic year. Remember, if the benefit amounts change after you submit this form, your financial aid and billing information may need to be revised.</p>

  <table style="width: 100%;">
    <tr>
      <td style="width: 30%;">Student's Name</td>
      <td style="width: 30%;">Student ID</td>
      <td style="width: 30%;">Date</td>
    </tr>
  </table>

  <table style="width: 100%; margin-top: 20px;">
    <tr>
      <td style="width: 30%;">Name of person submitting this form</td>
      <td style="width: 35%;">Relationship to student</td>
      <td style="width: 35%;"></td>
    </tr>
  </table>

  <table style="width: 100%; margin-top: 20px;">
    <tr>
      <td style="width: 30%;">Contact information: Phone number:</td>
      <td style="width: 35%;">Email:</td>
      <td style="width: 35%;"></td>
    </tr>
  </table>

  <h3 style="margin-top: 30px;">Will you receive any funds for tuition and fees?</h3>

  <table style="margin-top: 15px;">
    <thead>
      <tr>
        <th style="text-align: left; width: 30%;"></th>
        <th style="text-align: left; width: 30%;">Funds will go directly to:</th>
        <th style="text-align: center; width: 15%;">Fall 2018 Semester</th>
        <th style="text-align: center; width: 15%;">Spring 2019 Semester</th>
        <th style="text-align: center; width: 10%;">Total</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td style="padding: 0;">
          <input type="radio" name="waiver_1" value="no"> No
        </td>
        <td style="padding: 0;">
          <input type="radio" name="waiver_1" value="yes"> Yes Agency Name _________
        </td>
        <td style="text-align: center;"><span data-field="waiver_1.fall_2018_amount">{{ waiver_1.fall_2018_amount }}</span></td>
        <td style="text-align: center;"><span data-field="waiver_1.spring_2019_amount">{{ waiver_1.spring_2019_amount }}</span></td>
        <td style="text-align: center;"><span data-field="waiver_1.total_amount">{{ waiver_1.total_amount }}</span></td>
      </tr>
      <tr>
        <td style="padding: 0;">
          <input type="radio" name="waiver_2" value="no"> No
        </td>
        <td style="padding: 0;">
          <input type="radio" name="waiver_2" value="yes"> Yes
        </td>
        <td style="text-align: center;"><span data-field="waiver_2.fall_2018_amount">{{ waiver_2.fall_2018_amount }}</span></td>
        <td style="text-align: center;"><span data-field="waiver_2.spring_2019_amount">{{ waiver_2.spring_2019_amount }}</span></td>
        <td style="text-align: center;"><span data-field="waiver_2.total_amount">{{ waiver_2.total_amount }}</span></td>
      </tr>
    </tbody>
  </table>

  <table style="margin-top: 20px;">
    <tr>
      <td style="width: 30%;">Medicaid Waiver (also known as CADI/DD/CDCS Waivers):</td>
      <td style="width: 30%;"></td>
      <td style="width: 40%;"></td>
    </tr>
  </table>

  <table style="margin-top: 20px;">
    <tr>
      <td style="width: 30%;">Vocational Rehabilitation Services</td>
      <td style="width: 30%;"></td>
      <td style="width: 40%;"></td>
    </tr>
  </table>

  <h3 style="margin-top: 30px;">Please list any other resources/funding (e.g. scholarships, donations, etc.)</h3>

  <table style="margin-top: 15px;">
    <thead>
      <tr>
        <th style="text-align: left; width: 20%;">Other:</th>
        <th style="text-align: left; width: 25%;"></th>
        <th style="text-align: center; width: 15%;">Fall 2018 Semester</th>
        <th style="text-align: center; width: 15%;">Spring 2019 Semester</th>
        <th style="text-align: center; width: 15%;">Total</th>
      </tr>
    </thead>
    <tbody>
      {% for item in other_resources %}
      <tr>
        <td style="padding: 0;">Other:</td>
        <td style="padding: 0;">
          <input type="radio" name="other_resource_{{ loop.index0 }}" value="student"> Student/Family
          <input type="radio" name="other_resource_{{ loop.index0 }}" value="bethel"> Bethel University
        </td>
        <td style="text-align: center;"><span data-field="other_resources[{{ loop.index0 }}].fall_2018_amount">{{ other_resources[loop.index0].fall_2018_amount }}</span></td>
        <td style="text-align: center;"><span data-field="other_resources[{{ loop.index0 }}].spring_2019_amount">{{ other_resources[loop.index0].spring_2019_amount }}</span></td>
        <td style="text-align: center;"><span data-field="other_resources[{{ loop.index0 }}].total_amount">{{ other_resources[loop.index0].total_amount }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <table style="margin-top: 15px;">
    <thead>
      <tr>
        <th style="text-align: left; width: 20%;">Other:</th>
        <th style="text-align: left; width: 25%;"></th>
        <th style="text-align: center; width: 15%;">Fall 2018 Semester</th>
        <th style="text-align: center; width: 15%;">Spring 2019 Semester</th>
        <th style="text-align: center; width: 15%;">Total</th>
      </tr>
    </thead>
    <tbody>
      {% for item in other_resources_2 %}
      <tr>
        <td style="padding: 0;">Other:</td>
        <td style="padding: 0;">
          <input type="radio" name="other_resource_2_{{ loop.index0 }}" value="student"> Student/Family
          <input type="radio" name="other_resource_2_{{ loop.index0 }}" value="bethel"> Bethel University
        </td>
        <td style="text-align: center;"><span data-field="other_resources_2[{{ loop.index0 }}].fall_2018_amount">{{ other_resources_2[loop.index0].fall_2018_amount }}</span></td>
        <td style="text-align: center;"><span data-field="other_resources_2[{{ loop.index0 }}].spring_2019_amount">{{ other_resources_2[loop.index0].spring_2019_amount }}</span></td>
        <td style="text-align: center;"><span data-field="other_resources_2[{{ loop.index0 }}].total_amount">{{ other_resources_2[loop.index0].total_amount }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div style="text-align: right; margin-top: 40px;">
    <h3 style="margin-bottom: 10px;">TOTAL Funds for Tuition and Fees received:</h3>
    <table style="width: 40%;">
      <tr>
        <td style="text-align: center; width: 33%;"><span data-field="total_funds.fall_2018">{{ total_funds.fall_2018 }}</span></td>
        <td style="text-align: center; width: 33%;"><span data-field="total_funds.spring_2019">{{ total_funds.spring_2019 }}</span></td>
        <td style="text-align: center; width: 33%;"><span data-field="total_funds.total">{{ total_funds.total }}</span></td>
      </tr>
    </table>
  </div>

  <p style="margin-top: 30px;">Do you also wish to be considered federal and state aid? <input type="checkbox" data-field="consider_federal_aid" value="{{ consider_federal_aid }}"> YES <input type="checkbox" data-field="consider_federal_aid" value="{{ consider_federal_aid }}"> NO</p>

  <p style="margin-top: 10px;">If yes, please also submit the FAFSA (Free Application for Federal Student Aid) at <a href="http://www.fafsa.gov" style="color: blue;">www.fafsa.gov</a>. Bethel's FAFSA Code is 002338.</p>

  <p style="margin-top: 20px;">Find additional resources for scholarships, grants, and loans on our website: <a href="http://www.bethel.edu/undergrad/financial-aid/" style="color: blue;">www.bethel.edu/undergrad/financial-aid/</a></p>

  <div style="margin-top: 80px; font-size: 10pt;">
    <p style="margin: 0;">Office of Financial Aid • <span data-field="university_name">{{ university_name }}</span> • <span data-field="address">{{ address }}</span> • Fax: <span data-field="fax_number">{{ fax_number }}</span></p>
    <p style="margin: 5px 0 0 0;">phone: <span data-field="phone_number">{{ phone_number }}</span> • <span data-field="email_address">{{ email_address }}</span></p>
  </div>
</div>