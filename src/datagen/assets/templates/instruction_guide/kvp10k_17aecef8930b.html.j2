<!DOCTYPE html>
<html>
<head>
<title>Appointment Scheduling</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { font-weight: bold; }
  .header-title { font-size: 24pt; text-align: center; margin-bottom: 5px; }
  .subtitle { font-size: 14pt; text-align: center; margin-bottom: 30px; }
  .logo-container { text-align: center; margin: 40px 0; }
  .logo-img { max-width: 150px; height: auto; }
  .section-title { font-size: 16pt; font-weight: bold; margin-bottom: 15px; }
  .instruction-box {
    border: 1px solid #ccc;
    padding: 20px;
    margin: 20px 0;
    text-align: center;
    background-color: #f9f9f9;
  }
  .form-group { margin-bottom: 15px; }
  .form-group label { display: block; margin-bottom: 5px; font-weight: normal; }
  .form-group input[type="text"], .form-group input[type="password"], .form-group select {
    width: 100%;
    padding: 10px;
    border: 1px solid #ccc;
    box-sizing: border-box;
    font-family: inherit;
  }
  .button {
    padding: 10px 20px;
    background-color: #0056b3;
    color: white;
    border: none;
    cursor: pointer;
    font-size: 12pt;
    margin-top: 10px;
  }
  .button:hover { background-color: #004494; }
  .link-text { color: #0056b3; text-decoration: underline; }
  .grid-container {
    display: flex;
    gap: 40px;
    margin-top: 30px;
  }
  .column { flex: 1; }
  .tab-navigation { display: flex; border-bottom: 1px solid #ccc; margin-bottom: 20px; }
  .tab-button { padding: 10px 15px; cursor: pointer; border: 1px solid transparent; border-bottom: none; background-color: #eee; margin-right: 2px; }
  .tab-button.active { background-color: white; border-color: #ccc; border-bottom: 1px solid white; }
  .appointment-details-table { width: 100%; border-collapse: collapse; margin-top: 20px; }
  .appointment-details-table td { padding: 8px 0; border-bottom: 1px dotted #eee; }
  .appointment-details-table .label { font-weight: bold; width: 30%; }
  .time-slot-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 10px;
    margin-top: 15px;
  }
  .time-slot-button {
    padding: 10px;
    border: 1px solid #ccc;
    background-color: #fff;
    cursor: pointer;
    text-align: center;
  }
  .time-slot-button.selected {
    background-color: #d4edda;
    border-color: #c3e6cb;
  }
</style>
</head>
<body>

<div class="page">
  <div class="header-title">Scheduling an Appointment</div>
  <div class="subtitle">Division of Student Success – Advising Services</div>
  <div class="logo-container">
    <!-- Placeholder for NAVIGATE logo -->
    <span style="font-size: 30pt; font-weight: bold;">NAVIGATE</span>
  </div>
  <div class="logo-container" style="margin-top: 50px;">
    <!-- Placeholder for SUFFOLK UNIVERSITY logo -->
    <span style="font-size: 20pt; font-weight: bold;">SUFFOLK UNIVERSITY BOSTON</span>
  </div>
</div>

<div class="page">
  <div style="text-align: center; margin-bottom: 30px;">
    <span data-field="navigate_website_url" class="link-text">Navigate Website: {{ navigate_website_url }}</span>
  </div>

  <div class="grid-container">
    <div class="column" style="display: flex; flex-direction: column; align-items: center;">
      <!-- Image placeholder for building -->
      <div style="width: 100%; height: 300px; background-color: #e0e0e0; margin-bottom: 20px;"></div>
    </div>
    <div class="column" style="display: flex; flex-direction: column; justify-content: center;">
      <div class="logo-container" style="margin-bottom: 20px;">
        <!-- Placeholder for SUFFOLK UNIVERSITY logo -->
        <span style="font-size: 20pt; font-weight: bold;">SUFFOLK UNIVERSITY BOSTON</span>
      </div>
      <div class="form-group" style="width: 100%;">
        <label for="username">Sign in with your Suffolk University Username</label>
        <input type="text" id="username" placeholder="Username example jdoe">
      </div>
      <div class="form-group" style="width: 100%;">
        <label for="password">Password</label>
        <input type="password" id="password">
      </div>
      <button class="button" style="width: 100%;">Sign in</button>
      <div style="margin-top: 15px; text-align: center;">
        <a href="#" class="link-text">Change Password</a> |
        <a href="#" class="link-text">Forgot Password</a> |
        <a href="#" class="link-text">Enroll in Password Reset</a>
      </div>
      <div style="margin-top: 30px; font-size: 10pt; text-align: center;">
        Need help contact the Suffolk University Service Desk at {{ service_desk_phone }} or email <span data-field="service_desk_email" class="link-text">{{ service_desk_email }}</span>
      </div>
    </div>
  </div>
</div>

<div class="page">
  <div class="header-title">Scheduling An Appointment</div>
  <div class="instruction-box">
    Click on the “Schedule An Appointment” button on the right-hand side of the screen
  </div>

  <div style="margin-top: 50px;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
      <div style="display: flex; gap: 20px;">
        <div style="border: 1px solid #ccc; padding: 10px;">
          <div style="font-weight: bold;">Student Home</div>
          <div style="font-size: 10pt;">Class Information | Reports | Calendar</div>
        </div>
        <div style="border: 1px solid #ccc; padding: 10px;">
          <div style="font-weight: bold;">Courses This Term</div>
        </div>
      </div>
      <div style="text-align: right;">
        <div style="border: 1px solid #ccc; padding: 10px;">
          <div style="font-weight: bold;">Quick Links</div>
        </div>
        <button style="margin-top: 10px; background-color: #007bff; color: white; border: none; padding: 8px 15px; cursor: pointer;">Schedule an Appointment</button>
      </div>
    </div>
  </div>
</div>

<div class="page">
  <div class="header-title">Scheduling An Appointment Cont.</div>

  <div class="grid-container">
    <div class="column">
      <div class="section-title">Select the type of appointment you are looking for by clicking on the drop-down menu. Choose from:</div>
      <ul style="list-style-type: disc; padding-left: 20px;">
        <li>Advising Services – Division of Student Success</li>
        <li>Tutoring Services</li>
      </ul>
      <div class="section-title" style="margin-top: 20px;">Find the appropriate service category and then select the service that best fits your needs:</div>
      <ul style="list-style-type: circle; padding-left: 20px;">
        <li>International Student Services
          <ul style="list-style-type: circle; padding-left: 20px;">
            <li>Change of Status</li>
            <li>Visa/Immigration</li>
          </ul>
        </li>
        <li>Study Abroad
          <ul style="list-style-type: circle; padding-left: 20px;">
            <li>General Study Abroad</li>
            <li>Ireland</li>
          </ul>
        </li>
        <li>Undergraduate Academic Advising Center
          <ul style="list-style-type: circle; padding-left: 20px;">
            <li>Add / Drop / Schedule Change</li>
            <li>Graduation Question</li>
            <li>Program Evaluation</li>
          </ul>
        </li>
      </ul>
      <div style="margin-top: 30px;">
        <p>Select a Date</p>
        <p>Click on “Find Available Time”</p>
      </div>
    </div>

    <div class="column">
      <div class="section-title">New Appointment</div>
      <p>Below, you will find available options for scheduling an appointment. If you cannot find something that you are looking for, try the other appointment options to see available options for dropping in or requesting an appointment.</p>

      <div class="form-group">
        <label for="appointment_type">What type of appointment would you like to schedule?</label>
        <select id="appointment_type">
          <option value="advising">Advising Services - Division of Student Success</option>
          <option value="other">Other</option>
        </select>
      </div>

      <div class="form-group">
        <label for="appointment_category">Scroll through the types of appointments and select appropriate service.</label>
        <select id="appointment_category">
          <option value="add_drop">Add / Drop / Schedule Changes</option>
          <option value="other">Other</option>
        </select>
      </div>

      <div class="form-group">
        <label for="pick_a_date">Pick a Date</label>
        <input type="text" id="pick_a_date" value="Friday, September 3rd 2021">
      </div>

      <button class="button" style="width: 100%;">Find Available Time</button>
    </div>
  </div>
</div>

<div class="page">
  <div class="header-title">Scheduling An Appointment Cont.</div>

  <div class="instruction-box" style="text-align: left;">
    Start by selecting criteria on the bottom left-hand side.
  </div>

  <div class="grid-container">
    <div class="column">
      <div class="section-title">Staff:</div>
      <p>If you know which staff member you want to meet with select their name from the drop-down menu. Otherwise, just leave it blank and all available advisors will populate.</p>
      <div class="form-group">
        <label for="staff_search">Staff</label>
        <input type="text" id="staff_search" placeholder="Search by name">
      </div>

      <div class="section-title" style="margin-top: 20px;">How would you like to meet:</div>
      <div class="form-group">
        <label for="meeting_type">How would you like to meet?</label>
        <select id="meeting_type">
          <option value="in_person">In-person</option>
          <option value="virtual">Virtual</option>
        </select>
      </div>

      <div class="section-title" style="margin-top: 20px;">Select the office you are making the appointment with from the drop-down:</div>
      <div class="form-group">
        <label for="office_select">Choose the office you are looking to make an appointment with.</label>
        <select id="office_select">
          <option value="undergrad_advising">Undergraduate Academic Advising Center</option>
          <option value="other_office">Other Office</option>
        </select>
      </div>

      <div class="section-title" style="margin-top: 30px;">Next – Choose a time under the date that works for you.</div>
      <div class="time-slot-grid">
        <div class="time-slot-button">Wed, Sep 8th<br>9:30 - 10:00 AM</div>
        <div class="time-slot-button">Wed, Sep 8th<br>10:00 - 10:30 AM</div>
        <div class="time-slot-button">Wed, Sep 8th<br>10:30 - 11:00 AM</div>
        <div class="time-slot-button">Wed, Sep 8th<br>11:00 - 11:30 AM</div>
        <div class="time-slot-button">Wed, Sep 8th<br>11:30 - 12:00 PM</div>
        <div class="time-slot-button">Mon, Sep 13th<br>9:30 - 10:00 AM</div>
        <div class="time-slot-button">Mon, Sep 13th<br>10:00 - 10:30 AM</div>
        <div class="time-slot-button">Mon, Sep 13th<br>10:30 - 11:00 AM</div>
        <div class="time-slot-button">Mon, Sep 13th<br>11:00 - 11:30 AM</div>
        <div class="time-slot-button">Mon, Sep 13th<br>11:30 - 12:00 PM</div>
        <div class="time-slot-button">Wed, Sep 15th<br>9:30 - 10:00 AM</div>
        <div class="time-slot-button">Wed, Sep 15th<br>10:00 - 10:30 AM</div>
        <div class="time-slot-button">Wed, Sep 15th<br>10:30 - 11:00 AM</div>
        <div class="time-slot-button">Wed, Sep 15th<br>11:00 - 11:30 AM</div>
        <div class="time-slot-button">Wed, Sep 15th<br>11:30 - 12:00 PM</div>
      </div>
    </div>

    <div class="column">
      <!-- Empty column for layout balance -->
    </div>
  </div>
</div>

<div class="page">
  <div class="header-title">Confirm Appointment Information</div>
  <div class="instruction-box" style="text-align: left;">
    Review the information on the Appointment Details screen. Click “Schedule” after you have entered your comments and confirmed appointment details.
  </div>

  <div class="grid-container">
    <div class="column">
      <div class="section-title">Confirm the Details</div>
      <div class="form-group">
        <label>What type of Appointment:</label>
        <p><span data-field="appointment_type_confirmed">{{ appointment_type_confirmed }}</span> – Division of Student Success</p>
      </div>
      <div class="form-group">
        <label>Why:</label>
        <p><span data-field="appointment_reason">{{ appointment_reason }}</span></p>
      </div>
      <div class="form-group">
        <label>When:</label>
        <p><span data-field="appointment_date_time">{{ appointment_date_time }}</span></p>
      </div>
      <div class="form-group">
        <label>Where:</label>
        <p><span data-field="appointment_location">{{ appointment_location }}</span></p>
      </div>
      <div class="form-group">
        <label>Who:</label>
        <p><span data-field="appointment_staff">{{ appointment_staff }}</span></p>
      </div>
      <div class="form-group">
        <label>How would you like to meet:</label>
        <p><span data-field="meeting_preference_confirmed">{{ meeting_preference_confirmed }}</span></p>
      </div>

      <div style="margin-top: 30px;">
        <div class="section-title" style="font-size: 12pt;">Add notes here to help advisor understand what you would like to discuss during meeting.</div>
        <textarea style="width: 100%; height: 80px; margin-top: 10px; border: 1px solid #ccc; padding: 10px; box-sizing: border-box;"></textarea>
      </div>

      <div style="margin-top: 20px;">
        <div class="section-title" style="font-size: 12pt;">Enter cell phone number you want text reminders sent to.</div>
        <input type="text" placeholder="Phone Number for Text Reminder" style="width: 100%; padding: 10px; margin-top: 10px; border: 1px solid #ccc;">
      </div>

      <button class="button" style="width: 100%; margin-top: 30px;">Schedule</button>
    </div>

    <div class="column">
      <div class="section-title">Review Appointment Details and Confirm</div>
      <div class="appointment-details-table">
        <tr>
          <td class="label">What type of appointment would you like to schedule?</td>
          <td><span data-field="review_appointment_type">{{ review_appointment_type }}</span></td>
        </tr>
        <tr>
          <td class="label">Date</td>
          <td><span data-field="review_date">{{ review_date }}</span></td>
        </tr>
        <tr>
          <td class="label">Time</td>
          <td><span data-field="review_time">{{ review_time }}</span></td>
        </tr>
        <tr>
          <td class="label">Choose the office you are looking to make an appointment with.</td>
          <td><span data-field="review_office">{{ review_office }}</span></td>
        </tr>
        <tr>
          <td class="label">Staff</td>
          <td><span data-field="review_staff">{{ review_staff }}</span></td>
        </tr>
        <tr>
          <td class="label">How would you like to meet?</td>
          <td><span data-field="review_meeting_type">{{ review_meeting_type }}</span></td>
        </tr>
      </div>

      <div style="margin-top: 30px;">
        <div class="section-title" style="font-size: 12pt;">Would you like to share anything else?</div>
        <textarea style="width: 100%; height: 80px; margin-top: 10px; border: 1px solid #ccc; padding: 10px; box-sizing: border-box;"></textarea>
      </div>

      <div style="margin-top: 20px;">
        <label style="display: block; margin-bottom: 5px;">
          <input type="checkbox" checked> Email Reminder
        </label>
        <label style="display: block; margin-bottom: 5px;">
          <input type="checkbox"> Text Message Reminder
        </label>
      </div>
    </div>
  </div>
</div>

</body>
</html>