<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic layout structure */
  h1 { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; font-size: 36pt; line-height: 1.1; margin-bottom: 20px; }
  h2 { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; font-size: 18pt; line-height: 1.4; margin-top: 30px; margin-bottom: 10px; font-weight: bold; }
  .step-container { display: flex; align-items: flex-start; margin-bottom: 30px; }
  .step-icon { font-size: 30pt; line-height: 1; margin-right: 20px; color: #007bff; }
  .step-content { flex-grow: 1; }
  .step-title { font-weight: bold; font-size: 14pt; margin-bottom: 5px; }
  .step-description { font-size: 11pt; line-height: 1.5; color: #555; }
  .logo-area { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px; }
  .logo-left img, .logo-right img { height: 40px; } /* Placeholder for logos */
  .footer { display: flex; justify-content: space-between; align-items: center; margin-top: 80px; padding-top: 20px; border-top: 1px solid #eee; font-size: 10pt; }
  .footer-item { text-align: center; }
  .footer-icon { font-size: 18pt; margin-bottom: 5px; }
</style>

<div class="page">
  <div class="logo-area">
    <div class="logo-left">
      <!-- Placeholder for UWO Logo -->
      <span style="font-family: Arial, sans-serif; font-size: 16pt; font-weight: bold;">UWO OSHKOSH</span>
    </div>
    <div class="logo-right">
      <!-- Placeholder for PayMyTuition Logo -->
      <span style="font-family: Arial, sans-serif; font-size: 16pt; font-weight: bold;">PayMyTuition</span>
    </div>
  </div>

  <h1>HOW TO MAKE YOUR PAYMENT</h1>
  <p style="font-size: 12pt; line-height: 1.6; margin-bottom: 40px;">Paying tuition with <span data-field="payment_system_name">{{ payment_system_name }}</span> is safe, fast, and convenient. Follow the simple steps below to complete your payment:</p>

  <!-- Step 1 -->
  <div class="step-container">
    <div class="step-icon">1</div>
    <div class="step-content">
      <div class="step-title">ENTER YOUR INSTITUTION NAME</div>
      <div class="step-description">
        Log into your <span data-field="portal_name">{{ portal_name }}</span> portal and proceed through the payment process. The <span data-field="payment_system_name">{{ payment_system_name }}</span> solution is integrated into your one-time payment process to allow for a seamless payment experience. Click on the International Payments link to be re-directed to the <span data-field="payment_system_name">{{ payment_system_name }}</span> portal.
      </div>
    </div>
  </div>

  <!-- Step 2 -->
  <div class="step-container">
    <div class="step-icon">2</div>
    <div class="step-content">
      <div class="step-title">SELECT PAYMENT METHOD</div>
      <div class="step-description">
        Review the payment options provided and select your preferred payment method. Payment options include bank transfers, debit/credit cards in your home currency, eWallet payments and other local options.
      </div>
    </div>
  </div>

  <!-- Step 3 -->
  <div class="step-container">
    <div class="step-icon">3</div>
    <div class="step-content">
      <div class="step-title">ENTER YOUR DETAILS</div>
      <div class="step-description">
        Enter some basic information including your student number. We will include this information with your payment for easy identification of your payment by the University of <span data-field="institution_name">{{ institution_name }}</span> team.
      </div>
    </div>
  </div>

  <!-- Step 4 -->
  <div class="step-container">
    <div class="step-icon">4</div>
    <div class="step-content">
      <div class="step-title">MAKE YOUR PAYMENT</div>
      <div class="step-description">
        Follow the instructions provided to send your funds to <span data-field="payment_system_name">{{ payment_system_name }}</span> via your selected payment method.
      </div>
    </div>
  </div>

  <!-- Step 5 -->
  <div class="step-container">
    <div class="step-icon">5</div>
    <div class="step-content">
      <div class="step-title">TRACK & CONFIRM</div>
      <div class="step-description">
        Track your payment by logging into your <span data-field="dashboard_link">{{ dashboard_link }}</span> at any time. Receive SMS texts, email status updates, and confirmations of when your payment has been delivered.
      </div>
    </div>
  </div>

  <!-- Footer Section -->
  <div class="footer">
    <div class="footer-item">
      <span style="font-size: 24pt; color: #ff9900;">P</span>
      <p style="margin: 5px 0 0 0;">
        <span data-field="payment_system_name">{{ payment_system_name }}</span>
      </p>
      <p style="margin: 0;">
        U.S. & Canada toll free: <span data-field="phone_number">{{ phone_number }}</span><br>
        U.S. Local: <span data-field="phone_number">{{ phone_number }}</span><br>
        Canada Local: <span data-field="phone_number">{{ phone_number }}</span><br>
        Email: <span data-field="email_address">{{ email_address }}</span><br>
        Web: <span data-field="website_url">{{ website_url }}</span>
      </p>
    </div>
    <div class="footer-item">
      <div class="footer-icon">💳</div>
      <p>Great rates</p>
    </div>
    <div class="footer-item">
      <div class="footer-icon">🛡️</div>
      <p>Secure</p>
    </div>
    <div class="footer-item">
      <div class="footer-icon">📞</div>
      <p>Support</p>
    </div>
  </div>
</div>