<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; /* Defaulting to serif for document feel */
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic layout structure */
  h1, h2, h3 { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; }
  .header-section { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
  .form-container { border: 1px solid #ccc; padding: 20px; margin-top: 20px; }
  .input-group { margin-bottom: 15px; }
  .input-group label { display: block; margin-bottom: 5px; font-weight: bold; }
  .input-group input[type="text"], .input-group input[type="password"] { width: 95%; padding: 8px; border: 1px solid #ccc; }
  .button { padding: 10px 20px; border: none; cursor: pointer; background-color: #005a9c; color: white; margin-right: 10px; }
  .table-container { margin-top: 20px; }
  table { width: 100%; border-collapse: collapse; margin-top: 15px; }
  th, td { border: 1px solid #ddd; padding: 10px; text-align: left; }
  th { background-color: #f2f2f2; }
  .footer { margin-top: 50px; font-size: 0.8em; color: #555; }
</style>

<div class="page">
  <div class="header-section">
    <div>
      <span style="font-size: 24px; font-weight: bold;">SJSU</span>
      <div style="font-size: 14px;">BURSAR'S OFFICE</div>
    </div>
    <div style="text-align: right;">
      <h2 style="font-size: 18px; margin: 0;">How to View Payment Due Dates</h2>
      <div style="font-size: 12px;">One Washington Square, San José, CA <span data-field="zip_code">{{ zip_code }}</span></div>
    </div>
  </div>

  <div style="margin-top: 40px;">
    <ol style="line-height: 1.6;">
      <li>
        Go to <a href="#" style="color: #005a9c;">MySJSU</a> (<span data-field="my_sjsu_url">{{ my_sjsu_url }}</span>) and click the <span data-field="login_button_text">{{ login_button_text }}</span> button.
      </li>
      <li>
        Enter your User ID and Password and click the <span data-field="sign_in_button_text">{{ sign_in_button_text }}</span> button.
      </li>
      <li>
        From the Student Center page (your homepage), scroll down to Finances.
      </li>
      <li>
        Click the <span data-field="view_due_date_hyperlink">{{ view_due_date_hyperlink }}</span> hyperlink.
      </li>
    </ol>
  </div>

  <div style="display: flex; justify-content: space-between; margin-top: 40px;">
    <!-- Login Simulation Area -->
    <div style="width: 45%;">
      <div class="form-container">
        <div class="input-group">
          <label for="user_id">User ID:</label>
          <input type="text" id="user_id" value="">
        </div>
        <div class="input-group">
          <label for="password">Password:</label>
          <input type="password" id="password" value="">
        </div>
        <button class="button" style="background-color: #005a9c;">Sign In</button>
      </div>
    </div>

    <!-- Navigation/Summary Area -->
    <div style="width: 50%;">
      <div style="border: 1px solid #ccc; padding: 15px;">
        <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
          <div style="font-weight: bold;">My Account</div>
          <div style="font-weight: bold;">Account Summary</div>
        </div>
        <div style="margin-bottom: 15px;">
          <a href="#" style="color: #005a9c;">Account Inquiry</a> |
          <a href="#" style="color: #005a9c;">1098T Detail Inquiry</a> |
          <a href="#" style="color: #005a9c;">Payment Plan Inquiry</a>
        </div>
        <div style="text-align: center; margin-top: 20px;">
          <a href="#" style="color: #005a9c; font-weight: bold;">View Due Date</a>
        </div>
        <div style="margin-top: 20px; display: flex; justify-content: space-between;">
          <button class="button" style="background-color: #ccc;">PAY NOW</button>
          <button class="button" style="background-color: #ccc;">PAYMENT PLANS AND ACCOUNT SERVICES</button>
        </div>
        <div style="margin-top: 20px;">
          <label for="other_financial">other financial...</label>
          <select id="other_financial" style="padding: 5px;">
            <option>{{ other_financial_option }}</option>
          </select>
        </div>
      </div>
    </div>
  </div>

  <div style="margin-top: 40px;">
    <h3 style="font-size: 16px; font-weight: bold;">Charges Due</h3>
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
      <span style="font-size: 14px;">Summary</span>
      <span style="font-size: 14px;">activity</span>
      <span style="font-size: 14px;">charges due</span>
    </div>

    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th style="width: 50%;">Summary of Charges by Due Date</th>
            <th style="width: 20%;">Find | View All</th>
            <th style="width: 15%;">First</th>
            <th style="width: 15%;">Last</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td colspan="4" style="text-align: center; font-size: 12px;">
              <span data-field="due_date_range">{{ due_date_range }}</span> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
              <span data-field="due_amount_placeholder">{{ due_amount_placeholder }}</span> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
              <span data-field="running_total_placeholder">{{ running_total_placeholder }}</span>
            </td>
          </tr>
          {% for item in line_items %}
          <tr>
            <td><span data-field="line_items[{{ loop.index0 }}].description">{{ item.description }}</span></td>
            <td><span data-field="line_items[{{ loop.index0 }}].amount">{{ item.amount }}</span></td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  <div class="footer">
    <p>For additional assistance, visit <a href="#" style="color: #005a9c;">MySJSU Financial Information</a> (<span data-field="financial_info_url">{{ financial_info_url }}</span>)</p>
    <p style="margin-top: 10px;">Ph: <span data-field="phone_number_1">{{ phone_number_1 }}</span> | Fax: <span data-field="phone_number_2">{{ phone_number_2 }}</span></p>
    <p style="margin-top: 10px;">
      <span data-field="website_url">{{ website_url }}</span> |
      <span data-field="bursar_email">{{ bursar_email }}</span>
    </p>
    <p style="margin-top: 10px; text-align: right;">Page 1 of 1 | Last Updated: <span data-field="last_updated_date">{{ last_updated_date }}</span></p>
  </div>
</div>