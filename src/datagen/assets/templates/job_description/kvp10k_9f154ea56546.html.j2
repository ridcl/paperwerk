<!DOCTYPE html>
<html>
<head>
<title>Job Description Template</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 {
    font-family: "DejaVu Sans", "Liberation Sans", Arial, Helvetica, sans-serif;
  }
  .header-logo {
    text-align: center;
    margin-bottom: 30px;
  }
  .header-logo img {
    max-width: 200px;
    height: auto;
  }
  .section-title {
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
    font-family: "DejaVu Sans", "Liberation Sans", Arial, Helvetica, sans-serif;
  }
  .job-details-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  .job-details-table td {
    padding: 5px 0;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .job-details-table .label {
    font-weight: bold;
    width: 150px;
  }
  ul {
    padding-left: 20px;
    margin-top: 10px;
    margin-bottom: 10px;
  }
  li {
    margin-bottom: 5px;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .signature-area {
    margin-top: 80px;
    display: flex;
    justify-content: space-between;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .signature-line {
    border-bottom: 1px solid black;
    width: 40%;
    text-align: center;
  }
</style>
</head>
<body>

<div class="page">
  <div class="header-logo">
    <!-- Placeholder for Howard Payne University Logo -->
    <div style="font-size: 24px; font-weight: bold; font-family: 'DejaVu Sans', sans-serif;">HOWARD PAYNE UNIVERSITY</div>
  </div>

  <h1 style="text-align: center; font-family: 'DejaVu Sans', sans-serif; font-size: 24px;">POSITION ANNOUNCEMENT</h1>
  <h2 style="text-align: center; font-family: 'DejaVu Sans', sans-serif; font-size: 20px;">Facilities Department</h2>
  <h3 style="text-align: center; font-family: 'DejaVu Sans', sans-serif; font-size: 18px;">Brownwood, Texas</h3>

  <p style="font-family: 'DejaVu Serif', serif; font-size: 14px;">
    <span data-field="disclaimer_text">{{ disclaimer_text }}</span>
  </p>

  <div class="section-title">Job Title:</div>
  <table class="job-details-table">
    <tr>
      <td class="label">Job Title:</td>
      <td><span data-field="job_title">{{ job_title }}</span></td>
    </tr>
    <tr>
      <td class="label">Department:</td>
      <td><span data-field="department">{{ department }}</span></td>
    </tr>
    <tr>
      <td class="label">FLSA Status:</td>
      <td><span data-field="flsa_status">{{ flsa_status }}</span></td>
    </tr>
  </table>

  <div class="section-title">Expectation and Condition of Employment</div>
  <p style="font-family: 'DejaVu Serif', serif; font-size: 14px;">
    <span data-field="employment_expectation">{{ employment_expectation }}</span>
  </p>

  <div class="section-title">Mission Statement</div>
  <p style="font-family: 'DejaVu Serif', serif; font-size: 14px;">
    <span data-field="mission_statement">{{ mission_statement }}</span>
  </p>

  <div class="section-title">Core Values of Howard Payne University</div>
  <ul style="font-family: 'DejaVu Serif', serif; font-size: 14px;">
    <li><span data-field="core_value_1">{{ core_value_1 }}</span></li>
    <li><span data-field="core_value_2">{{ core_value_2 }}</span></li>
    <li><span data-field="core_value_3">{{ core_value_3 }}</span></li>
    <li><span data-field="core_value_4">{{ core_value_4 }}</span></li>
    <li><span data-field="core_value_5">{{ core_value_5 }}</span></li>
  </ul>

  <div class="section-title">Job Summary:</div>
  <p style="font-family: 'DejaVu Serif', serif; font-size: 14px;">
    <span data-field="job_summary">{{ job_summary }}</span>
  </p>

  <div class="section-title">Essential Duties and Responsibilities</div>
  <ol style="font-family: 'DejaVu Serif', serif; font-size: 14px;">
    <li><span data-field="duty_1">{{ duty_1 }}</span></li>
    <li><span data-field="duty_2">{{ duty_2 }}</span></li>
    <li><span data-field="duty_3">{{ duty_3 }}</span></li>
    <li><span data-field="duty_4">{{ duty_4 }}</span></li>
    <li><span data-field="duty_5">{{ duty_5 }}</span></li>
    <li><span data-field="duty_6">{{ duty_6 }}</span></li>
    <li><span data-field="duty_7">{{ duty_7 }}</span></li>
    <li><span data-field="duty_8">{{ duty_8 }}</span></li>
    <li><span data-field="duty_9">{{ duty_9 }}</span></li>
    <li><span data-field="duty_10">{{ duty_10 }}</span></li>
    <li><span data-field="duty_11">{{ duty_11 }}</span></li>
    <li><span data-field="duty_12">{{ duty_12 }}</span></li>
    <li><span data-field="duty_13">{{ duty_13 }}</span></li>
    <li><span data-field="duty_14">{{ duty_14 }}</span></li>
    <li><span data-field="duty_15">{{ duty_15 }}</span></li>
    <li><span data-field="duty_16">{{ duty_16 }}</span></li>
    <li><span data-field="duty_17">{{ duty_17 }}</span></li>
    <li><span data-field="duty_18">{{ duty_18 }}</span></li>
    <li><span data-field="duty_19">{{ duty_19 }}</span></li>
    <li><span data-field="duty_20">{{ duty_20 }}</span></li>
    <li><span data-field="duty_21">{{ duty_21 }}</span></li>
    <li><span data-field="duty_21b">{{ duty_21b }}</span></li>
    <li><span data-field="duty_22">{{ duty_22 }}</span></li>
    <li><span data-field="duty_23">{{ duty_23 }}</span></li>
    <li><span data-field="duty_23a">{{ duty_23a }}</span></li>
    <li><span data-field="duty_23b">{{ duty_23b }}</span></li>
    <li><span data-field="duty_23c">{{ duty_23c }}</span></li>
    <li><span data-field="duty_24">{{ duty_24 }}</span></li>
    <li><span data-field="duty_25">{{ duty_25 }}</span></li>
    <li><span data-field="duty_26">{{ duty_26 }}</span></li>
    <li><span data-field="duty_27">{{ duty_27 }}</span></li>
    <li><span data-field="duty_28">{{ duty_28 }}</span></li>
    <li><span data-field="duty_29">{{ duty_29 }}</span></li>
    <li><span data-field="duty_29a">{{ duty_29a }}</span></li>
    <li><span data-field="duty_29b">{{ duty_29b }}</span></li>
    <li><span data-field="duty_29c">{{ duty_29c }}</span></li>
    <li><span data-field="duty_30">{{ duty_30 }}</span></li>
    <li><span data-field="duty_31">{{ duty_31 }}</span></li>
    <li><span data-field="duty_32">{{ duty_32 }}</span></li>
    <li><span data-field="duty_33">{{ duty_33 }}</span></li>
  </ol>

  <div class="section-title">Supervisory Responsibilities</div>
  <p style="font-family: 'DejaVu Serif', serif; font-size: 14px;">This job has no supervisory responsibilities.</p>

  <div class="section-title">Required Competencies</div>
  <ol style="font-family: 'DejaVu Serif', serif; font-size: 14px;">
    <li><span data-field="competency_1">{{ competency_1 }}</span></li>
    <li><span data-field="competency_2">{{ competency_2 }}</span></li>
  </ol>

  <div class="section-title">Problem Solving</div>
  <ol style="font-family: 'DejaVu Serif', serif; font-size: 14px;">
    <li><span data-field="problem_solving_1">{{ problem_solving_1 }}</span></li>
    <li><span data-field="problem_solving_2">{{ problem_solving_2 }}</span></li>
    <li><span data-field="problem_solving_3">{{ problem_solving_3 }}</span></li>
    <li><span data-field="problem_solving_4">{{ problem_solving_4 }}</span></li>
    <li><span data-field="problem_solving_5">{{ problem_solving_5 }}</span></li>
    <li><span data-field="problem_solving_6">{{ problem_solving_6 }}</span></li>
    <li><span data-field="problem_solving_7">{{ problem_solving_7 }}</span></li>
    <li><span data-field="problem_solving_8">{{ problem_solving_8 }}</span></li>
    <li><span data-field="problem_solving_9">{{ problem_solving_9 }}</span></li>
    <li><span data-field="problem_solving_10">{{ problem_solving_10 }}</span></li>
    <li><span data-field="problem_solving_11">{{ problem_solving_11 }}</span></li>
    <li><span data-field="problem_solving_12">{{ problem_solving_12 }}</span></li>
    <li><span data-field="problem_solving_13">{{ problem_solving_13 }}</span></li>
    <li><span data-field="problem_solving_14">{{ problem_solving_14 }}</span></li>
  </ol>

  <div class="section-title">Qualifications</div>
  <p style="font-family: 'DejaVu Serif', serif; font-size: 14px;">
    <span data-field="qualifications_summary">{{ qualifications_summary }}</span>
  </p>

  <div class="section-title">Education and/or Experience</div>
  <p style="font-family: 'DejaVu Serif', serif; font-size: 14px;">
    <span data-field="education_experience">{{ education_experience }}</span>
  </p>

  <div class="section-title">Language Skills</div>
  <p style="font-family: 'DejaVu Serif', serif; font-size: 14px;">
    <span data-field="language_skills">{{ language_skills }}</span>
  </p>

  <div class="section-title">Math Skills</div>
  <p style="font-family: 'DejaVu Serif', serif; font-size: 14px;">
    <span data-field="math_skills">{{ math_skills }}</span>
  </p>

  <div class="section-title">Reasoning Ability</div>
  <p style="font-family: 'DejaVu Serif', serif; font-size: 14px;">
    <span data-field="reasoning_ability">{{ reasoning_ability }}</span>
  </p>

  <div class="section-title">Certificates and Licenses</div>
  <p style="font-family: 'DejaVu Serif', serif; font-size: 14px;">
    <span data-field="certifications_licenses">{{ certifications_licenses }}</span>
  </p>

  <div class="section-title">Physical Abilities</div>
  <p style="font-family: 'DejaVu Serif', serif; font-size: 14px;">
    <span data-field="physical_abilities">{{ physical_abilities }}</span>
  </p>

  <div class="section-title">Work Environment</div>
  <p style="font-family: 'DejaVu Serif', serif; font-size: 14px;">
    <span data-field="work_environment">{{ work_environment }}</span>
  </p>

  <p style="font-family: 'DejaVu Serif', serif; font-size: 14px; margin-top: 40px;">
    By my signature below, I confirm I have read, understand and can meet all of the expectations and physical requirements in this Job Description.
  </p>

  <div class="signature-area">
    <div>
      <div class="signature-line"></div>
      <div style="margin-top: 5px; font-family: 'DejaVu Serif', serif; font-size: 14px;">Signature</div>
    </div>
    <div>
      <div class="signature-line"></div>
      <div style="margin-top: 5px; font-family: 'DejaVu Serif', serif; font-size: 14px;">Date</div>
    </div>
  </div>
</div>

<div class="page">
  <!-- Placeholder for Page 2 Content if needed, though the source ends on page 6 -->
</div>

</body>
</html>