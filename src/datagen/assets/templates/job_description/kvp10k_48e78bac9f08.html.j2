<!DOCTYPE html>
<html>
<head>
<title>Placement Document</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  td {
    padding: 8px 0;
    vertical-align: top;
  }
  .header {
    font-size: 24pt;
    font-weight: bold;
    text-align: center;
    margin-bottom: 30px;
  }
  .section-title {
    font-size: 14pt;
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
  }
</style>
</head>
<body>
<div class="page">
  <div class="header">
    AMITY TECHNICAL PLACEMENT CENTRE
  </div>
  <table>
    <tr>
      <td style="width: 30%;">Company Name</td>
      <td style="width: 70%;"><span data-field="company_name">{{ company_name }}</span></td>
    </tr>
    <tr>
      <td>Registration Period Start Date</td>
      <td><span data-field="registration_period_start_date">{{ registration_period_start_date }}</span></td>
    </tr>
    <tr>
      <td>Registration Period End Date</td>
      <td><span data-field="registration_period_end_date">{{ registration_period_end_date }}</span></td>
    </tr>
    <tr>
      <td>About Company</td>
      <td><span data-field="about_company">{{ about_company }}</span></td>
    </tr>
    <tr>
      <td>Website</td>
      <td><span data-field="website">{{ website }}</span></td>
    </tr>
    <tr>
      <td>Date Of Campus</td>
      <td><span data-field="date_of_campus">{{ date_of_campus }}</span></td>
    </tr>
    <tr>
      <td>Venue</td>
      <td><span data-field="venue">{{ venue }}</span></td>
    </tr>
    <tr>
      <td>Joining</td>
      <td><span data-field="joining_date">{{ joining_date }}</span></td>
    </tr>
    <tr>
      <td>Job Title</td>
      <td><span data-field="job_title">{{ job_title }}</span></td>
    </tr>
    <tr>
      <td>Employment Type</td>
      <td><span data-field="employment_type">{{ employment_type }}</span></td>
    </tr>
    <tr>
      <td>Eligible Degree</td>
      <td><span data-field="eligible_degree">{{ eligible_degree }}</span></td>
    </tr>
    <tr>
      <td>Eligible Branches</td>
      <td><span data-field="eligible_branches">{{ eligible_branches }}</span></td>
    </tr>
    <tr>
      <td>Eligible Criteria</td>
      <td><span data-field="eligible_criteria">{{ eligible_criteria }}</span></td>
    </tr>
    <tr>
      <td>Roles & Responsibility</td>
      <td><span data-field="roles_and_responsibility">{{ roles_and_responsibility }}</span></td>
    </tr>
  </table>
</div>

<div class="page">
  <table>
    <tr>
      <td style="width: 30%;">Service Agreement, If Any</td>
      <td style="width: 70%;"><span data-field="service_agreement_if_any">{{ service_agreement_if_any }}</span></td>
    </tr>
    <tr>
      <td>Other Skill</td>
      <td><span data-field="other_skill">{{ other_skill }}</span></td>
    </tr>
    <tr>
      <td>Package</td>
      <td><span data-field="package">{{ package }}</span></td>
    </tr>
    <tr>
      <td>Location</td>
      <td><span data-field="location">{{ location }}</span></td>
    </tr>
    <tr>
      <td>Recruitment Process</td>
      <td><span data-field="recruitment_process">{{ recruitment_process }}</span></td>
    </tr>
    <tr>
      <td>How to Apply</td>
      <td><span data-field="how_to_apply">{{ how_to_apply }}</span></td>
    </tr>
    <tr>
      <td>Representative from ATPC(For any Guidance/ Query)</td>
      <td><span data-field="representative_from_atpc">{{ representative_from_atpc }}</span></td>
    </tr>
    <tr>
      <td></td>
      <td><a href="#" data-field="click_here_to_apply">{{ click_here_to_apply }}</a></td>
    </tr>
  </table>

  <div style="text-align: center; margin-top: 50px; font-size: 10pt;">
    Amity Technical Placement Centre<br>
    Room # G - 02, E-2 Ground Floor, Amity University Campus, Sector - 125, Noida, UP - 201313<br>
    Tel: <span data-field="tel">{{ tel }}</span> | Email Id: <span data-field="email">{{ email }}</span> | Website: <span data-field="website_footer">{{ website_footer }}</span>
  </div>
</div>
</body>
</html>