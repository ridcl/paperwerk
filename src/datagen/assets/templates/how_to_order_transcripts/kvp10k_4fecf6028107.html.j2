<!DOCTYPE html>
<html>
<head>
<title>Transcript Ordering Guide</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif; }
  .header-logo { margin-bottom: 20px; }
  .section-title { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
  .instruction { margin-bottom: 15px; line-height: 1.6; }
  .button {
    display: inline-block;
    padding: 10px 20px;
    margin-top: 10px;
    background-color: #0056b3;
    color: white;
    text-decoration: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
  }
  .form-group { margin-bottom: 15px; }
  .form-group label { display: block; margin-bottom: 5px; font-weight: bold; }
  .form-group input[type="text"], .form-group input[type="password"] {
    width: 100%;
    padding: 10px;
    box-sizing: border-box;
    border: 1px solid #ccc;
    font-family: inherit;
  }
  .tab-bar { display: flex; border-bottom: 1px solid #ccc; margin-bottom: 20px; }
  .tab-button { padding: 10px 15px; cursor: pointer; border: 1px solid transparent; border-bottom: none; background-color: #f1f1f1; margin-right: 5px; }
  .tab-button.active { background-color: white; border-color: #ccc; border-bottom: 1px solid white; }
  .content-box { border: 1px solid #ccc; padding: 20px; }
  .table-container { margin-top: 20px; }
  table { width: 100%; border-collapse: collapse; margin-top: 15px; }
  th, td { border: 1px solid #ddd; padding: 10px; text-align: left; }
  th { background-color: #f2f2f2; }
</style>
</head>
<body>

<div class="page">
  <div class="header-logo">
    <!-- Placeholder for University Logo -->
    <img src="placeholder_logo.png" alt="University Logo" style="height: 60px;">
  </div>
  <h1>How to Order Transcripts</h1>
  <p class="instruction">To order your transcripts, go to our website, <a href="http://{{ external_website_url }}">ce.fresno.edu</a>.</p>
  <p class="instruction">Sign into your account by clicking the <span data-field="sign_in_link_text">{{ sign_in_link_text }}</span> link.</p>
</div>

<div class="page">
  <div class="section-title">Accessing Account Options</div>
  <p class="instruction">Click the <span data-field="my_account_link_text">{{ my_account_link_text }}</span> link.</p>

  <!-- Mockup of the main navigation/dashboard -->
  <div style="border: 1px solid #ccc; padding: 20px; background-color: #f9f9f9;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <div style="font-weight: bold;">FRESNO PACIFIC Continuing Education</div>
      <div>
        <span class="tab-button">SEARCH</span>
        <span class="tab-button">CREATE ACCOUNT</span>
        <span class="tab-button active">SIGN IN</span>
        <span class="tab-button">MY CART</span>
      </div>
    </div>
    <div style="display: flex; justify-content: space-around; text-align: center; margin-bottom: 30px;">
      <div style="padding: 10px; border: 1px solid #ddd;">
        <span style="font-weight: bold;">INCREASE MY PAY</span>
        <p><span data-field="feature_description_1">{{ feature_description_1 }}</span></p>
      </div>
      <div style="padding: 10px; border: 1px solid #ddd;">
        <span style="font-weight: bold;">IMPROVE MY SKILLS</span>
        <p><span data-field="feature_description_2">{{ feature_description_2 }}</span></p>
      </div>
      <div style="padding: 10px; border: 1px solid #ddd;">
        <span style="font-weight: bold;">FIT MY SCHEDULE</span>
        <p><span data-field="feature_description_3">{{ feature_description_3 }}</span></p>
      </div>
    </div>
    <div style="text-align: center; padding: 20px; background-color: #e0f7fa;">
      <h2 style="font-size: 2em; margin: 0;">PROFESSIONAL DEVELOPMENT <br> HAPPENS HERE.</h2>
      <a href="#" class="button" style="margin-top: 20px;">VIEW ALL COURSES &raquo;</a>
    </div>
  </div>
</div>

<div class="page">
  <div class="section-title">Signing In</div>
  <p class="instruction">Enter your <span data-field="login_identifier">{{ login_identifier }}</span> and <span data-field="login_password">{{ login_password }}</span>, then click <span data-field="sign_in_button_text">{{ sign_in_button_text }}</span>.</p>
  <p class="instruction">Forgot your password? Click the <span data-field="reset_password_link">{{ reset_password_link }}</span> link.</p>

  <!-- Mockup of the Sign In Form -->
  <div style="border: 1px solid #ccc; padding: 20px; max-width: 400px; margin: 20px auto; background-color: white;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <div style="font-weight: bold;">FRESNO PACIFIC Continuing Education</div>
      <div>
        <span class="tab-button">SEARCH</span>
        <span class="tab-button">CREATE ACCOUNT</span>
        <span class="tab-button active">SIGN IN</span>
        <span class="tab-button">MY CART</span>
      </div>
    </div>
    <h3 style="text-align: center;">SIGN IN</h3>
    <form>
      <div class="form-group">
        <label for="email">Email *</label>
        <input type="text" id="email" name="email" value="{{ dummy_email }}">
      </div>
      <div class="form-group">
        <label for="password">Password *</label>
        <input type="password" id="password" name="password">
      </div>
      <button type="submit" class="button" style="width: 100%;">Sign In</button>
    </form>
    <p style="text-align: center; margin-top: 15px;"><a href="#">Reset Password</a></p>
  </div>
</div>

<div class="page">
  <div class="section-title">My Account Information</div>
  <p class="instruction">Find your <span data-field="student_id_label">{{ student_id_label }}</span> number. On the Statement of Account page, you will see your name and your 7-digit Student ID number. If the Student ID Number is shorter than 7 digits add a 0 to the beginning of the number to make it a 7-digit number.</p>

  <!-- Mockup of Statement of Account -->
  <div style="border: 1px solid #ccc; padding: 20px; background-color: white;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <div style="font-weight: bold;">FRESNO PACIFIC Continuing Education</div>
      <div>
        <span class="tab-button">SEARCH</span>
        <span class="tab-button">MY ACCOUNT</span>
        <span class="tab-button">SIGN OUT</span>
        <span class="tab-button">MY CART</span>
      </div>
    </div>
    <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
      <div style="font-weight: bold;">HOME &raquo; MY ACCOUNT &raquo; STATEMENT OF ACCOUNT</div>
      <div style="font-size: 0.9em;">FRESNO PACIFIC University<br>{{ university_address }}</div>
    </div>

    <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
      <div style="font-weight: bold;">STATEMENT OF ACCOUNT</div>
      <div style="font-size: 0.9em;">Continuing Education</div>
    </div>

    <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
      <div style="font-weight: bold;">Summary</div>
      <div style="font-size: 0.9em;">Student ID: <span data-field="student_id">{{ student_id }}</span> | Tax ID: <span data-field="tax_id">{{ tax_id }}</span> | Date: <span data-field="statement_date">{{ statement_date }}</span></div>
    </div>

    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>DATE</th>
            <th>DESCRIPTION</th>
            <th>CHARGES</th>
            <th>CREDITS</th>
            <th>PAYMENTS</th>
            <th>BALANCE</th>
          </tr>
        </thead>
        <tbody>
          {% for item in statement_items %}
          <tr>
            <td>{{ item.date }}</td>
            <td><span data-field="statement_items[{{ loop.index0 }}].description">{{ item.description }}</span></td>
            <td>{{ item.charges }}</td>
            <td>{{ item.credits }}</td>
            <td>{{ item.payments }}</td>
            <td>{{ item.balance }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <div style="text-align: right; margin-top: 20px;">
      <button class="button" style="background-color: #28a745;">Download PDF</button>
    </div>
  </div>
</div>

<div class="page">
  <div class="section-title">Ordering Transcripts</div>
  <p class="instruction">Click the <span data-field="order_transcripts_link">{{ order_transcripts_link }}</span> link to proceed to the Transcript Ordering Center (Student Clearing House third-party website).</p>

  <!-- Mockup of the Transcript Order Form -->
  <div style="border: 1px solid #ccc; padding: 20px; max-width: 500px; margin: 20px auto; background-color: white;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <div style="font-weight: bold;">FRESNO PACIFIC Continuing Education</div>
      <div>
        <span class="tab-button">SEARCH</span>
        <span class="tab-button">MY ACCOUNT</span>
        <span class="tab-button">SIGN OUT</span>
        <span class="tab-button">MY CART</span>
      </div>
    </div>
    <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
      <div style="font-weight: bold;">HOME &raquo; MY ACCOUNT</div>
      <div style="font-size: 0.9em;">Personal Information</div>
    </div>

    <h3 style="text-align: center;">PERSONAL INFORMATION</h3>
    <form>
      <div class="form-group">
        <label for="first_name">First Name *</label>
        <input type="text" id="first_name" name="first_name" value="{{ first_name }}">
      </div>
      <div class="form-group">
        <label for="last_name">Last Name *</label>
        <input type="text" id="last_name" name="last_name" value="{{ last_name }}">
      </div>
      <div class="form-group">
        <label for="other_last_name">Other Last Name(s)</label>
        <input type="text" id="other_last_name" name="other_last_name">
      </div>
      <div class="form-group">
        <label for="nickname">Nickname(s)</label>
        <input type="text" id="nickname" name="nickname">
      </div>
      <p style="font-size: 0.8em; color: #666;">CLARIFICATION IS NEEDED FOR TRANSCRIPT PURPOSES.</p>
    </form>
  </div>
</div>

<div class="page">
  <div class="section-title">Transcript Ordering Center</div>
  <p class="instruction">Enter <span data-field="institution_name">{{ institution_name }}</span> in the <span data-field="search_field_label">{{ search_field_label }}</span> field. Click CONTINUE to order your transcript.</p>

  <!-- Mockup of the Transcript Ordering Center -->
  <div style="border: 1px solid #ccc; padding: 30px; max-width: 600px; margin: 20px auto; background-color: white;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <div style="font-weight: bold;">FRESNO PACIFIC Continuing Education</div>
      <div>
        <span class="tab-button">SEARCH</span>
        <span class="tab-button">MY ACCOUNT</span>
        <span class="tab-button">SIGN OUT</span>
        <span class="tab-button">MY CART</span>
      </div>
    </div>
    <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
      <div style="font-weight: bold;">HOME &raquo; Transcript Ordering Center</div>
      <div style="font-size: 0.9em;">Transcript Clearinghouse</div>
    </div>

    <h3 style="text-align: center;">Transcript Ordering Center</h3>
    <form>
      <div class="form-group">
        <label for="school_name">School Name *</label>
        <input type="text" id="school_name" name="school_name" value="{{ institution_name }}">
      </div>
      <div class="form-group">
        <label for="search_query">Search Query</label>
        <input type="text" id="search_query" name="search_query" placeholder="Advanced Keyword Search">
      </div>
      <button type="submit" class="button" style="width: 100%; margin-top: 20px;">CONTINUE &raquo;</button>
    </form>
  </div>
</div>

</body>
</html>