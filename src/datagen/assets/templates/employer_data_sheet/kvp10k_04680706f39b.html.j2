<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  /* Basic styling to mimic document structure */
  h1, h2, h3 {
    font-weight: bold;
  }
  .form-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 15px;
    line-height: 1.5;
  }
  .form-group {
    display: flex;
    align-items: center;
    margin-bottom: 10px;
  }
  .checkbox-group label {
    margin-right: 15px;
    font-weight: normal;
  }
  .signature-area {
    margin-top: 80px;
    display: flex;
    justify-content: space-between;
    width: 100%;
  }
  .signature-line {
    border-top: 1px solid #000;
    padding-top: 5px;
    width: 45%;
    text-align: center;
  }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px;">
    <div style="display: flex; align-items: center;">
      <div style="font-size: 40px; margin-right: 20px;">&#9632;</div> <!-- Placeholder for University Logo -->
      <div>
        <h1 style="margin: 0;">Employer Data Sheet</h1>
        <h2 style="margin: 5px 0 0 0;">Computer and Information Sciences & Informatics</h2>
        <p style="margin: 5px 0 0 0;">Internship Program</p>
        <p style="margin: 5px 0 0 0;">Indiana University South Bend</p>
      </div>
    </div>
    <div style="text-align: right; font-size: 12px;">
      <p style="margin: 0;">cs.iub.edu</p>
      <p style="margin: 0;">informatics.iub.edu</p>
      <p style="margin: 5px 0 0 0;">Questions?</p>
      <p style="margin: 0;">574.520.5521 or <span data-field="contact.email">{{ contact.email }}</span></p>
    </div>
  </div>

  <p style="margin-bottom: 20px;">Employers planning to hire our students as interns, please complete this form & submit it to the Internship Coordinator</p>
  <p style="margin-bottom: 30px;"><strong>Company Name:</strong> <span data-field="company_name">{{ company_name }}</span></p>

  <div class="form-row">
    <div style="width: 45%;">
      <p>Contact Person: <span data-field="contact.name">{{ contact.name }}</span></p>
      <p>Address: <span data-field="contact.address">{{ contact.address }}</span></p>
      <p>City: <span data-field="contact.city">{{ contact.city }}</span></p>
      <p>URL: <span data-field="contact.url">{{ contact.url }}</span></p>
      <p>Other (Databases, CASE tools, etc.): <span data-field="contact.other_tools">{{ contact.other_tools }}</span></p>
    </div>
    <div style="width: 45%; text-align: right;">
      <p>Title: <span data-field="contact.title">{{ contact.title }}</span></p>
      <p>Tel: <span data-field="contact.phone">{{ contact.phone }}</span></p>
      <p>State: <span data-field="contact.state">{{ contact.state }}</span></p>
      <p>Fax: <span data-field="contact.fax">{{ contact.fax }}</span></p>
      <p>E-mail: <span data-field="contact.email">{{ contact.email }}</span></p>
    </div>
  </div>

  <div class="form-row">
    <div style="width: 45%;">
      <p>Number of Full-time Positions Requested: <span data-field="positions_full_time">{{ positions_full_time }}</span></p>
      <p>Starting Date: <span data-field="start_date">{{ start_date }}</span></p>
    </div>
    <div style="width: 45%;">
      <p>Number of Interns Requested: <span data-field="positions_interns">{{ positions_interns }}</span></p>
      <p>Ending Date: <span data-field="end_date">{{ end_date }}</span></p>
    </div>
  </div>

  <h3 style="margin-top: 30px;">Students should possess the following skills and knowledge:</h3>

  <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 20px;">
    <!-- Programming -->
    <div style="border: 1px solid #ccc; padding: 15px;">
      <h4 style="margin-top: 0;">Programming</h4>
      <div class="checkbox-group">
        <label><input type="checkbox"> Visual Basic</label>
        <label><input type="checkbox"> C++</label>
        <label><input type="checkbox"> Java</label>
        <label><input type="checkbox"> C#</label>
        <label><input type="checkbox"> Other: <span data-field="skills_programming_other">{{ skills_programming_other }}</span></label>
      </div>
    </div>

    <!-- Database -->
    <div style="border: 1px solid #ccc; padding: 15px;">
      <h4 style="margin-top: 0;">Database</h4>
      <div class="checkbox-group">
        <label><input type="checkbox"> Basic SQL</label>
        <label><input type="checkbox"> Advanced SQL</label>
        <label><input type="checkbox"> MySQL</label>
        <label><input type="checkbox"> Ms-SQL</label>
        <label><input type="checkbox"> Oracle</label>
        <label><input type="checkbox"> Other: <span data-field="skills_database_other">{{ skills_database_other }}</span></label>
      </div>
    </div>

    <!-- Web Technologies -->
    <div style="border: 1px solid #ccc; padding: 15px;">
      <h4 style="margin-top: 0;">Web Technologies</h4>
      <div class="checkbox-group">
        <label><input type="checkbox"> HTML</label>
        <label><input type="checkbox"> CSS, Frameworks</label>
        <label><input type="checkbox"> JavaScript</label>
        <label><input type="checkbox"> PHP</label>
        <label><input type="checkbox"> Node.js, Angular.js</label>
        <label><input type="checkbox"> Other: <span data-field="skills_web_other">{{ skills_web_other }}</span></label>
      </div>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 20px;">
    <!-- Courses -->
    <div style="border: 1px solid #ccc; padding: 15px;">
      <h4 style="margin-top: 0;">Courses</h4>
      <div class="checkbox-group">
        <label><input type="checkbox"> Applied Data Mining</label>
        <label><input type="checkbox"> Applied Deep Learning</label>
        <label><input type="checkbox"> Artificial Intelligence</label>
        <label><input type="checkbox"> Computer Graphics</label>
        <label><input type="checkbox"> Computer Networks</label>
        <label><input type="checkbox"> Computer Security</label>
        <label><input type="checkbox"> Databases</label>
        <label><input type="checkbox"> Game Programming</label>
        <label><input type="checkbox"> Mobile App Development</label>
        <label><input type="checkbox"> Parallel and Distributed Computing</label>
        <label><input type="checkbox"> Software Design Patterns using Java</label>
        <label><input type="checkbox"> Software Engineering</label>
        <label><input type="checkbox"> Web Programming</label>
      </div>
    </div>

    <!-- Other -->
    <div style="border: 1px solid #ccc; padding: 15px;">
      <h4 style="margin-top: 0;">Other (Databases, CASE, etc.)</h4>
      <div class="checkbox-group">
        <label><input type="checkbox"> Please Specify: <span data-field="skills_other_specify">{{ skills_other_specify }}</span></label>
      </div>
    </div>
  </div>

  <div style="margin-top: 50px;">
    <p>Position Description URL: <span data-field="position_description_url">{{ position_description_url }}</span></p>
    <p>Position Description: <span data-field="position_description_text">{{ position_description_text }}</span></p>
  </div>

  <div class="signature-area">
    <div class="signature-line">
      Signature (type in name if submitting digitally)
    </div>
    <div class="signature-line">
      Date
    </div>
  </div>

  <div style="text-align: center; margin-top: 80px;">
    <div style="font-size: 30px; margin-bottom: 10px;">&#9632;</div> <!-- Placeholder for University Logo -->
    <h2 style="margin: 0;">INDIANA UNIVERSITY SOUTH BEND</h2>
    <p style="margin: 5px 0 0 0; font-style: italic;">FULFILLING the PROMISE</p>
  </div>
</div>