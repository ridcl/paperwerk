<!DOCTYPE html>
<html>
<head>
    <title>Plan de Estudio Template</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 { font-weight: bold; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        td, th { padding: 8px; text-align: left; border-bottom: 1px solid #ccc; }
        .header-title { font-size: 24pt; font-weight: bold; margin-bottom: 10px; }
        .subtitle { font-size: 14pt; margin-bottom: 30px; }
        .section-title { font-size: 16pt; font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
        .footer-info { font-size: 10pt; margin-top: 50px; text-align: center; }
    </style>
</head>
<body>
    <div class="page">
        <div style="text-align: center; margin-bottom: 50px;">
            <span style="font-size: 12pt;">Facultad de Ciencias Marinas y Tecnológicas</span>
        </div>
        <div style="text-align: center; position: relative; height: 600px;">
            <!-- Placeholder for image/visual layout -->
            <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: #333; color: white; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center;">
                <h1 style="font-size: 48pt; margin-bottom: 20px;">Plan de Estudio</h1>
                <div style="margin-top: 50px;">
                    <h2 style="font-size: 28pt;">Licenciatura en Ingeniería en Ciencias Náuticas y Administración con Énfasis en Transporte Marítima</h2>
                    <p style="font-size: 14pt; margin-top: 20px;">CTDA-151-2019 del <span data-field="date">{{ date }}</span></p>
                </div>
            </div>
        </div>
        <div style="text-align: center; margin-top: 40px;">
            <!-- Placeholder for University Logo -->
            <img src="placeholder_logo.png" alt="University Logo" style="width: 150px; height: auto;">
        </div>
    </div>

