<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; }
  h1, h2, h3 { text-align: center; }
  .header-logo { text-align: center; margin-bottom: 20px; }
  .content-section { margin-top: 30px; }
  .signature-line { margin-top: 60px; margin-bottom: 10px; }
</style>

<div class="page">
  <div class="header-logo">
    <!-- Placeholder for University Logo -->
    <div style="font-size: 40px; margin-bottom: 5px;">&#9889;</div>
    <div style="font-size: 14px; letter-spacing: 2px;">UNIVERSITY OF</div>
    <div style="font-size: 24px; font-weight: bold;">SOUTH CAROLINA</div>
  </div>

  <div style="text-align: center; margin-bottom: 40px;">
    <div style="font-size: 16px; font-weight: bold;">Division of Human Resources</div>
    <div style="font-size: 18px; font-weight: bold;">Dual Career Employment Services</div>
  </div>

  <div style="text-align: center; margin-bottom: 30px;">
    <div style="font-size: 14px;">Authorization for Release of Contact Information</div>
  </div>

  <div class="content-section">
    <p>
      I, <span data-field="full_name">{{ full_name }}</span>, do hereby authorize the Division of Human Resources' Dual Career Employment Services to disclose my name, address, and phone number to potential employers and other participants in this program for the purpose of assisting me during my search for employment in South Carolina, especially in the Columbia area. I understand that I may withdraw this consent at any time by notifying USC's Dual Career Employment Services.
    </p>
  </div>

  <div class="signature-line" style="display: flex; justify-content: space-between; margin-top: 80px;">
    <div>
      <div style="border-bottom: 1px solid black; width: 200px;" data-field="field_1">{{ field_1 }}</div>
      <div style="margin-top: 5px;">(Signature)</div>
    </div>
    <div>
      <div style="border-bottom: 1px solid black; width: 200px;" data-field="field_2">{{ field_2 }}</div>
      <div style="margin-top: 5px;">(Date)</div>
    </div>
  </div>
</div>

<div class="page">
  <div style="text-align: center; margin-bottom: 30px;">
    <div style="font-weight: bold;">Return signed and dated release form:</div>
  </div>

  <div style="margin-top: 40px; font-size: 14px;">
    Fax: <span data-field="contact.fax">{{ contact.fax }}</span><br>
    Mail: Dual Career Employment Services<br>
    <span data-field="contact.street_address">{{ contact.street_address }}</span><br>
    <span data-field="contact.city_state_zip">{{ contact.city_state_zip }}</span>
  </div>
</div>