<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  /* Basic styling to mimic document structure */
  h1, h2, h3 {
    text-align: center;
    margin-top: 0;
  }
  .header-info {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 40px;
  }
  .form-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 20px;
    line-height: 1.5;
  }
  .form-row > div {
    width: 48%;
  }
  .signature-line {
    margin-top: 80px;
    display: flex;
    justify-content: space-between;
    width: 100%;
  }
  .signature-line div {
    width: 45%;
  }
  .divider {
    border-top: 1px solid #000;
    width: 100%;
    margin-top: 5px;
    margin-bottom: 20px;
  }
</style>

<div class="page">
  <div class="header-info">
    <div>
      <!-- Placeholder for Logo/Institution Name -->
      <h1 style="font-size: 30px; text-align: center;">DAVIDSON COLLEGE</h1>
    </div>
    <div style="text-align: right;">
      <span data-field="updated_date">{{ updated_date }}</span>
    </div>
  </div>

  <h2 style="text-align: center; margin-bottom: 40px;">Authorization to Check Motor Vehicle Records</h2>
  <h3 style="text-align: center; margin-top: 0;">Consent and Disclosure</h3>

  <!-- Applicant Information Section -->
  <div class="form-row">
    <div>
      <label for="first_name">APPLICANT'S FIRST NAME</label>
      <div class="divider"></div>
      <span data-field="full_name">{{ full_name }}</span>
    </div>
    <div>
      <label for="last_name">LAST NAME</label>
      <div class="divider"></div>
      <span data-field="full_name">{{ full_name }}</span>
    </div>
  </div>

  <div class="form-row">
    <div>
      <label for="email">EMAIL ADDRESS</label>
      <div class="divider"></div>
      <span data-field="email_address">{{ email_address }}</span>
    </div>
    <div>
      <label for="college_id">COLLEGE ID (#800)</label>
      <div class="divider"></div>
      <span data-field="college_id">{{ college_id }}</span>
    </div>
  </div>

  <div class="form-row">
    <div>
      <label for="dept_club">DEPARTMENT/CLUB/ORGANIZATION</label>
      <div class="divider"></div>
      <span data-field="department_club">{{ department_club }}</span>
    </div>
    <div>
      <label for="schedule_date">WHEN ARE YOU SCHEDULED TO DRIVE?</label>
      <div class="divider"></div>
      <span data-field="schedule_date">{{ schedule_date }}</span>
    </div>
  </div>

  <div class="form-row">
    <div>
      <label for="student_status">STUDENT/STAFF/FACULTY (CIRCLE ONE)</label>
      <div class="divider"></div>
      <span data-field="student_status">{{ student_status }}</span>
    </div>
    <div>
      <label for="class_of">IF STUDENT, CLASS OF</label>
      <div class="divider"></div>
      <span data-field="class_of">{{ class_of }}</span>
    </div>
  </div>

  <!-- Background Information Section -->
  <div style="margin-top: 40px;">
    <h3 style="font-weight: bold;">Background Information</h3>
    <p>Have you been convicted of the following (including pleas of nolo Contendere)?</p>

    <div style="margin-top: 15px;">
      <p>Three moving violations in the past three years:</p>
      <label><input type="checkbox"> Yes</label>
      <label><input type="checkbox"> No</label>
    </div>

    <div style="margin-top: 15px;">
      <p>Speeding 15 miles over the speed limit:</p>
      <label><input type="checkbox"> Yes</label>
      <label><input type="checkbox"> No</label>
    </div>

    <div style="margin-top: 15px;">
      <p>A DUI or DWI:</p>
      <label><input type="checkbox"> Yes</label>
      <label><input type="checkbox"> No</label>
    </div>
  </div>

  <!-- Authorization Statement -->
  <div style="margin-top: 40px; padding: 20px; border: 1px solid #ccc;">
    <p>I authorize investigation of my driving record and understand that false information or documentation, or a failure to disclose relevant information may be grounds for rejection. I understand that minor traffic violations will not, in and of themselves, be grounds for rejecting my authorization to drive College vehicles.</p>
  </div>

  <!-- Signature Section -->
  <div class="signature-line">
    <div>
      <label>Applicant Signature</label>
      <div class="divider"></div>
      <span data-field="applicant_signature">{{ applicant_signature }}</span>
    </div>
    <div>
      <label>Date</label>
      <div class="divider"></div>
      <span data-field="date_signed">{{ date_signed }}</span>
    </div>
  </div>
</div>