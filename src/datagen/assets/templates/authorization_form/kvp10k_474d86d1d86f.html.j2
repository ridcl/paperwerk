<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; /* Using serif fonts as a base */
  }
  .page:last-child {
    page-break-after: auto;
  }
  /* Basic styling to mimic document structure */
  .header-logo {
    display: flex;
    align-items: center;
    margin-bottom: 20px;
  }
  .logo-image {
    width: 80px; /* Placeholder size */
    height: auto;
    margin-right: 15px;
  }
  .university-name {
    font-size: 24pt;
    font-weight: bold;
    line-height: 1.1;
  }
  .division-info {
    text-align: right;
    font-size: 10pt;
    margin-top: 50px;
  }
  .form-section {
    margin-bottom: 30px;
  }
  .form-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 20px;
    font-size: 11pt;
  }
  .form-row > div {
    width: 48%;
  }
  .line-input {
    border-bottom: 1px solid black;
    display: inline-block;
    min-width: 200px; /* Adjust as needed */
    margin-top: 5px;
  }
  .signature-block {
    margin-top: 60px;
    display: flex;
    justify-content: space-between;
    font-size: 11pt;
  }
  .signature-line {
    border-bottom: 1px solid black;
    width: 30%;
    margin-top: 5px;
  }
</style>

<div class="page">
  <div class="header-logo">
    <!-- Placeholder for University Seal/Logo -->
    <div class="logo-image"></div>
    <div class="university-name">
      UNIVERSITY OF ARKANSAS
    </div>
  </div>

  <div class="division-info">
    Division of Student Affairs<br>
    Center for Educational Access
  </div>

  <div class="form-section">
    <h2 style="font-size: 14pt; margin-bottom: 10px;">Authorization to Release/Obtain Confidential Information</h2>
    <p style="font-weight: bold; margin-bottom: 30px;">Confidential Information</p>

    <div class="form-row">
      <div>
        NAME: <span class="line-input">&nbsp;</span>
      </div>
      <div>
        DATE: <span class="line-input">&nbsp;</span>
      </div>
    </div>

    <div class="form-row">
      <div>
        DATE OF BIRTH: <span class="line-input">&nbsp;</span>
      </div>
      <div>
        STUDENT ID #: <span class="line-input">&nbsp;</span>
      </div>
    </div>

    <div style="margin-top: 40px;">
      <p>I hereby authorize the Center for Educational Access to release confidential educational information and/or other records to:</p>
      <div style="height: 50px; border-bottom: 1px solid black; margin-top: 10px;" data-field="nbsp">{{ nbsp }}</div>
    </div>

    <div style="margin-top: 40px;">
      <p>I hereby authorize the University of Arkansas Center for Educational Access to obtain confidential information and/or other records including medical and/or psychological testing, evaluation and treatment concerning the above named individual from:</p>
      <div style="height: 50px; border-bottom: 1px solid black; margin-top: 10px;" data-field="field_1">{{ field_1 }}</div>
    </div>

    <div style="margin-top: 50px;">
      <p>This authorization expires 60 days from the date it is signed. I understand that I may revoke this authorization, in writing, at any time prior to the release of the information specified above.</p>
    </div>
  </div>

  <div class="signature-block">
    <div>
      Signature:
      <div class="signature-line">&nbsp;</div>
    </div>
    <div>
      Witness:
      <div class="signature-line">&nbsp;</div>
    </div>
    <div>
      Date:
      <div class="signature-line">&nbsp;</div>
    </div>
  </div>

  <div style="margin-top: 80px; font-size: 9pt; text-align: center;">
    209 Arkansas Union • Fayetteville, AR 72701 • Voice: {{ contact_phone }} • Fax: {{ fax_number }}<br>
    TDD/TTY: {{ tdd_tty }} • ada@uark.edu • http://cea.uark.edu/
    <br>
    The University of Arkansas is an equal opportunity/affirmative action institution
  </div>
</div>