<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1 { text-align: center; font-size: 18pt; margin-bottom: 30px; }
  .header-info { display: flex; justify-content: space-between; margin-bottom: 40px; }
  .header-info div { width: 45%; }
  .form-row { display: flex; margin-bottom: 15px; align-items: center; }
  .form-row > div { flex: 1; }
  .form-row label { display: block; font-weight: bold; margin-bottom: 5px; }
  .form-row input[type="text"], .form-row select { width: 100%; padding: 5px; border-bottom: 1px solid #000; box-sizing: border-box; }
  .section-title { font-weight: bold; margin-top: 25px; margin-bottom: 10px; }
  .checkbox-group label { font-weight: normal; margin-right: 15px; display: inline-block; }
  .signature-block { margin-top: 50px; display: flex; justify-content: space-between; }
  .signature-line { width: 40%; border-top: 1px solid #000; padding-top: 5px; text-align: center; }
</style>

<div class="page">
  <h1>AUTHORIZATION TO RELEASE MEDICAL INFORMATION</h1>

  <div class="header-info">
    <div>
      <p>PATIENT NAME (Please print):</p>
      <div class="form-row">
        <div><label>Last Name:</label><input type="text" value="{{ patient_last_name }}"></div>
        <div><label>First Name:</label><input type="text" value="{{ patient_first_name }}"></div>
        <div><label>MI:</label><input type="text" value="{{ patient_mi }}"></div>
        <div><label>Date of Birth:</label><input type="text" value="{{ patient_dob }}"></div>
      </div>
      <p>Address</p>
      <div class="form-row">
        <div><label>9-digit WIU Student ID #:</label><input type="text" value="{{ student_id }}"></div>
        <div><label>Local Phone:</label><input type="text" value="{{ local_phone }}"></div>
      </div>
    </div>
    <div>
      <p>Beu Health Center</p>
      <p>1 University Circle, WIU</p>
      <p>Macomb, IL 61455</p>
      <p>Phone (309) 298-1888</p>
      <p>FAX (309) 298-2188</p>
    </div>
  </div>

  <div class="section-title">RELEASE FROM:</div>
  <div class="form-row">
    <div>
      <label><input type="checkbox" data-field="release_from_beu_health_center" value="{{ release_from_beu_health_center }}">{{ release_from_beu_health_center }}</label> Beu Health Center
    </div>
  </div>

  <div class="section-title">RELEASE TO:</div>
  <div class="form-row">
    <div>
      <label><input type="checkbox" data-field="release_to_beu_health_center" value="{{ release_to_beu_health_center }}">{{ release_to_beu_health_center }}</label> Beu Health Center
    </div>
  </div>

  <div class="form-row" style="margin-top: 20px;">
    <div style="flex: 1;">
      <label>Name:</label>
      <input type="text" value="{{ name_from }}">
    </div>
    <div style="flex: 1;">
      <label>Name:</label>
      <input type="text" value="{{ name_to }}">
    </div>
  </div>

  <div class="form-row" style="margin-top: 15px;">
    <div style="flex: 1;">
      <label>Address</label>
      <input type="text" value="{{ address_from }}">
    </div>
    <div style="flex: 1;">
      <label>Address</label>
      <input type="text" value="{{ address_to }}">
    </div>
  </div>

  <div class="form-row" style="margin-top: 15px;">
    <div style="flex: 1;">
      <label>City</label>
      <input type="text" value="{{ city_from }}">
    </div>
    <div style="flex: 1;">
      <label>City</label>
      <input type="text" value="{{ city_to }}">
    </div>
  </div>

  <div class="form-row" style="margin-top: 15px;">
    <div style="flex: 1;">
      <label>State</label>
      <input type="text" value="{{ state_from }}">
    </div>
    <div style="flex: 1;">
      <label>State</label>
      <input type="text" value="{{ state_to }}">
    </div>
  </div>

  <div class="form-row" style="margin-top: 15px;">
    <div style="flex: 1;">
      <label>Zip</label>
      <input type="text" value="{{ zip_from }}">
    </div>
    <div style="flex: 1;">
      <label>Zip</label>
      <input type="text" value="{{ zip_to }}">
    </div>
  </div>

  <div class="form-row" style="margin-top: 15px;">
    <div style="flex: 1;">
      <label>FAX</label>
      <input type="text" value="{{ fax_from }}">
    </div>
    <div style="flex: 1;">
      <label>FAX</label>
      <input type="text" value="{{ fax_to }}">
    </div>
  </div>

  <div class="section-title">PURPOSE:</div>
  <div class="checkbox-group" style="margin-bottom: 20px;">
    <label><input type="checkbox" data-field="purpose_patient_request" value="{{ purpose_patient_request }}">{{ purpose_patient_request }}</label> Patient's Request
    <label><input type="checkbox" data-field="purpose_continuing_treatment" value="{{ purpose_continuing_treatment }}">{{ purpose_continuing_treatment }}</label> Continuing Treatment
    <label><input type="checkbox" data-field="purpose_legal" value="{{ purpose_legal }}">{{ purpose_legal }}</label> Legal
    <label><input type="checkbox" data-field="purpose_insurance" value="{{ purpose_insurance }}">{{ purpose_insurance }}</label> Insurance
    <label><input type="checkbox" data-field="purpose_other" value="{{ purpose_other }}">{{ purpose_other }}</label> Other: <input type="text" value="{{ purpose_other_details }}">
  </div>

  <div class="section-title">DATES OF RECORDS TO BE RELEASED:</div>
  <div class="form-row">
    <div style="flex: 1;">
      <label>From:</label>
      <input type="text" value="{{ date_from }}">
    </div>
    <div style="flex: 1;">
      <label>To:</label>
      <input type="text" value="{{ date_to }}">
    </div>
  </div>

  <div class="section-title">SPECIFY RECORDS TO BE RELEASED:</div>
  <div class="checkbox-group" style="margin-bottom: 20px;">
    <label><input type="checkbox" data-field="record_all_ergy_records" value="{{ record_all_ergy_records }}">{{ record_all_ergy_records }}</label> Allergy Records
    <label><input type="checkbox" data-field="record_x_ray" value="{{ record_x_ray }}">{{ record_x_ray }}</label> X-ray report
    <label><input type="checkbox" data-field="record_physical_exam" value="{{ record_physical_exam }}">{{ record_physical_exam }}</label> Physical Exam
    <label><input type="checkbox" data-field="record_laboratory_results" value="{{ record_laboratory_results }}">{{ record_laboratory_results }}</label> Laboratory Results
    <label><input type="checkbox" data-field="record_immunization_records" value="{{ record_immunization_records }}">{{ record_immunization_records }}</label> Immunization records
    <label><input type="checkbox" data-field="record_tb_tests" value="{{ record_tb_tests }}">{{ record_tb_tests }}</label> TB tests
    <label><input type="checkbox" data-field="record_clinic_notes" value="{{ record_clinic_notes }}">{{ record_clinic_notes }}</label> Clinic Notes
    <label><input type="checkbox" data-field="record_other_specify" value="{{ record_other_specify }}">{{ record_other_specify }}</label> Other (Specify): <input type="text" value="{{ record_other_details }}">
  </div>

  <p style="font-size: 10pt; margin-bottom: 20px;">
    <span data-field="disclaimer_text">{{ disclaimer_text }}</span>
  </p>

  <p style="font-size: 10pt; margin-bottom: 20px;">
    <span data-field="medical_info_description">{{ medical_info_description }}</span>
    <br>
    <span data-field="hiv_aid_description">{{ hiv_aid_description }}</span>
    <br>
    <span data-field="mental_health_description">{{ mental_health_description }}</span>
  </p>

  <p style="font-size: 10pt; margin-bottom: 20px;">
    <span data-field="consent_statement">{{ consent_statement }}</span>
    <br>
    <span data-field="revocation_statement">{{ revocation_statement }}</span>
    <br>
    <span data-field="legal_acknowledgement">{{ legal_acknowledgement }}</span>
    <br>
    <span data-field="no_calendar_date_statement">{{ no_calendar_date_statement }}</span>
  </p>

  <div class="section-title">NOTICE TO PATIENT:</div>
  <p style="font-size: 10pt; margin-bottom: 20px;">
    <span data-field="patient_notice_text">{{ patient_notice_text }}</span>
  </p>

  <p style="font-size: 10pt; margin-bottom: 20px;">
    <span data-field="waiver_statement">{{ waiver_statement }}</span>
  </p>

  <div class="signature-block">
    <div style="width: 50%;">
      <p>Signature of patient or authorized legal guardian</p>
      <div class="signature-line"></div>
      <p style="margin-top: 5px;">Date</p>
    </div>
    <div style="width: 50%;">
      <p>Date prepared:</p>
      <div class="signature-line" style="width: 100%;"></div>
      <p style="margin-top: 5px;">Date mailed/faxed:</p>
      <div class="signature-line" style="width: 100%;"></div>
      <p style="margin-top: 5px;">Date given to student:</p>
      <div class="signature-line" style="width: 100%;"></div>
    </div>
  </div>

  <div class="signature-block" style="margin-top: 40px;">
    <div style="width: 50%;">
      <p>Witness signature (required for mental health/HIV/substance abuse)</p>
      <div class="signature-line"></div>
      <p style="margin-top: 5px;">Initials:</p>
      <div class="signature-line" style="width: 100%;"></div>
    </div>
    <div style="width: 50%;">
      <p>For Office Use Only:</p>
      <p>Fee:</p>
      <div class="signature-line" style="width: 100%;"></div>
      <p style="margin-top: 5px;">Green Task Completed?</p>
      <div class="signature-line" style="width: 100%;"></div>
      <p style="margin-top: 5px;">Rev.09.10</p>
    </div>
  </div>
</div>