            <div style="text-align: center; margin-right: 50px;">
                <div class="node" style="width: 150px;">
                    <span data-field="branch_1_1">{{ branch_1_1 }}</span>
                </div>
                <div style="display: flex; justify-content: center; margin-top: 20px;">
                    <div class="node" style="width: 150px;">
                        <span data-field="branch_1_1_yes">{{ branch_1_1_yes }}</span>
                    </div>
                    <div class="node" style="width: 150px;">
                        <span data-field="branch_1_1_no">{{ branch_1_1_no }}</span>
                    </div>
                </div>
            </div>

            <!-- Branch 2: Relationship -->
            <div style="text-align: center; margin-left: 50px;">
                <div class="node" style="width: 150px;">
                    <span data-field="branch_2_1">{{ branch_2_1 }}</span>
                </div>
                <div style="display: flex; justify-content: center; margin-top: 20px;">
                    <div class="node" style="width: 150px;">
                        <span data-field="branch_2_1_yes">{{ branch_2_1_yes }}</span>
                    </div>
                    <div class="node" style="width: 150px;">
                        <span data-field="branch_2_1_no">{{ branch_2_1_no }}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div style="margin-top: 40px;">
        <!-- Ordinal Branch -->
        <div style="display: flex; justify-content: center; align-items: flex-start;">
            <div style="text-align: center; margin-right: 50px;">
                <div class="node" style="width: 150px;">
                    <span data-field="ordinal_branch_1">{{ ordinal_branch_1 }}</span>
                </div>
                <div style="display: flex; justify-content: center; margin-top: 20px;">
                    <div class="node" style="width: 150px;">
                        <span data-field="ordinal_branch_1_yes">{{ ordinal_branch_1_yes }}</span>
                    </div>
                    <div class="node" style="width: 150px;">
                        <span data-field="ordinal_branch_1_no">{{ ordinal_branch_1_no }}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div style="margin-top: 40px;">
        <!-- Parametric Branch -->
        <div style="display: flex; justify-content: center; align-items: flex-start;">
            <div style="text-align: center; margin-right: 50px;">
                <div class="node" style="width: 150px;">
                    <span data-field="parametric_branch_1">{{ parametric_branch_1 }}</span>
                </div>
                <div style="display: flex; justify-content: center; margin-top: 20px;">
                    <div class="node" style="width: 150px;">
                        <span data-field="parametric_branch_1_yes">{{ parametric_branch_1_yes }}</span>
                    </div>
                    <div class="node" style="width: 150px;">
                        <span data-field="parametric_branch_1_no">{{ parametric_branch_1_no }}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div style="margin-top: 40px;">
        <!-- Further Splits -->
        <div style="display: flex; justify-content: center; align-items: flex-start;">
            <!-- Split from 1-way between subjects ANOVA -->
            <div style="text-align: center; margin-right: 50px;">
                <div class="node" style="width: 150px;">
                    <span data-field="anova_split_1">{{ anova_split_1 }}</span>
                </div>
                <div style="display: flex; justify-content: center; margin-top: 20px;">
                    <div class="node" style="width: 150px;">
                        <span data-field="anova_split_1_2">{{ anova_split_1_2 }}</span>
                    </div>
                    <div class="node" style="width: 150px;">
                        <span data-field="anova_split_1_3">{{ anova_split_1_3 }}</span>
                    </div>
                </div>
            </div>

            <!-- Split from 1-way within subjects ANOVA -->
            <div style="text-align: center; margin-left: 50px;">
                <div class="node" style="width: 150px;">
                    <span data-field="anova_split_2">{{ anova_split_2 }}</span>
                </div>
                <div style="display: flex; justify-content: center; margin-top: 20px;">
                    <div class="node" style="width: 150px;">
                        <span data-field="anova_split_2_2">{{ anova_split_2_2 }}</span>
                    </div>
                    <div class="node" style="width: 150px;">
                        <span data-field="anova_split_2_3">{{ anova_split_2_3 }}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div style="margin-top: 40px;">
        <!-- Final Splits (Simplified for template structure) -->
        <div style="display: flex; justify-content: center; align-items: flex-start;">
            <div style="text-align: center; margin-right: 50px;">
                <div class="node" style="width: 150px;">
                    <span data-field="final_split_1">{{ final_split_1 }}</span>
                </div>
                <div style="display: flex; justify-content: center; margin-top: 20px;">
                    <div class="node" style="width: 150px;">
                        <span data-field="final_split_1_yes">{{ final_split_1_yes }}</span>
                    </div>
                    <div class="node" style="width: 150px;">
                        <span data-field="final_split_1_no">{{ final_split_1_no }}</span>
                    </div>
                </div>
            </div>
            <div style="text-align: center; margin-left: 50px;">
                <div class="node" style="width: 150px;">
                    <span data-field="final_split_2">{{ final_split_2 }}</span>
                </div>
                <div style="display: flex; justify-content: center; margin-top: 20px;">
                    <div class="node" style="width: 150px;">
                        <span data-field="final_split_2_yes">{{ final_split_2_yes }}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="page">
    <div style="text-align: center; margin-bottom: 30px;">
        <h2 style="font-size: 18pt;">Decision Aid: Descriptive Statistics</h2>
    </div>

    <!-- Selection Table -->
    <table style="margin-top: 20px;">
        <thead>
            <tr>
                <th style="width: 20%;">Type of Description</th>
                <th style="width: 20%;">Scale of Measurement</th>
                <th style="width: 30%;">Nominal</th>
                <th style="width: 30%;">Ordinal</th>
                <th style="width: 20%;">Interval/Ratio</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>central tendency</td>
                <td></td>
                <td><span data-field="table_central_nominal">{{ table_central_nominal }}</span></td>
                <td><span data-field="table_central_ordinal">{{ table_central_ordinal }}</span></td>
                <td><span data-field="table_central_interval_ratio">{{ table_central_interval_ratio }}</span></td>
            </tr>
            <tr>
                <td>variability</td>
                <td></td>
                <td>not applicable</td>
                <td><span data-field="table_variability_ordinal">{{ table_variability_ordinal }}</span></td>
                <td><span data-field="table_variability_interval_ratio">{{ table_variability_interval_ratio }}</span></td>
            </tr>
            <tr>
                <td>relationship</td>
                <td></td>
                <td><span data-field="table_relationship_nominal">{{ table_relationship_nominal }}</span></td>
                <td><span data-field="table_relationship_ordinal">{{ table_relationship_ordinal }}</span></td>
                <td><span data-field="table_relationship_interval_ratio">{{ table_relationship_interval_ratio }}</span></td>
            </tr>
        </tbody>
    </table>

    <div style="margin-top: 40px;">
        <p style="font-size: 10pt;">*dichotomous variable: only two categories exist (e.g., male-female, yes-no, pet owner-not owner)</p>
        <p style="font-size: 10pt;">**not truly dichotomous: actually on a continuum, but combined into only two categories (e.g., anxiety: high-low)</p>
    </div>

    <!-- Display Table -->
    <table style="margin-top: 40px;">
        <thead>
            <tr>
                <th style="width: 20%;">Scale of Measurement</th>
                <th style="width: 20%;">Type of Display</th>
                <th style="width: 30%;">Graph</th>
                <th style="width: 30%;">Relationship</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Nominal or Ordinal</td>
                <td>Table</td>
                <td><span data-field="display_nominal_graph">{{ display_nominal_graph }}</span></td>
                <td><span data-field="display_nominal_relationship">{{ display_nominal_relationship }}</span></td>
            </tr>
            <tr>
                <td>Interval or Ratio</td>
                <td>Graph</td>
                <td><span data-field="display_interval_graph">{{ display_interval_graph }}</span></td>
                <td><span data-field="display_interval_relationship">{{ display_interval_relationship }}</span></td>
            </tr>
        </tbody>
    </table>
</div>

</body>
</html>