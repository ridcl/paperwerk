<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; /* Using serif fonts as a base */
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  h1, h2 { text-align: center; font-weight: bold; }
  .header-info { display: flex; justify-content: space-between; margin-bottom: 40px; }
  .address-block { font-size: 12pt; line-height: 1.4; }
  .section-title { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
  .form-row { display: flex; margin-bottom: 15px; align-items: flex-start; }
  .form-row > div { flex: 1; }
  .label { font-weight: normal; }
  .input-line { border-bottom: 1px solid #000; margin-top: 5px; }
  .disclaimer { font-size: 10pt; margin-top: 20px; }
  .footer-section { margin-top: 50px; padding-top: 20px; border-top: 1px solid #000; }
</style>

<div class="page">
  <div style="text-align: center; margin-bottom: 30px;">
    <img src="placeholder_logo.png" alt="University Logo" style="height: 80px; margin-bottom: 10px;">
    <h1 style="font-size: 24pt; margin: 0;">FAIRLEIGH DICKINSON UNIVERSITY</h1>
  </div>

  <div class="header-info">
    <div class="address-block">
      <p><strong>Florham Campus</strong></p>
      <p><span data-field="florham_address_line1">{{ florham_address_line1 }}</span></p>
      <p><span data-field="florham_address_line2">{{ florham_address_line2 }}</span></p>
      <p><span data-field="florham_city_state_zip">{{ florham_city_state_zip }}</span></p>
      <p>Phone: <span data-field="florham_phone">{{ florham_phone }}</span></p>
      <p>Fax: <span data-field="florham_fax">{{ florham_fax }}</span></p>
    </div>
    <div class="address-block">
      <p><strong>Metropolitan Campus</strong></p>
      <p><span data-field="metropolitan_address_line1">{{ metropolitan_address_line1 }}</span></p>
      <p><span data-field="metropolitan_address_line2">{{ metropolitan_address_line2 }}</span></p>
      <p><span data-field="metropolitan_city_state_zip">{{ metropolitan_city_state_zip }}</span></p>
      <p>Phone: <span data-field="metropolitan_phone">{{ metropolitan_phone }}</span></p>
      <p>Fax: <span data-field="metropolitan_fax">{{ metropolitan_fax }}</span></p>
    </div>
  </div>

  <div class="section-title">IDENTITY VERIFICATION</div>
  <div style="margin-bottom: 20px;">
    <input type="checkbox" id="photo_id" name="photo_id">
    <label for="photo_id">Photo ID - Copy of a Photo ID (i.e. Driver's License/Passport) must be Attached to the Request</label>
  </div>
  <div style="margin-bottom: 30px;">
    <input type="checkbox" id="notarized" name="notarized">
    <label for="notarized">Notarized - Form Must be Notarized</label>
  </div>

  <div class="disclaimer">*FORMS SENT IN WITHOUT A COPY OF AN ID OR NOT NOTARIZED WILL BE RETURNED*</div>

  <p>Please complete the below information and mail your Request to:</p>

  <div class="form-row">
    <div style="flex: 1;">
      <p><strong>Florham Campus (Florham/Madison)</strong></p>
      <p><span data-field="florham_campus_name">{{ florham_campus_name }}</span></p>
      <p><span data-field="florham_campus_address_line1">{{ florham_campus_address_line1 }}</span></p>
      <p><span data-field="florham_campus_address_line2">{{ florham_campus_address_line2 }}</span></p>
      <p><span data-field="florham_campus_city_state_zip">{{ florham_campus_city_state_zip }}</span></p>
    </div>
    <div style="flex: 1;">
      <p><strong>Metropolitan Campus (Teaneck/Rutherford)</strong></p>
      <p><span data-field="metropolitan_campus_name">{{ metropolitan_campus_name }}</span></p>
      <p><span data-field="metropolitan_campus_address_line1">{{ metropolitan_campus_address_line1 }}</span></p>
      <p><span data-field="metropolitan_campus_address_line2">{{ metropolitan_campus_address_line2 }}</span></p>
      <p><span data-field="metropolitan_campus_city_state_zip">{{ metropolitan_campus_city_state_zip }}</span></p>
    </div>
  </div>

  <div class="form-row">
    <div style="flex: 1;">
      <p>Student ID#: <span data-field="student_id">{{ student_id }}</span></p>
      <p>E-Mail: <span data-field="email_address">{{ email_address }}</span></p>
      <p>Name you attended under (maiden, if married): <span data-field="previous_name">{{ previous_name }}</span></p>
      <p>Campus: <span data-field="campus_selection">{{ campus_selection }}</span></p>
      <p>Degree: <span data-field="degree_selection">{{ degree_selection }}</span></p>
    </div>
    <div style="flex: 1;">
      <p>Last 4 Digits of SSN #: <span data-field="ssn_last_four">{{ ssn_last_four }}</span></p>
      <p>Mobile Phone: <span data-field="mobile_phone">{{ mobile_phone }}</span></p>
      <p>Processing Fee: <span data-field="processing_fee">{{ processing_fee }}</span> (Processing Time is 4-6 Weeks)</p>
      <p>Rutherford: <span data-field="rutherford_selection">{{ rutherford_selection }}</span></p>
      <p>Degree Date: <span data-field="degree_date">{{ degree_date }}</span></p>
    </div>
  </div>

  <div class="form-row">
    <div style="flex: 1;">
      <p>Brief description for placing the order: <span data-field="order_description">{{ order_description }}</span></p>
      <p>Mail diploma to: <span data-field="mailing_address">{{ mailing_address }}</span></p>
    </div>
  </div>

  <div class="form-row" style="margin-top: 40px;">
    <div style="flex: 1;">
      <p>Sign your name: <span data-field="signature_line">{{ signature_line }}</span></p>
    </div>
    <div style="flex: 1; text-align: right;">
      <p>Date: <span data-field="date_signed">{{ date_signed }}</span></p>
    </div>
  </div>

  <div class="section-title">Notary Information & Seal</div>
  <div style="margin-bottom: 30px;">
    <p>Office Use Only: Clear of Financial Holds (PERC): <span data-field="financial_holds_cleared">{{ financial_holds_cleared }}</span></p>
    <p>Verify Degree (IASU): <span data-field="degree_verified">{{ degree_verified }}</span></p>
    <p>Processed by: <span data-field="processed_by">{{ processed_by }}</span></p>
  </div>

  <div class="footer-section">
    <p>
      <span data-field="fee_amount">{{ fee_amount }}</span> Fee - Initial & Date by Bursar: <span data-field="bursar_initials">{{ bursar_initials }}</span> / <span data-field="bursar_date">{{ bursar_date }}</span>
    </p>
    <p>
      Processed by: <span data-field="processor_initials">{{ processor_initials }}</span> / <span data-field="processor_date">{{ processor_date }}</span>
    </p>
  </div>
</div>