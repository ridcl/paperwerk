  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px;">
    <div>
      <h1 style="font-size: 24pt; margin: 0;">WESTERN MICHIGAN UNIVERSITY</h1>
      <p style="margin: 0;">Human Resources</p>
      <p style="margin: 0;">1300 Sobart Administration Building, Mail Stop 5217</p>
      <p style="margin: 0;">Phone: (269) 387-3620 Fax: (269) 387-3441</p>
    </div>
    <div style="text-align: right;">
      <p style="font-size: 12pt; margin: 0;">INS</p>
    </div>
