<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1 { font-size: 24pt; font-weight: bold; text-align: center; margin-bottom: 30px; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 15px; }
  .form-group { display: flex; align-items: center; }
  .form-group label { margin-right: 10px; font-weight: normal; }
  .input-line { border-bottom: 1px solid #000; flex-grow: 1; margin-left: 10px; }
  .checkbox-group label { margin-right: 15px; font-weight: normal; }
  .section-title { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
  .signature-area { margin-top: 50px; display: flex; justify-content: space-between; }
  .signature-box { width: 45%; border-top: 1px solid #000; padding-top: 5px; }
</style>

<div class="page">
  <!-- Header/Logo Area -->
  <div style="text-align: center; margin-bottom: 30px;">
    <img src="placeholder_logo.png" alt="Logo" style="height: 60px; margin-bottom: 10px;">
    <h2 style="font-size: 14pt; font-weight: bold;">New Paltz</h2>
    <p style="font-size: 10pt;">State University of New York</p>
    <p style="font-size: 9pt; margin-top: 5px;">Student Health Service • Division of Student Affairs</p>
    <p style="font-size: 9pt;">1 <span data-field="address_line_1">{{ address_line_1 }}</span>, <span data-field="city">{{ city }}</span>, NY <span data-field="zip_code">{{ zip_code }}</span> • <span data-field="phone">{{ phone }}</span> • Fax <span data-field="fax">{{ fax }}</span></p>
    <p style="font-size: 9pt;">healthservice@<span data-field="domain">{{ domain }}</span></p>
  </div>

  <!-- Title -->
  <h1 style="text-align: center;">Asthma History Questionnaire</h1>

  <!-- Personal Information Section -->
  <div class="form-row">
    <div style="width: 45%;">
      <div class="form-group">
        <label>Name:</label>
        <div class="input-line"><span data-field="full_name">{{ full_name }}</span></div>
      </div>
      <div class="form-group">
        <label>Permanent Address:</label>
        <div class="input-line"><span data-field="address">{{ address }}</span></div>
      </div>
      <div class="form-group">
        <label>Home telephone:</label>
        <div class="input-line"><span data-field="phone_number">{{ phone_number }}</span></div>
      </div>
      <div class="form-group">
        <label>Family Physician:</label>
        <div class="input-line"><span data-field="physician_name">{{ physician_name }}</span></div>
      </div>
    </div>
    <div style="width: 45%; text-align: right;">
      <div class="form-group" style="text-align: right;">
        <label>Date of Birth:</label>
        <div class="input-line" style="width: 150px;"><span data-field="dob">{{ dob }}</span></div>
      </div>
      <div class="form-group" style="text-align: right;">
        <label>Banner #:</label>
        <div class="input-line" style="width: 150px;"><span data-field="student_id">{{ student_id }}</span></div>
      </div>
      <div class="form-group" style="text-align: right;">
        <label>Cell phone:</label>
        <div class="input-line" style="width: 150px;"><span data-field="cell_phone">{{ cell_phone }}</span></div>
      </div>
      <div class="form-group" style="text-align: right;">
        <label>Physician phone #:</label>
        <div class="input-line" style="width: 150px;"><span data-field="physician_phone">{{ physician_phone }}</span></div>
      </div>
    </div>
  </div>

  <!-- Triggers Section -->
  <div class="section-title">Triggers:</div>
  <div style="margin-bottom: 20px;">
    <div class="checkbox-group">
      <label><input type="checkbox"> Weather changes</label>
      <label><input type="checkbox"> Colds</label>
      <label><input type="checkbox"> Exercise</label>
      <label><input type="checkbox"> Pets</label>
      <label><input type="checkbox"> Smoke</label>
    </div>
    <div class="checkbox-group" style="margin-top: 10px;">
      <label><input type="checkbox"> Stress</label>
      <label><input type="checkbox"> Grass</label>
      <label><input type="checkbox"> Weeds</label>
      <label><input type="checkbox"> Pollen</label>
      <label><input type="checkbox"> Other: <div class="input-line" style="width: 100px;" data-field="pollen">{{ pollen }}</div></label>
    </div>
  </div>

  <!-- Questionnaire Questions -->
  <div class="section-title">1. Were you ever hospitalized for asthma?</div>
  <div style="margin-bottom: 20px;">
    <label><input type="radio"> Yes</label>
    <label><input type="radio"> No</label>
  </div>

  <div class="section-title">2. Last asthma attack:</div>
  <div class="form-row">
    <label>Date:</label>
    <div class="input-line" style="width: 300px;"><span data-field="last_attack_date">{{ last_attack_date }}</span></div>
  </div>

  <div class="section-title">3. Medications (eg. Do you use an inhaler or nebulizer?):</div>
  <div style="height: 100px; border-bottom: 1px solid #000; margin-bottom: 20px;">
    <!-- Placeholder for medication details if needed, otherwise just a line -->
  </div>

  <!-- Comments Section -->
  <div class="section-title">Comments:</div>
  <div style="height: 150px; border-bottom: 1px solid #000; margin-bottom: 30px;">
    <!-- Large text area placeholder -->
  </div>

  <!-- Please Note -->
  <div style="margin-bottom: 40px; padding: 10px; border: 1px solid #ccc; font-size: 10pt;">
    <p style="font-weight: bold; margin-bottom: 5px;">PLEASE NOTE:</p>
    <p>The Student Health Service recommends the influenza vaccine. This vaccine is available at SHS at no additional charge to students.</p>
  </div>

  <!-- Signature Area -->
  <div class="signature-area">
    <div style="width: 50%;">
      <p>Signature</p>
      <div class="signature-box"></div>
    </div>
    <div style="width: 50%; text-align: right;">
      <div style="margin-bottom: 10px;">
        <p>For office use only:</p>
        <p>Reviewed by:</p>
        <div class="signature-box" style="width: 100%;"></div>
      </div>
      <div>
        <p>Date:</p>
        <div class="input-line" style="width: 150px;"><span data-field="review_date">{{ review_date }}</span></div>
      </div>
    </div>
  </div>
</div>