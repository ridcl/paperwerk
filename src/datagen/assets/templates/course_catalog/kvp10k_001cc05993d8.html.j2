<!DOCTYPE html>
<html>
<head>
<title>Course Catalog</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    line-height: 1.5;
    color: #333;
  }
  h1, h2, h3 {
    font-weight: bold;
    margin-top: 0;
  }
  .header-section {
    text-align: center;
    margin-bottom: 40px;
  }
  .course-entry {
    border-bottom: 1px solid #ccc;
    padding-bottom: 20px;
    margin-bottom: 20px;
  }
  .course-entry:last-child {
    border-bottom: none;
    margin-bottom: 0;
  }
  .course-title {
    font-size: 1.2em;
    font-weight: bold;
    margin-bottom: 5px;
  }
  .course-meta {
    font-size: 0.9em;
    color: #555;
    margin-bottom: 10px;
  }
  .course-content {
    margin-bottom: 15px;
  }
  .course-details {
    font-size: 0.9em;
    color: #555;
  }
  .details-row {
    margin-bottom: 5px;
  }
  .details-row span:first-child {
    font-weight: bold;
    display: inline-block;
    width: 80px;
  }
</style>

<style>
