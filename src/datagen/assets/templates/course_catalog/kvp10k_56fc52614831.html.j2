<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1, h2, h3 { font-weight: bold; }
  table { width: 100%; border-collapse: collapse; margin-top: 20px; }
  td, th { padding: 8px 0; text-align: left; }
  .header-info { display: flex; justify-content: space-between; margin-bottom: 20px; }
  .section-title { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
</style>

<div class="page">
  <div style="text-align: center;">
    <h1>{{ institution_name }}</h1>
    <h2>School of Public Architecture</h2>
    <h3>MASTER OF ARCHITECTURE / 55 S.H.</h3>
    <p>EFFECTIVE DATE: {{ effective_date }}</p>
  </div>

  <div style="margin-top: 40px;">
    <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
      <div>
        <p>START TERM: <span data-field="start_term">{{ start_term }}</span></p>
        <p>NAME: <span data-field="full_name">{{ full_name }}</span></p>
        <p>STUDENT ID: <span data-field="student_id">{{ student_id }}</span></p>
      </div>
      <div>
        <p>TRANSFER INSTITUTIONS (X): <span data-field="transfer_institutions_count">{{ transfer_institutions_count }}</span></p>
        <p>CREDITS: <span data-field="credits_total">{{ credits_total }}</span></p>
        <p>IN PROGRESS: <span data-field="in_progress_status">{{ in_progress_status }}</span></p>
      </div>
    </div>
  </div>

  <div class="section-title">GENERAL EDUCATION (total credits)</div>
  <table>
    <thead>
      <tr>
        <th style="width: 60%;">Course/Description</th>
        <th style="width: 20%; text-align: center;">Credits</th>
        <th style="width: 20%; text-align: center;">In Progress</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="general_education.course_code">{{ general_education.course_code }}</span>: <span data-field="general_education.course_name">{{ general_education.course_name }}</span></td>
        <td style="text-align: center;"><span data-field="general_education.credits">{{ general_education.credits }}</span></td>
        <td style="text-align: center;"><span data-field="general_education.in_progress">{{ general_education.in_progress }}</span></td>
      </tr>
    </tbody>
  </table>

  <div class="section-title" style="margin-top: 30px;">REQUIRED COURSES</div>
  <table>
    <thead>
      <tr>
        <th style="width: 60%;">Course</th>
        <th style="width: 20%; text-align: center;">Credits</th>
        <th style="width: 20%; text-align: center;">In Progress</th>
      </tr>
    </thead>
    <tbody>
      {% for course in required_courses %}
      <tr>
        <td><span data-field="required_courses[{{ loop.index0 }}].course_code">{{ course.course_code }}</span>: <span data-field="required_courses[{{ loop.index0 }}].course_name">{{ course.course_name }}</span></td>
        <td style="text-align: center;"><span data-field="required_courses[{{ loop.index0 }}].credits">{{ course.credits }}</span></td>
        <td style="text-align: center;"><span data-field="required_courses[{{ loop.index0 }}].in_progress">{{ course.in_progress }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="section-title" style="margin-top: 30px;">ELECTIVES</div>
  <table>
    <thead>
      <tr>
        <th style="width: 60%;">Course</th>
        <th style="width: 20%; text-align: center;">Credits</th>
        <th style="width: 20%; text-align: center;">In Progress</th>
      </tr>
    </thead>
    <tbody>
      {% for elective in elective_courses %}
      <tr>
        <td><span data-field="elective_courses[{{ loop.index0 }}].course_code">{{ elective.course_code }}</span>: <span data-field="elective_courses[{{ loop.index0 }}].course_name">{{ elective.course_name }}</span></td>
        <td style="text-align: center;"><span data-field="elective_courses[{{ loop.index0 }}].credits">{{ elective.credits }}</span></td>
        <td style="text-align: center;"><span data-field="elective_courses[{{ loop.index0 }}].in_progress">{{ elective.in_progress }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div style="margin-top: 60px;">
    <table style="width: 50%;">
      <tr>
        <td style="width: 50%;">NOTE:</td>
        <td style="width: 50%;">Minimum GPA of "3.0" required for graduation</td>
      </tr>
      <tr>
        <td>S.H. = Semester Hours</td>
        <td></td>
      </tr>
    </table>
  </div>

  <div style="margin-top: 50px;">
    <table style="width: 100%;">
      <tr>
        <td style="width: 50%;">TOTAL:</td>
        <td style="width: 50%; text-align: right;"><span data-field="total_credits">{{ total_credits }}</span></td>
      </tr>
      <tr>
        <td>ADVISOR SIGNATURE:</td>
        <td style="text-align: right;"></td>
      </tr>
    </table>
  </div>

</div>