<!DOCTYPE html>
<html>
<head>
<title>Synthetic Document</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  td {
    padding: 10px;
    text-align: left;
  }
  h1, h2, h3 {
    font-weight: bold;
    margin-top: 0;
  }
  .header-info {
    display: flex;
    justify-content: space-between;
    margin-bottom: 30px;
    font-size: 0.9em;
  }
  .footer-notes {
    font-size: 0.8em;
    line-height: 1.4;
    margin-top: 40px;
  }
</style>
</head>
<body>
<div class="page">
  <div class="header-info">
    <div>
      College of Business Graduate Advising Office<br>
      777 Glades Road, FW 101<br>
      Boca Raton, FL, 33431<br>
      Information Technology & Operations Management Department
    </div>
    <div>
      Phone: <span data-field="phone_number">{{ phone_number }}</span><br>
      E-mail: <span data-field="email_address">{{ email_address }}</span><br>
      Phone: <span data-field="phone_number_2">{{ phone_number_2 }}</span><br>
      E-mail: <span data-field="email_address_2">{{ email_address_2 }}</span>
    </div>
  </div>

  <h1>MSITM—Information Technology Management Concentration</h1>
  <h2>Minimum 33 Hours Required for Graduation <sup data-field="superscript_a">{{ superscript_a }}</sup></h2>

  <table>
    <thead>
      <tr>
        <th style="text-align: center;">Business Data Communications</th>
        <th style="text-align: center;">Information Technology Fundamentals</th>
        <th style="text-align: center;">Database Management Systems</th>
        <th style="text-align: center;">Advanced Systems Analysis and Design</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="course_code_1">{{ course_code_1 }}</span><br><span data-field="course_description_1">{{ course_description_1 }}</span></td>
        <td><span data-field="course_code_2">{{ course_code_2 }}</span><br><span data-field="course_description_2">{{ course_description_2 }}</span></td>
        <td><span data-field="course_code_3">{{ course_code_3 }}</span><br><span data-field="course_description_3">{{ course_description_3 }}</span></td>
        <td><span data-field="course_code_4">{{ course_code_4 }}</span><br><span data-field="course_description_4">{{ course_description_4 }}</span></td>
      </tr>
    </tbody>
  </table>

  <h3>REQUIRED COURSES (21 Credits)</h3>
  <table>
    <thead>
      <tr>
        <th style="text-align: center;">Management Information Systems and Technology</th>
        <th style="text-align: center;">Communication Strategies for Business Professionals</th>
        <th style="text-align: center;">Management of Information Assurance and Security</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="course_code_5">{{ course_code_5 }}</span></td>
        <td><span data-field="course_code_6">{{ course_code_6 }}</span></td>
        <td><span data-field="course_code_7">{{ course_code_7 }}</span></td>
      </tr>
    </tbody>
  </table>

  <table>
    <thead>
      <tr>
        <th style="text-align: center;">IT Sourcing Management</th>
        <th style="text-align: center;">IT Project and Change Management</th>
        <th style="text-align: center;">Web-Based Business Development</th>
        <th style="text-align: center;">Enterprise Information Technology Service Management</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="course_code_8">{{ course_code_8 }}</span></td>
        <td><span data-field="course_code_9">{{ course_code_9 }}</span></td>
        <td><span data-field="course_code_10">{{ course_code_10 }}</span></td>
        <td><span data-field="course_code_11">{{ course_code_11 }}</span></td>
      </tr>
    </tbody>
  </table>

  <h3>ELECTIVE COURSES (3 Credits) <sup data-field="superscript_d">{{ superscript_d }}</sup></h3>
  <table>
    <thead>
      <tr>
        <th style="text-align: center;">Introduction to Business Analytics & Big Data</th>
        <th style="text-align: center;">Advanced Business Analytics</th>
        <th style="text-align: center;">Mobile Apps for Business</th>
        <th style="text-align: center;">Data Mining and Predictive Analytics</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="course_code_12">{{ course_code_12 }}</span></td>
        <td><span data-field="course_code_13">{{ course_code_13 }}</span></td>
        <td><span data-field="course_code_14">{{ course_code_14 }}</span></td>
        <td><span data-field="course_code_15">{{ course_code_15 }}</span></td>
      </tr>
    </tbody>
  </table>

  <table>
    <thead>
      <tr>
        <th style="text-align: center;">Social Media and Web Analytics</th>
        <th style="text-align: center;">Data Management & Analysis with Excel</th>
        <th style="text-align: center;">Business Innovation with Artificial Intelligence</th>
        <th style="text-align: center;">Special Topics</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="course_code_16">{{ course_code_16 }}</span></td>
        <td><span data-field="course_code_17">{{ course_code_17 }}</span></td>
        <td><span data-field="course_code_18">{{ course_code_18 }}</span></td>
        <td><span data-field="course_code_19">{{ course_code_19 }}</span></td>
      </tr>
    </tbody>
  </table>

  <div style="text-align: center; margin-top: 50px;">
    <h2>COLLEGE OF ENGINEERING PROGRAM ELECTIVES (9 Credits) <sup data-field="superscript_e">{{ superscript_e }}</sup></h2>
    <p>Please Visit the Link below to View the Recommended College of Engineering and Computer Science Elective Course List for MSITM Business Students</p>
    <p style="margin-top: 20px;"><a href="https://business.fau.edu/itom/cs-courses/">https://business.fau.edu/itom/cs-courses/</a></p>
  </div>

  <div class="footer-notes">
    <p>
      <span data-field="note_a">{{ note_a }}</span><br>
      <span data-field="note_b">{{ note_b }}</span><br>
      <span data-field="note_c">{{ note_c }}</span><br>
      <span data-field="note_d">{{ note_d }}</span><br>
      <span data-field="note_e">{{ note_e }}</span>
  </div>
</div>
</body>
</html>