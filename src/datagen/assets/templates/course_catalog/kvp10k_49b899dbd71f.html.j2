<!DOCTYPE html>
<html>
<head>
    <title>Synthetic Document</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        td, th { padding: 8px; text-align: left; border: 1px solid #ccc; }
        .header-title { text-align: center; font-size: 18pt; font-weight: bold; margin-bottom: 10px; }
        .sub-header { text-align: center; font-size: 12pt; margin-bottom: 30px; }
        .form-row { display: flex; justify-content: space-between; margin-bottom: 15px; }
        .form-label { font-weight: bold; }
        .form-input { border-bottom: 1px solid #000; flex-grow: 1; margin-left: 10px; }
        .section-title { font-size: 14pt; font-weight: bold; margin-top: 25px; margin-bottom: 15px; border-bottom: 1px solid #000; padding-bottom: 5px; }
        .table-small { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        .table-small td { padding: 5px; border: 1px solid #ccc; }
    </style>
</head>
<body>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
        <div style="width: 30%;">
            <img src="placeholder_logo.png" alt="City College Logo" style="width: 100%;">
        </div>
        <div style="width: 70%; text-align: right;">
            <div style="font-size: 10pt;">TRANSFER INSTITUTION(S):</div>
        </div>
    </div>
    <div style="text-align: center; margin-top: 30px;">
        <div class="header-title">DIESEL TECHNOLOGY</div>
        <div class="sub-header">ASSOCIATE OF APPLIED SCIENCE</div>
        <div style="font-size: 12pt; margin-top: 10px;">ADVISING WORKSHEET 2020-2021</div>
    </div>

    <div style="margin-top: 50px;">
        <div class="form-row">
            <div style="width: 30%;">
                <div class="form-label">Name</div>
                <div class="form-input"><span data-field="full_name">{{ full_name }}</span></div>
            </div>
            <div style="width: 30%;">
                <div class="form-label">Student ID</div>
                <div class="form-input"><span data-field="student_id">{{ student_id }}</span></div>
            </div>
        </div>
    </div>

    <div class="section-title">Recommended Preparatory Courses</div>
    <table>
        <thead>
            <tr>
                <th style="width: 30%;">Course</th>
                <th style="width: 20%;">Credits</th>
                <th style="width: 20%;">Grade</th>
                <th style="width: 15%;">Semester</th>
                <th style="width: 15%;">Equivalent</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><span data-field="recommended_course_1_code">{{ recommended_course_1_code }}</span></td>
                <td><span data-field="recommended_course_1_credits">{{ recommended_course_1_credits }}</span></td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
        </tbody>
    </table>

    <div class="section-title">Required Preparatory Courses</div>
    <table>
        <thead>
            <tr>
                <th style="width: 30%;">Course</th>
                <th style="width: 20%;">Credits</th>
                <th style="width: 20%;">Grade</th>
                <th style="width: 15%;">Semester</th>
                <th style="width: 15%;">Equivalent</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><span data-field="required_prep_course_1_code">{{ required_prep_course_1_code }}</span></td>
                <td><span data-field="required_prep_course_1_credits">{{ required_prep_course_1_credits }}</span></td>
                <td></td>
                <td></td>
                <td></td>
            </tr>
        </tbody>
    </table>

    <div class="section-title">General Education Requirements</div>
    <table>
        <thead>
            <tr>
                <th style="width: 30%;">Course</th>
                <th style="width: 15%;">Credits</th>
                <th style="width: 55%;">Description</th>
                <th style="width: 20%;"></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><span data-field="gen_ed_course_1_code">{{ gen_ed_course_1_code }}</span></td>
                <td><span data-field="gen_ed_course_1_credits">{{ gen_ed_course_1_credits }}</span></td>
                <td><span data-field="gen_ed_course_1_description">{{ gen_ed_course_1_description }}</span></td>
                <td><span data-field="gen_ed_course_1_credits_value">{{ gen_ed_course_1_credits_value }}</span></td>
            </tr>
            <tr>
                <td><span data-field="gen_ed_course_2_code">{{ gen_ed_course_2_code }}</span></td>
                <td><span data-field="gen_ed_course_2_credits">{{ gen_ed_course_2_credits }}</span></td>
                <td><span data-field="gen_ed_course_2_description">{{ gen_ed_course_2_description }}</span></td>
                <td><span data-field="gen_ed_course_2_credits_value">{{ gen_ed_course_2_credits_value }}</span></td>
            </tr>
            <tr>
                <td><span data-field="gen_ed_course_3_code">{{ gen_ed_course_3_code }}</span></td>
                <td><span data-field="gen_ed_course_3_credits">{{ gen_ed_course_3_credits }}</span></td>
                <td><span data-field="gen_ed_course_3_description">{{ gen_ed_course_3_description }}</span></td>
                <td><span data-field="gen_ed_course_3_credits_value">{{ gen_ed_course_3_credits_value }}</span></td>
            </tr>
        </tbody>
    </table>

    <div class="section-title">Required Courses</div>
    <table>
        <thead>
            <tr>
                <th style="width: 15%;">DST</th>
                <th style="width: 15%;">Course</th>
                <th style="width: 15%;">Credits</th>
                <th style="width: 55%;">Description</th>
            </tr>
        </thead>
        <tbody>
            {% for item in required_courses %}
            <tr>
                <td><span data-field="required_courses[{{ loop.index0 }}].dst_code">{{ required_courses[loop.index0].dst_code }}</span></td>
                <td><span data-field="required_courses[{{ loop.index0 }}].course_code">{{ required_courses[loop.index0].course_code }}</span></td>
                <td><span data-field="required_courses[{{ loop.index0 }}].credits">{{ required_courses[loop.index0].credits }}</span></td>
                <td><span data-field="required_courses[{{ loop.index0 }}].description">{{ required_courses[loop.index0].description }}</span></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="section-title">Electives</div>
    <table>
        <thead>
            <tr>
                <th style="width: 30%;">Course</th>
                <th style="width: 15%;">Credits</th>
                <th style="width: 55%;">Description</th>
            </tr>
        </thead>
        <tbody>
            {% for item in elective_courses %}
            <tr>
                <td><span data-field="elective_courses[{{ loop.index0 }}].course_code">{{ elective_courses[loop.index0].course_code }}</span></td>
                <td><span data-field="elective_courses[{{ loop.index0 }}].credits">{{ elective_courses[loop.index0].credits }}</span></td>
                <td><span data-field="elective_courses[{{ loop.index0 }}].description">{{ elective_courses[loop.index0].description }}</span></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <div style="text-align: right; margin-top: 20px;">
        <div style="font-size: 12pt;">TOTAL MINIMUM CREDITS REQUIRED: <span data-field="total_minimum_credits">{{ total_minimum_credits }}</span></div>
    </div>
    <div style="text-align: center; margin-top: 10px; font-size: 10pt;">A grade of "<span data-field="grade_requirement">{{ grade_requirement }}</span>" or higher is mandatory in all courses</div>
</div>

<div class="page">
    <div style="text-align: center; margin-top: 30px;">
        <div class="header-title">2020-2021 Diesel Technology AAS</div>
        <div class="sub-header">Plan of Study</div>
    </div>

    <div style="margin-top: 40px;">
        <div class="form-row">
            <div style="width: 30%;">
                <div class="form-label">Name</div>
                <div class="form-input"><span data-field="full_name_plan">{{ full_name_plan }}</span></div>
            </div>
            <div style="width: 30%;">
                <div class="form-label">Student I.D.</div>
                <div class="form-input"><span data-field="student_id_plan">{{ student_id_plan }}</span></div>
            </div>
        </div>
    </div>

    <div style="display: flex; justify-content: space-between; margin-top: 40px;">
        <div style="width: 48%;">
            <div style="font-weight: bold; margin-bottom: 10px;">Fall</div>
            <table class="table-small">
                <thead>
                    <tr>
                        <th style="width: 30%;">Course</th>
                        <th style="width: 15%;">Credits</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in fall_courses %}
                    <tr>
                        <td><span data-field="fall_courses[{{ loop.index0 }}].course_code">{{ fall_courses[loop.index0].course_code }}</span></td>
                        <td><span data-field="fall_courses[{{ loop.index0 }}].credits">{{ fall_courses[loop.index0].credits }}</span></td>
                    </tr>
                    {% endfor %}
                    <tr>
                        <td style="font-weight: bold;">Total</td>
                        <td style="font-weight: bold;"><span data-field="fall_total_credits">{{ fall_total_credits }}</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div style="width: 48%;">
            <div style="font-weight: bold; margin-bottom: 10px;">Spring</div>
            <table class="table-small">
                <thead>
                    <tr>
                        <th style="width: 30%;">Course</th>
                        <th style="width: 15%;">Credits</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in spring_courses %}
                    <tr>
                        <td><span data-field="spring_courses[{{ loop.index0 }}].course_code">{{ spring_courses[loop.index0].course_code }}</span></td>
                        <td><span data-field="spring_courses[{{ loop.index0 }}].credits">{{ spring_courses[loop.index0].credits }}</span></td>
                    </tr>
                    {% endfor %}
                    <tr>
                        <td style="font-weight: bold;">Total</td>
                        <td style="font-weight: bold;"><span data-field="spring_total_credits">{{ spring_total_credits }}</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div style="display: flex; justify-content: space-between; margin-top: 40px;">
        <div style="width: 48%;">
            <div style="font-weight: bold; margin-bottom: 10px;">Fall</div>
            <table class="table-small">
                <thead>
                    <tr>
                        <th style="width: 30%;">Course</th>
                        <th style="width: 15%;">Credits</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in fall_courses_2 %}
                    <tr>
                        <td><span data-field="fall_courses_2[{{ loop.index0 }}].course_code">{{ fall_courses_2[loop.index0].course_code }}</span></td>
                        <td><span data-field="fall_courses_2[{{ loop.index0 }}].credits">{{ fall_courses_2[loop.index0].credits }}</span></td>
                    </tr>
                    {% endfor %}
                    <tr>
                        <td style="font-weight: bold;">Total</td>
                        <td style="font-weight: bold;"><span data-field="fall_total_credits_2">{{ fall_total_credits_2 }}</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div style="width: 48%;">
            <div style="font-weight: bold; margin-bottom: 10px;">Spring</div>
            <table class="table-small">
                <thead>
                    <tr>
                        <th style="width: 30%;">Course</th>
                        <th style="width: 15%;">Credits</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in spring_courses_2 %}
                    <tr>
                        <td><span data-field="spring_courses_2[{{ loop.index0 }}].course_code">{{ spring_courses_2[loop.index0].course_code }}</span></td>
                        <td><span data-field="spring_courses_2[{{ loop.index0 }}].credits">{{ spring_courses_2[loop.index0].credits }}</span></td>
                    </tr>
                    {% endfor %}
                    <tr>
                        <td style="font-weight: bold;">Total</td>
                        <td style="font-weight: bold;"><span data-field="spring_total_credits_2">{{ spring_total_credits_2 }}</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div style="margin-top: 50px;">
        <div style="font-weight: bold;">Number of earned credits that apply toward degree:</div>
        <div class="form-input" style="width: 50%; margin-bottom: 20px;"><span data-field="earned_credits_applied">{{ earned_credits_applied }}</span></div>

        <div style="font-weight: bold;">Number of credits left to earn for degree:</div>
        <div class="form-input" style="width: 50%; margin-bottom: 30px;"><span data-field="credits_left_to_earn">{{ credits_left_to_earn }}</span></div>

        <div style="display: flex; justify-content: space-between; margin-top: 40px;">
            <div>
                <div style="font-weight: bold;">CERTIFICATION:</div>
                <div style="font-weight: bold;">The courses listed are <span data-field="certification_status">{{ certification_status }}</span> required for the student's degree.</div>
            </div>
            <div style="text-align: right;">
                <div style="margin-top: 50px;">Advisor's Signature: _________________________</div>
                <div style="margin-top: 50px;">Date: _________________________</div>
                <div style="margin-top: 50px;">Student's Signature: _________________________</div>
                <div style="margin-top: 50px;">Date: _________________________</div>
            </div>
        </div>
    </div>
</div>

</body>
</html>