<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1 { font-size: 24pt; font-weight: bold; margin-bottom: 5px; }
  h2 { font-size: 14pt; font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
  .header-info { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px; }
  .logo { font-size: 36pt; font-weight: bold; }
  .meta-data { text-align: right; font-size: 10pt; }
  .form-row { display: flex; margin-bottom: 15px; }
  .form-row > div { flex: 1; padding-right: 20px; }
  .form-row label { display: block; font-weight: bold; margin-bottom: 5px; font-size: 10pt; }
  .form-row input[type="text"] { border-bottom: 1px solid #000; width: 100%; padding: 2px 0; }
  .table-container { width: 100%; border-collapse: collapse; margin-top: 20px; }
  .table-container th, .table-container td { border: 1px solid #000; padding: 8px; text-align: left; font-size: 10pt; }
  .table-container th { background-color: #f0f0f0; font-weight: bold; }
  .signature-area { margin-top: 80px; }
</style>

<div class="page">
  <div class="header-info">
    <div class="logo">LSU</div>
    <div class="meta-data">
      Louisiana State University<br>
      Office of Accounting Services<br>
      Accounts Payable & Travel<br>
      217 Thomas Boyd Hall
      <div style="margin-top: 10px;">AS580</div>
    </div>
  </div>

  <h2>DIRECT CHARGE WORKSHEET</h2>
  <p style="font-size: 11pt;">This form must be completed to provide the related FDM worktags and spend category for direct charge invoices. The <span style="font-weight: bold;">direct charge invoice must be attached to this form.</span></p>

  <div class="form-row">
    <div style="flex-basis: 20%;">
      <label>Request Date</label>
      <input type="text" value="{{ request_date }}">
    </div>
    <div style="flex-basis: 30%;">
      <label>Company</label>
      <input type="text" value="{{ company_name }}">
    </div>
    <div style="flex-basis: 20%;">
      <label>Department</label>
      <input type="text" value="{{ department_name }}">
    </div>
    <div style="flex-basis: 30%;">
      <label>Contact</label>
      <input type="text" value="{{ contact_name }}">
    </div>
  </div>

  <div class="form-row">
    <div style="flex-basis: 20%;">
      <label>Phone</label>
      <input type="text" value="{{ phone_number }}">
    </div>
    <div style="flex-basis: 20%;">
      <label>Fax</label>
      <input type="text" value="{{ fax_number }}">
    </div>
    <div style="flex-basis: 30%;">
      <label>E-Mail</label>
      <input type="text" value="{{ email_address }}">
    </div>
    <div style="flex-basis: 30%;">
      <label>Supplier/Payee</label>
      <input type="text" value="{{ supplier_payee_name }}">
    </div>
  </div>

  <div class="form-row">
    <div style="flex-basis: 20%;">
      <label>Purpose of Purchase</label>
      <input type="text" value="{{ purpose_of_purchase }}">
    </div>
    <div style="flex-basis: 50%;">
      <label>Document Number</label>
      <input type="text" value="{{ document_number }}">
    </div>
  </div>

  <table class="table-container">
    <thead>
      <tr>
        <th style="width: 15%;">Spend Category</th>
        <th style="width: 15%;">Amount</th>
        <th style="width: 15%;">Program</th>
        <th style="width: 15%;">Project</th>
        <th style="width: 15%;">Gift</th>
        <th style="width: 15%;">Grant</th>
        <th style="width: 15%;">Cost Center</th>
        <th style="width: 15%;">Fund</th>
        <th style="width: 15%;">Function</th>
        <th style="width: 15%;">Additional Worktags</th>
      </tr>
    </thead>
    <tbody>
      {% for item in line_items %}
      <tr>
        <td><span data-field="line_items[{{ loop.index0 }}].spend_category">{{ item.spend_category }}</span></td>
        <td><span data-field="line_items[{{ loop.index0 }}].amount">{{ item.amount }}</span></td>
        <td><span data-field="line_items[{{ loop.index0 }}].program">{{ item.program }}</span></td>
        <td><span data-field="line_items[{{ loop.index0 }}].project">{{ item.project }}</span></td>
        <td><span data-field="line_items[{{ loop.index0 }}].gift">{{ item.gift }}</span></td>
        <td><span data-field="line_items[{{ loop.index0 }}].grant">{{ item.grant }}</span></td>
        <td><span data-field="line_items[{{ loop.index0 }}].cost_center">{{ item.cost_center }}</span></td>
        <td><span data-field="line_items[{{ loop.index0 }}].fund">{{ item.fund }}</span></td>
        <td><span data-field="line_items[{{ loop.index0 }}].function">{{ item.function }}</span></td>
        <td><span data-field="line_items[{{ loop.index0 }}].additional_worktags">{{ item.additional_worktags }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div style="margin-top: 20px;">
    <div style="display: flex; justify-content: flex-end;">
      <div style="width: 200px;">
        <label>Invoice Total</label>
        <input type="text" value="{{ invoice_total }}">
      </div>
    </div>
  </div>

  <p style="margin-top: 50px; font-size: 10pt;">I certify the attached invoice adheres to PRO-U525.A, Exceptions to the Competitive Solicitation Process and will be processed as a Direct Charge payment.</p>

  <div class="signature-area">
    <div style="width: 40%;">
      <label>Authorized Signature</label>
      <div style="border-bottom: 1px solid #000; margin-top: 5px;" data-field="authorized_signature">{{ authorized_signature }}</div>
    </div>
  </div>
</div>