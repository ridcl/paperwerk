<style>
    @page { size: A4; margin: 0; }
    .page {
        width: 794px; height: 1123px;
        padding: 50px 60px; box-sizing: border-box;
        overflow: hidden; page-break-after: always;
        position: relative;
        font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
    }
    .page:last-child { page-break-after: auto; }
    table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
    td { padding: 5px 0; }
    .header { font-weight: bold; }
</style>
<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
        <div>
            <h1 style="font-size: 48px; margin: 0;">W</h1>
            <h2 style="font-size: 24px; margin-top: 5px;">Western Illinois University</h2>
        </div>
        <div style="text-align: right;">
            <p style="font-size: 12px;">Western Illinois University – Quad Cities</p>
            <p style="font-size: 12px;">{{ employer.address_line_1 }}</p>
            <p style="font-size: 12px;">{{ employer.address_line_2 }}</p>
            <p style="font-size: 12px;">{{ employer.phone }}</p>
        </div>
    </div>

    <h2 style="font-size: 22px; margin-top: 40px;">{{ applicant.full_name }} and {{ co_applicant.full_name }} Scholarship</h2>

    <p style="font-size: 16px; margin-top: 20px;">Deadline: <span data-field="deadline_date">{{ deadline_date }}</span> at <span data-field="deadline_time">{{ deadline_time }}</span>.</p>

    <div style="border: 1px solid #000; padding: 20px; margin-top: 30px;">
        <h3 style="font-weight: bold; margin-top: 0;">CRITERIA:</h3>
        <ul style="list-style-type: disc; padding-left: 20px;">
            <li>Resident of <span data-field="criteria.residency_county">{{ criteria.residency_county }}</span>, Illinois who enrolls full time at either WIU campus</li>
            <li>Any major, but a preference for Education or Agriculture majors and minors</li>
            <li>Undergraduate student</li>
            <li>Highest priority - based on financial need (FAFSA)</li>
            <li>Minimum GPA <span data-field="criteria.min_gpa">{{ criteria.min_gpa }}</span></li>
            <li>Demonstrated community service to <span data-field="criteria.service_county">{{ criteria.service_county }}</span>, especially New Boston Township with a preference for those who plan to reside in <span data-field="criteria.service_county">{{ criteria.service_county }}</span> after degree attainment</li>
        </ul>
    </div>

    <table style="margin-top: 40px;">
        <tr>
            <td style="width: 25%;">Student's Name</td>
            <td style="width: 25%;">Telephone No.</td>
            <td style="width: 25%;">County of Residence</td>
        </tr>
        <tr>
            <td><span data-field="applicant.full_name">{{ applicant.full_name }}</span></td>
            <td><span data-field="applicant.phone">{{ applicant.phone }}</span></td>
            <td><span data-field="applicant.county_of_residence">{{ applicant.county_of_residence }}</span></td>
        </tr>
        <tr>
            <td>Street Address</td>
            <td>WIU Student ID Number</td>
            <td>Major at WIU</td>
        </tr>
        <tr>
            <td><span data-field="applicant.street_address">{{ applicant.street_address }}</span></td>
            <td><span data-field="applicant.student_id">{{ applicant.student_id }}</span></td>
            <td><span data-field="applicant.major">{{ applicant.major }}</span></td>
        </tr>
        <tr>
            <td>City</td>
            <td>State</td>
            <td>Zip Code</td>
        </tr>
        <tr>
            <td><span data-field="applicant.city">{{ applicant.city }}</span></td>
            <td><span data-field="applicant.state">{{ applicant.state }}</span></td>
            <td><span data-field="applicant.zip_code">{{ applicant.zip_code }}</span></td>
        </tr>
    </table>

    <p style="margin-top: 30px;">Please list other scholarships which you have applied for during this school year:</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 20px;" data-field="field_1">{{ field_1 }}</div>

    <p style="margin-top: 30px;">Please list other types of financial aid you expect to receive (loans, grants, etc.):</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 20px;" data-field="field_2">{{ field_2 }}</div>

    <h3 style="font-weight: bold; margin-top: 40px;">Sources of financial support for college expenses (figures should total 100%):</h3>
    <table style="margin-top: 15px;">
        <tr>
            <td style="width: 25%;">% Self (incl. loans, grants)</td>
            <td style="width: 25%;">% Parents</td>
            <td style="width: 25%;">% Spouse</td>
        </tr>
        <tr>
            <td><span data-field="financial_support.self_percent">{{ financial_support.self_percent }}</span></td>
            <td><span data-field="financial_support.parents_percent">{{ financial_support.parents_percent }}</span></td>
            <td><span data-field="financial_support.spouse_percent">{{ financial_support.spouse_percent }}</span></td>
        </tr>
        <tr>
            <td style="width: 25%;">% Scholarships</td>
            <td style="width: 25%;">% Veterans Benefits</td>
            <td style="width: 25%;">% Other financial assistance</td>
        </tr>
        <tr>
            <td><span data-field="financial_support.scholarships_percent">{{ financial_support.scholarships_percent }}</span></td>
            <td><span data-field="financial_support.veterans_percent">{{ financial_support.veterans_percent }}</span></td>
            <td><span data-field="financial_support.other_percent">{{ financial_support.other_percent }}</span></td>
        </tr>
    </table>

    <p style="margin-top: 30px;">Please list any awards and honors received while in college or high school (use additional paper as needed):</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 20px;" data-field="field_3">{{ field_3 }}</div>

    <p style="margin-top: 30px;">Please list any civic, community, and college extra-curricular activities (use additional paper as needed):</p>
    <div style="border-bottom: 1px solid #000; margin-bottom: 20px;" data-field="field_4">{{ field_4 }}</div>

    <p style="margin-top: 30px;">During the scholarship application review process, your transcript and financial aid records may be reviewed by the scholarship committee. Please sign the statement below to give the committee permission to review your WIU transcript and financial aid records.</p>

    <p style="margin-top: 30px;">I, <span data-field="applicant.full_name">{{ applicant.full_name }}</span>, give my permission to the WIU Quad Cities Scholarship Committee to review my transcript and financial aid records.</p>

    <table style="margin-top: 50px;">
        <tr>
            <td style="width: 50%;">Signature</td>
            <td style="width: 50%; text-align: right;">Date</td>
        </tr>
    </table>

    <p style="margin-top: 50px;">All information must be completed on this application and any requested additional materials attached in order for your scholarship application to be reviewed by the scholarship committee. If you have any questions, please direct them to Curtis Williams: <span data-field="contact.phone">{{ contact.phone }}</span>, <span data-field="contact.email">{{ contact.email }}</span>.</p>

    <p style="margin-top: 50px;">RETURN TO: Western Illinois University – Quad Cities</p>
    <p style="margin-top: 5px;">Attn: QC Scholarship Office</p>
    <p style="margin-top: 5px;">{{ employer.address_line_1 }}</p>
    <p style="margin-top: 5px;">{{ employer.address_line_2 }}</p>
</div>