<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1 { font-size: 24pt; text-align: center; margin-bottom: 30px; }
  .header-section { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px; }
  .logo-area img { max-width: 150px; height: auto; }
  .application-details { width: 60%; }
  .form-row { display: flex; margin-bottom: 15px; align-items: flex-start; }
  .form-row > div { flex: 1; padding-right: 20px; }
  .form-row label { display: block; font-weight: bold; margin-bottom: 5px; }
  .form-row input[type="text"] { border-bottom: 1px solid black; padding-bottom: 2px; width: 100%; }
  .divider { border-top: 1px solid black; margin: 20px 0; }
  table { width: 100%; border-collapse: collapse; margin-top: 15px; }
  th, td { border: 1px solid #ccc; padding: 8px; text-align: left; }
  th { background-color: #f2f2f2; }
  .signature-section { margin-top: 60px; }
</style>

<div class="page">
  <h1>UNITY Textbook Scholarship Application</h1>

  <div class="header-section">
    <div class="logo-area">
      <!-- Placeholder for logo image -->
      <img src="" alt="University Logo">
    </div>
    <div class="application-details">
      <p>Scholarship Office, <span data-field="employer.name">{{ employer.name }}</span></p>
      <p><span data-field="employer.address_line_1">{{ employer.address_line_1 }}</span></p>
      <p><span data-field="employer.address_line_2">{{ employer.address_line_2 }}</span></p>
      <p>Phone: <span data-field="employer.phone">{{ employer.phone }}</span> Fax: <span data-field="employer.fax">{{ employer.fax }}</span></p>
      <p>Web: <span data-field="employer.website">{{ employer.website }}</span></p>
      <p><strong>Deadline:</strong> <span data-field="deadline_date">{{ deadline_date }}</span></p>
    </div>
  </div>

  <div class="form-row">
    <div>
      <label>Student Name:</label>
      <div style="display: flex; gap: 20px;">
        <div style="flex: 1;">
          <label>Last</label>
          <input type="text" data-field="last" value="{{ last }}">
        </div>
        <div style="flex: 1;">
          <label>First</label>
          <input type="text" data-field="first" value="{{ first }}">
        </div>
        <div style="flex: 1;">
          <label>Middle Initial</label>
          <input type="text" data-field="middle_initial" value="{{ middle_initial }}">
        </div>
      </div>
    </div>
  </div>

  <div class="form-row">
    <div>
      <label>WIU I.D. #:</label>
      <input type="text" data-field="wiu_i_d" value="{{ wiu_i_d }}">
    </div>
    <div>
      <label>Date of Birth:</label>
      <div style="display: flex; gap: 10px;">
        <input type="text" style="width: 30px;" data-field="date_of_birth" value="{{ date_of_birth }}">
        <input type="text" style="width: 30px;" data-field="date_of_birth_2" value="{{ date_of_birth_2 }}">
        <input type="text" style="width: 30px;" data-field="date_of_birth_3" value="{{ date_of_birth_3 }}">
      </div>
    </div>
    <div>
      <label>Mo</label>
      <input type="text" style="width: 30px;" data-field="mo" value="{{ mo }}">
      <label>Day</label>
      <input type="text" style="width: 30px;" data-field="day" value="{{ day }}">
      <label>Yr</label>
      <input type="text" style="width: 30px;" data-field="yr" value="{{ yr }}">
    </div>
  </div>

  <div class="form-row">
    <div>
      <label>Local address:</label>
      <input type="text" style="width: 100%;" data-field="local_address" value="{{ local_address }}">
    </div>
  </div>

  <div class="form-row">
    <div>
      <label>City:</label>
      <input type="text" style="width: 30%;" data-field="city" value="{{ city }}">
    </div>
    <div>
      <label>State:</label>
      <input type="text" style="width: 20%;" data-field="state" value="{{ state }}">
    </div>
    <div>
      <label>Zip Code:</label>
      <input type="text" style="width: 20%;" data-field="zip_code" value="{{ zip_code }}">
    </div>
    <div>
      <label>Cell Phone #:</label>
      <input type="text" style="width: 30%;" data-field="cell_phone" value="{{ cell_phone }}">
    </div>
  </div>

  <div class="form-row">
    <div>
      <label>Are you a member of UNITY?</label>
      <input type="text" style="width: 50%;" data-field="are_you_a_member_of_unity" value="{{ are_you_a_member_of_unity }}">
      <label>Yes</label>
      <input type="text" style="width: 10%;" data-field="yes" value="{{ yes }}">
      <label>No</label>
      <input type="text" style="width: 10%;" data-field="no" value="{{ no }}">
    </div>
  </div>

  <div class="divider"></div>

  <h3>Leadership and/or Service in the LGBTQIA+ community</h3>

  <table>
    <thead>
      <tr>
        <th style="width: 30%;">Name of organization</th>
        <th style="width: 30%;">In which academic years did you participate?</th>
        <th style="width: 40%;">Is it ongoing, monthly, or was it a one-time event?</th>
      </tr>
    </thead>
    <tbody>
      {% for item in leadership_experiences %}
      <tr>
        <td><span data-field="leadership_experiences[{{ loop.index0 }}].organization_name">{{ item.organization_name }}</span></td>
        <td><span data-field="leadership_experiences[{{ loop.index0 }}].years">{{ item.years }}</span></td>
        <td><span data-field="leadership_experiences[{{ loop.index0 }}].frequency">{{ item.frequency }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <p style="margin-top: 20px;">Use a separate sheet of paper, if necessary.</p>

  <div class="signature-section">
    <p>Attach a statement of financial need: a 1-page essay explaining your family financial status.</p>
    <div class="form-row" style="margin-top: 40px;">
      <div style="flex: 1;">
        <label>Student Signature</label>
        <div style="border-bottom: 1px solid black; margin-top: 50px;" data-field="student_signature">{{ student_signature }}</div>
      </div>
      <div style="flex: 1; text-align: right;">
        <label>Date</label>
        <div style="border-bottom: 1px solid black; margin-top: 50px;" data-field="date">{{ date }}</div>
      </div>
    </div>
    <p style="margin-top: 50px;">Return the completed application by <span data-field="return_date">{{ return_date }}</span> to the WIU Scholarship Office, <span data-field="employer.address_line_2">{{ employer.address_line_2 }}</span>.</p>
  </div>
</div>