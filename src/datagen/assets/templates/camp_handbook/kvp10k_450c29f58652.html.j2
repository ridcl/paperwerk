<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Camp Parent Handbook</title>
<style>
  @page { size: A4; margin: 0; }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; font-size: 13px; color: #000; background: #fff; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    border: 3px solid #1a237e;
  }
  .page:last-child { page-break-after: auto; }
  .page-footer {
    position: absolute;
    bottom: 28px;
    left: 60px;
    right: 60px;
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: #000;
  }
  /* Page 1 */
  .cover-title {
    text-align: center;
    margin-top: 40px;
    font-size: 36px;
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
    font-weight: normal;
    line-height: 1.3;
    color: #000;
  }
  .cover-logo-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 40px 0 40px 0;
  }
  .cover-logo-circle {
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: #1a237e;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }
  .cover-logo-c {
    font-size: 200px;
    font-weight: bold;
    font-family: Arial, Helvetica, sans-serif;
    color: #f5a623;
    text-shadow: -6px 0 0 #fff, -10px 0 0 #1a237e;
    line-height: 1;
    letter-spacing: -10px;
    padding-right: 20px;
  }
  .cover-contact {
    text-align: center;
    font-size: 13px;
    line-height: 1.8;
  }
  .cover-contact a {
    color: #1a237e;
  }
  /* Page 2 */
  .letter-logo-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 30px;
  }
  .letter-logo-c-outer {
    width: 200px;
    height: 140px;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .letter-logo-c-shape {
    font-size: 120px;
    font-weight: bold;
    font-family: Arial, Helvetica, sans-serif;
    color: #f5a623;
    text-shadow: -4px 0 0 #fff, -7px 0 0 #1a237e;
    line-height: 1;
  }
  .letter-body p {
    margin-bottom: 16px;
    line-height: 1.6;
    font-size: 13px;
  }
  .letter-signature {
    margin-top: 10px;
    line-height: 1.8;
    font-size: 13px;
  }
  /* Page 3 - TOC */
  .toc-title {
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 20px;
    font-family: "Liberation Sans", "DejaVu Sans", Arial, Helvetica, sans-serif;
  }
  .toc-entry {
    display: flex;
    justify-content: space-between;
    margin-bottom: 6px;
    font-size: 13px;
  }
  .toc-dots {
    flex: 1;
    border-bottom: 1px dotted #000;
    margin: 0 4px 4px 4px;
  }
  /* Page 4 - Mission */
  .section-title {
    font-size: 22px;
    font-weight: bold;
    margin-bottom: 14px;
    font-family: "Liberation Sans", "DejaVu Sans", Arial, Helvetica, sans-serif;
  }
  .section-body {
    font-size: 13px;
    line-height: 1.6;
    margin-bottom: 14px;
  }
  .core-values-list {
    margin-left: 40px;
    margin-bottom: 14px;
  }
  .core-values-list p {
    margin-bottom: 6px;
    font-size: 13px;
    line-height: 1.5;
  }
  /* Page 5 - Camp Overview */
  .week-block {
    margin-bottom: 8px;
  }
  .week-label {
    font-weight: bold;
    font-size: 13px;
    margin-bottom: 2px;
  }
  .week-bullets {
    list-style: disc;
    margin-left: 40px;
    font-size: 13px;
    line-height: 1.6;
  }
  /* Page 6 - Typical Day / Field Trips */
  .field-trip-list {
    list-style: disc;
    margin-left: 40px;
    font-size: 13px;
    line-height: 1.7;
  }
  /* Page 7 - Drop Off */
  .dropoff-time {
    font-size: 13px;
    margin-bottom: 8px;
    line-height: 1.6;
  }
  /* Page 8 - Participant Records */
  .records-list {
    list-style: disc;
    margin-left: 40px;
    font-size: 13px;
    line-height: 1.8;
    margin-bottom: 16px;
  }
</style>

<style>
  @page { size: A4; margin: 0; }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; font-size: 13px; color: #000; background: #fff; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    border: 3px solid #1a237e;
  }
  .page:last-child { page-break-after: auto; }
  .page-footer {
    position: absolute;
    bottom: 28px;
    left: 60px;
    right: 60px;
    display: flex;
    justify-content: space-between;
    font-size: 11.5px;
    color: #000;
  }
  h2 {
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
    font-size: 22px;
    font-weight: bold;
    margin-bottom: 12px;
    margin-top: 10px;
  }
  p {
    font-size: 13px;
    line-height: 1.5;
    margin-bottom: 10px;
  }
  ul {
    margin-left: 30px;
    margin-bottom: 10px;
  }
  ul li {
    font-size: 13px;
    line-height: 1.6;
    list-style-type: disc;
  }
  ul.circle-list li {
    list-style-type: circle;
    margin-left: 20px;
  }
  .section-gap { margin-top: 18px; }
  /* Contacts table */
  .contacts-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 18px;
  }
  .contacts-table th {
    background: #fff;
    font-weight: bold;
    font-size: 14px;
    text-align: center;
    border: 1.5px solid #000;
    padding: 8px 12px;
  }
  .contacts-table td {
    border: 1.5px solid #000;
    padding: 8px 12px;
    vertical-align: top;
    font-size: 13px;
    line-height: 1.5;
  }
  .contacts-table td a, .contacts-table td .email-link {
    color: #1a237e;
    text-decoration: none;
  }
  /* Thank you page */
  .thankyou-logo {
    text-align: center;
    margin-bottom: 30px;
    margin-top: 10px;
  }
  .thankyou-logo svg {
    width: 140px;
    height: 140px;
  }
  .thankyou-heading {
    text-align: center;
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
    font-size: 26px;
    font-weight: normal;
    margin-bottom: 20px;
  }
  .bold-label { font-weight: bold; }
</style>
</head>
<body>

<!-- PAGE 1: Cover -->
<div class="page">
  <div class="cover-title">
    <span data-field="university_name">{{ university_name }}</span><br>
    <span data-field="department_name">{{ department_name }}</span>
  </div>
  <div class="cover-logo-wrap">
    <div class="cover-logo-circle">
      <span class="cover-logo-c">C</span>
    </div>
  </div>
  <div class="cover-contact">
    <strong>Website:</strong>&nbsp;<a href="#"><span data-field="website_url">{{ website_url }}</span></a><br>
    <strong>Main Office:</strong>&nbsp;<span data-field="main_office_phone">{{ main_office_phone }}</span><br>
    <strong>Address:</strong><br>
    <span data-field="address.line1">{{ address.line1 }}</span><br>
    <span data-field="address.line2">{{ address.line2 }}</span><br>
    <span data-field="address.line3">{{ address.line3 }}</span><br>
    <span data-field="address.city_state_zip">{{ address.city_state_zip }}</span>
  </div>
  <div class="page-footer">
    <span><span data-field="handbook_title">{{ handbook_title }}</span></span>
    <span>1</span>
  </div>
</div>

<!-- PAGE 2: Welcome Letter -->
<div class="page">
  <div class="letter-logo-wrap">
    <div class="letter-logo-c-outer">
      <span class="letter-logo-c-shape">C</span>
    </div>
  </div>
  <div class="letter-body">
    <p>Dear Parent(s) and Guardian(s),</p>
    <p><span data-field="welcome_paragraph_1">{{ welcome_paragraph_1 }}</span></p>
    <p><span data-field="welcome_paragraph_2">{{ welcome_paragraph_2 }}</span></p>
    <p><span data-field="welcome_paragraph_3">{{ welcome_paragraph_3 }}</span></p>
  </div>
  <div class="letter-signature">
    <p>Sincerely,</p>
    <br>
    <p><span data-field="director_name">{{ director_name }}</span></p>
    <br>
    <p><span data-field="director_title_line1">{{ director_title_line1 }}</span></p>
    <p><span data-field="director_title_line2">{{ director_title_line2 }}</span></p>
    <p><span data-field="director_title_line3">{{ director_title_line3 }}</span></p>
  </div>
  <div class="page-footer">
    <span><span data-field="handbook_title">{{ handbook_title }}</span></span>
    <span>2</span>
  </div>
</div>

<!-- PAGE 3: Table of Contents -->
<div class="page">
  <div class="toc-title">Table of Contents:</div>
  {% for entry in toc_entries %}
  <div class="toc-entry">
    <span data-field="toc_entries[{{ loop.index0 }}].label">{{ entry.label }}</span>
    <span class="toc-dots"></span>
    <span data-field="toc_entries[{{ loop.index0 }}].page_number">{{ entry.page_number }}</span>
  </div>
  {% endfor %}
  <div class="page-footer">
    <span><span data-field="handbook_title">{{ handbook_title }}</span></span>
    <span>3</span>
  </div>
</div>

<!-- PAGE 4: Mission and Core Values / Summer Camp Staff -->
<div class="page">
  <div class="section-title">Mission and Core Values:</div>
  <div class="section-body">
    <span data-field="mission_intro">{{ mission_intro }}</span>
  </div>
  <div class="section-body">
    <strong>Mission Statement:</strong>&nbsp;<span data-field="mission_statement">{{ mission_statement }}</span>
  </div>
  <div class="section-body">
    <strong>Core Values:</strong>
    <div class="core-values-list">
      {% for cv in core_values %}
      <p><strong><span data-field="core_values[{{ loop.index0 }}].name">{{ cv.name }}</span></strong> – <span data-field="core_values[{{ loop.index0 }}].description">{{ cv.description }}</span></p>
      {% endfor %}
    </div>
  </div>

  <div class="section-title">Summer Camp Staff:</div>
  <div class="section-body">
    <span data-field="staff_paragraph_1">{{ staff_paragraph_1 }}</span>
  </div>
  <div class="section-body">
    <span data-field="staff_paragraph_2">{{ staff_paragraph_2 }}</span>
  </div>
  <div class="page-footer">
    <span><span data-field="handbook_title">{{ handbook_title }}</span></span>
    <span>4</span>
  </div>
</div>

<!-- PAGE 5: Camp Overview -->
<div class="page">
  <div class="section-title">Camp Overview:</div>
  {% for week in camp_weeks %}
  <div class="week-block">
    <div class="week-label">Week # <span data-field="camp_weeks[{{ loop.index0 }}].number">{{ week.number }}</span>:</div>
    <ul class="week-bullets">
      <li><strong>Theme:</strong>&nbsp;<span data-field="camp_weeks[{{ loop.index0 }}].theme">{{ week.theme }}</span></li>
      <li><strong>Dates:</strong>&nbsp;<span data-field="camp_weeks[{{ loop.index0 }}].dates">{{ week.dates }}</span></li>
      <li><strong>Special Activities:</strong>&nbsp;<span data-field="camp_weeks[{{ loop.index0 }}].special_activities">{{ week.special_activities }}</span></li>
      <li><strong>Field Trip:</strong>&nbsp;<span data-field="camp_weeks[{{ loop.index0 }}].field_trip">{{ week.field_trip }}</span></li>
    </ul>
  </div>
  {% endfor %}
  <div class="page-footer">
    <span><span data-field="handbook_title">{{ handbook_title }}</span></span>
    <span>5</span>
  </div>
</div>

<!-- PAGE 6: A Typical Day / Field Trips -->
<div class="page">
  <div class="section-title">A Typical Day:</div>
  <div class="section-body">
    <span data-field="typical_day_text">{{ typical_day_text }}</span>
  </div>

  <div class="section-title">Field Trips:</div>
  <div class="section-body">
    <span data-field="field_trips_paragraph_1">{{ field_trips_paragraph_1 }}</span>
  </div>
  <div class="section-body">
    <span data-field="field_trips_paragraph_2">{{ field_trips_paragraph_2 }}</span>
  </div>
  <div class="section-body">
    <span data-field="field_trips_paragraph_3">{{ field_trips_paragraph_3 }}</span>
  </div>
  <div class="section-body"><strong>Field Trips:</strong></div>
  <ul class="field-trip-list">
    {% for ft in field_trip_list %}
    <li>
      <strong><span data-field="field_trip_list[{{ loop.index0 }}].theme">{{ ft.theme }}</span></strong>
      – <span data-field="field_trip_list[{{ loop.index0 }}].dates">{{ ft.dates }}</span>
      – <span data-field="field_trip_list[{{ loop.index0 }}].destination">{{ ft.destination }}</span>
    </li>
    {% endfor %}
  </ul>
  <div class="page-footer">
    <span><span data-field="handbook_title">{{ handbook_title }}</span></span>
    <span>6</span>
  </div>
</div>

<!-- PAGE 7: Drop Off and Pick Up -->
<div class="page">
  <div class="section-title">Drop Off and Pick Up:</div>
  <div class="dropoff-time">
    <strong>Drop Off Time:</strong>&nbsp;<span data-field="drop_off_time">{{ drop_off_time }}</span>
  </div>
  <div class="dropoff-time">
    <strong>Pick Up Time:</strong>&nbsp;<span data-field="pick_up_time">{{ pick_up_time }}</span>
  </div>
  <div class="section-body">
    <span data-field="drop_off_paragraph_1">{{ drop_off_paragraph_1 }}</span>
  </div>
  <div class="section-body">
    <span data-field="drop_off_paragraph_2">{{ drop_off_paragraph_2 }}</span>
  </div>
  <div class="section-body">
    <span data-field="drop_off_paragraph_3">{{ drop_off_paragraph_3 }}</span>
  </div>

  <div class="section-title">Authorized Adults:</div>
  <div class="section-body">
    <span data-field="authorized_adults_text">{{ authorized_adults_text }}</span>
  </div>

  <div class="section-title">Late Pick Up:</div>
  <div class="section-body">
    <span data-field="late_pickup_text">{{ late_pickup_text }}</span>
  </div>

  <div class="section-title">Early Drop Off:</div>
  <div class="section-body">
    <span data-field="early_dropoff_text">{{ early_dropoff_text }}</span>
  </div>

  <div class="page-footer">
    <span><span data-field="handbook_title">{{ handbook_title }}</span></span>
    <span>7</span>
  </div>
</div>

<!-- PAGE 8: Participant Records -->
<div class="page">
  <div class="section-title">Participant Records:</div>
  <div class="section-body">
    <span data-field="participant_records_intro">{{ participant_records_intro }}</span>
  </div>
  <ul class="records-list">
    {% for doc in required_documents %}
    <li><span data-field="required_documents[{{ loop.index0 }}]">{{ doc }}</span></li>
    {% endfor %}
  </ul>
  <div class="section-body">
    <span data-field="participant_records_body">{{ participant_records_body }}</span>
  </div>
  <div class="page-footer">
    <span><span data-field="handbook_title">{{ handbook_title }}</span></span>
    <span>8</span>
  </div>
</div>




<!-- PAGE 1: Items to send / not to send -->
<div class="page">
  <h2>Items to send with your camper:</h2>
  <p><span data-field="items_send_intro">{{ items_send_intro }}</span></p>

  <ul>
    {% for item in items_to_send %}
    <li><span data-field="items_to_send[{{ loop.index0 }}]">{{ item }}</span></li>
    {% endfor %}
  </ul>

  <h2 class="section-gap">Items not to send with your camper:</h2>

  <ul>
    {% for item in items_not_to_send %}
    <li>
      <span data-field="items_not_to_send[{{ loop.index0 }}].label">{{ item.label }}</span>
      {% if item.subitems %}
      <ul class="circle-list">
        {% for sub in item.subitems %}
        <li><span data-field="items_not_to_send[{{ loop.index0 }}].subitems[{{ loop.index0 }}]">{{ sub }}</span></li>
        {% endfor %}
      </ul>
      {% endif %}
    </li>
    {% endfor %}
  </ul>

  <div class="page-footer">
    <span><span data-field="handbook_title_p1">{{ handbook_title_p1 }}</span></span>
    <span><span data-field="page_number_p1">{{ page_number_p1 }}</span></span>
  </div>
</div>

<!-- PAGE 2: T-Shirt -->
<div class="page">
  <h2>T-Shirt:</h2>
  <br>
  <p><span data-field="tshirt_description">{{ tshirt_description }}</span></p>

  <div style="text-align:center; margin-top: 40px;">
    <div style="display:inline-block; position:relative; width:320px; height:340px;">
      <!-- Front shirt placeholder -->
      <div style="position:absolute; left:0; top:0; width:200px; height:240px; background:#00aacc; border-radius:20px 20px 10px 10px; opacity:0.85;"></div>
      <!-- Back shirt placeholder -->
      <div style="position:absolute; left:110px; top:130px; width:160px; height:190px; background:#00aacc; border-radius:16px 16px 8px 8px; opacity:0.75;"></div>
    </div>
  </div>

  <div class="page-footer">
    <span><span data-field="handbook_title_p2">{{ handbook_title_p2 }}</span></span>
    <span><span data-field="page_number_p2">{{ page_number_p2 }}</span></span>
  </div>
</div>

<!-- PAGE 3: Medications -->
<div class="page">
  <h2>Medications:</h2>
  <p><span data-field="medications_intro">{{ medications_intro }}</span></p>

  <p>All medications must:</p>
  <ul>
    {% for req in medication_requirements %}
    <li><span data-field="medication_requirements[{{ loop.index0 }}]">{{ req }}</span></li>
    {% endfor %}
  </ul>

  <div class="page-footer">
    <span><span data-field="handbook_title_p3">{{ handbook_title_p3 }}</span></span>
    <span><span data-field="page_number_p3">{{ page_number_p3 }}</span></span>
  </div>
</div>

<!-- PAGE 4: COVID-19 -->
<div class="page">
  <h2>COVID-19:</h2>
  <p><span class="bold-label">Camp COVID Protocols:</span> <span data-field="covid_protocols_intro">{{ covid_protocols_intro }}</span></p>

  <ul>
    {% for protocol in covid_protocols %}
    <li>
      <span class="bold-label">{{ protocol.title }}:</span>
      <span data-field="covid_protocols[{{ loop.index0 }}].description">{{ protocol.description }}</span>
      {% if protocol.subitems %}
      <ul class="circle-list">
        {% for sub in protocol.subitems %}
        <li><span data-field="covid_protocols[{{ loop.index0 }}].subitems[{{ loop.index0 }}]">{{ sub }}</span></li>
        {% endfor %}
      </ul>
      {% endif %}
    </li>
    {% endfor %}
  </ul>

  <div class="page-footer">
    <span><span data-field="handbook_title_p4">{{ handbook_title_p4 }}</span></span>
    <span><span data-field="page_number_p4">{{ page_number_p4 }}</span></span>
  </div>
</div>

<!-- PAGE 5: Illness/Injuries & Confidentiality -->
<div class="page">
  <h2>Illness/Injuries:</h2>
  <p><span data-field="illness_intro_1">{{ illness_intro_1 }}</span></p>
  <p><span data-field="illness_intro_2">{{ illness_intro_2 }}</span></p>
  <p><span data-field="illness_intro_3">{{ illness_intro_3 }}</span></p>

  <ul>
    {% for symptom in illness_symptoms %}
    <li><span data-field="illness_symptoms[{{ loop.index0 }}]">{{ symptom }}</span></li>
    {% endfor %}
  </ul>

  <h2 class="section-gap">Confidentiality:</h2>
  <p><span data-field="confidentiality_para_1">{{ confidentiality_para_1 }}</span></p>
  <p><span data-field="confidentiality_para_2">{{ confidentiality_para_2 }}</span></p>

  <div class="page-footer">
    <span><span data-field="handbook_title_p5">{{ handbook_title_p5 }}</span></span>
    <span><span data-field="page_number_p5">{{ page_number_p5 }}</span></span>
  </div>
</div>

<!-- PAGE 6: Disciplinary Policy & Actions -->
<div class="page">
  <h2>Disciplinary Policy:</h2>
  <p><span data-field="disciplinary_policy_intro">{{ disciplinary_policy_intro }}</span></p>

  <p>The following behaviors will not be tolerated at camp:</p>
  <ul>
    {% for behavior in prohibited_behaviors %}
    <li><span data-field="prohibited_behaviors[{{ loop.index0 }}]">{{ behavior }}</span></li>
    {% endfor %}
  </ul>

  <h2 class="section-gap">Disciplinary Actions:</h2>
  <p><span data-field="disciplinary_actions_intro">{{ disciplinary_actions_intro }}</span></p>
  <ul>
    {% for action in disciplinary_actions %}
    <li>
      <span class="bold-label">{{ action.title }}:</span>
      <span data-field="disciplinary_actions[{{ loop.index0 }}].description">{{ action.description }}</span>
    </li>
    {% endfor %}
  </ul>

  <p style="margin-top:14px;"><span class="bold-label">Note:</span> <span data-field="disciplinary_note">{{ disciplinary_note }}</span></p>

  <div class="page-footer">
    <span><span data-field="handbook_title_p6">{{ handbook_title_p6 }}</span></span>
    <span><span data-field="page_number_p6">{{ page_number_p6 }}</span></span>
  </div>
</div>

<!-- PAGE 7: Contacts -->
<div class="page">
  <h2 style="font-size:20px; margin-bottom:6px;">
    <span data-field="contacts_section_title">{{ contacts_section_title }}</span>
  </h2>

  <table class="contacts-table">
    <thead>
      <tr>
        <th style="width:50%;">Staff Member:</th>
        <th style="width:50%;">Phone &amp; Email:</th>
      </tr>
    </thead>
    <tbody>
      {% for contact in camp_contacts %}
      <tr>
        <td>
          <span data-field="camp_contacts[{{ loop.index0 }}].name">{{ contact.name }}</span><br>
          <span data-field="camp_contacts[{{ loop.index0 }}].title">{{ contact.title }}</span>
        </td>
        <td>
          <span data-field="camp_contacts[{{ loop.index0 }}].phone">{{ contact.phone }}</span><br>
          <span class="email-link" data-field="camp_contacts[{{ loop.index0 }}].email">{{ contact.email }}</span>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="page-footer">
    <span><span data-field="handbook_title_p7">{{ handbook_title_p7 }}</span></span>
    <span><span data-field="page_number_p7">{{ page_number_p7 }}</span></span>
  </div>
</div>

<!-- PAGE 8: Thank You -->
<div class="page">
  <div class="thankyou-logo">
    <!-- Placeholder for camp logo -->
    <svg viewBox="0 0 140 140" xmlns="http://www.w3.org/2000/svg">
      <circle cx="70" cy="70" r="68" fill="#fff" stroke="#1a237e" stroke-width="2"/>
      <path d="M100 30 Q40 30 30 70 Q40 110 100 110 L100 90 Q55 90 50 70 Q55 50 100 50 Z" fill="#f5a800" stroke="#1a237e" stroke-width="3"/>
    </svg>
  </div>

  <div class="thankyou-heading">Thank You!</div>

  <p><span data-field="thankyou_paragraph">{{ thankyou_paragraph }}</span></p>

  <p style="margin-top:16px;">Sincerely,</p>
  <p style="margin-top:14px;"><span data-field="closing_name">{{ closing_name }}</span></p>
  <p style="margin-top:14px;">
    <span data-field="closing_title">{{ closing_title }}</span><br>
    <span data-field="closing_organization">{{ closing_organization }}</span>
  </p>

  <div class="page-footer">
    <span><span data-field="handbook_title_p8">{{ handbook_title_p8 }}</span></span>
    <span><span data-field="page_number_p8">{{ page_number_p8 }}</span></span>
  </div>
</div>

</body>
</html>