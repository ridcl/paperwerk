  </div>

  <div style="margin-bottom: 20px;">
    <p>✅ Agreement completed.</p>
    <p>Date: <span>{{ completion_date_time }}</span></p>
  </div>

  <div style="margin-top: 50px; text-align: center;">
    <img src="adobe_acrobat_sign_logo.png" alt="Adobe Acrobat Sign" style="max-width: 200px;">
  </div>
</div>