<!DOCTYPE html>
<html>
<head>
    <title>Annual Report</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif; }
        .header-logo { font-size: 24px; font-weight: bold; }
        .report-title { font-size: 36px; font-weight: bold; }
        .section-title { font-size: 24px; font-weight: bold; margin-bottom: 15px; }
        .data-point { font-size: 16px; line-height: 1.6; }
        .list-item { margin-bottom: 8px; }
        .chart-container { width: 100%; height: 300px; margin-top: 20px; }
        .table-header { font-weight: bold; }
    </style>

<style>
        @page { size: A4; margin: 0; }
