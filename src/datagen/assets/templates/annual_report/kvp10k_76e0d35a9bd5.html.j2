<!DOCTYPE html>
<html>
<head>
<title>Year in Review</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .header-title {
    font-size: 36pt;
    font-weight: bold;
    line-height: 1.1;
  }
  .subtitle {
    font-size: 18pt;
    font-weight: normal;
  }
  .section-title {
    font-size: 24pt;
    font-weight: bold;
    margin-bottom: 20px;
  }
  .mission-value-item {
    text-align: center;
    margin-bottom: 30px;
  }
  .mission-value-icon {
    font-size: 48pt;
    margin-bottom: 10px;
  }
  .mission-value-text {
    font-size: 12pt;
    font-weight: bold;
  }
  .content-block {
    line-height: 1.6;
    font-size: 11pt;
    margin-bottom: 20px;
  }
  .two-column-layout {
    display: flex;
    gap: 40px;
    margin-top: 30px;
  }
  .column {
    flex: 1;
  }
  .stat-box {
    border: 1px solid #ccc;
    padding: 15px;
    margin-bottom: 15px;
    text-align: center;
  }
  .stat-value {
    font-size: 36pt;
    font-weight: bold;
    display: block;
  }
  .stat-label {
    font-size: 10pt;
    text-transform: uppercase;
  }
  .list-item {
    margin-bottom: 10px;
    font-size: 11pt;
  }
  .list-item strong {
    font-weight: bold;
  }
  .footer-text {
    font-size: 9pt;
    text-align: center;
    margin-top: 50px;
  }
</style>
</head>
