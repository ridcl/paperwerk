      <div style="border-top: 1px solid #ccc; padding-top: 10px;">
        REGISTER
      </div>
    </div>
  </div>
</div>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div style="width: 70%;">
      <div style="text-align: center; margin-bottom: 30px;">
        <img src="placeholder_logo.png" alt="Knight Cancer Institute Logo" style="max-width: 200px; height: auto;">
        <p style="font-size: 11pt; margin-top: 10px;">
          <span data-field="institute_name">{{ institute_name }}</span>
        </p>
        <p style="font-size: 10pt;">
          <span data-field="institute_address_line_1">{{ institute_address_line_1 }}</span><br>
          <span data-field="institute_address_line_2">{{ institute_address_line_2 }}</span><br>
          <span data-field="institute_city_state_zip">{{ institute_city_state_zip }}</span>
        </p>
        <p style="font-size: 10pt;">
          <span data-field="institute_phone">{{ institute_phone }}</span> | <span data-field="institute_website">{{ institute_website }}</span>
        </p>
      </div>
      
      <h3 style="font-size: 14pt; margin-bottom: 10px;">OHSU Leadership Team</h3>
      <table style="font-size: 10pt;">
        <thead>
          <tr>
            <th style="text-align: left;">Name</th>
            <th style="text-align: left;">Title</th>
          </tr>
        </thead>
        <tbody>
          {% for leader in leadership_members %}
          <tr>
            <td><span data-field="leadership_members[{{ loop.index0 }}].name">{{ leadership_members[loop.index0].name }}</span></td>
            <td><span data-field="leadership_members[{{ loop.index0 }}].title">{{ leadership_members[loop.index0].title }}</span></td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <div style="width: 30%; text-align: right; padding-top: 100px; font-size: 10pt; line-height: 1.4;">
      <div style="border-top: 1px solid #ccc; padding-top: 10px;">
        CANCER ANNUAL REPORT 2013
      </div>
      <div style="text-align: right; margin-top: 10px;">
        <span data-field="page_number">{{ page_number }}</span>
      </div>
    </div>
  </div>
</div>

</body>
</html>