<!DOCTYPE html>
<html>
<head>
    <title>Tuition Discount Verification Form</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 { margin-top: 0; }
        .header-logo { float: left; margin-right: 20px; }
        .header-title { font-size: 24pt; font-weight: bold; }
        .section-heading { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
        .signature-line { border-bottom: 1px solid black; width: 50%; margin-top: 5px; }
        .form-row { display: flex; align-items: center; margin-bottom: 15px; }
        .form-row > div { flex: 1; }
        .form-label { font-weight: normal; }
    </style>
</head>
<body>
    <div class="page">
        <div style="text-align: center; margin-bottom: 30px;">
            <div class="header-logo">
                <!-- Placeholder for logo -->
            </div>
            <div class="header-title">Widener University</div>
            <div style="font-size: 10pt;">Graduate and Continuing Studies</div>
        </div>

        <div style="text-align: center; margin-bottom: 40px;">
            <h2 style="font-size: 14pt;">Penn Medicine</h2>
            <h3 style="font-size: 12pt;">Tuition Discount Verification Form</h3>
        </div>

        <div class="form-row">
            <div style="width: 100px;">Year:</div>
            <div style="flex: 1;">
                <span data-field="year">{{ year }}</span>
            </div>
            <div style="width: 150px;">Term (Select one):</div>
            <div style="flex: 1;">
                <input type="radio" name="term" value="Fall"> Fall
                <input type="radio" name="term" value="Spring"> Spring
                <input type="radio" name="term" value="Summer"> Summer
            </div>
        </div>

        <div class="section-heading">Section A. (Completed by student)</div>

        <p style="margin-top: 15px;">I hereby authorize certification of my employment status to Widener University.</p>

        <div class="form-row">
            <div style="width: 150px;">Print Name:</div>
            <div style="flex: 1;"><span data-field="full_name">{{ full_name }}</span></div>
        </div>

        <div class="form-row">
            <div style="width: 150px;">Student ID:</div>
            <div style="flex: 1;"><span data-field="student_id">{{ student_id }}</span></div>
            <div style="width: 150px;">Program:</div>
            <div style="flex: 1;">
                <input type="radio" name="program" value="Undergraduate"> Undergraduate
                <input type="radio" name="program" value="Graduate"> Graduate
            </div>
        </div>

        <div class="form-row">
            <div style="width: 150px;">Signature:</div>
            <div style="flex: 1;"><div class="signature-line" data-field="signature">{{ signature }}</div></div>
            <div style="width: 150px;">Date:</div>
            <div style="flex: 1;"><span data-field="date_a">{{ date_a }}</span></div>
        </div>

        <div class="section-heading">Section B. (Completed by employer)</div>

        <div style="margin-top: 15px; padding: 10px; border: 1px solid #ccc;">
            <p>I certify that the above named student is an employee of Penn Medicine and eligible for tuition discounts as outlined in the official Memorandum of Understanding between Widener University and Penn Medicine.</p>
        </div>

        <div class="form-row" style="margin-top: 30px;">
            <div style="width: 150px;">Signature:</div>
            <div style="flex: 1;"><div class="signature-line" data-field="signature_2">{{ signature_2 }}</div></div>
            <div style="width: 150px;">Date:</div>
            <div style="flex: 1;"><span data-field="date_b">{{ date_b }}</span></div>
        </div>

        <div class="form-row" style="margin-top: 20px;">
            <div style="width: 150px;">Title:</div>
            <div style="flex: 1;"><div class="signature-line" data-field="title">{{ title }}</div></div>
        </div>

        <div style="margin-top: 50px;">
            <p>Submit form for each semester enrolled via mail, fax, or email to:</p>
            <p>Widener University</p>
            <p>Graduate and Continuing Studies</p>
            <p><span data-field="address_line_1">{{ address_line_1 }}</span></p>
            <p><span data-field="address_line_2">{{ address_line_2 }}</span></p>
            <p>Phone: <span data-field="phone_number">{{ phone_number }}</span></p>
            <p>Fax: <span data-field="fax_number">{{ fax_number }}</span></p>
        </div>
    </div>
</body>
</html>