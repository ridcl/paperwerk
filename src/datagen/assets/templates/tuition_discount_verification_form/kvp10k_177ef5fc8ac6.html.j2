<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; }
  h1, h2, h3 { font-weight: bold; }
  .form-line { border-bottom: 1px solid #000; display: inline-block; width: 70%; }
  .checkbox-group label { margin-right: 15px; }
</style>

<div class="page">
  <div style="text-align: center; margin-bottom: 40px;">
    <img src="placeholder_logo.png" alt="Logo" style="height: 50px; margin-bottom: 10px;">
    <h1 style="font-size: 24pt;">Widener University</h1>
    <h2 style="font-size: 14pt;">Philadelphia Academy Charter High School</h2>
    <h3 style="font-size: 12pt;">Tuition Discount Verification Form</h3>
  </div>

  <div style="margin-bottom: 30px;">
    <p>Year: <span class="form-line" style="width: 150px;">{{ year }}</span></p>
    <p>Term (Select one):
      <span class="checkbox-group">
        <input type="checkbox" id="fall" name="term" value="Fall"> <label for="fall">Fall</label>
        <input type="checkbox" id="spring" name="term" value="Spring"> <label for="spring">Spring</label>
        <input type="checkbox" id="summer" name="term" value="Summer"> <label for="summer">Summer</label>
      </span>
    </p>
  </div>

  <hr style="border: 0; border-top: 1px solid #000; margin-bottom: 30px;">

  <h2 style="font-size: 14pt;">Section A. (Completed by the student)</h2>

  <p style="margin-bottom: 20px;">I hereby authorize certification of my employment status to Widener University.</p>

  <div style="margin-bottom: 20px;">
    <p>Name of Employee: <span class="form-line" style="width: 400px;">{{ employee_full_name }}</span></p>
  </div>

  <div style="margin-bottom: 20px;">
    <p>Relationship to Student:
      <span class="checkbox-group">
        <input type="checkbox" id="self" name="relationship" value="Self"> <label for="self">Self</label>
        <input type="checkbox" id="spouse" name="relationship" value="Spouse"> <label for="spouse">Spouse</label>
        <input type="checkbox" id="dependent" name="relationship" value="Dependent"> <label for="dependent">Dependent</label>
      </span>
    </p>
  </div>

  <div style="margin-bottom: 20px;">
    <p>Student ID: <span class="form-line" style="width: 150px;">{{ student_id }}</span></p>
    <p>Program:
      <span class="checkbox-group">
        <input type="checkbox" id="undergrad" name="program" value="Undergraduate"> <label for="undergrad">Undergraduate</label>
        <input type="checkbox" id="graduate" name="program" value="Graduate"> <label for="graduate">Graduate</label>
      </span>
    </p>
  </div>

  <div style="margin-bottom: 30px;">
    <p>Student Signature: <span class="form-line" style="width: 300px;">{{ student_signature }}</span> Date: <span class="form-line" style="width: 150px;">{{ date_signed }}</span></p>
  </div>

  <hr style="border: 0; border-top: 1px solid #000; margin-bottom: 30px;">

  <h2 style="font-size: 14pt;">Section B. (Completed by the employer)</h2>

  <div style="margin-bottom: 20px;">
    <p>I certify that the above named student is an employee of the Philadelphia Academy Charter High School and is eligible for tuition discounts as outlined in the official Memorandum of Understanding between Widener University and Philadelphia Academy Charter High School.</p>
  </div>

  <div style="margin-bottom: 30px;">
    <p>Signature: <span class="form-line" style="width: 300px;">{{ employer_signature }}</span> Date: <span class="form-line" style="width: 150px;">{{ date_employer_signed }}</span></p>
    <p>Print Name: <span class="form-line" style="width: 400px;">{{ employer_full_name }}</span></p>
  </div>

  <div style="margin-top: 50px; font-size: 10pt;">
    <p>Submit for each semester enrolled via mail, fax, or email to:</p>
    <p>Widener University</p>
    <p>{{ university_name }}</p>
    <p>{{ university_address_line1 }}</p>
    <p>{{ university_address_line2 }}</p>
    <p>{{ university_city_state_zip }}</p>
    <p>Email: {{ university_email }}</p>
    <p>Fax: {{ university_fax }}</p>
  </div>
</div>