<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
  }
  td {
    padding: 8px 0;
    vertical-align: top;
  }
  .header-row td {
    font-weight: bold;
  }
</style>

<div class="page">
  <div style="text-align: right;">
    <p style="font-size: 12pt; margin: 0;">IORG Number: <span data-field="iorg_number">{{ iorg_number }}</span></p>
    <p style="font-size: 12pt; margin: 0;">IRB NO.: <span data-field="irb_number">{{ irb_number }}</span></p>
    <p style="font-size: 12pt; margin: 0;">ASSURANCE NO.: <span data-field="assurance_number">{{ assurance_number }}</span></p>
    <p style="font-size: 12pt; margin: 0;">CURRENT MEMBERSHIP ROSTER APPROVED AS OF: <span data-field="approval_date">{{ approval_date }}</span></p>
  </div>
  <h1 style="text-align: center; font-size: 16pt; margin-bottom: 30px;">UNIVERSITY OF SOUTH CAROLINA INSTITUTIONAL REVIEW BOARD MEMBERSHIP</h1>

  <table>
    <thead>
      <tr class="header-row">
        <td style="width: 30%;">MEMBER NAME</td>
        <td style="width: 15%;">Highest Degree Earned</td>
        <td style="width: 30%;">Scientific or Non-Scientific Specialty</td>
        <td style="width: 25%;">Affiliation with Institute</td>
      </tr>
    </thead>
    <tbody>
      <!-- Voting Members -->
      <tr>
        <td style="font-weight: bold;">VOTING MEMBERS:</td>
        <td colspan="3" style="padding-top: 0;"></td>
      </tr>
      {% for member in voting_members %}
      <tr>
        <td><span data-field="voting_members[{{ loop.index0 }}].full_name">{{ member.full_name }}</span></td>
        <td><span data-field="voting_members[{{ loop.index0 }}].degree">{{ member.degree }}</span></td>
        <td><span data-field="voting_members[{{ loop.index0 }}].specialty">{{ member.specialty }}</span></td>
        <td><span data-field="voting_members[{{ loop.index0 }}].affiliation">{{ member.affiliation }}</span></td>
      </tr>
      {% endfor %}

      <!-- Alternate Members -->
      <tr>
        <td style="font-weight: bold; padding-top: 20px;">ALTERNATE MEMBERS:</td>
        <td colspan="3" style="padding-top: 0;"></td>
      </tr>
      {% for member in alternate_members %}
      <tr>
        <td><span data-field="alternate_members[{{ loop.index0 }}].full_name">{{ member.full_name }}</span></td>
        <td><span data-field="alternate_members[{{ loop.index0 }}].degree">{{ member.degree }}</span></td>
        <td><span data-field="alternate_members[{{ loop.index0 }}].specialty">{{ member.specialty }}</span></td>
        <td><span data-field="alternate_members[{{ loop.index0 }}].affiliation">{{ member.affiliation }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <p style="font-size: 9pt; margin-top: 50px;">The Office of Research Compliance (ORC) is an administrative office that supports the Institutional Review Board (IRB) / (803) 777-7095, located at <span data-field="office_address">{{ office_address }}</span></p>
</div>