<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic layout structure */
  body { font-family: "Liberation Serif", Georgia, serif; }
  h1, h2, h3 { font-weight: bold; }
  .section { margin-bottom: 30px; }
  .form-row { display: flex; align-items: center; margin-bottom: 15px; }
  .form-row label { margin-right: 10px; }
  .checkbox-group label { margin-right: 15px; }
  .divider { border-top: 1px solid #ccc; margin: 20px 0; }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      <h1 style="font-size: 24pt; margin-bottom: 10px;">I WANT TO BECOME A MEMBER OF</h1>
      <div style="font-size: 48pt; font-weight: bold; line-height: 0.9;">
        <span style="font-family: 'DejaVu Serif', serif;">Partners</span>
        <div style="font-size: 30pt; font-weight: normal;">
          for the <span style="font-family: 'DejaVu Serif', serif;">Arts</span>
        </div>
      </div>
    </div>
    <div style="text-align: right;">
      <h2 style="font-size: 14pt; margin-bottom: 10px;">METHOD OF PAYMENT</h2>
      <div class="checkbox-group">
        <label><input type="checkbox"> CASH</label>
        <label><input type="checkbox"> CHECK</label>
      </div>
      <p style="font-size: 10pt; margin-top: 15px;">Become a partner or renew online.</p>
      <p style="font-size: 10pt;">Visit <span data-field="website_url">{{ website_url }}</span>.</p>
    </div>
  </div>

  <div class="divider"></div>

  <div class="section" style="margin-top: 20px;">
    <div class="form-row">
      <label for="name">Name</label>
      <div style="flex-grow: 1; border-bottom: 1px solid #000; padding-bottom: 2px;">
        <span data-field="full_name">{{ full_name }}</span>
      </div>
    </div>
    <div class="form-row">
      <label for="address">Address</label>
      <div style="flex-grow: 1; border-bottom: 1px solid #000; padding-bottom: 2px;">
        <span data-field="address">{{ address }}</span>
      </div>
    </div>
    <div class="form-row">
      <label for="city_zip">City/State/ZIP</label>
      <div style="flex-grow: 1; border-bottom: 1px solid #000; padding-bottom: 2px;">
        <span data-field="city_state_zip">{{ city_state_zip }}</span>
      </div>
    </div>
    <div class="form-row">
      <label for="phone">Phone</label>
      <div style="flex-grow: 1; border-bottom: 1px solid #000; padding-bottom: 2px;">
        <span data-field="phone_number">{{ phone_number }}</span>
      </div>
    </div>
    <div class="form-row">
      <label for="email">Email</label>
      <div style="flex-grow: 1; border-bottom: 1px solid #000; padding-bottom: 2px;">
        <span data-field="email_address">{{ email_address }}</span>
      </div>
    </div>
  </div>

  <div class="section">
    <p style="font-size: 10pt;">In honor of <span data-field="honoree_name">{{ honoree_name }}</span> or in memory of <span data-field="deceased_name">{{ deceased_name }}</span> (name as you wish it to be listed)</p>
  </div>

  <div class="divider"></div>

  <div class="section">
    <h3 style="text-align: center;">PLEASE INDICATE A LEVEL OF GIVING</h3>
    <div style="display: flex; justify-content: space-around; margin-top: 20px;">
      <div style="text-align: center;">
        <input type="checkbox"> President's Circle ($5,000+)
      </div>
      <div style="text-align: center;">
        <input type="checkbox"> Donor ($250)
      </div>
      <div style="text-align: center;">
        <input type="checkbox"> Grand Benefactor ($2,500)
      </div>
      <div style="text-align: center;">
        <input type="checkbox"> Contributor ($150)
      </div>
      <div style="text-align: center;">
        <input type="checkbox"> Benefactor ($1,000)
      </div>
      <div style="text-align: center;">
        <input type="checkbox"> Friend ($50)
      </div>
      <div style="text-align: center;">
        <input type="checkbox"> Patron ($500)
      </div>
      <div style="text-align: center;">
        <input type="checkbox"> Other $
      </div>
    </div>
  </div>

  <div class="divider"></div>

  <div style="display: flex; justify-content: space-between;">
    <div style="width: 45%;">
      <h3 style="text-align: left;">LEGACY (Gifts for Legacy Endowment)</h3>
      <p style="font-size: 10pt;">*Over five years</p>
      <table style="width: 100%; font-size: 10pt;">
        <thead>
          <tr>
            <th style="text-align: left; padding-right: 10px;"></th>
            <th style="text-align: center;">MONTHLY</th>
            <th style="text-align: center;">ANNUALLY</th>
            <th style="text-align: center;">LEGACY SOCIETY</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><input type="checkbox"> Gold</td>
            <td style="text-align: center;"><span data-field="legacy_monthly_gold">{{ legacy_monthly_gold }}</span></td>
            <td style="text-align: center;"><span data-field="legacy_annual_gold">{{ legacy_annual_gold }}</span></td>
            <td style="text-align: center;"><span data-field="legacy_society_gold">{{ legacy_society_gold }}</span></td>
          </tr>
          <tr>
            <td><input type="checkbox"> Silver</td>
            <td style="text-align: center;"><span data-field="legacy_monthly_silver">{{ legacy_monthly_silver }}</span></td>
            <td style="text-align: center;"><span data-field="legacy_annual_silver">{{ legacy_annual_silver }}</span></td>
            <td style="text-align: center;"><span data-field="legacy_society_silver">{{ legacy_society_silver }}</span></td>
          </tr>
          <tr>
            <td><input type="checkbox"> Bronze</td>
            <td style="text-align: center;"><span data-field="legacy_monthly_bronze">{{ legacy_monthly_bronze }}</span></td>
            <td style="text-align: center;"><span data-field="legacy_annual_bronze">{{ legacy_annual_bronze }}</span></td>
            <td style="text-align: center;"><span data-field="legacy_society_bronze">{{ legacy_society_bronze }}</span></td>
          </tr>
        </tbody>
      </table>
      <p style="font-size: 9pt; margin-top: 10px;">Please note that 75% of your Legacy Gift will support the PFA Endowment.</p>
    </div>

    <div style="width: 50%; text-align: right;">
      <h3 style="text-align: right;">SIGNATURE</h3>
      <div style="height: 60px; border-bottom: 1px solid #000; margin-top: 40px;" data-field="signature">{{ signature }}</div>
      <p style="margin-top: 5px;">Printed Name</p>
    </div>
  </div>

  <div class="divider"></div>

  <div style="display: flex; justify-content: space-between; margin-top: 20px;">
    <div style="width: 50%;">
      <h3 style="text-align: left;">WOULD YOU LIKE TO DESIGNATE YOUR GIFT?</h3>
      <div style="display: flex; flex-wrap: wrap; margin-top: 15px;">
        <div style="margin-right: 20px; margin-bottom: 10px;">
          <input type="checkbox"> Friend of the Arts (all disciplines)
        </div>
        <div style="margin-right: 20px; margin-bottom: 10px;">
          <input type="checkbox"> Media and Entertainment Arts
        </div>
        <div style="margin-right: 20px; margin-bottom: 10px;">
          <input type="checkbox"> Art and Design
        </div>
        <div style="margin-right: 20px; margin-bottom: 10px;">
          <input type="checkbox"> Music
        </div>
        <div style="margin-right: 20px; margin-bottom: 10px;">
          <input type="checkbox"> Creative Writing
        </div>
        <div style="margin-right: 20px; margin-bottom: 10px;">
          <input type="checkbox"> Theatre
        </div>
        <div style="margin-right: 20px; margin-bottom: 10px;">
          <input type="checkbox"> Dance
        </div>
      </div>
    </div>

    <div style="width: 50%; text-align: right;">
      <h3 style="text-align: right; color: #000;">FOR FURTHER INFORMATION,</h3>
      <h1 style="text-align: right; font-size: 20pt; margin-top: 5px;">CALL 601.266.5095</h1>
      <p style="margin-top: 30px; font-size: 10pt;">MAIL THIS FORM WITH PAYMENT TO</p>
      <p style="font-size: 12pt; font-weight: bold;">Partners for the Arts</p>
      <p style="font-size: 10pt;">The University of Southern Mississippi</p>
      <p style="font-size: 10pt;">118 College Drive #5004</p>
      <p style="font-size: 10pt;">Hattiesburg, MS 39406</p>
      <p style="font-size: 9pt; margin-top: 20px;">*Seventy-five percent (75%) of your total contribution may be designated to an area of choice. The remainder of those funds, including undesignated funds, will be distributed to the Partners for the Arts grants program.</p>
      <p style="font-size: 9pt;">The USM Foundation is a 501(c)(3) nonprofit organization and all gifts are tax-deductible to the extent of current IRS regulations.</p>
      <p style="font-size: 9pt; margin-top: 20px;">FRIENDS OF THE UNIVERSITY LIBRARIES</p>
      <p style="font-size: 9pt;">Friends of University Libraries is another important organization that provides essential support for the research, teaching and public service missions of USM libraries. To learn more, visit <span data-field="library_website_url">{{ library_website_url }}</span>.</p>
    </div>
  </div>
</div>