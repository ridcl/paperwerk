<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { text-align: center; }
  .header-block { text-align: center; margin-bottom: 30px; }
  .footer { text-align: center; font-size: 10pt; margin-top: 50px; }
  table { width: 100%; border-collapse: collapse; margin-top: 20px; }
  td { padding: 8px 0; text-align: left; }
  .inventory-table td:nth-child(2), .inventory-table td:nth-child(3) { text-align: center; }
</style>

<div class="page">
  <div class="header-block">
    <span style="font-size: 18pt; font-weight: bold;">University of Pennsylvania</span>
    <div style="margin: 20px 0;">
      <!-- Placeholder for University Seal/Logo -->
      <img src="" alt="Seal" style="width: 100px; height: auto;">
    </div>
    <span style="font-size: 14pt;">The University Archives and Records Center</span>
  </div>

  <div style="text-align: center; margin-top: 50px;">
    <span style="font-size: 14pt;">A Guide to the</span>
    <span style="font-size: 16pt; font-weight: bold;">College of Arts and Sciences. Courses Offered, Course Cards, etc.</span>
    <div style="margin-top: 10px;">
      <span style="font-size: 12pt;">1896-1946</span>
    </div>
    <div style="margin-top: 30px;">
      <span style="font-size: 12pt;">1.0 Cubic feet</span>
      <div style="margin-top: 5px;">
        <span style="font-size: 12pt;">UPB 1.75</span>
      </div>
    </div>
  </div>
</div>

<div class="page">
  <div style="text-align: right; margin-bottom: 20px;">
    <span data-field="center_contact.address_line_1">{{ center_contact.address_line_1 }}</span><br>
    <span data-field="center_contact.city_state_zip">{{ center_contact.city_state_zip }}</span><br>
    <span data-field="center_contact.phone">{{ center_contact.phone }}</span><br>
    <span data-field="center_contact.fax">{{ center_contact.fax }}</span><br>
    <span data-field="center_contact.website">{{ center_contact.website }}</span><br>
    <span data-field="center_contact.director_name">{{ center_contact.director_name }}</span>
  </div>
</div>

<div class="page">
  <div style="text-align: center; margin-top: 100px;">
    <span style="font-size: 14pt;">College of Arts and Sciences. Courses Offered, Course Cards, etc.</span>
    <div style="margin-top: 10px;">
      <span style="font-size: 12pt;">UPB 1.75</span>
    </div>
  </div>

  <div style="text-align: center; margin-top: 50px;">
    <span style="font-size: 14pt;">TABLE OF CONTENTS</span>
  </div>

  <div style="margin-top: 40px;">
    <table style="width: 100%;">
      <tr>
        <td style="width: 50%;">
          <span data-field="toc_entry_1.title">{{ toc_entry_1.title }}</span>
          <div style="height: 1px; background-color: #000; margin-top: 2px;"></div>
          <span data-field="toc_entry_1.page">{{ toc_entry_1.page }}</span>
        </td>
        <td style="width: 50%; text-align: right;">
          <div style="height: 1px; background-color: #000; margin-top: 2px;"></div>
        </td>
      </tr>
      <tr>
        <td style="width: 50%;">
          <span data-field="toc_entry_2.title">{{ toc_entry_2.title }}</span>
          <div style="height: 1px; background-color: #000; margin-top: 2px;"></div>
          <span data-field="toc_entry_2.page">{{ toc_entry_2.page }}</span>
        </td>
        <td style="width: 50%; text-align: right;">
          <div style="height: 1px; background-color: #000; margin-top: 2px;"></div>
        </td>
      </tr>
      <tr>
        <td style="width: 50%;">
          <span data-field="toc_entry_3.title">{{ toc_entry_3.title }}</span>
          <div style="height: 1px; background-color: #000; margin-top: 2px;"></div>
          <span data-field="toc_entry_3.page">{{ toc_entry_3.page }}</span>
        </td>
        <td style="width: 50%; text-align: right;">
          <div style="height: 1px; background-color: #000; margin-top: 2px;"></div>
        </td>
      </tr>
    </table>
  </div>
</div>

<div class="page">
  <div style="text-align: center; margin-top: 100px;">
    <span style="font-size: 14pt;">College of Arts and Sciences. Courses Offered, Course Cards, etc.</span>
    <div style="margin-top: 10px;">
      <span style="font-size: 12pt;">UPB 1.75</span>
    </div>
  </div>

  <div style="text-align: center; margin-top: 50px;">
    <span style="font-size: 14pt;">Guide to the</span>
    <span style="font-size: 16pt; font-weight: bold;">College of Arts and Sciences. Courses Offered, Course Cards, etc.</span>
    <div style="margin-top: 10px;">
      <span style="font-size: 12pt;">1896-1946</span>
    </div>
    <div style="margin-top: 30px;">
      <span style="font-size: 12pt;">1.0 Cubic feet</span>
      <div style="margin-top: 5px;">
        <span style="font-size: 12pt;">UPB 1.75</span>
      </div>
    </div>
  </div>

  <div style="margin-top: 80px; text-align: center;">
    <span style="font-size: 12pt;">Access is granted in accordance with the <a href="#" style="text-decoration: underline;">Protocols for the University Archives and Records Center</a>.</span>
  </div>

  <div style="text-align: center; margin-top: 80px;">
    <span style="font-size: 14pt;">ARRANGEMENT</span>
    <div style="height: 1px; background-color: #000; margin-top: 5px;"></div>
    <span style="font-size: 12pt;">This collection has not been fully processed. The following preliminary inventory is available.</span>
  </div>
</div>

<div class="page">
  <div style="text-align: center; margin-top: 100px;">
    <span style="font-size: 14pt;">College of Arts and Sciences. Courses Offered, Course Cards, etc.</span>
    <div style="margin-top: 10px;">
      <span style="font-size: 12pt;">UPB 1.75</span>
    </div>
  </div>

  <div style="text-align: center; margin-top: 50px;">
    <span style="font-size: 14pt;">INVENTORY</span>
  </div>

  <div style="margin-top: 30px;">
    <table class="inventory-table">
      <thead>
        <tr>
          <td style="width: 70%;"></td>
          <td style="width: 15%;">Box</td>
          <td style="width: 15%;">Folder</td>
        </tr>
      </thead>
      <tbody>
        {% for item in inventory_items %}
        <tr>
          <td><span data-field="inventory_items[{{ loop.index0 }}].description">{{ item.description }}</span></td>
          <td><span data-field="inventory_items[{{ loop.index0 }}].box">{{ item.box }}</span></td>
          <td><span data-field="inventory_items[{{ loop.index0 }}].folder">{{ item.folder }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>