<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 {
    font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif;
  }
  .center-text { text-align: center; }
  .right-align { text-align: right; }
  .divider { border-top: 1px solid #000; margin: 10px 0; }
</style>
<div class="page">
  <div class="center-text">
    <span style="font-size: 24pt;">University of Pennsylvania</span>
    <div style="margin: 20px 0;">
      <!-- Placeholder for University Logo -->
      <img src="" alt="Logo" style="width: 100px; height: auto;">
    </div>
    <span style="font-size: 16pt;">The University Archives</span>
    <span style="font-size: 16pt;">and Records Center</span>
  </div>
  <div class="center-text" style="margin-top: 50px;">
    <span style="font-size: 18pt;">A Guide to the</span>
    <span style="font-size: 18pt;">School of Design. Faculty and Board Minutes</span>
    <span style="font-size: 18pt;">1920-1952</span>
  </div>
  <div class="center-text" style="margin-top: 50px;">
    <span style="font-size: 14pt;">2.0 Cubic feet</span>
    <span style="font-size: 14pt;">UPB 8.1</span>
  </div>
  <div class="center-text" style="margin-top: 100px;">
    Prepared by <span data-field="prepared_by_name">{{ prepared_by_name }}</span><br>
    <span data-field="prepared_date">{{ prepared_date }}</span>
  </div>
</div>
