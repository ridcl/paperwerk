<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 {
    font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif;
  }
  .center-text { text-align: center; }
  .right-align { text-align: right; }
  .table-header th {
    border-bottom: 1px solid black;
    padding: 5px;
    text-align: left;
  }
  .table-row td {
    padding: 5px;
  }
</style>
<div class="page">
  <div class="center-text">
    <span style="font-size: 18pt;">University of Pennsylvania</span>
    <div style="margin: 20px 0;">
      <!-- Placeholder for University Logo -->
      <img src="" alt="Logo" style="width: 100px; height: auto;">
    </div>
    <span style="font-size: 14pt;">The University Archives</span>
    <span style="font-size: 14pt;">and Records Center</span>
  </div>
  <div class="center-text" style="margin-top: 50px;">
    <span style="font-size: 16pt;">A Guide to the</span>
    <span style="font-size: 16pt;">Wharton School. Conferences</span>
    <span style="font-size: 16pt;">and Symposia Records</span>
    <span style="font-size: 14pt; margin-top: 10px;">{{ year }}</span>
  </div>
  <div class="center-text" style="margin-top: 30px;">
    <span style="font-size: 12pt;">1.0 Item</span>
    <span style="font-size: 12pt;">UPB 5.3</span>
  </div>
</div>
<div class="page">
  <div style="text-align: right; font-family: 'DejaVu Sans', 'Liberation Sans', Arial, sans-serif;">
    <span style="font-size: 12pt;">Wharton School. Conferences and Symposia Records</span>
    <span style="font-size: 12pt;">UPB 5.3</span>
  </div>
  <div style="margin-top: 50px;">
    <span style="font-size: 14pt;">TABLE OF CONTENTS</span>
    <div style="margin-top: 20px;">
      <div style="display: flex; justify-content: space-between; font-family: Georgia, serif;">
        <span>INVENTORY..................................................................................................................................</span>
        <span>2</span>
      </div>
      <div style="display: flex; justify-content: space-between; font-family: Georgia, serif; margin-top: 5px;">
        <span>INVENTORY..................................................................................................................................</span>
        <span>2</span>
      </div>
    </div>
  </div>
</div>
<div class="page">
  <div class="center-text">
    <span style="font-size: 16pt;">Wharton School. Conferences and Symposia Records</span>
    <span style="font-size: 12pt;">UPB 5.3</span>
  </div>
  <div style="margin-top: 50px;">
    <span style="font-size: 14pt;">Guide to the</span>
    <span style="font-size: 14pt;">Wharton School. Conferences and Symposia Records</span>
    <span style="font-size: 12pt; margin-top: 10px;">{{ year }}</span>
    <span style="font-size: 12pt;">UPB 5.3</span>
    <span style="font-size: 12pt; margin-top: 10px;">1.0 Item</span>
  </div>
  <div style="margin-top: 50px;">
    <span style="font-size: 12pt;">Access is granted in accordance with the <a href="#" style="text-decoration: underline;">Protocols for the University Archives and Records Center</a>.</span>
  </div>
</div>
<div class="page">
  <div style="text-align: center; margin-top: 100px;">
    <span style="font-size: 14pt;">- 1 -</span>
  </div>
</div>
<div class="page">
  <div style="text-align: right; font-family: 'DejaVu Sans', 'Liberation Sans', Arial, sans-serif;">
    <span style="font-size: 12pt;">Wharton School. Conferences and Symposia Records</span>
    <span style="font-size: 12pt;">UPB 5.3</span>
  </div>
  <div style="margin-top: 50px;">
    <span style="font-size: 14pt;">Wharton School. Conferences and Symposia Records</span>
    <span style="font-size: 12pt;">{{ year }}</span>
    <span style="font-size: 12pt;">UPB 5.3</span>
    <div style="margin-top: 30px;">
      <span style="font-size: 12pt;">Access is granted in accordance with the <a href="#" style="text-decoration: underline;">Protocols for the University Archives and Records Center</a>.</span>
    </div>
  </div>
  <div style="margin-top: 80px;">
    <span style="font-size: 14pt;">INVENTORY</span>
  </div>
  <div style="margin-top: 40px;">
    <table style="width: 100%; border-collapse: collapse;">
      <thead>
        <tr class="table-header">
          <th style="width: 70%;">INVENTORY</th>
          <th style="width: 15%; text-align: center;">Box</th>
          <th style="width: 15%; text-align: center;">Folder</th>
        </tr>
      </thead>
      <tbody>
        {% for item in inventory_items %}
        <tr class="table-row">
          <td style="width: 70%;"><span data-field="inventory_items[{{ loop.index0 }}].description">{{ item.description }}</span></td>
          <td style="width: 15%; text-align: center;"><span data-field="inventory_items[{{ loop.index0 }}].box_number">{{ item.box_number }}</span></td>
          <td style="width: 15%; text-align: center;"><span data-field="inventory_items[{{ loop.index0 }}].folder_number">{{ item.folder_number }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
<div class="page">
  <div style="text-align: center; margin-top: 100px;">
    <span style="font-size: 14pt;">- 2 -</span>
  </div>
</div>