<div class="page">
  <div style="text-align: center; margin-bottom: 40px;">
    <img src="logo_clincard.png" alt="ClinCard Logo" style="height: 40px;">
    <div style="font-size: 10pt; margin-top: 5px;">Powered by <img src="logo_greenphire.png" alt="Greenphire Logo" style="height: 15px;"></div>
  </div>

  <h1 style="font-size: 24pt; text-align: center; margin-bottom: 40px;">Create a Travel Profile.</h1>

  <ol class="step-list">
    <li>
      <p>Click Create Travel Profile.</p>
    </li>
  </ol>

  <div style="border: 1px solid #ccc; padding: 20px; margin-top: 30px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <h2 style="font-size: 16pt; margin: 0;">TRAVEL TESTER</h2>
      <div style="display: flex; gap: 10px;">
        <button class="button">SUBJECT INFORMATION</button>
        <button class="button">AUDIT HISTORY</button>
        <button class="button">ASSIGN CLINICARD</button>
        <button class="button">REQUEST REIMBURSEMENT</button>
        <button class="button">EDIT PROFILE</button>
        <button class="button">SCHEDULE APPOINTMENT</button>
      </div>
    </div>
    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px;">
      <div>
        <p>Subject Name:</p>
        <div style="border: 1px solid #eee; padding: 10px;"><span data-field="subject.name">{{ subject.name }}</span></div>
        <p>Subject ID:</p>
        <div style="border: 1px solid #eee; padding: 10px;"><span data-field="subject.id">{{ subject.id }}</span></div>
        <p>Sex:</p>
        <div style="border: 1px solid #eee; padding: 10px;"><span data-field="subject.sex">{{ subject.sex }}</span></div>
        <p>Date of Birth:</p>
        <div style="border: 1px solid #eee; padding: 10px;"><span data-field="subject.dob">{{ subject.dob }}</span></div>
      </div>
      <div>
        <p>Study Name:</p>
        <div style="border: 1px solid #eee; padding: 10px;"><span data-field="study.name">{{ study.name }}</span></div>
        <p>Study ID:</p>
        <div style="border: 1px solid #eee; padding: 10px;"><span data-field="study.id">{{ study.id }}</span></div>
        <p>Email:</p>
        <div style="border: 1px solid #eee; padding: 10px;"><span data-field="subject.email">{{ subject.email }}</span></div>
        <p>Phone:</p>
        <div style="border: 1px solid #eee; padding: 10px;"><span data-field="subject.phone">{{ subject.phone }}</span></div>
      </div>
    </div>
  </div>

  <ol class="step-list">
    <li>
      <p>Click Add Travel to Profile.</p>
    </li>
  </ol>

  <div style="border: 1px solid #ccc; padding: 20px; margin-top: 30px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <h2 style="font-size: 16pt; margin: 0;">Travel Profile</h2>
      <div style="display: flex; gap: 10px;">
        <button class="button">REGISTER SUBJECT</button>
        <button class="button">LOOK UP SUBJECT</button>
        <button class="button">SUPPORT</button>
      </div>
    </div>
    <table style="margin-top: 20px;">
      <thead>
        <tr>
          <th>TRAVEL REQUEST TYPE</th>
          <th>SUBJECT</th>
          <th>STATUS</th>
        </tr>
      </thead>
      <tbody>
        {% for travel_request in travel_requests %}
        <tr>
          <td><span data-field="travel_requests[{{ loop.index0 }}].type">{{ travel_request.type }}</span></td>
          <td><span data-field="travel_requests[{{ loop.index0 }}].subject">{{ travel_request.subject }}</span></td>
          <td><span data-field="travel_requests[{{ loop.index0 }}].status">{{ travel_request.status }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    <p style="margin-top: 20px;">A travel profile has not been created for this subject in this study.</p>
  </div>

  <ol class="step-list">
    <li>
      <p>Select "Travel Type" from drop down menu.</p>
      <p>You will be brought to a new screen where you will be required to enter information regarding the selected Travel Type.</p>
    </li>
  </ol>

  <div style="border: 1px solid #ccc; padding: 20px; margin-top: 30px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <h2 style="font-size: 16pt; margin: 0;">Request Travel</h2>
      <div style="display: flex; gap: 10px;">
        <button class="button">CANCEL</button>
        <button class="button">SAVE</button>
      </div>
    </div>
    <form>
      <label for="travel_type" style="display: block; margin-bottom: 5px;">Travel Type:</label>
      <select id="travel_type" class="input-field">
        <option value="">Select a travel type</option>
        {% for type in travel_types %}
        <option value="{{ type }}">{{ type }}</option>
        {% endfor %}
      </select>

      <label for="study_name" style="display: block; margin-top: 15px; margin-bottom: 5px;">Study:</label>
      <input type="text" id="study_name" class="input-field" value="{{ study.name }}">

      <label for="travel_date" style="display: block; margin-top: 15px; margin-bottom: 5px;">Travel Date:</label>
      <input type="date" id="travel_date" class="input-field" value="{{ travel_date }}">

      <label for="destination" style="display: block; margin-top: 15px; margin-bottom: 5px;">Destination:</label>
      <input type="text" id="destination" class="input-field" value="{{ destination }}">

      <label for="notes" style="display: block; margin-top: 15px; margin-bottom: 5px;">Notes:</label>
      <textarea id="notes" class="input-field" rows="4">{{ notes }}</textarea>

      <div style="margin-top: 20px; display: flex; justify-content: flex-end; gap: 10px;">
        <button type="button" class="button">CANCEL</button>
        <button type="submit" class="button">ADD TO PROFILE</button>
      </div>
    </form>
  </div>

  <ol class="step-list">
    <li>
      <p>Complete the required fields and add any other necessary information, notes, etc. within this screen.</p>
    </li>
  </ol>

  <div style="border: 1px solid #ccc; padding: 20px; margin-top: 30px;">
    <p style="font-weight: bold; margin-bottom: 10px;">IMPORTANT NOTE:</p>
    <p>The Subject Name entered into ClinCard needs to be the exact name found on their legal, travel documents (ex. Photo ID, Passport.)</p>
  </div>

  <ol class="step-list">
    <li>
      <p>Click Add to Profile.</p>
    </li>
  </ol>

  <div style="border: 1px solid #ccc; padding: 20px; margin-top: 30px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <h2 style="font-size: 16pt; margin: 0;">Request Travel</h2>
      <div style="display: flex; gap: 10px;">
        <button class="button">CANCEL</button>
        <button class="button">START OVER</button>
      </div>
    </div>
    <form>
      <label for="flight_request" style="display: block; margin-bottom: 5px;">Flight request for Travel Tester:</label>
      <input type="text" id="flight_request" class="input-field" value="{{ flight_request }}">

      <label for="departure_city" style="display: block; margin-top: 15px; margin-bottom: 5px;">Departure City:</label>
      <input type="text" id="departure_city" class="input-field" value="{{ departure_city }}">

      <label for="arrival_city" style="display: block; margin-top: 15px; margin-bottom: 5px;">Arrival City:</label>
      <input type="text" id="arrival_city" class="input-field" value="{{ arrival_city }}">

      <label for="preferred_airline" style="display: block; margin-top: 15px; margin-bottom: 5px;">Preferred Airline:</label>
      <input type="text" id="preferred_airline" class="input-field" value="{{ preferred_airline }}">

      <label for="travel_notes" style="display: block; margin-top: 15px; margin-bottom: 5px;">Travel Notes:</label>
      <textarea id="travel_notes" class="input-field" rows="4">{{ travel_notes }}</textarea>

      <div style="margin-top: 20px; display: flex; justify-content: flex-end; gap: 10px;">
        <button type="button" class="button">ADD TO PROFILE</button>
        <button type="submit" class="button">START OVER</button>
      </div>
    </form>
  </div>

  <ol class="step-list">
    <li>
      <p>Click Submit Request to finalize.</p>
    </li>
  </ol>

  <div style="border: 1px solid #ccc; padding: 20px; margin-top: 30px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <h2 style="font-size: 16pt; margin: 0;">Request Travel</h2>
      <div style="display: flex; gap: 10px;">
        <button class="button">CANCEL</button>
        <button class="button">START OVER</button>
      </div>
    </div>
    <form>
      <label for="travel_type_final" style="display: block; margin-bottom: 5px;">Travel Type:</label>
      <select id="travel_type_final" class="input-field">
        <option value="">Select a travel type</option>
        {% for type in travel_types %}
        <option value="{{ type }}">{{ type }}</option>
        {% endfor %}
      </select>

      <label for="study_name_final" style="display: block; margin-top: 15px; margin-bottom: 5px;">Study:</label>
      <input type="text" id="study_name_final" class="input-field" value="{{ study.name }}">

      <label for="departure_city_final" style="display: block; margin-top: 15px; margin-bottom: 5px;">Departure City:</label>
      <input type="text" id="departure_city_final" class="input-field" value="{{ departure_city }}">

      <label for="arrival_city_final" style="display: block; margin-top: 15px; margin-bottom: 5px;">Arrival City:</label>
      <input type="text" id="arrival_city_final" class="input-field" value="{{ arrival_city }}">

      <label for="preferred_airline_final" style="display: block; margin-top: 15px; margin-bottom: 5px;">Preferred Airline:</label>
      <input type="text" id="preferred_airline_final" class="input-field" value="{{ preferred_airline }}">

      <label for="travel_notes_final" style="display: block; margin-top: 15px; margin-bottom: 5px;">Travel Notes:</label>
      <textarea id="travel_notes_final" class="input-field" rows="4">{{ travel_notes }}</textarea>

      <div style="margin-top: 20px; display: flex; justify-content: flex-end; gap: 10px;">
        <button type="button" class="button">ADD TO PROFILE</button>
        <button type="submit" class="button">START OVER</button>
      </div>
    </form>
  </div>

  <ol class="step-list">
    <li>
      <p>The Site Coordinator or Subject should contact the Travel Partner to complete the booking process.</p>
    </li>
    <li>
      <p>IMPORTANT NOTE: No travel arrangement will be booked until the Subject or Site Coordinator contacts the Travel Partner with specific dates and times.</p>
    </li>
  </ol>

  <div style="border: 1px solid #ccc; padding: 20px; margin-top: 30px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <h2 style="font-size: 16pt; margin: 0;">Travel Profile</h2>
      <div style="display: flex; gap: 10px;">
        <button class="button">ADD TRAVEL TO PROFILE</button>
        <button class="button">EDIT PROFILE</button>
      </div>
    </div>
    <table style="margin-top: 20px;">
      <thead>
        <tr>
          <th>TRAVEL REQUEST TYPE</th>
          <th>SUBJECT</th>
          <th>STATUS</th>
        </tr>
      </thead>
      <tbody>
        {% for travel_request in travel_requests %}
        <tr>
          <td><span data-field="travel_requests[{{ loop.index0 }}].type">{{ travel_request.type }}</span></td>
          <td><span data-field="travel_requests[{{ loop.index0 }}].subject">{{ travel_request.subject }}</span></td>
          <td><span data-field="travel_requests[{{ loop.index0 }}].status">{{ travel_request.status }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

