<!DOCTYPE html>
<html>
<head>
    <title>Travel Abroad Risk Management Plan</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        td {
            padding: 5px 0;
        }
        .header-title {
            text-align: center;
            font-size: 24pt;
            font-weight: bold;
            margin-bottom: 20px;
        }
        .section-heading {
            font-size: 14pt;
            font-weight: bold;
            margin-top: 20px;
            margin-bottom: 10px;
        }
        .form-row {
            display: flex;
            margin-bottom: 10px;
            align-items: flex-start;
        }
        .form-row > div {
            flex: 1;
        }
        .label {
            font-weight: bold;
            display: block;
            margin-bottom: 3px;
        }
        .input-area {
            border-bottom: 1px solid #000;
            min-height: 1em;
        }
        .two-column-layout {
            display: flex;
            justify-content: space-between;
            margin-bottom: 20px;
        }
        .two-column-layout > div {
            width: 48%;
        }
    </style>
</head>
<body>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px;">
        <div>
            <img src="placeholder_logo_1.png" alt="University Logo" style="height: 70px;">
        </div>
        <div style="text-align: right;">
            <div style="font-size: 10pt;">2121 Euclid Ave. MC 412</div>
            <div style="font-size: 10pt;">Cleveland, OH 44115</div>
            <div style="font-size: 10pt;">Phone: {{ contact_phone }}</div>
            <div style="font-size: 10pt;">Fax: {{ contact_fax }}</div>
            <div style="font-size: 10pt;">www.csuohio.edu/csuea</div>
        </div>
    </div>
    <div class="header-title">
        Individual Student Research & Independent/Academic Travel Abroad Risk Management Plan
    </div>

    <div class="two-column-layout">
        <div>
            <div class="section-heading">Name of Student (Last, First Middle)</div>
            <div class="form-row">
                <div style="flex-basis: 100%;">
                    <span data-field="full_name" class="input-area">{{ full_name }}</span>
                </div>
            </div>
        </div>
        <div>
            <div class="section-heading">Student ID Number</div>
            <div class="form-row">
                <div style="flex-basis: 100%;">
                    <span data-field="student_id" class="input-area">{{ student_id }}</span>
                </div>
            </div>
        </div>
    </div>

    <div class="two-column-layout">
        <div>
            <div class="section-heading">Supervising Professor</div>
            <div class="form-row">
                <div style="flex-basis: 100%;">
                    <span data-field="supervising_professor_name" class="input-area">{{ supervising_professor_name }}</span>
                </div>
            </div>
        </div>
        <div>
            <div class="section-heading">Supervising Academic Dept.</div>
            <div class="form-row">
                <div style="flex-basis: 100%;">
                    <span data-field="supervising_department" class="input-area">{{ supervising_department }}</span>
                </div>
            </div>
        </div>
    </div>

    <div class="two-column-layout">
        <div>
            <div class="section-heading">Host University</div>
            <div class="form-row">
                <div style="flex-basis: 100%;">
                    <span data-field="host_university_name" class="input-area">{{ host_university_name }}</span>
                </div>
            </div>
        </div>
        <div>
            <div class="section-heading">Location (City, Country)</div>
            <div class="form-row">
                <div style="flex-basis: 100%;">
                    <span data-field="host_location" class="input-area">{{ host_location }}</span>
                </div>
            </div>
        </div>
    </div>

    <div class="two-column-layout">
        <div>
            <div class="section-heading">Purpose of Activity</div>
            <div class="form-row">
                <div style="flex-basis: 100%;">
                    <span data-field="activity_purpose" class="input-area">{{ activity_purpose }}</span>
                </div>
            </div>
        </div>
        <div>
            <div class="section-heading">Start Date (M/D/YYYY)</div>
            <div class="form-row">
                <div style="flex-basis: 100%;">
                    <span data-field="start_date" class="input-area">{{ start_date }}</span>
                </div>
            </div>
        </div>
    </div>

    <div class="two-column-layout">
        <div>
            <div class="section-heading">End Date (M/D/YYYY)</div>
            <div class="form-row">
                <div style="flex-basis: 100%;">
                    <span data-field="end_date" class="input-area">{{ end_date }}</span>
                </div>
            </div>
        </div>
        <div>
            <div class="section-heading">Credits</div>
            <div class="form-row">
                <div style="flex-basis: 100%;">
                    <span data-field="credits" class="input-area">{{ credits }}</span>
                </div>
            </div>
        </div>
    </div>

    <div class="section-heading">Travel Issues: Please list the modes of transportation which will be used as a part of activity both to the site and while abroad. Please list both the type and name of the provider.</div>
    <ol style="padding-left: 20px;">
        <li><span data-field="travel_issue_1" class="input-area">{{ travel_issue_1 }}</span></li>
        <li><span data-field="travel_issue_2" class="input-area">{{ travel_issue_2 }}</span></li>
        <li><span data-field="travel_issue_3" class="input-area">{{ travel_issue_3 }}</span></li>
        <li><span data-field="travel_issue_4" class="input-area">{{ travel_issue_4 }}</span></li>
        <li><span data-field="travel_issue_5" class="input-area">{{ travel_issue_5 }}</span></li>
    </ol>

    <div class="section-heading">Important Contacts: Please list contacts for the following fields so that we may contact them, if allowed, in the unlikely event of an emergency.</div>

    <div class="two-column-layout">
        <div>
            <div class="section-heading">Emergency Contact at Home (Last, First Middle)</div>
            <div class="form-row">
                <div style="flex-basis: 100%;">
                    <span data-field="emergency_contact_name" class="input-area">{{ emergency_contact_name }}</span>
                </div>
            </div>
            <div class="form-row">
                <div style="flex-basis: 33%;">
                    <span data-field="emergency_contact_street_address" class="input-area">{{ emergency_contact_street_address }}</span>
                </div>
                <div style="flex-basis: 33%;">
                    <span data-field="emergency_contact_city" class="input-area">{{ emergency_contact_city }}</span>
                </div>
                <div style="flex-basis: 33%;">
                    <span data-field="emergency_contact_state" class="input-area">{{ emergency_contact_state }}</span>
                </div>
            </div>
            <div class="form-row">
                <div style="flex-basis: 33%;">
                    <span data-field="emergency_contact_zip" class="input-area">{{ emergency_contact_zip }}</span>
                </div>
                <div style="flex-basis: 33%;">
                    <span data-field="emergency_contact_home_phone" class="input-area">{{ emergency_contact_home_phone }}</span>
                </div>
                <div style="flex-basis: 33%;">
                    <span data-field="emergency_contact_cell_email" class="input-area">{{ emergency_contact_cell_email }}</span>
                </div>
            </div>
        </div>
        <div>
            <div class="section-heading">Relation to Student</div>
            <div class="form-row">
                <div style="flex-basis: 100%;">
                    <span data-field="emergency_contact_relation" class="input-area">{{ emergency_contact_relation }}</span>
                </div>
            </div>
        </div>
    </div>

    <div class="section-heading">Name of Travel Agent or Ticket Issuing Co.</div>
    <div class="two-column-layout">
        <div>
            <div class="form-row">
                <div style="flex-basis: 100%;">
                    <span data-field="travel_agent_name" class="input-area">{{ travel_agent_name }}</span>
                </div>
            </div>
            <div class="form-row">
                <div style="flex-basis: 33%;">
                    <span data-field="travel_agent_street_address" class="input-area">{{ travel_agent_street_address }}</span>
                </div>
                <div style="flex-basis: 33%;">
                    <span data-field="travel_agent_city" class="input-area">{{ travel_agent_city }}</span>
                </div>
                <div style="flex-basis: 33%;">
                    <span data-field="travel_agent_state" class="input-area">{{ travel_agent_state }}</span>
                </div>
            </div>
            <div class="form-row">
                <div style="flex-basis: 33%;">
                    <span data-field="travel_agent_zip" class="input-area">{{ travel_agent_zip }}</span>
                </div>
                <div style="flex-basis: 33%;">
                    <span data-field="travel_agent_main_phone" class="input-area">{{ travel_agent_main_phone }}</span>
                </div>
                <div style="flex-basis: 33%;">
                    <span data-field="travel_agent_fax" class="input-area">{{ travel_agent_fax }}</span>
                </div>
            </div>
        </div>
        <div>
            <div class="section-heading">Emergency No.</div>
            <div class="form-row">
                <div style="flex-basis: 100%;">
                    <span data-field="travel_agent_emergency_no" class="input-area">{{ travel_agent_emergency_no }}</span>
                </div>
            </div>
            <div class="form-row">
                <div style="flex-basis: 100%;">
                    <span data-field="travel_agent_email_address" class="input-area">{{ travel_agent_email_address }}</span>
                </div>
            </div>
        </div>
    </div>

    <div class="section-heading">Name of In-Country Contact (If Applicable)</div>
    <div class="two-column-layout">
        <div>
            <div class="form-row">
                <div style="flex-basis: 100%;">
                    <span data-field="in_country_contact_name" class="input-area">{{ in_country_contact_name }}</span>
                </div>
            </div>
            <div class="form-row">
                <div style="flex-basis: 33%;">
                    <span data-field="in_country_contact_street_address" class="input-area">{{ in_country_contact_street_address }}</span>
                </div>
                <div style="flex-basis: 33%;">
                    <span data-field="in_country_contact_city" class="input-area">{{ in_country_contact_city }}</span>
                </div>
                <div style="flex-basis: 33%;">
                    <span data-field="in_country_contact_state" class="input-area">{{ in_country_contact_state }}</span>
                </div>
            </div>
            <div class="form-row">
                <div style="flex-basis: 33%;">
                    <span data-field="in_country_contact_zip" class="input-area">{{ in_country_contact_zip }}</span>
                </div>
                <div style="flex-basis: 33%;">
                    <span data-field="in_country_contact_main_phone" class="input-area">{{ in_country_contact_main_phone }}</span>
                </div>
                <div style="flex-basis: 33%;">
                    <span data-field="in_country_contact_fax" class="input-area">{{ in_country_contact_fax }}</span>
                </div>
            </div>
        </div>
        <div>
            <div class="section-heading">Emergency No.</div>
            <div class="form-row">
                <div style="flex-basis: 100%;">
                    <span data-field="in_country_contact_emergency_no" class="input-area">{{ in_country_contact_emergency_no }}</span>
                </div>
            </div>
            <div class="form-row">
                <div style="flex-basis: 100%;">
                    <span data-field="in_country_contact_email_address" class="input-area">{{ in_country_contact_email_address }}</span>
                </div>
            </div>
        </div>
    </div>

    <div class="section-heading">Name of In-Country Hotel/Hostel/Home-Base</div>
    <div class="two-column-layout">
        <div>
            <div class="form-row">
                <div style="flex-basis: 100%;">
                    <span data-field="hostel_name" class="input-area">{{ hostel_name }}</span>
                </div>
            </div>
            <div class="form-row">
                <div style="flex-basis: 33%;">
                    <span data-field="hostel_street_address" class="input-area">{{ hostel_street_address }}</span>
                </div>
                <div style="flex-basis: 33%;">
                    <span data-field="hostel_city" class="input-area">{{ hostel_city }}</span>
                </div>
                <div style="flex-basis: 33%;">
                    <span data-field="hostel_state" class="input-area">{{ hostel_state }}</span>
                </div>
            </div>
            <div class="form-row">
                <div style="flex-basis: 33%;">
                    <span data-field="hostel_zip" class="input-area">{{ hostel_zip }}</span>
                </div>
                <div style="flex-basis: 33%;">
                    <span data-field="hostel_main_phone" class="input-area">{{ hostel_main_phone }}</span>
                </div>
                <div style="flex-basis: 33%;">
                    <span data-field="hostel_fax" class="input-area">{{ hostel_fax }}</span>
                </div>
            </div>
        </div>
        <div>
            <div class="section-heading">Emergency No.</div>
            <div class="form-row">
                <div style="flex-basis: 100%;">
                    <span data-field="hostel_emergency_no" class="input-area">{{ hostel_emergency_no }}</span>
                </div>
            </div>
            <div class="form-row">
                <div style="flex-basis: 100%;">
                    <span data-field="hostel_email_address" class="input-area">{{ hostel_email_address }}</span>
                </div>
            </div>
        </div>
    </div>

    <div class="section-heading">Name of Research Facility or Company</div>
    <div class="two-column-layout">
        <div>
            <div class="form-row">
                <div style="flex-basis: 100%;">
                    <span data-field="facility_name" class="input-area">{{ facility_name }}</span>
                </div>
            </div>
            <div class="form-row">
                <div style="flex-basis: 33%;">
                    <span data-field="facility_street_address" class="input-area">{{ facility_street_address }}</span>
                </div>
                <div style="flex-basis: 33%;">
                    <span data-field="facility_city" class="input-area">{{ facility_city }}</span>
                </div>
                <div style="flex-basis: 33%;">
                    <span data-field="facility_state" class="input-area">{{ facility_state }}</span>
                </div>
            </div>
            <div class="form-row">
                <div style="flex-basis: 33%;">
                    <span data-field="facility_zip" class="input-area">{{ facility_zip }}</span>
                </div>
                <div style="flex-basis: 33%;">
                    <span data-field="facility_main_phone" class="input-area">{{ facility_main_phone }}</span>
                </div>
                <div style="flex-basis: 33%;">
                    <span data-field="facility_fax" class="input-area">{{ facility_fax }}</span>
                </div>
            </div>
        </div>
        <div>
            <div class="section-heading">Emergency No.</div>
            <div class="form-row">
                <div style="flex-basis: 100%;">
                    <span data-field="facility_emergency_no" class="input-area">{{ facility_emergency_no }}</span>
                </div>
            </div>
            <div class="form-row">
                <div style="flex-basis: 100%;">
                    <span data-field="facility_email_address" class="input-area">{{ facility_email_address }}</span>
                </div>
            </div>
        </div>
    </div>

    <div class="section-heading">Passport Information: Please provide information regarding your passport below. Please attach a copy of passport. If you do not have one, please apply for on immediately.</div>
    <div class="two-column-layout">
        <div>
            <div class="form-row">
                <div style="flex-basis: 33%;">
                    <span data-field="passport_number" class="input-area">{{ passport_number }}</span>
                </div>
                <div style="flex-basis: 33%;">
                    <span data-field="passport_expiration_date" class="input-area">{{ passport_expiration_date }}</span>
                </div>
                <div style="flex-basis: 33%;">
                    <span data-field="passport_place_of_issue" class="input-area">{{ passport_place_of_issue }}</span>
                </div>
            </div>
        </div>
        <div>
            <div class="form-row">
                <div style="flex-basis: 100%;">
                    <span data-field="passport_date_of_issue" class="input-area">{{ passport_date_of_issue }}</span>
                </div>
            </div>
        </div>
    </div>

</div>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px;">
        <div>
            <img src="placeholder_logo_1.png" alt="University Logo" style="height: 70px;">
        </div>
        <div style="text-align: right;">
            <div style="font-size: 10pt;">2121 Euclid Ave. MC 412</div>
            <div style="font-size: 10pt;">Cleveland, OH 44115</div>
            <div style="font-size: 10pt;">Phone: {{ contact_phone }}</div>
            <div style="font-size: 10pt;">Fax: {{ contact_fax }}</div>
            <div style="font-size: 10pt;">www.csuohio.edu/csuea</div>
        </div>
    </div>
    <div class="header-title">
        Individual Student Research & Independent/Academic Travel Abroad Risk Management Plan (Cont.)
    </div>

    <div class="section-heading">Health & Wellness: Please provide the following information regarding your insurance and health while abroad.</div>
    <table>
        <thead>
            <tr>
                <td style="width: 20%;">Name of Insurance Provider</td>
                <td style="width: 10%;">Yes</td>
                <td style="width: 10%;">No</td>
                <td style="width: 60%;">Does this insurance provide world-wide coverage?</td>
            </tr>
        </thead>
        <tbody>
            {% for item in insurance_details %}
            <tr>
                <td><span data-field="insurance_details[{{ loop.index0 }}].provider_name">{{ item.provider_name }}</span></td>
                <td><span data-field="insurance_details[{{ loop.index0 }}].has_coverage_yes">{{ item.has_coverage_yes }}</span></td>
                <td><span data-field="insurance_details[{{ loop.index0 }}].has_coverage_no">{{ item.has_coverage_no }}</span></td>
                <td><span data-field="insurance_details[{{ loop.index0 }}].world_wide_coverage">{{ item.world_wide_coverage }}</span></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <table>
        <thead>
            <tr>
                <td style="width: 20%;">Group No.</td>
                <td style="width: 10%;">Yes</td>
                <td style="width: 10%;">No</td>
                <td style="width: 60%;">Does this insurance require you to pay up front for any medical treatment?</td>
            </tr>
        </thead>
        <tbody>
            {% for item in insurance_details %}
            <tr>
                <td><span data-field="insurance_details[{{ loop.index0 }}].group_no">{{ item.group_no }}</span></td>
                <td><span data-field="insurance_details[{{ loop.index0 }}].requires_upfront_yes">{{ item.requires_upfront_yes }}</span></td>
                <td><span data-field="insurance_details[{{ loop.index0 }}].requires_upfront_no">{{ item.requires_upfront_no }}</span></td>
                <td><span data-field="insurance_details[{{ loop.index0 }}].upfront_payment_status">{{ item.upfront_payment_status }}</span></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <table>
        <thead>
            <tr>
                <td style="width: 20%;">Member No.</td>
                <td style="width: 10%;">Yes</td>
                <td style="width: 10%;">No</td>
                <td style="width: 60%;">Does this insurance require you to submit receipts for reimbursement?</td>
            </tr>
        </thead>
        <tbody>
            {% for item in insurance_details %}
            <tr>
                <td><span data-field="insurance_details[{{ loop.index0 }}].member_no">{{ item.member_no }}</span></td>
                <td><span data-field="insurance_details[{{ loop.index0 }}].requires_receipts_yes">{{ item.requires_receipts_yes }}</span></td>
                <td><span data-field="insurance_details[{{ loop.index0 }}].requires_receipts_no">{{ item.requires_receipts_no }}</span></td>
                <td><span data-field="insurance_details[{{ loop.index0 }}].receipt_submission_status">{{ item.receipt_submission_status }}</span></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="section-heading">List any required or recommended inoculations for the country or region:</div>
    <div class="form-row">
        <div style="flex-basis: 100%;">
            <span data-field="inoculation_recommendations" class="input-area">{{ inoculation_recommendations }}</span>
        </div>
    </div>

    <div class="section-heading">Safety Information: Please list any particular safety issues which are apparent either in the proposed activity or the country in which you will travel to. Discuss how you will address these issues. List also any particular concerns that you have. Use another sheet of paper if necessary.</div>
    <ol style="padding-left: 20px;">
        <li><span data-field="safety_concern_1" class="input-area">{{ safety_concern_1 }}</span></li>
        <li><span data-field="safety_concern_2" class="input-area">{{ safety_concern_2 }}</span></li>
        <li><span data-field="safety_concern_3" class="input-area">{{ safety_concern_3 }}</span></li>
    </ol>

    <div class="section-heading">Overseas Information: Please fill out the below information about the area in which you are studying abroad.</div>

    <div class="section-heading">U.S. Embassy Information</div>
    <div class="two-column-layout">
        <div>
            <div class="form-row">
                <div style="flex-basis: 33%;">
                    <span data-field="embassy_street_address" class="input-area">{{ embassy_street_address }}</span>
                </div>
                <div style="flex-basis: 33%;">
                    <span data-field="embassy_city" class="input-area">{{ embassy_city }}</span>
                </div>
                <div style="flex-basis: 33%;">
                    <span data-field="embassy_state" class="input-area">{{ embassy_state }}</span>
                </div>
            </div>
            <div class="form-row">
                <div style="flex-basis: 33%;">
                    <span data-field="embassy_zip" class="input-area">{{ embassy_zip }}</span>
                </div>
                <div style="flex-basis: 33%;">
                    <span data-field="embassy_main_phone" class="input-area">{{ embassy_main_phone }}</span>
                </div>
                <div style="flex-basis: 33%;">
                    <span data-field="embassy_fax" class="input-area">{{ embassy_fax }}</span>
                </div>
            </div>
        </div>
    </div>

    <div class="section-heading">Name of Closest U.S. Consulate</div>
    <div class="two-column-layout">
        <div>
            <div class="form-row">
                <div style="flex-basis: 100%;">
                    <span data-field="consulate_name" class="input-area">{{ consulate_name }}</span>
                </div>
            </div>
            <div class="form-row">
                <div style="flex-basis: 33%;">
                    <span data-field="consulate_street_address" class="input-area">{{ consulate_street_address }}</span>
                </div>
                <div style="flex-basis: 33%;">
                    <span data-field="consulate_city" class="input-area">{{ consulate_city }}</span>
                </div>
                <div style="flex-basis: 33%;">
                    <span data-field="consulate_state" class="input-area">{{ consulate_state }}</span>
                </div>
            </div>
            <div class="form-row">
                <div style="flex-basis: 33%;">
                    <span data-field="consulate_zip" class="input-area">{{ consulate_zip }}</span>
                </div>
                <div style="flex-basis: 33%;">
                    <span data-field="consulate_main_phone" class="input-area">{{ consulate_main_phone }}</span>
                </div>
                <div style="flex-basis: 33%;">
                    <span data-field="consulate_fax" class="input-area">{{ consulate_fax }}</span>
                </div>
            </div>
        </div>
    </div>

    <div class="section-heading">Name of Closest Doctor or Urgent Care (Must Speak English)</div>
    <div class="two-column-layout">
        <div>
            <div class="form-row">
                <div style="flex-basis: 100%;">
