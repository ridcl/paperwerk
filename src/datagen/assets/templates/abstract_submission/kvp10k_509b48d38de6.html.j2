<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3, h4 { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; }
  .header-info { font-size: 10pt; }
  .section-title { font-weight: bold; margin-top: 15px; margin-bottom: 5px; }
  .author-block { margin-bottom: 20px; border-bottom: 1px solid #ccc; padding-bottom: 10px; }
  .author-details p { margin: 2px 0; font-size: 10pt; }
  .affiliation { font-style: italic; font-size: 10pt; margin-top: 5px; }
  .abstract-text { margin-top: 15px; line-height: 1.5; font-size: 10pt; }
  .list-item { margin-bottom: 5px; font-size: 10pt; }
</style>

<div class="page">
  <div class="header-info" style="display: flex; justify-content: space-between; align-items: center;">
    <span data-field="date">{{ date }}</span>
    <span data-field="document_title">{{ document_title }}</span>
  </div>
  <p style="margin-top: 10px;">
    <span data-field="submission_status">{{ submission_status }}</span>
    <br>
    <span data-field="confirmation_note">{{ confirmation_note }}</span>
  </p>
  <p style="margin-top: 15px;">
    Click <a href="#" style="color: blue;">HERE</a> to print this page now.
  </p>
  <p style="margin-top: 20px; font-size: 10pt;">
    Receipt of this notice does not guarantee that your submission was accepted for the 2014 AGU Fall Meeting. All submissions are subject to review and acceptance by the Program Committee. You may review or edit your abstract submission until the deadline of <span data-field="deadline_date">{{ deadline_date }}</span>. After this date, no further edits will be made to the submission.
  </p>
  <p style="margin-top: 20px; font-size: 10pt;">
    Frontal features of the Columbia River plume seen from a high-resolution non-hydrostatic model
  </p>
  <div style="margin-top: 10px;">
    <span data-field="author_list">
      {% for author in authors %}
        <span data-field="author_name">{{ author.full_name }}</span>
        {% if not loop.last %}
        ,
        {% endif %}
      {% endfor %}
    </span>
  </div>
  <div style="margin-top: 15px;">
    <span data-field="abstract_text">{{ abstract_text }}</span>
  </div>
  <div style="margin-top: 30px;">
    <div class="section-title">Session Selection: Nearshore Processes</div>
    <p>
      Title: <span data-field="paper_title">{{ paper_title }}</span>
    </p>
    <p>
      Submitter's E-mail Address: <span data-field="submitter_email">{{ submitter_email }}</span>
    </p>
    <p>
      Preferred Presentation Format: Assigned by Program Committee (Oral or Poster)
    </p>
    <p>
      Scheduling Request: Please schedule it after the talks about RIVET II field measurements
    </p>
  </div>
  <div style="margin-top: 30px;">
    <div class="section-title">First Presenting Author</div>
    <div class="author-block">
      <p><strong>Presenting Author</strong></p>
      <p><span data-field="presenting_author_name">{{ presenting_author.full_name }}</span></p>
      <div class="author-details">
        <p>Primary Email: <span data-field="presenting_author_email">{{ presenting_author_email }}</span></p>
        <p>Phone: <span data-field="presenting_author_phone">{{ presenting_author_phone }}</span></p>
        <p>Affiliation(s):</p>
        <p class="affiliation"><span data-field="presenting_author_affiliation">{{ presenting_author.affiliation }}</span></p>
      </div>
    </div>
  </div>
</div>

<div class="page">
  <div class="header-info" style="display: flex; justify-content: space-between; align-items: center;">
    <span data-field="date">{{ date }}</span>
    <span data-field="document_title">{{ document_title }}</span>
  </div>

