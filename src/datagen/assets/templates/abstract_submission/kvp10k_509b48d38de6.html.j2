      <p><span data-field="author_name">{{ authors[5].full_name }}</span></p>
      <div class="author-details">
        <p>Primary Email: <span data-field="authors[5].email">{{ authors[5].email }}</span></p>
        <p>Phone: <span data-field="authors[5].phone">{{ authors[5].phone }}</span></p>
        <p>Affiliation(s):</p>
        <p class="affiliation"><span data-field="authors[5].affiliation">{{ authors[5].affiliation }}</span></p>
      </div>
    </div>
  </div>
</div>

<div class="page">
  <div class="header-info" style="display: flex; justify-content: space-between; align-items: center;">
    <span data-field="date">{{ date }}</span>
    <span data-field="document_title">{{ document_title }}</span>
  </div>

  <div style="margin-top: 30px;">
    <p style="font-size: 10pt;">
      If necessary, you can make changes to your abstract submission
    </p>
    <ul style="list-style-type: disc; padding-left: 20px; margin-top: 10px;">
      <li class="list-item"><span data-field="list_item_1">{{ list_item_1 }}</span></li>
      <li class="list-item"><span data-field="list_item_2">Your Abstract ID# is: {{ abstract_id }}.</span></li>
      <li class="list-item"><span data-field="list_item_3">{{ list_item_3 }}</span></li>
      <li class="list-item"><span data-field="list_item_4">{{ list_item_4 }}</span></li>
      <li class="list-item"><span data-field="list_item_5">{{ list_item_5 }}</span></li>
      <li class="list-item"><span data-field="list_item_6">{{ list_item_6 }}</span></li>
    </ul>
  </div>
</div>