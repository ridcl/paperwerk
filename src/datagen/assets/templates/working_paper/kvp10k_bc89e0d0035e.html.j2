    <h1>ADOLESCENT DATING VIOLENCE:</h1>
    <h1>THE INFLUENCE OF FRIENDSHIPS AND SCHOOL CONTEXT</h1>
  </div>
  <div class="author-list">
    <p>{{ author_list }}</p>
  </div>
  <div class="affiliation">
    <p>Department of Sociology and</p>
    <p>Center for Family and Demographic Research</p>
