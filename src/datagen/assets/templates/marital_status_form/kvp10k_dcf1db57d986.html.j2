<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child {
    page-break-after: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  td {
    padding: 5px 0;
  }
  .header-title {
    font-size: 24pt;
    font-weight: bold;
    text-align: center;
    margin-bottom: 5px;
  }
  .sub-header {
    font-size: 12pt;
    text-align: center;
    margin-bottom: 20px;
  }
  .section-title {
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
    font-size: 12pt;
  }
  .label {
    font-weight: normal;
    display: inline-block;
    width: 150px; /* Adjust as needed for alignment */
  }
  .value {
    font-weight: normal;
  }
  .instruction {
    font-style: italic;
    margin-bottom: 15px;
    font-size: 10pt;
  }
  .checkbox-group {
    margin-bottom: 15px;
  }
  .checkbox-group label {
    font-weight: normal;
    display: block;
    margin-bottom: 5px;
  }
  .required-note {
    font-size: 9pt;
    color: #555;
  }
</style>

<div class="page">
  <table style="width: 100%;">
    <tr>
      <td style="width: 30%; text-align: left;">
        <!-- Logo Placeholder -->
        <div style="text-align: center;">
          <img src="placeholder_logo.png" alt="Logo" style="width: 100px; height: auto;">
        </div>
      </td>
      <td style="width: 70%; text-align: right;">
        <div style="font-size: 10pt;">
          <span data-field="address.street">{{ address.street }}</span><br>
          <span data-field="address.city">{{ address.city }}</span>, <span data-field="address.state">{{ address.state }}</span> <span data-field="address.zip">{{ address.zip }}</span><br>
          Phone: <span data-field="phone">{{ phone }}</span><br>
          Fax: <span data-field="fax">{{ fax }}</span><br>
          Email: <span data-field="email">{{ email }}</span><br>
          Website: <span data-field="website">{{ website }}</span>
        </div>
      </td>
    </tr>
  </table>

  <div style="text-align: center; margin-top: 40px;">
    <div class="header-title">2022-2023</div>
    <div class="sub-header">Parent Marital Status Form</div>
    <div style="font-size: 10pt; margin-top: 10px;">*Black Ink Only*</div>
  </div>

  <div class="instruction">
    The Parent Marital Status form is used to document loss of income due to divorce or death of parent, or to reconcile a discrepancy of information reported on the FAFSA regarding the parent's tax filing status and marital status.
  </div>

  <table style="margin-top: 30px;">
    <tr>
      <td style="width: 25%;">Student Name</td>
      <td style="width: 25%;">Student ID</td>
      <td style="width: 50%;">Phone Number (include area code)</td>
    </tr>
    <tr>
      <td><span data-field="student_name">{{ student_name }}</span></td>
      <td><span data-field="student_id">{{ student_id }}</span></td>
      <td><span data-field="phone_number">{{ phone_number }}</span></td>
    </tr>
  </table>

  <div class="section-title">Instructions:</div>
  <div class="instruction">
    Select the option that applies to your parent's current situation and submit this form with the required documentation.
  </div>

  <!-- Married/Remarried Section -->
  <div class="checkbox-group">
    <label>
      <input type="checkbox"> Married/Remarried
    </label>
    <div style="margin-left: 20px;">
      Date of Status: <span data-field="date_married_remarried">{{ date_married_remarried }}</span> <span class="required-note">(Required if Married/Remarried)</span>
      <div class="section-title" style="margin-top: 15px;">Required Documentation:</div>
      <ul style="margin-top: 5px; padding-left: 20px;">
        <li><span data-field="doc_married_remarried_1">{{ doc_married_remarried_1 }}</span></li>
      </ul>
    </div>
  </div>

  <!-- Divorced/Widowed Section -->
  <div class="checkbox-group">
    <label>
      <input type="checkbox"> Divorced/Widowed
    </label>
    <div style="margin-left: 20px;">
      Date of Status: <span data-field="date_divorced_widowed">{{ date_divorced_widowed }}</span> <span class="required-note">(Required if Divorced/Widowed)</span>
      <div class="section-title" style="margin-top: 15px;">Required Documentation:</div>
      <ul style="margin-top: 5px; padding-left: 20px;">
        <li><span data-field="doc_divorced_widowed_1">{{ doc_divorced_widowed_1 }}</span></li>
        <li><span data-field="doc_divorced_widowed_2">{{ doc_divorced_widowed_2 }}</span></li>
      </ul>
    </div>
  </div>

  <!-- Separated Section -->
  <div class="checkbox-group">
    <label>
      <input type="checkbox"> Separated
    </label>
    <div style="margin-left: 20px;">
      <div class="section-title" style="margin-top: 15px;">Please initial one option below:</div>
      <div style="margin-left: 20px;">
        <label style="display: block; margin-bottom: 10px;">
          <input type="checkbox"> I have attached the required documentation as proof of separation: Petition for divorce from courts, legal separation court document (if not married in TX.)
        </label>
        <label style="display: block;">
          OR
        </label>
        <div style="margin-left: 20px;">
          <p style="font-size: 10pt;">I certify that I am separated from my spouse as of the following date <span data-field="date_separated">{{ date_separated }}</span></p>
          <p style="font-size: 10pt;">I maintain a separate household from my spouse, which includes independently paying more than 50% of my household's expenses. Household expenses include mortgage/rent, utilities, food, child care, and health care.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Certification & Signature -->
  <div class="section-title" style="margin-top: 40px;">Certification & Signature(s)</div>
  <div class="instruction">
    I certify the information on this appeal to be complete and accurate and that I have attached the required documentation. If any of the information changes, I understand I must promptly notify the Office of Financial Assistance and that the student listed on this form may be responsible for repayment of financial aid received if I fail to do so.
  </div>

  <table style="margin-top: 50px;">
    <tr>
      <td style="width: 50%; padding-top: 20px;">
        Printed Name of Parent (<span style="font-weight: bold;">Required</span>):<br>
        <span data-field="parent_printed_name">{{ parent_printed_name }}</span>
      </td>
      <td style="width: 50%; padding-top: 20px; text-align: right;">
        Date (<span style="font-weight: bold;">Required</span>):<br>
        <span data-field="date_signed">{{ date_signed }}</span>
      </td>
    </tr>
    <tr>
      <td style="width: 50%; padding-top: 50px;">
        Parent Signature (<span style="font-weight: bold;">Required</span>):<br>
        _________________________
      </td>
      <td style="width: 50%; padding-top: 50px; text-align: right;">
        _________________________
      </td>
    </tr>
  </table>
</div>