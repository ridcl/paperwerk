        <td><span data-field="dependent_relationship_affidavit_{{ loop.index0 }}">{{ dependent_relationship_affidavit_i }}</span></td>
        <td><span data-field="dependent_age_affidavit_{{ loop.index0 }}">{{ dependent_age_affidavit_i }}</span></td>
      </tr>
      {% endfor %}
