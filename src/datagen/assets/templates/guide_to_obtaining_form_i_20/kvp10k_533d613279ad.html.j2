        <td>{{ room_grad }}</td>
        <td>{{ room_mfa }}</td>
      </tr>
      <tr>
        <td>Student Health Insurance</td>
        <td>{{ insurance_undergrad }}</td>
        <td>{{ insurance_grad }}</td>
        <td>{{ insurance_mfa }}</td>
      </tr>
      <tr>
        <td>Books, transportation, food & personal expenses</td>
        <td>{{ expenses_undergrad }}</td>
        <td>{{ expenses_grad }}</td>
        <td>{{ expenses_mfa }}</td>
      </tr>
      <tr>
        <td><strong>Total Per Year:</strong></td>
        <td><strong>{{ total_undergrad }}</strong></td>
        <td><strong>{{ total_grad }}</strong></td>
        <td><strong>{{ total_mfa }}</strong></td>
      </tr>
    </tbody>
  </table>
</div>

<div class="page">
  <p>Tuition for undergraduate studies covers <span data-field="undergrad_credits">{{ undergrad_credits }}</span> for each of the fall and spring semesters. Tuition for graduate studies covers <span data-field="grad_credits">{{ grad_credits }}</span> each of the fall and spring semesters.</p>
  <p><strong>Dependents:</strong> A student planning to bring a spouse or a child in F-2 status or planning to change the status of a spouse or child already in the U.S. to F-2, must show additional funds of <span data-field="dependent_funds_per_year">{{ dependent_funds_per_year }}</span> per year for spouse and <span data-field="dependent_funds_per_child">{{ dependent_funds_per_child }}</span> per year for each child.</p>
</div>

<div class="page">
