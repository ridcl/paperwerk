  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1 { font-size: 24pt; font-weight: bold; margin-bottom: 15px; }
  p { font-size: 11pt; line-height: 1.5; margin-bottom: 10px; }
</style>

