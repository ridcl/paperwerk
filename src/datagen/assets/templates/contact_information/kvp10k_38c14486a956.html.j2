<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
</style>

<div class="page">
  <div style="display: flex; align-items: center; margin-bottom: 40px;">
    <div style="font-size: 48px; font-weight: bold; color: #003366; margin-right: 10px;">UF</div>
    <div style="display: flex; flex-direction: column; justify-content: center;">
      <div style="font-size: 36px; font-weight: bold;">UNIVERSITY of</div>
      <div style="font-size: 60px; font-weight: bold;">FLORIDA</div>
    </div>
  </div>

  <div style="margin-bottom: 30px;">
    <h1 style="font-size: 28px; font-weight: bold; margin: 0;">
      <span data-field="full_name">{{ full_name }}</span>
    </h1>
    <p style="font-size: 18px; margin: 5px 0;">
      <span data-field="employer.title_1">{{ employer.title_1 }}</span>
    </p>
    <p style="font-size: 18px; margin: 0;">
      <span data-field="employer.title_2">{{ employer.title_2 }}</span>
    </p>
  </div>

  <div style="display: flex; justify-content: space-between; font-size: 14px; line-height: 1.5;">
    <div style="flex-grow: 1;">
      <p style="margin: 0;">
        <span data-field="contact.address_line_1">{{ contact.address_line_1 }}</span>
      </p>
      <p style="margin: 0;">
        <span data-field="contact.address_line_2">{{ contact.address_line_2 }}</span>
      </p>
      <p style="margin: 0;">
        <span data-field="contact.city_state_zip">{{ contact.city_state_zip }}</span>
      </p>
    </div>
    <div style="text-align: right;">
      <p style="margin: 0;">
        <span data-field="contact.phone_main">{{ contact.phone_main }}</span>
      </p>
      <p style="margin: 0;">
        <span data-field="contact.phone_fax">{{ contact.phone_fax }}</span>
      </p>
      <p style="margin: 0;">
        <span data-field="contact.email">{{ contact.email }}</span>
      </p>
      <p style="margin: 0;">
        <span data-field="contact.website">{{ contact.website }}</span>
      </p>
    </div>
  </div>
</div>