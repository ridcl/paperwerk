<!DOCTYPE html>
<html>
<head>
<title>Curriculum Vitae</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
    line-height: 1.5;
    color: #333;
  }
  h1, h2, h3 {
    font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif;
    font-weight: bold;
  }
  .header-info {
    text-align: center;
    margin-bottom: 30px;
  }
  .contact-info p {
    margin: 2px 0;
  }
  .section-title {
    font-size: 14pt;
    margin-top: 20px;
    margin-bottom: 10px;
    border-bottom: 1px solid #ccc;
    padding-bottom: 3px;
  }
  .entry {
    margin-bottom: 15px;
  }
  .entry-title {
    font-weight: bold;
  }
  .entry-details {
    font-style: italic;
    margin-left: 15px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
  }
  td {
    padding: 5px 0;
    vertical-align: top;
  }
  .publication-list li {
    margin-bottom: 10px;
    font-size: 10pt;
  }
  .page-number {
    text-align: center;
    position: absolute;
    bottom: 20px;
    width: 100%;
    font-size: 10pt;
    color: #777;
  }
</style>

<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; line-height: 1.5; }
  h1, h2, h3 { font-weight: bold; margin-top: 1.5em; margin-bottom: 0.5em; }
  .section-title { font-weight: bold; text-transform: uppercase; margin-top: 1.5em; margin-bottom: 0.5em; }
  ul { list-style-type: disc; padding-left: 20px; margin-top: 0.5em; margin-bottom: 0.5em; }
  li { margin-bottom: 0.3em; }
</style>
</head>
<body>

<div class="page">
  <div class="header-info">
    <h1>Curriculum Vitae</h1>
    <p><span>{{ full_name }}</span></p>
    <p><span>{{ employer.title }}</span>, <span>{{ employer.department }}</span>, <span>{{ employer.institution }}</span></p>
  </div>

  <div class="section-title">WORK ADDRESS</div>
  <div class="contact-info">
    <p><span>{{ address_line_1 }}</span></p>
    <p>Email: <span data-field="email">{{ email }}</span></p>
    <p>Fax: <span data-field="fax">{{ fax }}</span></p>
  </div>

  <div class="section-title">EDUCATION</div>
  <div class="entry">
    <div class="entry-title">Ph.D. ({{ education_phd_year }})</div>
    <div class="entry-details">
      <span>{{ education_phd_institution }}</span>, <span>{{ education_phd_location }}</span>. Graduated with <span>{{ education_phd_award }}</span>. Dissertation: <span>{{ education_phd_dissertation_title }}</span>. Advisor: <span>{{ education_phd_advisor }}</span>.
    </div>
  </div>

  <div class="entry">
    <div class="entry-title">M.S. ({{ education_ms_year }})</div>
    <div class="entry-details">
      <span>{{ education_ms_institution }}</span>, <span>{{ education_ms_location }}</span>. Thesis: <span>{{ education_ms_thesis_title }}</span>. Advisor: <span>{{ education_ms_advisor }}</span>.
    </div>
  </div>

  <div class="entry">
    <div class="entry-title">B.S. ({{ education_bs_year }})</div>
    <div class="entry-details">
      <span>{{ education_bs_institution }}</span>, <span>{{ education_bs_location }}</span>. Thesis: <span>{{ education_bs_thesis_title }}</span>. Advisor: <span>{{ education_bs_advisor }}</span>.
    </div>
  </div>

  <div class="section-title">PROFESSIONAL APPOINTMENTS</div>
  <div class="entry">
    <div class="entry-title">Assistant Professor ({{ appointment_prof_start_year }}-Present)</div>
    <div class="entry-details">
      <span>{{ appointment_prof_institution }}</span>, <span>{{ appointment_prof_department }}</span>, <span>{{ appointment_prof_focus }}</span>.
    </div>
  </div>

  <div class="entry">
    <div class="entry-title">Postdoctoral Research Fellow ({{ appointment_postdoc_start_year }}-{{ appointment_postdoc_end_year }})</div>
    <div class="entry-details">
      <span>{{ appointment_postdoc_institution }}</span>, <span>{{ appointment_postdoc_department }}</span>, <span>{{ appointment_postdoc_focus }}</span>.
    </div>
  </div>

  <div class="entry">
    <div class="entry-title">Graduate Research Assistant ({{ appointment_gra_start_year }}-{{ appointment_gra_end_year }})</div>
    <div class="entry-details">
      <span>{{ appointment_gra_institution }}</span>, <span>{{ appointment_gra_department }}</span>.
    </div>
  </div>

  <div class="entry">
    <div class="entry-title">Field Research Assistant ({{ appointment_fra_start_year }}-{{ appointment_fra_end_year }})</div>
    <div class="entry-details">
      <span>{{ appointment_fra_institution }}</span>, <span>{{ appointment_fra_department }}</span>.
    </div>
  </div>

  <div class="page-number">page 1 of 9</div>
</div>

<div class="page">
  <div class="section-title">PROFESSIONAL RECOGNITION</div>

  <div class="section-title">PEER-REVIEWED PUBLICATIONS</div>
  <ul class="publication-list">
    {% for pub in peer_reviewed_publications %}
    <li>
      ({{ pub.number }}) <span>{{ pub.authors }}</span>, ({{ pub.year }}) <span>{{ pub.title }}</span>. <span>{{ pub.journal_info }}</span>.
    </li>
    {% endfor %}
  </ul>

  <div class="page-number">page 2 of 9</div>
</div>

<div class="page">
  <div class="section-title">GRANTS & PROPOSALS</div>

  <div class="section-title">Granted Funding</div>
  <ul class="publication-list">
    {% for grant in granted_funding %}
    <li>
      ({{ grant.number }}) <span>{{ grant.description }}</span>. <span>{{ grant.institution }}</span>, <span>{{ grant.date }}</span>. Amount: <span>{{ grant.amount }}</span>.
    </li>
    {% endfor %}
  </ul>

  <div class="section-title">Grant Proposals submitted but not funded</div>
  <ul class="publication-list">
    {% for proposal in grant_proposals %}
    <li>
      ({{ proposal.number }}) <span>{{ proposal.description }}</span>. <span>{{ proposal.institution }}</span>, <span>{{ proposal.date }}</span>. Amount requested: <span>{{ proposal.amount_requested }}</span>.
    </li>
    {% endfor %}
  </ul>

  <div class="section-title">AWARDS AND HONORS</div>
  <ul class="publication-list">
    {% for award in awards_and_honors %}
    <li>
      ({{ award.number }}) <span>{{ award.description }}</span>. <span>{{ award.institution }}</span>, <span>{{ award.year }}</span>.
    </li>
    {% endfor %}
  </ul>

  <div class="section-title">CONFERENCE PROCEEDINGS</div>
  <ul class="publication-list">
    {% for proceedings in conference_proceedings %}
    <li>
      <span>{{ proceedings.authors }}</span>, ({{ proceedings.year }}) <span>{{ proceedings.title }}</span>. <span>{{ proceedings.venue_info }}</span>.
    </li>
    {% endfor %}
  </ul>

  <div class="page-number">page 3 of 9</div>
</div>

<div class="page">
  <div class="section-title">NEWSPAPERS & OTHERS</div>
  <ul class="publication-list">
    {% for newspaper in newspapers_and_others %}
    <li>
      <span>{{ newspaper.authors }}</span>, ({{ newspaper.year }}) <span>{{ newspaper.title }}</span>. <span>{{ newspaper.venue_info }}</span>.
    </li>
    {% endfor %}
  </ul>

  <div class="section-title">CONFERENCE PRESENTATIONS</div>
  <ul class="publication-list">
    {% for presentation in conference_presentations %}
    <li>
      <span>{{ presentation.authors }}</span>, ({{ presentation.year }}) <span>{{ presentation.title }}</span>. <span>{{ presentation.venue_info }}</span>.
    </li>
    {% endfor %}
  </ul>

  <div class="page-number">page 4 of 9</div>
</div>

<div class="page">
  <div class="section-title">PROFESSIONAL COMPETENCE IN TEACHING</div>

  <div class="section-title">TEACHING EXPERIENCE</div>
  <div class="entry">
    <div class="entry-title">Course Taught at <span>{{ teaching_institution_1 }}</span></div>
    <ul class="publication-list">
      {% for course in teaching_courses_1 %}
      <li>
        ({{ course.number }}) <span>{{ course.title }}</span> ({{ course.year }}) - <span>{{ course.details }}</span>.
      </li>
      {% endfor %}
    </ul>
  </div>

  <div class="entry">
    <div class="entry-title">Course Taught at <span>{{ teaching_institution_2 }}</span></div>
    <ul class="publication-list">
      {% for course in teaching_courses_2 %}
      <li>
        ({{ course.number }}) <span>{{ course.title }}</span> ({{ course.year }}) - <span>{{ course.details }}</span>.
      </li>
      {% endfor %}
    </ul>
  </div>

  <div class="section-title">THESES SUPERVISION</div>
  <div class="entry">
    <div class="entry-title">Chair</div>
    <ul class="publication-list">
      {% for thesis in thesis_supervision_chair %}
      <li>
        ({{ thesis.number }}) <span>{{ thesis.student_name }}</span> (graduated in {{ thesis.year }}), M.S. <span>{{ thesis.title }}</span>.
      </li>
      {% endfor %}
    </ul>
  </div>

  <div class="entry">
    <div class="entry-title">Committee Member</div>
    <ul class="publication-list">
      {% for thesis in thesis_supervision_committee %}
      <li>
        ({{ thesis.number }}) <span>{{ thesis.student_name }}</span> (graduated in {{ thesis.year }}), Committee Member. <span>{{ thesis.title }}</span>.
      </li>
      {% endfor %}
    </ul>
  </div>

  <div class="entry">
    <div class="entry-title">Committee Member</div>
    <ul class="publication-list">
      {% for thesis in thesis_supervision_committee_2 %}
      <li>
        ({{ thesis.number }}) <span>{{ thesis.student_name }}</span> (graduated in {{ thesis.year }}), Committee Member. <span>{{ thesis.title }}</span>.
      </li>
      {% endfor %}
    </ul>
  </div>

  <div class="page-number">page 5 of 9</div>
</div>

<div class="page">
  <div class="section-title">EXTERNAL SERVICES</div>
  <ul class="publication-list">
    {% for service in external_services %}
    <li>
      ({{ service.number }}) <span>{{ service.description }}</span>.
    </li>
    {% endfor %}
  </ul>

  <div class="section-title">CONFERENCE SERVICES</div>
  <ul class="publication-list">
    {% for service in conference_services %}
    <li>
      ({{ service.number }}) <span>{{ service.description }}</span>.
    </li>
    {% endfor %}
  </ul>

  <div class="page-number">page 6 of 9</div>
</div>


<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; line-height: 1.5; }
  h1, h2, h3 { font-weight: bold; margin-top: 1.5em; margin-bottom: 0.5em; }
  .section-title { font-weight: bold; text-transform: uppercase; margin-top: 1.5em; margin-bottom: 0.5em; }
  ul { list-style-type: disc; padding-left: 20px; margin-top: 0.5em; margin-bottom: 0.5em; }
  li { margin-bottom: 0.3em; }
</style>

<div class="page">
  <p>Updated on <span data-field="update_date">{{ update_date }}</span></p>

  <div class="section-title">Publications</div>
  <ul>
    <li><span data-field="publication_title_1">{{ publication_title_1 }}</span> (<span data-field="publication_count_1">{{ publication_count_1 }}</span>)</li>
    <li><span data-field="publication_title_2">{{ publication_title_2 }}</span> (<span data-field="publication_count_2">{{ publication_count_2 }}</span>)</li>
    <li><span data-field="publication_title_3">{{ publication_title_3 }}</span> (<span data-field="publication_count_3">{{ publication_count_3 }}</span>)</li>
    <li><span data-field="publication_title_4">{{ publication_title_4 }}</span> (<span data-field="publication_count_4">{{ publication_count_4 }}</span>)</li>
    <li><span data-field="publication_title_5">{{ publication_title_5 }}</span> (<span data-field="publication_count_5">{{ publication_count_5 }}</span>)</li>
    <li><span data-field="publication_title_6">{{ publication_title_6 }}</span> (<span data-field="publication_count_6">{{ publication_count_6 }}</span>)</li>
    <li><span data-field="publication_title_7">{{ publication_title_7 }}</span> (<span data-field="publication_count_7">{{ publication_count_7 }}</span>)</li>
    <li><span data-field="publication_title_8">{{ publication_title_8 }}</span> (<span data-field="publication_count_8">{{ publication_count_8 }}</span>)</li>
    <li><span data-field="publication_title_9">{{ publication_title_9 }}</span> (<span data-field="publication_count_9">{{ publication_count_9 }}</span>)</li>
    <li><span data-field="publication_title_10">{{ publication_title_10 }}</span> (<span data-field="publication_count_10">{{ publication_count_10 }}</span>)</li>
  </ul>

  <div class="section-title">Book chapter reviewer for:</div>
  <ul>
    <li><span data-field="reviewer_journal">{{ reviewer_journal }}</span></li>
  </ul>

  <div class="section-title">INTERNAL SERVICES</div>
  <ul>
    <li><span data-field="service_entry_1">{{ service_entry_1 }}</span></li>
    <li><span data-field="service_entry_2">{{ service_entry_2 }}</span></li>
    <li><span data-field="service_entry_3">{{ service_entry_3 }}</span></li>
  </ul>

  <div class="section-title">OTHER RECORDS</div>

  <div class="section-title">MEMBERSHIP IN PROFESSIONAL ORGANIZATIONS</div>
  <ul>
    <li><span data-field="membership_org_1">{{ membership_org_1 }}</span> (<span data-field="membership_date_1">{{ membership_date_1 }}</span>)</li>
    <li><span data-field="membership_org_2">{{ membership_org_2 }}</span> (<span data-field="membership_date_2">{{ membership_date_2 }}</span>)</li>
  </ul>

  <div class="section-title">SKILLS</div>
  <p>Languages: <span data-field="skill_language_1">{{ skill_language_1 }}</span>, <span data-field="skill_language_2">{{ skill_language_2 }}</span>, <span data-field="skill_language_3">{{ skill_language_3 }}</span>, <span data-field="skill_language_4">{{ skill_language_4 }}</span>. Operating Systems: <span data-field="skill_os_1">{{ skill_os_1 }}</span> & <span data-field="skill_os_2">{{ skill_os_2 }}</span></p>
  <p>Programming Languages: <span data-field="skill_programming_1">{{ skill_programming_1 }}</span> (very proficient), <span data-field="skill_programming_2">{{ skill_programming_2 }}</span> (very proficient)</p>
  <p>Software Packages: <span data-field="skill_software_1">{{ skill_software_1 }}</span> (very proficient), <span data-field="skill_software_2">{{ skill_software_2 }}</span> (proficient), <span data-field="skill_software_3">{{ skill_software_3 }}</span> (proficient)</p>
  <p>Statistic Packages: <span data-field="skill_stats_1">{{ skill_stats_1 }}</span> (proficient) and SPSS Models: <span data-field="skill_stats_2">{{ skill_stats_2 }}</span>, <span data-field="skill_stats_3">{{ skill_stats_3 }}</span>, <span data-field="skill_stats_4">{{ skill_stats_4 }}</span></p>
</div>

<div class="page">
  <!-- Placeholder for page 2 content if necessary, otherwise this is the end -->
</div></body>
</html>