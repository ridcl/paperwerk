<!DOCTYPE html>
<html>
<head>
<title>Curriculum Vitae</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { font-weight: bold; }
  .header-info { display: flex; justify-content: space-between; margin-bottom: 30px; }
  .section-title { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
  .contact-info p { margin: 2px 0; }
  .job-entry, .education-entry, .research-entry { margin-bottom: 15px; }
  .job-header, .education-header, .research-header { display: flex; justify-content: space-between; font-weight: bold; }
  .job-details, .education-details, .research-details { margin-top: 5px; font-size: 0.9em; }
  .list-item { margin-bottom: 5px; }
  table { width: 100%; border-collapse: collapse; margin-top: 10px; }
  td { padding: 5px 0; }
</style>

<style>
