    <div class="list-item"><span data-field="service_5">{{ service_5 }}</span></div>
    <div class="list-item"><span data-field="service_6">{{ service_6 }}</span></div>
    <div class="list-item"><span data-field="service_7">{{ service_7 }}</span></div>
  </div>

  <div class="section-title">Professional Associations</div>
  <div style="font-size: 9pt;">
    <div class="list-item"><span data-field="association_1">{{ association_1 }}</span></div>
    <div class="list-item"><span data-field="association_2">{{ association_2 }}</span></div>
    <div class="list-item"><span data-field="association_3">{{ association_3 }}</span></div>
    <div class="list-item"><span data-field="association_4">{{ association_4 }}</span></div>
    <div class="list-item"><span data-field="association_5">{{ association_5 }}</span></div>
    <div class="list-item"><span data-field="association_6">{{ association_6 }}</span></div>
