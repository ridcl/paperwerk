  </div>
</div>
<div class="page">
  <div style="text-align: right; font-size: 9pt;">6</div>
</div>

<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  .references-section { display: flex; justify-content: space-between; margin-top: 30px; }
  .contact-block { width: 30%; }
  .contact-block div { margin-bottom: 15px; }
  .contact-block strong { display: inline-block; width: 60px; }
</style>

<div class="page">
  <h2 style="font-size: 16pt; font-weight: bold; margin-bottom: 20px;">References</h2>
  <div class="references-section">
    
    <!-- Column 1 -->
    <div class="contact-block">
      <div>
        <strong>Dr.</strong> <span data-field="contact_1.first_name">{{ contact_1.first_name }}</span> <span data-field="contact_1.last_name">{{ contact_1.last_name }}</span><br>
        <span data-field="contact_1.affiliation">{{ contact_1.affiliation }}</span><br>
        Email: <span data-field="contact_1.email">{{ contact_1.email }}</span><br>
        Phone: <span data-field="contact_1.phone">{{ contact_1.phone }}</span>
      </div>
      <div>
        <strong>Dr.</strong> <span data-field="contact_2.first_name">{{ contact_2.first_name }}</span> <span data-field="contact_2.last_name">{{ contact_2.last_name }}</span><br>
        <span data-field="contact_2.affiliation">{{ contact_2.affiliation }}</span><br>
        Email: <span data-field="contact_2.email">{{ contact_2.email }}</span><br>
        Phone: <span data-field="contact_2.phone">{{ contact_2.phone }}</span>
      </div>
    </div>

    <!-- Column 2 -->
    <div class="contact-block">
      <div>
        <strong>Dr.</strong> <span data-field="contact_3.first_name">{{ contact_3.first_name }}</span> <span data-field="contact_3.last_name">{{ contact_3.last_name }}</span><br>
        <span data-field="contact_3.affiliation">{{ contact_3.affiliation }}</span><br>
        Email: <span data-field="contact_3.email">{{ contact_3.email }}</span><br>
        Phone: <span data-field="contact_3.phone">{{ contact_3.phone }}</span>
      </div>
      <div>
        <strong>Dr.</strong> <span data-field="contact_4.first_name">{{ contact_4.first_name }}</span> <span data-field="contact_4.last_name">{{ contact_4.last_name }}</span><br>
        <span data-field="contact_4.affiliation">{{ contact_4.affiliation }}</span><br>
        Email: <span data-field="contact_4.email">{{ contact_4.email }}</span><br>
        Phone: <span data-field="contact_4.phone">{{ contact_4.phone }}</span>
      </div>
    </div>
  </div>
  
  <div style="position: absolute; bottom: 50px; right: 60px; font-size: 10pt;">9</div>
</div></body>
</html>