</head>
<body>

<div class="page">
  <div class="header-logo">
    <!-- Placeholder for LSU Health Logo -->
    <div style="font-size: 24px; font-weight: bold;">LSU Health</div>
    <div style="font-size: 14px;">School of Nursing</div>
  </div>

  <h1 style="text-align: center; font-size: 24px;">CURRICULUM VITAE</h1>

  <div style="margin-top: 30px;">
    <h2 style="text-align: center;">{{ full_name }}</h2>
  </div>

  <div style="margin-top: 20px;">
    <p>Current Title: <span data-field="current_title">{{ current_title }}</span></p>
    <p>Business Address: <span data-field="business_address">{{ business_address }}</span></p>
    <p>Business Telephone: <span data-field="business_telephone">{{ business_telephone }}</span></p>
    <p>Business Email Address: <span data-field="business_email">{{ business_email }}</span></p>
    <p>Citizenship: <span data-field="citizenship">{{ citizenship }}</span></p>
    <p>Date of Initial Appointment: <span data-field="date_of_initial_appointment">{{ date_of_initial_appointment }}</span></p>
    <p>Academic Rank: <span data-field="academic_rank">{{ academic_rank }}</span></p>
    <p>Date Appointed to Present Rank: <span data-field="date_appointed_to_present_rank">{{ date_appointed_to_present_rank }}</span></p>
    <p>Tenure Status: <span data-field="tenure_status">{{ tenure_status }}</span></p>
