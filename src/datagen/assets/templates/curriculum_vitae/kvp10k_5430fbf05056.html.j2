<!DOCTYPE html>
<html>
<head>
<title>Curriculum Vitae</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
    line-height: 1.5;
    color: #333;
  }
  h1, h2, h3 {
    font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif;
    font-weight: bold;
  }
  .header-info {
    text-align: center;
    margin-bottom: 40px;
  }
  .contact-info {
    margin-bottom: 30px;
    font-size: 0.9em;
  }
  .section-title {
    font-size: 1.2em;
    font-weight: bold;
    margin-top: 25px;
    margin-bottom: 10px;
    border-bottom: 1px solid #ccc;
    padding-bottom: 3px;
  }
  .entry {
    margin-bottom: 15px;
  }
  .entry-title {
    font-weight: bold;
  }
  .entry-details {
    font-style: italic;
    font-size: 0.95em;
  }
  ul {
    list-style-type: disc;
    margin-left: 20px;
    padding-left: 0;
  }
  li {
    margin-bottom: 8px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
  }
  td {
    padding: 5px 0;
  }
</style>

<style>
  @page { size: A4; margin: 0; }
