<!DOCTYPE html>
<html>
<head>
<title>Curriculum Vitae</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 {
    font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif;
    font-weight: bold;
  }
  .section-title {
    font-weight: bold;
    text-transform: uppercase;
    margin-top: 20px;
    margin-bottom: 10px;
  }
  .sub-heading {
    font-weight: bold;
    margin-top: 15px;
    margin-bottom: 5px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
  }
  td {
    padding: 5px 0;
    vertical-align: top;
  }
  .left-align {
    text-align: left;
  }
  .right-align {
    text-align: right;
  }
</style>
</head>
<body>
<div class="page">
  <div class="right-align">1</div>
  <h1>Curriculum Vitae</h1>
  <p><span data-field="full_name">{{ full_name }}</span></p>

  <div class="section-title">CURRENT INFORMATION</div>
  <table>
    <tr>
      <td class="left-align">Rank/Title:</td>
      <td class="left-align"><span data-field="rank_title">{{ rank_title }}</span></td>
    </tr>
    <tr>
      <td class="left-align">Department:</td>
      <td class="left-align"><span data-field="department">{{ department }}</span></td>
    </tr>
    <tr>
      <td class="left-align">Business Address:</td>
      <td class="left-align"><span data-field="business_address">{{ business_address }}</span></td>
    </tr>
    <tr>
      <td class="left-align">Business Phone:</td>
      <td class="left-align"><span data-field="business_phone">{{ business_phone }}</span></td>
    </tr>
    <tr>
      <td class="left-align">Email:</td>
      <td class="left-align"><span data-field="email">{{ email }}</span></td>
    </tr>
  </table>

  <div class="section-title">EDUCATION</div>
  <table>
    <tr>
      <td style="width: 30%;">Date Received</td>
      <td style="width: 70%;"><span data-field="education_date_received">{{ education_date_received }}</span></td>
    </tr>
  </table>

  <div class="sub-heading">Degree Received</div>
  <p><span data-field="degree_received">{{ degree_received }}</span></p>

  <div class="sub-heading">Institution</div>
  <p><span data-field="institution">{{ institution }}</span></p>

  <div class="sub-heading">Education History</div>
  <table>
    <tr>
      <td style="width: 30%;">August 2008</td>
      <td style="width: 70%;"><span data-field="education_entry_1_degree">{{ education_entry_1_degree }}</span></td>
    </tr>
    <tr>
      <td style="width: 30%;">May 2006</td>
      <td style="width: 70%;"><span data-field="education_entry_2_degree">{{ education_entry_2_degree }}</span></td>
    </tr>
  </table>
</div>

<div class="page">
  <div class="right-align">2</div>

  <div class="section-title">PREVIOUS PROFESSIONAL POSITIONS AND APPOINTMENTS</div>
  <table>
    <tr>
      <td style="width: 30%;">Policy Analyst, The Sycamore Institute, Nashville, TN, 2016-2019</td>
      <td style="width: 70%;"><span data-field="previous_position_1_title">{{ previous_position_1_title }}</span></td>
    </tr>
    <tr>
      <td style="width: 30%;">Postdoctoral Research Associate, University of Tennessee Health Science Center, Research Center on Health Disparities, Equity, and the Exposome, Memphis, TN, 2013-2014</td>
      <td style="width: 70%;"><span data-field="previous_position_2_title">{{ previous_position_2_title }}</span></td>
    </tr>
    <tr>
      <td style="width: 30%;">Research Assistant, University of Tennessee Health Science Center, Department of Preventive Medicine, 2009-2010</td>
      <td style="width: 70%;"><span data-field="previous_position_3_title">{{ previous_position_3_title }}</span></td>
    </tr>
  </table>

  <div class="section-title">PROFESSIONAL SOCIETIES</div>
  <table>
    <tr>
      <td style="width: 30%;">Member, American Public Health Association, 2018-present</td>
      <td style="width: 70%;"><span data-field="societies_member_1">{{ societies_member_1 }}</span></td>
    </tr>
  </table>

  <div class="section-title">RESEARCH INTERESTS</div>
  <ul>
    <li><span data-field="research_interest_1">{{ research_interest_1 }}</span></li>
    <li><span data-field="research_interest_2">{{ research_interest_2 }}</span></li>
    <li><span data-field="research_interest_3">{{ research_interest_3 }}</span></li>
    <li><span data-field="research_interest_4">{{ research_interest_4 }}</span></li>
  </ul>

  <div class="section-title">PUBLICATIONS</div>

  <div class="sub-heading">PEER-REVIEWED: PUBLISHED AND IN PRESS</div>
  <ul>
    <li><span data-field="publication_1">{{ publication_1 }}</span></li>
    <li><span data-field="publication_2">{{ publication_2 }}</span></li>
    <li><span data-field="publication_3">{{ publication_3 }}</span></li>
    <li><span data-field="publication_4">{{ publication_4 }}</span></li>
  </ul>
</div>

<div class="page">
  <div class="right-align">3</div>

  <div class="sub-heading">Journal Articles</div>
