    <li><span data-field="journal_article_1">{{ journal_article_1 }}</span></li>
    <li><span data-field="journal_article_2">{{ journal_article_2 }}</span></li>
    <li><span data-field="journal_article_3">{{ journal_article_3 }}</span></li>
    <li><span data-field="journal_article_4">{{ journal_article_4 }}</span></li>
    <li><span data-field="journal_article_5">{{ journal_article_5 }}</span></li>
  </ul>

  <div class="sub-heading">POLICY BRIEFS AND WHITE PAPERS</div>
