    <li><span data-field="policy_brief_1">{{ policy_brief_1 }}</span></li>
    <li><span data-field="policy_brief_2">{{ policy_brief_2 }}</span></li>
    <li><span data-field="policy_brief_3">{{ policy_brief_3 }}</span></li>
    <li><span data-field="policy_brief_4">{{ policy_brief_4 }}</span></li>
    <li><span data-field="policy_brief_5">{{ policy_brief_5 }}</span></li>
    <li><span data-field="policy_brief_6">{{ policy_brief_6 }}</span></li>
    <li><span data-field="policy_brief_7">{{ policy_brief_7 }}</span></li>
    <li><span data-field="policy_brief_8">{{ policy_brief_8 }}</span></li>
    <li><span data-field="policy_brief_9">{{ policy_brief_9 }}</span></li>
  </ul>
</div>

<div class="page">
