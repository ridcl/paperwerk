<!DOCTYPE html>
<html>
<head>
<title>CV Template</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { font-weight: bold; }
  .header-info { display: flex; justify-content: space-between; margin-bottom: 20px; }
  .contact-info p { margin: 2px 0; }
  .section-title { font-size: 14pt; margin-top: 20px; margin-bottom: 10px; border-bottom: 1px solid #ccc; padding-bottom: 3px; }
  .entry { margin-bottom: 15px; }
  .entry-header { display: flex; justify-content: space-between; font-weight: bold; }
  .entry-details { margin-top: 3px; font-size: 10pt; }
  .publication-item { margin-bottom: 10px; font-size: 10pt; }
  .publication-item strong { font-weight: bold; }
</style>

<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic typography mirroring the source's academic/formal feel */
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
    line-height: 1.5;
    color: #333;
  }
  h1, h2, h3 {
    font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif;
    font-weight: bold;
  }
  .reference-entry {
    margin-bottom: 15px;
  }
</style>
</head>
<body>

<div class="page">
  <div style="text-align: center;">
    <h1 style="font-size: 24pt; margin-bottom: 5px;">{{ full_name }}</h1>
  </div>
  <div class="header-info">
    <div class="contact-info">
      <p>Email: <span data-field="email">{{ email }}</span></p>
      <p>Phone: <span data-field="phone">{{ phone }}</span></p>
      <p>Fax: <span data-field="fax">{{ fax }}</span></p>
    </div>
    <div style="text-align: right;">
      <p>Address: <span data-field="address">{{ address }}</span></p>
    </div>
  </div>

  <div class="section-title">Education</div>
  <div class="entry">
    <div class="entry-header">
      <span>{{ education_entry.degree }}</span>
      <span>{{ education_entry.year }}</span>
    </div>
    <div class="entry-details">
      <span data-field="education_entry.institution">{{ education_entry.institution }}</span>, <span data-field="education_entry.location">{{ education_entry.location }}</span>.
      <p style="margin: 3px 0 0 0;">Dissertation title: <span data-field="education_entry.dissertation_title">{{ education_entry.dissertation_title }}</span></p>
    </div>
  </div>

  <div class="section-title">Research Interest</div>
  <div style="font-size: 10pt;">
    <span data-field="research_interests_list">{{ research_interests_list }}</span>
  </div>

  <div class="section-title">Professional Experiences</div>
  {% for job in professional_experiences %}
    <div class="entry">
      <div class="entry-header">
        <span>{{ job.title }}</span>
        <span>{{ job.dates }}</span>
      </div>
      <div class="entry-details">
        <span data-field="job.organization">{{ job.organization }}</span>.
        <p style="margin: 3px 0 0 0;">Contributions: <span data-field="job.contributions">{{ job.contributions }}</span></p>
        {% if job.supervisor %}
          <p style="margin: 3px 0 0 0;">Supervisor: <span data-field="job.supervisor">{{ job.supervisor }}</span></p>
        {% endif %}
        {% if job.research_problem %}
          <p style="margin: 3px 0 0 0;">Research problem: <span data-field="job.research_problem">{{ job.research_problem }}</span></p>
        {% endif %}
        {% if job.contributions_detail %}
          <p style="margin: 3px 0 0 0;">Contributions: <span data-field="job.contributions_detail">{{ job.contributions_detail }}</span></p>
        {% endif %}
      </div>
    </div>
  {% endfor %}

  <div class="section-title">Honors and Awards</div>
  {% for award in honors_and_awards %}
    <div class="entry">
      <div class="entry-header">
        <span>{{ award.name }}</span>
        <span>{{ award.year }}</span>
      </div>
      <div class="entry-details">
        <span data-field="award.details">{{ award.details }}</span>
      </div>
    </div>
  {% endfor %}

  <div class="section-title">Publications</div>
  <div style="font-size: 10pt;">
    {% for pub in publications %}
      <div class="publication-item">
        <strong>{{ pub.type }}:</strong> {{ pub.title }}
        {% if pub.authors %}
          (Authors: {{ pub.authors }})
        {% endif %}
        <br>
        <span data-field="pub.journal_info">{{ pub.journal_info }}</span>
      </div>
    {% endfor %}
  </div>

  <div class="section-title">Technical Reports</div>
  <div style="font-size: 10pt;">
    {% for report in technical_reports %}
      <div class="publication-item">
        <strong>Technical Report:</strong> {{ report.title }}
        <br>
        <span data-field="report.details">{{ report.details }}</span>
      </div>
    {% endfor %}
  </div>

  <div class="section-title">Research Grants</div>
  <div style="font-size: 10pt;">
    {% for grant in research_grants %}
      <div class="publication-item">
        <strong>Grant:</strong> {{ grant.title }}
        <br>
        <span data-field="grant.details">{{ grant.details }}</span>
      </div>
    {% endfor %}
  </div>

</div>

<div class="page">
  <div class="section-title">Course Developments/Upgrades</div>
  {% for course in course_developments %}
    <div class="entry">
      <div class="entry-header">
        <span>{{ course.title }}</span>
        <span>{{ course.year }}</span>
      </div>
      <div class="entry-details">
        <span data-field="course.details">{{ course.details }}</span>
      </div>
    </div>
  {% endfor %}

  <div class="section-title">Teaching Experience</div>
  {% for teaching in teaching_experience %}
    <div class="entry">
      <div class="entry-header">
        <span>{{ teaching.title }}</span>
        <span>{{ teaching.year }}</span>
      </div>
      <div class="entry-details">
        <span data-field="teaching.details">{{ teaching.details }}</span>
      </div>
    </div>
  {% endfor %}

  <div class="section-title">Technical Presentations</div>
  {% for presentation in technical_presentations %}
    <div class="entry">
      <div class="entry-header">
        <span>{{ presentation.title }}</span>
        <span>{{ presentation.year }}</span>
      </div>
      <div class="entry-details">
        <span data-field="presentation.details">{{ presentation.details }}</span>
      </div>
    </div>
  {% endfor %}

</div>


<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic typography mirroring the source's academic/formal feel */
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
    line-height: 1.5;
    color: #333;
  }
  h1, h2, h3 {
    font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif;
    font-weight: bold;
  }
  .reference-entry {
    margin-bottom: 15px;
  }
</style>

<div class="page">
  <div style="text-align: justify;">
    <div class="reference-entry">
      <p style="font-weight: bold;">Use Case-Based Modeling and Analysis of Failsafe Fault-Tolerance (poster presentation).</p>
      <p style="margin-top: 0;">International Conference on Requirements Engineering, <span data-field="location">{{ location }}</span>. <span data-field="date">{{ date }}</span>.</p>
    </div>

    <div class="reference-entry">
      <p style="font-weight: bold;">Automated Design of Fault-Tolerance.</p>
      <p style="margin-top: 0;">University of <span data-field="institution">{{ institution }}</span>, <span data-field="location">{{ location }}</span>. <span data-field="date">{{ date }}</span>.</p>
    </div>

    <div class="reference-entry">
      <p style="font-weight: bold;">Hierarchical Presynthesized Component for Automatic Addition of Fault-Tolerance.</p>
      <p style="margin-top: 0;">Poster workshop of the 12th ACM SIGSOFT SAVCBS Workshop, <span data-field="location">{{ location }}</span>, <span data-field="country">{{ country }}</span>. <span data-field="date">{{ date }}</span>.</p>
    </div>

    <div class="reference-entry">
      <p style="font-weight: bold;">Mechanical Verification of Automatic Synthesis of Failsafe Fault-Tolerance.</p>
      <p style="margin-top: 0;">Poster talk in <span data-field="location">{{ location }}</span>, <span data-field="country">{{ country }}</span>. <span data-field="date">{{ date }}</span>.</p>
    </div>

    <div class="reference-entry">
      <p style="font-weight: bold;">Automated Synthesis of Fault-Tolerance.</p>
      <p style="margin-top: 0;">Poster workshop at the Computer Science and Engineering Department, <span data-field="institution">{{ institution }}</span>, <span data-field="location">{{ location }}</span>. <span data-field="date">{{ date }}</span>.</p>
    </div>

    <div class="reference-entry">
      <p style="font-weight: bold;">Enhancing the Fault-Tolerance of Nonmasking Programs.</p>
      <p style="margin-top: 0;">IEEE ICDCS, <span data-field="date">{{ date }}</span>, <span data-field="location">{{ location }}</span>, <span data-field="country">{{ country }}</span>.</p>
    </div>

    <div class="reference-entry">
      <p style="font-weight: bold;">Algorithmic Synthesis of Fault-Tolerant Distributed Programs.</p>
      <p style="margin-top: 0;">Doctoral Symposium of IEEE ICDCS, <span data-field="date">{{ date }}</span>, <span data-field="location">{{ location }}</span>, <span data-field="country">{{ country }}</span>.</p>
    </div>

    <p style="margin-top: 30px;">References: upon request</p>
  </div>
</div></body>
</html>