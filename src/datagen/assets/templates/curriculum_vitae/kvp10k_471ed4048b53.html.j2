<!DOCTYPE html>
<html>
<head>
<title>Curriculum Vitae</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; }
  .header-info { margin-bottom: 20px; }
  .contact-info p { margin: 2px 0; }
  .section-title { font-weight: bold; margin-top: 20px; margin-bottom: 10px; font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; }
  .education-entry, .experience-entry, .article-entry, .presentation-entry, .invited-lecture-entry, .professional-activity-entry, .service-entry, .award-entry, .reference-entry { margin-bottom: 15px; }
  .date-info { font-style: italic; font-size: 0.9em; }
  table { width: 100%; border-collapse: collapse; margin-top: 10px; }
  td { padding: 5px 0; }
</style>
</head>
<body>

<div class="page">
  <div class="header-info">
    <span data-field="full_name">{{ full_name }}</span>
    <div style="margin-top: 5px;">
      <span data-field="department">{{ department }}</span><br>
      <span data-field="university">{{ university }}</span><br>
      <span data-field="address">{{ address }}</span><br>
      <span data-field="phone">{{ phone }}</span><br>
      <span data-field="email">email: {{ email }}</span>
    </div>
  </div>

