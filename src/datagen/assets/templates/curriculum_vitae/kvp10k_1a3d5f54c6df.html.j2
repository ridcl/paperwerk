<!DOCTYPE html>
<html>
<head>
<title>Curriculum Vitae</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 {
    font-weight: bold;
    margin-top: 0;
  }
  .header-info {
    margin-bottom: 20px;
  }
  .contact-info p {
    margin: 2px 0;
  }
  .section-title {
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
    border-bottom: 1px solid #ccc;
    padding-bottom: 3px;
  }
  .entry {
    margin-bottom: 15px;
  }
  .entry-header {
    font-weight: bold;
  }
  .entry-details {
    font-size: 0.9em;
    color: #555;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
  }
  td {
    padding: 5px 0;
  }
  .publication-list li {
    margin-bottom: 10px;
    font-size: 0.9em;
  }
  .award-list li {
    margin-bottom: 8px;
    font-size: 0.9em;
  }
</style>
</head>
<body>

<div class="page">
  <h1 style="text-align: center;">Curriculum Vitae</h1>
  <div class="header-info">
    <span data-field="full_name">{{ full_name }}</span>, Ph.D.
    <div class="contact-info" style="margin-top: 10px;">
      <p>Assistant Professor of Landscape Architecture</p>
      <p>School of Design and Community Development</p>
      <p>West Virginia University</p>
      <p>4320 Agricultural Sciences Building</p>
      <p>PO Box 6108, Morgantown, WV 26506-6108</p>
      <p>Phone: <span data-field="phone">{{ phone }}</span></p>
      <p>Cell: <span data-field="cell">{{ cell }}</span></p>
      <p>Email: <span data-field="email">{{ email }}</span></p>
    </div>
  </div>
</div>

<div class="page">
  <h2 class="section-title">Academic Appointment</h2>
  <div class="entry">
    <div class="entry-header">2015-Present</div>
    <div class="entry-details">
      Assistant Professor, Department of Landscape Architecture, School of Design and Community Development, West Virginia University | Morgantown, WV
      <br>Courses: <span data-field="courses_taught">{{ courses_taught }}</span>
    </div>
  </div>
  <div class="entry">
    <div class="entry-header">2013-2015</div>
    <div class="entry-details">
      Graduate Instructor, Department of Landscape Architecture, Clemson University | Clemson, SC
      <br>Courses: <span data-field="courses_taught_2">{{ courses_taught_2 }}</span>
    </div>
  </div>
  <div class="entry">
    <div class="entry-header">2015</div>
    <div class="entry-details">
      Doctor of Philosophy in Planning Design and the Built Environment (Architecture + Health), Clemson University | Clemson, SC
    </div>
  </div>
  <div class="entry">
    <div class="entry-header">2012</div>
    <div class="entry-details">
      Master of Science in Landscape Architecture, Tongji University | Shanghai, China
    </div>
  </div>
  <div class="entry">
    <div class="entry-header">2010</div>
    <div class="entry-details">
      Exchange Student (non-degree), School of Architecture + Design, Virginia Polytechnic Institute and State University | Blacksburg, VA
    </div>
  </div>
  <div class="entry">
    <div class="entry-header">2009</div>
    <div class="entry-details">
      Bachelor of Agriculture in Landscape Architecture, Beijing Forestry University | Beijing, China
    </div>
  </div>
</div>

<div class="page">
  <h2 class="section-title">Professional Experience</h2>
  <div class="entry">
    <div class="entry-header">2012-2013</div>
    <div class="entry-details">
      Research Assistant, Planning Design and the Built Environment program, Clemson University | Clemson, SC
    </div>
  </div>
  <div class="entry">
    <div class="entry-header">2011-2012</div>
    <div class="entry-details">
      Graduate Research Assistant, Department of Landscape Studies, Tongji University
    </div>
  </div>

  <h2 class="section-title">Landscape Designer (Part-time)</h2>
  <div class="entry">
    <div class="entry-header">2009-2011</div>
    <div class="entry-details">
      Shanghai Yaoshun Enterprise (Group) Co., Ltd., | Shanghai, China
    </div>
  </div>
  <div class="entry">
    <div class="entry-header">2009-2010</div>
    <div class="entry-details">
      LIUBINYI Landscape Planning and Design Co., Ltd., | Shanghai, China
    </div>
  </div>
  <div class="entry">
    <div class="entry-header">2009-2010</div>
    <div class="entry-details">
      Graduate Teaching Assistant, Department of Landscape Studies, Tongji University, | Shanghai, China
    </div>
  </div>
</div>

<div class="page">
  <h2 class="section-title">Funded Projects and Grants</h2>
  <div class="entry">
    <div class="entry-header">2014-2015</div>
    <div class="entry-details">
      AIA AAH Arthur N. Tuttle Jr. Graduate Fellowship
      <br>Funding source: The American Institute of Architects (AIA)
    </div>
  </div>

  <h2 class="section-title">Publications</h2>
  <ul class="publication-list">
    <li>
      <span data-field="publication_1_title">{{ publication_1_title }}</span>.
      <span data-field="publication_1_journal">{{ publication_1_journal }}</span>.
    </li>
    <li>
      <span data-field="publication_2_title">{{ publication_2_title }}</span>.
      <span data-field="publication_2_journal">{{ publication_2_journal }}</span>.
    </li>
    <li>
      <span data-field="publication_3_title">{{ publication_3_title }}</span>.
      <span data-field="publication_3_journal">{{ publication_3_journal }}</span>.
    </li>
    <li>
      <span data-field="publication_4_title">{{ publication_4_title }}</span>.
      <span data-field="publication_4_journal">{{ publication_4_journal }}</span>.
    </li>
    <li>
      <span data-field="publication_5_title">{{ publication_5_title }}</span>.
      <span data-field="publication_5_journal">{{ publication_5_journal }}</span>.
    </li>
  </ul>

  <h2 class="section-title">Peer-Reviewed Presentation</h2>
  <ul class="publication-list">
    <li>
      <span data-field="presentation_1_title">{{ presentation_1_title }}</span>.
      <span data-field="presentation_1_conference">{{ presentation_1_conference }}</span>.
    </li>
    <li>
      <span data-field="presentation_2_title">{{ presentation_2_title }}</span>.
      <span data-field="presentation_2_conference">{{ presentation_2_conference }}</span>.
    </li>
  </ul>

  <h2 class="section-title">Peer-Reviewed Presentation [Poster]</h2>
  <ul class="publication-list">
    <li>
      <span data-field="poster_1_title">{{ poster_1_title }}</span>.
      <span data-field="poster_1_conference">{{ poster_1_conference }}</span>.
    </li>
  </ul>

  <h2 class="section-title">Patent</h2>
  <div class="entry">
    <div class="entry-details">
      Title: <span data-field="patent_title">{{ patent_title }}</span>
      <br>Inventor: <span data-field="patent_inventor">{{ patent_inventor }}</span>
      <br>Publication Number: <span data-field="patent_number">{{ patent_number }}</span>
      <br>IPC: <span data-field="patent_ipc">{{ patent_ipc }}</span>
    </div>
  </div>

  <h2 class="section-title">Symposia and Lectures</h2>
  <div class="entry">
    <div class="entry-header">February 17, 2016</div>
    <div class="entry-details">
      [Guest Lecture] <span data-field="symposia_1_title">{{ symposia_1_title }}</span>.
      <span data-field="symposia_1_location">{{ symposia_1_location }}</span>.
    </div>
  </div>
  <div class="entry">
    <div class="entry-header">November 15, 2015</div>
    <div class="entry-details">
      <span data-field="symposia_2_title">{{ symposia_2_title }}</span>.
      <span data-field="symposia_2_location">{{ symposia_2_location }}</span>.
    </div>
  </div>
</div>

<div class="page">
  <h2 class="section-title">Involved Research Projects</h2>
  <div class="entry">
