    <div class="entry-details">
      [Co-PI] <span data-field="project_1_title">{{ project_1_title }}</span>.
      <span data-field="project_1_details">{{ project_1_details }}</span>.
    </div>
  </div>
  <div class="entry">
    <div class="entry-header">2014</div>
    <div class="entry-details">
