      <span data-field="project_2_details">{{ project_2_details }}</span>.
    </div>
  </div>
  <div class="entry">
    <div class="entry-header">2013</div>
    <div class="entry-details">
      [Consultant] <span data-field="project_3_title">{{ project_3_title }}</span>.
      <span data-field="project_3_details">{{ project_3_details }}</span>.
    </div>
  </div>
  <div class="entry">
    <div class="entry-header">2012</div>
    <div class="entry-details">
      [Translator] <span data-field="project_4_title">{{ project_4_title }}</span>.
      <span data-field="project_4_details">{{ project_4_details }}</span>.
    </div>
  </div>

  <h2 class="section-title">Honors and Awards</h2>
  <ul class="award-list">
    <li>
      <span data-field="award_1_year">{{ award_1_year }}</span>: <span data-field="award_1_description">{{ award_1_description }}</span>.
    </li>
    <li>
      <span data-field="award_2_year">{{ award_2_year }}</span>: <span data-field="award_2_description">{{ award_2_description }}</span>.
    </li>
    <li>
      <span data-field="award_3_year">{{ award_3_year }}</span>: <span data-field="award_3_description">{{ award_3_description }}</span>.
    </li>
    <li>
      <span data-field="award_4_year">{{ award_4_year }}</span>: <span data-field="award_4_description">{{ award_4_description }}</span>.
    </li>
  </ul>

  <h2 class="section-title">Professional Service Activities</h2>
  <div class="entry">
    <div class="entry-header">2016</div>
    <div class="entry-details">
      [Reviewer] <span data-field="service_1_title">{{ service_1_title }}</span>.
    </div>
  </div>
  <div class="entry">
    <div class="entry-header">2014-Present</div>
    <div class="entry-details">
      [Reviewer] <span data-field="service_2_title">{{ service_2_title }}</span>.
    </div>
  </div>
  <div class="entry">
    <div class="entry-header">2016</div>
    <div class="entry-details">
      [Reviewer] <span data-field="service_3_title">{{ service_3_title }}</span>.
    </div>
  </div>
  <div class="entry">
    <div class="entry-header">2016</div>
    <div class="entry-details">
      [Reviewer] <span data-field="service_4_title">{{ service_4_title }}</span>.
    </div>
  </div>
</div>

<div class="page">
  <h2 class="section-title">Institutional Service Activities</h2>
  <div class="entry">
    <div class="entry-header">2016</div>
    <div class="entry-details">
      [Board Member] <span data-field="institutional_1_title">{{ institutional_1_title }}</span>.
    </div>
  </div>
  <div class="entry">
    <div class="entry-header">March, 2016</div>
    <div class="entry-details">
