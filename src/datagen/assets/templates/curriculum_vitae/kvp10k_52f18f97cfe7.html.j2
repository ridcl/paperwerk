  </div>

  <div class="section-title">Education</div>
  <div class="entry">
    <div class="two-column-layout">
      <div>
        <span class="entry-title">{{ education_1_degree }}</span>, <span data-field="education_1_institution">{{ education_1_institution }}</span>, <span data-field="education_1_location">{{ education_1_location }}</span>
