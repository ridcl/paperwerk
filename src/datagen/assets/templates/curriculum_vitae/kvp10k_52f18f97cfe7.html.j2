        <td style="width: 30%; text-align: right;"></td>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>{{ award_1_name }}</td>
        <td class="right-aligned">{{ award_1_date }}</td>
      </tr>
      <tr>
        <td>{{ award_2_name }}</td>
        <td class="right-aligned">{{ award_2_date }}</td>
      </tr>
      <tr>
        <td>{{ award_3_name }}</td>
        <td class="right-aligned">{{ award_3_date }}</td>
      </tr>
      <tr>
        <td>{{ award_4_name }}</td>
