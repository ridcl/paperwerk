<!DOCTYPE html>
<html>
<head>
<title>Curriculum Vitae</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
    line-height: 1.5;
    color: #000;
  }
  h1, h2, h3 {
    font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif;
    font-weight: bold;
  }
  .header-info {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 10px;
  }
  .name {
    font-size: 24pt;
    font-weight: bold;
  }
  .title {
    font-size: 14pt;
    margin-top: -10px;
    margin-bottom: 30px;
  }
  .section-title {
    font-size: 14pt;
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
    border-bottom: 1px solid #ccc;
    padding-bottom: 3px;
  }
  .entry {
    margin-bottom: 15px;
  }
  .entry-title {
    font-weight: bold;
  }
  .entry-details {
    font-style: italic;
    margin-left: 15px;
  }
  .two-column-layout {
    display: flex;
    justify-content: space-between;
    margin-bottom: 15px;
  }
  .two-column-layout > div {
    width: 48%;
  }
  .right-aligned {
    text-align: right;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
  }
  td {
    padding: 5px 0;
  }
  .divider {
    border-top: 1px solid #000;
    margin: 20px 0;
  }
</style>
</head>
<body>

<div class="page">
  <div class="header-info">
    <div>
      <span class="name">{{ full_name }}</span>
      <div class="title">Curriculum Vitae</div>
    </div>
    <div class="right-aligned">
      <span data-field="date_august_2021">{{ date_august_2021 }}</span>
    </div>
  </div>
  <div style="margin-bottom: 30px;">
    Website: <a href="{{ website_url }}">{{ website_url }}</a>
    <div style="margin-top: 5px;">Email: <span data-field="email_address">{{ email_address }}</span></div>
  </div>

  <div class="section-title">Academic Appointments</div>
  <div class="entry">
    <div class="two-column-layout">
      <div>
        <span class="entry-title">{{ academic_appointment_1_title }}</span>, <span data-field="academic_appointment_1_institution">{{ academic_appointment_1_institution }}</span>
      </div>
      <div class="right-aligned"><span data-field="current_status_1">{{ current_status_1 }}</span></div>
    </div>
