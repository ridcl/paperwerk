    </tbody>
  </table>

  <div class="section-title">References</div>
  <div class="entry">
    <span class="entry-title">{{ reference_1_name }}</span>
    <div class="entry-details">
      <span data-field="reference_1_title">{{ reference_1_title }}</span>
      <br>
