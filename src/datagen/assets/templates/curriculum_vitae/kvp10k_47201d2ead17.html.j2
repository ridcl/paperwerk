    font-size: 10pt;
  }
  .section-title {
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 5px;
  }
  .entry-item {
    margin-bottom: 10px;
  }
  .date {
    font-weight: bold;
    display: inline-block;
    width: 120px; /* Adjust as needed for alignment */
  }
  .description {
    display: inline-block;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
  }
  td {
    padding: 5px 0;
    vertical-align: top;
  }
</style>

