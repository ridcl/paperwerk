<!DOCTYPE html>
<html>
<head>
<title>Curriculum Vitae</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    line-height: 1.5;
    color: #000;
  }
  h1, h2, h3 {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    font-weight: bold;
  }
  .header-info {
    display: flex;
    justify-content: space-between;
    margin-bottom: 20px;
  }
  .contact-info p {
    margin: 2px 0;
  }
  .section-title {
    font-size: 14pt;
    margin-top: 20px;
    margin-bottom: 10px;
    font-weight: bold;
  }
  .entry {
    margin-bottom: 15px;
  }
  .entry-title {
    font-weight: bold;
  }
  .entry-details {
    font-style: italic;
    margin-left: 15px;
  }
  .publication-item {
    margin-bottom: 10px;
    font-size: 10pt;
  }
  .publication-item a {
    color: #000;
    text-decoration: none;
  }
  .publication-item ul {
    list-style-type: disc;
    margin-left: 20px;
    padding-left: 0;
  }
  .publication-item li {
    margin-bottom: 5px;
  }
</style>

<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child {
    page-break-after: auto;
  }
  h1, h2, h3, h4 {
    font-weight: bold;
    margin-top: 0;
  }
  .section-title {
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
  }
  .entry-item {
    margin-bottom: 10px;
    line-height: 1.4;
  }
  .metadata {
    font-size: 0.9em;
    color: #555;
    margin-top: 5px;
  }
  .signature {
    margin-top: 50px;
    font-size: 0.9em;
    text-align: right;
  }
</style>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3, h4 { font-weight: bold; }
  .section-title { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
  .entry { margin-bottom: 15px; }
  .date { float: right; font-style: italic; }
  .list-item { margin-bottom: 5px; }
</style>
</head>
<body>

<div class="page">
  <div style="text-align: center; margin-bottom: 40px;">
    <h1 style="font-size: 24pt; margin: 0;">{{ full_name }}</h1>
    <p style="font-size: 12pt; margin-top: 5px;">Curriculum Vitae</p>
  </div>

  <div class="header-info">
    <div class="contact-info">
      <p>Mailing address: {{ mailing_address }}</p>
    </div>
    <div class="contact-info">
      <p>Phone: {{ phone }}</p>
      <p>Fax: {{ fax }}</p>
      <p>Email: {{ email }}</p>
      <p>Website: {{ website }}</p>
    </div>
  </div>

  <div class="section-title">AREAS OF SPECIALIZATION</div>
  <p>{{ areas_of_specialization }}</p>

  <div class="section-title">AREAS OF COMPETENCE</div>
  <p>{{ areas_of_competence }}</p>

  <div class="section-title">EMPLOYMENT</div>
  <div class="entry">
    <div class="entry-title">{{ employment_title_1 }}</div>
    <div class="entry-details">{{ employment_details_1 }}</div>
  </div>
  <div class="entry">
    <div class="entry-title">{{ employment_title_2 }}</div>
    <div class="entry-details">{{ employment_details_2 }}</div>
  </div>
  <div class="entry">
    <div class="entry-title">{{ employment_title_3 }}</div>
    <div class="entry-details">{{ employment_details_3 }}</div>
  </div>
  <div class="entry">
    <div class="entry-title">{{ employment_title_4 }}</div>
    <div class="entry-details">{{ employment_details_4 }}</div>
  </div>

  <div class="section-title">EDUCATION</div>
  <div class="entry">
    <div class="entry-title">{{ education_entry_1_degree }}</div>
    <div class="entry-details">{{ education_entry_1_institution }}</div>
  </div>
  <div class="entry">
    <div class="entry-title">{{ education_entry_2_degree }}</div>
    <div class="entry-details">{{ education_entry_2_institution }}</div>
  </div>
  <div class="entry">
    <div class="entry-title">{{ education_entry_3_degree }}</div>
    <div class="entry-details">{{ education_entry_3_institution }}</div>
  </div>

  <div class="section-title">AWARDS & HONORS</div>
  <div class="entry">
    <div class="entry-title">{{ award_1_name }}</div>
    <div class="entry-details">{{ award_1_details }}</div>
  </div>
  <div class="entry">
    <div class="entry-title">{{ award_2_name }}</div>
    <div class="entry-details">{{ award_2_details }}</div>
  </div>
  <div class="entry">
    <div class="entry-title">{{ award_3_name }}</div>
    <div class="entry-details">{{ award_3_details }}</div>
  </div>
  <div class="entry">
    <div class="entry-title">{{ award_4_name }}</div>
    <div class="entry-details">{{ award_4_details }}</div>
  </div>

  <div class="section-title">PUBLICATIONS</div>
  <div class="entry">
    <div class="entry-title">Books</div>
    <div class="entry-details">
      <div class="publication-item">
        <p><strong>{{ book_1_title }}</strong></p>
        <p>{{ book_1_details }}</p>
      </div>
      <div class="publication-item">
        <p><strong>{{ book_2_title }}</strong></p>
        <p>{{ book_2_details }}</p>
      </div>
      <div class="publication-item">
        <p><strong>{{ book_3_title }}</strong></p>
        <p>{{ book_3_details }}</p>
      </div>
    </div>
  </div>

  <div class="entry">
    <div class="entry-title">Journal Articles, Book Chapters, and Commentary Essays</div>
    <div class="entry-details">
      {% for article in journal_articles %}
        <div class="publication-item">
          <p><strong>{{ article.title }}</strong></p>
          <p>{{ article.details }}</p>
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="entry">
    <div class="entry-title">Popular Media Publications – Op-Eds, Extended Interviews, and Radio & Podcast Episodes</div>
    <div class="entry-details">
      {% for media_item in media_publications %}
        <div class="publication-item">
          <p><strong>{{ media_item.title }}</strong></p>
          <p>{{ media_item.details }}</p>
        </div>
      {% endfor %}
    </div>
  </div>

</div>

<div class="page">
  <div class="section-title">PUBLICATIONS (Continued)</div>
  <div class="entry">
    <div class="entry-title">Books (Continued)</div>
    <div class="entry-details">
      {% for book in additional_books %}
        <div class="publication-item">
          <p><strong>{{ book.title }}</strong></p>
          <p>{{ book.details }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>


<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
