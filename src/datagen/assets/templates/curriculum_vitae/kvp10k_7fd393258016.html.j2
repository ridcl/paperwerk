<!DOCTYPE html>
<html>
<head>
<title>CV Template</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 {
    font-weight: bold;
    margin-top: 0;
  }
  .contact-info p {
    margin: 2px 0;
  }
  .section-title {
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
    text-transform: uppercase;
    font-size: 12pt;
  }
  .entry {
    margin-bottom: 15px;
  }
  .entry-header {
    font-weight: bold;
  }
  .entry-details {
    font-size: 10pt;
  }
  ul {
    padding-left: 20px;
    margin-top: 5px;
    margin-bottom: 15px;
  }
  li {
    margin-bottom: 5px;
    font-size: 10pt;
  }
</style>

<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 {
    font-family: "DejaVu Sans", "Liberation Sans", Arial, Helvetica, sans-serif;
    font-weight: bold;
  }
  .section-title {
    font-size: 14pt;
    text-transform: uppercase;
    margin-top: 20px;
    margin-bottom: 10px;
    border-bottom: 1px solid #ccc;
    padding-bottom: 3px;
  }
  .entry {
    margin-bottom: 15px;
  }
  .entry-title {
    font-weight: bold;
    display: block;
  }
  .entry-details {
    font-size: 10pt;
    color: #555;
  }
  ul {
    list-style-type: disc;
    margin-left: 20px;
    padding-left: 0;
  }
  li {
    margin-bottom: 5px;
    font-size: 10pt;
  }
</style>
</head>
<body>
<div class="page">
  <h1 style="font-size: 18pt; margin-bottom: 5px;">{{ full_name }}</h1>
  <p style="font-size: 14pt; margin-top: 0;">{{ title }}</p>
  <p style="font-size: 14pt; margin-bottom: 20px;">{{ affiliation }}</p>

  <div class="contact-info">
    <p>Department of Political Science</p>
    <p>{{ address_line_1 }}</p>
    <p>{{ address_line_2 }}</p>
    <p>{{ city_state_zip }}</p>
    <p>Email: <span data-field="email">{{ email }}</span></p>
    <p>Phone: <span data-field="phone">{{ phone }}</span></p>
  </div>

  <div class="section-title">EDUCATION</div>

  {% for edu in education %}
  <div class="entry">
    <div class="entry-header">
      {{ edu.degree }} - {{ edu.year }}
    </div>
    <div class="entry-details">
      {{ edu.institution }} ({{ edu.notes }})
    </div>
  </div>
  {% endfor %}

  <div class="section-title">TEACHING AND PROFESSIONAL EXPERIENCE</div>

  {% for job in experience %}
  <div class="entry">
    <div class="entry-header">
      {{ job.title }} - {{ job.start_year }}-{{ job.end_year }}
    </div>
    <div class="entry-details">
      {{ job.institution }}
    </div>
    {% if job.details %}
    <div class="entry-details">
      {{ job.details }}
    </div>
    {% endif %}
  </div>
  {% endfor %}

  <div class="section-title">CURRENT COURSES AT THE UWEC</div>
  <ul>
    {% for course in current_courses %}
    <li>{{ course }}</li>
    {% endfor %}
  </ul>

  <div class="section-title">PUBLICATIONS</div>

  <div class="entry">
    <div class="entry-header">BOOK:</div>
    <div class="entry-details">
      {{ book_title }}
    </div>
  </div>

  <div class="entry">
    <div class="entry-header">ARTICLES:</div>
    <ul>
      {% for article in articles %}
      <li>
        {{ article.title }}
        <br>
        <span data-field="article_journal">{{ article.journal }}</span>, {{ article.volume }} vol. {{ article.issue }}, {{ article.pages }}
      </li>
      {% endfor %}
    </ul>
  </div>

  <div class="section-title">POST-TENURE PUBLICATIONS</div>
  <ul>
    {% for post_tenure in post_tenure_publications %}
    <li>
      {{ post_tenure.title }}
      <br>
      <span data-field="post_tenure_journal">{{ post_tenure.journal }}</span>, {{ post_tenure.volume }} vol. {{ post_tenure.issue }}, {{ post_tenure.pages }}
    </li>
    {% endfor %}
  </ul>

  <div class="section-title">PRE-TENURE PUBLICATIONS</div>
  <ul>
    {% for pre_tenure in pre_tenure_publications %}
    <li>
      {{ pre_tenure.title }}
      <br>
      <span data-field="pre_tenure_journal">{{ pre_tenure.journal }}</span>, {{ pre_tenure.volume }} vol. {{ pre_tenure.issue }}, {{ pre_tenure.pages }}
    </li>
    {% endfor %}
  </ul>

  <div class="section-title">LECTURES, PROFESSIONAL PRESENTATIONS, SERVICE (POST TENURE)</div>
  <ul>
    {% for lecture in post_tenure_lectures %}
    <li>
      Lecture: "{{ lecture.title }}"
      <br>
      {{ lecture.details }}
    </li>
    {% endfor %}
  </ul>

  <div class="section-title">LECTURES, PROFESSIONAL PRESENTATIONS, SERVICE (PRE-TENURE)</div>
  <ul>
    {% for lecture in pre_tenure_lectures %}
    <li>
      Presented Paper: "{{ lecture.title }}"
      <br>
      {{ lecture.details }}
    </li>
    {% endfor %}
  </ul>

  <div class="section-title">SERVICE</div>
  <ul>
    {% for service in service_entries %}
    <li>
      {{ service.description }}
      <br>
      {{ service.details }}
    </li>
    {% endfor %}
  </ul>

</div>



