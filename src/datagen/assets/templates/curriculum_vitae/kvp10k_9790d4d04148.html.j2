<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { font-weight: bold; }
  .header-info { text-align: right; font-size: 0.9em; }
</style>

<div class="page">
  <div class="header-info">Updated: <span data-field="updated_date">{{ updated_date }}</span></div>
  <h1>CURRICULUM VITAE</h1>
  <h2><span data-field="full_name">{{ full_name }}</span></h2>

  <p>Department of Economics</p>
  <p><span data-field="employer.name">{{ employer.name }}</span></p>
  <p><span data-field="employer.location">{{ employer.location }}</span></p>
  <p><span data-field="employer.address_line_1">{{ employer.address_line_1 }}</span></p>
  <p><span data-field="employer.address_line_2">{{ employer.address_line_2 }}</span></p>
  <p>Phone: <span data-field="employer.phone">{{ employer.phone }}</span></p>
  <p>Email: <span data-field="contact.email">{{ contact.email }}</span></p>
  <p>Web: <span data-field="contact.website">{{ contact.website }}</span></p>

  <h3>EMPLOYMENT:</h3>
  <div>
    <p><span data-field="employment_entry_1.title">{{ employment_entry_1.title }}</span>, <span data-field="employment_entry_1.institution">{{ employment_entry_1.institution }}</span>, <span data-field="employment_entry_1.dates">{{ employment_entry_1.dates }}</span></p>
    <p><span data-field="employment_entry_2.title">{{ employment_entry_2.title }}</span>, <span data-field="employment_entry_2.institution">{{ employment_entry_2.institution }}</span>, <span data-field="employment_entry_2.dates">{{ employment_entry_2.dates }}</span></p>
  </div>

  <h3>EDUCATION:</h3>
  <ul>
    <li>Ph.D. in Economics, <span data-field="education_1.institution">{{ education_1.institution }}</span>, <span data-field="education_1.year">{{ education_1.year }}</span>. Thesis Title: <span data-field="education_1.thesis_title">{{ education_1.thesis_title }}</span>. Committee: <span data-field="education_1.committee">{{ education_1.committee }}</span></li>
    <li>B.A. in Finance, <span data-field="education_2.institution">{{ education_2.institution }}</span>, <span data-field="education_2.year">{{ education_2.year }}</span></li>
    <li>B.S. in Computer Science, <span data-field="education_3.institution">{{ education_3.institution }}</span>, <span data-field="education_3.year">{{ education_3.year }}</span></li>
  </ul>

  <h3>RESEARCH INTERESTS:</h3>
  <div>
    <p><span data-field="research_interest_1">{{ research_interest_1 }}</span>, <span data-field="research_interest_2">{{ research_interest_2 }}</span>, <span data-field="research_interest_3">{{ research_interest_3 }}</span>, <span data-field="research_interest_4">{{ research_interest_4 }}</span></p>
  </div>

  <h3>PUBLICATIONS:</h3>
  <h4>Journal Articles</h4>
  <ul>
    <li><span data-field="publication_1.authors">{{ publication_1.authors }}</span>, <span data-field="publication_1.year">{{ publication_1.year }}</span>. "<span data-field="publication_1.title">{{ publication_1.title }}</span>," <span data-field="publication_1.journal">{{ publication_1.journal }}</span>, accepted.</li>
    <li><span data-field="publication_2.authors">{{ publication_2.authors }}</span>, <span data-field="publication_2.year">{{ publication_2.year }}</span>. "<span data-field="publication_2.title">{{ publication_2.title }}</span>," <span data-field="publication_2.journal">{{ publication_2.journal }}</span>, 35: 89-133.</li>
  </ul>

  <h4>Book Chapters</h4>
  <ul>
    <li><span data-field="publication_3.authors">{{ publication_3.authors }}</span>, <span data-field="publication_3.year">{{ publication_3.year }}</span>. "<span data-field="publication_3.title">{{ publication_3.title }}</span>," in <span data-field="publication_3.book_title">{{ publication_3.book_title }}</span> (Singapore: World Scientific Publishing).</li>
  </ul>

  <h4>WORKING PAPERS:</h4>
  <ul>
    <li><span data-field="publication_4.authors">{{ publication_4.authors }}</span>, <span data-field="publication_4.year">{{ publication_4.year }}</span>. "<span data-field="publication_4.title">{{ publication_4.title }}</span>," Revised and resubmitted.</li>
    <li><span data-field="publication_5.authors">{{ publication_5.authors }}</span>, <span data-field="publication_5.year">{{ publication_5.year }}</span>. "<span data-field="publication_5.title">{{ publication_5.title }}</span>."</li>
    <li><span data-field="publication_6.authors">{{ publication_6.authors }}</span>, <span data-field="publication_6.year">{{ publication_6.year }}</span>. "<span data-field="publication_6.title">{{ publication_6.title }}</span>."</li>
    <li><span data-field="publication_7.authors">{{ publication_7.authors }}</span>, <span data-field="publication_7.year">{{ publication_7.year }}</span>. "<span data-field="publication_7.title">{{ publication_7.title }}</span>."</li>
  </ul>

  <h3>PRESENTATIONS:</h3>
  <ul>
    <li><span data-field="presentation_1.year">{{ presentation_1.year }}</span>: <span data-field="presentation_1.title">{{ presentation_1.title }}</span>, Association for Education Finance and Policy Annual Conference</li>
    <li><span data-field="presentation_2.year">{{ presentation_2.year }}</span>: <span data-field="presentation_2.title">{{ presentation_2.title }}</span>, World Congress of the Econometric Society, Southeastern Micro Labor Workshop Series, Association for Education Finance and Policy Annual Conference</li>
  </ul>

  <div style="page-break-after: always;"></div>

  <div class="page">
    <h3>REFEREE:</h3>
    <ul>
      <li><span data-field="referee_1.name">{{ referee_1.name }}</span>, <span data-field="referee_1.journal_details">{{ referee_1.journal_details }}</span></li>
    </ul>

    <h3>TEACHING:</h3>
    <div>
      <p><span data-field="teaching_institution">{{ teaching_institution }}</span></p>
      <p>Undergraduate: <span data-field="teaching_course_1">{{ teaching_course_1 }}</span></p>
      <p>Master: <span data-field="teaching_course_2">{{ teaching_course_2 }}</span></p>
    </div>

    <h3>STUDENT ADVISING:</h3>
    <ul>
      <li>Undergraduate Honors Thesis: <span data-field="student_advisor_1.name">{{ student_advisor_1.name }}</span>, <span data-field="student_advisor_1.name">{{ student_advisor_1.name }}</span>, <span data-field="student_advisor_1.name">{{ student_advisor_1.name }}</span></li>
      <li>Master's Thesis: <span data-field="student_advisor_2.name">{{ student_advisor_2.name }}</span>, <span data-field="student_advisor_2.name">{{ student_advisor_2.name }}</span></li>
      <li>Ph.D.: <span data-field="student_advisor_3.name">{{ student_advisor_3.name }}</span>, <span data-field="student_advisor_3.name">{{ student_advisor_3.name }}</span></li>
      <li>Main adviser: <span data-field="student_advisor_4">{{ student_advisor_4 }}</span></li>
    </ul>

    <h3>SERVICE:</h3>
    <ul>
      <li>Master's in Economics Committee, <span data-field="service_1.year">{{ service_1.year }}</span> – Current</li>
      <li>Moore School of Business Certificate Electives Approval Committee (Formerly Data Analytics Task Force), <span data-field="service_2.year">{{ service_2.year }}</span></li>
      <li>Economics Undergraduate Teaching Committee, <span data-field="service_3.year">{{ service_3.year }}</span></li>
    </ul>

    <h3>LANGUAGE SKILLS:</h3>
    <div>
      <p>Languages: <span data-field="language_1">{{ language_1 }}</span>, <span data-field="language_2">{{ language_2 }}</span></p>
    </div>
  </div>

  <div class="page">
    <div style="text-align: center; margin-top: 50px;">
      <p>Page <span data-field="page_number">{{ page_number }}</span> of <span data-field="total_pages">{{ total_pages }}</span></p>
    </div>
  </div>
</div>