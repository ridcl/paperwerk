<!DOCTYPE html>
<html>
<head>
<title>Curriculum Vitae</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, Helvetica, Arial, sans-serif;
    line-height: 1.5;
    color: #000;
  }
  h1, h2, h3 {
    font-weight: bold;
    margin-top: 0;
  }
  .header-info {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 20px;
  }
  .contact-info p {
    margin: 2px 0;
  }
  .section-title {
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
  }
  .entry {
    margin-bottom: 15px;
  }
  .entry-header {
    font-weight: bold;
  }
  .entry-details {
    font-style: italic;
    margin-left: 15px;
  }
  .list-item {
    margin-bottom: 8px;
  }
  .list-item span {
    display: block;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
  }
  td {
    padding: 5px 0;
  }
</style>

<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; line-height: 1.5; }
  h1, h2, h3 { font-weight: bold; }
  .contact-info p { margin: 2px 0; }
</style>
</head>
<body>

<div class="page">
  <div class="header-info">
    <div>
      <span data-field="full_name">{{ full_name }}</span>
    </div>
    <div>
      <span data-field="document_title">{{ document_title }}</span>
    </div>
  </div>

  <div class="contact-info">
    <p>Department of Political Science</p>
    <p><span data-field="address_line_1">{{ address_line_1 }}</span></p>
    <p><span data-field="address_line_2">{{ address_line_2 }}</span></p>
    <p>Phone: <span data-field="phone_number">{{ phone_number }}</span></p>
    <p>Email: <span data-field="email_address">{{ email_address }}</span></p>
  </div>

  <div class="section-title">Academic and research positions</div>

  {% for item in academic_positions %}
  <div class="entry">
    <div class="entry-header">{{ item.year_range }}</div>
    <div class="entry-details">{{ item.title }} at <span data-field="employer.name">{{ item.employer.name }}</span></div>
  </div>
  {% endfor %}

  <div class="section-title">Education</div>

  {% for item in education %}
  <div class="entry">
    <div class="entry-header">{{ item.year_range }}</div>
    <div class="entry-details">{{ item.degree }} from <span data-field="institution.name">{{ item.institution.name }}</span></div>
  </div>
  {% endfor %}

</div>

<div class="page">
  <div class="section-title">Peer-Reviewed Publications</div>

  {% for pub in peer_reviewed_publications %}
  <div class="list-item">
    <span data-field="publication_title">{{ pub.title }}</span>
    <span data-field="publication_details">{{ pub.details }}</span>
  </div>
  {% endfor %}

  <div class="section-title">Book chapters and other publications</div>

  {% for pub in book_chapters %}
  <div class="list-item">
    <span data-field="publication_title">{{ pub.title }}</span>
    <span data-field="publication_details">{{ pub.details }}</span>
  </div>
  {% endfor %}

  <div class="section-title">Working papers</div>

  {% for pub in working_papers %}
  <div class="list-item">
    <span data-field="publication_title">{{ pub.title }}</span>
    <span data-field="publication_details">{{ pub.details }}</span>
  </div>
  {% endfor %}

</div>

<div class="page">
  <div class="section-title">Grants and Fellowships</div>

  {% for item in grants_fellowships %}
  <div class="entry">
    <div class="entry-header">{{ item.year }}</div>
    <div class="entry-details">{{ item.name }} (with <span data-field="collaborator.name">{{ item.collaborator.name }}</span>)</div>
  </div>
  {% endfor %}

  <div class="section-title">Language Training</div>

  <div class="list-item">
    <span data-field="language_training_details">{{ language_training_details }}</span>
  </div>

  <div class="section-title">Presentations</div>

  {% for item in presentations %}
  <div class="list-item">
    <span data-field="presentation_title">{{ item.title }}</span>
    <span data-field="presentation_details">{{ item.details }}</span>
  </div>
  {% endfor %}

</div>

<div class="page">
  <div class="section-title">Selected Publications</div>

  {% for item in selected_publications %}
  <div class="list-item">
    <span data-field="publication_title">{{ item.title }}</span>
    <span data-field="publication_details">{{ item.details }}</span>
  </div>
  {% endfor %}

  <div class="section-title">Professional</div>

  <div class="entry">
    <div class="entry-header">Political Science</div>
    <div class="entry-details">
      <span data-field="role">{{ role_political_science }}</span>
      <span data-field="journals">{{ journals_political_science }}</span>
    </div>
  </div>

  <div class="entry">
    <div class="entry-header">General, Econ.</div>
    <div class="entry-details">
      <span data-field="role">{{ role_general_econ }}</span>
      <span data-field="journals">{{ journals_general_econ }}</span>
    </div>
  </div>

  <div class="section-title">Courses</div>

  <div class="list-item">
    <span data-field="course_list">{{ course_list }}</span>
  </div>

  <div class="section-title">University Service</div>

  <div class="list-item">
    <span data-field="service_list">{{ service_list }}</span>
  </div>

</div>

<div class="page">
  <div class="section-title">Essays, Opinion Articles</div>

  {% for item in essays_opinion_articles %}
  <div class="list-item">
    <span data-field="article_title">{{ item.title }}</span>
    <span data-field="article_details">{{ item.details }}</span>
  </div>
  {% endfor %}

  <div class="section-title">Research-Related Blog Posts</div>

  {% for item in research_blog_posts %}
  <div class="list-item">
    <span data-field="post_title">{{ item.title }}</span>
    <span data-field="post_details">{{ item.details }}</span>
  </div>
  {% endfor %}

</div>


<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
