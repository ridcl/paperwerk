    <p style="margin: 2px 0;">{{ reference_3.affiliation.institution }}</p>
    <p style="margin: 2px 0;">{{ reference_3.affiliation.address }}</p>
    <p style="margin: 2px 0;">Office Phone: {{ reference_3.contact.office_phone }}</p>
    <p style="margin: 2px 0;">Email: <a href="mailto:{{ reference_3.contact.email }}">{{ reference_3.contact.email }}</a></p>
  </div>

  <!-- Reference 4 -->
  <div style="margin-bottom: 30px;">
    <h3 style="margin: 0;">{{ reference_4.full_name }}</h3>
    <p style="margin: 2px 0;">{{ reference_4.affiliation.department }}</p>
    <p style="margin: 2px 0;">{{ reference_4.affiliation.institution }}</p>
    <p style="margin: 2px 0;">{{ reference_4.affiliation.address }}</p>
    <p style="margin: 2px 0;">Office Phone: {{ reference_4.contact.office_phone }}</p>
    <p style="margin: 2px 0;">Email: <a href="mailto:{{ reference_4.contact.email }}">{{ reference_4.contact.email }}</a></p>
  </div>

</div></body>
</html>