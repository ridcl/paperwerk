<!DOCTYPE html>
<html>
<head>
<title>Curriculum Vitae</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3, h4 { margin-top: 0; }
  .section-title { font-weight: bold; text-transform: uppercase; }
  .contact-info p { margin: 2px 0; }
  .divider { border-top: 1px solid #000; margin: 15px 0; }
</style>
</head>
<body>

<div class="page">
  <h1 style="text-align: center;">CURRICULUM VITAE OF {{ full_name }}</h1>
  <p style="text-align: center;">(Revised {{ revision_date }})</p>

  <div class="divider"></div>

  <h2 class="section-title">I. PROFESSIONAL AFFILIATION AND CONTACT INFORMATION</h2>
  <div class="contact-info">
    <p>
      <span data-field="address.street">{{ address.street }}</span><br>
      <span data-field="address.city_state_zip">{{ address.city_state_zip }}</span>
    </p>
    <p>
      Phone: {{ phone_number }}<br>
      Email: <span data-field="email">{{ email }}</span>
    </p>
  </div>

  <div class="divider"></div>

  <h2 class="section-title">II. EDUCATION:</h2>
  <ul>
    {% for edu in education %}
    <li>
      <span data-field="education[{{ loop.index0 }}].year">{{ edu.year }}</span>: 
      <span data-field="education[{{ loop.index0 }}].degree">{{ edu.degree }}</span> in <span data-field="education[{{ loop.index0 }}].major">{{ edu.major }}</span>, 
      <span data-field="education[{{ loop.index0 }}].institution">{{ edu.institution }}</span>.
    </li>
    {% endfor %}
  </ul>

  <div class="divider"></div>

  <h2 class="section-title">III. RESEARCH AND CREATIVE ACTIVITY:</h2>
  
  <h3>A. Research Interests and Specialties:</h3>
  <ul>
    {% for interest in research_interests %}
    <li><span data-field="research_interests[{{ loop.index0 }}]">{{ interest }}</span></li>
    {% endfor %}
  </ul>

  <h3>B. Current Projects and Fieldwork:</h3>
  {% for project in projects %}
  <p>
    <span data-field="projects[{{ loop.index0 }}].year">{{ project.year }}</span>: 
    <span data-field="projects[{{ loop.index0 }}].description">{{ project.description }}</span>.
  </p>
  {% endfor %}

  <div class="divider"></div>

  <h3>C. Grants Received:</h3>
  {% for grant in grants %}
  <p>
    <span data-field="grants[{{ loop.index0 }}].year">{{ grant.year }}</span>: 
    <span data-field="grants[{{ loop.index0 }}].name">{{ grant.name }}</span> (<span data-field="grants[{{ loop.index0 }}].amount">{{ grant.amount }}</span>).
  </p>
  {% endfor %}

  <div class="divider"></div>

  <h3>D. Honors, Scholarships, and Awards:</h3>
  {% for honor in honors %}
  <p>
    <span data-field="honors[{{ loop.index0 }}].year">{{ honor.year }}</span>: 
    <span data-field="honors[{{ loop.index0 }}].description">{{ honor.description }}</span>.
  </p>
  {% endfor %}

</div>

<div class="page">
  <h2 class="section-title">II. EDUCATION:</h2>
  <ul>
    {% for edu in education %}
    <li>
      <span data-field="education[{{ loop.index0 }}].year">{{ edu.year }}</span>: 
      <span data-field="education[{{ loop.index0 }}].degree">{{ edu.degree }}</span> in <span data-field="education[{{ loop.index0 }}].major">{{ edu.major }}</span>, 
      <span data-field="education[{{ loop.index0 }}].institution">{{ edu.institution }}</span>.
    </li>
    {% endfor %}
  </ul>

  <div class="divider"></div>

  <h2 class="section-title">IV. UNIVERSITY EXPERIENCE:</h2>
  <h3>A. Conferences and Events Organized:</h3>
  {% for event in events %}
  <p>
    <span data-field="events[{{ loop.index0 }}].year">{{ event.year }}</span>: 
    <span data-field="events[{{ loop.index0 }}].description">{{ event.description }}</span>.
  </p>
  {% endfor %}

  <div class="divider"></div>

  <h2 class="section-title">V. PROFESSIONAL SERVICE:</h2>
  <h3>A. Language Competence:</h3>
  <ul>
    {% for lang in languages %}
    <li><span data-field="languages[{{ loop.index0 }}]">{{ lang }}</span> ({{ lang.level }})</li>
    {% endfor %}
  </ul>

  <h3>B. Other Skills:</h3>
  <ul>
    {% for skill in skills %}
    <li><span data-field="skills[{{ loop.index0 }}]">{{ skill }}</span></li>
    {% endfor %}
  </ul>

</div>

<div class="page">
  <h2 style="text-align: center;">Names and Addresses of References:</h2>

  {% for reference in references %}
  <div style="margin-bottom: 30px;">
    <h3 style="margin-bottom: 5px;">{{ reference.full_name }} ({{ reference.title }})</h3>
    <p>
      <span data-field="reference[{{ loop.index0 }}].department">{{ reference.department }}</span><br>
      <span data-field="reference[{{ loop.index0 }}].institution">{{ reference.institution }}</span><br>
      <span data-field="reference[{{ loop.index0 }}].address_line1">{{ reference.address_line1 }}</span><br>
      <span data-field="reference[{{ loop.index0 }}].address_line2">{{ reference.address_line2 }}</span>
    </p>
    <p>
      Phone: {{ reference.phone }}<br>
      Email: <span data-field="reference[{{ loop.index0 }}].email">{{ reference.email }}</span>
    </p>
  </div>
  {% endfor %}

</div>

</body>
</html>