<!DOCTYPE html>
<html>
<head>
<title>CV Template</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 {
    font-weight: bold;
    margin-top: 0;
  }
  .header-title {
    font-size: 24pt;
    text-align: center;
    margin-bottom: 5px;
  }
  .header-subtitle {
    font-size: 12pt;
    text-align: center;
    margin-bottom: 20px;
  }
  .contact-info {
    font-size: 10pt;
    line-height: 1.5;
  }
  .section-title {
    font-size: 12pt;
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 5px;
  }
  .entry-item {
    margin-bottom: 10px;
    font-size: 10pt;
  }
  .entry-title {
    font-weight: bold;
  }
  .entry-details {
    font-size: 10pt;
    margin-left: 10px;
  }
  .publication-title {
    font-style: italic;
    font-size: 10pt;
  }
  .footer {
    text-align: right;
    font-size: 10pt;
    margin-top: 50px;
  }
</style>
</head>
<body>

<div class="page">
  <div class="header-title">جامعة نيويورك أبوظبي</div>
  <div class="header-subtitle">NYU | ABU DHABI</div>
  <div class="contact-info">
    Email: <span data-field="email">{{ email }}</span><br>
    Phone: <span data-field="phone">{{ phone }}</span>
  </div>
  <div class="section-title">Soo Jin (Suzie) Kim</div>

  <div class="section-title">Research Interests</div>
  <div class="entry-item">
    <p>My research interests lie at the intersection of political philosophy and public policy. Specifically, I am interested in the justifiability of paternalistic policy and law in liberal states, theories of deliberative democracy and public reason, multiculturalism, business ethics, and epistemic theories of democracy and its critiques. I have recently published an article in the <span data-field="journal_name">{{ journal_name }}</span> that offers an original critique of a prominent strand of social contract theory and a suitable alternative. I am currently working on several articles on state paternalism, and a book project based on my dissertation, which concerns the ethics and moral permissibility of state paternalism on various issues, including recreational drug use, prostitution, and unconcionable contracts.</p>
  </div>

  <div class="section-title">Education</div>
  <div class="entry-item">
    <div class="entry-title">{{ degree_1 }}</div>
    <div class="entry-details">{{ institution_1 }}</div>
  </div>
  <div class="entry-item">
    <div class="entry-title">{{ degree_2 }}</div>
    <div class="entry-details">{{ institution_2 }}</div>
  </div>
  <div class="entry-item">
    <div class="entry-title">{{ degree_3 }}</div>
    <div class="entry-details">{{ institution_3 }}</div>
  </div>
</div>

<div class="page">
  <div class="header-title">جامعة نيويورك أبوظبي</div>
  <div class="header-subtitle">NYU | ABU DHABI</div>

  <div class="section-title">Publications</div>
  {% for pub in publications %}
    <div class="entry-item">
      <div class="publication-title">"{{ pub.title }}"</div>
      <div class="entry-details">{{ pub.journal_info }}</div>
    </div>
  {% endfor %}

  <div class="section-title">Works in Progress</div>
  {% for wip in works_in_progress %}
    <div class="entry-item">
      <div class="entry-title">"{{ wip.title }}"</div>
      <div class="entry-details">{{ wip.status }}</div>
    </div>
  {% endfor %}

  <div class="section-title">Conferences and Workshop Presentations</div>
  {% for conf in conferences %}
    <div class="entry-item">
      <div class="entry-title">{{ conf.title }}</div>
      <div class="entry-details">{{ conf.details }}</div>
    </div>
  {% endfor %}
</div>

<div class="page">
  <div class="header-title">جامعة نيويورك أبوظبي</div>
  <div class="header-subtitle">NYU | ABU DHABI</div>

  <div class="section-title">Awards and Fellowships</div>
  {% for award in awards %}
    <div class="entry-item">
      <div class="entry-title">{{ award.name }}</div>
      <div class="entry-details">{{ award.details }}</div>
    </div>
  {% endfor %}

  <div class="section-title">Teaching Experience</div>
  {% for teaching in teaching_experience %}
    <div class="entry-item">
      <div class="entry-title">{{ teaching.course_name }}</div>
      <div class="entry-details">{{ teaching.institution }} ({{ teaching.dates }})</div>
    </div>
  {% endfor %}

  <div class="section-title">Advising Experience</div>
  {% for advising in advising_experience %}
    <div class="entry-item">
      <div class="entry-title">{{ advising.role }}</div>
      <div class="entry-details">{{ advising.details }}</div>
    </div>
  {% endfor %}

  <div class="section-title">Professional Service</div>
  {% for service in professional_service %}
    <div class="entry-item">
      <div class="entry-title">{{ service.role }}</div>
      <div class="entry-details">{{ service.details }}</div>
    </div>
  {% endfor %}

  <div class="section-title">References</div>
  {% for ref in references %}
    <div class="entry-item">
      <div class="entry-title">{{ ref.name }}</div>
      <div class="entry-details">{{ ref.details }}</div>
    </div>
  {% endfor %}
</div>

<div class="page">
  <div class="header-title">جامعة نيويورك أبوظبي</div>
  <div class="header-subtitle">NYU | ABU DHABI</div>
  <div class="contact-info">
    <p>Email: <span data-field="contact_email">{{ contact_email }}</span></p>
  </div>
</div>

</body>
</html>