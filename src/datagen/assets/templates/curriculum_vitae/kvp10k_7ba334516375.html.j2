<!DOCTYPE html>
<html>
<head>
<title>Curriculum Vitae</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    line-height: 1.5;
    color: #333;
  }
  h1, h2, h3 {
    font-weight: bold;
    margin-top: 0.5em;
    margin-bottom: 0.5em;
  }
  .header-info {
    text-align: center;
    margin-bottom: 20px;
  }
  .contact-info {
    text-align: center;
    font-size: 0.9em;
  }
  .section-title {
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
    text-transform: uppercase;
    font-size: 1.1em;
  }
  .entry {
    margin-bottom: 15px;
  }
  .entry-title {
    font-weight: bold;
  }
  .entry-details {
    font-style: italic;
    font-size: 0.95em;
  }
  .list-item {
    margin-bottom: 5px;
  }
  .publication-title {
    font-weight: bold;
  }
  .page-number {
    position: absolute;
    bottom: 30px;
    right: 60px;
    font-size: 0.9em;
    text-align: right;
  }
</style>

<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document appearance */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; line-height: 1.5; }
</style>
</head>
<body>

<div class="page">
  <div class="header-info">
    <h1>CURRICULUM VITAE</h1>
    <div class="contact-info">
      <span data-field="full_name">{{ full_name }}</span><br>
      Address: <span data-field="address">{{ address }}</span><br>
      Phone: <span data-field="phone">{{ phone }}</span><br>
      E-Mail: <span data-field="email">{{ email }}</span>
    </div>
  </div>

  <div class="section-title">ACADEMIC PROFILE:</div>
  <div class="entry">
    <span data-field="academic_degree_1">{{ academic_degree_1 }}</span>, <span data-field="university_1">{{ university_1 }}</span>, <span data-field="location_1">{{ location_1 }}</span> (<span data-field="field_1">{{ field_1 }}</span>)
  </div>
  <div class="entry">
    <span data-field="academic_degree_2">{{ academic_degree_2 }}</span>, <span data-field="university_2">{{ university_2 }}</span>, <span data-field="location_2">{{ location_2 }}</span>
  </div>
  <div class="entry">
    <span data-field="academic_degree_3">{{ academic_degree_3 }}</span>, <span data-field="university_3">{{ university_3 }}</span>, <span data-field="location_3">{{ location_3 }}</span>
  </div>
  <div class="entry">
    <span data-field="academic_degree_4">{{ academic_degree_4 }}</span>, <span data-field="university_4">{{ university_4 }}</span>, <span data-field="location_4">{{ location_4 }}</span>
  </div>
  <div class="entry">
    <span data-field="academic_degree_5">{{ academic_degree_5 }}</span>, <span data-field="university_5">{{ university_5 }}</span>, <span data-field="location_5">{{ location_5 }}</span>
  </div>
  <div class="entry">
    <span data-field="academic_degree_6">{{ academic_degree_6 }}</span>, <span data-field="university_6">{{ university_6 }}</span>, <span data-field="location_6">{{ location_6 }}</span>
  </div>

  <div class="section-title">PROFESSIONAL QUALIFICATIONS (Current and Former):</div>
  <div class="entry">
    Current: <span data-field="qualification_current">{{ qualification_current }}</span>
  </div>
  <div class="entry">
    Former: <span data-field="qualification_former">{{ qualification_former }}</span>
  </div>

  <div class="section-title">ACADEMIC APPOINTMENTS: (Beginning with most recent)</div>
  {% for appointment in academic_appointments %}
    <div class="entry">
      <span data-field="appointment_title[{{ loop.index0 }}]">{{ appointment.title }}</span>, <span data-field="appointment_institution[{{ loop.index0 }}]">{{ appointment.institution }}</span>, <span data-field="appointment_location[{{ loop.index0 }}]">{{ appointment.location }}</span>, <span data-field="appointment_dates[{{ loop.index0 }}]">{{ appointment.dates }}</span>
    </div>
  {% endfor %}

  <div class="page-number">2</div>
</div>

<div class="page">
  <div class="section-title">PRIMARY PROFESSIONAL INVOLVEMENTS (Beginning with current)</div>
  {% for involvement in primary_involvements %}
    <div class="entry">
      <span data-field="primary_involvement_description[{{ loop.index0 }}]">{{ involvement.description }}</span>, <span data-field="primary_involvement_dates[{{ loop.index0 }}]">{{ involvement.dates }}</span>
    </div>
  {% endfor %}

  <div class="section-title">PROFESSIONAL APPOINTMENTS AND ELECTIONS: (Regional and National)</div>
  {% for appointment in professional_appointments %}
    <div class="entry">
      <span data-field="professional_appointment_description[{{ loop.index0 }}]">{{ appointment.description }}</span>, <span data-field="professional_appointment_dates[{{ loop.index0 }}]">{{ appointment.dates }}</span>
    </div>
  {% endfor %}

  <div class="section-title">SELECTED COMMITTEE INVOLVEMENTS</div>
  {% for committee in committee_involvements %}
    <div class="entry">
      <span data-field="committee_description[{{ loop.index0 }}]">{{ committee.description }}</span>, <span data-field="committee_dates[{{ loop.index0 }}]">{{ committee.dates }}</span>
    </div>
  {% endfor %}

  <div class="page-number">3</div>
</div>

<div class="page">
  <div class="section-title">SELECTED INVITED PRESENTATIONS</div>
  {% for presentation in invited_presentations %}
    <div class="entry">
      <span data-field="presentation_title[{{ loop.index0 }}]">{{ presentation.title }}</span>, <span data-field="presentation_location[{{ loop.index0 }}]">{{ presentation.location }}</span>, <span data-field="presentation_date[{{ loop.index0 }}]">{{ presentation.date }}</span>
    </div>
  {% endfor %}

  <div class="page-number">4</div>
</div>

<div class="page">
  <div class="section-title">PUBLISHED MATERIALS: ARTICLES AND BOOK REVIEWS</div>
  {% for publication in published_articles %}
    <div class="entry">
      <span data-field="publication_title[{{ loop.index0 }}]">{{ publication.title }}</span>, <span data-field="publication_journal[{{ loop.index0 }}]">{{ publication.journal }}</span>, <span data-field="publication_volume[{{ loop.index0 }}]">{{ publication.volume }}</span>, <span data-field="publication_pages[{{ loop.index0 }}]">{{ publication.pages }}</span>, <span data-field="publication_year[{{ loop.index0 }}]">{{ publication.year }}</span>
    </div>
  {% endfor %}

  <div class="section-title">PUBLISHED MATERIALS: BOOKS</div>
  {% for book in published_books %}
    <div class="entry">
      <span data-field="book_title[{{ loop.index0 }}]">{{ book.title }}</span>, <span data-field="book_publisher[{{ loop.index0 }}]">{{ book.publisher }}</span>, <span data-field="book_year[{{ loop.index0 }}]">{{ book.year }}</span>
    </div>
  {% endfor %}

  <div class="page-number">5</div>
</div>


<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document appearance */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; line-height: 1.5; }
</style>
<div class="page">
  <div style="text-align: right; font-size: 0.9em;">{{ page_number }}</div>
  <p style="margin-top: 0;">of Religion, Volume 5.</p>
  <p style="margin-top: 1em;">Reviewed, <span data-field="reviewer_name">{{ reviewer_name }}</span>, <span data-field="journal_title">{{ journal_title }}</span>, Vol. <span data-field="volume_number">{{ volume_number }}</span>, No.<span data-field="issue_number">{{ issue_number }}</span>, <span data-field="year">{{ year }}</span>, p. <span data-field="page_range">{{ page_range }}</span>.</p>
  <p style="margin-top: 1em;">
    <span data-field="author_name">{{ author_name }}</span>, "<span data-field="article_title">{{ article_title }}</span>", <span data-field="publication_details">{{ publication_details }}</span>, <span data-field="year_of_publication">{{ year_of_publication }}</span>, Chapter <span data-field="chapter_number">{{ chapter_number }}</span>.
  </p>
</div></body>
</html>