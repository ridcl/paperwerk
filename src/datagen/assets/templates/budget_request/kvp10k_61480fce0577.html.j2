<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child { page-break-after: auto; }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  td {
    padding: 8px 0;
    border: 1px solid #ccc;
    text-align: left;
  }
  .header-table td {
    border: none;
  }
  .form-row td {
    padding: 5px 0;
  }
  .full-width-table td {
    padding: 0;
  }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div style="text-align: left;">
      <h1 style="font-size: 24pt; margin: 0;">Request to Establish a Designated Department</h1>
    </div>
    <div style="text-align: right;">
      <div style="font-size: 10pt;">
        <p>Please return to the Budget Office (fax: {{ fax_number }}, <a href="mailto:{{ budget_office_email }}">{{ budget_office_email }}</a>, or MC: {{ mc_number }})</p>
      </div>
    </div>
  </div>

  <div style="margin-top: 20px; font-size: 10pt;">
    <p>The proposed activity must 1) clearly support the University's mission of instruction, research, and public service 2) be ongoing 3) administer revenues exceeding ${{ revenue_threshold }} (student fee revenue is excluded)</p>
  </div>

  <div style="margin-top: 30px; font-size: 10pt;">
    <p>In addition to this form, please attach the <span data-field="required_document_1">{{ required_document_1 }}</span> and documentation to show approval of the fee, if applicable (e.g., Board of Trustees agenda or Provost memo)</p>
  </div>

  <table class="header-table" style="margin-top: 40px;">
    <tr>
      <td style="width: 30%;">Department ID</td>
      <td style="width: 70%;">Department Description</td>
    </tr>
    <tr>
      <td style="width: 30%;">Purpose/Mission</td>
      <td style="width: 70%;"></td>
    </tr>
  </table>

  <h3 style="margin-top: 40px; font-size: 12pt;">Estimate revenue and expense for the initial fiscal year and the next two fiscal years</h3>

  <table style="margin-top: 20px;">
    <thead>
      <tr>
        <td style="width: 25%; padding-bottom: 5px;">Balance Forward</td>
        <td style="width: 25%; text-align: center;">Year 1</td>
        <td style="width: 25%; text-align: center;">Year 2</td>
        <td style="width: 25%; text-align: center;">Year 3</td>
      </tr>
    </thead>
    <tbody>
      <tr class="form-row">
        <td>Revenue</td>
        <td style="text-align: center;"><span data-field="year1_revenue">{{ year1_revenue }}</span></td>
        <td style="text-align: center;"><span data-field="year2_revenue">{{ year2_revenue }}</span></td>
        <td style="text-align: center;"><span data-field="year3_revenue">{{ year3_revenue }}</span></td>
      </tr>
      <tr class="form-row">
        <td>Transfer In</td>
        <td style="text-align: center;"><span data-field="year1_transfer_in">{{ year1_transfer_in }}</span></td>
        <td style="text-align: center;"><span data-field="year2_transfer_in">{{ year2_transfer_in }}</span></td>
        <td style="text-align: center;"><span data-field="year3_transfer_in">{{ year3_transfer_in }}</span></td>
      </tr>
      <tr class="form-row">
        <td>Cash Available</td>
        <td style="text-align: center;"><span data-field="year1_cash_available">{{ year1_cash_available }}</span></td>
        <td style="text-align: center;"><span data-field="year2_cash_available">{{ year2_cash_available }}</span></td>
        <td style="text-align: center;"><span data-field="year3_cash_available">{{ year3_cash_available }}</span></td>
      </tr>
      <tr class="form-row">
        <td>Salary</td>
        <td style="text-align: center;"><span data-field="year1_salary">{{ year1_salary }}</span></td>
        <td style="text-align: center;"><span data-field="year2_salary">{{ year2_salary }}</span></td>
        <td style="text-align: center;"><span data-field="year3_salary">{{ year3_salary }}</span></td>
      </tr>
      <tr class="form-row">
        <td>OPS</td>
        <td style="text-align: center;"><span data-field="year1_ops">{{ year1_ops }}</span></td>
        <td style="text-align: center;"><span data-field="year2_ops">{{ year2_ops }}</span></td>
        <td style="text-align: center;"><span data-field="year3_ops">{{ year3_ops }}</span></td>
      </tr>
      <tr class="form-row">
        <td>Expense</td>
        <td style="text-align: center;"><span data-field="year1_expense">{{ year1_expense }}</span></td>
        <td style="text-align: center;"><span data-field="year2_expense">{{ year2_expense }}</span></td>
        <td style="text-align: center;"><span data-field="year3_expense">{{ year3_expense }}</span></td>
      </tr>
      <tr class="form-row">
        <td>OCO</td>
        <td style="text-align: center;"><span data-field="year1_oco">{{ year1_oco }}</span></td>
        <td style="text-align: center;"><span data-field="year2_oco">{{ year2_oco }}</span></td>
        <td style="text-align: center;"><span data-field="year3_oco">{{ year3_oco }}</span></td>
      </tr>
      <tr class="form-row" style="font-weight: bold;">
        <td>Total Operating Expenditures</td>
        <td style="text-align: center;"><span data-field="year1_total_op_exp">{{ year1_total_op_exp }}</span></td>
        <td style="text-align: center;"><span data-field="year2_total_op_exp">{{ year2_total_op_exp }}</span></td>
        <td style="text-align: center;"><span data-field="year3_total_op_exp">{{ year3_total_op_exp }}</span></td>
      </tr>
      <tr class="form-row">
        <td>Transfer Out</td>
        <td style="text-align: center;"><span data-field="year1_transfer_out">{{ year1_transfer_out }}</span></td>
        <td style="text-align: center;"><span data-field="year2_transfer_out">{{ year2_transfer_out }}</span></td>
        <td style="text-align: center;"><span data-field="year3_transfer_out">{{ year3_transfer_out }}</span></td>
      </tr>
      <tr class="form-row" style="font-weight: bold;">
        <td>Ending Cash Balance</td>
        <td style="text-align: center;"><span data-field="year1_ending_cash_balance">{{ year1_ending_cash_balance }}</span></td>
        <td style="text-align: center;"><span data-field="year2_ending_cash_balance">{{ year2_ending_cash_balance }}</span></td>
        <td style="text-align: center;"><span data-field="year3_ending_cash_balance">{{ year3_ending_cash_balance }}</span></td>
      </tr>
    </tbody>
  </table>

  <div style="margin-top: 20px; font-size: 10pt;">
    Cash as a % of Expenditures: <span data-field="cash_percent_of_expenditures">{{ cash_percent_of_expenditures }}</span>
  </div>

  <h3 style="margin-top: 40px; font-size: 12pt;">Identify the entities to which you will provide sales or services, and the projected percentage of revenue for each</h3>

  <table style="margin-top: 20px;">
    <thead>
      <tr>
        <td style="width: 15%;">Type of User</td>
        <td style="width: 40%;">Customers</td>
        <td style="width: 25%;">Projected Sales</td>
        <td style="width: 20%;">Percentage of Total</td>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Internal</td>
        <td>Your own department</td>
        <td style="text-align: left;"><span data-field="customer_internal_1">{{ customer_internal_1 }}</span></td>
        <td style="text-align: center;"><span data-field="percent_internal_1">{{ percent_internal_1 }}</span></td>
      </tr>
      <tr>
        <td>Internal</td>
        <td>C&G within your department</td>
        <td style="text-align: left;"><span data-field="customer_internal_2">{{ customer_internal_2 }}</span></td>
        <td style="text-align: center;"><span data-field="percent_internal_2">{{ percent_internal_2 }}</span></td>
      </tr>
      <tr>
        <td>Internal</td>
        <td>Other FSU departments</td>
        <td style="text-align: left;"><span data-field="customer_internal_3">{{ customer_internal_3 }}</span></td>
        <td style="text-align: center;"><span data-field="percent_internal_3">{{ percent_internal_3 }}</span></td>
      </tr>
      <tr>
        <td>Internal</td>
        <td>C&G from other FSU departments</td>
        <td style="text-align: left;"><span data-field="customer_internal_4">{{ customer_internal_4 }}</span></td>
        <td style="text-align: center;"><span data-field="percent_internal_4">{{ percent_internal_4 }}</span></td>
      </tr>
      <tr>
        <td>Internal</td>
        <td>Students</td>
        <td style="text-align: left;"><span data-field="customer_internal_5">{{ customer_internal_5 }}</span></td>
        <td style="text-align: center;"><span data-field="percent_internal_5">{{ percent_internal_5 }}</span></td>
      </tr>
      <tr>
        <td>External</td>
        <td>Other State agencies</td>
        <td style="text-align: left;"><span data-field="customer_external_1">{{ customer_external_1 }}</span></td>
        <td style="text-align: center;"><span data-field="percent_external_1">{{ percent_external_1 }}</span></td>
      </tr>
      <tr>
        <td>External</td>
        <td>Other outside customers</td>
        <td style="text-align: left;"><span data-field="customer_external_2">{{ customer_external_2 }}</span></td>
        <td style="text-align: center;"><span data-field="percent_external_2">{{ percent_external_2 }}</span></td>
      </tr>
    </tbody>
  </table>

  <table style="margin-top: 20px;">
    <tr>
      <td style="width: 30%;">Total Revenue</td>
      <td style="width: 70%; text-align: right;"><span data-field="total_revenue_amount">{{ total_revenue_amount }}</span></td>
    </tr>
  </table>

  <div style="margin-top: 50px;">
    <table style="width: 100%;">
      <tr>
        <td style="width: 30%;">Contact Person</td>
        <td style="width: 30%;">Phone</td>
        <td style="width: 20%;">Date</td>
      </tr>
      <tr>
        <td style="width: 30%; border-bottom: 1px solid black;"></td>
        <td style="width: 30%; border-bottom: 1px solid black;"></td>
        <td style="width: 20%; border-bottom: 1px solid black;"></td>
      </tr>
    </table>
  </div>

  <div style="margin-top: 50px;">
    <table style="width: 100%;">
      <tr>
        <td style="width: 50%;">DDDHC</td>
        <td style="width: 50%;">Approval Signature</td>
      </tr>
      <tr>
        <td style="width: 50%; border-bottom: 1px solid black;"></td>
        <td style="width: 50%; border-bottom: 1px solid black;"></td>
      </tr>
    </table>
  </div>

  <div style="margin-top: 50px;">
    <table style="width: 100%;">
      <tr>
        <td style="width: 50%;">Budget Office Use Only</td>
        <td style="width: 50%;"></td>
      </tr>
      <tr>
        <td style="width: 50%;">Processed By</td>
        <td style="width: 25%;">Fund ID</td>
        <td style="width: 25%;">Classification</td>
        <td style="width: 20%;">OHA</td>
      </tr>
      <tr>
        <td style="width: 50%; border-bottom: 1px solid black;"></td>
        <td style="width: 25%; border-bottom: 1px solid black;"></td>
        <td style="width: 25%; border-bottom: 1px solid black;"></td>
        <td style="width: 20%; border-bottom: 1px solid black;"></td>
      </tr>
    </table>
  </div>
</div>