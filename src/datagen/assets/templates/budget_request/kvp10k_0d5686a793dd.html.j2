<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child {
    page-break-after: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
    margin-bottom: 20px;
  }
  td, th {
    padding: 8px;
    text-align: left;
    border: 1px solid #ccc;
  }
  .header-title {
    font-size: 24pt;
    font-weight: bold;
    text-align: center;
    margin-bottom: 10px;
  }
  .sub-header {
    font-size: 14pt;
    font-weight: bold;
    text-align: center;
    margin-bottom: 20px;
  }
  .section-heading {
    font-size: 12pt;
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
  }
  .signature-line {
    margin-top: 50px;
    border-top: 1px solid black;
    width: 50%;
  }
</style>
<div class="page">
  <div style="text-align: center;">
    <span style="font-size: 36pt; font-weight: bold;">SJSU</span>
    <div style="font-size: 18pt; font-weight: bold;">SAN JOSÉ STATE UNIVERSITY</div>
  </div>
  <div style="text-align: center; margin-top: 40px;">
    <div style="font-size: 16pt; font-weight: bold;">CAMPUS FEE ADVISORY COMMITTEE (CFAC)</div>
    <div style="font-size: 14pt; font-weight: bold;">AGENDA</div>
    <div style="font-size: 12pt;">Friday, <span data-field="agenda_date">{{ agenda_date }}</span></div>
    <div style="font-size: 12pt;">2:30pm-4:30pm</div>
    <div style="font-size: 12pt;">Clark Hall 506</div>
  </div>

  <div style="margin-top: 50px;">
    <div style="font-weight: bold;">Committee Members:</div>
    <div style="margin-top: 5px;">
      {% for member in committee_members %}
        <span data-field="committee_members[{{ loop.index0 }}].name">{{ member.name }}</span>, 
        <span data-field="committee_members[{{ loop.index0 }}].role">{{ member.role }}</span>
        {% if not loop.last %}, {% endif %}
      {% endfor %}
    </div>
  </div>

  <div style="margin-top: 50px;">
    <div class="section-heading">I. SSETF Discussion</div>
    <ol style="margin-left: 20px;">
      <li>
        <span data-field="discussion_item_1_a">{{ discussion_item_1_a }}</span> (<a href="#" data-field="discussion_item_1_a_link">{{ discussion_item_1_a_link }}</a>)
      </li>
      <li>
        <span data-field="discussion_item_2">{{ discussion_item_2 }}</span> (<a href="#" data-field="discussion_item_2_link">{{ discussion_item_2_link }}</a>) – Information and Q&A
      </li>
      <li>
        <span data-field="discussion_item_3">{{ discussion_item_3 }}</span> – Read in advance of the meeting and come prepared for discussion on whether to support the request for funding
      </li>
      <li>
        <span data-field="discussion_item_4">{{ discussion_item_4 }}</span> (spreadsheet)
      </li>
    </ol>
  </div>
</div>

<div class="page">
  <div style="text-align: center;">
    <span style="font-size: 18pt; font-weight: bold;">San José State University</span>
    <div style="font-size: 14pt; font-weight: bold;">SSETF Biennial Budget Funding Request - FYs 2015-17</div>
    <div style="font-size: 10pt;">Please refer to the SSETF Allocation and Expenditure Procedures on the SJSU Finance website (under Policies & Guidelines)</div>
  </div>

  <table style="margin-top: 30px;">
    <tr>
      <th style="width: 20%;">Division:</th>
      <td style="width: 30%;"><span data-field="division">{{ division }}</span></td>
      <th style="width: 20%;">Dean/AVP Approval:</th>
      <td style="width: 30%;"><span data-field="dean_avp_approval">{{ dean_avp_approval }}</span></td>
    </tr>
    <tr>
      <th>College/Dept.:</th>
      <td><span data-field="college_dept">{{ college_dept }}</span></td>
      <th>DeptID:</th>
      <td><span data-field="dept_id">{{ dept_id }}</span></td>
      <th>Ph:</th>
      <td><span data-field="phone">{{ phone }}</span></td>
    </tr>
    <tr>
      <th>Contact Person:</th>
      <td><span data-field="contact_person">{{ contact_person }}</span></td>
      <th>Title of Proposed Project:</th>
      <td><span data-field="project_title">{{ project_title }}</span></td>
    </tr>
  </table>

  <div style="margin-top: 30px;">
    <div class="section-heading">Indicate which SSETF Priority this request fulfills:</div>
    <div style="margin-top: 10px;">
      <label><input type="radio" name="priority" value="academic"> Academic Technology</label>
      <label style="margin-left: 20px;"><input type="radio" name="priority" value="21st_century"> 21st Century Teaching Spaces</label>
      <label style="margin-left: 20px;"><input type="radio" name="priority" value="retention"> Retention & Graduation</label>
    </div>
    <div style="margin-top: 10px;">
      <label><input type="checkbox" name="priority_check" value="student_success"> Student Success Services & Graduation Pathways</label>
    </div>
  </div>

  <div style="margin-top: 40px;">
    <div style="font-weight: bold;">One-Time Request - 2015/16</div>
    <table style="margin-top: 10px;">
      <tr>
        <th style="width: 30%;">Staff/Faculty Salaries*:</th>
        <td style="width: 30%;"><span data-field="salaries_2015_16_staff_faculty">{{ salaries_2015_16_staff_faculty }}</span></td>
        <th style="width: 30%;">Benefits (42%):</th>
        <td style="width: 30%;"><span data-field="benefits_2015_16">{{ benefits_2015_16 }}</span></td>
      </tr>
      <tr>
        <th>Other Salary**:</th>
        <td><span data-field="other_salary_2015_16">{{ other_salary_2015_16 }}</span></td>
        <th>Other Salary**:</th>
        <td><span data-field="other_salary_2015_16_other">{{ other_salary_2015_16_other }}</span></td>
      </tr>
      <tr>
        <th style="text-align: right;">Sub-Total Compensation</th>
        <td style="text-align: right;"><span data-field="subtotal_compensation_2015_16">{{ subtotal_compensation_2015_16 }}</span></td>
        <th style="text-align: right;">Sub-Total Compensation</th>
        <td style="text-align: right;"><span data-field="subtotal_compensation_2015_16_other">{{ subtotal_compensation_2015_16_other }}</span></td>
      </tr>
    </table>

    <div style="margin-top: 20px;">
      <div style="font-weight: bold;">Supplies:</div>
      <table style="margin-top: 10px;">
        <tr>
          <th style="width: 30%;">Supplies:</th>
          <td style="width: 30%;"><span data-field="supplies_2015_16">{{ supplies_2015_16 }}</span></td>
          <th style="width: 30%;">Supplies:</th>
          <td style="width: 30%;"><span data-field="supplies_2015_16_other">{{ supplies_2015_16_other }}</span></td>
        </tr>
        <tr>
          <th>Other (specify):</th>
          <td><span data-field="other_2015_16">{{ other_2015_16 }}</span></td>
          <th>Other (specify):</th>
          <td><span data-field="other_2015_16_other">{{ other_2015_16_other }}</span></td>
        </tr>
        <tr>
          <th style="text-align: right;">Sub-Total Supplies</th>
          <td style="text-align: right;"><span data-field="subtotal_supplies_2015_16">{{ subtotal_supplies_2015_16 }}</span></td>
          <th style="text-align: right;">Sub-Total Supplies</th>
          <td style="text-align: right;"><span data-field="subtotal_supplies_2015_16_other">{{ subtotal_supplies_2015_16_other }}</span></td>
        </tr>
      </table>
    </div>

    <div style="margin-top: 20px;">
      <table style="width: 50%; float: left; margin-right: 2%;">
        <tr>
          <th style="text-align: right;">Total One-Time w/o benefits</th>
          <td style="text-align: right;"><span data-field="total_one_time_wo_benefits_2015_16">{{ total_one_time_wo_benefits_2015_16 }}</span></td>
        </tr>
        <tr>
          <th style="text-align: right;">Total 2015/16 Request</th>
          <td style="text-align: right;"><span data-field="total_request_2015_16">{{ total_request_2015_16 }}</span></td>
        </tr>
      </table>
      <table style="width: 50%; float: right; margin-left: 2%;">
        <tr>
          <th style="text-align: right;">Total One-Time w/o benefits</th>
          <td style="text-align: right;"><span data-field="total_one_time_wo_benefits_2016_17">{{ total_one_time_wo_benefits_2016_17 }}</span></td>
        </tr>
        <tr>
          <th style="text-align: right;">Total 2016/17 Request</th>
          <td style="text-align: right;"><span data-field="total_request_2016_17">{{ total_request_2016_17 }}</span></td>
        </tr>
      </table>
      <div style="clear: both;"></div>
    </div>
  </div>

  <div style="margin-top: 50px;">
    <div class="section-heading">Total Funds Requested:</div>
    <div style="font-size: 14pt; font-weight: bold;"><span data-field="total_funds_requested">{{ total_funds_requested }}</span></div>
  </div>

  <div style="margin-top: 50px;">
    <div class="section-heading">*Complete the Details section on page 2 for all salary dollars requested.</div>
    <div class="section-heading">**Other Salary includes student assistants, temporary/seasonal workers, shift differentials, etc.</div>
    <div class="section-heading">Briefly describe the program/project and purpose for which funds are being requested:</div>
    <div style="border: 1px solid #ccc; height: 100px; margin-top: 10px;">
      <p style="padding: 10px;">{{ program_description }}</p>
    </div>
  </div>
</div>

<div class="page">
  <div style="text-align: center;">
    <span style="font-size: 18pt; font-weight: bold;">SJSU</span>
    <div style="font-size: 14pt; font-weight: bold;">SSETF Project Outcome Report</div>
    <div style="font-size: 10pt;">Budget & Risk Management</div>
  </div>

  <div style="margin-top: 30px;">
    <table style="width: 100%;">
      <tr>
        <th style="width: 20%;">Finance:</th>
        <td>One Washington Square</td>
        <th style="width: 20%;">San Jose, CA</th>
        <td>95192-0004</td>
        <th style="width: 20%;">408-924-1588/Fax: 408-924-1892</th>
      </tr>
    </table>
  </div>

  <div style="margin-top: 30px;">
    <div class="section-heading">Instructions: Complete form, attaching additional files or documentation as necessary, then obtain Dean/AVP digital signature (click here for instructions). Please include a copy of original funding request submitted during year of initial funding. Once complete, please e-mail form to <span data-field="email_address">{{ email_address }}</span>. Keep a copy of the form for your records. As a reminder, your unit may be invited to deliver a brief presentation to the Campus Fee Advisory Committee highlighting accomplishments.</div>
  </div>

  <div style="margin-top: 40px;">
    <div class="section-heading">PROJECT INFORMATION</div>
    <table style="width: 100%;">
      <tr>
        <th style="width: 20%;">Title of Project:</th>
