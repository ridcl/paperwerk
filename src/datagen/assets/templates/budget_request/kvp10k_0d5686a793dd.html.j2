        <td><span data-field="commitment_number">{{ commitment_number }}</span></td>
      </tr>
      <tr>
        <th>Division:</th>
        <td><span data-field="division_report">{{ division_report }}</span></td>
        <th>Base Funds (Yes/No):</th>
        <td><span data-field="base_funds">{{ base_funds }}</span></td>
      </tr>
      <tr>
        <th>College/Department:</th>
        <td><span data-field="college_dept_report">{{ college_dept_report }}</span></td>
        <th>Dept. ID:</th>
        <td><span data-field="dept_id_report">{{ dept_id_report }}</span></td>
      </tr>
      <tr>
        <th>Contact Person:</th>
        <td><span data-field="contact_person_report">{{ contact_person_report }}</span></td>
        <th>Phone:</th>
        <td><span data-field="phone_report">{{ phone_report }}</span></td>
      </tr>
      <tr>
        <th>Year Funds Awarded:</th>
        <td><span data-field="year_funds_awarded_report">{{ year_funds_awarded_report }}</span></td>
        <th>Funds Awarded:</th>
        <td><span data-field="funds_awarded_report">{{ funds_awarded_report }}</span></td>
      </tr>
    </table>
  </div>

  <div style="margin-top: 40px;">
    <div class="section-heading">Dean/AVP Approval</div>
    <div style="display: flex; justify-content: space-between; margin-top: 20px;">
      <div>
        <div class="signature-line"></div>
        <div style="text-align: center; margin-top: 5px;">Dean/AVP Name & Title:</div>
        <div style="text-align: center; font-size: 10pt;">Dean David Steele</div>
      </div>
      <div>
        <div class="signature-line"></div>
        <div style="text-align: center; margin-top: 5px;">Digital Signature:</div>
      </div>
    </div>
  </div>

  <div style="margin-top: 40px;">
    <div class="section-heading">Please select applicable categories:</div>
    <div style="margin-top: 10px;">
      <label><input type="checkbox" name="category" value="student_success"> Student Success Services & Graduation Pathways</label>
      <label style="margin-left: 20px;"><input type="checkbox" name="category" value="academic_tech"> Academic Technology</label>
      <label style="margin-left: 20px;"><input type="checkbox" name="category" value="21st_century"> 21st Century Teaching Spaces</label>
      <label style="margin-left: 20px;"><input type="checkbox" name="category" value="retention"> Retention & Graduation</label>
    </div>
  </div>

  <div style="margin-top: 40px;">
    <div class="section-heading">PROJECT UPDATE</div>
    <table style="width: 100%;">
      <tr>
        <th style="width: 20%;">Project Completed:</th>
        <td><span data-field="project_completed">{{ project_completed }}</span></td>
        <th style="width: 20%;">Were all Funds Spent:</th>
        <td><span data-field="funds_spent">{{ funds_spent }}</span></td>
      </tr>
      <tr>
        <th>Please provide an overview of the project:</th>
        <td colspan="3" style="border: 1px solid #ccc; height: 150px; padding: 10px;">
          <p>{{ project_overview }}</p>
        </td>
      </tr>
    </table>
  </div>
</div>

<div class="page">
  <div style="text-align: center;">
    <span style="font-size: 18pt; font-weight: bold;">SJSU</span>
    <div style="font-size: 14pt; font-weight: bold;">PROJECT OBSERVATIONS</div>
  </div>

  <div style="margin-top: 30px;">
