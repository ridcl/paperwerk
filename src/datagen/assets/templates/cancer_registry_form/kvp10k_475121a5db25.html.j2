<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
  }
  th, td {
    border: 1px solid #000;
    padding: 8px;
    text-align: left;
    vertical-align: top;
  }
  th {
    font-weight: bold;
    font-size: 12pt;
  }
</style>
<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div style="display: flex; align-items: center;">
      <img src="placeholder_logo.png" alt="University of Guam Logo" style="height: 80px; margin-right: 20px;">
      <div>
        <h1 style="font-size: 24pt; margin: 0;">Guam Cancer Registry</h1>
        <p style="font-size: 11pt; margin: 2px 0 0 0;">A Joint Project of the UOG Cancer Research Center and the Department of Public Health & Social Services</p>
        <p style="font-size: 11pt; margin: 2px 0 0 0;">Funded via Public Law 30-80</p>
      </div>
    </div>
    <div style="text-align: right;">
      <img src="placeholder_seal.png" alt="Public Health Seal" style="height: 80px;">
    </div>
  </div>

  <h2 style="font-size: 16pt; margin-top: 30px; margin-bottom: 10px;">NON-MEDICAL PROVIDER CANCER REPORTING FORM</h2>

  <div style="margin-bottom: 20px;">
    Service Provider Name/Contact No.: <span data-field="service_provider_name">{{ service_provider_name }}</span>
  </div>
  <div style="margin-bottom: 30px;">
    Service Period: <span data-field="service_period">{{ service_period }}</span>
  </div>

  <table>
    <thead>
      <tr>
        <th style="width: 15%;">NAME (Last, First, M.I.)</th>
        <th style="width: 10%;">DATE OF BIRTH</th>
        <th style="width: 20%;">STREET ADDRESS & VILLAGE</th>
        <th style="width: 15%;">RACE/ETHNICITY (for research)</th>
        <th style="width: 15%;">PRIMARY SITE OF CANCER</th>
        <th style="width: 15%;">HOSPITAL/CLINIC and PRIMARY DOCTOR</th>
        <th style="width: 10%;">SERVICE DATE OR DATE OF LAST CONTACT</th>
      </tr>
    </thead>
    <tbody>
      {% for i in range(25) %}
      <tr>
        <td><span data-field="line_items[{{ i }}].name">{{ line_items[i].name }}</span></td>
        <td><span data-field="line_items[{{ i }}].dob">{{ line_items[i].dob }}</span></td>
        <td><span data-field="line_items[{{ i }}].address">{{ line_items[i].address }}</span></td>
        <td><span data-field="line_items[{{ i }}].race_ethnicity">{{ line_items[i].race_ethnicity }}</span></td>
        <td><span data-field="line_items[{{ i }}].primary_site">{{ line_items[i].primary_site }}</span></td>
        <td><span data-field="line_items[{{ i }}].hospital_doctor">{{ line_items[i].hospital_doctor }}</span></td>
        <td><span data-field="line_items[{{ i }}].service_date">{{ line_items[i].service_date }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>