<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child {
    page-break-after: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
  }
  td {
    padding: 8px 0;
    text-align: left;
  }
  .header-section {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 30px;
  }
  .logo-area {
    text-align: left;
  }
  .title-area {
    text-align: right;
  }
  .info-block {
    margin-top: 30px;
    font-size: 0.9em;
  }
  .table-container {
    margin-top: 40px;
  }
</style>

<div class="page">
  <div class="header-section">
    <div class="logo-area">
      <!-- Placeholder for Seal/Logo -->
    </div>
    <div class="title-area">
      <h1 style="font-size: 24pt; margin: 0;">Oklahoma Tax Commission</h1>
      <p style="font-size: 10pt; margin: 0;">www.tax.ok.gov</p>
    </div>
  </div>

  <div class="info-block">
    <p>Date Issued: <span data-field="date_issued">{{ date_issued }}</span></p>
    <p>Letter ID: <span data-field="letter_id">{{ letter_id }}</span></p>
    <p>Taxpayer ID: <span data-field="taxpayer_id">{{ taxpayer_id }}</span></p>
  </div>

  <h2 style="margin-top: 40px;">Oklahoma Sales Tax Exemption Permit</h2>
  <h3 style="margin-top: 5px;">Public Schools-Higher Education</h3>

  <div style="display: flex; justify-content: space-between; margin-top: 40px;">
    <div style="width: 45%;">
      <p>County: <span data-field="county">{{ county }}</span></p>
      <p>CHEROKEE</p>
    </div>
    <div style="width: 45%; text-align: right;">
      <p>Non-Transferable</p>
      <p>Permit Number: <span data-field="permit_number">{{ permit_number }}</span></p>
      <p>EXM-14318898-02</p>
    </div>
  </div>

  <div class="table-container">
    <table>
      <thead>
        <tr>
          <td style="width: 25%;">Business Location</td>
          <td style="width: 20%;">Industry Code</td>
          <td style="width: 20%;">City Code</td>
          <td style="width: 20%;">Permit Effective</td>
          <td style="width: 15%;">Permit Expires</td>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>
            <span data-field="business_location_name">{{ business_location_name }}</span><br>
            <span data-field="business_location_address_line1">{{ business_location_address_line1 }}</span><br>
            <span data-field="business_location_address_line2">{{ business_location_address_line2 }}</span>
          </td>
          <td><span data-field="industry_code">{{ industry_code }}</span></td>
          <td><span data-field="city_code">{{ city_code }}</span></td>
          <td><span data-field="permit_effective_date">{{ permit_effective_date }}</span></td>
          <td>NON-EXPIRING</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div style="margin-top: 80px; display: flex; justify-content: space-between;">
    <div style="width: 50%;">
      <p>68 Oklahoma Statutes Section 1356(11)(2001): Which we quote in part: "Sales of tangible personal property or services to private institutions of higher education and private elementary and secondary institutions of education accredited by the State Department of Education or registered by the State Board of Education for purposes of participating in federal programs or accredited as defined by the Oklahoma State Regents for Higher Education..."</p>
    </div>
    <div style="width: 50%; text-align: right;">
      <p>Steve Burrage, Chairman</p>
      <p>Dawn Cash, Vice-Chairman</p>
      <p>Thomas Kemp Jr., Secretary-Member</p>
    </div>
  </div>
</div>