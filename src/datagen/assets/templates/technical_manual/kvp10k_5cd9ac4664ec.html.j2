<!DOCTYPE html>
<html>
<head>
    <title>Preventive Maintenance Kits</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 { font-weight: bold; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; margin-bottom: 15px; }
        th, td { border: 1px solid #ccc; padding: 8px; text-align: left; }
        .header-title { font-size: 24pt; font-weight: bold; }
        .section-heading { font-size: 14pt; font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
        .list-item { margin-bottom: 8px; }
    </style>
</head>
<body>
    <div class="page">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
                <h1 class="header-title">Preventive maintenance kits for SELMA2 mapped drive control systems</h1>
                <p style="margin-top: 20px;"><span data-field="document_id">{{ document_id }}</span></p>
            </div>
            <div style="text-align: right;">
                <div style="font-size: 10pt; font-weight: bold;">FACT FILE</div>
                <div style="font-size: 10pt;">SP25 EN REVB 2007</div>
            </div>
        </div>

        <div style="display: flex; margin-top: 40px;">
            <div style="flex: 1; padding-right: 50px;">
                <p>Preventive maintenance kits contain all necessary replacement parts for the specific scheduled maintenance. The content of each kit is carefully defined to match the SELMA 2 maintenance schedule.</p>
                <p>The kits have been specified based on <span data-field="manufacturer_name">{{ manufacturer_name }}</span>'s extensive SELMA 2 system and component maintenance experience.</p>

                <h2 class="section-heading">Benefits</h2>
                <ul style="list-style-type: disc; padding-left: 20px;">
                    <li class="list-item"><span data-field="benefit_1">{{ benefit_1 }}</span></li>
                    <li class="list-item"><span data-field="benefit_2">{{ benefit_2 }}</span></li>
                    <li class="list-item"><span data-field="benefit_3">{{ benefit_3 }}</span></li>
                    <li class="list-item"><span data-field="benefit_4">{{ benefit_4 }}</span></li>
                    <li class="list-item"><span data-field="benefit_5">{{ benefit_5 }}</span></li>
                    <li class="list-item"><span data-field="benefit_6">{{ benefit_6 }}</span></li>
                </ul>

                <h2 class="section-heading">Service provides</h2>
                <p>The delivered preventive maintenance (PM) kits contain the service parts for preventive maintenance. See table below:</p>
                <table>
                    <thead>
                        <tr>
                            <th></th>
                            <th>Every <span data-field="period_1">{{ period_1 }}</span> year</th>
                            <th>Every <span data-field="period_2">{{ period_2 }}</span> year</th>
                            <th>Every <span data-field="period_3">{{ period_3 }}</span> year</th>
                            <th>Every <span data-field="period_4">{{ period_4 }}</span> year</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Cooling fan unit in cabinet</td>
                            <td><span data-field="part_qty_1">{{ part_qty_1 }}</span></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>Batteries on SELMA boards</td>
                            <td><span data-field="part_qty_2">{{ part_qty_2 }}</span></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>Fan filters in cabinet and cooling system</td>
                            <td><span data-field="part_qty_3">{{ part_qty_3 }}</span></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>Keyboard overlay</td>
                            <td></td>
                            <td><span data-field="part_qty_4">{{ part_qty_4 }}</span></td>
                            <td></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>Fan in SELMA cabinet</td>
                            <td></td>
                            <td><span data-field="part_qty_5">{{ part_qty_5 }}</span></td>
                            <td></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>Updates: Capacitors of power unit</td>
                            <td></td>
                            <td></td>
                            <td><span data-field="part_qty_6">{{ part_qty_6 }}</span></td>
                            <td></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div style="flex: 1; padding-left: 50px;">
                <div style="position: absolute; top: 100px; right: 0; transform: rotate(-90deg); transform-origin: top right; font-size: 18pt; font-weight: bold; color: #333;">Service notes</div>
                <div style="margin-top: 100px;">
                    <h2 class="section-heading">Preparations before preventive maintenance</h2>
                    <p>PM kits are delivered on lead-time basis, contrary to normal spare parts, hence the PM kits must be ordered well in advance of the planned preventive maintenance.</p>
                    <p>More information regarding PM kits and their content visit: <span data-field="website_url">{{ website_url }}</span>.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="page">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div style="text-align: left;">
                <div style="font-size: 10pt; font-weight: bold;">FACT FILE</div>
                <div style="font-size: 10pt;">SP25 EN REVB 2007</div>
            </div>
            <div style="text-align: right;">
                <div style="font-size: 10pt; font-weight: bold;">Service notes</div>
            </div>
        </div>

        <h2 class="section-heading" style="margin-top: 30px;">Maintenance schedule</h2>
        <p>Based on <span data-field="experience_level">{{ experience_level }}</span>'s experience, however, failure probability of such industrial products equipped with electronic components in creases after years of operation. For control system products this period is typically 5 to 10 years. One of the main reasons for failures is the aging of components, but it is also highly affected by operational conditions.</p>
        <p>A component failure may cause consequential damage to other parts of the control system.</p>
        <p>A maintenance schedule provides a systematic and functional means of maintaining SELMA 2 control systems. It is based on extensive experience and knowledge of manufacturing and</p>

        <h2 class="section-heading">Maintenance Schedule</h2>
        <p>Maintaining SELMA 2 systems. Specifications of component suppliers are observed carefully.</p>

        <p>The environmental and operational conditions of the system are also considered. Demanding environments, such as high ambient temperature, humidity or dustiness, can measurably shorten component lifetime and also maintenance and component replacement intervals.</p>
        <p>ABB recommends an annual inspection in addition to regular maintenance to be carried out to ensure optimum control system performance through its entire lifetime.</p>

        <h3 style="margin-top: 25px;">Years from start-up</h3>
        <table>
            <thead>
                <tr>
                    <th>Start-up</th>
                    {% for year in range(0, 23) %}
                        <th>{{ year }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Operation Station</td>
                    {% for year in range(0, 23) %}
                        <td><span data-field="op_station_{{ loop.index0 }}">{{ 'I' if loop.index0 % 3 == 0 else 'P' }}</span></td>
                    {% endfor %}
                </tr>
                <tr>
                    <td>Input/Output</td>
                    {% for year in range(0, 23) %}
                        <td><span data-field="io_{{ loop.index0 }}">{{ 'I' if loop.index0 % 2 == 0 else 'P' }}</span></td>
                    {% endfor %}
                </tr>
                <tr>
                    <td>Power supply</td>
                    {% for year in range(0, 23) %}
                        <td><span data-field="ps_{{ loop.index0 }}">{{ 'I' if loop.index0 % 4 == 0 else 'P' }}</span></td>
                    {% endfor %}
                </tr>
                <tr>
                    <td>Communication function test</td>
                    {% for year in range(0, 23) %}
                        <td><span data-field="comm_{{ loop.index0 }}">{{ 'I' if loop.index0 % 5 == 0 else 'P' }}</span></td>
                    {% endfor %}
                </tr>
                <tr>
                    <td>System backup</td>
                    {% for year in range(0, 23) %}
                        <td><span data-field="sys_{{ loop.index0 }}">{{ 'I' if loop.index0 % 6 == 0 else 'P' }}</span></td>
                    {% endfor %}
                </tr>
            </tbody>
        </table>

        <h3 style="margin-top: 25px;">SELMA 2 cabinet</h3>
        <table>
            <thead>
                <tr>
                    <th></th>
                    {% for year in range(0, 23) %}
                        <th>{{ year }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Visual inspection</td>
                    {% for year in range(0, 23) %}
                        <td><span data-field="selma2_vis_{{ loop.index0 }}">{{ 'I' if loop.index0 % 2 == 0 else 'P' }}</span></td>
                    {% endfor %}
                </tr>
                <tr>
                    <td>Mechanical joints</td>
                    {% for year in range(0, 23) %}
                        <td><span data-field="selma2_mech_{{ loop.index0 }}">{{ 'I' if loop.index0 % 3 == 0 else 'P' }}</span></td>
                    {% endfor %}
                </tr>
                <tr>
                    <td>Power supply (UPS)</td>
                    {% for year in range(0, 23) %}
                        <td><span data-field="selma2_ups_{{ loop.index0 }}">{{ 'I' if loop.index0 % 4 == 0 else 'P' }}</span></td>
                    {% endfor %}
                </tr>
                <tr>
                    <td>Battery check</td>
                    {% for year in range(0, 23) %}
                        <td><span data-field="selma2_batt_{{ loop.index0 }}">{{ 'I' if loop.index0 % 5 == 0 else 'P' }}</span></td>
                    {% endfor %}
                </tr>
                <tr>
                    <td>Fan on SELMA</td>
                    {% for year in range(0, 23) %}
                        <td><span data-field="selma2_fan_{{ loop.index0 }}">{{ 'I' if loop.index0 % 6 == 0 else 'P' }}</span></td>
                    {% endfor %}
                </tr>
                <tr>
                    <td>Cleanliness of fan filter</td>
                    {% for year in range(0, 23) %}
                        <td><span data-field="selma2_clean_{{ loop.index0 }}">{{ 'I' if loop.index0 % 7 == 0 else 'P' }}</span></td>
                    {% endfor %}
                </tr>
            </tbody>
        </table>

        <h3 style="margin-top: 25px;">Battery</h3>
        <table>
            <thead>
                <tr>
                    <th></th>
                    {% for year in range(0, 23) %}
                        <th>{{ year }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Visual inspection</td>
                    {% for year in range(0, 23) %}
                        <td><span data-field="batt_vis_{{ loop.index0 }}">{{ 'I' if loop.index0 % 2 == 0 else 'P' }}</span></td>
                    {% endfor %}
                </tr>
                <tr>
                    <td>Voltage check</td>
                    {% for year in range(0, 23) %}
                        <td><span data-field="batt_volt_{{ loop.index0 }}">{{ 'I' if loop.index0 % 3 == 0 else 'P' }}</span></td>
                    {% endfor %}
                </tr>
                <tr>
                    <td>Current check</td>
                    {% for year in range(0, 23) %}
                        <td><span data-field="batt_curr_{{ loop.index0 }}">{{ 'I' if loop.index0 % 4 == 0 else 'P' }}</span></td>
                    {% endfor %}
                </tr>
            </tbody>
        </table>

        <h3 style="margin-top: 25px;">Cooling system</h3>
        <table>
            <thead>
                <tr>
                    <th></th>
                    {% for year in range(0, 23) %}
                        <th>{{ year }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Visual inspection</td>
                    {% for year in range(0, 23) %}
                        <td><span data-field="cool_vis_{{ loop.index0 }}">{{ 'I' if loop.index0 % 2 == 0 else 'P' }}</span></td>
                    {% endfor %}
                </tr>
                <tr>
                    <td>Mechanical joints</td>
                    {% for year in range(0, 23) %}
                        <td><span data-field="cool_mech_{{ loop.index0 }}">{{ 'I' if loop.index0 % 3 == 0 else 'P' }}</span></td>
                    {% endfor %}
                </tr>
                <tr>
                    <td>Fan filter cleaning</td>
                    {% for year in range(0, 23) %}
                        <td><span data-field="cool_clean_{{ loop.index0 }}">{{ 'I' if loop.index0 % 4 == 0 else 'P' }}</span></td>
                    {% endfor %}
                </tr>
            </tbody>
        </table>

        <h3 style="margin-top: 25px;">Parameters</h3>
        <table>
            <thead>
                <tr>
                    <th></th>
                    {% for year in range(0, 23) %}
                        <th>{{ year }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Inspection and change</td>
                    {% for year in range(0, 23) %}
                        <td><span data-field="param_insp_{{ loop.index0 }}">{{ 'I' if loop.index0 % 2 == 0 else 'P' }}</span></td>
                    {% endfor %}
                </tr>
                <tr>
                    <td>Backing-up the parameters</td>
                    {% for year in range(0, 23) %}
                        <td><span data-field="param_backup_{{ loop.index0 }}">{{ 'I' if loop.index0 % 3 == 0 else 'P' }}</span></td>
                    {% endfor %}
                </tr>
                <tr>
                    <td>Software update</td>
                    {% for year in range(0, 23) %}
                        <td><span data-field="param_soft_{{ loop.index0 }}">{{ 'I' if loop.index0 % 4 == 0 else 'P' }}</span></td>
                    {% endfor %}
                </tr>
            </tbody>
        </table>

        <h3 style="margin-top: 25px;">M-Unit (DG automatic)</h3>
        <table>
            <thead>
                <tr>
                    <th></th>
                    {% for year in range(0, 23) %}
                        <th>{{ year }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Checking the panels</td>
                    {% for year in range(0, 23) %}
                        <td><span data-field="munit_panel_{{ loop.index0 }}">{{ 'I' if loop.index0 % 2 == 0 else 'P' }}</span></td>
                    {% endfor %}
                </tr>
                <tr>
                    <td>System inspection</td>
                    {% for year in range(0, 23) %}
                        <td><span data-field="munit_sys_{{ loop.index0 }}">{{ 'I' if loop.index0 % 3 == 0 else 'P' }}</span></td>
                    {% endfor %}
                </tr>
                <tr>
                    <td>Repair Center</td>
                    {% for year in range(0, 23) %}
                        <td><span data-field="munit_repair_{{ loop.index0 }}">{{ 'I' if loop.index0 % 4 == 0 else 'P' }}</span></td>
                    {% endfor %}
                </tr>
            </tbody>
        </table>

        <h3 style="margin-top: 25px;">Improvements</h3>
        <table>
            <thead>
                <tr>
                    <th></th>
                    {% for year in range(0, 23) %}
                        <th>{{ year }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>ABB VibePoint</td>
                    {% for year in range(0, 23) %}
                        <td><span data-field="imp_vibe_{{ loop.index0 }}">{{ 'I' if loop.index0 % 2 == 0 else 'P' }}</span></td>
                    {% endfor %}
                </tr>
                <tr>
                    <td>ABB VibePoint</td>
                    {% for year in range(0, 23) %}
                        <td><span data-field="imp_vibe2_{{ loop.index0 }}">{{ 'I' if loop.index0 % 3 == 0 else 'P' }}</span></td>
                    {% endfor %}
                </tr>
                <tr>
                    <td>Electrical interface RS232</td>
                    {% for year in range(0, 23) %}
                        <td><span data-field="imp_rs232_{{ loop.index0 }}">{{ 'I' if loop.index0 % 4 == 0 else 'P' }}</span></td>
                    {% endfor %}
                </tr>
                <tr>
                    <td>Spare parts</td>
                    {% for year in range(0, 23) %}
                        <td><span data-field="imp_spare_{{ loop.index0 }}">{{ 'I' if loop.index0 % 5 == 0 else 'P' }}</span></td>
                    {% endfor %}
                </tr>
            </tbody>
        </table>
    </div>
</body>
</html>