        .table-caption { font-size: 10pt; margin-bottom: 10px; font-weight: bold; }
        .footer { position: absolute; bottom: 50px; right: 60px; font-size: 9pt; color: #555; }
    </style>

<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
