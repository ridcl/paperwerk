<body>

<div class="page">
    <div style="text-align: center; margin-top: 100px;">
        <h1 class="header-title">Protection and Control Relay</h1>
        <h2 style="font-size: 20pt;">{{ series_number }} series</h2>
        <h3 style="font-size: 14pt; margin-top: 20px;">Protocol Implementation Conformance Statement for the IEC 61850 interface in {{ series_number }} series</h3>
    </div>
    <!-- Placeholder for image -->
</div>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
        <div style="font-size: 10pt;">1MRS757522 B</div>
        <div style="text-align: right; font-size: 10pt;">{{ series_number }} series</div>
    </div>
    <div style="text-align: center; margin-bottom: 40px;">
        <h2 style="font-size: 14pt;">Protocol Implementation Conformance Statement</h2>
    </div>

    <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
        <div style="width: 50%;">
            <h3 class="section-title">Table of Contents</h3>
            <ul style="list-style: none; padding-left: 0;">
                <li style="margin-bottom: 5px;"><span style="display: inline-block; width: 10%;">1</span> About this document .................................................................... <span style="float: right;">{{ page_number_1 }}</span></li>
                <li style="margin-bottom: 5px;"><span style="display: inline-block; width: 10%;">1.1</span> Read it first! ...................................................................................... <span style="float: right;">{{ page_number_1_1 }}</span></li>
                <li style="margin-bottom: 5px;"><span style="display: inline-block; width: 10%;">1.2</span> Document information ................................................................................ <span style="float: right;">{{ page_number_1_2 }}</span></li>
                <li style="margin-bottom: 5px;"><span style="display: inline-block; width: 10%;">2</span> Safety Information .............................................................................. <span style="float: right;">{{ page_number_2 }}</span></li>
                <li style="margin-bottom: 5px;"><span style="display: inline-block; width: 10%;">3</span> Abbreviations, Definitions and Conventions ..................................... <span style="float: right;">{{ page_number_3 }}</span></li>
                <li style="margin-bottom: 5px;"><span style="display: inline-block; width: 10%;">3.1</span> Abbreviations ........................................................................................ <span style="float: right;">{{ page_number_3_1 }}</span></li>
                <li style="margin-bottom: 5px;"><span style="display: inline-block; width: 10%;">3.2</span> Definitions ............................................................................................ <span style="float: right;">{{ page_number_3_2 }}</span></li>
                <li style="margin-bottom: 5px;"><span style="display: inline-block; width: 10%;">4</span> Reference Documents ............................................................................ <span style="float: right;">{{ page_number_4 }}</span></li>
                <li style="margin-bottom: 5px;"><span style="display: inline-block; width: 10%;">5</span> Introduction ................................................................................................... <span style="float: right;">{{ page_number_5 }}</span></li>
                <li style="margin-bottom: 5px;"><span style="display: inline-block; width: 10%;">5.1</span> Scope of this statement .......................................................................... <span style="float: right;">{{ page_number_5_1 }}</span></li>
                <li style="margin-bottom: 5px;"><span style="display: inline-block; width: 10%;">6</span> ACSI conformance statement ................................................................... <span style="float: right;">{{ page_number_6 }}</span></li>
                <li style="margin-bottom: 5px;"><span style="display: inline-block; width: 10%;">6.1</span> General .................................................................................................... <span style="float: right;">{{ page_number_6_1 }}</span></li>
                <li style="margin-bottom: 5px;"><span style="display: inline-block; width: 10%;">6.2</span> ASCI basic conformance statement ...................................................... <span style="float: right;">{{ page_number_6_2 }}</span></li>
                <li style="margin-bottom: 5px;"><span style="display: inline-block; width: 10%;">6.3</span> ACSI models conformance statement ....................................................... <span style="float: right;">{{ page_number_6_3 }}</span></li>
                <li style="margin-bottom: 5px;"><span style="display: inline-block; width: 10%;">6.4</span> ACSI service conformance statement .................................................... <span style="float: right;">{{ page_number_6_4 }}</span></li>
                <li style="margin-bottom: 5px;"><span style="display: inline-block; width: 10%;">7</span> SCL conformance statement ................................................................... <span style="float: right;">{{ page_number_7 }}</span></li>
                <li style="margin-bottom: 5px;"><span style="display: inline-block; width: 10%;">8</span> PICS – Protocol conformance statement ..................................................... <span style="float: right;">{{ page_number_8 }}</span></li>
                <li style="margin-bottom: 5px;"><span style="display: inline-block; width: 10%;">8.1</span> Profile conformance ............................................................................... <span style="float: right;">{{ page_number_8_1 }}</span></li>
                <li style="margin-bottom: 5px;"><span style="display: inline-block; width: 10%;">8.2</span> MMS Conformance ................................................................................... <span style="float: right;">{{ page_number_8_2 }}</span></li>
                <li style="margin-bottom: 5px;"><span style="display: inline-block; width: 10%;">9</span> PIXIT 14 ................................................................................................... <span style="float: right;">{{ page_number_9 }}</span></li>
                <li style="margin-bottom: 5px;"><span style="display: inline-block; width: 10%;">10</span> Appendix A: Index of Tables ................................................................... <span style="float: right;">{{ page_number_10 }}</span></li>
            </ul>
        </div>
    </div>
    <div class="footer">ABB Oy – Distribution Automation</div>
</div>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
        <div style="font-size: 10pt;">1MRS757522 B</div>
        <div style="text-align: right; font-size: 10pt;">{{ series_number }} series</div>
    </div>
    <div style="text-align: center; margin-bottom: 30px;">
        <h2 class="section-title">1 About this document</h2>
        <h3 class="subsection-title">1.1 Read it first!</h3>
        <p>Before attempting any operation with IED from {{ series_number }} series, read carefully the IED documen- tation first.</p>
        <p>This document is addressed to anyone who needs to interact with {{ series_number }} series and its IEC 61850 features in more detail.</p>

        <h3 class="subsection-title">1.2 Document information</h3>
        <table>
            <thead>
                <tr>
                    <th style="width: 15%;">Revision</th>
                    <th style="width: 25%;">Date</th>
                    <th style="width: 60%;">Note</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>A</td>
                    <td>{{ date_revision_a }}</td>
                    <td>{{ note_revision_a }}</td>
                </tr>
                <tr>
                    <td>B</td>
                    <td>{{ date_revision_b }}</td>
                    <td>{{ note_revision_b }}</td>
                </tr>
            </tbody>
        </table>

        <h3 class="subsection-title">Applicability</h3>
        <p>This manual is applicable to all {{ series_number }} series Protection and Control IED ver- sions mentioned in Document Revision History above or newer versions if doc- ument update is not required.</p>
    </div>
    <div class="footer">ABB Oy – Distribution Automation</div>
</div>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
        <div style="font-size: 10pt;">1MRS757522 B</div>
        <div style="text-align: right; font-size: 10pt;">{{ series_number }} series</div>
    </div>
    <div style="text-align: center; margin-bottom: 30px;">
        <h2 class="section-title">2 Safety Information</h2>
    </div>
    <p>There are safety warnings and notes in the following text. They are in a different for- mat to distinguish them from normal text.</p>

    <h3 class="subsection-title">Safety warning</h3>
    <p>The safety warnings should always be observed. Non-observance can result in death, personal injury or substantial damages to property. Guarantee claims might not be accepted when safety warnings are not respected. They look like below:</p>

    <div style="display: flex; align-items: center; margin: 20px 0;">
        <div style="background-color: #ff4d4d; color: white; border-radius: 50%; width: 30px; height: 30px; display: flex; justify-content: center; align-items: center; font-weight: bold; margin-right: 15px;">STOP</div>
        <p style="font-weight: bold;">Do not make any changes to the {{ series_number }} series configuration unless you are familiar with the {{ series_number }} series and its configuration tool. This might result in disoperation and loss of warranty.</p>
    </div>

    <h3 class="subsection-title">Note</h3>
    <p>A note contains additional information worth noting in the specific context, and looks like below:</p>

    <div style="display: flex; align-items: center; margin: 20px 0;">
        <div style="background-color: #ffc107; color: black; border-radius: 50%; width: 30px; height: 30px; display: flex; justify-content: center; align-items: center; font-weight: bold; margin-right: 15px;">!</div>
        <p>The selection of this control mode requires caution, because opera- tions are allowed both from the HMI and remotely.</p>
    </div>
    <div class="footer">ABB Oy – Distribution Automation</div>
</div>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
        <div style="font-size: 10pt;">1MRS757522 B</div>
        <div style="text-align: right; font-size: 10pt;">{{ series_number }} series</div>
    </div>
    <div style="text-align: center; margin-bottom: 30px;">
        <h2 class="section-title">3 Abbreviations, Definitions and Conventions</h2>
    </div>

    <h3 class="subsection-title">3.1 Abbreviations</h3>
    <table>
        <thead>
            <tr>
                <th style="width: 30%;">Abbreviation</th>
                <th style="width: 70%;">Definition</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>HMI</td>
                <td>Human Machine Interface</td>
            </tr>
            <tr>
                <td>LCD</td>
                <td>Liquid Crystal Display</td>
            </tr>
            <tr>
                <td>SLD</td>
                <td>Single Line Diagram</td>
            </tr>
            <tr>
                <td>LED</td>
                <td>Light Emitting Diode</td>
            </tr>
            <tr>
                <td>GPS</td>
                <td>Global Positioning System</td>
            </tr>
            <tr>
                <td>SCADA</td>
                <td>Supervision, Control and Data Acquisition</td>
            </tr>
            <tr>
                <td>CT</td>
                <td>Current Transformer</td>
            </tr>
            <tr>
                <td>VT</td>
                <td>Voltage Transformer</td>
            </tr>
            <tr>
                <td>SI</td>
                <td>Sensor Input</td>
            </tr>
            <tr>
                <td>Y</td>
                <td>Yes</td>
            </tr>
            <tr>
                <td>N</td>
                <td>No</td>
            </tr>
        </tbody>
    </table>

    <h3 class="subsection-title">3.2 Definitions</h3>
    <table>
        <thead>
            <tr>
                <th style="width: 30%;">Term</th>
                <th style="width: 70%;">Definition</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Operational State:</td>
                <td>the unit is active and it is protecting and controlling the switch- gear.</td>
            </tr>
            <tr>
                <td>Stand-alone:</td>
                <td>the unit is not connected to a Scada system.</td>
            </tr>
            <tr>
                <td>M/m:</td>
                <td>mandatory support. The item shall be implemented.</td>
            </tr>
            <tr>
                <td>C/c:</td>
                <td>conditional support. The item shall be implemented if the stated condition exists.</td>
            </tr>
            <tr>
                <td>O/o:</td>
                <td>optional support. The implementation may decide to implement the item.</td>
            </tr>
            <tr>
                <td>x:</td>
                <td>excluded: The implementation shall not implement this item.</td>
            </tr>
            <tr>
                <td>i:</td>
                <td>out-of-scope: The implementation of the item is not within the scope of this product.</td>
            </tr>
            <tr>
                <td>F/S:</td>
                <td>Functional Standard. Should be applied.</td>
            </tr>
            <tr>
                <td>Base:</td>
                <td>Shall be applied in any application claiming conformance to this standard.</td>
            </tr>
        </tbody>
    </table>
    <div class="footer">ABB Oy – Distribution Automation</div>
</div>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
        <div style="font-size: 10pt;">1MRS757522 B</div>
        <div style="text-align: right; font-size: 10pt;">{{ series_number }} series</div>
    </div>
    <div style="text-align: center; margin-bottom: 30px;">
        <h2 class="section-title">4 Reference Documents</h2>
    </div>
    <table>
        <thead>
            <tr>
                <th style="width: 5%;">Ref</th>
                <th style="width: 20%;">Document id</th>
                <th style="width: 15%;">Rev</th>
                <th style="width: 60%;">Communication networks and systems in substa- tions - Part {{ ref_part_number }}</th>
            </tr>
        </thead>
        <tbody>
            {% for doc in reference_documents %}
            <tr>
                <td>[{{ loop.index0 + 1 }}]</td>
                <td>{{ doc.document_id }}</td>
                <td>{{ doc.revision }}</td>
                <td>{{ doc.title }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    <div class="footer">ABB Oy – Distribution Automation</div>
</div>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
        <div style="font-size: 10pt;">1MRS757522 B</div>
        <div style="text-align: right; font-size: 10pt;">{{ series_number }} series</div>
    </div>
    <div style="text-align: center; margin-bottom: 30px;">
        <h2 class="section-title">5 Introduction</h2>
    </div>
    <p>This document defines the compliance to IEC 61850 in terms of service, modeling and engineering interfaces. Also, exceptions and local adaptations are described.</p>
    <p>The conformance statements and documents are referred as PICS (Protocol Imple- mentation Conformance Statement), MICS (Model Implementation Conformance Statement) and local adaptations to be published are described in PIXIT (Protocol Implementation Extra Information for Testing). ACSI conformance statement de- scribes the abstract services interfaces, which are normally mapped to certain SCSM and therefore indirectly stated in PICS.</p>
    <p>The purpose of the information in this document is to give a user, to a system integra- tor a detailed explanation of IEC 61850 capabilities of a product.</p>

    <h3 class="subsection-title">5.1 Scope of this statement</h3>
    <p>The scope of this document is one product/software module. This is identified as fol- lows:</p>
    <ul>
        <li>Product family / name: {{ product_family_name }}</li>
        <li>Product designation: {{ product_designation }}</li>
        <li>Role(s) in two-party association (TP, c/s): Server</li>
        <li>Role(s) in multicast association (MC, GOOSE, GSSE): GOOSE</li>
        <li>Notes, exceptions: MMS conformance statement is not filled</li>
    </ul>
    <div class="footer">ABB Oy – Distribution Automation</div>
</div>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
        <div style="font-size: 10pt;">1MRS757522 B</div>
        <div style="text-align: right; font-size: 10pt;">{{ series_number }} series</div>
    </div>
    <div style="text-align: center; margin-bottom: 30px;">
        <h2 class="section-title">6 ACSI conformance statement</h2>
    </div>

    <h3 class="subsection-title">6.1 General</h3>
    <p>These tables are according to 7-2. [3]</p>

    <h3 class="subsection-title">6.2 ASCI basic conformance statement</h3>
    <div class="table-caption">Table 6-1– Basic conformance statement</div>
    <table>
        <thead>
            <tr>
                <th style="width: 20%;">Client-Server roles</th>
                <th style="width: 20%;">Client/ Subscriber</th>
                <th style="width: 20%;">Server/ Publisher</th>
                <th style="width: 40%;">Value/Comments</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>B11</td>
                <td>—</td>
                <td>Y</td>
                <td></td>
            </tr>
            <tr>
                <td>B12</td>
                <td>N</td>
                <td>—</td>
                <td></td>
            </tr>
        </tbody>
    </table>

    <h3 class="subsection-title">SCSMs supported</h3>
    <table>
        <thead>
            <tr>
                <th style="width: 20%;">ID</th>
                <th style="width: 50%;">Description</th>
                <th style="width: 20%;">Conformance</th>
            </tr>
        </thead>
        <tbody>
            {% for scsm in scsm_list %}
            <tr>
                <td>{{ scsm.id }}</td>
                <td>{{ scsm.description }}</td>
                <td>{{ scsm.conformance }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <h3 class="subsection-title">Generic substation event model (GSE)</h3>
    <table>
        <thead>
            <tr>
                <th style="width: 20%;">ID</th>
                <th style="width: 50%;">Description</th>
                <th style="width: 20%;">Conformance</th>
            </tr>
        </thead>
        <tbody>
            {% for gse in gse_list %}
            <tr>
                <td>{{ gse.id }}</td>
                <td>{{ gse.description }}</td>
                <td>{{ gse.conformance }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <h3 class="subsection-title">Transmission of sampled value model (SVC)</h3>
    <table>
        <thead>
            <tr>
                <th style="width: 20%;">ID</th>
                <th style="width: 50%;">Description</th>
                <th style="width: 20%;">Conformance</th>
            </tr>
        </thead>
        <tbody>
            {% for svc in svc_list %}
            <tr>
                <td>{{ svc.id }}</td>
                <td>{{ svc.description }}</td>
                <td>{{ svc.conformance }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    <div class="footer">ABB Oy – Distribution Automation</div>
</div>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
        <div style="font-size: 10pt;">1MRS757522 B</div>
        <div style="text-align: right; font-size: 10pt;">{{ series_number }} series</div>
    </div>
    <div style="text-align: center; margin-bottom: 30px;">
        <h2 class="section-title">6.3 ACSI models conformance statement</h2>
    </div>
    <div class="table-caption">Table 6-2– ACSI models conformance statement</div>
    <table>
        <thead>
            <tr>
                <th style="width: 20%;">If Server side (B1) supported</th>
                <th style="width: 20%;">Client/ Subscriber</th>
                <th style="width: 20%;">Server/ Publisher</th>
                <th style="width: 40%;">Value/Comments</th>
            </tr>
        </thead>
        <tbody>
            {% for model in model_list %}
            <tr>
                <td>{{ model.id }}</td>
                <td>{{ model.client_conformance }}</td>
                <td>{{ model.server_conformance }}</td>
                <td>{{ model.value_comments }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <h3 class="subsection-title">If GSE (B31/32) is supported</h3>
    <table>
        <thead>
            <tr>
                <th style="width: 20%;">ID</th>
                <th style="width: 20%;">Client/ Subscriber</th>
                <th style="width: 20%;">Server/ Publisher</th>
                <th style="width: 40%;">Value/Comments</th>
            </tr>
        </thead>
        <tbody>
            {% for gse_model in gse_model_list %}
            <tr>
                <td>{{ gse_model.id }}</td>
                <td>{{ gse_model.client_conformance }}</td>
                <td>{{ gse_model.server_conformance }}</td>
                <td>{{ gse_model.value_comments }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <h3 class="subsection-title">If SVC (41/42) is supported</h3>
    <table>
        <thead>
            <tr>
                <th style="width: 20%;">ID</th>
                <th style="width: 20%;">Client/ Subscriber</th>
                <th style="width: 20%;">Server/ Publisher</th>
                <th style="width: 40%;">Value/Comments</th>
            </tr>
        </thead>
        <tbody>
            {% for svc_model in svc_model_list %}
            <tr>
                <td>{{ svc_model.id }}</td>
                <td>{{ svc_model.client_conformance }}</td>
                <td>{{ svc_model.server_conformance }}</td>
                <td>{{ svc_model.value_comments }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    <div class="footer">ABB Oy – Distribution Automation</div>
</div>


