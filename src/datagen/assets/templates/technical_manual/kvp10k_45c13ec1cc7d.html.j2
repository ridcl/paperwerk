<!DOCTYPE html>
<html>
<head>
    <title>Document Conversion</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3, h4 { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; margin-bottom: 15px; }
        td, th { border: 1px solid #ccc; padding: 8px; text-align: left; }
        .header-title { font-size: 24pt; font-weight: bold; }
        .section-title { font-size: 14pt; font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
