        .diagram-box { width: 48%; text-align: center; }
        .part-label { font-size: 10pt; font-weight: bold; }
        .note { font-size: 9pt; margin-top: 15px; }
        .footer { position: absolute; bottom: 50px; right: 60px; font-size: 9pt; }
