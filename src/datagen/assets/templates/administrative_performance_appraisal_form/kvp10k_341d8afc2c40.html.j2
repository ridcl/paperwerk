    <tbody>
      {% for i in range(1, 6) %}
      <tr>
        <td>{{ i }}. <span data-field="annual_goals[{{ loop.index0 }}].goal_description" style="font-size: 12px;">{{ annual_goals[loop.index0].goal_description }}</span></td>
        <td><span data-field="annual_goals[{{ loop.index0 }}].comments" style="min-height: 50px;">{{ annual_goals[loop.index0].comments }}</span></td>
      </tr>
      {% endfor %}
      <tr>
        <td colspan="2" style="text-align: right; font-weight: bold;">Annual Goal Rating</td>
      </tr>
    </tbody>
  </table>

  <div style="margin-top: 30px;">
    <p style="font-size: 12px;">How do these goals relate to the overall organizational goals? (Implementation phase)</p>
    <div style="border: 1px solid #000; height: 80px; margin-top: 5px;"></div>
  </div>

  <div style="margin-top: 20px;">
    <p style="font-size: 12px;">What problems/challenges are anticipated in reaching these goals? (Implementation phase)</p>
    <div style="border: 1px solid #000; height: 80px; margin-top: 5px;"></div>
  </div>
</div>

<div class="page">
  <div class="header-logo">
    <!-- Placeholder for logo -->
    <div style="font-size: 24px; font-weight: bold;">FOOTHILL-DE ANZA</div>
    <div style="font-size: 12px;">Community College District</div>
