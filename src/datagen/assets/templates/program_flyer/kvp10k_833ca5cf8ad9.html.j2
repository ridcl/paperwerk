<!DOCTYPE html>
<html>
<head>
<title>Program</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
    margin: 0;
    padding: 0;
  }
</style>
</head>
<body>
<div class="page">
  <p style="text-align: center; font-size: 14pt;">The Department of Music Presents</p>
  <h1 style="text-align: center; font-size: 72pt; margin: 40px 0;">A Season of</h1>
  <h1 style="text-align: center; font-size: 120pt; margin: 0;">Renewal</h1>
  <h2 style="text-align: center; font-size: 36pt; margin: 40px 0;">Davenport Resident</h2>
  <h2 style="text-align: center; font-size: 36pt; margin: 10px 0;">{{ full_name }}</h2>
  <h2 style="text-align: center; font-size: 36pt; margin: 10px 0;">LECTURE</h2>
  <p style="text-align: center; font-size: 18pt; margin: 20px 0;">Shepard Recital Hall</p>
  <div style="text-align: center; margin-top: 50px;">
    <p style="font-size: 24pt; margin: 0;">Tuesday February 1</p>
    <p style="font-size: 24pt; margin: 5px 0;">7:30pm</p>
  </div>
  <div style="text-align: center; margin-top: 50px;">
    <img src="placeholder_sunflower.jpg" alt="Sunflower" style="max-width: 100%; height: auto;">
    <p style="font-size: 24pt; margin-top: 20px;">PROGRAM</p>
  </div>
</div>

<div class="page">
  <h2 style="font-size: 24pt; margin-bottom: 10px;">2022 Davenport Artist {{ full_name }}</h2>
  <h3 style="font-size: 20pt; margin-top: 0;">Artist Talk</h3>
  <p style="font-size: 12pt; line-height: 1.6;">
    {{ bio_paragraph_1 }}
  </p>
  <p style="font-size: 12pt; line-height: 1.6;">
    {{ bio_paragraph_2 }}
  </p>
  <div style="text-align: center; margin-top: 40px;">
    <img src="placeholder_sunflower_2.jpg" alt="Sunflower" style="max-width: 100%; height: auto;">
  </div>
</div>

<div class="page">
  <div style="text-align: center; margin-top: 100px;">
    <p style="font-size: 14pt;">Please visit <a href="http://newpaltz.edu/music/concert-series" style="color: #000;">{{ website_url }}</a> to view our upcoming Concert Series events. Enjoy the show!</p>
  </div>
  <div style="border: 1px solid #ccc; padding: 30px; margin-top: 50px;">
    <p style="font-size: 14pt; margin-bottom: 15px;">Your generous contributions support Department of Music programs.</p>
    <p style="font-size: 12pt; line-height: 1.6;">
      Make your tax-deductible gift today at <a href="http://newpaltz.edu/gift" style="color: #000;">{{ donation_url }}</a>, or send your check, made payable to the SUNY New Paltz Foundation and marked for Music to:
    </p>
    <p style="font-size: 12pt; line-height: 1.6; margin-top: 10px;">
      SUNY New Paltz Foundation<br>
      1 Hawk Drive<br>
      New Paltz, NY 12561
    </p>
  </div>
</div>
</body>
</html>