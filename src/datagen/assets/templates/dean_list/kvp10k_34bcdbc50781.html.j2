<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  h1, h2, h3 {
    font-weight: bold;
    margin-top: 0;
  }
  .section-title {
    font-weight: bold;
    margin-top: 15px;
    margin-bottom: 5px;
  }
  .honor-entry {
    margin-bottom: 10px;
  }
  .honor-label {
    font-weight: bold;
    display: inline-block;
    width: 100px; /* Adjust as needed for alignment */
  }
  .honor-value {
    display: inline-block;
    margin-left: 5px;
  }
  .list-item {
    margin-left: 20px;
    font-size: 0.95em;
  }
</style>

<div class="page">
  <header>
    <h1>UNIVERSITY OF NEW HAMPSHIRE</h1>
    <h2>Dean's List for Term {{ term_year }} - {{ state_abbreviation }}</h2>
  </header>

  <section>
    <h3 class="section-title">State of {{ state_name }} Dean's List</h3>

    <div class="honor-entry">
      <div class="section-title">{{ location_name }}</div>
      <div class="honor-entry">
        <span class="honor-label">Highest Honors:</span>
        <span class="honor-value">{{ highest_honors_list }}</span>
      </div>
      <div class="honor-entry">
        <span class="honor-label">Honors:</span>
        <span class="honor-value">{{ honors_list }}</span>
      </div>
    </div>
  </section>
</div>

