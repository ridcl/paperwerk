<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1 { text-align: center; font-weight: bold; margin-bottom: 30px; }
  h2 { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 15px; }
  .form-row > div { width: 48%; }
  .line-input { border-bottom: 1px solid #000; width: 100%; margin-top: 5px; }
</style>

<div class="page">
  <h1>APPLICATION FOR SPECIAL LOAN PRIVILEGES</h1>

  <h2>A. TO BE COMPLETED BY FACULTY SPONSOR.</h2>

  <div class="form-row">
    <div>
      Last Name: <span class="line-input" data-field="application_for_special_loan_privileges">{{ application_for_special_loan_privileges }}</span>
    </div>
    <div>
      First Name: <span class="line-input" data-field="last_name">{{ last_name }}</span>
    </div>
  </div>

  <div class="form-row">
    <div>
      Please Print Applicant's Name: <span class="line-input" data-field="first_name">{{ first_name }}</span>
    </div>
    <div>
      Expiration Date for Loan Privileges: <span class="line-input" data-field="please_print_applicant_s_name">{{ please_print_applicant_s_name }}</span>
    </div>
  </div>

  <div class="form-row">
    <div>
      Faculty Sponsor's Name (printed): <span class="line-input" data-field="expiration_date_for_loan_privileges">{{ expiration_date_for_loan_privileges }}</span>
    </div>
    <div>
      Faculty Sponsor's Signature: <span class="line-input" data-field="faculty_sponsor_s_name">{{ faculty_sponsor_s_name }}</span>
    </div>
  </div>

  <div class="form-row">
    <div>
      Sponsor Phone: <span class="line-input" data-field="faculty_sponsor_s_signature">{{ faculty_sponsor_s_signature }}</span>
    </div>
    <div>
      Date: <span class="line-input" data-field="sponsor_phone">{{ sponsor_phone }}</span>
    </div>
  </div>

  <div style="margin-top: 30px;">
    REASON FOR SPECIAL LOAN PRIVILEGES:
    <div class="line-input" style="height: 80px; margin-top: 5px;" data-field="date">{{ date }}</div>
  </div>

  <h2>B. TO BE COMPLETED BY THE APPLICANT</h2>

  <div class="form-row">
    <div>
      Name: <span class="line-input" data-field="reason_for_special_loan_privileges">{{ reason_for_special_loan_privileges }}</span>
    </div>
    <div>
      Phone: <span class="line-input" data-field="name">{{ name }}</span>
    </div>
  </div>

  <div class="form-row">
    <div>
      Street Address: <span class="line-input" data-field="phone">{{ phone }}</span>
    </div>
    <div>
      City, State, Zip: <span class="line-input" data-field="street_address_2">{{ street_address_2 }}</span>
    </div>
  </div>

  <div class="form-row">
    <div>
      E-Mail: <span class="line-input" data-field="city_state_zip_2">{{ city_state_zip_2 }}</span>
    </div>
    <div>
      <!-- Empty space or placeholder if needed -->
    </div>
  </div>

  <div style="margin-top: 50px; font-size: 0.9em;">
    Completed form may be delivered in person, mailed, or faxed to:
    <div style="margin-top: 10px;">
      <span data-field="department_name">{{ department_name }}</span><br>
      <span data-field="street_address">{{ street_address }}</span><br>
      <span data-field="city_state_zip">{{ city_state_zip }}</span><br>
      Phone (<span data-field="phone_number">{{ phone_number }}</span>): <span data-field="phone_number_2">{{ phone_number_2 }}</span><br>
      Fax (<span data-field="fax_number">{{ fax_number }}</span>): <span data-field="fax_number_2">{{ fax_number_2 }}</span>
    </div>
  </div>
</div>