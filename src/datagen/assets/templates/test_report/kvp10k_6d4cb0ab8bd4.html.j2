<!DOCTYPE html>
<html>
<head>
<title>Benchmark Analytics Report</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  td, th {
    padding: 8px;
    text-align: left;
  }
  .header-section {
    display: flex;
    justify-content: space-between;
    margin-bottom: 30px;
  }
  .info-block {
    width: 48%;
  }
  .signature-block {
    margin-top: 60px;
    display: flex;
    justify-content: space-between;
  }
  .signature-line {
    width: 40%;
    border-top: 1px solid black;
    padding-top: 5px;
    text-align: center;
  }
</style>
</head>
<body>

<div class="page">
  <div class="header-section">
    <div class="info-block">
      <h1>Benchmark Analytics, Inc.</h1>
      <p>4777 Saucon Creek Road</p>
      <p>Center Valley, PA 18034</p>
      <p>Phone: {{ company.phone }}</p>
      <p>Fax: {{ company.fax }}</p>
    </div>
    <div class="info-block" style="text-align: right;">
      <p>Work Order: <span data-field="work_order_number">{{ work_order_number }}</span></p>
    </div>
  </div>

  <div style="display: flex; justify-content: space-between; margin-bottom: 40px;">
    <div style="width: 45%;">
      <p>SEND DATA TO:</p>
      <p>NAME: <span data-field="client.full_name">{{ client.full_name }}</span></p>
      <p>COMPANY: <span data-field="client.company">{{ client.company }}</span></p>
      <p>ADDRESS: <span data-field="client.address">{{ client.address }}</span></p>
    </div>
    <div style="width: 45%; text-align: right;">
      <p>WO#: <span data-field="wo_number">{{ wo_number }}</span></p>
      <p>PAGE: 1 of 2</p>
      <p>PO#: <span data-field="po_number">{{ po_number }}</span></p>
      <p>PWS ID#: <span data-field="pws_id">{{ pws_id }}</span></p>
    </div>
  </div>

  <h2 style="text-align: center; margin-bottom: 30px;">TEST REPORT</h2>

  <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
    <div style="width: 30%;">
      <p>OVERFLOW LOT B</p>
      <p>RECEIVED FOR LAB BY: <span data-field="received_by_name">{{ received_by_name }}</span></p>
    </div>
    <div style="width: 30%;">
      <p>DATE: <span data-field="test_date">{{ test_date }}</span></p>
      <p>LAB ID: <span data-field="lab_id">{{ lab_id }}</span></p>
    </div>
    <div style="width: 30%; text-align: right;">
      <p>Page 1 of 2</p>
    </div>
  </div>

  <h3 style="margin-top: 30px;">SAMPLE: <span data-field="sample_description_1">{{ sample_description_1 }}</span></h3>
  <p>SAMPLED BY: <span data-field="sampled_by_name_1">{{ sampled_by_name_1 }}</span></p>

  <table>
    <thead>
      <tr>
        <th>Test</th>
        <th>Result</th>
        <th>Method</th>
        <th>Reg. Limit</th>
        <th>Analysis Start</th>
        <th>Analysis End</th>
        <th>Analyst*</th>
      </tr>
    </thead>
    <tbody>
      {% for item in test_results_1 %}
      <tr>
        <td><span data-field="test_results_1[{{ loop.index0 }}].test_name">{{ item.test_name }}</span></td>
        <td><span data-field="test_results_1[{{ loop.index0 }}].result">{{ item.result }}</span></td>
        <td><span data-field="test_results_1[{{ loop.index0 }}].method">{{ item.method }}</span></td>
        <td><span data-field="test_results_1[{{ loop.index0 }}].reg_limit">{{ item.reg_limit }}</span></td>
        <td><span data-field="test_results_1[{{ loop.index0 }}].analysis_start">{{ item.analysis_start }}</span></td>
        <td><span data-field="test_results_1[{{ loop.index0 }}].analysis_end">{{ item.analysis_end }}</span></td>
        <td><span data-field="test_results_1[{{ loop.index0 }}].analyst">{{ item.analyst }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <h3 style="margin-top: 30px;">SAMPLE: <span data-field="sample_description_2">{{ sample_description_2 }}</span></h3>
  <p>SAMPLED BY: <span data-field="sampled_by_name_2">{{ sampled_by_name_2 }}</span></p>

  <table>
    <thead>
      <tr>
        <th>Test</th>
        <th>Result</th>
        <th>Method</th>
        <th>Reg. Limit</th>
        <th>Analysis Start</th>
        <th>Analysis End</th>
        <th>Analyst*</th>
      </tr>
    </thead>
    <tbody>
      {% for item in test_results_2 %}
      <tr>
        <td><span data-field="test_results_2[{{ loop.index0 }}].test_name">{{ item.test_name }}</span></td>
        <td><span data-field="test_results_2[{{ loop.index0 }}].result">{{ item.result }}</span></td>
        <td><span data-field="test_results_2[{{ loop.index0 }}].method">{{ item.method }}</span></td>
        <td><span data-field="test_results_2[{{ loop.index0 }}].reg_limit">{{ item.reg_limit }}</span></td>
        <td><span data-field="test_results_2[{{ loop.index0 }}].analysis_start">{{ item.analysis_start }}</span></td>
        <td><span data-field="test_results_2[{{ loop.index0 }}].analysis_end">{{ item.analysis_end }}</span></td>
        <td><span data-field="test_results_2[{{ loop.index0 }}].analyst">{{ item.analyst }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div style="margin-top: 50px;">
    <p>REMARKS:</p>
    <p><span data-field="remarks_text">{{ remarks_text }}</span></p>
  </div>

  <div class="signature-block">
    <div style="width: 45%;">
      <p>MANAGER</p>
      <div class="signature-line"></div>
    </div>
    <div style="width: 45%; text-align: right;">
      <p>DATE: <span data-field="report_date">{{ report_date }}</span></p>
    </div>
  </div>
</div>

<div class="page">
  <!-- This page structure is based on the third image, which is a different document type (Chain of Custody) -->
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px;">
    <div style="width: 50%;">
      <h1 style="text-align: center;">CHAIN OF CUSTODY</h1>
      <div style="text-align: center; margin-top: 20px;">
        <p>WO#: <span data-field="chain_of_custody_wo_number">{{ chain_of_custody_wo_number }}</span></p>
        <p>PAGE 1 OF 1</p>
      </div>
    </div>
    <div style="width: 45%; text-align: right;">
      <p>Benchmark Analytics, Inc.</p>
      <p>4777 Saucon Creek Road</p>
      <p>Center Valley, PA 18034</p>
      <p>Phone: {{ company.phone }}</p>
      <p>Fax: {{ company.fax }}</p>
    </div>
  </div>

  <table style="margin-top: 30px;">
    <thead>
      <tr>
        <th style="width: 10%;">Date</th>
        <th style="width: 20%;">Time</th>
        <th style="width: 30%;">From</th>
        <th style="width: 20%;">To</th>
        <th style="width: 20%;">Signature</th>
      </tr>
    </thead>
    <tbody>
      {% for item in custody_log %}
      <tr>
        <td><span data-field="custody_log[{{ loop.index0 }}].date">{{ item.date }}</span></td>
        <td><span data-field="custody_log[{{ loop.index0 }}].time">{{ item.time }}</span></td>
        <td><span data-field="custody_log[{{ loop.index0 }}].from_name">{{ item.from_name }}</span></td>
        <td><span data-field="custody_log[{{ loop.index0 }}].to_name">{{ item.to_name }}</span></td>
        <td><span data-field="custody_log[{{ loop.index0 }}].signature">{{ item.signature }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div style="margin-top: 50px;">
    <p>MATRIX *</p>
    <p>Volume of Sample</p>
    <p>Preservatives</p>
    <p>No. of Containers</p>
    <p>Turn Around Time</p>
  </div>

  <table style="margin-top: 30px;">
    <thead>
      <tr>
        <th style="width: 10%;">Fraction</th>
        <th style="width: 30%;">Sample</th>
      </tr>
    </thead>
    <tbody>
      {% for item in sample_details %}
      <tr>
        <td><span data-field="sample_details[{{ loop.index0 }}].fraction">{{ item.fraction }}</span></td>
        <td><span data-field="sample_details[{{ loop.index0 }}].sample_name">{{ item.sample_name }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

</div>

</body>
</html>