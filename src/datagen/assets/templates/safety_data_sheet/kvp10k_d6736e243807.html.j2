<!DOCTYPE html>
<html>
<head>
    <title>EC Safety Data Sheet</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3, h4 { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; margin-bottom: 10px; }
        td, th { padding: 6px 0; text-align: left; vertical-align: top; }
        .header-row th { border-bottom: 1px solid #000; }
        .section-title { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
        .sub-section-title { font-weight: bold; margin-top: 15px; margin-bottom: 5px; }
        .label { font-weight: normal; }
    </style>

<style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 { font-family: "DejaVu Sans", "Liberation Sans", Arial, Helvetica, sans-serif; }
        .header-info { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 20px; }
        .section-title { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
        .subsection-title { font-weight: bold; margin-top: 15px; margin-bottom: 5px; }
        .data-table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        .data-table td { padding: 5px 0; }
        .footer { position: absolute; bottom: 50px; width: 100%; text-align: center; font-size: 10px; color: #555; }
    </style>
</head>
<body>
    <div class="page">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px;">
            <h1 style="font-size: 24pt; margin: 0;">EC safety data sheet</h1>
            <div style="font-size: 18pt; font-weight: bold;">ABB</div>
        </div>
        <div style="margin-bottom: 20px;">
            <p>Trade name: <span data-field="trade_name">{{ trade_name }}</span></p>
            <p>Current version: <span data-field="current_version">{{ current_version }}</span>, issued: <span data-field="current_date">{{ current_date }}</span></p>
            <p>Replaced version: <span data-field="replaced_version">{{ replaced_version }}</span>, issued: <span data-field="replaced_date">{{ replaced_date }}</span></p>
            <p>Region: <span data-field="region">{{ region }}</span></p>
        </div>

        <div class="section-title">SECTION 1: Identification of the substance/mixture and of the company/undertaking</div>

        <div class="sub-section-title">1.1 Product identifier</div>
        <p>Trade name: <span data-field="product_trade_name">{{ product_trade_name }}</span></p>

        <div class="sub-section-title">1.2 Relevant identified uses of the substance or mixture and uses advised against</div>
        <p>Relevant identified uses of the substance or mixture</p>
        <ul>
            <li><span data-field="use_description_1">{{ use_description_1 }}</span></li>
            <li><span data-field="use_description_2">{{ use_description_2 }}</span></li>
            <li><span data-field="use_description_3">{{ use_description_3 }}</span></li>
        </ul>
        <p>Uses advised against</p>
        <p><span data-field="uses_advised_against">{{ uses_advised_against }}</span></p>

        <div class="sub-section-title">1.3 Details of the supplier of the safety data sheet</div>
        <p>Address</p>
        <p><span data-field="supplier_address_line_1">{{ supplier_address_line_1 }}</span></p>
        <p><span data-field="supplier_city">{{ supplier_city }}</span></p>
        <p><span data-field="supplier_country">{{ supplier_country }}</span></p>
        <p><span data-field="supplier_country_detail">{{ supplier_country_detail }}</span></p>
        <p>Telephone no.: <span data-field="supplier_phone">{{ supplier_phone }}</span></p>
        <p>Fax no.: <span data-field="supplier_fax">{{ supplier_fax }}</span></p>
        <p>E-mail: <span data-field="supplier_email">{{ supplier_email }}</span></p>
        <p>Advice on Safety Data Sheet</p>
        <p><span data-field="sds_advice_url">{{ sds_advice_url }}</span></p>

        <div class="sub-section-title">1.4 Emergency telephone number</div>
        <p><span data-field="emergency_phone">{{ emergency_phone }}</span></p>
    </div>

    <div class="page">
        <div class="section-title">SECTION 2: Hazards identification</div>

        <div class="sub-section-title">2.1 Classification of the substance or mixture</div>
        <p>Classification information</p>
        <p><span data-field="classification_statement">{{ classification_statement }}</span></p>

        <div class="sub-section-title">2.2 Label elements</div>
        <p><span data-field="label_elements">{{ label_elements }}</span></p>

        <div class="sub-section-title">2.3 Other hazards</div>
        <p>PBT assessment</p>
        <p><span data-field="pbt_assessment">{{ pbt_assessment }}</span></p>
        <p>vPvB assessment</p>
        <p><span data-field="vvpb_assessment">{{ vvpb_assessment }}</span></p>
    </div>

    <div class="page">
        <div class="section-title">SECTION 3: Composition/information on ingredients</div>

        <div class="sub-section-title">3.1 Substances</div>
        <p><span data-field="substance_status">{{ substance_status }}</span></p>

        <div class="sub-section-title">3.2 Mixtures</div>
        <p>Hazardous ingredients</p>
        <table>
            <thead>
                <tr class="header-row">
                    <th style="width: 10%;">No</th>
                    <th style="width: 30%;">Substance name</th>
                    <th style="width: 30%;">CAS / EC / Index / REACH no</th>
                    <th style="width: 20%;">Classification (EC) 1272/2008 (CLP)</th>
                    <th style="width: 10%;">Additional information</th>
                    <th style="width: 10%;">%</th>
                </tr>
            </thead>
            <tbody>
                {% for item in line_items %}
                <tr>
                    <td><span data-field="line_items[{{ loop.index0 }}].no">{{ item.no }}</span></td>
                    <td><span data-field="line_items[{{ loop.index0 }}].description">{{ item.description }}</span></td>
                    <td><span data-field="line_items[{{ loop.index0 }}].cas_ec_reach">{{ item.cas_ec_reach }}</span></td>
                    <td><span data-field="line_items[{{ loop.index0 }}].classification">{{ item.classification }}</span></td>
                    <td><span data-field="line_items[{{ loop.index0 }}].additional_info">{{ item.additional_info }}</span></td>
                    <td><span data-field="line_items[{{ loop.index0 }}].percentage">{{ item.percentage }}</span></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="page">
        <div class="section-title">SECTION 4: First aid measures</div>

        <div class="sub-section-title">4.1 Description of first aid measures</div>
        <p>General information</p>
        <p><span data-field="first_aid_general">{{ first_aid_general }}</span></p>
        <p>After inhalation</p>
        <p><span data-field="first_aid_inhalation">{{ first_aid_inhalation }}</span></p>
        <p>After skin contact</p>
        <p><span data-field="first_aid_skin">{{ first_aid_skin }}</span></p>
        <p>After eye contact</p>
        <p><span data-field="first_aid_eye">{{ first_aid_eye }}</span></p>
        <p>After ingestion</p>
        <p><span data-field="first_aid_ingestion">{{ first_aid_ingestion }}</span></p>

        <div class="sub-section-title">4.2 Most important symptoms and effects, both acute and delayed</div>
        <p><span data-field="symptoms_effects">{{ symptoms_effects }}</span></p>

        <div class="sub-section-title">4.3 Indication of any immediate medical attention and special treatment needed</div>
        <p><span data-field="medical_attention">{{ medical_attention }}</span></p>
    </div>

    <div class="page">
        <div class="section-title">SECTION 5: Firefighting measures</div>

        <div class="sub-section-title">5.1 Extinguishing media</div>
        <p>Suitable extinguishing media</p>
        <p><span data-field="extinguishing_media_suitable">{{ extinguishing_media_suitable }}</span></p>
        <p>Unsuitable extinguishing media</p>
        <p><span data-field="extinguishing_media_unsuitable">{{ extinguishing_media_unsuitable }}</span></p>

        <div class="sub-section-title">5.2 Special hazards arising from the substance or mixture</div>
        <p><span data-field="special_hazards">{{ special_hazards }}</span></p>
    </div>

    <div class="page">
        <div class="section-title">SECTION 6: Accidental release measures</div>

        <div class="sub-section-title">6.1 Personal precautions, protective equipment and emergency procedures</div>
        <p>For non-emergency personnel</p>
        <p><span data-field="precautions_non_emergency">{{ precautions_non_emergency }}</span></p>
        <p>For emergency responders</p>
        <p><span data-field="precautions_emergency">{{ precautions_emergency }}</span></p>

        <div class="sub-section-title">6.2 Environmental precautions</div>
        <p><span data-field="environmental_precautions">{{ environmental_precautions }}</span></p>

        <div class="sub-section-title">6.3 Methods and material for containment and cleaning up</div>
        <p><span data-field="containment_methods">{{ containment_methods }}</span></p>

        <div class="sub-section-title">6.4 Reference to other sections</div>
        <p><span data-field="reference_sections">{{ reference_sections }}</span></p>
    </div>

    <div class="page">
        <div class="section-title">SECTION 7: Handling and storage</div>

        <div class="sub-section-title">7.1 Precautions for safe handling</div>
        <p>General handling</p>
        <p><span data-field="handling_general">{{ handling_general }}</span></p>
        <p>General protective and hygiene measures</p>
        <p><span data-field="handling_hygiene">{{ handling_hygiene }}</span></p>
        <p>Advice on protection against fire and explosion</p>
        <p><span data-field="handling_fire_explosion">{{ handling_fire_explosion }}</span></p>
        <p>Conditions for safe storage, including any incompatibilities</p>
        <p>Technical measures and storage conditions</p>
        <p><span data-field="storage_technical">{{ storage_technical }}</span></p>
        <p>Requirements for storage rooms and vessels</p>
        <p><span data-field="storage_requirements">{{ storage_requirements }}</span></p>
        <p>Incompatible products</p>
        <p><span data-field="incompatible_products">{{ incompatible_products }}</span></p>

        <div class="sub-section-title">7.3 Specific end use(s)</div>
        <p><span data-field="specific_end_use">{{ specific_end_use }}</span></p>
    </div>

    <div class="page">
        <div class="section-title">SECTION 8: Exposure controls/personal protection</div>

        <div class="sub-section-title">8.1 Control parameters</div>
        <p>No parameters available for monitoring.</p>

        <div class="sub-section-title">8.2 Exposure controls</div>
        <p>General information</p>
        <p><span data-field="exposure_general">{{ exposure_general }}</span></p>
        <p>Personal protective equipment</p>
        <p>Respiratory protection</p>
        <p><span data-field="respiratory_protection">{{ respiratory_protection }}</span></p>
        <p>Eye / face protection</p>
        <p><span data-field="eye_face_protection">{{ eye_face_protection }}</span></p>
        <p>Hand protection</p>
        <p><span data-field="hand_protection">{{ hand_protection }}</span></p>
        <p>Environmental exposure controls</p>
        <p><span data-field="environmental_exposure_controls">{{ environmental_exposure_controls }}</span></p>

        <div class="sub-section-title">9.1 Information on basic physical and chemical properties</div>
            <p>Form/Colour</p>
            <p><span data-field="form_colour">{{ form_colour }}</span></p>
            <p>Odour</p>
            <p><span data-field="odour">{{ odour }}</span></p>
            <p>Odour threshold</p>
            <p><span data-field="odour_threshold">{{ odour_threshold }}</span></p>
            <p>pH value</p>
            <p><span data-field="ph_value">{{ ph_value }}</span></p>
            <p>Boiling point / boiling range</p>
            <table>
                <thead>
                    <tr class="header-row">
                        <th>Value</th>
                        <th>CAS 756-12-7</th>
                        <th>Supplier</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span data-field="boiling_point">{{ boiling_point }}</span> &deg;C</td>
                        <td></td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
            <p>Melting point / melting range</p>
            <table>
                <thead>
                    <tr class="header-row">
                        <th>Value</th>
                        <th>CAS 756-12-7</th>
                        <th>Supplier</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span data-field="melting_point">{{ melting_point }}</span> &deg;C</td>
                        <td></td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
            <p>Decomposition point / decomposition range</p>
            <table>
                <thead>
                    <tr class="header-row">
                        <th>Value</th>
                        <th>Supplier</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span data-field="decomposition_point">{{ decomposition_point }}</span></td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
            <p>Flash point</p>
            <table>
                <thead>
                    <tr class="header-row">
                        <th>Value</th>
                        <th>Supplier</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span data-field="flash_point">{{ flash_point }}</span></td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
            <p>Auto-ignition temperature</p>
            <table>
                <thead>
                    <tr class="header-row">
                        <th>Value</th>
                        <th>Supplier</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span data-field="auto_ignition_temp">{{ auto_ignition_temp }}</span></td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
            <p>Oxidising properties</p>
            <p><span data-field="oxidising_properties">{{ oxidising_properties }}</span></p>
            <p>Explosive properties</p>
            <p><span data-field="explosive_properties">{{ explosive_properties }}</span></p>
            <p>Flammability (solid, gas)</p>
            <p><span data-field="flammability">{{ flammability }}</span></p>
            <p>Lower flammability or explosive limits</p>
            <p><span data-field="lower_flammability">{{ lower_flammability }}</span></p>
            <p>Upper flammability or explosive limits</p>
            <p><span data-field="upper_flammability">{{ upper_flammability }}</span></p>
        </div>

        <div class="sub-section-title">9.2 Physical and chemical properties</div>
            <p>Vapour pressure</p>
            <table>
                <thead>
                    <tr class="header-row">
                        <th>Value</th>
                        <th>CAS 756-12-7</th>
                        <th>Supplier</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span data-field="vapour_pressure">{{ vapour_pressure }}</span> kPa</td>
                        <td></td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
            <p>Vapour density</p>
            <table>
                <thead>
                    <tr class="header-row">
                        <th>Value</th>
                        <th>CAS 756-12-7</th>
                        <th>Supplier</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span data-field="vapour_density">{{ vapour_density }}</span></td>
                        <td></td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
            <p>Evaporation rate</p>
            <table>
                <thead>
                    <tr class="header-row">
                        <th>Value</th>
                        <th>CAS 756-12-7</th>
                        <th>Supplier</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span data-field="evaporation_rate">{{ evaporation_rate }}</span> 50</td>
                        <td></td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
            <p>Relative density</p>
            <table>
                <thead>
                    <tr class="header-row">
                        <th>Value</th>
                        <th>CAS 756-12-7</th>
                        <th>Supplier</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span data-field="relative_density">{{ relative_density }}</span></td>
                        <td></td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
            <p>Density</p>
            <table>
                <thead>
                    <tr class="header-row">
                        <th>Value</th>
                        <th>CAS 756-12-7</th>
                        <th>Supplier</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span data-field="density">{{ density }}</span> g/ml</td>
                        <td></td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
            <p>Solubility in water</p>
            <p><span data-field="solubility_water">{{ solubility_water }}</span></p>
            <p>Partition coefficient: n-octanol/water</p>
            <table>
                <thead>
                    <tr class="header-row">
                        <th>No</th>
                        <th>Substance name</th>
                        <th>CAS no.</th>
                        <th>EC no.</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in line_items %}
                    <tr>
                        <td><span data-field="line_items[{{ loop.index0 }}].no">{{ item.no }}</span></td>
                        <td><span data-field="line_items[{{ loop.index0 }}].description">{{ item.description }}</span></td>
                        <td><span data-field="line_items[{{ loop.index0 }}].cas_ec_reach">{{ item.cas_ec_reach }}</span></td>
                        <td><span data-field="line_items[{{ loop.index0 }}].ec_no">{{ item.ec_no }}</span></td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            <p>Log Pow</p>
            <table>
                <thead>
                    <tr class="header-row">
                        <th>Value</th>
                        <th>CAS 756-12-7</th>
                        <th>Supplier</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span data-field="log_pow">{{ log_pow }}</span></td>
                        <td></td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
            <p>Viscosity</p>
            <table>
                <thead>
                    <tr class="header-row">
                        <th>Value</th>
                        <th>CAS 756-12-7</th>
                        <th>Supplier</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span data-field="viscosity">{{ viscosity }}</span> mm2/s</td>
                        <td></td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
            <p>Type</p>
            <p><span data-field="viscosity_type">{{ viscosity_type }}</span></p>
            <p>Reference substance</p>
            <p><span data-field="viscosity_ref_substance">{{ viscosity_ref_substance }}</span></p>
            <p>Source</p>
            <p><span data-field="viscosity_source">{{ viscosity_source }}</span></p>
        </div>

        <div class="sub-section-title">9.2 Other information</div>
            <p><span data-field="other_info">{{ other_info }}</span></p>
        </div>
    </div>

    <div class="page">
        <div class="section-title">SECTION 10: Stability and reactivity</div>

        <div class="sub-section-title">10.1 Reactivity</div>
        <p><span data-field="reactivity_statement">{{ reactivity_statement }}</span></p>

        <div class="sub-section-title">10.2 Chemical stability</div>
        <p><span data-field="chemical_stability">{{ chemical_stability }}</span></p>

        <div class="sub-section-title">10.3 Possibility of hazardous reactions</div>
        <p><span data-field="hazardous_reactions">{{ hazardous_reactions }}</span></p>
    </div>

    <div class="page">
        <div class="section-title">SECTION 11: Toxicological information</div>

        <div class="sub-section-title">11.1 Information on toxicological effects</div>
            <p>Acute oral toxicity</p>
            <table>
                <thead>
                    <tr class="header-row">
                        <th>No</th>
                        <th>Substance name</th>
                        <th>CAS no.</th>
                        <th>EC no.</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in line_items %}
                    <tr>
                        <td><span data-field="line_items[{{ loop.index0 }}].no">{{ item.no }}</span></td>
                        <td><span data-field="line_items[{{ loop.index0 }}].description">{{ item.description }}</span></td>
                        <td><span data-field="line_items[{{ loop.index0 }}].cas_ec_reach">{{ item.cas_ec_reach }}</span></td>
                        <td><span data-field="line_items[{{ loop.index0 }}].ec_no">{{ item.ec_no }}</span></td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            <p>LD50</p>
            <table>
                <thead>
                    <tr class="header-row">
                        <th>Species</th>
                        <th>LD50</th>
                        <th>Method</th>
                        <th>Source</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span data-field="ld50_species">{{ ld50_species }}</span></td>
                        <td><span data-field="ld50_value">{{ ld50_value }}</span></td>
                        <td><span data-field="ld50_method">{{ ld50_method }}</span></td>
                        <td><span data-field="ld50_source">{{ ld50_source }}</span></td>
                    </tr>
                </tbody>
            </table>
            <p>Acute dermal toxicity</p>
            <table>
                <thead>
                    <tr class="header-row">
                        <th>No</th>
                        <th>Substance name</th>
                        <th>CAS no.</th>
                        <th>EC no.</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in line_items %}
                    <tr>
                        <td><span data-field="line_items[{{ loop.index0 }}].no">{{ item.no }}</span></td>
                        <td><span data-field="line_items[{{ loop.index0 }}].description">{{ item.description }}</span></td>
                        <td><span data-field="line_items[{{ loop.index0 }}].cas_ec_reach">{{ item.cas_ec_reach }}</span></td>
                        <td><span data-field="line_items[{{ loop.index0 }}].ec_no">{{ item.ec_no }}</span></td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            <p>LD50</p>
            <table>
                <thead>
                    <tr class="header-row">
                        <th>Species</th>
                        <th>LD50</th>
                        <th>Method</th>
                        <th>Source</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span data-field="ld50_species">{{ ld50_species }}</span></td>
                        <td><span data-field="ld50_value">{{ ld50_value }}</span> 2000</td>
                        <td><span data-field="ld50_method">{{ ld50_method }}</span></td>
                        <td><span data-field="ld50_source">{{ ld50_source }}</span></td>
                    </tr>
                </tbody>
            </table>
            <p>Acute inhalation toxicity</p>
            <table>
                <thead>
                    <tr class="header-row">
                        <th>No</th>
                        <th>Substance name</th>
                        <th>CAS no.</th>
                        <th>EC no.</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in line_items %}
                    <tr>
                        <td><span data-field="line_items[{{ loop.index0 }}].no">{{ item.no }}</span></td>
