      <tr class="data-row">
        <td>Upper explosion limit</td>
        <td>: <span data-field="upper_explosion_limit">{{ upper_explosion_limit }}</span></td>
      </tr>
      <tr class="data-row">
        <td>Vapor pressure</td>
        <td>: <span data-field="vapor_pressure">{{ vapor_pressure }}</span></td>
      </tr>
      <tr class="data-row">
        <td>Vapor density</td>
        <td>: <span data-field="vapor_density">{{ vapor_density }}</span></td>
      </tr>
      <tr class="data-row">
        <td>Density</td>
        <td>: <span data-field="density">{{ density }}</span></td>
      </tr>
      <tr class="data-row">
        <td>Water solubility</td>
        <td>: <span data-field="water_solubility">{{ water_solubility }}</span></td>
      </tr>
      <tr class="data-row">
        <td>Ignition temperature</td>
        <td>: <span data-field="ignition_temperature">{{ ignition_temperature }}</span></td>
      </tr>
