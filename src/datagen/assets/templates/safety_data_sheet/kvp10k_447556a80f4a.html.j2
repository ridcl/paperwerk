  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      <div class="header-title">SAFETY DATA SHEET</div>
      <div class="header-info">
        <div>
          Version <span data-field="version">{{ version }}</span>
        </div>
