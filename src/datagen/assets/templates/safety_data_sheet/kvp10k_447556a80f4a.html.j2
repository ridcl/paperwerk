  <table>
    <tbody>
      <tr class="data-row">
        <td>Odor</td>
        <td>: <span data-field="odor">{{ odor }}</span></td>
      </tr>
      <tr class="data-row">
        <td>pH</td>
        <td>: <span data-field="ph">{{ ph }}</span></td>
      </tr>
      <tr class="data-row">
        <td>Melting point/freezing point</td>
        <td>: <span data-field="melting_point">{{ melting_point }}</span></td>
      </tr>
      <tr class="data-row">
        <td>Boiling point/boiling range</td>
        <td>: <span data-field="boiling_point">{{ boiling_point }}</span></td>
      </tr>
      <tr class="data-row">
        <td>Flash point</td>
        <td>: <span data-field="flash_point">{{ flash_point }}</span><br>Method: <span data-field="flash_point_method">{{ flash_point_method }}</span></td>
      </tr>
      <tr class="data-row">
        <td>Lower explosion limit</td>
        <td>: <span data-field="lower_explosion_limit">{{ lower_explosion_limit }}</span></td>
