<!DOCTYPE html>
<html>
<head>
    <title>Safety Data Sheet</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }
        td, th {
            padding: 8px 0;
            text-align: left;
        }
        .header-title {
            font-size: 24pt;
            font-weight: bold;
            text-align: center;
            margin-bottom: 20px;
        }
        .section-heading {
            font-size: 14pt;
            font-weight: bold;
            margin-top: 25px;
            margin-bottom: 10px;
            border-bottom: 1px solid #ccc;
            padding-bottom: 5px;
        }
        .sub-heading {
            font-weight: bold;
            margin-top: 15px;
        }
        .data-row td:first-child {
            width: 30%;
            font-weight: normal;
        }
        .data-row td:last-child {
            width: 70%;
        }
        .logo {
            float: right;
            margin-top: 10px;
        }
        .logo img {
            width: 150px; /* Placeholder size */
            height: auto;
        }
    </style>

