<body>
    <div class="page">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
                <div class="header-title">SAFETY DATA SHEET</div>
                <div style="margin-top: 20px;">
                    <p>Hexane ({{ product_identifiers.hexanes_list }})</p>
                    <p>MSDS Number: <span data-field="msds_number">{{ msds_number }}</span></p>
                    <p>Version: {{ version }}</p>
                    <p>Revision Date: <span data-field="revision_date">{{ revision_date }}</span></p>
                    <p>Print Date: <span data-field="print_date">{{ print_date }}</span></p>
                </div>
            </div>
            <div class="logo">
                <!-- Placeholder for BDH logo -->
                <svg width="150" height="150" viewBox="0 0 100 100" style="display: block;">
                    <rect width="100" height="100" fill="#007bff"/>
                    <text x="50" y="60" font-size="40" font-weight="bold" fill="white" text-anchor="middle">BDH</text>
                </svg>
            </div>
        </div>

        <div class="section-heading">SECTION 1. PRODUCT AND COMPANY IDENTIFICATION</div>
        <table>
            <tbody>
                <tr class="data-row">
                    <td>Product name</td>
                    <td><span data-field="product_name">{{ product_name }}</span></td>
                </tr>
                <tr class="data-row">
                    <td>MSDS Number</td>
                    <td><span data-field="msds_number_sec1">{{ msds_number }}</span></td>
                </tr>
                <tr class="data-row">
                    <td>Product Use Description</td>
                    <td><span data-field="product_use_description">{{ product_use_description }}</span></td>
                </tr>
                <tr class="data-row">
                    <td>Manufacturer</td>
                    <td><span data-field="manufacturer.name">{{ manufacturer.name }}</span><br><span data-field="manufacturer.address">{{ manufacturer.address }}</span></td>
                </tr>
                <tr class="data-row">
                    <td>Manufactured for</td>
                    <td><span data-field="manufactured_for.name">{{ manufactured_for.name }}</span><br><span data-field="manufactured_for.address">{{ manufactured_for.address }}</span></td>
                </tr>
            </tbody>
        </table>

        <div class="section-heading">SECTION 2. HAZARDS IDENTIFICATION</div>
        <table>
            <tbody>
                <tr class="data-row">
                    <td>Odor</td>
                    <td><span data-field="odor">{{ odor }}</span></td>
                </tr>
                <tr class="data-row">
                    <td>Hazard Summary</td>
                    <td><span data-field="hazard_summary">{{ hazard_summary }}</span></td>
                </tr>
                <tr class="data-row">
                    <td>Potential Health Effects</td>
                    <td>
                        <table style="width: 100%;">
                            <tbody>
                                <tr class="data-row">
                                    <td style="width: 15%;">Skin</td>
                                    <td><span data-field="health_effects.skin">{{ health_effects.skin }}</span></td>
                                </tr>
                                <tr class="data-row">
                                    <td style="width: 15%;">Eyes</td>
                                    <td><span data-field="health_effects.eyes">{{ health_effects.eyes }}</span></td>
                                </tr>
                                <tr class="data-row">
                                    <td style="width: 15%;">Ingestion</td>
                                    <td><span data-field="health_effects.ingestion">{{ health_effects.ingestion }}</span></td>
                                </tr>
                                <tr class="data-row">
                                    <td style="width: 15%;">Inhalation</td>
                                    <td><span data-field="health_effects.inhalation">{{ health_effects.inhalation }}</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
                <tr class="data-row">
                    <td>Chronic Exposure</td>
                    <td><span data-field="chronic_exposure">{{ chronic_exposure }}</span></td>
                </tr>
                <tr class="data-row">
                    <td>Aggravated Medical Condition</td>
                    <td><span data-field="aggravated_conditions">{{ aggravated_conditions }}</span></td>
                </tr>
                <tr class="data-row">
                    <td>Target Organs</td>
                    <td><span data-field="target_organs">{{ target_organs }}</span></td>
                </tr>
                <tr class="data-row">
                    <td>Carcinogenicity</td>
                    <td><span data-field="carcinogenicity">{{ carcinogenicity }}</span></td>
                </tr>
                <tr class="data-row">
                    <td>Formula</td>
                    <td><span data-field="formula">{{ formula }}</span></td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="page">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
                <div class="header-title">SAFETY DATA SHEET</div>
                <div style="margin-top: 20px;">
                    <p>Hexane ({{ product_identifiers.hexanes_list }})</p>
                    <p>MSDS Number: <span data-field="msds_number">{{ msds_number }}</span></p>
                    <p>Version: {{ version }}</p>
                    <p>Revision Date: <span data-field="revision_date">{{ revision_date }}</span></p>
                    <p>Print Date: <span data-field="print_date">{{ print_date }}</span></p>
                </div>
            </div>
            <div class="logo">
                <!-- Placeholder for BDH logo -->
                <svg width="150" height="150" viewBox="0 0 100 100" style="display: block;">
                    <rect width="100" height="100" fill="#007bff"/>
                    <text x="50" y="60" font-size="40" font-weight="bold" fill="white" text-anchor="middle">BDH</text>
                </svg>
            </div>
        </div>

        <div class="section-heading">SECTION 3. COMPOSITION/INFORMATION ON INGREDIENTS</div>
        <table>
            <thead>
                <tr>
                    <th style="width: 30%;">Chemical Name</th>
                    <th style="width: 20%;">CAS-No.</th>
                    <th style="width: 20%;">Concentration</th>
                </tr>
            </thead>
            <tbody>
                {% for item in ingredients %}
                <tr class="data-row">
                    <td><span data-field="ingredients[{{ loop.index0 }}].name">{{ item.name }}</span></td>
                    <td><span data-field="ingredients[{{ loop.index0 }}].cas_no">{{ item.cas_no }}</span></td>
                    <td><span data-field="ingredients[{{ loop.index0 }}].concentration">{{ item.concentration }}</span></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>

        <div class="section-heading">SECTION 4. FIRST AID MEASURES</div>
        <table>
            <tbody>
                <tr class="data-row">
                    <td>Inhalation</td>
                    <td><span data-field="first_aid.inhalation">{{ first_aid.inhalation }}</span></td>
                </tr>
                <tr class="data-row">
                    <td>Skin contact</td>
                    <td><span data-field="first_aid.skin_contact">{{ first_aid.skin_contact }}</span></td>
                </tr>
                <tr class="data-row">
                    <td>Eye contact</td>
                    <td><span data-field="first_aid.eye_contact">{{ first_aid.eye_contact }}</span></td>
                </tr>
                <tr class="data-row">
                    <td>Ingestion</td>
                    <td><span data-field="first_aid.ingestion">{{ first_aid.ingestion }}</span></td>
                </tr>
                <tr class="data-row">
                    <td>Notes to physician</td>
                    <td><span data-field="first_aid.notes_to_physician">{{ first_aid.notes_to_physician }}</span></td>
                </tr>
            </tbody>
        </table>

        <div class="section-heading">SECTION 5. FIRE FIGHTING MEASURES</div>
        <table>
            <tbody>
                <tr class="data-row">
                    <td>Suitable extinguishing media</td>
                    <td><span data-field="fire_fighting.extinguishing_media">{{ fire_fighting.extinguishing_media }}</span></td>
                </tr>
                <tr class="data-row">
                    <td>Unsuitable extinguishing media</td>
                    <td><span data-field="fire_fighting.unsuitable_media">{{ fire_fighting.unsuitable_media }}</span></td>
                </tr>
                <tr class="data-row">
                    <td>Specific hazards during firefighting</td>
                    <td><span data-field="fire_fighting.specific_hazards">{{ fire_fighting.specific_hazards }}</span></td>
                </tr>
                <tr class="data-row">
                    <td>Special protective equipment for firefighters</td>
                    <td><span data-field="fire_fighting.protective_equipment">{{ fire_fighting.protective_equipment }}</span></td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="page">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
                <div class="header-title">SAFETY DATA SHEET</div>
                <div style="margin-top: 20px;">
                    <p>Hexane ({{ product_identifiers.hexanes_list }})</p>
                    <p>MSDS Number: <span data-field="msds_number">{{ msds_number }}</span></p>
                    <p>Version: {{ version }}</p>
                    <p>Revision Date: <span data-field="revision_date">{{ revision_date }}</span></p>
                    <p>Print Date: <span data-field="print_date">{{ print_date }}</span></p>
                </div>
            </div>
            <div class="logo">
                <!-- Placeholder for BDH logo -->
                <svg width="150" height="150" viewBox="0 0 100 100" style="display: block;">
                    <rect width="100" height="100" fill="#007bff"/>
                    <text x="50" y="60" font-size="40" font-weight="bold" fill="white" text-anchor="middle">BDH</text>
                </svg>
            </div>
        </div>

        <div class="section-heading">SECTION 6. ACCIDENTAL RELEASE MEASURES</div>
        <table>
            <tbody>
                <tr class="data-row">
                    <td>Personal precautions</td>
                    <td><span data-field="accidental_release.personal_precautions">{{ accidental_release.personal_precautions }}</span></td>
                </tr>
                <tr class="data-row">
                    <td>Environmental precautions</td>
                    <td><span data-field="accidental_release.environmental_precautions">{{ accidental_release.environmental_precautions }}</span></td>
                </tr>
                <tr class="data-row">
                    <td>Methods for cleaning up</td>
                    <td><span data-field="accidental_release.methods_for_cleaning_up">{{ accidental_release.methods_for_cleaning_up }}</span></td>
                </tr>
            </tbody>
        </table>

        <div class="section-heading">SECTION 7. HANDLING AND STORAGE</div>
        <table>
            <tbody>
                <tr class="data-row">
                    <td>Handling</td>
                    <td><span data-field="handling.handling">{{ handling.handling }}</span></td>
                </tr>
                <tr class="data-row">
                    <td>Advice on protection against fire and explosion</td>
                    <td><span data-field="handling.fire_explosion_advice">{{ handling.fire_explosion_advice }}</span></td>
                </tr>
                <tr class="data-row">
                    <td>Storage</td>
                    <td><span data-field="handling.storage">{{ handling.storage }}</span></td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="page">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
                <div class="header-title">SAFETY DATA SHEET</div>
                <div style="margin-top: 20px;">
                    <p>Hexane ({{ product_identifiers.hexanes_list }})</p>
                    <p>MSDS Number: <span data-field="msds_number">{{ msds_number }}</span></p>
                    <p>Version: {{ version }}</p>
                    <p>Revision Date: <span data-field="revision_date">{{ revision_date }}</span></p>
                    <p>Print Date: <span data-field="print_date">{{ print_date }}</span></p>
                </div>
            </div>
            <div class="logo">
                <!-- Placeholder for BDH logo -->
                <svg width="150" height="150" viewBox="0 0 100 100" style="display: block;">
                    <rect width="100" height="100" fill="#007bff"/>
                    <text x="50" y="60" font-size="40" font-weight="bold" fill="white" text-anchor="middle">BDH</text>
                </svg>
            </div>
        </div>

        <div class="section-heading">SECTION 8. EXPOSURE CONTROLS/PERSONAL PROTECTION</div>
        <table>
            <tbody>
                <tr class="data-row">
                    <td>Protective measures</td>
                    <td><span data-field="exposure_controls.protective_measures">{{ exposure_controls.protective_measures }}</span></td>
                </tr>
                <tr class="data-row">
                    <td>Engineering measures</td>
                    <td><span data-field="exposure_controls.engineering_measures">{{ exposure_controls.engineering_measures }}</span></td>
                </tr>
                <tr class="data-row">
                    <td>Eye protection</td>
                    <td><span data-field="exposure_controls.eye_protection">{{ exposure_controls.eye_protection }}</span></td>
                </tr>
                <tr class="data-row">
                    <td>Hand protection</td>
                    <td><span data-field="exposure_controls.hand_protection">{{ exposure_controls.hand_protection }}</span></td>
                </tr>
                <tr class="data-row">
                    <td>Skin and body protection</td>
                    <td><span data-field="exposure_controls.skin_body_protection">{{ exposure_controls.skin_body_protection }}</span></td>
                </tr>
                <tr class="data-row">
                    <td>Respiratory protection</td>
                    <td><span data-field="exposure_controls.respiratory_protection">{{ exposure_controls.respiratory_protection }}</span></td>
                </tr>
                <tr class="data-row">
                    <td>Hygiene measures</td>
                    <td><span data-field="exposure_controls.hygiene_measures">{{ exposure_controls.hygiene_measures }}</span></td>
                </tr>
            </tbody>
        </table>

        <div class="section-heading">Exposure Guidelines</div>
        <table>
            <thead>
                <tr>
                    <th style="width: 30%;">Components</th>
                    <th style="width: 15%;">CAS-No.</th>
                    <th style="width: 15%;">Value</th>
                    <th style="width: 25%;">Control parameters</th>
                    <th style="width: 15%;">Basis</th>
                </tr>
            </thead>
            <tbody>
                {% for guideline in exposure_guidelines %}
                <tr class="data-row">
                    <td><span data-field="exposure_guidelines[{{ loop.index0 }}].component">{{ guideline.component }}</span></td>
                    <td><span data-field="exposure_guidelines[{{ loop.index0 }}].cas_no">{{ guideline.cas_no }}</span></td>
                    <td><span data-field="exposure_guidelines[{{ loop.index0 }}].value">{{ guideline.value }}</span></td>
                    <td><span data-field="exposure_guidelines[{{ loop.index0 }}].control_parameters">{{ guideline.control_parameters }}</span></td>
                    <td><span data-field="exposure_guidelines[{{ loop.index0 }}].basis">{{ guideline.basis }}</span></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>



<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      <div class="header-title">SAFETY DATA SHEET</div>
      <div class="header-info">
        <div>
          Version <span data-field="version">{{ version }}</span>
        </div>
        <div>
          Revision Date <span data-field="revision_date">{{ revision_date }}</span>
          Print Date <span data-field="print_date">{{ print_date }}</span>
        </div>
      </div>
      <div style="font-size: 18pt; font-weight: bold;">
        Hexane (BDH1129-19L, BDH1129-204L, BDH1129-4LP, BDH1129-4LG)
        <br>
        <span data-field="product_id">{{ product_id }}</span>
      </div>
    </div>
    <div class="logo">
      <img src="placeholder_bdh_logo.png" alt="BDH Logo" style="width: 150px;">
    </div>
  </div>

  <div class="section-heading">SECTION 9. PHYSICAL AND CHEMICAL PROPERTIES</div>
  <table>
    <tbody>
      <tr class="data-row">
        <td>Physical state</td>
        <td>: <span data-field="physical_state">{{ physical_state }}</span></td>
      </tr>
      <tr class="data-row">
        <td>Color</td>
        <td>: <span data-field="color">{{ color }}</span></td>
      </tr>
    </tbody>
  </table>
  <div style="text-align: center; margin-top: 50px; font-size: 10pt;">Page <span data-field="page_number">{{ page_number }}</span> / <span data-field="total_pages">{{ total_pages }}</span></div>
</div>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      <div class="header-title">SAFETY DATA SHEET</div>
      <div class="header-info">
        <div>
          Version <span data-field="version">{{ version }}</span>
        </div>
        <div>
          Revision Date <span data-field="revision_date">{{ revision_date }}</span>
          Print Date <span data-field="print_date">{{ print_date }}</span>
        </div>
