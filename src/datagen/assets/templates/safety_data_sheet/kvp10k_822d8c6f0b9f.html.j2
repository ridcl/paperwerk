<!DOCTYPE html>
<html>
<head>
    <title>Safety Data Sheet</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 { font-weight: bold; }
        .section-header { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
        .data-row { display: flex; margin-bottom: 5px; }
        .data-label { width: 30%; font-weight: normal; }
        .data-value { width: 70%; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { border: 1px solid #ccc; padding: 8px; text-align: left; }
        .center-text { text-align: center; }
    </style>

<style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 { font-weight: bold; }
        .section-header {
            font-weight: bold;
            text-transform: uppercase;
            margin-top: 20px;
            margin-bottom: 10px;
        }
        .data-row {
            display: flex;
            margin-bottom: 8px;
        }
        .label {
            flex-basis: 30%;
            font-weight: normal;
        }
        .value {
            flex-basis: 70%;
            font-weight: normal;
        }
        .divider {
            border-top: 1px solid #ccc;
            margin: 20px 0;
        }
    </style>
</head>
<body>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px;">
        <div>
            <h1 style="font-size: 24pt; margin: 0;">SAFETY DATA SHEET</h1>
            <h2 style="font-size: 18pt; margin: 5px 0 0 0;">AZ nLOF 2035 Photoresist</h2>
            <div style="margin-top: 10px;">
                <div class="data-row">
                    <div class="data-label">Substance No.:</div>
                    <div class="data-value"><span data-field="substance_number">{{ substance_number }}</span></div>
                </div>
                <div class="data-row">
                    <div class="data-label">Version:</div>
                    <div class="data-value"><span data-field="version">{{ version }}</span></div>
                </div>
            </div>
        </div>
        <div style="text-align: right;">
            <div class="data-row" style="justify-content: flex-end;">
                <div class="data-value" style="text-align: right;"><span data-field="revision_date">{{ revision_date }}</span></div>
            </div>
            <div class="data-row" style="justify-content: flex-end;">
                <div class="data-value" style="text-align: right;"><span data-field="print_date">{{ print_date }}</span></div>
            </div>
        </div>
    </div>

    <div class="section-header">SECTION 1. PRODUCT AND COMPANY IDENTIFICATION</div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Product name:</div>
        <div class="data-value"><span data-field="product_name">{{ product_name }}</span></div>
    </div>
    <div class="data-row">
        <div class="data-label">Product Use Description:</div>
        <div class="data-value"><span data-field="product_use_description">{{ product_use_description }}</span></div>
    </div>
    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Company:</div>
        <div class="data-value">
            <span data-field="company_name">{{ company_name }}</span><br>
            <span data-field="company_address_line_1">{{ company_address_line_1 }}</span><br>
            <span data-field="company_address_line_2">{{ company_address_line_2 }}</span><br>
            <span data-field="company_address_city_state_zip">{{ company_address_city_state_zip }}</span>
        </div>
    </div>
    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Telephone:</div>
        <div class="data-value"><span data-field="telephone_number">{{ telephone_number }}</span></div>
    </div>
    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Emergency telephone number:</div>
        <div class="data-value"><span data-field="emergency_telephone_number">{{ emergency_telephone_number }}</span></div>
    </div>
</div>

<div class="page">
    <div class="section-header">SECTION 2. HAZARDS IDENTIFICATION</div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Emergency Overview</div>
        <div class="data-value"></div>
    </div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">HMIS Classification</div>
        <div class="data-value"><span data-field="hmis_classification">{{ hmis_classification }}</span></div>
    </div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">NFPA Classification</div>
        <div class="data-value">
            <div style="display: flex; align-items: center; gap: 20px;">
                <div style="position: relative; width: 80px; height: 80px;">
                    <div style="width: 70px; height: 70px; background-color: red; border: 3px solid black; position: absolute; top: 5px; left: 5px;"></div>
                    <div style="width: 50px; height: 50px; background-color: blue; border: 3px solid black; position: absolute; top: 35px; left: 15px;"></div>
                    <div style="width: 40px; height: 40px; background-color: yellow; border: 3px solid black; position: absolute; top: 55px; left: 30px;"></div>
                </div>
                <div>
                    <div class="data-row">
                        <div class="data-label">Health hazard:</div>
                        <div class="data-value"><span data-field="nfpa_health_hazard">{{ nfpa_health_hazard }}</span></div>
                    </div>
                    <div class="data-row">
                        <div class="data-label">Fire Hazard:</div>
                        <div class="data-value"><span data-field="nfpa_fire_hazard">{{ nfpa_fire_hazard }}</span></div>
                    </div>
                    <div class="data-row">
                        <div class="data-label">Reactivity Hazard:</div>
                        <div class="data-value"><span data-field="nfpa_reactivity_hazard">{{ nfpa_reactivity_hazard }}</span></div>
                    </div>
                    <div class="data-row">
                        <div class="data-label">Special Hazards:</div>
                        <div class="data-value"><span data-field="nfpa_special_hazards">{{ nfpa_special_hazards }}</span></div>
                    </div>
                </div>
            </div>
        </div>

    <div class="data-row" style="margin-top: 20px;">
        <div class="data-label">GHS Classification</div>
        <div class="data-value"><span data-field="ghs_classification">{{ ghs_classification }}</span></div>
    </div>

    <div class="data-row" style="margin-top: 20px;">
        <div class="data-label">GHS-Labelling</div>
        <div class="data-value">
            <div style="display: flex; gap: 20px;">
                <div style="font-size: 30pt;">&#9888;</div>
                <div style="font-size: 30pt;">&#9888;</div>
            </div>
        </div>
    </div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Signal word</div>
        <div class="data-value"><span data-field="signal_word">{{ signal_word }}</span></div>
    </div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Hazard statements</div>
        <div class="data-value">
            <ul style="margin: 0; padding-left: 20px;">
                <li><span data-field="hazard_statement_1">{{ hazard_statement_1 }}</span></li>
                <li><span data-field="hazard_statement_2">{{ hazard_statement_2 }}</span></li>
                <li><span data-field="hazard_statement_3">{{ hazard_statement_3 }}</span></li>
            </ul>
        </div>
    </div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Precautionary statements</div>
        <div class="data-value">
            <div style="margin-top: 10px;">
                <div style="font-weight: bold;">Prevention:</div>
                <ul style="margin: 5px 0 10px 20px;">
                    <li><span data-field="precaution_prevention_1">{{ precaution_prevention_1 }}</span></li>
                    <li><span data-field="precaution_prevention_2">{{ precaution_prevention_2 }}</span></li>
                    <li><span data-field="precaution_prevention_3">{{ precaution_prevention_3 }}</span></li>
                    <li><span data-field="precaution_prevention_4">{{ precaution_prevention_4 }}</span></li>
                </ul>
                <div style="font-weight: bold;">Response:</div>
                <ul style="margin: 5px 0 10px 20px;">
                    <li><span data-field="precaution_response_1">{{ precaution_response_1 }}</span></li>
                    <li><span data-field="precaution_response_2">{{ precaution_response_2 }}</span></li>
                    <li><span data-field="precaution_response_3">{{ precaution_response_3 }}</span></li>
                    <li><span data-field="precaution_response_4">{{ precaution_response_4 }}</span></li>
                    <li><span data-field="precaution_response_5">{{ precaution_response_5 }}</span></li>
                </ul>
                <div style="font-weight: bold;">Storage:</div>
                <ul style="margin: 5px 0 10px 20px;">
                    <li><span data-field="precaution_storage_1">{{ precaution_storage_1 }}</span></li>
                    <li><span data-field="precaution_storage_2">{{ precaution_storage_2 }}</span></li>
                </ul>
                <div style="font-weight: bold;">Disposal:</div>
                <ul style="margin: 5px 0 10px 20px;">
                    <li><span data-field="precaution_disposal_1">{{ precaution_disposal_1 }}</span></li>
                </ul>
            </div>
        </div>
    </div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Special labelling of certain mixtures:</div>
        <div class="data-value"></div>
    </div>
</div>

<div class="page">
    <div class="section-header">SECTION 3. COMPOSITION/INFORMATION ON INGREDIENTS</div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Hazardous ingredients</div>
        <div class="data-value"></div>
    </div>

    <table>
        <thead>
            <tr>
                <th style="width: 50%;">Component</th>
                <th style="width: 25%; text-align: center;">CAS-No.</th>
                <th style="width: 25%; text-align: center;">Weight percent</th>
            </tr>
        </thead>
        <tbody>
            {% for item in hazardous_ingredients %}
            <tr>
                <td><span data-field="hazardous_ingredients[{{ loop.index0 }}].component">{{ hazardous_ingredients[loop.index0].component }}</span></td>
                <td class="center-text"><span data-field="hazardous_ingredients[{{ loop.index0 }}].cas_no">{{ hazardous_ingredients[loop.index0].cas_no }}</span></td>
                <td class="center-text"><span data-field="hazardous_ingredients[{{ loop.index0 }}].weight_percent">{{ hazardous_ingredients[loop.index0].weight_percent }}</span></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="data-row" style="margin-top: 20px;">
        <div class="data-label">Non-hazardous ingredients</div>
        <div class="data-value"></div>
    </div>

    <table>
        <thead>
            <tr>
                <th style="width: 50%;">Component</th>
                <th style="width: 25%; text-align: center;">CAS-No.</th>
                <th style="width: 25%; text-align: center;">Weight percent</th>
            </tr>
        </thead>
        <tbody>
            {% for item in non_hazardous_ingredients %}
            <tr>
                <td><span data-field="non_hazardous_ingredients[{{ loop.index0 }}].component">{{ non_hazardous_ingredients[loop.index0].component }}</span></td>
                <td class="center-text"><span data-field="non_hazardous_ingredients[{{ loop.index0 }}].cas_no">{{ non_hazardous_ingredients[loop.index0].cas_no }}</span></td>
                <td class="center-text"><span data-field="non_hazardous_ingredients[{{ loop.index0 }}].weight_percent">{{ non_hazardous_ingredients[loop.index0].weight_percent }}</span></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<div class="page">
    <div class="section-header">SECTION 4. FIRST AID MEASURES</div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">General advice</div>
        <div class="data-value"><span data-field="first_aid_general_advice">{{ first_aid_general_advice }}</span></div>
    </div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Inhalation</div>
        <div class="data-value"><span data-field="first_aid_inhalation">{{ first_aid_inhalation }}</span></div>
    </div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Skin contact</div>
        <div class="data-value"><span data-field="first_aid_skin_contact">{{ first_aid_skin_contact }}</span></div>
    </div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Eye contact</div>
        <div class="data-value"><span data-field="first_aid_eye_contact">{{ first_aid_eye_contact }}</span></div>
    </div>
</div>

<div class="page">
    <div class="section-header">SECTION 5. FIRE FIGHTING MEASURES</div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Flammable properties</div>
        <div class="data-value">
            <div class="data-row">
                <div class="data-label">Flash point</div>
                <div class="data-value"><span data-field="flash_point">{{ flash_point }}</span></div>
            </div>
            <div class="data-row">
                <div class="data-label">Method:</div>
                <div class="data-value"><span data-field="flash_point_method">{{ flash_point_method }}</span></div>
            </div>
        </div>
    </div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Fire fighting</div>
        <div class="data-value">
            <div class="data-row">
                <div class="data-label">Suitable extinguishing media</div>
                <div class="data-value"><span data-field="extinguishing_media">{{ extinguishing_media }}</span></div>
            </div>
            <div class="data-row">
                <div class="data-label">Further information</div>
                <div class="data-value"><span data-field="firefighting_further_info">{{ firefighting_further_info }}</span></div>
            </div>
        </div>
    </div>
</div>

<div class="page">
    <div class="section-header">SECTION 6. ACCIDENTAL RELEASE MEASURES</div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Personal precautions</div>
        <div class="data-value"><span data-field="spill_personal_precautions">{{ spill_personal_precautions }}</span></div>
    </div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Environmental precautions</div>
        <div class="data-value"><span data-field="spill_environmental_precautions">{{ spill_environmental_precautions }}</span></div>
    </div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Methods for containment / Methods for cleaning up</div>
        <div class="data-value"><span data-field="spill_cleanup_methods">{{ spill_cleanup_methods }}</span></div>
    </div>
</div>

<div class="page">
    <div class="section-header">SECTION 7. HANDLING AND STORAGE</div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Handling</div>
        <div class="data-value"><span data-field="handling_advice">{{ handling_advice }}</span></div>
    </div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Advice on protection against fire and explosion</div>
        <div class="data-value"><span data-field="fire_explosion_protection">{{ fire_explosion_protection }}</span></div>
    </div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Storage</div>
        <div class="data-value">
            <div class="data-row">
                <div class="data-label">Further information on storage conditions</div>
                <div class="data-value"><span data-field="storage_conditions">{{ storage_conditions }}</span></div>
            </div>
            <div class="data-row">
                <div class="data-label">Advice on common storage</div>
                <div class="data-value"><span data-field="storage_common_advice">{{ storage_common_advice }}</span></div>
            </div>
        </div>
    </div>
</div>

<div class="page">
    <div class="section-header">SECTION 8. EXPOSURE CONTROLS/PERSONAL PROTECTION</div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Exposure Guidelines</div>
        <div class="data-value"></div>
    </div>

    <table>
        <thead>
            <tr>
                <th style="width: 50%;">Components</th>
                <th style="width: 25%; text-align: center;">CAS-No.</th>
                <th style="width: 25%; text-align: center;">Control parameters</th>
                <th style="width: 25%; text-align: center;">Basis</th>
            </tr>
        </thead>
        <tbody>
            {% for item in exposure_components %}
            <tr>
                <td><span data-field="exposure_components[{{ loop.index0 }}].component">{{ exposure_components[loop.index0].component }}</span></td>
                <td class="center-text"><span data-field="exposure_components[{{ loop.index0 }}].cas_no">{{ exposure_components[loop.index0].cas_no }}</span></td>
                <td class="center-text"><span data-field="exposure_components[{{ loop.index0 }}].control_parameters">{{ exposure_components[loop.index0].control_parameters }}</span></td>
                <td class="center-text"><span data-field="exposure_components[{{ loop.index0 }}].basis">{{ exposure_components[loop.index0].basis }}</span></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="data-row" style="margin-top: 20px;">
        <div class="data-label">Engineering measures</div>
        <div class="data-value"><span data-field="engineering_measures">{{ engineering_measures }}</span></div>
    </div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Personal protective equipment</div>
        <div class="data-value">
            <div class="data-row">
                <div class="data-label">Eye protection</div>
                <div class="data-value"><span data-field="ppe_eye_protection">{{ ppe_eye_protection }}</span></div>
            </div>
            <div class="data-row">
                <div class="data-label">Hand protection</div>
                <div class="data-value"><span data-field="ppe_hand_protection">{{ ppe_hand_protection }}</span></div>
            </div>
        </div>
    </div>
</div>

<div class="page">
    <div class="section-header">SECTION 9. PHYSICAL AND CHEMICAL PROPERTIES</div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Appearance</div>
        <div class="data-value"><span data-field="appearance">{{ appearance }}</span></div>
    </div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Form</div>
        <div class="data-value"><span data-field="form">{{ form }}</span></div>
    </div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Color</div>
        <div class="data-value"><span data-field="color">{{ color }}</span></div>
    </div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Odor</div>
        <div class="data-value"><span data-field="odor">{{ odor }}</span></div>
    </div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Safety data</div>
        <div class="data-value"></div>
    </div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Flash point</div>
        <div class="data-value">
            <div class="data-row">
                <div class="data-label">Value:</div>
                <div class="data-value"><span data-field="flash_point_value">{{ flash_point_value }}</span></div>
            </div>
            <div class="data-row">
                <div class="data-label">Method:</div>
                <div class="data-value"><span data-field="flash_point_method_2">{{ flash_point_method_2 }}</span></div>
            </div>
        </div>
    </div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">pH</div>
        <div class="data-value"><span data-field="ph">{{ ph }}</span></div>
    </div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Starts to boil</div>
        <div class="data-value"><span data-field="boiling_point">{{ boiling_point }}</span></div>
    </div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Vapour pressure</div>
        <div class="data-value"><span data-field="vapour_pressure">{{ vapour_pressure }}</span></div>
    </div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Density</div>
        <div class="data-value"><span data-field="density">{{ density }}</span></div>
    </div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Water solubility</div>
        <div class="data-value"><span data-field="water_solubility">{{ water_solubility }}</span></div>
    </div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">VOC</div>
        <div class="data-value"><span data-field="voc">{{ voc }}</span></div>
    </div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Loss on drying</div>
        <div class="data-value"><span data-field="loss_on_drying">{{ loss_on_drying }}</span></div>
    </div>
</div>

<div class="page">
    <div class="section-header">SECTION 10. STABILITY AND REACTIVITY</div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Conditions to avoid</div>
        <div class="data-value"><span data-field="stability_avoid_conditions">{{ stability_avoid_conditions }}</span></div>
    </div>
</div>

<div class="page">
    <div class="section-header">SECTION 11. TOXICOLOGICAL INFORMATION</div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Data for AZ nLOF 2035 Photoresist</div>
        <div class="data-value"><span data-field="toxicology_general_data">{{ toxicology_general_data }}</span></div>
    </div>

    <div class="data-row" style="margin-top: 15px;">
        <div class="data-label">Data for 1-Methoxy-2-propanol acetate (108-65-6)</div>
        <div class="data-value">
            <div class="data-row" style="margin-top: 10px;">
                <div class="data-label">Acute oral toxicity</div>
                <div class="data-value"><span data-field="toxicity_oral_acute">{{ toxicity_oral_acute }}</span></div>
            </div>
            <div class="data-row">
                <div class="data-label">Acute inhalation toxicity</div>
                <div class="data-value"><span data-field="toxicity_inhalation_acute">{{ toxicity_inhalation_acute }}</span></div>
            </div>
            <div class="data-row">
                <div class="data-label">Acute dermal toxicity</div>
                <div class="data-value"><span data-field="toxicity_dermal_acute">{{ toxicity_dermal_acute }}</span></div>
            </div>
            <div class="data-row">
                <div class="data-label">Skin irritation</div>
                <div class="data-value"><span data-field="toxicity_skin_irritation">{{ toxicity_skin_irritation }}</span></div>
            </div>
            <div class="data-row">
                <div class="data-label">Eye irritation</div>
                <div class="data-value"><span data-field="toxicity_eye_irritation">{{ toxicity_eye_irritation }}</span></div>
            </div>
