<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  table { width: 100%; border-collapse: collapse; margin-top: 20px; }
  th, td { padding: 8px; text-align: left; border-bottom: 1px solid #ddd; }
  th { font-weight: bold; }
</style>

<div class="page">
  <div>
    <div style="font-weight: bold; margin-bottom: 10px;">Curriculum Guide</div>
    <h1 style="font-size: 24pt; margin-top: 0;">Minor in Political Science</h1>
    <div style="display: flex; align-items: center; margin-top: 20px;">
      <div style="background-color: #eee; padding: 5px 10px; font-size: 10pt; margin-right: 20px;">2023-24</div>
      <div style="flex-grow: 1; border-bottom: 1px solid #ccc;"></div>
    </div>
  </div>
</div>

<div class="page">
  <div>
    <h2 style="font-size: 14pt; margin-bottom: 15px;">Required Courses</h2>
    <table>
      <thead>
        <tr>
          <th style="width: 10%;">Item #</th>
          <th style="width: 60%;">Title</th>
          <th style="width: 30%;">Credits</th>
        </tr>
      </thead>
      <tbody>
        {% for course in required_courses %}
        <tr>
          <td><span data-field="required_courses[{{ loop.index0 }}].item_number">{{ course.item_number }}</span></td>
          <td><span data-field="required_courses[{{ loop.index0 }}].title">{{ course.title }}</span></td>
          <td><span data-field="required_courses[{{ loop.index0 }}].credits">{{ course.credits }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    <div style="margin-top: 20px;">
      <p>Sub-Total Credits: <span data-field="total_credits">{{ total_credits }}</span></p>
      <p style="font-size: 10pt;">June 2023</p>
      <p style="font-size: 10pt;">Southwestern Adventist University—Office of Academic Administration</p>
    </div>
  </div>
  <div style="position: absolute; bottom: 50px; right: 60px; font-size: 10pt;">
    <img src="placeholder_logo.png" alt="University Logo" style="height: 30px; vertical-align: middle; margin-right: 10px;">
    <span>SOUTHWESTERN ADVENTIST UNIVERSITY</span>
  </div>
</div>