<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  table { width: 100%; border-collapse: collapse; margin-top: 20px; }
  th, td { padding: 8px; text-align: left; }
  .header-title { font-size: 24pt; font-weight: bold; margin-bottom: 10px; }
  .section-title { font-size: 14pt; font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <div style="background-color: #f0f0f0; padding: 10px 20px; border: 1px solid #ccc;">
      <span data-field="document_title">{{ document_title }}</span>
    </div>
    <div style="border-bottom: 2px solid black; padding-bottom: 5px;">
      <span data-field="program_name">{{ program_name }}</span>
    </div>
  </div>
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px;">
    <div style="font-size: 10pt;">
      <span data-field="academic_year">{{ academic_year }}</span>
    </div>
    <div style="width: 50%; height: 30px; background-color: #e0e0e0;"></div>
  </div>
</div>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px;">
    <div style="width: 50%;">
      <div style="font-size: 10pt;">
        <span data-field="address_street">{{ address_street }}</span><br>
        <span data-field="address_city_state_zip">{{ address_city_state_zip }}</span>
      </div>
      <div style="margin-top: 10px; font-size: 10pt;">
        Phone: <span data-field="phone_number">{{ phone_number }}</span><br>
        Phone: <span data-field="phone_number_alt">{{ phone_number_alt }}</span><br>
        Email: <span data-field="email_address">{{ email_address }}</span>
      </div>
    </div>
    <div style="width: 45%; text-align: right; font-size: 10pt;">
      <img src="placeholder_logo.png" alt="University Logo" style="height: 50px; display: block;">
      <div style="text-align: center; margin-top: 5px;">
        <span data-field="university_name">{{ university_name }}</span>
      </div>
    </div>
  </div>

  <div class="section-title">Required Courses</div>
  <table>
    <thead>
      <tr>
        <th style="width: 10%;">Item #</th>
        <th style="width: 60%;">Title</th>
        <th style="width: 30%;">Credits</th>
      </tr>
    </thead>
    <tbody>
      {% for item in required_courses %}
      <tr>
        <td><span data-field="required_courses[{{ loop.index0 }}].item_number">{{ item.item_number }}</span></td>
        <td><span data-field="required_courses[{{ loop.index0 }}].title">{{ item.title }}</span></td>
        <td><span data-field="required_courses[{{ loop.index0 }}].credits">{{ item.credits }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div style="margin-top: 30px; font-size: 10pt;">
    <span data-field="semester_date">{{ semester_date }}</span><br>
    <span data-field="department_info">{{ department_info }}</span>
  </div>
</div>