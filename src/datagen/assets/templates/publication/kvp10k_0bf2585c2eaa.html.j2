  table { width: 100%; border-collapse: collapse; margin-top: 10px; }
  td, th { padding: 4px 8px; text-align: left; border: 1px solid #000; }
  .header-text { font-weight: bold; }
</style>
<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      <div style="font-size: 14pt; font-weight: bold;">Form 4797</div>
      <div style="font-size: 10pt;">Department of the Treasury</div>
      <div style="font-size: 10pt;">Internal Revenue Service</div>
    </div>
    <div style="text-align: right;">
      <div style="font-size: 14pt; font-weight: bold;">OMB No. 1565-2184</div>
      <div style="font-size: 10pt;">Sequence No. 27</div>
