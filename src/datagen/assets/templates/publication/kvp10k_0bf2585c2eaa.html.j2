<div class="page">
  <div style="text-align: right;">
    <span data-field="document_title">{{ document_title }}</span>
    <div style="font-size: small; margin-top: 5px;">Form 1040</div>
  </div>
  <div style="margin-top: 20px;">
    <div style="display: flex; justify-content: space-between;">
      <div style="width: 45%;">
        <div style="font-weight: bold; margin-bottom: 5px;">Taxpayer Information</div>
        <div class="form-row">
          <div style="width: 30%;">Name:</div>
          <div style="width: 70%;"><span data-field="taxpayer_full_name">{{ taxpayer_full_name }}</span></div>
        </div>
        <div class="form-row">
          <div style="width: 30%;">Social Security Number:</div>
          <div style="width: 70%;"><span data-field="taxpayer_ssn">{{ taxpayer_ssn }}</span></div>
        </div>
        <div class="form-row">
          <div style="width: 30%;">Address:</div>
          <div style="width: 70%;"><span data-field="taxpayer_address">{{ taxpayer_address }}</span></div>
        </div>
      </div>
      <div style="width: 45%;">
        <div style="font-weight: bold; margin-bottom: 5px;">Filing Status</div>
        <div style="margin-top: 10px;">
          <label><input type="radio" name="filing_status" value="single"> Single</label>
          <label><input type="radio" name="filing_status" value="married"> Married Filing Jointly</label>
          <label><input type="radio" name="filing_status" value="head_of_household"> Head of Household</label>
        </div>
        <div style="margin-top: 15px;">
          <div style="font-weight: bold;">Dependents</div>
          <div class="form-row">
            <div style="width: 30%;">Number:</div>
            <div style="width: 70%;"><span data-field="dependent_count">{{ dependent_count }}</span></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="section-title">Filing Status & Dependents</div>
  <div style="margin-top: 10px;">
    <p>Check one box:</p>
    <div style="margin-top: 10px;">
      <label><input type="checkbox" name="check_box_1"> Single</label>
      <label><input type="checkbox" name="check_box_2"> Married Filing Jointly</label>
      <label><input type="checkbox" name="check_box_3"> Head of Household</label>
    </div>
  </div>

  <div class="section-title">Exemptions</div>
  <div style="margin-top: 10px;">
    <p>Check one box:</p>
    <div style="margin-top: 10px;">
      <label><input type="checkbox" name="exemptions_check_1"> No exemptions</label>
      <label><input type="checkbox" name="exemptions_check_2"> Claim exemptions</label>
    </div>
  </div>

  <div class="section-title">Income</div>
  <table style="margin-top: 10px;">
    <thead>
      <tr>
        <th style="width: 5%;">No.</th>
        <th style="width: 45%;">Description</th>
        <th style="width: 20%; text-align: right;">Amount</th>
        <th style="width: 30%; text-align: right;">Amount</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>1a</td>
        <td>Wages, salaries, tips, etc. (See Form W-2)</td>
        <td style="text-align: right;"><span data-field="income_wages_amount">{{ income_wages_amount }}</span></td>
        <td style="text-align: right;"><span data-field="income_wages_tax_amount">{{ income_wages_tax_amount }}</span></td>
      </tr>
      <tr>
        <td>1b</td>
        <td>Taxable interest income</td>
        <td style="text-align: right;"><span data-field="income_interest_amount">{{ income_interest_amount }}</span></td>
        <td style="text-align: right;"><span data-field="income_interest_tax_amount">{{ income_interest_tax_amount }}</span></td>
      </tr>
      <tr>
        <td>2a</td>
        <td>Ordinary dividends</td>
        <td style="text-align: right;"><span data-field="income_dividends_amount">{{ income_dividends_amount }}</span></td>
        <td style="text-align: right;"><span data-field="income_dividends_tax_amount">{{ income_dividends_tax_amount }}</span></td>
      </tr>
      <tr>
        <td>3a</td>
        <td>Capital gain or loss</td>
        <td style="text-align: right;"><span data-field="income_capital_gain_amount">{{ income_capital_gain_amount }}</span></td>
        <td style="text-align: right;"><span data-field="income_capital_gain_tax_amount">{{ income_capital_gain_tax_amount }}</span></td>
      </tr>
      {% for item in income_items %}
      <tr>
        <td>{{ loop.index }}</td>
        <td><span data-field="income_item_description_{{ loop.index0 }}">{{ item.description }}</span></td>
        <td style="text-align: right;"><span data-field="income_item_amount_{{ loop.index0 }}">{{ item.amount }}</span></td>
        <td style="text-align: right;"><span data-field="income_item_tax_amount_{{ loop.index0 }}">{{ item.tax_amount }}</span></td>
      </tr>
      {% endfor %}
      <tr>
        <td>18</td>
        <td>Total income</td>
        <td style="text-align: right;"><span data-field="total_income_amount">{{ total_income_amount }}</span></td>
        <td style="text-align: right;"><span data-field="total_income_tax_amount">{{ total_income_tax_amount }}</span></td>
      </tr>
    </tbody>
  </table>

  <div class="section-title">Adjustments to Income</div>
  <table style="margin-top: 10px;">
    <thead>
      <tr>
        <th style="width: 5%;">No.</th>
        <th style="width: 45%;">Description</th>
        <th style="width: 20%; text-align: right;">Amount</th>
        <th style="width: 30%; text-align: right;">Amount</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>20</td>
        <td>Adjustments to income</td>
        <td style="text-align: right;"><span data-field="adj_income_amount">{{ adj_income_amount }}</span></td>
        <td style="text-align: right;"><span data-field="adj_income_tax_amount">{{ adj_income_tax_amount }}</span></td>
      </tr>
      {% for item in adjustment_items %}
      <tr>
        <td>{{ loop.index }}</td>
        <td><span data-field="adj_item_description_{{ loop.index0 }}">{{ item.description }}</span></td>
        <td style="text-align: right;"><span data-field="adj_item_amount_{{ loop.index0 }}">{{ item.amount }}</span></td>
        <td style="text-align: right;"><span data-field="adj_item_tax_amount_{{ loop.index0 }}">{{ item.tax_amount }}</span></td>
      </tr>
      {% endfor %}
      <tr>
        <td>30</td>
        <td>Adjusted gross income</td>
        <td style="text-align: right;"><span data-field="adjusted_gross_income_amount">{{ adjusted_gross_income_amount }}</span></td>
        <td style="text-align: right;"><span data-field="adjusted_gross_income_tax_amount">{{ adjusted_gross_income_tax_amount }}</span></td>
      </tr>
    </tbody>
  </table>

  <div class="section-title">Tax and Credits</div>
  <table style="margin-top: 10px;">
    <thead>
      <tr>
        <th style="width: 5%;">No.</th>
        <th style="width: 45%;">Description</th>
        <th style="width: 20%; text-align: right;">Amount</th>
        <th style="width: 30%; text-align: right;">Amount</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>33</td>
        <td>Taxable income</td>
        <td style="text-align: right;"><span data-field="taxable_income_amount">{{ taxable_income_amount }}</span></td>
        <td style="text-align: right;"><span data-field="taxable_income_tax_amount">{{ taxable_income_tax_amount }}</span></td>
      </tr>
      {% for item in tax_credit_items %}
      <tr>
        <td>{{ loop.index }}</td>
        <td><span data-field="tax_credit_description_{{ loop.index0 }}">{{ item.description }}</span></td>
        <td style="text-align: right;"><span data-field="tax_credit_amount_{{ loop.index0 }}">{{ item.amount }}</span></td>
        <td style="text-align: right;"><span data-field="tax_credit_tax_amount_{{ loop.index0 }}">{{ item.tax_amount }}</span></td>
      </tr>
      {% endfor %}
      <tr>
        <td>40</td>
        <td>Total tax</td>
        <td style="text-align: right;"><span data-field="total_tax_amount">{{ total_tax_amount }}</span></td>
        <td style="text-align: right;"><span data-field="total_tax_tax_amount">{{ total_tax_tax_amount }}</span></td>
      </tr>
    </tbody>
  </table>

  <div class="section-title">Payments and Refund</div>
  <table style="margin-top: 10px;">
    <thead>
      <tr>
        <th style="width: 5%;">No.</th>
        <th style="width: 45%;">Description</th>
        <th style="width: 20%; text-align: right;">Amount</th>
        <th style="width: 30%; text-align: right;">Amount</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>51</td>
        <td>Federal income tax withheld</td>
        <td style="text-align: right;"><span data-field="withheld_amount">{{ withheld_amount }}</span></td>
        <td style="text-align: right;"><span data-field="withheld_tax_amount">{{ withheld_tax_amount }}</span></td>
      </tr>
      {% for item in payment_items %}
      <tr>
        <td>{{ loop.index }}</td>
        <td><span data-field="payment_description_{{ loop.index0 }}">{{ item.description }}</span></td>
        <td style="text-align: right;"><span data-field="payment_amount_{{ loop.index0 }}">{{ item.amount }}</span></td>
        <td style="text-align: right;"><span data-field="payment_tax_amount_{{ loop.index0 }}">{{ item.tax_amount }}</span></td>
      </tr>
      {% endfor %}
      <tr>
        <td>60</td>
        <td>Total payments</td>
        <td style="text-align: right;"><span data-field="total_payments_amount">{{ total_payments_amount }}</span></td>
        <td style="text-align: right;"><span data-field="total_payments_tax_amount">{{ total_payments_tax_amount }}</span></td>
      </tr>
    </tbody>
  </table>

  <div class="section-title">Refund or Amount Owed</div>
  <table style="margin-top: 10px;">
    <thead>
      <tr>
        <th style="width: 5%;">No.</th>
        <th style="width: 45%;">Description</th>
        <th style="width: 20%; text-align: right;">Amount</th>
        <th style="width: 30%; text-align: right;">Amount</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>70</td>
        <td>Amount of refund or amount you owe</td>
        <td style="text-align: right;"><span data-field="refund_owed_amount">{{ refund_owed_amount }}</span></td>
        <td style="text-align: right;"><span data-field="refund_owed_tax_amount">{{ refund_owed_tax_amount }}</span></td>
      </tr>
    </tbody>
  </table>

  <div style="margin-top: 50px; text-align: center; font-size: small;">
    <span data-field="page_number">{{ page_number }}</span>
  </div>
</div>
