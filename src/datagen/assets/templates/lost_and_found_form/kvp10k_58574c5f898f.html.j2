<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    color: #000;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
  }
  th, td {
    border: 1px solid #000;
    padding: 8px;
    text-align: left;
    vertical-align: top;
  }
  th {
    font-weight: bold;
    font-size: 12pt;
  }
  .header-row td {
    padding-bottom: 5px;
  }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px;">
    <div>
      <h1 style="font-size: 16pt; margin: 0;">University Surplus and Salvage</h1>
      <h2 style="font-size: 14pt; margin-top: 5px;">Lost and Found Property Form</h2>
    </div>
    <div style="text-align: right;">
      <p style="font-size: 10pt; margin: 0;">Please attach this form to a Retirement / Transfer (RT) form before submitting it and the lost and found to the University Surplus and Salvage Department.</p>
      <p style="font-size: 10pt; margin-top: 5px;">On the RT form in the asset section write lost and found and see attached.</p>
    </div>
  </div>

  <div style="display: flex; justify-content: space-between; margin-bottom: 30px; font-size: 10pt;">
    <div style="width: 30%;">
      <label for="campus_address" style="display: block; margin-bottom: 5px;">Campus Address:</label>
      <div style="border-bottom: 1px solid #000; padding-bottom: 2px;">
        <span data-field="campus_address">{{ campus_address }}</span>
      </div>
    </div>
    <div style="width: 30%; text-align: center;">
      <label for="signature" style="display: block; margin-bottom: 5px;">Signature:</label>
      <div style="border-bottom: 1px solid #000; padding-bottom: 2px; margin-top: 20px;">
        <span data-field="signature">{{ signature }}</span>
      </div>
    </div>
    <div style="width: 30%; text-align: right;">
      <label for="department" style="display: block; margin-bottom: 5px;">Department:</label>
      <div style="border-bottom: 1px solid #000; padding-bottom: 2px;">
        <span data-field="department">{{ department }}</span>
      </div>
    </div>
  </div>

  <table style="margin-top: 20px;">
    <thead>
      <tr class="header-row">
        <th style="width: 20%;">Description (Make, Model, Serial, Color & Size)</th>
        <th style="width: 10%;">Date Found</th>
        <th style="width: 10%;">Time Found</th>
        <th style="width: 10%;">Where Found</th>
        <th style="width: 10%;">How Obtained</th>
        <th style="width: 10%;">Is the owner known?</th>
        <th style="width: 10%;">Is in the property stolen?</th>
        <th style="width: 10%;">Is the property legal to possess?</th>
        <th style="width: 10%;">Date Owner Notified</th>
      </tr>
    </thead>
    <tbody>
      {% for item in line_items %}
      <tr>
        <td><span data-field="line_items[{{ loop.index0 }}].description">{{ item.description }}</span></td>
        <td><span data-field="line_items[{{ loop.index0 }}].date_found">{{ item.date_found }}</span></td>
        <td><span data-field="line_items[{{ loop.index0 }}].time_found">{{ item.time_found }}</span></td>
        <td><span data-field="line_items[{{ loop.index0 }}].where_found">{{ item.where_found }}</span></td>
        <td><span data-field="line_items[{{ loop.index0 }}].how_obtained">{{ item.how_obtained }}</span></td>
        <td>
          {% if item.is_owner_known %}
            <span data-field="line_items[{{ loop.index0 }}].is_owner_known_yes">{{ line_items[loop.index0].is_owner_known_yes }}</span>
          {% else %}
            <span data-field="line_items[{{ loop.index0 }}].is_owner_known_no">{{ line_items[loop.index0].is_owner_known_no }}</span>
          {% endif %}
        </td>
        <td>
          {% if item.is_stolen %}
            <span data-field="line_items[{{ loop.index0 }}].is_stolen_yes">{{ line_items[loop.index0].is_stolen_yes }}</span>
          {% else %}
            <span data-field="line_items[{{ loop.index0 }}].is_stolen_no">{{ line_items[loop.index0].is_stolen_no }}</span>
          {% endif %}
        </td>
        <td>
          {% if item.is_legal_to_possess %}
            <span data-field="line_items[{{ loop.index0 }}].is_legal_to_possess_yes">{{ line_items[loop.index0].is_legal_to_possess_yes }}</span>
          {% else %}
            <span data-field="line_items[{{ loop.index0 }}].is_legal_to_possess_no">{{ line_items[loop.index0].is_legal_to_possess_no }}</span>
          {% endif %}
        </td>
        <td><span data-field="line_items[{{ loop.index0 }}].date_owner_notified">{{ item.date_owner_notified }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>