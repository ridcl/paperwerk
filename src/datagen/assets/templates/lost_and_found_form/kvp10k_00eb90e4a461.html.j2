<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1, h2, h3 { text-align: center; }
  .form-section { margin-bottom: 20px; }
  .label-field { display: block; margin-bottom: 5px; font-weight: bold; }
  .field-value { display: block; margin-bottom: 15px; }
</style>

<div class="page">
    <!-- Logo Placeholder (Visual element, no data field needed) -->
    <div style="text-align: center; margin-bottom: 30px;">
        <!-- Placeholder for Police Seal -->
        <img src="placeholder_seal.png" alt="Seal" style="width: 100px; height: auto;">
    </div>

    <h1 style="text-align: center; font-size: 18pt; margin-bottom: 10px;">Return This Form and Property to</h1>
    <h2 style="text-align: center; font-size: 14pt; margin-top: 0;">
        <span data-field="department.name">{{ department.name }}</span><br>
        <span data-field="department.address">{{ department.address }}</span>
    </h2>

    <div style="text-align: center; margin-bottom: 30px;">
        <p style="margin: 5px 0;">
            <span data-field="department.phone">{{ department.phone }}</span> or <span data-field="department.phone_alt">{{ department.phone_alt }}</span>
        </p>
        <p style="margin: 5px 0;">
            Public Safety is open <span data-field="hours">{{ hours }}</span>.
        </p>
    </div>

    <div class="form-section">
        <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
            <div>
                <span class="label-field">Date Found:</span>
                <span data-field="date_found" class="field-value">{{ date_found }}</span>
            </div>
            <div>
                <span class="label-field">Date sent to Public Safety:</span>
                <span data-field="date_sent" class="field-value">{{ date_sent }}</span>
            </div>
        </div>
    </div>

    <div class="form-section">
        <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
            <div>
                <span class="label-field">Location property was found:</span>
                <span data-field="location_found" class="field-value">{{ location_found }}</span>
            </div>
            <div>
                <span class="label-field">Contact phone number:</span>
                <span data-field="contact_phone" class="field-value">{{ contact_phone }}</span>
            </div>
        </div>
    </div>

    <div class="form-section">
        <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
            <div>
                <span class="label-field">Found by:</span>
                <span data-field="found_by" class="field-value">{{ found_by }}</span>
            </div>
            <div>
                <span class="label-field">Department:</span>
                <span data-field="department_found_by" class="field-value">{{ department_found_by }}</span>
            </div>
        </div>
    </div>

    <div class="form-section">
        <span class="label-field">Description of found item(s):</span>
        <div class="field-value" style="min-height: 50px; border-bottom: 1px solid #ccc; padding-bottom: 10px;">
            <span data-field="description_items" style="display: block;">{{ description_items }}</span>
        </div>
    </div>

    <div style="margin-top: 50px; text-align: center; font-size: 10pt;">
        Please print out this form and return to Public Safety with found property. Thank you for your assistance.
    </div>
</div>