<!DOCTYPE html>
<html>
<head>
    <title>Document Conversion</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 { text-align: center; }
        .header-block { text-align: center; margin-bottom: 30px; }
        .logo { margin: 20px 0; }
        .title-section { text-align: center; margin-top: 40px; }
        .metadata { text-align: center; margin-top: 20px; font-size: 0.9em; }
        .contact-info { margin-top: 50px; border-top: 1px solid #ccc; padding-top: 20px; }
        .table-container { margin-top: 30px; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th, td { padding: 8px 12px; text-align: left; border-bottom: 1px solid #ddd; }
        th { background-color: #f2f2f2; }
        .toc-entry { display: flex; justify-content: space-between; padding: 3px 0; }
        .toc-entry span:first-child { flex-grow: 1; }
        .toc-entry span:last-child { width: 30px; text-align: right; }
    </style>

<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    margin: 0;
    padding: 0;
  }
</style>
</head>
<body>

<div class="page">
    <div class="header-block">
        <span style="font-size: 1.5em; font-weight: bold;">University of Pennsylvania</span>
        <div class="logo">
            <!-- Placeholder for University Seal -->
            <img src="" alt="Seal" style="width: 100px; height: auto;">
        </div>
        <div style="font-size: 1.2em;">The University Archives and Records Center</div>
    </div>

    <div class="title-section">
        <h1 style="font-size: 2em;">A Guide to the <span data-field="record_name">{{ record_name }}</span></h1>
        <h2 style="font-size: 1.5em;">{{ record_date_range }} (bulk {{ record_date_range_detail }})</h2>
        <p style="margin-top: 30px;">{{ volume_size }}</p>
        <div class="metadata">
            UPC {{ upc_number }}
        </div>
        <p style="margin-top: 50px; font-size: 0.9em;">Prepared by {{ preparer_name }}</p>
        <p style="font-size: 0.9em;">{{ preparation_date }}</p>
    </div>
</div>

<div class="page">
    <div class="contact-info">
        <p>The University Archives and Records Center</p>
        <p>{{ address_line_1 }}</p>
        <p>{{ city_state_zip }}</p>
        <p>Phone: {{ phone_number }}</p>
        <p>Fax: {{ fax_number }}</p>
        <p>{{ website_url }}</p>
        <p>{{ director_name }}, Director</p>
    </div>
</div>

<div class="page">
    <div style="text-align: center; margin-bottom: 40px;">
        <h2 style="font-size: 1.5em;">Abrahamsohn Christmas and Easter Committee Records</h2>
        <p>UPC {{ upc_number }}</p>
    </div>

    <div style="text-align: center; margin-bottom: 30px;">
        <h3 style="font-size: 1.2em;">TABLE OF CONTENTS</h3>
    </div>

    <div class="table-container">
        {% for section in table_of_contents %}
        <div class="toc-entry">
            <span>{{ section.title }}</span>
            <span>{{ section.page_number }}</span>
        </div>
        {% endfor %}
    </div>
</div>

<div class="page">
