    </tr>
    <tr>
      <td style="padding-bottom: 5px;"><span data-field="toc_inventory">{{ toc_inventory }}</span></td>
      <td class="right" style="padding-bottom: 5px;">3</td>
    </tr>
    <tr>
      <td style="padding-bottom: 5px;"><span data-field="toc_individual">{{ toc_individual }}</span></td>
