  </div>
  <table style="width: 100%; border-collapse: collapse;">
    <tr>
      <td style="padding-bottom: 5px;"><span data-field="toc_provenance">{{ toc_provenance }}</span></td>
      <td class="right" style="padding-bottom: 5px;">1</td>
    </tr>
    <tr>
      <td style="padding-bottom: 5px;"><span data-field="toc_arrangement">{{ toc_arrangement }}</span></td>
      <td class="right" style="padding-bottom: 5px;">1</td>
    </tr>
