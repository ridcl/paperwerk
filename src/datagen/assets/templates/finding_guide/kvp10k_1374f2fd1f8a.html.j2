  }
  .page:last-child { page-break-after: auto; }
  table { width: 100%; border-collapse: collapse; margin-top: 10px; }
  td { padding: 5px 0; }
</style>
</head>
<body>

<div class="page">
  <div class="center">
    <span style="font-size: 24pt;">University of Pennsylvania</span>
    <div style="margin: 20px 0;">
      <!-- Placeholder for University Seal Image -->
      <div style="width: 100px; height: 100px; border: 1px solid #ccc; margin: 0 auto;"></div>
    </div>
    <span style="font-size: 16pt;">The University Archives</span>
    <span style="font-size: 16pt;">and Records Center</span>
  </div>
  <div class="center" style="margin-top: 50px;">
    <span style="font-size: 14pt;">A Guide to the</span>
    <span style="font-size: 14pt;">Awards and Certificate Collection</span>
    <span style="font-size: 14pt;">1775-2006 (bulk 1893-1994)</span>
  </div>
  <div class="center" style="margin-top: 30px;">
    <span style="font-size: 12pt;">4.0 Cubic feet</span>
    <span style="font-size: 12pt;">UPP 500</span>
  </div>
  <div class="center" style="margin-top: 80px;">
    Prepared by <span data-field="prepared_by_name">{{ prepared_by_name }}</span><br>
    <span data-field="prepared_date">{{ prepared_date }}</span>
  </div>
</div>

<div class="page">
  <div class="left">
    <span style="font-weight: bold;">The University Archives and Records Center</span><br>
    <span data-field="address_line_1">{{ address_line_1 }}</span><br>
    <span data-field="address_line_2">{{ address_line_2 }}</span><br>
    <span data-field="phone">{{ phone }}</span><br>
    Fax: <span data-field="fax">{{ fax }}</span><br>
    <span data-field="website">{{ website }}</span><br>
    <span data-field="director_name">{{ director_name }}</span>, Director
  </div>
</div>

