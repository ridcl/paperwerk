<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  h1, h2, h3, h4, h5, h6 {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial;
  }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px;">
    <div style="font-size: 36px; font-weight: bold;">CSUN.</div>
    <div style="font-size: 40px;">
      <img src="placeholder_logo.png" alt="University Logo" style="height: 60px;">
    </div>
  </div>

  <div style="display: flex; justify-content: space-between; margin-bottom: 60px;">
    <div>
      <span data-field="date">{{ date }}</span>
    </div>
    <div>
      <p style="font-weight: bold;">Contact:</p>
      <p><span data-field="contact.name">{{ contact.name }}</span></p>
      <p><span data-field="contact.email">{{ contact.email }}</span></p>
      <p><span data-field="contact.affiliation">{{ contact.affiliation }}</span></p>
      <p><span data-field="contact.address">{{ contact.address }}</span></p>
    </div>
  </div>

  <div style="margin-bottom: 40px;">
    <h2 style="font-size: 24px; font-weight: bold;">Media Alert</h2>
  </div>

  <div style="display: flex; flex-direction: column; gap: 20px;">
    <div>
      <p style="font-weight: bold; margin-bottom: 5px;">WHAT:</p>
      <p><span data-field="event_summary">{{ event_summary }}</span></p>
    </div>
    <div>
      <p style="font-weight: bold; margin-bottom: 5px;">WHO:</p>
      <p><span data-field="organizer">{{ organizer }}</span></p>
    </div>
    <div>
      <p style="font-weight: bold; margin-bottom: 5px;">WHEN:</p>
      <p><span data-field="event_date_time">{{ event_date_time }}</span></p>
    </div>
    <div>
      <p style="font-weight: bold; margin-bottom: 5px;">WHERE:</p>
      <p><span data-field="event_location">{{ event_location }}</span></p>
    </div>
    <div>
      <p style="font-weight: bold; margin-bottom: 5px;">WHY:</p>
      <p><span data-field="event_purpose">{{ event_purpose }}</span></p>
    </div>
    <div>
      <p style="font-weight: bold; margin-bottom: 5px;">BACKGROUND:</p>
      <p><span data-field="background_text">{{ background_text }}</span></p>
    </div>
  </div>

  <div style="margin-top: 80px; padding-top: 20px; border-top: 1px solid #ccc;">
    <p style="font-size: 12px; color: #555;">The University Student Union (USU) is committed to inclusion, diversity and personal growth for all students while providing services such as study areas, lounge spaces, prayer room, lactation room and wireless printing kiosks in addition to a variety of food options and a wide range of events. The USU includes the Student Recreation Center, Oasis Wellness Center, Pride Center, Veterans Resource Center, USU Board of Directors, Computer Lab, Games Room, USU Programs and more. For additional information, please visit <a href="#" style="color: #000;">{{ website_url }}</a>.</p>
  </div>

  <div style="margin-top: 60px; padding-top: 20px; border-top: 1px solid #ccc; font-size: 12px;">
    <p><span data-field="footer.institution">{{ footer.institution }}</span> • <span data-field="footer.address">{{ footer.address }}</span> • <span data-field="footer.website">{{ footer.website }}</span></p>
  </div>
</div>