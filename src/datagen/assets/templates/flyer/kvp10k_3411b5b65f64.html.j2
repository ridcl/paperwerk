<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  h1 { font-size: 36pt; font-weight: bold; }
  h2 { font-size: 18pt; font-weight: bold; }
  .form-group { margin-bottom: 15px; }
  .form-group label { display: block; margin-bottom: 5px; font-weight: bold; }
  .form-group input[type="text"] { width: 100%; padding: 8px; border: 1px solid #ccc; box-sizing: border-box; }
  .button-grid { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 30px; justify-content: space-around; }
  .sign-box { border: 2px solid #333; padding: 15px; text-align: center; flex-basis: 22%; min-width: 150px; }
  .sign-box h3 { font-size: 16pt; margin: 5px 0; }
  .sign-box p { font-size: 10pt; margin: 5px 0; }
  .sign-box input[type="text"] { width: 90%; padding: 5px; margin-top: 10px; }
  .header-logo { float: left; margin-right: 20px; }
  .header-title { float: right; }
</style>

<div class="page">
  <div class="header-logo">
    <!-- Placeholder for University Logo -->
    <span style="font-size: 24pt;">[Logo Placeholder]</span>
  </div>
  <div class="header-title">
    <h1>COVID-19 Signs</h1>
  </div>
  <div style="clear: both;"></div>

  <p style="font-size: 14pt; margin-top: 20px;">Please call extension <span data-field="extension_number">{{ extension_number }}</span> before you pick up your COVID-19 signs.</p>

  <div style="margin-top: 30px;">
    <h2>Download and complete the form.</h2>
    <p style="font-size: 14pt;">Please email to <span data-field="email_address">{{ email_address }}</span>.</p>
  </div>

  <div style="display: flex; justify-content: space-between; margin-top: 40px;">
    <div style="flex-basis: 40%;">
      <div class="form-group">
        <label>Name:</label>
        <input type="text" data-field="full_name" value="{{ full_name }}">
      </div>
      <div class="form-group">
        <label>Department:</label>
        <input type="text" data-field="department_name" value="{{ department_name }}">
      </div>
      <div class="form-group">
        <label>Phone Number:</label>
        <input type="text" data-field="phone_number" value="{{ phone_number }}">
      </div>
      <div class="form-group">
        <label>Email:</label>
        <input type="text" data-field="email_address_input" value="{{ email_address_input }}">
      </div>
    </div>

    <div style="flex-basis: 55%; text-align: right;">
      <div style="border: 2px solid #333; padding: 15px; width: 200px; text-align: center;">
        <h3 style="color: #CC0000;">WELCOME!</h3>
        <p style="font-size: 10pt;">Please remember to practice physical distancing, and the wearing of a mask is <span style="font-weight: bold;">required</span>.</p>
        <div style="margin-top: 15px;">
          <p style="font-size: 10pt;">Mask Required</p>
          <input type="text" data-field="mask_required_quantity" style="width: 80%;" value="{{ mask_required_quantity }}">
        </div>
      </div>
    </div>
  </div>

  <div style="margin-top: 40px; text-align: center;">
    <p style="font-size: 12pt; font-weight: bold;">The signs are no cost to you.</p>
    <p style="font-size: 12pt;">We just ask that you order only what you need and reorder as needed.</p>
  </div>

  <div class="button-grid">
    <!-- Row 1 -->
    <div class="sign-box">
      <h3 style="color: #000;">NO LION SITS HERE</h3>
      <p>Quantity:</p>
      <input type="text" data-field="line_items[0].quantity" value="{{ line_items[0].quantity }}">
    </div>
    <div class="sign-box">
      <h3 style="color: #000;">STOP</h3>
      <p>(256) 765-</p>
      <p>before entering.</p>
      <p>Quantity:</p>
      <input type="text" data-field="line_items[1].quantity" value="{{ line_items[1].quantity }}">
    </div>
    <div class="sign-box">
      <h3 style="color: #000;">FACE COVERINGS REQUIRED ON ELEVATORS</h3>
      <p>Quantity:</p>
      <input type="text" data-field="line_items[2].quantity" value="{{ line_items[2].quantity }}">
    </div>
    <div class="sign-box">
      <h3 style="color: #000;">HEALTHY HYGIENE</h3>
      <p>Quantity:</p>
      <input type="text" data-field="line_items[3].quantity" value="{{ line_items[3].quantity }}">
    </div>
    <div class="sign-box">
      <h3 style="color: #000;">BATHROOM SIGN</h3>
      <p>Quantity:</p>
      <input type="text" data-field="line_items[4].quantity" value="{{ line_items[4].quantity }}">
    </div>
  </div>

  <div class="button-grid" style="margin-top: 20px;">
    <!-- Row 2 -->
    <div class="sign-box">
      <h3 style="color: #000;">ONE WAY</h3>
      <p>Direction Sign Left</p>
      <p>Quantity:</p>
      <input type="text" data-field="line_items[5].quantity" value="{{ line_items[5].quantity }}">
    </div>
    <div class="sign-box">
      <h3 style="color: #000;">ONE WAY</h3>
      <p>Direction Sign Right</p>
      <p>Quantity:</p>
      <input type="text" data-field="line_items[6].quantity" value="{{ line_items[6].quantity }}">
    </div>
    <div class="sign-box">
      <h3 style="color: #000;">ENTRANCE ONLY</h3>
      <p>Quantity:</p>
      <input type="text" data-field="line_items[7].quantity" value="{{ line_items[7].quantity }}">
    </div>
    <div class="sign-box">
      <h3 style="color: #000;">EXIT ONLY</h3>
      <p>Quantity:</p>
      <input type="text" data-field="line_items[8].quantity" value="{{ line_items[8].quantity }}">
    </div>
  </div>

  <div style="text-align: center; margin-top: 60px; font-size: 12pt;">
    The UNA Print Shop hours are <span data-field="hours_start">{{ hours_start }}</span> - <span data-field="hours_end">{{ hours_end }}</span>.
  </div>
</div>