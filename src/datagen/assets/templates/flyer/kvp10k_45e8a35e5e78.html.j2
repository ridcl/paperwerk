<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; /* Using serif fonts as a base */
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  h1 { font-size: 24pt; font-weight: bold; margin-bottom: 10px; }
  .contact-block { margin-bottom: 30px; }
  .contact-block p { margin: 2px 0; font-size: 11pt; line-height: 1.4; }
</style>

<div class="page">
  <h1>Low-Cost Vision Care in Chicago</h1>

  <div class="contact-block">
    <p><strong>Winfield Moody Health Center</strong></p>
    <p><span data-field="address.street">{{ address.street }}</span></p>
    <p><span data-field="address.city">{{ address.city }}</span>, <span data-field="address.state">{{ address.state }}</span> <span data-field="address.zip">{{ address.zip }}</span></p>
    <p><span data-field="phone">{{ phone }}</span></p>
    <p><span data-field="website">{{ website }}</span></p>
  </div>

  <div class="contact-block">
    <p><strong>Illinois Eye Institute</strong></p>
    <p><span data-field="address.street">{{ address.street }}</span></p>
    <p><span data-field="address.city">{{ address.city }}</span>, <span data-field="address.state">{{ address.state }}</span> <span data-field="address.zip">{{ address.zip }}</span></p>
    <p><span data-field="phone">{{ phone }}</span></p>
    <p><span data-field="website">{{ website }}</span></p>
  </div>

  <div class="contact-block">
    <p><strong>Erie Family Health Center</strong></p>
    <p><span data-field="address.street">{{ address.street }}</span></p>
    <p><span data-field="address.city">{{ address.city }}</span>, <span data-field="address.state">{{ address.state }}</span> <span data-field="address.zip">{{ address.zip }}</span></p>
    <p><span data-field="phone">{{ phone }}</span></p>
    <p><span data-field="website">{{ website }}</span></p>
  </div>

  <div class="contact-block">
    <p><strong>Englewood Neighborhood Health Center</strong></p>
    <p><span data-field="address.street">{{ address.street }}</span></p>
    <p><span data-field="address.city">{{ address.city }}</span>, <span data-field="address.state">{{ address.state }}</span></p>
    <p><span data-field="phone">{{ phone }}</span></p>
  </div>
</div>