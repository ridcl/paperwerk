<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1, h2 { text-align: center; font-weight: bold; }
  .header-info { display: flex; justify-content: space-between; margin-bottom: 30px; }
  .contact-info div { margin-bottom: 5px; }
  .form-section { margin-bottom: 30px; }
  .signature-line { display: flex; justify-content: space-between; margin-top: 50px; }
  .line-item { margin-bottom: 15px; }
</style>

<div class="page">
  <div style="text-align: center; margin-bottom: 20px;">
    <img src="placeholder_logo.png" alt="Logo" style="height: 60px; margin-bottom: 10px;">
    <h1 style="font-size: 18pt; margin: 0;">FAIRLEIGH DICKINSON UNIVERSITY</h1>
  </div>

  <div class="header-info">
    <div style="text-align: left;">
      <h2 style="font-size: 14pt; margin: 0;">THE LEADER IN GLOBAL EDUCATION</h2>
    </div>
    <div style="text-align: right;">
      <h2 style="font-size: 14pt; margin: 0;">CHANGE OF NAME APPLICATION</h2>
    </div>
  </div>

  <div class="contact-info" style="display: flex; justify-content: space-between; margin-bottom: 40px;">
    <div style="width: 45%;">
      <div style="font-weight: bold;">Florham Campus</div>
      <div><span data-field="address.street">{{ address.street }}</span></div>
      <div><span data-field="address.city">{{ address.city }}</span>, <span data-field="address.state">{{ address.state }}</span> <span data-field="address.zip">{{ address.zip }}</span></div>
      <div>Phone: <span data-field="phone">{{ phone }}</span></div>
      <div>Fax: <span data-field="fax">{{ fax }}</span></div>
    </div>
    <div style="width: 45%; text-align: right;">
      <div style="font-weight: bold;">Metropolitan Campus</div>
      <div><span data-field="address.street_metropolitan">{{ address.street_metropolitan }}</span></div>
      <div><span data-field="address.city_metropolitan">{{ address.city_metropolitan }}</span>, <span data-field="address.state_metropolitan">{{ address.state_metropolitan }}</span> <span data-field="address.zip_metropolitan">{{ address.zip_metropolitan }}</span></div>
      <div>Phone: <span data-field="phone_metropolitan">{{ phone_metropolitan }}</span></div>
      <div>Fax: <span data-field="fax_metropolitan">{{ fax_metropolitan }}</span></div>
    </div>
  </div>

  <div class="form-section">
    <p>Required: 2 forms of documentation (must be clear/readable copies)</p>
    <div style="margin-top: 15px;">
      <input type="checkbox" id="doc1" name="doc1">
      <label for="doc1">Official court document indicating legal name change (ex: marriage/divorce/naturalization)</label>
    </div>
    <div style="margin-top: 10px;">
      <input type="checkbox" id="doc2" name="doc2">
      <label for="doc2">Photo identification (i.e. driver's license, passport – with CORRECTED name)</label>
    </div>
  </div>

  <div class="form-section">
    <div style="display: flex; justify-content: space-between;">
      <div style="width: 45%;">
        <p>Current Name: _________________________</p>
        <p>Signature: _________________________</p>
        <p>Contact Phone: _________________________</p>
      </div>
      <div style="width: 45%; text-align: right;">
        <p>Student ID #: _________________________</p>
        <p>Date: _________________________</p>
        <p>E-Mail: _________________________</p>
      </div>
    </div>
    <div style="margin-top: 30px;">
      <p>Request Name be changed to: ____________________________________________________________________</p>
    </div>
  </div>

  <div class="form-section" style="margin-top: 50px;">
    <h3 style="text-align: center; font-size: 12pt; margin-bottom: 20px;">TO BE COMPLETED BY THE OFFICE OF ENROLLMENT SERVICES</h3>
    
    <div class="line-item">
      <p>ACADEMIC PROGRAM: _________________________ ( ) Proof of ID, if at received at counter</p>
    </div>
    <div class="line-item">
      <p>
        <input type="checkbox" id="check1">
        <label for="check1">checked 2 forms of documentation (the name is already corrected on these documents)</label>
      </p>
    </div>

    <div style="margin-top: 20px;">
      <p>CURRENT STUDENT</p>
      <div class="line-item">
        <p>
          <input type="checkbox" id="check2">
          <label for="check2">Current student – corrected in SPRO on: ________ / ________ / ________ by: _________________________</label>
        </p>
      </div>
      <div class="line-item">
        <p>
          <input type="checkbox" id="check3">
          <label for="check3">Check SGRD _________________________ Process, make a copy & give it to the appropriate Graduation Specialist</label>
        </p>
      </div>
      <div class="line-item">
        <p>Filed: Current student folder</p>
      </div>
    </div>

    <div style="margin-top: 30px;">
      <p>ALUMNI</p>
      <div class="line-item">
        <p>
          <input type="checkbox" id="check4">
          <label for="check4">IASU – Date of graduation: ________ / ________ / ________</label>
        </p>
      </div>
      <div class="line-item">
        <p>
          <input type="checkbox" id="check5">
          <label for="check5">FNM ________ if alumni, name populates – change to reflect on TRANSCRIPT ONLY</label>
        </p>
      </div>
      <div class="line-item">
        <p>Filed: Alumni folder</p>
      </div>
    </div>
  </div>
</div>