                <li class="list-item"><span data-field="bill_view_step_4">{{ bill_view_step_4 }}</span></li>
            </ul>

            <div class="sub-heading">How to check BGSU ACCESS BGSU:</div>
            <ul style="list-style-type: disc; padding-left: 20px;">
                <li class="list-item"><span data-field="access_check_step_1">{{ access_check_step_1 }}</span></li>
