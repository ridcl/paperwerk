<!DOCTYPE html>
<html>
<head>
    <title>DPA UPScale RI - System Documentation</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 {
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
            font-weight: bold;
        }
        .header-logo {
            position: absolute;
            top: 30px;
            right: 60px;
        }
        .footer-text {
            position: absolute;
            bottom: 30px;
            right: 60px;
            font-size: 10pt;
            color: #555;
        }
        .section-title {
            font-size: 24pt;
            margin-bottom: 20px;
            font-weight: bold;
        }
        .sub-heading {
            font-size: 16pt;
            margin-top: 30px;
            margin-bottom: 15px;
            font-weight: bold;
        }
        .product-table th, .product-table td {
            border: 1px solid #ccc;
            padding: 10px;
            text-align: center;
            font-size: 10pt;
        }
        .product-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        .feature-list {
            list-style-type: disc;
            margin-left: 20px;
            font-size: 11pt;
        }
        .feature-list li {
            margin-bottom: 8px;
        }
        .two-column-layout {
            display: flex;
            justify-content: space-between;
            gap: 40px;
            margin-top: 30px;
        }
        .column {
            flex: 1;
        }
        .diagram-container {
            text-align: center;
            margin-top: 30px;
        }
    </style>
</head>
