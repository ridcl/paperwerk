<!DOCTYPE html>
<html>
<head>
<title>Synthetic Document</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; /* Defaulting to serif for layout consistency */
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; }
  p, li { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  .header-title { font-size: 24pt; font-weight: bold; }
  .section-heading { font-size: 16pt; font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
  .sub-heading { font-size: 12pt; font-weight: bold; margin-top: 15px; margin-bottom: 5px; }
  .body-text { font-size: 11pt; line-height: 1.5; }
  .image-container { text-align: center; margin: 30px 0; }
</style>
</head>
<body>

<div class="page">
    <div style="text-align: center; margin-bottom: 30px;">
        <h1 class="header-title">ABB JOKAB SAFETY Products</h1>
        <h2 class="header-title">Anti-collision solution</h2>
        <h2 class="header-title">Airline lift industry</h2>
    </div>

    <div class="body-text">
        <h3 class="section-heading">Inspired by industry</h3>
        <p>
            <span data-field="inspired_industry_text">{{ inspired_industry_text }}</span>
        </p>
        <p>
            <span data-field="single_impact_description">A single impact resulting in airplane damage can cause in excess of <span data-field="impact_cost_value">{{ single_impact_description">A single impact resulting in airplane damage can cause in excess of <span data-field= }}</span> million. This cost includes repair to the damaged portion of the airplane as well as the cost of lost flight time of up to several days.</span>
        </p>
        <p>
            <span data-field="abb_solution_summary">{{ abb_solution_summary }}</span>
        </p>

        <h3 class="section-heading">Unique solutions and design by ABB</h3>
        <ul>
            <li><span data-field="safety_bumpers_feature">{{ safety_bumpers_feature }}</span></li>
            <li><span data-field="pluto_safety_plc_feature">{{ pluto_safety_plc_feature }}</span></li>
            <li><span data-field="power_supplies_feature">{{ power_supplies_feature }}</span></li>
            <li><span data-field="quick_guard_feature">{{ quick_guard_feature }}</span></li>
        </ul>
    </div>

    <div class="image-container">
        <!-- Placeholder for the first image -->
        <img src="placeholder_image_1.png" alt="Anti-collision system in use" style="max-width: 100%; height: auto;">
    </div>

    <div class="image-container">
        <!-- Placeholder for the second image -->
        <img src="placeholder_image_2.png" alt="Aircraft maintenance scene" style="max-width: 100%; height: auto;">
    </div>

    <div style="text-align: right; margin-top: 50px;">
        <p style="font-size: 10pt;">Power and productivity for a better world&trade;</p>
        <img src="placeholder_abb_logo.png" alt="ABB Logo" style="height: 30px;">
    </div>
</div>

<div class="page">
    <div style="text-align: center; margin-bottom: 30px;">
        <h1 class="header-title">ABB anti-collision solution - airline lift industry</h1>
        <h2 class="header-title">Delivering reliable solutions to your operations</h2>
    </div>

    <div class="body-text">
        <h3 class="section-heading">Safety edges, bumpers and mats</h3>
        <ul>
            <li><span data-field="safety_edges_description">{{ safety_edges_description }}</span></li>
            <li><span data-field="safety_bumpers_description">{{ safety_bumpers_description }}</span></li>
            <li><span data-field="safety_mats_description">{{ safety_mats_description }}</span></li>
        </ul>

        <h3 class="section-heading">Pluto Safety PLC</h3>
        <p>
            <span data-field="pluto_plc_description">Pluto Safety PLC's allows for up to <span data-field="pluto_io_count">{{ pluto_plc_description">Pluto Safety PLC's allows for up to <span data-field= }}</span> devices per input without compromising the level of safety.</span>
        </p>
        <ul>
            <li><span data-field="discrete_io_description">{{ discrete_io_description }}</span></li>
            <li><span data-field="safety_rating_description">{{ safety_rating_description }}</span></li>
        </ul>

        <h3 class="section-heading">Power supplies, connection, pilot devices and contactors</h3>
        <p>
            <span data-field="power_supplies_scope">{{ power_supplies_scope }}</span>
        </p>
        <p>
            <span data-field="connection_devices_scope">{{ connection_devices_scope }}</span>
        </p>
        <p>
            <span data-field="ip69k_pilot_devices_scope">{{ ip69k_pilot_devices_scope }}</span>
        </p>

        <h3 class="section-heading">Quick-Guard&reg; extruded aluminum framing</h3>
        <ul>
            <li><span data-field="quick_guard_framing_description">{{ quick_guard_framing_description }}</span></li>
            <li><span data-field="quick_guard_modifications_description">{{ quick_guard_modifications_description }}</span></li>
        </ul>
    </div>

    <div style="margin-top: 60px;">
        <h3 class="section-heading">Contact us</h3>
        <p>
            <span data-field="company_name">{{ company_name }}</span>
        </p>
        <p>
            <span data-field="address_line_1">{{ address_line_1 }}</span><br>
            <span data-field="address_line_2">{{ address_line_2 }}</span>
        </p>
        <p>
            Phone: <span data-field="phone_number">{{ phone_number }}</span><br>
            Fax: <span data-field="fax_number">{{ fax_number }}</span><br>
            Web: <span data-field="website_url">{{ website_url }}</span>
        </p>
    </div>

    <div style="text-align: right; margin-top: 50px;">
        <p style="font-size: 10pt;">Power and productivity for a better world&trade;</p>
        <img src="placeholder_abb_logo_2.png" alt="ABB Logo" style="height: 30px;">
    </div>
</div>

</body>
</html>