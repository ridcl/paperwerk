<!DOCTYPE html>
<html>
<head>
<title>Northwest University Partnership Program</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic layout structure */
  .header-section { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px; }
  .logo-area { display: flex; align-items: center; }
  .logo-graphic { width: 150px; height: 150px; margin-right: 20px; }
  .university-name { font-size: 36px; font-weight: bold; }
  .title-section { text-align: center; margin-bottom: 50px; }
  .title-text { font-size: 32px; font-weight: bold; }
  .form-section { display: flex; flex-direction: column; gap: 20px; }
  .form-group { display: flex; flex-direction: column; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 15px; }
  .form-label { font-weight: bold; margin-bottom: 5px; }
  .input-field { border-bottom: 1px solid #000; padding-bottom: 3px; }
  .radio-group label { margin-right: 15px; }
  .footer-section { margin-top: 80px; text-align: center; }
</style>
</head>
<body>

<div class="page">
  <div class="header-section">
    <div class="logo-area">
      <!-- Placeholder for logo graphic -->
      <div class="logo-graphic"></div>
      <div class="university-name">Northwest UNIVERSITY</div>
    </div>
    <div class="title-section">
      <div class="title-text">NORTHWEST PARTNERSHIP PROGRAM OFFERINGS</div>
    </div>
  </div>

  <div class="form-section">
    <!-- Personal Information Section -->
    <div class="form-group">
      <div class="form-row">
        <div style="width: 45%;">
          <div class="form-label">Name:</div>
          <div class="input-field"><span data-field="full_name">{{ full_name }}</span></div>
        </div>
        <div style="width: 45%;">
          <div class="form-label"></div>
          <div class="input-field">FIRST</div>
        </div>
      </div>
      <div class="form-row">
        <div style="width: 45%;">
          <div class="form-label"></div>
          <div class="input-field">LAST</div>
        </div>
      </div>
    </div>

    <div class="form-group">
      <div class="form-label">Gender:</div>
      <div class="radio-group">
        <label><input type="radio" name="gender"> Male</label>
        <label><input type="radio" name="gender"> Female</label>
      </div>
    </div>

    <!-- Address Section -->
    <div class="form-group">
      <div class="form-label">Address:</div>
      <div class="input-field" style="width: 100%;"></div>
    </div>

    <div class="form-row">
      <div style="width: 30%;">
        <div class="form-label">City:</div>
        <div class="input-field"></div>
      </div>
      <div style="width: 30%;">
        <div class="form-label">State:</div>
        <div class="input-field"></div>
      </div>
      <div style="width: 30%;">
        <div class="form-label">Zip:</div>
        <div class="input-field"></div>
      </div>
    </div>

    <!-- Contact Information Section -->
    <div class="form-group">
      <div class="form-label">Email:</div>
      <div class="input-field" style="width: 100%;"></div>
    </div>

    <div class="form-group">
      <div class="form-label">Cell:</div>
      <div class="input-field" style="width: 100%;"></div>
    </div>

    <div class="form-group">
      <div class="form-label">OK to text?</div>
      <div class="radio-group">
        <label><input type="radio" name="text_consent"> Yes</label>
        <label><input type="radio" name="text_consent"> No</label>
      </div>
    </div>

    <!-- Program Interest Section -->
    <div class="form-group">
      <div class="form-label">What program are you interested in learning more about?</div>
      <div class="radio-group">
        <label><input type="radio" name="program_track"> Regular Intern Track</label>
        <label><input type="radio" name="program_track"> Adult Learner/Flex Student</label>
      </div>
    </div>

    <div class="form-group">
      <div class="form-label">Major(s):</div>
      <div class="input-field" style="width: 100%;"></div>
    </div>
  </div>
</div>

<div class="page">
  <!-- Program Offerings List (Mimicking the vertical list structure) -->
  <div style="padding-top: 50px;">
    <div style="display: flex; flex-direction: column; gap: 20px;">
      <div style="border-bottom: 1px solid #ccc; padding-bottom: 10px;">
        <span data-field="program_offerings[0].degree">{{ program_offerings[0].degree }}</span>
      </div>
      <div style="border-bottom: 1px solid #ccc; padding-bottom: 10px;">
        <span data-field="program_offerings[1].degree">{{ program_offerings[1].degree }}</span>
      </div>
      <div style="border-bottom: 1px solid #ccc; padding-bottom: 10px;">
        <span data-field="program_offerings[2].degree">{{ program_offerings[2].degree }}</span>
      </div>
      <div style="border-bottom: 1px solid #ccc; padding-bottom: 10px;">
        <span data-field="program_offerings[3].degree">{{ program_offerings[3].degree }}</span>
      </div>
      <div style="border-bottom: 1px solid #ccc; padding-bottom: 10px;">
        <span data-field="program_offerings[4].degree">{{ program_offerings[4].degree }}</span>
      </div>
      <div style="border-bottom: 1px solid #ccc; padding-bottom: 10px;">
        <span data-field="program_offerings[5].degree">{{ program_offerings[5].degree }}</span>
      </div>
      <div style="border-bottom: 1px solid #ccc; padding-bottom: 10px;">
        <span data-field="program_offerings[6].degree">{{ program_offerings[6].degree }}</span>
      </div>
      <div style="padding-bottom: 10px;">
        <span data-field="program_offerings[7].degree">{{ program_offerings[7].degree }}</span>
      </div>
      <div style="padding-bottom: 10px;">
        <span data-field="program_offerings[8].degree">{{ program_offerings[8].degree }}</span>
      </div>
    </div>
  </div>

  <!-- Footer Section -->
  <div class="footer-section">
    <div style="margin-bottom: 20px;">
      For more information about our Northwest Partnership Program (NPP), go to <a href="http://northwestu.edu/partnership"><span data-field="website_url">{{ website_url }}</span></a>.
    </div>
    <div style="font-size: 12px; color: #555;">
      Since <span data-field="founding_year">{{ founding_year }}</span>, Kirkland, Washington.
    </div>
  </div>
</div>

</body>
</html>