    Greenbook 2000, Energy and Sustainable Agriculture Program, Minnesota Department of Agriculture<br>
    <a href="{{ resource_url_6 }}">{{ resource_url_6 }}</a><br>
    <span data-field="resource_description_6">{{ resource_description_6 }}</span>
