<div class="page">
    <div style="text-align: center; margin-bottom: 30px;">
        <h2 class="subheader">Summer Interns</h2>
    </div>

    <div class="column-layout">
        <div class="column" style="width: 48%;">
            <div class="image-container">
                <img src="placeholder_image_16.jpg" alt="Intern Image 1">
            </div>
            <div class="image-container">
                <img src="placeholder_image_17.jpg" alt="Intern Image 2">
            </div>
            <div class="image-container">
                <img src="placeholder_image_18.jpg" alt="Intern Image 3">
