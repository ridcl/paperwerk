      </tr>
      {% endfor %}
    </tbody>
  </table>

  <h2 class="section-title">Available Infrastructure of Campus</h2>
  <p>The Campus is located at {{ location_address }}.</p>
  <table>
    <thead>
      <tr>
        <th>Area of the Land</th>
        <th>1 acre 58 cents</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Area of the building</td>
        <td>
          <table>
            <tr>
              <td>Ground Floor</td>
              <td>{{ ground_floor_area }} Sq. metres</td>
            </tr>
            <tr>
              <td>First Floor</td>
              <td>{{ first_floor_area }} Sq. metres</td>
            </tr>
            <tr>
              <td>Second Floor</td>
              <td>{{ second_floor_area }} Sq. metres</td>
            </tr>
          </table>
        </td>
      </tr>
      <tr>
        <td>Total Area</td>
        <td>{{ total_area }} Sq.metres</td>
      </tr>
    </tbody>
  </table>

  <h2 class="section-title">Room Allocation:</h2>
  <p>There are total {{ total_rooms }} rooms and the allocations of these rooms are the following:</p>
  <table>
    <thead>
      <tr>
        <th>Sl. No.</th>
        <th>Room Allocation</th>
        <th>Total Number</th>
      </tr>
    </thead>
    <tbody>
      {% for room in room_allocation %}
      <tr>
        <td>{{ loop.index }}</td>
        <td><span data-field="room_allocation[{{ loop.index0 }}].room_name">{{ room.room_name }}</span></td>
        <td>{{ room.total_number }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <h2 class="section-title">Other Peripherals</h2>
  <table>
    <thead>
      <tr>
        <th>SL.NO</th>
        <th>Peripheral Name</th>
        <th>Total Number</th>
      </tr>
    </thead>
    <tbody>
      {% for peripheral in peripherals %}
      <tr>
        <td>{{ loop.index }}</td>
        <td><span data-field="peripherals[{{ loop.index0 }}].name">{{ peripheral.name }}</span></td>
        <td>{{ peripheral.total_number }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <h2 class="section-title">Library</h2>
  <table>
    <thead>
      <tr>
        <th>SL.NO</th>
        <th>Subject</th>
        <th>Total</th>
      </tr>
    </thead>
    <tbody>
      {% for library_item in library_subjects %}
      <tr>
        <td>{{ loop.index }}</td>
        <td><span data-field="library_subjects[{{ loop.index0 }}].subject">{{ library_item.subject }}</span></td>
        <td>{{ library_item.total }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <p><strong>Total Books:</strong> {{ total_books }}</p>
</div>

