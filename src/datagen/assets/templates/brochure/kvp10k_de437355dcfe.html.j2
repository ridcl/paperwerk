<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
</style>
<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px;">
    <div style="flex-basis: 30%;">
      <h1 style="font-size: 48px; margin-bottom: 10px;">An interior view</h1>
      <img src="placeholder_image_1.jpg" alt="Interior View" style="width: 100%; height: auto; margin-top: 20px;">
    </div>
    <div style="flex-basis: 70%; text-align: right;">
      <h2 style="font-size: 48px; margin-bottom: 10px;">Why Wake Forest Properties ?</h2>
      <p style="font-size: 18px; margin-bottom: 20px;">We are proud to serve our residents by offering:</p>
      <ul style="list-style-type: disc; padding-left: 20px; font-size: 18px;">
        <li>Housing exclusively for {{ target_audience }}</li>
        <li>Courteous, Friendly Service</li>
        <li>Fully furnished units, including internet and utilities</li>
        <li>Common area cleaning</li>
        <li>Modern appliances</li>
        <li>Close to campus</li>
      </ul>
      <div style="margin-top: 50px; text-align: right;">
        <h1 style="font-size: 60px; line-height: 1.1;">Wake<br>Forest<br>University<br>Welcomes<br>you to your<br>New Home!</h1>
      </div>
    </div>
  </div>
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-top: 30px;">
    <div style="flex-basis: 30%;">
      <img src="placeholder_image_2.jpg" alt="Kitchen View" style="width: 100%; height: auto;">
    </div>
    <div style="flex-basis: 35%; text-align: center;">
      <p style="font-size: 16px;">Phone: <span data-field="contact.phone">{{ contact.phone }}</span></p>
      <p style="font-size: 16px;">E-mail: <span data-field="contact.email">{{ contact.email }}</span></p>
      <p style="font-size: 16px;">Wake Forest Properties</p>
      <p style="font-size: 16px;">P.O Box <span data-field="contact.zip_code">{{ contact.zip_code }}</span></p>
      <p style="font-size: 16px;">Winston Salem, NC <span data-field="contact.city_state">{{ contact.city_state }}</span></p>
      <div style="margin-top: 30px;">
        <img src="placeholder_logo.png" alt="Wake Forest University Logo" style="width: 150px; height: auto;">
        <p style="font-size: 14px; text-align: center;">Wake Forest Properties</p>
      </div>
    </div>
    <div style="flex-basis: 35%;">
      <img src="placeholder_image_3.jpg" alt="Exterior View" style="width: 100%; height: auto;">
    </div>
  </div>
</div>
<div class="page">
  <div style="text-align: center; margin-bottom: 40px;">
    <h1 style="font-size: 40px;">WFU</h1>
    <h2 style="font-size: 32px;">Off-Campus Housing</h2>
  </div>
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px;">
    <div style="flex-basis: 30%;">
      <img src="placeholder_image_4.jpg" alt="Dining Area" style="width: 100%; height: auto;">
    </div>
    <div style="flex-basis: 65%;">
      <p style="font-size: 18px; line-height: 1.6;">Residents of WF Properties enjoy housing that is comfortable, affordable and stylishly beautiful. Our homes offer spacious dining and living areas as well as remodeled bedrooms, kitchens and baths!</p>
    </div>
  </div>
  <div style="text-align: center; margin-bottom: 30px;">
    <h3 style="font-size: 24px;">How to apply:</h3>
  </div>
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px;">
    <div style="flex-basis: 45%;">
      <ul style="list-style-type: disc; padding-left: 20px; font-size: 18px;">
        <li>Visit our website: <a href="http://www.wfu.edu/properties" style="color: blue;">{{ website_url }}</a></li>
        <li>Fill out the PDF application and submit to: <span data-field="application.email">{{ application.email }}</span></li>
        <li>Submit a security deposit to reserve your assignment</li>
        <li>Applications will be accepted throughout the summer, but hurry, reservations are made on a first-come, first-served basis</li>
        <li>Students will be notified of their room assignment as soon as it is confirmed.</li>
      </ul>
    </div>
    <div style="flex-basis: 50%;">
      <img src="placeholder_image_5.jpg" alt="Living Room" style="width: 100%; height: auto;">
    </div>
  </div>
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div style="flex-basis: 45%;">
      <img src="placeholder_image_6.jpg" alt="Kitchen Interior" style="width: 100%; height: auto;">
    </div>
    <div style="flex-basis: 50%;">
      <img src="placeholder_image_7.jpg" alt="Bathroom Interior" style="width: 100%; height: auto;">
    </div>
  </div>
</div>