            <p>Feinste verzinnte Kupfergeflechten</p>
            <p>Bedeckungsgrad: &gt; 90%</p>
            <table>
                <thead>
                    <tr>
                        <th>Bestell-Nr.</th>
                        <th>NW</th>
                        <th>Geflecht-Spezifikation</th>
                        <th>Querschnitt min.</th>
                        <th>Querschnitt max.</th>
                        <th>Gewicht netto pro 100 m*</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in fck_items %}
                    <tr>
                        <td><span data-field="fck_items[{{ loop.index0 }}].order_number">{{ item.order_number }}</span></td>
                        <td><span data-field="fck_items[{{ loop.index0 }}].wire_size">{{ item.wire_size }}</span></td>
                        <td><span data-field="fck_items[{{ loop.index0 }}].spec">{{ item.spec }}</span></td>
                        <td><span data-field="fck_items[{{ loop.index0 }}].cs_min">{{ item.cs_min }}</span></td>
                        <td><span data-field="fck_items[{{ loop.index0 }}].cs_max">{{ item.cs_max }}</span></td>
                        <td><span data-field="fck_items[{{ loop.index0 }}].weight">{{ item.weight }}</span></td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            <p style="font-size: 10px; margin-top: 10px;">*Ohne Trägerschauch</p>
            <p style="font-size: 10px;">Typische Schirmwerte: 65-75 dB bei 100 MHz</p>
            <p style="font-size: 10px;">Temperaturbereich: -65 °C bis +150 °C</p>
        </div>
    </div>

    <!-- F.CU Table -->
