<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1, h2, h3 { font-weight: bold; }
  .content-block { margin-bottom: 20px; }
</style>

<div class="page">
  <div class="content-block">
    <h2>Hagedorn 106</h2>
    <div class="content-block">
      <p>Hours of Operation: <span data-field="hours_of_operation">{{ hours_of_operation }}</span></p>
      <p>To Reserve Room: <span data-field="reservation_contact">Please call {{ reservation_contact_name }}, ext. {{ reservation_contact_extension }}.</span></p>
      <p>Phone: ext. <span data-field="phone_extension">{{ phone_extension }}</span></p>
      <p>Software Available for Use: <a href="{{ software_link }}">{{ software_link_text }}</a></p>
    </div>
  </div>
  
  <!-- Placeholder for the visual grid/diagram on the right side -->
  <div style="position: absolute; top: 100px; right: 60px; width: 250px; height: 400px; border: 1px solid #ccc; padding: 10px;">
    <!-- Mimicking the visual layout elements -->
    <div style="display: flex; flex-direction: column; gap: 5px;">
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 5px;">
        <div style="height: 20px; border: 1px solid #000;"></div>
        <div style="height: 20px; border: 1px solid #000;"></div>
        <div style="height: 20px; border: 1px solid #000;"></div>
      </div>
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 5px;">
        <div style="height: 20px; border: 1px solid #000;"></div>
        <div style="height: 20px; border: 1px solid #000;"></div>
        <div style="height: 20px; border: 1px solid #000;"></div>
      </div>
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 5px;">
        <div style="height: 20px; border: 1px solid #000;"></div>
        <div style="height: 20px; border: 1px solid #000;"></div>
        <div style="height: 20px; border: 1px solid #000;"></div>
      </div>
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 5px;">
        <div style="height: 20px; border: 1px solid #000;"></div>
        <div style="height: 20px; border: 1px solid #000;"></div>
        <div style="height: 20px; border: 1px solid #000;"></div>
      </div>
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 5px;">
        <div style="height: 20px; border: 1px solid #000;"></div>
        <div style="height: 20px; border: 1px solid #000;"></div>
        <div style="height: 20px; border: 1px solid #000;"></div>
      </div>
    </div>
    
    <!-- Labels mimicking the bottom section -->
    <div style="margin-top: 20px; text-align: center; font-size: 10px;">
        <div style="display: flex; justify-content: space-around;">
            <div>
                <div style="height: 10px; border: 1px solid #000;"></div>
                <div style="font-size: 8px;">Calling Mounted Projector</div>
            </div>
            <div>
                <div style="height: 10px; border: 1px solid #000;"></div>
                <div style="font-size: 8px;">Wall Mounted Hybrid Box</div>
            </div>
        </div>
        <div style="margin-top: 10px;">
            <div style="height: 10px; border: 1px solid #000;"></div>
            <div style="font-size: 8px;">Ceiling Mounted Screen</div>
        </div>
    </div>
  </div>
</div>