                    <td>&#10003;</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div style="margin-bottom: 30px;">
        <h3 style="font-size: 20px; margin-bottom: 15px;">Zuordnung der IT-Netze</h3>
        <table style="width: 100%;">
            <thead>
                <tr>
                    <th style="width: 25%;">BSV Nennleistung</th>
                    <th style="width: 20%;">Wechselrichter Kurzschlussstrom (kA)</th>
                    <th style="width: 20%;">Minimale Trafo-Primärsicherung (A)</th>
                    <th style="width: 20%;">Leitungs-Schutzschalter (A)</th>
                    <th style="width: 15%;">Maximal zulässiger IT-Trenntrafo (kVA)</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>BSV mit 1-Ph. Ausgang</td>
                    <td>{{ short_circuit_current_1ph }} kA</td>
                    <td>{{ min_fuse_1ph }} A</td>
                    <td>{{ circuit_breaker_1ph }} A</td>
                    <td>{{ max_transformer_1ph }} kVA</td>
                </tr>
                <tr>
                    <td>BSV mit 3-Ph. Ausgang</td>
                    <td>{{ short_circuit_current_3ph }} kA</td>
                    <td>{{ min_fuse_3ph }} A</td>
                    <td>{{ circuit_breaker_3ph }} A</td>
                    <td>{{ max_transformer_3ph }} kVA</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div style="margin-top: 50px;">
        <p style="font-size: 12px;">
            <span data-field="footnote_1">{{ footnote_1 }}</span>
        </p>
        <p style="font-size: 12px;">
            <span data-field="footnote_2">{{ footnote_2 }}</span>
        </p>
    </div>
</div>

<div class="page">
    <h2 style="font-size: 28px; margin-bottom: 30px;">Abmessungen und Gewichte</h2>

    <div style="margin-bottom: 30px;">
        <h3 style="font-size: 20px; margin-bottom: 15px;">BSV-Schrank (und Bypassschrank)</h3>
        <table style="width: 100%;">
            <thead>
                <tr>
                    <th style="width: 10%;">BSV</th>
                    <th style="width: 10%;">Bypass</th>
                    <th style="width: 10%;">Batterieschrank</th>
                    <th style="width: 10%;">1-stündig</th>
                    <th style="width: 10%;">3-stündig</th>
                    <th style="width: 10%;">B</th>
                    <th style="width: 10%;">T</th>
                    <th style="width: 10%;">Gewicht</th>
                </tr>
            </thead>
            <tbody>
                {% for row in bsv_dimensions %}
                <tr>
                    <td style="text-align: center;">{{ row.bsv_size }}</td>
                    <td style="text-align: center;">{{ row.bypass_size }}</td>
                    <td style="text-align: center;">{{ row.battery_size }}</td>
                    <td style="text-align: center;">{{ row.h_1h }}</td>
                    <td style="text-align: center;">{{ row.h_3h }}</td>
                    <td style="text-align: center;">{{ row.b }}</td>
                    <td style="text-align: center;">{{ row.t }}</td>
                    <td style="text-align: center;">{{ row.weight }} kg</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div style="margin-bottom: 30px;">
        <h3 style="font-size: 20px; margin-bottom: 15px;">Geschlossene NiCd-Batterie</h3>
        <table style="width: 100%;">
            <thead>
                <tr>
                    <th style="width: 10%;">BSV</th>
                    <th style="width: 10%;">Bypass</th>
                    <th style="width: 10%;">Batterieschrank</th>
                    <th style="width: 10%;">1-stündig</th>
                    <th style="width: 10%;">3-stündig</th>
                    <th style="width: 10%;">B</th>
                    <th style="width: 10%;">T</th>
                    <th style="width: 10%;">Gewicht</th>
                </tr>
            </thead>
            <tbody>
                {% for row in nicd_battery_dimensions %}
                <tr>
                    <td style="text-align: center;">{{ row.bsv_size }}</td>
                    <td style="text-align: center;">{{ row.bypass_size }}</td>
                    <td style="text-align: center;">{{ row.battery_size }}</td>
                    <td style="text-align: center;">{{ row.h_1h }}</td>
                    <td style="text-align: center;">{{ row.h_3h }}</td>
                    <td style="text-align: center;">{{ row.b }}</td>
                    <td style="text-align: center;">{{ row.t }}</td>
                    <td style="text-align: center;">{{ row.weight }} kg</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div style="margin-bottom: 30px;">
        <h3 style="font-size: 20px; margin-bottom: 15px;">Empfohlene externe Absicherung bei gemeinsamer Zulistung</h3>
        <table style="width: 100%;">
            <thead>
                <tr>
                    <th style="width: 25%;">BSV-Anlage (50 Hz) Nennleistung (kVA)</th>
                    <th style="width: 20%;">Blei-Batterie</th>
                    <th style="width: 20%;">NiCd-Batterie</th>
                    <th style="width: 35%;">1-stündig</th>
                </tr>
            </thead>
            <tbody>
                {% for row in recommended_protection %}
                <tr>
                    <td>{{ row.bsv_kva }}</td>
                    <td>{{ row.lead_fuse }}</td>
                    <td>{{ row.nicd_fuse }}</td>
                    <td>{{ row.1h_fuse }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div style="margin-top: 50px;">
        <p style="font-size: 12px;">
            <span data-field="footnote_3">{{ footnote_3 }}</span>
        </p>
    </div>
</div>

