<!DOCTYPE html>
<html>
<head>
<title>Tutoring Centers Directory</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  h1 { font-size: 24pt; font-weight: bold; margin-bottom: 10px; }
  h2 { font-size: 14pt; font-weight: bold; margin-top: 20px; margin-bottom: 5px; }
  ul { list-style-type: disc; padding-left: 20px; margin-top: 5px; margin-bottom: 15px; }
  li { margin-bottom: 5px; }
  .contact-info p { margin: 2px 0; font-size: 10pt; }
  .contact-info strong { display: inline-block; width: 60px; }
</style>
</head>
