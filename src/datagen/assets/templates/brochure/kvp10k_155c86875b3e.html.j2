<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { margin-top: 0; }
</style>

<div class="page">
  <div style="text-align: center; margin-bottom: 40px;">
    <h1 style="font-size: 24pt; font-weight: bold;">University Copy, Print, and Delivery Services Updates</h1>
  </div>
  <div style="text-align: center; margin-bottom: 40px;">
    <p style="font-size: 12pt;">
      <span data-field="full_name">{{ full_name }}</span>, <span data-field="title">{{ title }}</span><br>
      <span data-field="department">{{ department }}</span>
    </p>
  </div>
  <div style="background-color: #A51C2B; padding: 15px 0; text-align: center;">
    <h2 style="color: white; font-size: 20pt; margin: 0;">UNIVERSITY of HOUSTON</h2>
  </div>
</div>

<div class="page">
  <div style="text-align: center; margin-bottom: 30px;">
    <h2 style="font-size: 20pt; font-weight: bold;">UH Copy and Print Online & Promotional Items</h2>
  </div>
  <ul style="list-style-type: disc; padding-left: 40px; margin-bottom: 30px;">
    <li>User-friendly</li>
    <li>Convenient</li>
    <li><a href="{{ printing_online_url }}">{{ printing_online_url }}</a></li>
    <li>Promotional Items website-</li>
    <li><a href="{{ promotional_items_url }}">{{ promotional_items_url }}</a></li>
  </ul>
</div>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px;">
    <div style="flex: 1; padding-right: 20px;">
      <div style="background-color: #A51C2B; padding: 20px; text-align: center; margin-bottom: 20px;">
        <h2 style="color: white; font-size: 36pt; margin: 0;">WE PRICE MATCH!</h2>
      </div>
      <h3 style="font-size: 14pt; margin-bottom: 10px;">We Price Match</h3>
      <ul style="list-style-type: disc; padding-left: 20px;">
        <li>Specifications on paper, print colors and bindery</li>
        <li>To meet your quality requirements</li>
        <li>To meet normal delivery requirements</li>
        <li>Quoted price as obtained locally</li>
        <li>Comparable materials or requirements for promotions</li>
      </ul>
    </div>
    <div style="flex: 1; padding-left: 20px;">
      <h3 style="font-size: 14pt; margin-bottom: 10px;">We Can Deliver</h3>
      <ul style="list-style-type: disc; padding-left: 20px;">
        <li>Brochures and Flyers</li>
        <li>Posters and Banners</li>
        <li>Stationery and Digital printing</li>
        <li>Pocket folders and Postcards</li>
        <li>All manner of swag</li>
      </ul>
    </div>
    <div style="flex: 1; padding-left: 20px;">
      <h3 style="font-size: 14pt; margin-bottom: 10px;">Visit our website or contact us:</h3>
      <ul style="list-style-type: disc; padding-left: 20px;">
        <li><a href="{{ website_url }}">{{ website_url }}</a></li>
        <li><span data-field="phone_number">{{ phone_number }}</span></li>
      </ul>
    </div>
  </div>
  <div style="font-size: 10pt; color: #555; text-align: center; margin-top: 50px;">
    Printing & Postal Services will match any price as confirmed and shown to us for any of the products and services that we offer, produce in-house or manage via third-party vendors. In all instances, we will ensure that our products are delivered on time, with the requisite level of quality and at a price that match your best price comparison. For projects requiring specific material requirements, we will ensure that our material requirements if substituted, match your specific requirements as closely as possible.
  </div>
</div>

<div class="page">
  <div style="text-align: center; margin-bottom: 40px;">
    <h2 style="font-size: 24pt; font-weight: bold;">MAPP Policy 04.01.01</h2>
  </div>
  <ul style="list-style-type: disc; padding-left: 40px;">
    <li>Offset printing <span data-field="threshold_1_amount">{{ threshold_1_amount }}</span> or less (<span data-field="threshold_1_small_amount">{{ threshold_1_small_amount }}</span> or less on federal funds) do not require competitive bids.</li>
    <li>Offset printing <span data-field="threshold_2_amount">{{ threshold_2_amount }}</span> or more (<span data-field="threshold_2_small_amount">{{ threshold_2_small_amount }}</span> on federal funds) require competitive bids, one from University Copy and Print Department.</li>
    <li>Offset printing of any dollar amount do not require competitive bids if provided by University Copy and Print Department.</li>
  </ul>
</div>

<div class="page">
  <div style="display: flex; justify-content: space-between; margin-bottom: 40px;">
    <div style="flex: 1; padding-right: 20px;">
      <h3 style="font-size: 14pt; font-weight: bold; margin-bottom: 15px;">CONTACT INFORMATION</h3>
      <div style="margin-bottom: 20px;">
        <p style="font-size: 10pt; margin: 0;">
          <span data-field="contact_name_1">{{ contact_name_1 }}</span><br>
          <span data-field="contact_title_1">{{ contact_title_1 }}</span><br>
          <span data-field="contact_department_1">{{ contact_department_1 }}</span><br>
          <span data-field="contact_email_1">{{ contact_email_1 }}</span><br>
          <span data-field="contact_phone_1">{{ contact_phone_1 }}</span>
        </p>
      </div>
      <div style="margin-bottom: 20px;">
        <p style="font-size: 10pt; margin: 0;">
          <span data-field="contact_name_2">{{ contact_name_2 }}</span><br>
          <span data-field="contact_title_2">{{ contact_title_2 }}</span><br>
          <span data-field="contact_department_2">{{ contact_department_2 }}</span><br>
          <span data-field="contact_email_2">{{ contact_email_2 }}</span><br>
          <span data-field="contact_phone_2">{{ contact_phone_2 }}</span>
        </p>
      </div>
      <div style="margin-bottom: 20px;">
        <p style="font-size: 10pt; margin: 0;">
          <span data-field="contact_name_3">{{ contact_name_3 }}</span><br>
          <span data-field="contact_title_3">{{ contact_title_3 }}</span><br>
          <span data-field="contact_department_3">{{ contact_department_3 }}</span><br>
          <span data-field="contact_email_3">{{ contact_email_3 }}</span><br>
          <span data-field="contact_phone_3">{{ contact_phone_3 }}</span>
        </p>
      </div>
      <div style="margin-bottom: 20px;">
        <p style="font-size: 10pt; margin: 0;">
          <span data-field="contact_name_4">{{ contact_name_4 }}</span><br>
          <span data-field="contact_title_4">{{ contact_title_4 }}</span><br>
          <span data-field="contact_department_4">{{ contact_department_4 }}</span><br>
          <span data-field="contact_email_4">{{ contact_email_4 }}</span><br>
          <span data-field="contact_phone_4">{{ contact_phone_4 }}</span>
        </p>
      </div>
    </div>
    <div style="flex: 1; text-align: right;">
      <div style="margin-bottom: 20px;">
        <p style="font-size: 10pt; margin: 0;">
          <strong>Location:</strong><br>
          <span data-field="location_building">{{ location_building }}</span><br>
          <span data-field="location_address">{{ location_address }}</span><br>
          <span data-field="location_parking">{{ location_parking }}</span>
        </p>
      </div>
      <div>
        <p style="font-size: 10pt; margin: 0;">
          <strong>Hours:</strong><br>
          <span data-field="hours_schedule">{{ hours_schedule }}</span>
        </p>
      </div>
    </div>
  </div>
</div>