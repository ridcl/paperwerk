<div class="page">
  <div style="text-align: right; font-size: 10pt;">9</div>
  <h2 style="font-size: 18pt; margin-bottom: 20px;">Options for every application</h2>

  <div style="display: flex; justify-content: space-between; margin-top: 40px;">
    <div style="width: 45%;">
      <div style="display: flex; align-items: center; margin-bottom: 15px;">
        <div style="width: 50px; height: 50px; border: 1px solid #ccc; margin-right: 15px; display: flex; align-items: center; justify-content: center;">
          <!-- Placeholder for icon -->
        </div>
