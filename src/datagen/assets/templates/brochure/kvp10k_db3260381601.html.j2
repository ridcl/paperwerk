<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px;">
        <div style="width: 50%;">
            <p style="font-size: 10pt; color: #777;">ROYCE THOMPSON RELIABLE CONTROLS FOR STREET, HIGHWAY AND AMENITY LIGHTING</p>
        </div>
        <div style="width: 48%; text-align: right;">
