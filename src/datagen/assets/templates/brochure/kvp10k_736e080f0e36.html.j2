<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  h1, h2, h3, h4 {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial;
  }
  .header-title {
    font-size: 24pt;
    font-weight: bold;
  }
  .sub-title {
    font-size: 14pt;
    font-weight: normal;
  }
  .section-heading {
    font-size: 14pt;
    font-weight: bold;
    text-align: center;
    margin-top: 20px;
    margin-bottom: 10px;
  }
  .price-box {
    border: 2px solid #d9534f;
    border-radius: 50%;
    width: 180px;
    height: 180px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    background-color: #f0ad4e;
    color: white;
    margin: 20px;
  }
  .price-box h2 {
    font-size: 36pt;
    margin: 0;
  }
  .price-box p {
    font-size: 14pt;
    margin: 5px 0 0 0;
  }
  .divider {
    border-top: 1px solid #ccc;
    margin: 30px 0;
  }
  .table-header th {
    text-align: left;
    padding: 8px 0;
    font-weight: bold;
  }
  .table-row td {
    padding: 8px 0;
    border-bottom: 1px solid #eee;
  }
  .form-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 15px;
}
  .form-group {
    width: 48%;
  }
  .form-group label {
    display: block;
    margin-bottom: 5px;
    font-weight: bold;
  }
  .form-group input[type="text"], .form-group input[type="date"], .form-group select {
    width: 100%;
    padding: 8px;
    border: 1px solid #ccc;
    box-sizing: border-box;
  }
  .signature-line {
    margin-top: 50px;
    display: flex;
    justify-content: space-between;
  }
  .signature-box {
    width: 45%;
    text-align: center;
  }
  .signature-box p {
    margin-top: 40px;
    border-top: 1px solid black;
    padding-top: 5px;
  }
</style>

