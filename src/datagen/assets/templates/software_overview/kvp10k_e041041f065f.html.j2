<!DOCTYPE html>
<html>
<head>
<title>Curriculum Management Software Overview</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif; }
  .header-logo { font-size: 30px; font-weight: bold; }
  .nav-bar { display: flex; justify-content: space-around; border-bottom: 1px solid #ccc; margin-bottom: 20px; }
  .nav-item { padding: 10px 20px; cursor: pointer; font-weight: bold; }
  .content-section { margin-bottom: 40px; }
  table { width: 100%; border-collapse: collapse; margin-top: 20px; }
  th, td { border: 1px solid #ddd; padding: 10px; text-align: left; }
  th { background-color: #f2f2f2; }
  .form-group { margin-bottom: 15px; }
  .form-group label { display: block; margin-bottom: 5px; font-weight: bold; }
  .form-group input[type="text"], .form-group input[type="password"] { width: 100%; padding: 8px; box-sizing: border-box; border: 1px solid #ccc; }
  .button { padding: 10px 20px; background-color: #007bff; color: white; border: none; cursor: pointer; }
</style>
</head>
<body>

<div class="page">
  <div style="text-align: center; margin-top: 100px;">
    <div class="header-logo">{{ organization_name }}</div>
    <h1 style="margin-top: 20px;">Curriculum Management Software Overview</h1>
  </div>

  <div style="text-align: center; margin-top: 50px;">
    <p>Please login with your Sitecore credentials.</p>
    <div style="width: 300px; margin: 0 auto;">
      <div class="form-group">
        <label for="username">Username</label>
        <input type="text" id="username" value="{{ username }}">
      </div>
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password">
      </div>
      <button class="button" style="width: 100%; margin-top: 10px;">Login</button>
    </div>
  </div>
</div>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h2>Single Sign On:</h2>
    <div style="font-size: 12px;">Account Settings</div>
  </div>
  <div style="text-align: center; margin-bottom: 30px;">
    <div class="header-logo">{{ organization_name }}</div>
  </div>

  <div class="content-section">
    <p>Enter your <span data-field="user_type">{{ user_type }}</span> user name: Your user name is your <span data-field="user_email_domain">{{ user_email_domain }}</span> email address without the @<span data-field="user_email_domain">{{ user_email_domain }}</span></p>
    <p>Enter your <span data-field="password_label">{{ password_label }}</span> Password</p>
  </div>

  <div class="nav-bar">
    <div class="nav-item">Curriculum Home</div>
    <div class="nav-item" style="border-bottom: 2px solid #000;">Curriculum Forms</div>
    <div class="nav-item">Curriculum Dashboard</div>
    <div class="nav-item">My Items</div>
    <div class="nav-item">Archived Proposals</div>
  </div>

  <div class="content-section">
    <h3>Welcome to Kean University Curriculum Management!</h3>
    <p>
      <span data-field="description_text_1">{{ description_text_1 }}</span>
      <span data-field="description_text_2">{{ description_text_2 }}</span>
    </p>
    <table>
      <thead>
        <tr>
          <th></th>
          <th></th>
          <th></th>
          <th></th>
          <th></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {% for item in workflow_items %}
        <tr>
          <td><span data-field="workflow_items[{{ loop.index0 }}].workflow_name">{{ item.workflow_name }}</span></td>
          <td><span data-field="workflow_items[{{ loop.index0 }}].workflow_type">{{ item.workflow_type }}</span></td>
          <td><span data-field="workflow_items[{{ loop.index0 }}].workflow_status">{{ item.workflow_status }}</span></td>
          <td><span data-field="workflow_items[{{ loop.index0 }}].workflow_date">{{ item.workflow_date }}</span></td>
          <td><span data-field="workflow_items[{{ loop.index0 }}].workflow_user">{{ item.workflow_user }}</span></td>
          <td><span data-field="workflow_items[{{ loop.index0 }}].workflow_details">{{ item.workflow_details }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    <p style="margin-top: 20px;">
      <span data-field="workflow_summary_text">{{ workflow_summary_text }}</span>
    </p>
  </div>
</div>

<div class="page">
  <div class="content-section">
    <h3>The Curriculum Forms Tab</h3>
    <p>
      <span data-field="forms_description_1">{{ forms_description_1 }}</span>
      <span data-field="forms_description_2">{{ forms_description_2 }}</span>
      <span data-field="forms_description_3">{{ forms_description_3 }}</span>
      <span data-field="forms_description_4">{{ forms_description_4 }}</span>
    </p>
  </div>

  <div class="nav-bar">
    <div class="nav-item">Curriculum Home</div>
    <div class="nav-item" style="border-bottom: 2px solid #000;">Curriculum Forms</div>
    <div class="nav-item">Curriculum Dashboard</div>
    <div class="nav-item">My Items</div>
    <div class="nav-item">Archived Proposals</div>
  </div>

  <div class="content-section">
    <h3>Curriculum Dashboard</h3>
    <p>
      <span data-field="dashboard_description_1">{{ dashboard_description_1 }}</span>
      <span data-field="dashboard_description_2">{{ dashboard_description_2 }}</span>
      <span data-field="dashboard_description_3">{{ dashboard_description_3 }}</span>
    </p>
    <table>
      <thead>
        <tr>
          <th>College</th>
          <th>Department</th>
          <th>Type</th>
          <th>Name</th>
          <th>Workflow</th>
          <th>Date</th>
          <th>User</th>
        </tr>
      </thead>
      <tbody>
        {% for item in dashboard_items %}
        <tr>
          <td><span data-field="dashboard_items[{{ loop.index0 }}].college">{{ item.college }}</span></td>
          <td><span data-field="dashboard_items[{{ loop.index0 }}].department">{{ item.department }}</span></td>
          <td><span data-field="dashboard_items[{{ loop.index0 }}].type">{{ item.type }}</span></td>
          <td><span data-field="dashboard_items[{{ loop.index0 }}].name">{{ item.name }}</span></td>
          <td><span data-field="dashboard_items[{{ loop.index0 }}].workflow">{{ item.workflow }}</span></td>
          <td><span data-field="dashboard_items[{{ loop.index0 }}].date">{{ item.date }}</span></td>
          <td><span data-field="dashboard_items[{{ loop.index0 }}].user">{{ item.user }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    <p style="margin-top: 20px;">
      <span data-field="dashboard_summary_text">Showing {{ dashboard_count }} of {{ dashboard_total }} entries.</span>
    </p>
  </div>
</div>

<div class="page">
  <div class="content-section">
    <h3>My Items</h3>
    <p>
      <span data-field="my_items_description_1">{{ my_items_description_1 }}</span>
      <span data-field="my_items_description_2">{{ my_items_description_2 }}</span>
      <span data-field="my_items_description_3">{{ my_items_description_3 }}</span>
    </p>
    <table>
      <thead>
        <tr>
          <th>College</th>
          <th>Department</th>
          <th>Type</th>
          <th>Name</th>
          <th>Workflow</th>
          <th>Date</th>
          <th>User</th>
        </tr>
      </thead>
      <tbody>
        {% for item in my_items %}
        <tr>
          <td><span data-field="my_items[{{ loop.index0 }}].college">{{ item.college }}</span></td>
          <td><span data-field="my_items[{{ loop.index0 }}].department">{{ item.department }}</span></td>
          <td><span data-field="my_items[{{ loop.index0 }}].type">{{ item.type }}</span></td>
          <td><span data-field="my_items[{{ loop.index0 }}].name">{{ item.name }}</span></td>
          <td><span data-field="my_items[{{ loop.index0 }}].workflow">{{ item.workflow }}</span></td>
          <td><span data-field="my_items[{{ loop.index0 }}].date">{{ item.date }}</span></td>
          <td><span data-field="my_items[{{ loop.index0 }}].user">{{ item.user }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    <p style="margin-top: 20px;">
      <span data-field="my_items_summary_text">Showing {{ my_items_count }} of {{ my_items_total }} entries.</span>
    </p>
  </div>
</div>

<div class="page">
  <div class="content-section">
    <h3>The Archived Proposals Tab</h3>
    <p>
      <span data-field="archived_description_1">{{ archived_description_1 }}</span>
      <span data-field="archived_description_2">{{ archived_description_2 }}</span>
      <span data-field="archived_description_3">{{ archived_description_3 }}</span>
    </p>
  </div>

  <div class="content-section" style="display: flex; gap: 50px;">
    <div style="flex: 1;">
      <h4>Workflow</h4>
      <div style="border: 1px solid #ccc; padding: 15px;">
        <p>Workflow Status: <span data-field="archived_workflow_status">{{ archived_workflow_status }}</span></p>
        <p>Action: <span data-field="archived_workflow_action">{{ archived_workflow_action }}</span></p>
        <p>Date: <span data-field="archived_workflow_date">{{ archived_workflow_date }}</span></p>
        <p>User: <span data-field="archived_workflow_user">{{ archived_workflow_user }}</span></p>
        <button class="button" style="margin-top: 10px;">Save</button>
        <button class="button" style="margin-top: 10px; background-color: #6c757d;">Compare Versions</button>
      </div>
    </div>
    <div style="flex: 1;">
      <h4>Audit Trail</h4>
      <div style="border: 1px solid #ccc; padding: 15px;">
        <p>Audit Trail: <span data-field="audit_trail_description">{{ audit_trail_description }}</span></p>
        <p>It provides the name of the person who originally created the proposal, the date, and list previous comments.</p>
        <p>After reviewing the proposal, you can approve, return to submitter, add comments and print the form for your records if needed. All the can be viewed by the next person who is reviewing the proposal.</p>
        <ul style="list-style-type: none; padding: 0;">
          {% for audit in audit_trail %}
            <li style="margin-bottom: 10px; border-bottom: 1px dotted #eee; padding-bottom: 5px;">
              <strong>{{ audit.timestamp }}</strong> - <span data-field="audit_trail[{{ loop.index0 }}].action">{{ audit.action }}</span> by <span data-field="audit_trail[{{ loop.index0 }}].user">{{ audit.user }}</span>
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</div>

</body>
</html>