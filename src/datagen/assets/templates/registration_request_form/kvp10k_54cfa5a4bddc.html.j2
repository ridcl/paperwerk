<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1 { font-size: 24pt; font-weight: bold; text-align: center; margin-bottom: 10px; }
  .header-info { display: flex; justify-content: space-between; font-size: 10pt; margin-bottom: 20px; }
  .form-row { display: flex; margin-bottom: 15px; font-size: 11pt; }
  .form-row > div { flex: 1; padding-right: 20px; }
  .form-row label { display: block; margin-bottom: 5px; font-weight: bold; }
  .form-row input[type="text"] { border-bottom: 1px solid black; width: 100%; padding: 2px 0; }
  .checkbox-group { margin-top: 10px; }
  .signature-line { margin-top: 50px; border-bottom: 1px solid black; width: 80%; }
  .notes-box { border: 1px solid black; height: 100px; margin-top: 10px; padding: 10px; font-size: 11pt; }
  .term-key-table { width: 100%; border-collapse: collapse; margin-top: 20px; font-size: 10pt; }
  .term-key-table th, .term-key-table td { border: 1px solid #ccc; padding: 5px; text-align: center; }
</style>

<div class="page">
  <h1>Continuation of Capstone/Thesis Registration Request Form</h1>
  <div class="header-info">
    <div>
      <p>Rochester Institute of Technology</p>
    </div>
    <div>
      <p>Data Science</p>
      <p>GOL (70) Rm. 1690</p>
      <p>{{ department_email }}</p>
    </div>
  </div>

  <div class="form-row">
    <div>
      <label>Last Name:</label>
      <input type="text" value="{{ student.last_name }}">
    </div>
    <div>
      <label>First Name:</label>
      <input type="text" value="{{ student.first_name }}">
    </div>
    <div>
      <label>Student ID:</label>
      <input type="text" value="{{ student.id }}">
    </div>
  </div>

  <p style="font-weight: bold;">This form should only be used when requesting a <span data-field="term_type">{{ term_type }}</span> for Capstone or Thesis</p>

  <div class="form-row">
    <div>
      <label>Request Registration:</label>
      <div class="checkbox-group">
        <label><input type="checkbox"> Capstone</label>
        <label><input type="checkbox"> Thesis</label>
      </div>
    </div>
    <div>
      <label>Number of Credits Per Term:</label>
      <input type="text" value="{{ credits_per_term }}">
    </div>
  </div>

  <div class="form-row">
    <div>
      <label>Advisor:</label>
      <input type="text" value="{{ advisor_name }}">
    </div>
    <div>
      <label>Tentative Title:</label>
      <input type="text" value="{{ tentative_title }}">
    </div>
  </div>

  <div>
    <label>Notes:</label>
    <div class="notes-box">
      <span data-field="notes">{{ notes }}</span>
    </div>
  </div>

  <div class="form-row" style="margin-top: 40px;">
    <div>
      <label>Student Signature:</label>
      <div class="signature-line" data-field="student_signature">{{ student_signature }}</div>
    </div>
    <div>
      <label>Date:</label>
      <input type="text" value="{{ student_signature_date }}">
    </div>
  </div>

  <div class="form-row" style="margin-top: 40px;">
    <div>
      <label>Print Name of Student:</label>
      <input type="text" value="{{ student.full_name }}">
    </div>
  </div>

  <div class="form-row" style="margin-top: 50px;">
    <div>
      <label>Signature of Faculty Advisor:</label>
      <div class="signature-line" data-field="signature_of_faculty_advisor">{{ signature_of_faculty_advisor }}</div>
    </div>
    <div>
      <label>Date:</label>
      <input type="text" value="{{ advisor_signature_date }}">
    </div>
  </div>

  <div class="form-row" style="margin-top: 50px;">
    <div>
      <label>Signature of Graduate Director:</label>
      <div class="signature-line" data-field="signature_of_graduate_director">{{ signature_of_graduate_director }}</div>
    </div>
    <div>
      <label>Date:</label>
      <input type="text" value="{{ director_signature_date }}">
    </div>
  </div>

  <table class="term-key-table">
    <thead>
      <tr>
        <th>TERM KEY</th>
        <th>2191 = Fall 2019</th>
        <th>2195 = Spring 2020</th>
        <th>2198 = Summer 2020</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>2201 = Fall 2020</td>
        <td>2205 = Spring 2021</td>
        <td>2208 = Summer 2021</td>
      </tr>
    </tbody>
  </table>
</div>