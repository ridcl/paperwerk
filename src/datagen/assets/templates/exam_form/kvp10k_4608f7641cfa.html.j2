<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; /* Using serif fonts as a base */
  }
  .page:last-child { page-break-after: auto; }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  td {
    padding: 8px 0;
    vertical-align: top;
  }
  .header-title {
    text-align: center;
    font-size: 18pt;
    font-weight: bold;
    margin-bottom: 5px;
  }
  .header-subtitle {
    text-align: center;
    font-size: 12pt;
    margin-bottom: 20px;
  }
  .contact-info {
    display: flex;
    justify-content: space-between;
    margin-bottom: 30px;
    font-size: 10pt;
  }
  .contact-block {
    width: 48%;
  }
  .form-section {
    margin-bottom: 30px;
  }
  .form-section h3 {
    font-size: 12pt;
    margin-bottom: 15px;
    font-weight: bold;
  }
  .input-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 10px;
  }
  .input-row > div {
    width: 48%;
  }
  .checkbox-group label {
    display: block;
    margin-bottom: 5px;
    font-size: 10pt;
  }
</style>

<div class="page">
  <div style="text-align: center;">
    <div class="header-title">YESHIVA UNIVERSITY</div>
    <div class="header-subtitle">Office of Disability Services</div>
  </div>

  <div class="contact-info">
    <div class="contact-block">
      <div style="font-size: 10pt;">
        Beren Campus<br>
        <span data-field="address_line_1">{{ address_line_1 }}</span><br>
        <span data-field="city_state_zip">{{ city_state_zip }}</span><br>
        <span data-field="phone">{{ contact_phone }}</span><br>
        <span data-field="email">{{ contact_email }}</span>
      </div>
    </div>
    <div class="contact-block">
      <div style="font-size: 10pt;">
        Wilf Campus<br>
        <span data-field="address_line_1">{{ address_line_1 }}</span><br>
        <span data-field="city_state_zip">{{ city_state_zip }}</span><br>
        <span data-field="phone">{{ contact_phone_2 }}</span><br>
        <span data-field="email">{{ contact_email_2 }}</span>
      </div>
    </div>
  </div>

  <div style="text-align: center; margin-bottom: 30px;">
    <h2 style="font-size: 14pt; font-weight: bold;">EXAM IN A REDUCED DISTRACTION LOCATION</h2>
    <p style="font-size: 11pt;">FACULTY REQUEST FORM</p>
    <p style="font-size: 10pt; margin-top: 10px;">Please submit this form at least one week before exam.</p>
  </div>

  <div class="form-section">
    <table style="font-size: 10pt;">
      <tr>
        <td style="width: 50%;">
          <span style="font-weight: bold;">Professor:</span><br>
          <span data-field="professor_name">{{ professor_name }}</span>
        </td>
        <td style="width: 50%;">
          <span style="font-weight: bold;">STUDENT NAME(S):</span><br>
          <span data-field="student_name">{{ student_name }}</span>
        </td>
      </tr>
      <tr>
        <td>
          <span style="font-weight: bold;">Course title:</span><br>
          <span data-field="course_title">{{ course_title }}</span>
        </td>
        <td>
          <span style="font-weight: bold;">Professor's Email:</span><br>
          <span data-field="professor_email">{{ professor_email }}</span>
        </td>
      </tr>
      <tr>
        <td>
          <span style="font-weight: bold;">Date of exam:</span><br>
          <span data-field="exam_date">{{ exam_date }}</span>
        </td>
        <td>
          <span style="font-weight: bold;">Cell phone (during exam):</span><br>
          <span data-field="student_phone">{{ student_phone }}</span>
        </td>
      </tr>
      <tr>
        <td>
          <span style="font-weight: bold;">Class Start time of exam:</span><br>
          <span data-field="start_time">{{ start_time }}</span>
        </td>
        <td>
          <!-- Empty cell for alignment -->
        </td>
      </tr>
    </table>
  </div>

  <div class="form-section">
    <p style="font-size: 10pt; font-weight: bold; margin-bottom: 10px;">METHOD FOR EXAM DELIVERY BY INSTRUCTOR TO ODS:</p>
    <table style="font-size: 10pt;">
      <tr>
        <td style="width: 20px;"><input type="checkbox"></td>
        <td style="width: 80%;">
          <span data-field="delivery_method_email_wilf">E-mail to {{ wilf_email }} or {{ beren_email }}</span>
        </td>
      </tr>
      <tr>
        <td style="width: 20px;"><input type="checkbox"></td>
        <td style="width: 80%;">
          Drop off at ODS office by: <span data-field="dropoff_details">{{ dropoff_details }}</span>
        </td>
      </tr>
    </table>
  </div>

  <div class="form-section">
    <p style="font-size: 10pt; font-weight: bold; margin-bottom: 15px;">PLEASE CHECK THE MATERIALS YOU ARE PERMITTING FOR THIS EXAM:</p>
    <div class="checkbox-group" style="font-size: 10pt;">
      <label><input type="checkbox"> Textbook</label>
      <label><input type="checkbox"> Class notes</label>
      <label><input type="checkbox"> Laptop use – student's personal computer</label>
      <label><input type="checkbox"> Formula sheet</label>
      <label><input type="checkbox"> Calculator (specify type)</label>
      <label><input type="checkbox"> Other</label>
    </div>
  </div>

  <div class="form-section">
    <p style="font-size: 10pt; font-weight: bold; margin-bottom: 15px;">PLEASE INDICATE YOUR PREFERENCE FOR COMPLETED EXAM DELIVERY. YOUR EXAM WILL BE EMAILED TO YOU UNLESS YOU SPECIFY OTHERWISE.</p>
    <div class="checkbox-group" style="font-size: 10pt;">
      <label><input type="checkbox"> Scan and email exam to professor</label>
      <label><input type="checkbox"> BEREN: Professor will pick up exam in Student Affairs office – {{ beren_pickup_location }}</label>
      <label><input type="checkbox"> WILF: Professor will pick up exam in Disability Services office - {{ wilf_pickup_location }}</label>
    </div>
  </div>

  <div style="text-align: right; font-size: 9pt; margin-top: 50px;">
    11/17
  </div>
</div>