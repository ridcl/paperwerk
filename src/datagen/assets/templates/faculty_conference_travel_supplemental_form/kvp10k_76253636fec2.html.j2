<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1, h2 { font-weight: bold; }
  .form-row { margin-bottom: 15px; display: flex; align-items: flex-start; }
  .form-row > div { flex: 1; }
  .label-col { width: 150px; }
  .input-col { flex-grow: 1; }
  .signature-line { border-bottom: 1px solid #000; margin-top: 50px; margin-bottom: 5px; display: inline-block; width: 200px; }
</style>
<div class="page">
  <div style="text-align: center; margin-bottom: 30px;">
    <h1 style="font-size: 18pt;">International Travel</h1>
    <h2 style="font-size: 14pt;">Faculty Conference/Travel Supplemental Form*</h2>
  </div>

  <div style="margin-bottom: 20px;">
    <p>Funding is competitive and the amount available to be awarded varies from year to year. Maximum funding per faculty member is <span data-field="max_funding_amount">{{ max_funding_amount }}</span> per year.</p>
  </div>

  <div class="form-row">
    <div class="label-col">Name:</div>
    <div class="input-col"><span data-field="full_name">{{ full_name }}</span></div>
  </div>

  <div class="form-row">
    <div class="label-col">Department:</div>
    <div class="input-col">
      <span data-field="department_name">{{ department_name }}</span>
      <span style="margin-left: 30px;">Ext.:</span>
      <span data-field="extension_number">{{ extension_number }}</span>
    </div>
  </div>

  <div class="form-row" style="margin-top: 20px;">
    <div class="label-col" style="flex-grow: 1;">Name of conference/professional activity (include the name of the sponsoring organization):</div>
    <div class="input-col">
      <span data-field="conference_name">{{ conference_name }}</span>
    </div>
  </div>

  <div class="form-row" style="margin-top: 20px;">
    <div class="label-col">Date(s) of attendance and location:</div>
    <div class="input-col">
      <span data-field="attendance_dates">{{ attendance_dates }}</span>
    </div>
  </div>

  <div class="form-row" style="margin-top: 20px;">
    <div class="label-col" style="flex-grow: 1;">Please attach a copy of brochure or meeting announcement.</div>
    <div class="input-col"></div>
  </div>

  <div class="form-row" style="margin-top: 30px;">
    <div class="label-col" style="flex-grow: 1;">Briefly describe the significance of your professional development activity and how it will engage your faculty work:</div>
    <div class="input-col">
      <span data-field="activity_description">{{ activity_description }}</span>
    </div>
  </div>

  <div style="margin-top: 40px;">
    <div class="form-row">
      <div class="label-col">Amount of funding for this trip approved by FDC:</div>
      <div class="input-col"><span data-field="approved_funding_amount">{{ approved_funding_amount }}</span></div>
    </div>

    <div class="form-row">
      <div class="label-col">Estimated cost of this trip:</div>
      <div class="input-col"><span data-field="estimated_cost">{{ estimated_cost }}</span></div>
    </div>

    <div class="form-row">
      <div class="label-col">Amount requested from the international travel fund:</div>
      <div class="input-col"><span data-field="requested_amount">{{ requested_amount }}</span></div>
    </div>
  </div>

  <div style="margin-top: 40px;">
    <div class="form-row">
      <div class="label-col" style="flex-grow: 1;">Chairperson's recommendation: I approve this request and have discussed the coverage of classes and other faculty responsibilities with this faculty member.</div>
    </div>
  </div>

  <div class="form-row" style="margin-top: 30px;">
    <div class="label-col">Date:</div>
    <div class="input-col"><span data-field="chairperson_date">{{ chairperson_date }}</span></div>
    <div class="label-col" style="margin-left: 50px;">Chairperson's signature:</div>
    <div class="input-col"><span data-field="chairperson_signature">{{ chairperson_signature }}</span></div>
    <div class="label-col" style="margin-left: 50px;">Department:</div>
    <div class="input-col"><span data-field="department_signature">{{ department_signature }}</span></div>
  </div>

  <div style="margin-top: 50px;">
    <p style="font-size: 10pt;">*This form is a supplement to normal requests through FDC and addresses the higher costs of international travel.</p>
  </div>

  <div style="margin-top: 50px;">
    <div style="border-top: 1px solid #000; margin-bottom: 10px;"></div>
    <div class="form-row">
      <div class="label-col">Status of pending request:</div>
      <div class="input-col">
        <span data-field="request_status">{{ request_status }}</span>
      </div>
    </div>

    <div class="form-row">
      <div class="label-col">Date received:</div>
      <div class="input-col"><span data-field="date_received">{{ date_received }}</span></div>
      <div class="label-col" style="margin-left: 50px;">Date of trip:</div>
      <div class="input-col"><span data-field="trip_date">{{ trip_date }}</span></div>
    </div>

    <div class="form-row">
      <div class="label-col">Not approved:</div>
      <div class="input-col"><span data-field="not_approved_reason">{{ not_approved_reason }}</span></div>
      <div class="label-col" style="margin-left: 50px;">Approved:</div>
      <div class="input-col"><span data-field="approved_reason">{{ approved_reason }}</span></div>
    </div>

    <div class="form-row">
      <div class="label-col">Level of funding:</div>
      <div class="input-col"><span data-field="funding_level">{{ funding_level }}</span></div>
    </div>

    <div class="form-row" style="margin-top: 40px;">
      <div class="label-col">Provost's signature:</div>
      <div class="input-col"><span data-field="provost_signature">{{ provost_signature }}</span></div>
    </div>
  </div>
</div>