<!DOCTYPE html>
<html>
<head>
    <title>Tour Document</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif; }
        .header-logo { text-align: center; margin-bottom: 20px; }
        .tour-title { text-align: center; margin-bottom: 30px; }
        .tour-dates { text-align: center; margin-bottom: 40px; }
        .hosts-info { text-align: center; margin-bottom: 50px; }
        .section-title { font-weight: bold; margin-bottom: 15px; border-bottom: 1px solid #ccc; padding-bottom: 5px; }
        .itinerary-table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        .itinerary-table th, .itinerary-table td { border: 1px solid #ddd; padding: 10px; text-align: left; }
        .itinerary-table th { background-color: #f2f2f2; }
        .payment-section { margin-top: 50px; }
        .payment-table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        .payment-table th, .payment-table td { border: 1px solid #ddd; padding: 10px; text-align: left; }
        .payment-table th { background-color: #f2f2f2; }
        .map-container { display: flex; justify-content: space-between; margin-top: 30px; }
        .map-item { width: 48%; }
        .image-gallery { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
        .gallery-item { width: calc(33.33% - 10px); min-width: 150px; }
        .footer-info { text-align: center; margin-top: 80px; padding-top: 20px; border-top: 1px solid #ccc; }
    </style>
</head>
<body>

<div class="page">
    <div class="header-logo">
        <img src="logo_placeholder.png" alt="Fresno Pacific University Logo" style="max-width: 200px;">
        <p style="font-size: 1.2em; font-weight: bold;">FRESNO PACIFIC UNIVERSITY</p>
    </div>

    <div class="tour-title">
        <h1 style="font-size: 3em; margin-bottom: 10px;">TURKEY AND GREEK ISLANDS</h1>
    </div>

    <div class="tour-dates">
        <p style="font-size: 1.5em;">JUNE 4-18, 2022 Main Trip (15 Days)</p>
        <p style="font-size: 1.5em;">JUNE 18-25 Trip Extension (22 Days)</p>
    </div>

    <div class="hosts-info">
        <p style="font-size: 1.2em;">Tour Hosts: <span data-field="host_one_name">{{ host_one_name }}</span> & <span data-field="host_two_name">{{ host_two_name }}</span></p>
    </div>

    <div style="text-align: center; margin-top: 50px;">
        <img src="tour_image_placeholder.jpg" alt="Tour Scenery" style="width: 100%; height: auto; max-height: 400px; object-fit: cover;">
        <p style="margin-top: 20px; font-style: italic;">organized by</p>
        <h2 style="font-size: 2.5em; color: #333;">TUTKU</h2>
        <p style="font-size: 1.2em;">— EDUCATIONAL TRAVEL —</p>
    </div>
</div>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px;">
        <div style="width: 40%;">
            <img src="host_photo_1.jpg" alt="Host 1" style="width: 100%; height: auto; border-radius: 5px;">
            <h3 style="margin-top: 15px;">Dr. <span data-field="host_one_first_name">{{ host_one_first_name }}</span> <span data-field="host_one_last_name">{{ host_one_last_name }}</span>, Ph.D.</h3>
            <p><span data-field="host_one_title">{{ host_one_title }}</span></p>
            <p><span data-field="host_one_department">{{ host_one_department }}</span></p>
        </div>
        <div style="width: 40%;">
            <img src="host_photo_2.jpg" alt="Host 2" style="width: 100%; height: auto; border-radius: 5px;">
            <h3 style="margin-top: 15px;">Dr. <span data-field="host_two_first_name">{{ host_two_first_name }}</span> <span data-field="host_two_last_name">{{ host_two_last_name }}</span>, Ph.D.</h3>
            <p><span data-field="host_two_title">{{ host_two_title }}</span></p>
            <p><span data-field="host_two_department">{{ host_two_department }}</span></p>
        </div>
    </div>

    <div class="section-title">Tour Itinerary:</div>
    <table class="itinerary-table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Activity</th>
            </tr>
        </thead>
        <tbody>
            {% for day in itinerary %}
            <tr>
                <td><span data-field="itinerary[{{ loop.index0 }}].date">{{ day.date }}</span></td>
                <td><span data-field="itinerary[{{ loop.index0 }}].activity">{{ day.activity }}</span></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="section-title" style="margin-top: 40px;">Trip Extension Option: Cappadocia</div>
    <p>Dates: <span data-field="extension_dates">{{ extension_dates }}</span></p>
    <table class="itinerary-table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Activity</th>
            </tr>
        </thead>
        <tbody>
            {% for day in extension_itinerary %}
            <tr>
                <td><span data-field="extension_itinerary[{{ loop.index0 }}].date">{{ day.date }}</span></td>
                <td><span data-field="extension_itinerary[{{ loop.index0 }}].activity">{{ day.activity }}</span></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<div class="page">
    <div class="map-container">
        <div class="map-item">
            <img src="world_map_placeholder.png" alt="World Map" style="width: 100%; height: auto;">
            <h3 style="text-align: center; margin-top: 10px;">TOUR MAP</h3>
        </div>
        <div class="map-item">
            <img src="tour_map_placeholder.png" alt="Tour Map" style="width: 100%; height: auto;">
            <h3 style="text-align: center; margin-top: 10px;">MAIN TOUR (JUNE 4-18, 2022)</h3>
            <p>Starting Price: <span data-field="main_tour_price">{{ main_tour_price }}</span></p>
            <p>Single Room Supplement: <span data-field="main_tour_supplement">{{ main_tour_supplement }}</span></p>
            <h3 style="margin-top: 20px;">TOUR EXTENSION (JUNE 18-25)</h3>
            <p>Starting Price: <span data-field="extension_tour_price">{{ extension_tour_price }}</span></p>
            <p>Single Room Supplement: <span data-field="extension_tour_supplement">{{ extension_tour_supplement }}</span></p>
        </div>
    </div>

    <div style="display: flex; justify-content: space-between; margin-top: 40px;">
        <div style="width: 48%;">
            <h3 style="font-weight: bold;">INCLUDING</h3>
            <ul>
                <li><span data-field="inclusion_item_1">{{ inclusion_item_1 }}</span></li>
                <li><span data-field="inclusion_item_2">{{ inclusion_item_2 }}</span></li>
                <li><span data-field="inclusion_item_3">{{ inclusion_item_3 }}</span></li>
                <li><span data-field="inclusion_item_4">{{ inclusion_item_4 }}</span></li>
                <li><span data-field="inclusion_item_5">{{ inclusion_item_5 }}</span></li>
            </ul>
        </div>
        <div style="width: 48%;">
            <h3 style="font-weight: bold;">EXCLUDING</h3>
            <ul>
                <li><span data-field="exclusion_item_1">{{ exclusion_item_1 }}</span></li>
                <li><span data-field="exclusion_item_2">{{ exclusion_item_2 }}</span></li>
                <li><span data-field="exclusion_item_3">{{ exclusion_item_3 }}</span></li>
                <li><span data-field="exclusion_item_4">{{ exclusion_item_4 }}</span></li>
            </ul>
        </div>
    </div>
</div>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px;">
        <div style="width: 48%;">
            <div class="section-title">PAYMENT PROCEDURE:</div>
            <table class="payment-table">
                <thead>
                    <tr>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1- <span data-field="payment_step_1">{{ payment_step_1 }}</span></td>
                        <td><span data-field="payment_deadline_1">{{ payment_deadline_1 }}</span></td>
                    </tr>
                    <tr>
                        <td>2- <span data-field="payment_step_2">{{ payment_step_2 }}</span></td>
                        <td><span data-field="payment_deadline_2">{{ payment_deadline_2 }}</span></td>
                    </tr>
                    <tr>
                        <td>Cancellation Policy:</td>
                        <td>
                            <ul style="list-style-type: disc; margin-left: 20px;">
                                <li><span data-field="cancellation_policy_1">{{ cancellation_policy_1 }}</span></li>
                                <li><span data-field="cancellation_policy_2">{{ cancellation_policy_2 }}</span></li>
                                <li><span data-field="cancellation_policy_3">{{ cancellation_policy_3 }}</span></li>
                                <li><span data-field="cancellation_policy_4">{{ cancellation_policy_4 }}</span></li>
                            </ul>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div style="width: 48%;">
            <div class="section-title">For Registration, and payment please contact:</div>
            <p>Dr. <span data-field="contact_first_name">{{ contact_first_name }}</span> <span data-field="contact_last_name">{{ contact_last_name }}</span>, Ph.D.</p>
            <p><span data-field="contact_title">{{ contact_title }}</span></p>
            <p><span data-field="contact_institution">{{ contact_institution }}</span></p>
            <p><span data-field="contact_address">{{ contact_address }}</span></p>
            <p>Office: <span data-field="contact_office">{{ contact_office }}</span></p>
            <p>Email: <span data-field="contact_email">{{ contact_email }}</span></p>
        </div>
    </div>

    <div class="footer-info">
        <img src="tutku_logo_footer.png" alt="Tutku Logo" style="max-width: 250px; margin-bottom: 15px;">
        <p>Gazi Osmanpaşa Bulvarı 3/303 İzmir 35210 TURKEY</p>
        <p>Phone: <span data-field="tutku_phone">{{ tutku_phone }}</span> | Fax: <span data-field="tutku_fax">{{ tutku_fax }}</span></p>
        <p>Visit our website for tours: <a href="#" data-field="tutku_website">{{ tutku_website }}</a></p>
        <p>Email for customized group & individual tour requests: <a href="#" data-field="tutku_email">{{ tutku_email }}</a></p>
    </div>
</div>

</body>
</html>