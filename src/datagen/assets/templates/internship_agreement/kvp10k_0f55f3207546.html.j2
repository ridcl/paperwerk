<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; }
  h1, h2, h3 { font-weight: bold; }
  .header-info { margin-bottom: 30px; }
  .section-title { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 15px; }
  .form-row > div { width: 48%; }
  .line-break { border-bottom: 1px solid #000; display: inline-block; width: 100%; }
</style>

<div class="page">
  <div class="header-info">
    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
      <div>
        <h1 style="font-size: 36px; margin: 0;">California State University<br>Northridge</h1>
      </div>
      <div>
        <p style="margin: 0;">Purchasing & Contract Administration</p>
      </div>
    </div>
    <h2 style="text-align: center; margin-top: 30px;">Request to Initiate an Internship Agreement</h2>
  </div>

  <div style="margin-bottom: 30px;">
    <p>University Hall {{ university_hall_number }}</p>
    <p>Phone: ({{ phone_area_code }}) {{ phone_prefix }}-{{ phone_suffix }}</p>
    <p>Fax: ({{ fax_area_code }}) {{ fax_prefix }}-{{ fax_suffix }}</p>
    <p>Mail Code: {{ mail_code }}</p>
    <p>Email: <a href="mailto:{{ email_address }}">{{ email_address }}</a></p>
  </div>

  <div class="section-title">I. TYPE OF ORGANIZATION</div>
  <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
    <div>Non-Profit</div>
    <div>Government</div>
    <div>School</div>
    <div>Other</div>
  </div>

  <div class="section-title">II. COMMUNITY PARTNER (CP)</div>
  <div class="form-row">
    <div>
      Community Partner: <span class="line-break"></span>
    </div>
    <div>
      Street Address: <span class="line-break"></span>
    </div>
  </div>
  <div class="form-row">
    <div>
      Executive Director: <span class="line-break"></span>
    </div>
    <div>
      City: <span class="line-break"></span>
      State: <span class="line-break"></span> Zip+4: <span class="line-break"></span>
    </div>
  </div>
  <div class="form-row">
    <div>
      Telephone No.: <span class="line-break"></span> Fax No.: <span class="line-break"></span>
    </div>
    <div>
      Email Address: <span class="line-break"></span>
    </div>
  </div>
  <div class="form-row">
    <div>
      Alt. Telephone No.: <span class="line-break"></span> Website Url: <span class="line-break"></span>
    </div>
  </div>

  <div class="section-title">III. COMMUNITY PARTNER MISSION STATEMENT (OPTIONAL):</div>
  <div style="border: 1px solid #ccc; padding: 10px; min-height: 80px;">
    <p>{{ mission_statement }}</p>
  </div>

  <div class="section-title">IV. INHERENT RISKS:</div>
  <p>Please list all known risks inherent to the internship environment, associated with your organization, (facility hazards, location concerns, personal issues, etc.):</p>
  <div style="border: 1px solid #ccc; padding: 10px; min-height: 80px;">
    <p>{{ inherent_risks }}</p>
  </div>

  <div style="margin-top: 50px;">
    <div style="display: flex; justify-content: space-between;">
      <div>
        Faculty Member Requesting Internship Agreement: <span class="line-break"></span>
      </div>
      <div>
        Date: <span class="line-break"></span>
      </div>
    </div>
    <div style="margin-top: 30px;">
      Name of Student: <span class="line-break"></span>
    </div>
  </div>
</div>