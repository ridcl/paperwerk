<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; }
  h1, h2, h3 { font-weight: bold; }
  .header-info { display: flex; justify-content: space-between; margin-bottom: 20px; }
  .form-section { margin-bottom: 30px; }
  .input-row { display: flex; justify-content: space-between; margin-bottom: 10px; }
  .input-row div { width: 50%; }
  .checkbox-group label { display: block; margin-bottom: 5px; }
  .text-area-container { border: 1px solid #ccc; padding: 10px; min-height: 150px; margin-top: 10px; }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      <img src="placeholder_logo.png" alt="Florida Atlantic University Logo" style="height: 80px;">
    </div>
    <div style="text-align: right;">
      <div style="font-size: 12px;">Aid Year: <span data-field="aid_year">{{ aid_year }}</span></div>
      <div style="margin-top: 20px;">
        <h2 style="font-size: 16px; margin: 0;">Florida State Programs Academic Progress Appeal</h2>
        <p style="margin: 2px 0;">Office of Student Financial Aid | Florida Atlantic University</p>
        <p style="font-weight: bold; margin: 5px 0;">FORM: STAAPP</p>
      </div>
    </div>
  </div>

  <div style="border: 1px solid #ccc; padding: 15px; margin: 20px 0;">
    <p style="font-size: 12px;">Submit this form online via <a href="#" style="color: blue;">owflies.fau.edu</a></p>
    <p style="font-size: 12px;">Need Help? Visit <a href="#" style="color: blue;">fau.edu/finaid/contact</a></p>
  </div>

  <div class="form-section">
    <div class="input-row">
      <div>Student Name: <span data-field="full_name">{{ full_name }}</span></div>
      <div>Student Z Number: <span data-field="student_z_number">{{ student_z_number }}</span></div>
    </div>
    <div class="input-row">
      <div>Address: <span data-field="address">{{ address }}</span></div>
      <div>FAU Email Address: <span data-field="fau_email_address">{{ fau_email_address }}</span></div>
    </div>
    <div class="input-row">
      <div></div>
      <div>Telephone: <span data-field="telephone">{{ telephone }}</span></div>
    </div>
  </div>

  <div class="form-section">
    <h3 style="font-weight: bold;">YOU MUST SUBMIT THIS FORM ALONG WITH THE FOLLOWING:</h3>
    <ol>
      <li>A detailed <span data-field="statement_of_circumstances_description">{{ statement_of_circumstances_description }}</span> explaining the reason for your appeal.</li>
      <li>An unofficial copy of an updated <span data-field="academic_transcript">{{ academic_transcript }}</span>.</li>
      <li>Any verifiable documentation that supports your reason for appeal.</li>
    </ol>
  </div>

  <div class="form-section">
    <h3 style="font-weight: bold;">STATE PROGRAM: (Check One)</h3>
    <div class="checkbox-group">
      <label><input type="checkbox"> Florida Academic Scholarship</label>
      <label><input type="checkbox"> Medallion Scholarship</label>
      <label><input type="checkbox"> FSAG</label>
    </div>
  </div>

  <div class="form-section">
    <h3 style="font-weight: bold;">DESCRIPTION OF CIRCUMSTANCES: (Check One)</h3>
    <div class="checkbox-group">
      <label><input type="checkbox"> Personal injury, illness, or physical disability</label>
      <label><input type="checkbox"> Death/illness of immediate family member</label>
      <label><input type="checkbox"> Emergency</label>
      <label><input type="checkbox"> GPA or hours accurate/changed (for FSAG only)</label>
    </div>
  </div>

  <div class="form-section">
    <h3 style="font-weight: bold;">STUDENT STATEMENT OF CIRCUMSTANCES:</h3>
    <p style="font-size: 12px;">You may use this space or attach a typed statement explaining the mitigating circumstances that you feel affected your academic progress.</p>
    <div class="text-area-container">
      <!-- Placeholder for detailed statement -->
      <span data-field="detailed_statement_content">{{ detailed_statement_content }}</span>
    </div>
  </div>

  <div class="form-section" style="margin-top: 40px;">
    <p style="font-weight: bold; text-align: center; margin-bottom: 20px;">REMEMBER: ATTACH VERIFIABLE DOCUMENTATION AND UPDATED TRANSCRIPT TO SUPPORT YOUR APPEAL.</p>
    <p style="font-size: 12px; text-align: center;">You must submit this appeal within 30 days of the date of your ineligibility notice or by September 1st of the upcoming aid year, whichever is later.</p>
  </div>

  <div class="form-section" style="display: flex; justify-content: space-between; margin-top: 50px;">
    <div>
      Student Signature
    </div>
    <div>
      Date
    </div>
  </div>
</div>