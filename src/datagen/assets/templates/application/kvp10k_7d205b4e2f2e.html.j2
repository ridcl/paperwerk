<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1, h2, h3 { text-align: center; margin-bottom: 0.5em; }
  .header-logo { float: left; margin-right: 30px; }
  .form-section { margin-bottom: 20px; }
  .line-item { display: flex; margin-bottom: 15px; }
  .line-item > div { flex: 1; }
  .signature-line { border-bottom: 1px solid #000; margin-top: 50px; margin-bottom: 5px; }
</style>

<div class="page">
  <div class="header-logo">
    <!-- Placeholder for University Logo -->
    <img src="" alt="University Logo" style="width: 100px;">
  </div>
  <h1 style="text-align: center;">Application for Permission to Elect</h1>
  <h2 style="text-align: center;">CECP 6050 – Professional Issues and Ethics</h2>

  <div class="form-section">
    <p>Return this form to <span data-field="recipient_name">{{ recipient_name }}</span>, CECP Administrative Assistant, via email at <span data-field="recipient_email">{{ recipient_email }}</span>.</p>
  </div>

  <div class="form-section">
    <div class="line-item">
      <div>Course CRN #: <span data-field="course_crn">{{ course_crn }}</span></div>
    </div>
  </div>

  <div class="form-section">
    <div class="line-item">
      <div>Semester: <span data-field="semester">{{ semester }}</span></div>
    </div>
  </div>

  <div class="form-section">
    <div class="line-item">
      <div>Today's Date: <span data-field="today_date">{{ today_date }}</span></div>
    </div>
  </div>

  <div class="form-section">
    <div class="line-item">
      <div>Student Name: <span data-field="student_name">{{ student_name }}</span></div>
    </div>
  </div>

  <div class="form-section">
    <div class="line-item">
      <div>Address: <span data-field="student_address">{{ student_address }}</span></div>
    </div>
  </div>

  <div class="form-section" style="display: flex; justify-content: space-between;">
    <div style="width: 45%;">City: <span data-field="student_city">{{ student_city }}</span></div>
    <div style="width: 25%; text-align: center;">State: <span data-field="student_state">{{ student_state }}</span></div>
    <div style="width: 30%;">Zip code: <span data-field="student_zip_code">{{ student_zip_code }}</span></div>
  </div>

  <div class="form-section">
    <div class="line-item">
      <div>WIN#: <span data-field="win_number">{{ win_number }}</span></div>
    </div>
  </div>

  <div class="form-section">
    <p>Program:</p>
    <div style="margin-top: 10px;">
      <label><input type="checkbox" data-field="program_options[0]" value="{{ program_options[0] }}"> Clinical Mental Health Counseling—M.A.</label><br>
      <label><input type="checkbox" data-field="program_options[1]" value="{{ program_options[1] }}"> Counseling Psychology—M.A.</label><br>
      <label><input type="checkbox" data-field="program_options[2]" value="{{ program_options[2] }}"> Marriage Couple Family Counseling—M.A.</label><br>
      <label><input type="checkbox" data-field="program_options[3]" value="{{ program_options[3] }}"> Rehabilitation Counseling (Generalist) and Rehabilitation Counseling/Teaching (concentration in Blindness and Low Vision)—M.A.</label><br>
      <label><input type="checkbox" data-field="program_options[4]" value="{{ program_options[4] }}"> School Counseling—M.A.</label><br>
    </div>
  </div>

  <div class="form-section">
    <div class="line-item">
      <div>Advisor: <span data-field="advisor_name">{{ advisor_name }}</span></div>
    </div>
  </div>

  <div class="form-section">
    <div class="line-item">
      <div>Total Credit Hours completed in your CECP program to date: <span data-field="total_credit_hours">{{ total_credit_hours }}</span></div>
    </div>
  </div>

  <div class="form-section">
    <div class="line-item">
      <div>Current # enrolled hours: <span data-field="current_enrolled_hours">{{ current_enrolled_hours }}</span></div>
    </div>
  </div>

</div>