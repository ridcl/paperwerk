<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  .form-label {
    display: inline-block;
    width: 150px; /* Approximate width for alignment */
    vertical-align: top;
    margin-bottom: 5px;
  }
  .form-input {
    border-bottom: 1px solid #000;
    display: inline-block;
    width: calc(100% - 160px); /* Adjust based on label width */
    min-width: 200px;
    margin-bottom: 10px;
  }
  .full-width-input {
    border-bottom: 1px solid #000;
    display: block;
    width: 100%;
    margin-bottom: 10px;
  }
  .signature-line {
    border-bottom: 1px solid #000;
    display: inline-block;
    width: 300px;
    margin-bottom: 5px;
  }
</style>

<div class="page">
  <div style="text-align: center; margin-bottom: 30px;">
    <h1 style="font-family: 'DejaVu Serif', serif; font-size: 48px; margin: 0;">Dickinson</h1>
  </div>
  <div style="text-align: center; margin-bottom: 20px;">
    <h2 style="font-family: 'DejaVu Sans', sans-serif; font-size: 24px; margin: 0;">Discover Diversity at Dickinson Application</h2>
  </div>
  <div style="text-align: center; margin-bottom: 20px; font-size: 14px;">
    Submit via e-mail to <span data-field="contact.email">{{ contact.email }}</span> or fax to <span data-field="contact.fax">{{ contact.fax }}</span>
  </div>
  <div style="text-align: center; margin-bottom: 30px; font-size: 14px;">
    Due Date: <span data-field="due_date">{{ due_date }}</span>
  </div>

  <div style="margin-bottom: 20px;">
    Please print clearly
  </div>

  <div style="margin-bottom: 20px;">
    Name: <span class="form-input">{{ applicant.full_name }}</span>
  </div>
  <div style="margin-bottom: 20px;">
    Street Address: <span class="form-input">{{ applicant.address.street }}</span>
  </div>

  <div style="margin-bottom: 20px;">
    City: <span class="form-input">{{ applicant.address.city }}</span>
    State: <span class="form-input" style="width: 100px;">{{ applicant.address.state }}</span>
    Zip: <span class="form-input" style="width: 100px;">{{ applicant.address.zip }}</span>
  </div>

  <div style="margin-bottom: 20px;">
    Home Phone: <span class="form-input">{{ applicant.phone.home }}</span>
  </div>
  <div style="margin-bottom: 20px;">
    Cell Phone: <span class="form-input">{{ applicant.phone.cell }}</span>
  </div>

  <div style="margin-bottom: 20px;">
    Race/Ethnicity: <span class="form-input">{{ applicant.demographics.race_ethnicity }}</span>
    Gender: <span class="form-input">{{ applicant.demographics.gender }}</span>
  </div>

  <div style="margin-bottom: 20px;">
    Additional information regarding your sex or gender identity:
    <div class="full-width-input" style="height: 60px; margin-top: 5px;" data-field="gender">{{ gender }}</div>
  </div>

  <div style="margin-bottom: 20px;">
    Citizenship: (please check one) U.S. Citizen <span class="form-input" style="width: 20px;" data-field="gender_2">{{ gender_2 }}</span> U.S. Permanent Resident <span class="form-input" style="width: 20px;" data-field="citizenship_u_s_citizen">{{ citizenship_u_s_citizen }}</span> Non-Resident <span class="form-input" style="width: 20px;" data-field="u_s_permanent_resident">{{ u_s_permanent_resident }}</span>
  </div>

  <div style="margin-bottom: 20px;">
    Student Email: <span class="form-input">{{ applicant.email.student }}</span>
  </div>
  <div style="margin-bottom: 20px;">
    Parent Email: <span class="form-input">{{ applicant.email.parent }}</span>
  </div>

  <div style="text-align: center; margin-top: 50px;">
    <p>1</p>
  </div>
</div>

<div class="page">
  <h2 style="font-family: 'DejaVu Sans', sans-serif; font-size: 20px; margin-bottom: 20px;">High School Information</h2>

  <div style="margin-bottom: 20px;">
    High School/State: <span class="form-input">{{ high_school.name }}</span>
  </div>
  <div style="margin-bottom: 20px;">
    Graduation Year: <span class="form-input">{{ high_school.graduation_year }}</span>
  </div>
  <div style="margin-bottom: 20px;">
    Guidance Counselor Name: <span class="form-input">{{ high_school.counselor.name }}</span>
  </div>
  <div style="margin-bottom: 20px;">
    Guidance Counselor Phone Number: <span class="form-input">{{ high_school.counselor.phone }}</span>
  </div>
  <div style="margin-bottom: 20px;">
    Guidance Counselor Email: <span class="form-input">{{ high_school.counselor.email }}</span>
  </div>

  <h2 style="font-family: 'DejaVu Sans', sans-serif; font-size: 20px; margin-top: 40px; margin-bottom: 20px;">Organization Information (if applicable)</h2>

  {% for org in organizations %}
  <div style="margin-bottom: 20px;">
    Organization Name: <span class="form-input">{{ org.name }}</span>
  </div>
  <div style="margin-bottom: 20px;">
    Organization Counselor Phone Number: <span class="form-input">{{ org.counselor.phone }}</span>
  </div>
  <div style="margin-bottom: 20px;">
    Organization Counselor Email: <span class="form-input">{{ org.counselor.email }}</span>
  </div>
  {% endfor %}

  <h2 style="font-family: 'DejaVu Sans', sans-serif; font-size: 20px; margin-top: 40px; margin-bottom: 20px;">Academic Information</h2>

  <div style="margin-bottom: 20px;">
    GPA: <span class="form-input">{{ academic.gpa }}</span>
  </div>

  <div style="margin-bottom: 20px;">
    Standardized Test Scores: SAT (CR/MA/WR): <span class="form-input" style="width: 50px;" data-field="gpa">{{ gpa }}</span> / <span class="form-input" style="width: 50px;" data-field="standardized_test_scores_sat">{{ standardized_test_scores_sat }}</span> / <span class="form-input" style="width: 50px;" data-field="standardized_test_scores_sat_2">{{ standardized_test_scores_sat_2 }}</span> ACT Composite: <span class="form-input" style="width: 50px;" data-field="standardized_test_scores_sat_3">{{ standardized_test_scores_sat_3 }}</span>
  </div>

  <div style="margin-bottom: 20px;">
    Please include a copy of your high school transcript and senior year courses.
  </div>

  <div style="margin-bottom: 20px;">
    List any college-prep or community-based organizations in which you participate:
    <div class="full-width-input" style="height: 80px; margin-top: 5px;" data-field="act_composite">{{ act_composite }}</div>
  </div>

  <div style="margin-bottom: 20px;">
    List any club and activities in which you are involved:
    <div class="full-width-input" style="height: 80px; margin-top: 5px;" data-field="field_1">{{ field_1 }}</div>
  </div>

  <div style="text-align: center; margin-top: 50px;">
    <p>2</p>
  </div>
</div>

<div class="page">
  <div style="margin-bottom: 30px;">
    A limited number of travel grants will be available to reimburse students' expenses.
  </div>

  <div style="margin-bottom: 20px;">
    Will you be seeking reimbursement for travel expenses? Yes <span class="form-input" style="width: 20px;" data-field="field_2">{{ field_2 }}</span> No <span class="form-input" style="width: 20px;" data-field="field_3">{{ field_3 }}</span>
  </div>

  <h2 style="font-family: 'DejaVu Sans', sans-serif; font-size: 20px; margin-top: 30px; margin-bottom: 15px;">Short Answer/Essay (required)</h2>
  <p style="font-weight: bold; margin-bottom: 10px;">Why would you like to attend Discover Diversity at Dickinson? What is it about Dickinson that you would like to explore?</p>
  <div class="full-width-input" style="height: 200px; margin-top: 5px;" data-field="short_answer_essay">{{ short_answer_essay }}</div>

  <div style="margin-top: 60px;">
    <div style="display: flex; justify-content: space-between;">
      <div style="width: 45%;">
        Student Signature:
        <div class="signature-line" style="margin-top: 5px;" data-field="field_4">{{ field_4 }}</div>
        Date: <span class="form-input" style="width: 150px; display: inline-block; margin-left: 10px;">{{ signature_date }}</span>
      </div>
      <div style="width: 45%;">
        Parent Signature:
        <div class="signature-line" style="margin-top: 5px;" data-field="date">{{ date }}</div>
        Date: <span class="form-input" style="width: 150px; display: inline-block; margin-left: 10px;">{{ parent_signature_date }}</span>
      </div>
    </div>
  </div>

  <div style="margin-top: 40px;">
    Counselor Signature:
    <div class="signature-line" style="margin-top: 5px;" data-field="date_2">{{ date_2 }}</div>
    Date: <span class="form-input" style="width: 150px; display: inline-block; margin-left: 10px;">{{ counselor_signature_date }}</span>
  </div>

  <div style="text-align: center; margin-top: 50px;">
    <p>3</p>
  </div>
</div>