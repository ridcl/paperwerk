<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1, h2, h3 { text-align: center; }
  .header-section { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px; }
  .logo-area { text-align: left; }
  .title-area { text-align: right; }
  .form-row { display: flex; margin-bottom: 15px; align-items: center; }
  .form-row > div { flex: 1; }
  .form-row label { width: 150px; font-weight: bold; }
  .input-field { border-bottom: 1px solid #000; min-width: 100px; }
  .section-title { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
  .list-item { margin-bottom: 5px; }
</style>
<body>
  <div class="page">
    <div class="header-section">
      <div class="logo-area">
        <!-- Placeholder for University Logo/Name -->
        <span style="font-size: 30px; font-weight: bold;">[University Logo Placeholder]</span>
        <div style="font-size: 18px; font-weight: bold;">FLORIDA GULF COAST UNIVERSITY</div>
      </div>
      <div class="title-area">
        <h1 style="font-size: 24px;">COLLEGE OF EDUCATION</h1>
        <h2 style="font-size: 20px;">MINOR IN EDUCATION</h2>
        <h3 style="font-size: 16px;">Application</h3>
      </div>
    </div>

    <p>Please print or type</p>

    <!-- Personal Information Section -->
    <div class="form-row" style="margin-top: 30px;">
      <label>University Identification Number</label>
      <div style="flex: 3;">
        <span class="input-field" style="display: inline-block; width: 30%;" data-field="university_identification_number">{{ university_identification_number }}</span>
        <span class="input-field" style="display: inline-block; width: 30%;" data-field="university_identification_number_2">{{ university_identification_number_2 }}</span>
        <span class="input-field" style="display: inline-block; width: 30%;" data-field="university_identification_number_3">{{ university_identification_number_3 }}</span>
      </div>
      <label>Date</label>
      <div style="flex: 1;">
        <span class="input-field" data-field="date">{{ date }}</span>
      </div>
    </div>

    <div class="form-row">
      <label>NAME:</label>
      <div style="flex: 1;">
        <span class="input-field" data-field="full_name_last">{{ full_name_last }}</span>
      </div>
      <label>Last</label>
      <div style="flex: 1;">
        <span class="input-field" data-field="full_name_first">{{ full_name_first }}</span>
      </div>
      <label>First</label>
      <div style="flex: 1;">
        <span class="input-field" data-field="full_name_middle">{{ full_name_middle }}</span>
      </div>
      <label>Middle</label>
      <div style="flex: 1;">
        <span class="input-field" data-field="middle">{{ middle }}</span>
      </div>
      <label>Suffix (Jr., Sr., III, etc.)</label>
      <div style="flex: 1;">
        <span class="input-field" data-field="suffix">{{ suffix }}</span>
      </div>
    </div>

    <div class="form-row">
      <label>Number and Street Address</label>
      <div style="flex: 3;">
        <span class="input-field" data-field="address_line_1">{{ address_line_1 }}</span>
      </div>
      <label>City</label>
      <div style="flex: 1;">
        <span class="input-field" data-field="city">{{ city }}</span>
      </div>
      <label>State</label>
      <div style="flex: 1;">
        <span class="input-field" data-field="state">{{ state }}</span>
      </div>
      <label>Zip Code</label>
      <div style="flex: 1;">
        <span class="input-field" data-field="zip_code">{{ zip_code }}</span>
      </div>
    </div>

    <div class="form-row">
      <label>Home Telephone</label>
      <div style="flex: 3;">
        <span class="input-field" data-field="phone_home">{{ phone_home }}</span>
      </div>
      <label>Work Telephone</label>
      <div style="flex: 3;">
        <span class="input-field" data-field="phone_work">{{ phone_work }}</span>
      </div>
      <label>Email Address</label>
      <div style="flex: 3;">
        <span class="input-field" data-field="email">{{ email }}</span>
      </div>
    </div>

    <div class="form-row">
      <label>Current Major</label>
      <div style="flex: 3;">
        <span class="input-field" data-field="current_major">{{ current_major }}</span>
      </div>
      <label>Expected Graduation Date</label>
      <div style="flex: 3;">
        <span class="input-field" data-field="graduation_date">{{ graduation_date }}</span>
      </div>
    </div>

    <!-- Program Requirements Section -->
    <div class="section-title">Semester Hours Required for Minor: 18</div>

    <div class="section-title">Required Courses (12 credits)</div>
    <ul style="list-style-type: disc; padding-left: 20px;">
      <li class="list-item">EDF 3253 Learning Mgmt Inclusive Class (3)</li>
      <li class="list-item">EDF 4470 Classroom Assessment (3)</li>
      <li class="list-item">RED 4344 Methods of Teaching Reading (3)</li>
      <li class="list-item">TSL 4340 Methods, Cur. and Instr Effect (3)</li>
    </ul>

    <div class="section-title">Restricted Electives (6 credits)</div>
    <div class="section-title">One of the following:</div>
    <ul style="list-style-type: disc; padding-left: 20px;">
      <li class="list-item">EDG 3323 Professional Teaching Practice (3)</li>
      <li class="list-item">MAE 4152 Math Methods 6-12 (3)</li>
      <li class="list-item">SCE 4330 Science Methods 6-12 (3)</li>
      <li class="list-item">SSE 4153 Social Science Methods 6-12 (3)</li>
    </ul>

    <div class="section-title">One of the following:</div>
    <ul style="list-style-type: disc; padding-left: 20px;">
      <li class="list-item">EDF 3132 Adolescent Growth & Dev (3)*</li>
      <li class="list-item">EDF 4112 Child Growth and Development (3)**</li>
    </ul>

    <p style="margin-top: 30px;">*6-12 Teaching focus</p>
    <p style="margin-top: 10px;">**Pre K-6 Teaching focus</p>

    <p style="margin-top: 50px;">Effective Fall 2017</p>
  </div>
</body>