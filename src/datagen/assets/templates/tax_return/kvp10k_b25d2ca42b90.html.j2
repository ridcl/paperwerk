      <td><span data-field="expense_legal_professional">{{ expense_legal_professional }}</span></td>
      <td></td>
      <td></td>
    </tr>
    <tr>
      <td>11 Management fees</td>
      <td><span data-field="expense_management_fees">{{ expense_management_fees }}</span></td>
      <td></td>
      <td></td>
    </tr>
    <tr>
      <td>12 Mortgage interest paid to banks, etc. (see instructions)</td>
      <td><span data-field="expense_mortgage_interest">{{ expense_mortgage_interest }}</span></td>
      <td></td>
      <td></td>
    </tr>
    <tr>
      <td>13 Other interest</td>
      <td><span data-field="expense_other_interest">{{ expense_other_interest }}</span></td>
      <td></td>
      <td></td>
    </tr>
    <tr>
      <td>14 Repairs</td>
      <td><span data-field="expense_repairs">{{ expense_repairs }}</span></td>
      <td></td>
      <td></td>
    </tr>
    <tr>
      <td>15 Supplies</td>
      <td><span data-field="expense_supplies">{{ expense_supplies }}</span></td>
      <td></td>
      <td></td>
    </tr>
    <tr>
      <td>16 Taxes</td>
      <td><span data-field="expense_taxes">{{ expense_taxes }}</span></td>
      <td></td>
      <td></td>
    </tr>
    <tr>
      <td>17 Utilities</td>
      <td><span data-field="expense_utilities">{{ expense_utilities }}</span></td>
