<!DOCTYPE html>
<html>
<head>
<title>Schedule E Template</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    font-size: 11pt;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 15px;
  }
  td, th {
    padding: 4px 8px;
    text-align: left;
  }
  .header-row td {
    font-weight: bold;
  }
  .section-title {
    font-weight: bold;
    margin-top: 15px;
    margin-bottom: 5px;
  }
  .line-item-label {
    width: 150px; /* Adjust as needed for alignment */
  }
</style>
</head>
<body>
<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      <h2 style="font-size: 14pt; margin: 0;">SCHEDULE E</h2>
      <p style="margin: 5px 0 0 0;">(Form 1040)</p>
    </div>
    <div style="text-align: right;">
      <p style="margin: 0;">OMB No. 1545-0074</p>
      <p style="margin: 0;">2025</p>
      <p style="margin: 0;">Attachment Schedule No. <span data-field="attachment_number">{{ attachment_number }}</span></p>
    </div>
  </div>
  <div style="margin-top: 20px;">
    <p>Name(s) shown on return: <span data-field="filer_name">{{ filer_name }}</span></p>
    <p>Your social security number</p>
  </div>

  <h3 class="section-title">Part I</h3>
  <p>Income or Loss From Rental Real Estate and Royalties</p>
  <p>Note: If you are in the business of renting personal property, use Schedule C. See instructions. If you are an individual, report farm rental income or loss from Form 4835 on page 2, line 40.</p>

  <table style="margin-top: 10px;">
    <tr class="header-row">
      <td style="width: 10%;">A</td>
      <td style="width: 10%;">B</td>
      <td style="width: 10%;">C</td>
      <td style="width: 10%;">D</td>
      <td style="width: 10%;">E</td>
      <td style="width: 10%;">F</td>
      <td style="width: 10%;">G</td>
    </tr>
    <tr>
      <td>1a</td>
      <td style="width: 70%;">Physical address of each property (street, city, state, ZIP code)</td>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
    </tr>
    <tr>
      <td>1b</td>
      <td style="width: 70%;">Type of Property:</td>
      <td><span data-field="property_type_1">{{ property_type_1 }}</span></td>
      <td><span data-field="property_type_2">{{ property_type_2 }}</span></td>
      <td><span data-field="property_type_3">{{ property_type_3 }}</span></td>
      <td><span data-field="property_type_4">{{ property_type_4 }}</span></td>
      <td><span data-field="property_type_5">{{ property_type_5 }}</span></td>
      <td><span data-field="property_type_6">{{ property_type_6 }}</span></td>
    </tr>
  </table>

  <table style="margin-top: 15px;">
    <tr class="header-row">
      <td style="width: 20%;">Type of Property:</td>
      <td style="width: 10%;">1</td>
      <td style="width: 10%;">2</td>
      <td style="width: 10%;">3</td>
      <td style="width: 10%;">4</td>
      <td style="width: 10%;">5</td>
      <td style="width: 10%;">6</td>
    </tr>
    <tr>
      <td></td>
      <td><span data-field="property_type_detail_1">{{ property_type_detail_1 }}</span></td>
      <td><span data-field="property_type_detail_2">{{ property_type_detail_2 }}</span></td>
      <td><span data-field="property_type_detail_3">{{ property_type_detail_3 }}</span></td>
      <td><span data-field="property_type_detail_4">{{ property_type_detail_4 }}</span></td>
      <td><span data-field="property_type_detail_5">{{ property_type_detail_5 }}</span></td>
      <td><span data-field="property_type_detail_6">{{ property_type_detail_6 }}</span></td>
    </tr>
  </table>

  <h3 class="section-title" style="margin-top: 25px;">Income:</h3>
  <table style="margin-top: 10px;">
    <tr class="header-row">
      <td style="width: 15%;"></td>
      <td style="width: 10%;">A</td>
      <td style="width: 10%;">B</td>
      <td style="width: 10%;">C</td>
    </tr>
    <tr>
      <td>3 Rents received</td>
      <td><span data-field="income_rents_received">{{ income_rents_received }}</span></td>
      <td></td>
      <td></td>
    </tr>
    <tr>
      <td>4 Royalties received</td>
      <td><span data-field="income_royalties_received">{{ income_royalties_received }}</span></td>
      <td></td>
      <td></td>
    </tr>
  </table>

  <h3 class="section-title" style="margin-top: 25px;">Expenses:</h3>
  <table style="margin-top: 10px;">
    <tr class="header-row">
      <td style="width: 15%;"></td>
      <td style="width: 10%;">A</td>
      <td style="width: 10%;">B</td>
      <td style="width: 10%;">C</td>
    </tr>
    <tr>
      <td>5 Advertising</td>
      <td><span data-field="expense_advertising">{{ expense_advertising }}</span></td>
      <td></td>
      <td></td>
    </tr>
    <tr>
      <td>6 Auto and travel (see instructions)</td>
      <td><span data-field="expense_auto_travel">{{ expense_auto_travel }}</span></td>
      <td></td>
      <td></td>
    </tr>
    <tr>
      <td>7 Cleaning and maintenance</td>
      <td><span data-field="expense_cleaning_maintenance">{{ expense_cleaning_maintenance }}</span></td>
