    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "DejaVu Sans", "Liberation Sans", Helvetica, Arial;
  }
  .page:last-child {
    page-break-after: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
    margin-bottom: 10px;
  }
  td, th {
    padding: 8px;
    text-align: left;
    border: 1px solid #ccc;
  }
  .header-row th {
    background-color: #f0f0f0;
    font-weight: bold;
  }
  .form-label {
    font-weight: bold;
    display: inline-block;
    width: 150px; /* Adjust as necessary for alignment */
  }
  .section-title {
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
  }
</style>
<style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
        }
        .page:last-child { page-break-after: auto; }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
