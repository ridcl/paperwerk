                    <th style="width: 15%; text-align: center;">(h) Current year excess business interest expense carryforward</th>
                </tr>
            </thead>
            <tbody>
                {% for item in partnership_items %}
                <tr>
                    <td><span data-field="partnership_items[{{ loop.index0 }}].name">{{ item.name }}</span></td>
                    <td class="center"><span data-field="partnership_items[{{ loop.index0 }}].ein">{{ item.ein }}</span></td>
                    <td class="center"><span data-field="partnership_items[{{ loop.index0 }}].current_taxable_income">{{ item.current_taxable_income }}</span></td>
                    <td class="center"><span data-field="partnership_items[{{ loop.index0 }}].prior_carryforward">{{ item.prior_carryforward }}</span></td>
                    <td class="center"><span data-field="partnership_items[{{ loop.index0 }}].total">{{ item.total }}</span></td>
                    <td class="center"><span data-field="partnership_items[{{ loop.index0 }}].current_excess_interest_income">{{ item.current_excess_interest_income }}</span></td>
                    <td class="center"><span data-field="partnership_items[{{ loop.index0 }}].excess_business_interest_income">{{ item.excess_business_interest_income }}</span></td>
                    <td class="center"><span data-field="partnership_items[{{ loop.index0 }}].excess_interest_expense_carryforward">{{ item.excess_interest_expense_carryforward }}</span></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>

        <table style="width: 100%;">
            <tr>
                <td style="width: 25%; padding-bottom: 5px;">44 Total</td>
                <td style="width: 10%; text-align: center; padding-bottom: 5px;"></td>
                <td style="width: 15%; text-align: center; padding-bottom: 5px;"></td>
                <td style="width: 15%; text-align: center; padding-bottom: 5px;"></td>
                <td style="width: 15%; text-align: center; padding-bottom: 5px;"></td>
                <td style="width: 15%; text-align: center; padding-bottom: 5px;"></td>
                <td style="width: 15%; text-align: center; padding-bottom: 5px;"></td>
                <td style="width: 15%; text-align: center; padding-bottom: 5px;"></td>
            </tr>
        </table>

        <h3 style="margin-top: 30px; margin-bottom: 10px;">SCHEDULE B Summary of S Corporation Shareholder's Excess Taxable Income and Excess Business Interest Income</h3>
        <p style="font-size: 0.9em; margin-bottom: 15px;">Any taxpayer that is required to complete Part I and is a shareholder in an S corporation that has excess taxable income or excess business interest income should complete Schedule B before completing Part I.</p>

        <table style="width: 100%;">
            <thead>
                <tr>
                    <th style="width: 25%; text-align: left;">(a) Name of S corporation</th>
                    <th style="width: 10%; text-align: center;">(b) EIN</th>
                    <th style="width: 20%; text-align: center;">(c) Current year excess taxable income</th>
                    <th style="width: 20%; text-align: center;">(d) Current year excess business interest income</th>
                </tr>
            </thead>
            <tbody>
                {% for item in s_corp_items %}
                <tr>
                    <td><span data-field="s_corp_items[{{ loop.index0 }}].name">{{ item.name }}</span></td>
                    <td class="center"><span data-field="s_corp_items[{{ loop.index0 }}].ein">{{ item.ein }}</span></td>
                    <td class="center"><span data-field="s_corp_items[{{ loop.index0 }}].current_excess_taxable_income">{{ item.current_excess_taxable_income }}</span></td>
                    <td class="center"><span data-field="s_corp_items[{{ loop.index0 }}].current_excess_business_interest_income">{{ item.current_excess_business_interest_income }}</span></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>

        <table style="width: 100%;">
            <tr>
                <td style="width: 25%; padding-bottom: 5px;">46 Total</td>
                <td class="center" style="width: 20%; padding-bottom: 5px;"></td>
                <td class="center" style="width: 20%; padding-bottom: 5px;"><span data-field="s_corp_items_total.current_excess_taxable_income">{{ s_corp_items_total.current_excess_taxable_income }}</span></td>
                <td class="center" style="width: 20%; padding-bottom: 5px;"><span data-field="s_corp_items_total.current_excess_business_interest_income">{{ s_corp_items_total.current_excess_business_interest_income }}</span></td>
            </tr>
        </table>

        <div style="display: flex; justify-content: space-between; margin-top: 50px;">
            <div></div>
            <div>Form 8990 (Rev. 5-2020)</div>
        </div>
    </div>
</body>
</html>