<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 15px;
  }
  td, th {
    padding: 4px 8px;
    text-align: left;
  }
  .form-row {
    display: flex;
    margin-bottom: 5px;
    align-items: baseline;
  }
  .form-label {
    width: 150px; /* Adjust as necessary for layout matching */
    font-weight: normal;
  }
  .form-input {
    flex-grow: 1;
    text-align: right;
  }
  .section-title {
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
  }
  .line-item-table td:nth-child(1) { width: 30%; }
  .line-item-table td:nth-child(2) { width: 30%; }
  .line-item-table td:nth-child(3) { width: 20%; }
  .line-item-table td:nth-child(4) { width: 20%; }
</style>
<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px;">
    <div style="font-size: 16pt; font-weight: bold;">990-T</div>
    <div style="text-align: right;">
      <div style="font-size: 12pt;">OMB No. 15-6038</div>
      <div style="font-size: 14pt; font-weight: bold;">2018</div>
    </div>
  </div>

  <h2 style="font-size: 14pt; font-weight: bold; margin-bottom: 10px;">Exempt Organization Business Income Tax Return (and proxy tax under section 6033(e))</h2>

  <div style="margin-bottom: 20px;">
    <p style="font-size: 10pt;">For calendar year <span data-field="tax_year">{{ tax_year }}</span> or other tax year beginning <span data-field="start_date">{{ start_date }}</span> and ending <span data-field="end_date">{{ end_date }}</span>.</p>
  </div>

  <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
    <div style="width: 48%;">
      <p style="font-weight: bold;">Name of organization (check if name changed and use close identification):</p>
      <div style="border-bottom: 1px solid #000; padding-bottom: 2px;">
        <span data-field="organization_name">{{ organization_name }}</span>
      </div>
      <p style="font-weight: bold; margin-top: 10px;">Principal address:</p>
      <div style="border-bottom: 1px solid #000; padding-bottom: 2px;">
        <span data-field="organization_address">{{ organization_address }}</span>
      </div>
    </div>
    <div style="width: 48%; text-align: right;">
      <p style="font-weight: bold;">EIN:</p>
      <div style="border-bottom: 1px solid #000; padding-bottom: 2px;">
        <span data-field="ein">{{ ein }}</span>
      </div>
      <p style="font-weight: bold; margin-top: 10px;">Employer identification number (if different from EIN):</p>
      <div style="border-bottom: 1px solid #000; padding-bottom: 2px;">
        <span data-field="employer_id">{{ employer_id }}</span>
      </div>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Type of organization:</p>
    <div style="display: flex; gap: 20px; margin-top: 5px;">
      <label><input type="checkbox"> 501(c)(3)</label>
      <label><input type="checkbox"> 501(c)(4)</label>
      <label><input type="checkbox"> Other trust</label>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">H Enter the number of the organization's unrelated trades or businesses. <span data-field="num_unrelated_businesses">{{ num_unrelated_businesses }}</span></p>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Describe the entity (or first unrelated trade or business here). <span data-field="description_unrelated_business">{{ description_unrelated_business }}</span></p>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">I During the tax year, was the corporation a subsidiary in an affiliated group or a parent-subsidiary control group? <span data-field="is_subsidiary_or_parent">{{ is_subsidiary_or_parent }}</span> Yes <span data-field="is_subsidiary_or_parent_yes">{{ is_subsidiary_or_parent_yes }}</span> No</p>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">J The books are in <span data-field="books_location">{{ books_location }}</span>.</p>
  </div>

  <h3 style="font-size: 12pt; font-weight: bold; margin-top: 25px; margin-bottom: 10px;">Part I Unrelated Trade or Business Income</h3>
  <table class="line-item-table">
    <thead>
      <tr>
        <th style="width: 30%;">Gross receipts or sales</th>
        <th style="width: 30%;">Balance</th>
        <th style="width: 20%;">Income (A)</th>
        <th style="width: 20%;">Expenses (B)</th>
        <th style="width: 20%;">Net</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="part1_gross_receipts">{{ part1_gross_receipts }}</span></td>
        <td><span data-field="part1_balance">{{ part1_balance }}</span></td>
        <td><span data-field="part1_income">{{ part1_income }}</span></td>
        <td><span data-field="part1_expenses">{{ part1_expenses }}</span></td>
        <td><span data-field="part1_net">{{ part1_net }}</span></td>
      </tr>
    </tbody>
  </table>

  <h3 style="font-size: 12pt; font-weight: bold; margin-top: 25px; margin-bottom: 10px;">Part II Deductions Not Taken Elsewhere</h3>
  <table class="line-item-table">
    <thead>
      <tr>
        <th style="width: 30%;">Description</th>
        <th style="width: 30%;">Amount</th>
        <th style="width: 20%;">Amount</th>
        <th style="width: 20%;">Amount</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="part2_deduction_1">{{ part2_deduction_1 }}</span></td>
        <td><span data-field="part2_amount_1">{{ part2_amount_1 }}</span></td>
        <td><span data-field="part2_amount_2">{{ part2_amount_2 }}</span></td>
        <td><span data-field="part2_amount_3">{{ part2_amount_3 }}</span></td>
      </tr>
      <tr>
        <td><span data-field="part2_deduction_2">{{ part2_deduction_2 }}</span></td>
        <td><span data-field="part2_amount_2">{{ part2_amount_2 }}</span></td>
        <td><span data-field="part2_amount_3">{{ part2_amount_3 }}</span></td>
        <td><span data-field="part2_amount_4">{{ part2_amount_4 }}</span></td>
      </tr>
      <tr>
        <td><span data-field="part2_deduction_3">{{ part2_deduction_3 }}</span></td>
        <td><span data-field="part2_amount_3">{{ part2_amount_3 }}</span></td>
        <td><span data-field="part2_amount_4">{{ part2_amount_4 }}</span></td>
        <td><span data-field="part2_amount_5">{{ part2_amount_5 }}</span></td>
      </tr>
      <tr>
        <td><span data-field="part2_deduction_4">{{ part2_deduction_4 }}</span></td>
        <td><span data-field="part2_amount_4">{{ part2_amount_4 }}</span></td>
        <td><span data-field="part2_amount_5">{{ part2_amount_5 }}</span></td>
        <td><span data-field="part2_amount_6">{{ part2_amount_6 }}</span></td>
      </tr>
      <tr>
        <td><span data-field="part2_deduction_5">{{ part2_deduction_5 }}</span></td>
        <td><span data-field="part2_amount_5">{{ part2_amount_5 }}</span></td>
        <td><span data-field="part2_amount_6">{{ part2_amount_6 }}</span></td>
        <td><span data-field="part2_amount_7">{{ part2_amount_7 }}</span></td>
      </tr>
    </tbody>
  </table>

  <h3 style="font-size: 12pt; font-weight: bold; margin-top: 25px; margin-bottom: 10px;">Part III Total Unrelated Business Taxable Income</h3>
  <table class="line-item-table">
    <thead>
      <tr>
        <th style="width: 30%;">Total of unrelated business taxable income computed from all unrelated trades or businesses (see instructions).</th>
        <th style="width: 30%;"></th>
        <th style="width: 20%;"></th>
        <th style="width: 20%;"></th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="part3_total_income">{{ part3_total_income }}</span></td>
        <td><span data-field="part3_total_income_amount">{{ part3_total_income_amount }}</span></td>
        <td><span data-field="part3_total_income_amount_2">{{ part3_total_income_amount_2 }}</span></td>
        <td><span data-field="part3_total_income_amount_3">{{ part3_total_income_amount_3 }}</span></td>
      </tr>
    </tbody>
  </table>

  <h3 style="font-size: 12pt; font-weight: bold; margin-top: 25px; margin-bottom: 10px;">Part IV Tax Computation</h3>
  <table class="line-item-table">
    <thead>
      <tr>
        <th style="width: 30%;">Description</th>
        <th style="width: 30%;"></th>
        <th style="width: 20%;"></th>
        <th style="width: 20%;"></th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="part4_taxable_income_amount">{{ part4_taxable_income_amount }}</span></td>
        <td><span data-field="part4_taxable_income_amount_2">{{ part4_taxable_income_amount_2 }}</span></td>
        <td><span data-field="part4_tax_rate">{{ part4_tax_rate }}</span></td>
        <td><span data-field="part4_tax_amount">{{ part4_tax_amount }}</span></td>
      </tr>
      <tr>
        <td><span data-field="part4_alternative_min_tax">{{ part4_alternative_min_tax }}</span></td>
        <td><span data-field="part4_alternative_min_tax_amount">{{ part4_alternative_min_tax_amount }}</span></td>
        <td></td>
        <td><span data-field="part4_alternative_min_tax_amount_2">{{ part4_alternative_min_tax_amount_2 }}</span></td>
      </tr>
    </tbody>
  </table>

  <h3 style="font-size: 12pt; font-weight: bold; margin-top: 25px; margin-bottom: 10px;">Part V Tax and Payments</h3>
  <table class="line-item-table">
    <thead>
      <tr>
        <th style="width: 30%;">Description</th>
        <th style="width: 30%;"></th>
        <th style="width: 20%;"></th>
        <th style="width: 20%;"></th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="part5_tax_due">{{ part5_tax_due }}</span></td>
        <td><span data-field="part5_tax_due_amount">{{ part5_tax_due_amount }}</span></td>
        <td><span data-field="part5_payments_amount">{{ part5_payments_amount }}</span></td>
        <td><span data-field="part5_tax_due_after_payments">{{ part5_tax_due_after_payments }}</span></td>
      </tr>
    </tbody>
  </table>

  <div style="margin-top: 40px;">
    <p style="font-size: 10pt;">Signature of authorized officer:</p>
    <div style="border-bottom: 1px solid #000; width: 300px;">
      <span data-field="signature_line">{{ signature_line }}</span>
    </div>
    <p style="font-size: 10pt;">Printed name:</p>
    <div style="border-bottom: 1px solid #000; width: 300px;">
      <span data-field="printed_name">{{ printed_name }}</span>
    </div>
  </div>
</div>
<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px;">
    <div style="font-size: 16pt; font-weight: bold;">Schedule A- Cost of Goods Sold</div>
    <div style="text-align: right;">
      <div style="font-size: 12pt;">Statement 4</div>
    </div>
  </div>

  <table class="line-item-table">
    <thead>
      <tr>
        <th style="width: 30%;">Inventory at beginning of year</th>
        <th style="width: 30%;">Inventory at end of year</th>
        <th style="width: 20%;">Cost of goods sold</th>
        <th style="width: 20%;"></th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="sch_a_inv_beg">{{ sch_a_inv_beg }}</span></td>
        <td><span data-field="sch_a_inv_end">{{ sch_a_inv_end }}</span></td>
        <td><span data-field="sch_a_cogs">{{ sch_a_cogs }}</span></td>
        <td><span data-field="sch_a_notes">{{ sch_a_notes }}</span></td>
      </tr>
    </tbody>
  </table>

  <h3 style="font-size: 12pt; font-weight: bold; margin-top: 25px; margin-bottom: 10px;">Schedule B- Other Costs</h3>
  <table class="line-item-table">
    <thead>
      <tr>
        <th style="width: 30%;">Description</th>
        <th style="width: 30%;">Amount</th>
        <th style="width: 20%;"></th>
        <th style="width: 20%;"></th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="sch_b_description">{{ sch_b_description }}</span></td>
        <td><span data-field="sch_b_amount">{{ sch_b_amount }}</span></td>
        <td><span data-field="sch_b_notes">{{ sch_b_notes }}</span></td>
        <td></td>
      </tr>
    </tbody>
  </table>

  <h3 style="font-size: 12pt; font-weight: bold; margin-top: 25px; margin-bottom: 10px;">Schedule C- Rent Income (From Real Property and Personal Property Leased With Real Property)</h3>
  <table class="line-item-table">
    <thead>
      <tr>
        <th style="width: 30%;">Description of property</th>
        <th style="width: 30%;"></th>
        <th style="width: 20%;"></th>
        <th style="width: 20%;"></th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="sch_c_property_desc">{{ sch_c_property_desc }}</span></td>
        <td><span data-field="sch_c_amount_1">{{ sch_c_amount_1 }}</span></td>
        <td><span data-field="sch_c_amount_2">{{ sch_c_amount_2 }}</span></td>
        <td><span data-field="sch_c_amount_3">{{ sch_c_amount_3 }}</span></td>
      </tr>
    </tbody>
  </table>

  <h3 style="font-size: 12pt; font-weight: bold; margin-top: 25px; margin-bottom: 10px;">Schedule D- Unrelated Debt-Financed Income</h3>
  <table class="line-item-table">
    <thead>
      <tr>
        <th style="width: 30%;">Description of debt-financed property</th>
        <th style="width: 30%;"></th>
        <th style="width: 20%;"></th>
        <th style="width: 20%;"></th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="sch_d_property_desc">{{ sch_d_property_desc }}</span></td>
        <td><span data-field="sch_d_amount_1">{{ sch_d_amount_1 }}</span></td>
        <td><span data-field="sch_d_amount_2">{{ sch_d_amount_2 }}</span></td>
        <td><span data-field="sch_d_amount_3">{{ sch_d_amount_3 }}</span></td>
      </tr>
    </tbody>
  </table>

  <h3 style="font-size: 12pt; font-weight: bold; margin-top: 25px; margin-bottom: 10px;">Schedule E- Investment Income</h3>
  <table class="line-item-table">
    <thead>
      <tr>
        <th style="width: 30%;">Description of income</th>
        <th style="width: 30%;">Amount of income</th>
        <th style="width: 20%;"></th>
        <th style="width: 20%;"></th>
      </tr>
    </thead>
    <tbody>
      {% for item in investment_income %}
      <tr>
        <td><span data-field="sch_e_description">{{ item.description }}</span></td>
        <td><span data-field="sch_e_amount">{{ item.amount }}</span></td>
        <td></td>
        <td></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <h3 style="font-size: 12pt; font-weight: bold; margin-top: 25px; margin-bottom: 10px;">Schedule J- Advertising Income</h3>
  <table class="line-item-table">
    <thead>
      <tr>
        <th style="width: 30%;">Name of periodical</th>
        <th style="width: 30%;">Gross advertising income</th>
        <th style="width: 20%;">Direct advertising costs</th>
        <th style="width: 20%;">Circulation income</th>
      </tr>
    </thead>
    <tbody>
      {% for item in advertising_income %}
      <tr>
        <td><span data-field="sch_j_periodical_name">{{ item.periodical_name }}</span></td>
        <td><span data-field="sch_j_gross_income">{{ item.gross_income }}</span></td>
        <td><span data-field="sch_j_direct_costs">{{ item.direct_costs }}</span></td>
        <td><span data-field="sch_j_circulation_income">{{ item.circulation_income }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <h3 style="font-size: 12pt; font-weight: bold; margin-top: 25px; margin-bottom: 10px;">Schedule K- Compensation of Officers, Directors, and Trustees</h3>
  <table class="line-item-table">
    <thead>
      <tr>
        <th style="width: 30%;">Name</th>
        <th style="width: 30%;">Title</th>
        <th style="width: 20%;">Percent of time devoted to organization</th>
        <th style="width: 20%;">Compensation attributable to unrelated business</th>
      </tr>
    </thead>
    <tbody>
      {% for item in officer_compensation %}
      <tr>
        <td><span data-field="sch_k_name">{{ item.name }}</span></td>
        <td><span data-field="sch_k_title">{{ item.title }}</span></td>
        <td><span data-field="sch_k_percent_time">{{ item.percent_time }}</span></td>
        <td><span data-field="sch_k_compensation">{{ item.compensation }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px;">
    <div style="font-size: 16pt; font-weight: bold;">Form 990-T (2018)</div>
    <div style="text-align: right;">
      <div style="font-size: 12pt;">Tax Year 2018, Fiscal Year 2019</div>
    </div>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">Central Michigan University</p>
    <p style="font-weight: bold;">EIN: <span data-field="ein_990t">{{ ein_990t }}</span></p>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-weight: bold;">ELECTION STATEMENT</p>
    <p style="font-size: 10pt;">Section 1.263(a)-(f) De Minimis Safe Harbor Election</p>
    <p style="font-weight: bold;">Central Michigan University</p>
    <p style="font-weight: bold;">304 Warminer</p>
    <p style="font-weight: bold;">Mt. Pleasant, MI 48859</p>
    <p style="font-size: 10pt;">Employer identification number: <span data-field="ein_990t_employer">{{ ein_990t_employer }}</span></p>
    <p style="font-size: 10pt;">For the year ending June 30, 2019</p>
    <p style="font-size: 10pt;">Central Michigan University is making the de minimis safe harbor election under Reg. Sec. 1.263(a)-(f).</p>
  </div>
</div>

