<!DOCTYPE html>
<html>
<head>
    <title>Synthetic Document</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 15px; }
        td, th { padding: 5px; text-align: left; }
        .header-title { font-size: 14pt; font-weight: bold; margin-bottom: 10px; }
        .section-header { font-size: 12pt; font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
        .sub-header { font-size: 10pt; font-weight: bold; margin-top: 15px; margin-bottom: 5px; }
        .label { font-weight: normal; }
        .value { font-weight: normal; }
        .right-align { text-align: right; }
        .center-align { text-align: center; }
    </style>
</head>
<body>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
        <div>
            <div class="header-title">Form 990 T</div>
            <div style="font-size: 10pt;">Tax Year <span data-field="tax_year">{{ tax_year }}</span></div>
            <div style="font-size: 10pt;">Central <span data-field="organization_name">{{ organization_name }}</span></div>
            <div style="font-size: 10pt;">EIN: <span data-field="ein">{{ ein }}</span></div>
            <div style="font-size: 10pt;">Unrelated Trade or Business: <span data-field="utb_identifier">{{ utb_identifier }}</span></div>
            <div style="font-size: 10pt;">Supporting Schedules</div>
        </div>
        <div style="text-align: right;">
            <div style="font-size: 10pt;">STATEMENT 12</div>
        </div>
    </div>

    <div class="section-header" style="margin-top: 30px;">Income (from a Partnership or as a Corporation - Use S)</div>
    <table>
        <thead>
            <tr>
                <th style="width: 30%;">Description</th>
                <th class="right-align" style="width: 20%;">Amount</th>
            </tr>
        </thead>
        <tbody>
            {% for item in income_items %}
            <tr>
                <td><span data-field="income_items[{{ loop.index0 }}].description">{{ item.description }}</span></td>
                <td class="right-align"><span data-field="income_items[{{ loop.index0 }}].amount">{{ item.amount }}</span></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<div class="page">
    <div class="section-header">Schedule D</div>
    <div style="font-size: 10pt; margin-bottom: 15px;">(Form 1120)</div>
    <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
        <div>
            <div style="font-size: 10pt;">Department of the Treasury</div>
            <div style="font-size: 10pt;">Internal Revenue Service</div>
        </div>
        <div style="text-align: right;">
            <div style="font-size: 10pt;">2018</div>
            <div style="font-size: 10pt;">OMB No. 1545-0123</div>
        </div>
    </div>
    <div style="font-size: 10pt; margin-bottom: 15px;">
        <div style="font-weight: bold;">Name:</div> <span data-field="organization_name">{{ organization_name }}</span>
        <div style="font-weight: bold;">Business Activity:</div> <span data-field="business_activity">{{ business_activity }}</span>
        <div style="font-weight: bold;">EIN:</div> <span data-field="ein">{{ ein }}</span>
    </div>

    <div class="sub-header">Part I - Short-Term Capital Gains and Losses (See Instructions)</div>
    <table>
        <thead>
            <tr>
                <th style="width: 10%;">Part</th>
                <th style="width: 40%;">Description</th>
                <th style="width: 15%;">Acquisition Date</th>
                <th style="width: 15%;">Sale Date</th>
                <th style="width: 20%;">Proceeds (sales price)</th>
                <th style="width: 20%;">Cost (other basis)</th>
            </tr>
        </thead>
        <tbody>
            {% for item in short_term_items %}
            <tr>
                <td>{{ loop.index }}</td>
                <td><span data-field="short_term_items[{{ loop.index0 }}].description">{{ item.description }}</span></td>
                <td><span data-field="short_term_items[{{ loop.index0 }}].acquisition_date">{{ item.acquisition_date }}</span></td>
                <td><span data-field="short_term_items[{{ loop.index0 }}].sale_date">{{ item.sale_date }}</span></td>
                <td class="right-align"><span data-field="short_term_items[{{ loop.index0 }}].proceeds">{{ item.proceeds }}</span></td>
                <td class="right-align"><span data-field="short_term_items[{{ loop.index0 }}].cost">{{ item.cost }}</span></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="sub-header">Part II - Long-Term Capital Gains and Losses (See Instructions)</div>
    <table>
        <thead>
            <tr>
                <th style="width: 10%;">Part</th>
                <th style="width: 40%;">Description</th>
                <th style="width: 15%;">Acquisition Date</th>
                <th style="width: 15%;">Sale Date</th>
                <th style="width: 20%;">Proceeds (sales price)</th>
                <th style="width: 20%;">Cost (other basis)</th>
            </tr>
        </thead>
        <tbody>
            {% for item in long_term_items %}
            <tr>
                <td>{{ loop.index }}</td>
                <td><span data-field="long_term_items[{{ loop.index0 }}].description">{{ item.description }}</span></td>
                <td><span data-field="long_term_items[{{ loop.index0 }}].acquisition_date">{{ item.acquisition_date }}</span></td>
                <td><span data-field="long_term_items[{{ loop.index0 }}].sale_date">{{ item.sale_date }}</span></td>
                <td class="right-align"><span data-field="long_term_items[{{ loop.index0 }}].proceeds">{{ item.proceeds }}</span></td>
                <td class="right-align"><span data-field="long_term_items[{{ loop.index0 }}].cost">{{ item.cost }}</span></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="sub-header" style="margin-top: 30px;">Part III - Summary of Parts I and II</div>
    <table>
        <thead>
            <tr>
                <th style="width: 5%;"></th>
                <th style="width: 30%;">Description</th>
                <th class="right-align" style="width: 15%;">Total Proceeds</th>
                <th class="right-align" style="width: 15%;">Total Cost</th>
                <th class="right-align" style="width: 35%;">Net Gain or Loss</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>1</td>
                <td>Total short-term capital gain (line 7 over net long-term capital loss (line 15))</td>
                <td class="right-align"><span data-field="summary.total_short_term_gain">{{ summary.total_short_term_gain }}</span></td>
                <td class="right-align"><span data-field="summary.total_short_term_cost">{{ summary.total_short_term_cost }}</span></td>
                <td class="right-align"><span data-field="summary.net_short_term_gain">{{ summary.net_short_term_gain }}</span></td>
            </tr>
            <tr>
                <td>2</td>
                <td>Total net capital gain or loss (line 15 over net short-term capital loss (line 7))</td>
