            </tr>
            <tr>
                <td>16</td>
                <td>Less: accumulated depreciation (attach schedule)</td>
                <td><span data-field="asset_accumulated_depreciation">{{ asset_accumulated_depreciation }}</span></td>
                <td></td>
                <td></td>
            </tr>
            <tr>
                <td>17</td>
                <td>Investments—other (attach schedule)</td>
                <td><span data-field="asset_other_investments_book">{{ asset_other_investments_book }}</span></td>
                <td><span data-field="asset_other_investments_fmv">{{ asset_other_investments_fmv }}</span></td>
                <td></td>
            </tr>
            <tr>
                <td>18</td>
                <td>Total assets (to be completed by all filers—see page 13 of the instructions).</td>
                <td><span data-field="total_assets_book">{{ total_assets_book }}</span></td>
                <td><span data-field="total_assets_fmv">{{ total_assets_fmv }}</span></td>
                <td></td>
            </tr>
