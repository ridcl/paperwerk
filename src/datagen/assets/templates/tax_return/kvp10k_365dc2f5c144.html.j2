                <td></td>
            </tr>
            <tr>
                <td>6</td>
                <td>Less: allowance for doubtful accounts</td>
                <td><span data-field="asset_allowance_pledge">{{ asset_allowance_pledge }}</span></td>
                <td></td>
                <td></td>
            </tr>
            <tr>
                <td>7</td>
                <td>Grants receivable</td>
                <td><span data-field="asset_grants_receivable">{{ asset_grants_receivable }}</span></td>
