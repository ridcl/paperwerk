                <td></td>
            </tr>
            <tr>
                <td>8</td>
                <td>Investments</td>
                <td><span data-field="asset_investments_book">{{ asset_investments_book }}</span></td>
                <td><span data-field="asset_investments_fmv">{{ asset_investments_fmv }}</span></td>
                <td></td>
            </tr>
            <tr>
                <td>9</td>
                <td>Other notes and loans receivable (attach schedule)</td>
                <td><span data-field="asset_other_notes_book">{{ asset_other_notes_book }}</span></td>
                <td><span data-field="asset_other_notes_fmv">{{ asset_other_notes_fmv }}</span></td>
                <td></td>
            </tr>
            <tr>
                <td>10</td>
                <td>Less: allowance for doubtful accounts</td>
                <td><span data-field="asset_allowance_other_notes">{{ asset_allowance_other_notes }}</span></td>
                <td></td>
                <td></td>
            </tr>
            <tr>
                <td>11</td>
                <td>Inventories for sale or use</td>
                <td><span data-field="asset_inventories_book">{{ asset_inventories_book }}</span></td>
                <td><span data-field="asset_inventories_fmv">{{ asset_inventories_fmv }}</span></td>
                <td></td>
            </tr>
            <tr>
                <td>12</td>
                <td>Investments—US and state government obligations (attach schedule)</td>
                <td><span data-field="asset_us_gov_obligations_book">{{ asset_us_gov_obligations_book }}</span></td>
                <td><span data-field="asset_us_gov_obligations_fmv">{{ asset_us_gov_obligations_fmv }}</span></td>
                <td></td>
            </tr>
            <tr>
                <td>13</td>
                <td>Investments—corporate stock (attach schedule)</td>
