<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1, h2, h3 { font-weight: bold; }
  table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
  td { padding: 5px 0; }
  .header-info { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px; }
  .logo-area { display: flex; flex-direction: column; align-items: flex-start; }
  .form-section { margin-bottom: 30px; }
  .signature-line { margin-top: 50px; }
</style>

<div class="page">
  <div class="header-info">
    <div class="logo-area">
      <img src="" alt="Logo" style="height: 80px; width: auto;">
      <div style="font-size: 18pt; font-weight: bold;">NORTHEASTERN<br>STATE UNIVERSITY</div>
    </div>
    <div style="text-align: right;">
      <div style="font-size: 12pt;">PCERT</div>
      <div style="font-size: 12pt;">PTX</div>
      <div style="font-size: 10pt;">Northeastern State University<br>Student Financial Services<br>715 N. Grand Ave.<br>Tahlequah, OK 74464<br>Phone: (918) 444-3456<br>Fax: (918) 455-2150<br>dropbox@nsuk.edu<br>financialaid@nsuk.edu</div>
    </div>
  </div>

  <h1 style="font-size: 16pt;">2025-2026 Certification of Parent Non-Filing Form</h1>

  <table style="width: 100%; margin-top: 30px;">
    <tr>
      <td style="width: 25%;">Last Name</td>
      <td style="width: 25%;">First Name</td>
      <td style="width: 25%;">Student ID #</td>
      <td style="width: 25%;">Phone</td>
    </tr>
    <tr>
      <td><span data-field="last_name">{{ last_name }}</span></td>
      <td><span data-field="first_name">{{ first_name }}</span></td>
      <td><span data-field="student_id">{{ student_id }}</span></td>
      <td><span data-field="phone">{{ phone }}</span></td>
    </tr>
  </table>

  <div class="form-section" style="margin-top: 30px;">
    <p style="font-weight: bold;">INSTRUCTIONS: If your parent(s) <span data-field="did_not_file">{{ did_not_file }}</span> a 2023 federal income tax return, and are not required to file a 2023 tax return (IRS Form 1040), <span data-field="they_must_complete">{{ they_must_complete }}</span> this form and provide signatures. If they had income from work, they must also attach a copy of their W-2 or equivalent document.</p>
    <p>
      <input type="checkbox" style="margin-right: 10px;"> Parent(s), by checking this box and signing this form, you are verifying that you have attempted to obtain the Verification of Non-Filing Transcript from the IRS or other tax authorities and was unable to obtain the required documentation.
    </p>
  </div>

  <div class="form-section">
    <h3 style="font-size: 12pt;">Section A – Certification of Non-Tax Filing (PLEASE CHECK BOX BELOW IF NOT FILING)</h3>
    <p>
      <input type="checkbox" style="margin-right: 10px;"> I (we) certify that I (we) have not and will not file a 2023 U.S. Income Tax Return IRS Form 1040 and are not required to file.
    </p>
  </div>

  <div class="form-section">
    <h3 style="font-size: 12pt;">Section B - 2023 Source(s) of Income</h3>
    <p>You (and/or your spouse) must document all income earned from work as well as the sources of non-taxed income and your means of support for the <span data-field="year">{{ year }}</span> calendar year. Please answer each of the questions in Section B.</p>

    <table style="margin-top: 20px;">
      <thead>
        <tr>
          <th style="width: 10%;">#</th>
          <th style="width: 45%;">Employer/Type of Work</th>
          <th style="width: 25%;">Period of Work (MM/YY – MM/YY)</th>
          <th style="width: 20%;">Total Earnings (2023)</th>
        </tr>
      </thead>
      <tbody>
        {% for item in income_sources %}
        <tr>
          <td>{{ loop.index }}</td>
          <td><span data-field="income_sources[{{ loop.index0 }}].employer_type">{{ item.employer_type }}</span></td>
          <td><span data-field="income_sources[{{ loop.index0 }}].period">{{ item.period }}</span></td>
          <td><span data-field="income_sources[{{ loop.index0 }}].earnings">{{ item.earnings }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <table style="margin-top: 20px;">
      <thead>
        <tr>
          <th style="width: 10%;">#</th>
          <th style="width: 45%;">Source of Untaxed Income</th>
          <th style="width: 25%;">Monthly Amount</th>
          <th style="width: 20%;"></th>
        </tr>
      </thead>
      <tbody>
        {% for item in untaxed_income %}
        <tr>
          <td>{{ loop.index }}</td>
          <td><span data-field="untaxed_income[{{ loop.index0 }}].source">{{ item.source }}</span></td>
          <td><span data-field="untaxed_income[{{ loop.index0 }}].amount">{{ item.amount }}</span></td>
          <td></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    <p style="font-size: 9pt; margin-top: 10px;">Period benefits were received in 2023 (give month and year)</p>
  </div>

  <div class="form-section">
    <h3 style="font-size: 12pt;">Section C – Certification and Signatures</h3>
    <p>
      <input type="checkbox" style="margin-right: 10px;"> I listed earned income from work and have attached my 2023 W-2 or equivalent document
    </p>
    <p>My signature below certifies that all of the above information is true and correct.</p>

    <div style="display: flex; justify-content: space-between; margin-top: 40px;">
      <div>
        <p>Mother's (Step-Mother's) Signature:</p>
        <div style="border-bottom: 1px solid black; width: 300px;" data-field="mother_s_signature">{{ mother_s_signature }}</div>
        <p>Date:</p>
        <span data-field="mother_signature_date">{{ mother_signature_date }}</span>
      </div>
      <div>
        <p>Father's (Step-Father's) Signature:</p>
        <div style="border-bottom: 1px solid black; width: 300px;" data-field="father_s_signature">{{ father_s_signature }}</div>
        <p>Date:</p>
        <span data-field="father_signature_date">{{ father_signature_date }}</span>
      </div>
    </div>
  </div>

  <div style="margin-top: 80px; border-top: 1px solid black; padding-top: 10px;">
    <p style="font-weight: bold;">Student Financial Services</p>
    <p style="font-size: 9pt;">715 N. Grand Ave. | Tahlequah, OK 74464 | P 918.444.3456 | F 918.458.2150</p>
    <p style="text-align: right; font-size: 9pt;">www.nsuk.edu</p>
  </div>
</div>