<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; }
  table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
  td { padding: 5px 0; }
</style>

<div class="page">
  <h1 style="text-align: center;">{{ university_name }} Policy</h1>
  <h2 style="text-align: center;">Academic Policy</h2>

  <table>
    <tr>
      <td style="width: 15%;">SUBJECT:</td>
      <td style="width: 25%;"><span data-field="subject_description">{{ subject_description }}</span></td>
      <td style="width: 15%;">TITLE:</td>
      <td style="width: 35%;"><span data-field="title_description">{{ title_description }}</span></td>
    </tr>
    <tr>
      <td>CATEGORY:</td>
      <td>Board of Trustees</td>
      <td>University</td>
      <td>Functional</td>
      <td>School/Unit</td>
    </tr>
  </table>

  <table style="margin-top: 20px;">
    <tr>
      <td style="width: 20%;">Responsible Executive:</td>
      <td style="width: 40%;"><span data-field="responsible_executive_name">{{ responsible_executive_name }}</span></td>
      <td style="width: 20%;">Responsible Office:</td>
      <td style="width: 20%;"><span data-field="responsible_office_name">{{ responsible_office_name }}</span></td>
    </tr>
    <tr>
      <td>CODING:</td>
      <td><span data-field="coding_value">{{ coding_value }}</span></td>
      <td>ADOPTED:</td>
      <td><span data-field="adopted_date">{{ adopted_date }}</span></td>
    </tr>
  </table>

  <div style="margin-top: 30px;">
    <p>LAST REVIEWED: <span data-field="last_reviewed_date">{{ last_reviewed_date }}</span></p>
  </div>

  <h3 style="margin-top: 30px;">PURPOSE</h3>
  <p>{{ purpose_text }}</p>

  <h3 style="margin-top: 20px;">ACCOUNTABILITY</h3>
  <p>{{ accountability_text }}</p>

  <h3 style="margin-top: 20px;">POLICY</h3>
  <p>{{ policy_paragraph_1 }}</p>
  <p>{{ policy_paragraph_2 }}</p>
  <p>{{ policy_paragraph_3 }}</p>
  <p>{{ policy_paragraph_4 }}</p>

  <h3 style="margin-top: 20px;">PROCEDURE</h3>
  <p>{{ procedure_paragraph_1 }}</p>
  <p>{{ procedure_paragraph_2 }}</p>
  <p>{{ procedure_paragraph_3 }}</p>
</div>

<div class="page">
  <p>{{ procedure_paragraph_4_cont }}</p>
  <p>{{ procedure_paragraph_5 }}</p>
  <p>By Direction of the Provost and Senior Vice President for Academic Affairs</p>
  <p>Date: <span data-field="document_date">{{ document_date }}</span></p>
</div>