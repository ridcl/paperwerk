<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3, h4 { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 15px; }
  .form-label { font-weight: bold; }
  .input-line { border-bottom: 1px solid #000; min-width: 200px; }
  .checkbox-group label { margin-right: 15px; }
</style>

<div class="page">
  <div style="text-align: center; margin-bottom: 30px;">
    <h4 style="font-weight: bold;">APPENDIX H4</h4>
    <h3 style="font-weight: bold;">INDIVIDUAL PROPOSAL FOR FACULTY FLEX DAY</h3>
    <p style="font-style: italic;">(Article 27 – Calendar)</p>
    <p>Foothill-De Anza Community College District</p>
  </div>

  <div class="form-row">
    <div style="width: 30%;">
      <div class="form-label">Name:</div>
      <div class="input-line" style="margin-top: 5px;"><span data-field="full_name">{{ full_name }}</span></div>
    </div>
    <div style="width: 30%;">
      <div class="form-label">CWID:</div>
      <div class="input-line" style="margin-top: 5px;"><span data-field="cwid">{{ cwid }}</span></div>
    </div>
    <div style="width: 30%;">
      <div class="form-label">Last:</div>
      <div class="input-line" style="margin-top: 5px;"><span data-field="last_name">{{ last_name }}</span></div>
    </div>
    <div style="width: 30%;">
      <div class="form-label">First:</div>
      <div class="input-line" style="margin-top: 5px;"><span data-field="first_name">{{ first_name }}</span></div>
    </div>
  </div>

  <div class="form-row" style="margin-top: 20px;">
    <div style="width: 30%;">
      <div class="form-label">Full-time:</div>
      <div class="checkbox-group" style="margin-top: 5px;">
        <label><input type="checkbox"> Full-time</label>
      </div>
    </div>
    <div style="width: 30%;">
      <div class="form-label">Part-time:</div>
      <div class="checkbox-group" style="margin-top: 5px;">
        <label><input type="checkbox"> Part-time</label>
      </div>
    </div>
    <div style="width: 30%;">
      <div class="form-label">District Ext #:</div>
      <div class="input-line" style="margin-top: 5px;"><span data-field="district_extension">{{ district_extension }}</span></div>
    </div>
    <div style="width: 30%;">
      <div class="form-label">Date(s) of Activity:</div>
      <div class="input-line" style="margin-top: 5px;"><span data-field="activity_dates">{{ activity_dates }}</span></div>
    </div>
  </div>

  <div class="form-row" style="margin-top: 20px;">
    <div style="width: 30%;">
      <div class="form-label">Hours of activity to be credited:</div>
      <div class="input-line" style="margin-top: 5px;"><span data-field="credited_hours">{{ credited_hours }}</span></div>
    </div>
    <div style="width: 30%;">
      <div class="form-label">On-Campus</div>
      <div class="input-line" style="margin-top: 5px;"><span data-field="on_campus_hours">{{ on_campus_hours }}</span></div>
    </div>
    <div style="width: 30%;">
      <div class="form-label">Off-Campus</div>
      <div class="input-line" style="margin-top: 5px;"><span data-field="off_campus_hours">{{ off_campus_hours }}</span></div>
    </div>
  </div>

  <div style="margin-top: 30px;">
    <p style="font-weight: bold;">Please note:</p>
    <ol style="margin-top: 10px;">
      <li>File this form with the Division Dean or appropriate supervisor 5 working days prior to the requested flex/conference day.</li>
      <li>Attach list of fellow participants if the flex-day will be used for a collective activity of faculty in the department/division/college/District.</li>
      <li>Make and retain a copy of this form for your professional records.</li>
    </ol>
  </div>

  <div style="margin-top: 30px;">
    <p style="font-weight: bold;">I. Focus of the activity/project:</p>
    <div style="margin-top: 10px;">
      <div class="checkbox-group" style="margin-bottom: 10px;">
        <label><input type="checkbox"> Division/Department</label>
        <label><input type="checkbox"> Subject matter/discipline</label>
      </div>
      <div class="checkbox-group" style="margin-bottom: 10px;">
        <label><input type="checkbox"> College</label>
        <label><input type="checkbox"> Professional enhancement</label>
      </div>
    </div>
  </div>

  <div style="margin-top: 20px;">
    <p style="font-weight: bold;">II. Abstract:</p>
    <p style="margin-top: 5px;">a) Describe briefly what you will do:</p>
    <div class="input-line" style="margin-top: 5px;"><span data-field="abstract_description">{{ abstract_description }}</span></div>
    <p style="margin-top: 15px;">b) Specify the results of your activity/project:</p>
    <div class="input-line" style="margin-top: 5px;"><span data-field="results_description">{{ results_description }}</span></div>
    <p style="margin-top: 15px;">c) Identify at least two ways this activity/project benefits students/division/program:</p>
    <div class="input-line" style="margin-top: 5px;"><span data-field="benefits_description">{{ benefits_description }}</span></div>
  </div>

  <div style="margin-top: 40px;">
    <p style="font-weight: bold;">III. Approval:</p>
    <div class="form-row" style="margin-top: 10px;">
      <div style="width: 30%;">
        <div class="form-label">Faculty signature:</div>
        <div class="input-line" style="margin-top: 5px;"><span data-field="faculty_signature_line">{{ faculty_signature_line }}</span></div>
      </div>
      <div style="width: 30%;">
        <div class="form-label">Date:</div>
        <div class="input-line" style="margin-top: 5px;"><span data-field="faculty_date">{{ faculty_date }}</span></div>
      </div>
    </div>
    <div class="form-row" style="margin-top: 20px;">
      <div style="width: 30%;">
        <div class="form-label">Division/Program Administrator signature:</div>
        <div class="input-line" style="margin-top: 5px;"><span data-field="admin_signature_line">{{ admin_signature_line }}</span></div>
      </div>
      <div style="width: 30%;">
        <div class="form-label">Date:</div>
        <div class="input-line" style="margin-top: 5px;"><span data-field="admin_date">{{ admin_date }}</span></div>
      </div>
    </div>
  </div>

  <div style="margin-top: 40px;">
    <p style="font-weight: bold;">IV. Activity Completed:</p>
    <div class="form-row" style="margin-top: 10px;">
      <div style="width: 30%;">
        <div class="form-label">Division/Program Administrator signature:</div>
        <div class="input-line" style="margin-top: 5px;"><span data-field="completion_signature_line">{{ completion_signature_line }}</span></div>
      </div>
      <div style="width: 30%;">
        <div class="form-label">Date:</div>
        <div class="input-line" style="margin-top: 5px;"><span data-field="completion_date">{{ completion_date }}</span></div>
      </div>
    </div>
  </div>

  <div style="text-align: right; margin-top: 50px; font-size: small;">
    <span data-field="document_date_start">{{ document_date_start }}</span> to <span data-field="document_date_end">{{ document_date_end }}</span>, <span data-field="page_number">{{ page_number }}</span>
  </div>
</div>