<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 {
    font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif;
  }
  .divider {
    border-top: 1px solid #000;
    margin: 20px 0;
  }
  .form-row {
    display: flex;
    margin-bottom: 15px;
  }
  .form-row > div {
    flex: 1;
  }
  .label-col {
    flex-basis: 30%;
    padding-right: 20px;
  }
  .input-col {
    flex-basis: 70%;
  }
  .signature-line {
    border-bottom: 1px solid #000;
    margin-top: 30px;
    margin-bottom: 30px;
    width: 100%;
  }
</style>

<div class="page">
  <div style="text-align: center; margin-bottom: 30px;">
    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle;">
      <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
    </svg>
  </div>
  <h1 style="font-size: 24pt; margin-bottom: 5px;">MAIL ORDER FORM</h1>
  <p style="margin-top: 0;">Please print the email and include this portion with your payment.</p>

  <div class="divider"></div>

  <h3 style="font-size: 12pt; margin-bottom: 5px;">PATRONAGES: Season Memberships (Admissions) + Gift to PSST!</h3>
  <p style="margin-top: 0; font-size: 10pt;">Please indicate your patronage level</p>
  <div style="font-size: 10pt; margin-bottom: 15px;">
    <span style="display: inline-block; width: 150px;">SILVER CIRCLE ($3.00+)</span>
    <span style="display: inline-block; width: 150px;">BENEFACTOR ($1,500-$2,499)</span>
    <span style="display: inline-block; width: 150px;">PRODUCER ($1,000-$1,499)</span>
    <span style="display: inline-block; width: 150px;">ASSOCIATE ($150-$249)</span>
  </div>
  <div style="font-size: 10pt; margin-bottom: 20px;">
    <span style="display: inline-block; width: 150px;">PARTNER ($500-$999)</span>
    <span style="display: inline-block; width: 150px;">SUPPORTER ($250-$499)</span>
  </div>

  <p style="font-size: 10pt;">(Name as it should appear on Patrons Page in playbill)</p>

  <h3 style="font-size: 12pt; margin-bottom: 5px;">SEASON MEMBERSHIPS: Tickets only:</h3>
  <p style="font-size: 10pt;"><strong>Early Bird Season Memberships (available {{ start_date }} to {{ end_date }})</strong></p>
  <p style="font-size: 10pt;">Each membership comes with 3 admissions, advance reservation required</p>
  <p style="font-size: 10pt;">Prices include 8% sales tax and fee</p>

  <div class="form-row" style="margin-top: 15px;">
    <div class="label-col" style="font-size: 10pt;">Early Bird Adult Memberships at ${{ adult_price }} each</div>
    <div class="input-col" style="font-size: 10pt;">
      <span style="display: inline-block; width: 100%;"></span>
      <span style="display: inline-block; width: 50px; text-align: right;">$</span>
    </div>
  </div>

  <div class="form-row" style="margin-top: 15px;">
    <div class="label-col" style="font-size: 10pt;">Early Bird Student/Senior Memberships at ${{ student_price }} each</div>
    <div class="input-col" style="font-size: 10pt;">
      <span style="display: inline-block; width: 100%;"></span>
      <span style="display: inline-block; width: 50px; text-align: right;">$</span>
    </div>
  </div>

  <h3 style="font-size: 12pt; margin-top: 30px; margin-bottom: 5px;">Gift:</h3>
  <p style="font-size: 10pt;">A ${{ gift_amount }} gift added to your purchase is a great way to help PSST!</p>

  <div class="form-row" style="margin-top: 20px;">
    <div class="label-col" style="font-size: 10pt;">TOTAL:</div>
    <div class="input-col" style="font-size: 10pt;">
      <span style="display: inline-block; width: 100%;"></span>
      <span style="display: inline-block; width: 50px; text-align: right;">$</span>
    </div>
  </div>

  <div style="margin-top: 40px;">
    <div class="form-row">
      <div class="label-col" style="font-size: 10pt;">Name</div>
      <div class="input-col" style="font-size: 10pt;"><span class="signature-line" data-field="name">{{ name }}</span></div>
    </div>
    <div class="form-row">
      <div class="label-col" style="font-size: 10pt;">Address</div>
      <div class="input-col" style="font-size: 10pt;"><span class="signature-line" data-field="address">{{ address }}</span></div>
    </div>
    <div class="form-row">
      <div class="label-col" style="font-size: 10pt;">City,</div>
      <div class="input-col" style="font-size: 10pt;"><span class="signature-line" data-field="city">{{ city }}</span></div>
      <div class="label-col" style="font-size: 10pt;">State</div>
      <div class="input-col" style="font-size: 10pt;"><span class="signature-line" data-field="state">{{ state }}</span></div>
      <div class="label-col" style="font-size: 10pt;">Zip</div>
      <div class="input-col" style="font-size: 10pt;"><span class="signature-line" data-field="zip">{{ zip }}</span></div>
    </div>
    <div class="form-row">
      <div class="label-col" style="font-size: 10pt;">Daytime Phone Number</div>
      <div class="input-col" style="font-size: 10pt;"><span class="signature-line" data-field="daytime_phone_number">{{ daytime_phone_number }}</span></div>
    </div>
    <div class="form-row">
      <div class="label-col" style="font-size: 10pt;">Email Address</div>
      <div class="input-col" style="font-size: 10pt;"><span class="signature-line" data-field="email_address">{{ email_address }}</span></div>
    </div>
  </div>

  <p style="font-size: 10pt; margin-top: 50px;">Checks should be made payable to PSST and mailed to:</p>
  <p style="font-size: 10pt;">PSST; attn: {{ recipient_name }}; {{ street_address }}; {{ city }}; {{ state }}; {{ zip_code }}</p>
</div>