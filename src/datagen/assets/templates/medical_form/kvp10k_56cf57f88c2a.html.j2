  <div class="table-header">
    <div style="flex: 2;">Word</div>
    <div style="flex: 1; text-align: center;">Uses</div>
    <div style="flex: 1; text-align: center;">Understands</div>
  </div>

  {% for vocab_item in vocabulary_list %}
  <div class="table-row">
    <div style="flex: 2;"><span data-field="vocabulary_list[{{ loop.index0 }}].word">{{ vocab_item.word }}</span></div>
    <div style="flex: 1; text-align: center;"><input type="checkbox" data-field="vocab_uses[{{ loop.index0 }}]" value="{{ vocab_uses[loop.index0] }}"></div>
    <div style="flex: 1; text-align: center;"><input type="checkbox" data-field="vocab_understands[{{ loop.index0 }}]" value="{{ vocab_understands[loop.index0] }}"></div>
