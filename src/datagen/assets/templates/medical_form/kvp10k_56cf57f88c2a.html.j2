    <div style="flex: 1; text-align: center;"><input type="checkbox" data-field="grammatical_helping_verbs_no" value="{{ grammatical_helping_verbs_no }}"></div>
    <div style="flex: 1; text-align: center;"><input type="checkbox" data-field="grammatical_helping_verbs_sometimes" value="{{ grammatical_helping_verbs_sometimes }}"></div>
