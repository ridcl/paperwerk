<!DOCTYPE html>
<html>
<head>
<title>Synthetic Document</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { font-weight: bold; }
  .header-info { text-align: right; font-size: 10pt; }
  .section-title { font-weight: bold; margin-top: 15px; margin-bottom: 5px; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 10px; }
  .form-group { flex: 1; margin-right: 20px; }
  .form-group.right { margin-right: 0; }
  .signature-line { border-bottom: 1px solid #000; margin-top: 50px; margin-bottom: 50px; }
  .checkbox-group label { margin-right: 15px; }
</style>

<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  h1, h2, h3 {
    font-weight: bold;
  }
  .header-info {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 30px;
  }
  .logo-area {
    display: flex;
    align-items: center;
  }
  .logo-img {
    width: 100px; /* Placeholder size */
    height: auto;
    margin-right: 20px;
  }
  .contact-info {
    text-align: right;
    font-size: 0.9em;
  }
  .section-title {
    text-align: center;
    margin: 40px 0 20px 0;
    font-size: 1.5em;
  }
  .form-row {
    display: flex;
    margin-bottom: 15px;
    align-items: flex-start;
  }
  .form-row > div {
    flex: 1;
  }
  .form-label {
    font-weight: bold;
    display: block;
    margin-bottom: 5px;
  }
  .form-input-area {
    border-bottom: 1px solid #000;
    padding-bottom: 2px;
  }
  .checkbox-group label {
    font-weight: normal;
    margin-right: 15px;
  }
  .signature-line {
    display: flex;
    justify-content: space-between;
    margin-top: 60px;
    padding-bottom: 10px;
  }
  .signature-line div {
    flex: 1;
    text-align: center;
  }
  .table-header {
    display: flex;
    justify-content: space-between;
    font-weight: bold;
    padding: 5px 0;
    border-bottom: 1px solid #000;
  }
  .table-row {
    display: flex;
    justify-content: space-between;
    padding: 5px 0;
    border-bottom: 1px dotted #ccc;
  }
  .full-width-line {
    border-bottom: 1px solid #000;
    margin-bottom: 20px;
  }
</style>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1, h2, h3 { font-weight: bold; }
  .section-header { margin-top: 20px; margin-bottom: 10px; }
  .form-group { margin-bottom: 15px; }
  .checkbox-group label { margin-right: 15px; }
  .line-item-table { width: 100%; border-collapse: collapse; margin-top: 10px; }
  .line-item-table td { padding: 5px 0; }
</style>
</head>
<body>

<div class="page">
  <div style="text-align: right;">
    <div class="header-info">
      University of the Pacific<br>
      Speech-Language Pathology Department<br>
      <span data-field="address.street">{{ address.street }}</span><br>
      <span data-field="address.city">{{ address.city }}</span><br>
      Telephone: <span data-field="phone">{{ phone }}</span> • Fax: <span data-field="fax">{{ fax }}</span><br>
      E-mail: <span data-field="email">{{ email }}</span>
    </div>
  </div>
  <div style="text-align: center; margin-top: 50px;">
    <img src="placeholder_logo.png" alt="Rite Care Logo" style="width: 150px; height: auto;">
    <h1 style="margin-top: 10px;">RiteCare Childhood Language Center of Stockton</h1>
    <p>University of the Pacific, Speech-Language Pathology Department</p>
    <p><span data-field="address.street">{{ address.street }}</span>, <span data-field="address.city">{{ address.city }}</span></p>
    <p>Telephone: <span data-field="phone">{{ phone }}</span> • Fax: <span data-field="fax">{{ fax }}</span> • E-mail: <span data-field="email">{{ email }}</span></p>
  </div>
</div>

<div class="page">
  <div style="text-align: right; font-size: 10pt;">
    Date: <span data-field="date_document">{{ date_document }}</span>
  </div>
  <div style="margin-bottom: 30px;">
    <div class="form-row">
      <div class="form-group">Child's Name: <span data-field="child_name">{{ child_name }}</span></div>
      <div class="form-group right">Sex: <span data-field="sex">{{ sex }}</span> Age: <span data-field="age">{{ age }}</span> Birthdate: <span data-field="birthdate">{{ birthdate }}</span></div>
    </div>
    <div class="form-row">
      <div class="form-group">Mailing Address: <span data-field="mailing_address">{{ mailing_address }}</span></div>
      <div class="form-group right">Parent/Guardian 1 Name: <span data-field="parent1_name">{{ parent1_name }}</span> Parent/Guardian 2 Name: <span data-field="parent2_name">{{ parent2_name }}</span></div>
    </div>
    <div class="form-row">
      <div class="form-group">Home Phone: <span data-field="home_phone">{{ home_phone }}</span> Cell Phone: <span data-field="cell_phone">{{ cell_phone }}</span></div>
      <div class="form-group right">E-Mail Address: <span data-field="email_address">{{ email_address }}</span> Occupation: <span data-field="occupation">{{ occupation }}</span></div>
    </div>
    <div class="form-row">
      <div class="form-group">Employer: <span data-field="employer">{{ employer }}</span> Birthplace: <span data-field="birthplace">{{ birthplace }}</span></div>
      <div class="form-group right">Birthdate: <span data-field="birthdate_parent">{{ birthdate_parent }}</span> Education: <span data-field="education">{{ education }}</span></div>
    </div>
    <div class="form-row">
      <div class="form-group">Status of the child's parents:
        <div class="checkbox-group">
          <label><input type="checkbox"> Married</label>
          <label><input type="checkbox"> Divorced</label>
          <label><input type="checkbox"> Separated</label>
          <label><input type="checkbox"> Foster Parents</label>
          <label><input type="checkbox"> Other</label>
        </div>
      </div>
      <div class="form-group right">Relationship to child: <span data-field="relationship_to_child">{{ relationship_to_child }}</span></div>
    </div>
    <div class="form-row">
      <div class="form-group">Who is the primary care giver for the child?: <span data-field="primary_caregiver">{{ primary_caregiver }}</span></div>
      <div class="form-group right">If both parents are employed, who takes care of the child?: <span data-field="employed_caregiver">{{ employed_caregiver }}</span></div>
    </div>
  </div>

  <div class="section-title">Other children:</div>
  {% for i in range(3) %}
    <div class="form-row" style="margin-bottom: 15px;">
      <div class="form-group">Name: <span data-field="other_children[{{ i }}].name">{{ other_children[i].name }}</span></div>
      <div class="form-group right">Age: <span data-field="other_children[{{ i }}].age">{{ other_children[i].age }}</span> Sex: <span data-field="other_children[{{ i }}].sex">{{ other_children[i].sex }}</span></div>
    </div>
  {% endfor %}

  <div class="section-title">Language(s) spoken in the home:</div>
  <div style="margin-bottom: 30px;"></div>

  <div class="section-title">BIRTH HISTORY:</div>
  <div class="form-row">
    <div class="form-group">Mother's health during pregnancy: <span data-field="mother_health">{{ mother_health }}</span></div>
    <div class="form-group right">Term of pregnancy: <span data-field="term_of_pregnancy">{{ term_of_pregnancy }}</span> Birth weight: <span data-field="birth_weight">{{ birth_weight }}</span></div>
  </div>
  <div class="form-row">
    <div class="form-group">Normal delivery?: <span data-field="normal_delivery">{{ normal_delivery }}</span> If no, please explain: <span data-field="normal_delivery_explanation">{{ normal_delivery_explanation }}</span></div>
  </div>
  <div class="form-row">
    <div class="form-group">Child's general condition at birth: <span data-field="child_condition">{{ child_condition }}</span></div>
  </div>
  <div class="form-row">
    <div class="form-group">Feeding difficulties (swallowing or sucking problems): <span data-field="feeding_difficulties">{{ feeding_difficulties }}</span></div>
  </div>
  <div class="form-row">
    <div class="form-group">Name/address of doctor attending at birth: <span data-field="doctor_address">{{ doctor_address }}</span></div>
  </div>

  <div class="section-title">DEVELOPMENTAL HISTORY:</div>
  <div class="form-row">
    <div class="form-group">Age your child: <span data-field="age_development">{{ age_development }}</span></div>
    <div class="form-group right">Dressed self: <span data-field="dressed_self">{{ dressed_self }}</span> Walked alone: <span data-field="walked_alone">{{ walked_alone }}</span></div>
  </div>
  <div class="form-row">
    <div class="form-group">Crawled: <span data-field="crawled">{{ crawled }}</span> Toilet Training began: <span data-field="toilet_training_began">{{ toilet_training_began }}</span></div>
    <div class="form-group right">Toilet training completed: <span data-field="toilet_training_completed">{{ toilet_training_completed }}</span> Spoke first sentences: <span data-field="spoke_first_sentences">{{ spoke_first_sentences }}</span></div>
  </div>
</div>

<div class="page">
  <div class="section-title">CHILD'S MEDICAL HISTORY: (please bring all relevant medical records with you to your first appointment)</div>
  <div class="form-row">
    <div class="form-group">Name/address/city of child's present physician: <span data-field="physician_info">{{ physician_info }}</span></div>
    <div class="form-group right">Phone: <span data-field="physician_phone">{{ physician_phone }}</span> Weight: <span data-field="weight">{{ weight }}</span></div>
  </div>
  <div class="form-row">
    <div class="form-group">Diseases: <span data-field="diseases">{{ diseases }}</span> Length of illness: <span data-field="illness_length">{{ illness_length }}</span> Severity: <span data-field="severity">{{ severity }}</span> Age at onset: <span data-field="age_onset">{{ age_onset }}</span></div>
  </div>
  <div class="form-row">
    <div class="form-group">Surgery(s) or Hospitalizations: <span data-field="surgeries">{{ surgeries }}</span> Degree of Recovery: <span data-field="recovery_degree">{{ recovery_degree }}</span> Age at surgery: <span data-field="age_surgery">{{ age_surgery }}</span></div>
  </div>

  <div class="section-title">Other health problems:</div>
  <div class="form-row" style="margin-bottom: 20px;">
    <div class="form-group">Are you aware of any hearing problems?
      <div class="checkbox-group">
        <label><input type="checkbox"> Yes</label>
        <label><input type="checkbox"> No</label>
      </div>
    </div>
    <div class="form-group right">Has the child had a hearing test?
      <div class="checkbox-group">
        <label><input type="checkbox"> Yes</label>
        <label><input type="checkbox"> No</label>
      </div>
    </div>
  </div>
  <div class="form-row">
    <div class="form-group">If so, when and by whom?: <span data-field="hearing_test_details">{{ hearing_test_details }}</span></div>
  </div>

  <div class="section-title">DOES YOUR CHILD:</div>
  <div class="form-row" style="margin-bottom: 15px;">
    <div class="form-group">Wear glasses
      <div class="checkbox-group">
        <label><input type="checkbox"> Yes</label>
        <label><input type="checkbox"> No</label>
      </div>
    </div>
    <div class="form-group">Have a history of ear infections
      <div class="checkbox-group">
        <label><input type="checkbox"> Yes</label>
        <label><input type="checkbox"> No</label>
      </div>
    </div>
    <div class="form-group">Pull at his/her ears
      <div class="checkbox-group">
        <label><input type="checkbox"> Yes</label>
        <label><input type="checkbox"> No</label>
      </div>
    </div>
  </div>
  <div class="form-row">
    <div class="form-group">Have tubes in his/her ears? For how long?: <span data-field="tubes_details">{{ tubes_details }}</span></div>
    <div class="form-group">Have a history of respiratory infections?
      <div class="checkbox-group">
        <label><input type="checkbox"> Yes</label>
        <label><input type="checkbox"> No</label>
      </div>
    </div>
    <div class="form-group">Take any medication? Name(s) of medication: <span data-field="medication_details">{{ medication_details }}</span></div>
  </div>
  <div class="form-row">
    <div class="form-group">For what reason?: <span data-field="medication_reason">{{ medication_reason }}</span></div>
    <div class="form-group">What effect does this medication have on your child?: <span data-field="medication_effect">{{ medication_effect }}</span></div>
  </div>

  <div class="section-title">HAS YOUR CHILD RECEIVED ANY OF THE FOLLOWING REGARDING HIS/HER DEVELOPMENT?</div>
  <div class="form-row" style="margin-bottom: 15px;">
    <div class="form-group">Autism
      <div class="checkbox-group">
        <label><input type="checkbox"> Yes</label>
        <label><input type="checkbox"> No</label>
      </div>
    </div>
    <div class="form-group">Down Syndrome
      <div class="checkbox-group">
        <label><input type="checkbox"> Yes</label>
        <label><input type="checkbox"> No</label>
      </div>
    </div>
    <div class="form-group">ADHD
      <div class="checkbox-group">
        <label><input type="checkbox"> Yes</label>
        <label><input type="checkbox"> No</label>
      </div>
    </div>
    <div class="form-group">Specific Learning Disability
      <div class="checkbox-group">
        <label><input type="checkbox"> Yes</label>
        <label><input type="checkbox"> No</label>
      </div>
    </div>
    <div class="form-group">Intellectual Disability
      <div class="checkbox-group">
        <label><input type="checkbox"> Yes</label>
        <label><input type="checkbox"> No</label>
      </div>
    </div>
  </div>
  <div class="form-row" style="margin-bottom: 15px;">
    <div class="form-group">Speech or Language Impairment
      <div class="checkbox-group">
        <label><input type="checkbox"> Yes</label>
        <label><input type="checkbox"> No</label>
      </div>
    </div>
    <div class="form-group">Traumatic Brain Injury
      <div class="checkbox-group">
        <label><input type="checkbox"> Yes</label>
        <label><input type="checkbox"> No</label>
      </div>
    </div>
    <div class="form-group">Deaf/ Hard of Hearing
      <div class="checkbox-group">
        <label><input type="checkbox"> Yes</label>
        <label><input type="checkbox"> No</label>
      </div>
    </div>
  </div>

  <div class="section-title">BEHAVIOR PATTERNS:</div>
  <div class="form-row" style="margin-bottom: 15px;">
    <div class="form-group">Over active
      <div class="checkbox-group">
        <label><input type="checkbox"> Yes</label>
        <label><input type="checkbox"> No</label>
      </div>
    </div>
    <div class="form-group">Temper tantrums
      <div class="checkbox-group">
        <label><input type="checkbox"> Yes</label>
        <label><input type="checkbox"> No</label>
      </div>
    </div>
    <div class="form-group">Thumb sucking
      <div class="checkbox-group">
        <label><input type="checkbox"> Yes</label>
        <label><input type="checkbox"> No</label>
      </div>
    </div>
  </div>
  <div class="form-row">
    <div class="form-group">Eating habits: <span data-field="eating_habits">{{ eating_habits }}</span> Sleeping habits: <span data-field="sleeping_habits">{{ sleeping_habits }}</span></div>
    <div class="form-group">Fears: <span data-field="fears">{{ fears }}</span> Destructiveness: <span data-field="destructiveness">{{ destructiveness }}</span></div>
  </div>
  <div class="form-row">
    <div class="form-group">Discipline measures used: <span data-field="discipline_measures">{{ discipline_measures }}</span> Child's reaction: <span data-field="child_reaction">{{ child_reaction }}</span></div>
  </div>
  <div class="form-row">
    <div class="form-group">How often does your child need to be disciplined?: <span data-field="discipline_frequency">{{ discipline_frequency }}</span></div>
    <div class="form-group">Discipline has been:
      <div class="checkbox-group">
        <label><input type="checkbox"> Strict</label>
        <label><input type="checkbox"> Lenient</label>
        <label><input type="checkbox"> Inconsistent</label>
        <label><input type="checkbox"> Adequate</label>
        <label><input type="checkbox"> Effective</label>
        <label><input type="checkbox"> Ineffective</label>
      </div>
    </div>
  </div>
  <div class="form-row">
    <div class="form-group">Does your child: Have playmates in the neighborhood?
      <div class="checkbox-group">
        <label><input type="checkbox"> Yes</label>
        <label><input type="checkbox"> No</label>
      </div>
    </div>
    <div class="form-group">Play away from home?
      <div class="checkbox-group">
        <label><input type="checkbox"> Yes</label>
        <label><input type="checkbox"> No</label>
      </div>
    </div>
  </div>
  <div class="form-row">
    <div class="form-group">Tend to tattle?: <span data-field="tattle">{{ tattle }}</span> Yes No Appear to be a leader OR a follower Seem basically: happy or unhappy</div>
    <div class="form-group">Does your child prefer to play with: People OR Things Have regular responsibilities at home? Yes No</div>
  </div>
  <div class="form-row">
    <div class="form-group">What Pleases You Most About Your Child's Behavior?: <span data-field="pleasing_behavior">{{ pleasing_behavior }}</span></div>
  </div>
</div>

<div class="page">
  <div class="section-title">SCHOOL HISTORY:</div>
  <div class="form-row">
    <div class="form-group">School: <span data-field="school_name">{{ school_name }}</span> Teacher: <span data-field="teacher_name">{{ teacher_name }}</span> Grade: <span data-field="grade">{{ grade }}</span></div>
    <div class="form-group right">Academic performance: <span data-field="academic_performance">{{ academic_performance }}</span> Grade(s) repeated: <span data-field="grades_repeated">{{ grades_repeated }}</span></div>
  </div>
  <div class="form-row">
    <div class="form-group">Strongest subject: <span data-field="strongest_subject">{{ strongest_subject }}</span> Weakest subject: <span data-field="weakest_subject">{{ weakest_subject }}</span></div>
  </div>
  <div class="form-row">
    <div class="form-group">Does he/she enjoy school?: <span data-field="enjoys_school">{{ enjoys_school }}</span> If no, why not?: <span data-field="why_not">{{ why_not }}</span></div>
  </div>
  <div class="form-row">
    <div class="form-group">Does your child have an Individualized Education Program (IEP)?:
      <div class="checkbox-group">
        <label><input type="checkbox"> Yes</label>
        <label><input type="checkbox"> No</label>
      </div>
    </div>
    <div class="form-group right">If "yes," what services is he/she receiving?: <span data-field="iep_services">{{ iep_services }}</span></div>
  </div>
  <div style="margin-top: 30px;">
    <p><em>*Please attach the most current Individual Education Program, speech and language report, and/or medical reports that may be pertinent to your child's therapy here at the center.</em></p>
  </div>

  <div class="section-title">SPEECH HISTORY:</div>
  <div class="form-row">
    <div class="form-group">Please describe your child's speech problem: <span data-field="speech_problem_description">{{ speech_problem_description }}</span></div>
  </div>
  <div class="form-row">
    <div class="form-group">At what age did this first concern you?: <span data-field="speech_concern_age">{{ speech_concern_age }}</span> Who noticed the problem?:
      <div class="checkbox-group">
        <label><input type="checkbox"> Yes</label>
        <label><input type="checkbox"> No</label>
      </div>
    </div>
  </div>
  <div class="form-row">
    <div class="form-group">Do the child's caregiver/s agree about the nature of the problem?: <span data-field="caregiver_agreement">{{ caregiver_agreement }}</span></div>
    <div class="form-group">Are there any speech problems in your family besides the child? What was the problem and who had it?: <span data-field="family_speech_problems">{{ family_speech_problems }}</span></div>
  </div>
  <div class="form-row">
    <div class="form-group">Methods used by the family to improve the child's speech: <span data-field="family_methods">{{ family_methods }}</span></div>
  </div>
  <div class="form-row">
    <div class="form-group">What do you think may have caused this problem?: <span data-field="causation_theory">{{ causation_theory }}</span></div>
  </div>

  <div class="section-title">Is your child receiving speech and language therapy in school or received speech and language therapy in the past?</div>
  <div class="form-row">
    <div class="form-group">
      <div class="checkbox-group">
        <label><input type="checkbox"> Yes</label>
        <label><input type="checkbox"> No</label>
      </div>
    </div>
    <div class="form-group">If you answered YES, please include the following information:</div>
  </div>
  <div class="form-row">
    <div class="form-group">Name of therapist: <span data-field="therapist_name_school">{{ therapist_name_school }}</span> School: <span data-field="school_name_therapy">{{ school_name_therapy }}</span></div>
  </div>
  <div class="form-row">
    <div class="form-group">Number of times per week: <span data-field="therapy_frequency_school">{{ therapy_frequency_school }}</span> Length of therapy sessions: <span data-field="therapy_length_school">{{ therapy_length_school }}</span> Individual or group therapy:
      <div class="checkbox-group">
        <label><input type="checkbox"> Yes</label>
        <label><input type="checkbox"> No</label>
      </div>
    </div>
  </div>
  <div class="form-row">
    <div class="form-group">Does your child receive any speech and language therapy other than in school?:
      <div class="checkbox-group">
        <label><input type="checkbox"> Yes</label>
        <label><input type="checkbox"> No</label>
      </div>
    </div>
    <div class="form-group">If you answered YES, please provide the following information:</div>
  </div>
  <div class="form-row">
    <div class="form-group">Name of therapist: <span data-field="therapist_name_other">{{ therapist_name_other }}</span></div>
    <div class="form-group">Number of times per week: <span data-field="therapy_frequency_other">{{ therapy_frequency_other }}</span> Length of therapy sessions: <span data-field="therapy_length_other">{{ therapy_length_other }}</span> Individual or group therapy:
      <div class="checkbox-group">
        <label><input type="checkbox"> Yes</label>
        <label><input type="checkbox"> No</label>
      </div>
    </div>
  </div>
</div>

<div class="page">
  <div class="section-title">Communication Skills:</div>
  <div class="form-row">
    <div class="form-group">How much of your child's speech do you understand?:
      <div class="checkbox-group">
        <label><input type="checkbox"> All</label>
        <label><input type="checkbox"> Most</label>
        <label><input type="checkbox"> Little</label>
        <label><input type="checkbox"> None</label>
      </div>
    </div>
    <div class="form-group">How much do other family members understand?:
      <div class="checkbox-group">
