      <div class="form-input-area"><span data-field="mean_length_of_utterance">{{ mean_length_of_utterance }}</span></div>
    </div>
  </div>

  <p>Please give a few examples:</p>
  <div class="form-input-area" style="height: 80px;"><span data-field="utterance_examples">{{ utterance_examples }}</span></div>

