  <div class="table-header" style="font-weight: normal; font-size: 0.9em;">
    <div style="flex: 1;"></div>
    <div style="flex: 1; text-align: center;">Yes</div>
    <div style="flex: 1; text-align: center;">No</div>
    <div style="flex: 1; text-align: center;">Sometimes</div>
  </div>

  <div class="table-row" style="font-weight: normal; font-size: 0.9em;">
    <div style="flex: 1;">-ing</div>
    <div style="flex: 1; text-align: center;"><input type="checkbox" data-field="grammatical_ing_yes" value="{{ grammatical_ing_yes }}"></div>
    <div style="flex: 1; text-align: center;"><input type="checkbox" data-field="grammatical_ing_no" value="{{ grammatical_ing_no }}"></div>
    <div style="flex: 1; text-align: center;"><input type="checkbox" data-field="grammatical_ing_sometimes" value="{{ grammatical_ing_sometimes }}"></div>
  </div>
  <div class="table-row" style="font-weight: normal; font-size: 0.9em;">
    <div style="flex: 1;">past tense -ed</div>
    <div style="flex: 1; text-align: center;"><input type="checkbox" data-field="grammatical_past_ed_yes" value="{{ grammatical_past_ed_yes }}"></div>
    <div style="flex: 1; text-align: center;"><input type="checkbox" data-field="grammatical_past_ed_no" value="{{ grammatical_past_ed_no }}"></div>
    <div style="flex: 1; text-align: center;"><input type="checkbox" data-field="grammatical_past_ed_sometimes" value="{{ grammatical_past_ed_sometimes }}"></div>
  </div>
  <div class="table-row" style="font-weight: normal; font-size: 0.9em;">
    <div style="flex: 1;">possessive 's</div>
    <div style="flex: 1; text-align: center;"><input type="checkbox" data-field="grammatical_possessive_yes" value="{{ grammatical_possessive_yes }}"></div>
    <div style="flex: 1; text-align: center;"><input type="checkbox" data-field="grammatical_possessive_no" value="{{ grammatical_possessive_no }}"></div>
    <div style="flex: 1; text-align: center;"><input type="checkbox" data-field="grammatical_possessive_sometimes" value="{{ grammatical_possessive_sometimes }}"></div>
  </div>
  <div class="table-row" style="font-weight: normal; font-size: 0.9em;">
    <div style="flex: 1;">articles a and the</div>
    <div style="flex: 1; text-align: center;"><input type="checkbox" data-field="grammatical_articles_yes" value="{{ grammatical_articles_yes }}"></div>
    <div style="flex: 1; text-align: center;"><input type="checkbox" data-field="grammatical_articles_no" value="{{ grammatical_articles_no }}"></div>
    <div style="flex: 1; text-align: center;"><input type="checkbox" data-field="grammatical_articles_sometimes" value="{{ grammatical_articles_sometimes }}"></div>
  </div>
  <div class="table-row" style="font-weight: normal; font-size: 0.9em;">
    <div style="flex: 1;">prepositions (in, on)</div>
    <div style="flex: 1; text-align: center;"><input type="checkbox" data-field="grammatical_prepositions_yes" value="{{ grammatical_prepositions_yes }}"></div>
    <div style="flex: 1; text-align: center;"><input type="checkbox" data-field="grammatical_prepositions_no" value="{{ grammatical_prepositions_no }}"></div>
    <div style="flex: 1; text-align: center;"><input type="checkbox" data-field="grammatical_prepositions_sometimes" value="{{ grammatical_prepositions_sometimes }}"></div>
  </div>
  <div class="table-row" style="font-weight: normal; font-size: 0.9em;">
