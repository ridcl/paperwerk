<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif; }
  h1, h2 { font-weight: bold; }
  .section { margin-bottom: 20px; }
  .label { font-weight: bold; display: inline-block; width: 150px; }
  .value { display: inline-block; }
</style>

<div class="page">
  <div style="text-align: center; margin-bottom: 50px;">
    <!-- Logo placeholder -->
    <img src="" alt="Logo" style="max-width: 200px; height: auto;">
    <h1 style="font-size: 18pt; margin-top: 10px;">The Hong Kong Academy for Performing Arts</h1>
  </div>

  <div class="section">
    <h2 style="font-size: 14pt;">HKAPA Bank Account Information</h2>
  </div>

  <!-- Remittance in HK Dollar Section -->
  <div class="section">
    <h3 style="font-size: 12pt;">Remittance in HK Dollar</h3>
    <div style="margin-top: 10px;">
      <span class="label">Name of Bank:</span>
      <span class="value"><span data-field="hkd_bank_name">{{ hkd_bank_name }}</span></span>
    </div>
    <div style="margin-top: 5px;">
      <span class="label">Swift code:</span>
      <span class="value"><span data-field="hkd_swift_code">{{ hkd_swift_code }}</span></span>
    </div>
    <div style="margin-top: 5px;">
      <span class="label">Beneficiary Name:</span>
      <span class="value"><span data-field="hkd_beneficiary_name">{{ hkd_beneficiary_name }}</span></span>
    </div>
    <div style="margin-top: 5px;">
      <span class="label">Beneficiary A/C No.:</span>
      <span class="value"><span data-field="hkd_account_number">{{ hkd_account_number }}</span></span>
    </div>
    <div style="margin-top: 5px;">
      <span class="label">Bank Address:</span>
      <span class="value"><span data-field="hkd_bank_address">{{ hkd_bank_address }}</span></span>
    </div>
  </div>

  <!-- Remittance in Foreign Currencies Section -->
  <div class="section">
    <h3 style="font-size: 12pt;">Remittance in foreign currencies (other than HK Dollar)</h3>
    <div style="margin-top: 10px;">
      <span class="label">Name of Bank:</span>
      <span class="value"><span data-field="forex_bank_name">{{ forex_bank_name }}</span></span>
    </div>
    <div style="margin-top: 5px;">
      <span class="label">Swift code:</span>
      <span class="value"><span data-field="forex_swift_code">{{ forex_swift_code }}</span></span>
    </div>
    <div style="margin-top: 5px;">
      <span class="label">Beneficiary Name:</span>
      <span class="value"><span data-field="forex_beneficiary_name">{{ forex_beneficiary_name }}</span></span>
    </div>
    <div style="margin-top: 5px;">
      <span class="label">Beneficiary A/C No.:</span>
      <span class="value"><span data-field="forex_account_number">{{ forex_account_number }}</span></span>
    </div>
    <div style="margin-top: 5px;">
      <span class="label">Bank Address:</span>
      <span class="value"><span data-field="forex_bank_address">{{ forex_bank_address }}</span></span>
    </div>
  </div>

  <!-- Footer Section (Simplified based on layout) -->
  <div style="position: absolute; bottom: 50px; left: 60px; right: 60px; font-size: 9pt; display: flex; justify-content: space-between;">
    <div>
      <p>Dance</p>
      <p>Main Campus: <span data-field="campus_main_name">{{ campus_main_name }}</span></p>
      <p>Béthanie Campus: <span data-field="campus_bethanie_name">{{ campus_bethanie_name }}</span></p>
      <p>Tel: <span data-field="campus_main_tel">{{ campus_main_tel }}</span></p>
    </div>
    <div>
      <p>Drama</p>
      <p>Staff: <span data-field="staff_name">{{ staff_name }}</span></p>
      <p>Fax: <span data-field="staff_fax">{{ staff_fax }}</span></p>
    </div>
    <div>
      <p>Music</p>
      <p>School: <span data-field="school_name">{{ school_name }}</span></p>
    </div>
    <div>
      <p>Film & Television</p>
      <p>Department: <span data-field="dept_name">{{ dept_name }}</span></p>
    </div>
    <div>
      <p>Theatre & Entertainment Arts</p>
      <p>Program: <span data-field="program_name">{{ program_name }}</span></p>
    </div>
    <div>
      <p>Chinese Opera</p>
      <p>Division: <span data-field="opera_division">{{ opera_division }}</span></p>
    </div>
  </div>
</div>