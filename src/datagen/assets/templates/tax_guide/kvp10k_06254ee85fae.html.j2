<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div style="width: 50%;">
      <div class="section-title">Worksheet A. Worksheet A, Significant Participation Passive Activities</div>
      <p style="font-size: 10pt;">Name of activity</p>
      <table style="margin-top: 10px;">
        <tr>
          <td style="width: 30%;"></td>
          <td style="width: 20%;">(a) Hours of participation</td>
          <td style="width: 20%;">(b) Net loss</td>
          <td style="width: 30%;">(c) Net income</td>
