<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
    margin-bottom: 15px;
  }
  td, th {
    padding: 8px;
    text-align: left;
  }
  .header-title {
    font-size: 24pt;
    font-weight: bold;
    text-align: center;
    margin-bottom: 30px;
  }
  .section-heading {
    font-size: 14pt;
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
  }
  .sub-heading {
    font-size: 12pt;
    font-weight: bold;
    margin-top: 15px;
    margin-bottom: 5px;
  }
  .form-label {
    display: inline-block;
    width: 150px;
    font-weight: bold;
    margin-bottom: 10px;
  }
  .form-field {
    border-bottom: 1px solid #000;
    display: inline-block;
    width: calc(100% - 160px);
    margin-bottom: 10px;
  }
  .radio-group label {
    font-weight: normal;
    margin-right: 15px;
  }
</style>

<div class="page">
