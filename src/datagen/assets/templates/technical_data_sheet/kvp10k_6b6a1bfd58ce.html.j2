<!DOCTYPE html>
<html>
<head>
    <title>Technical Data Sheet</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; margin-bottom: 15px; }
        th, td { border: 1px solid #ccc; padding: 8px; text-align: left; }
        .header-right { text-align: right; }
    </style>
</head>
<body>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <div>
            <h1 style="font-size: 24pt; margin: 0;">Non-Metallic Systems</h1>
            <h2 style="font-size: 18pt; margin: 0;">PFH Heavyweight Conduit</h2>
        </div>
        <div style="text-align: right;">
            <div style="font-size: 10pt;">201504</div>
            <div style="font-size: 10pt;">Page 1</div>
            <img src="placeholder_logo.png" alt="Logo" style="height: 40px;">
        </div>
    </div>

    <h3 style="font-size: 14pt; margin-top: 30px;">Technical Characteristics</h3>
    
    <table style="width: 100%;">
        <tr>
            <td style="width: 30%;">Conforms to</td>
            <td><span data-field="conformity_standards">{{ conformity_standards }}</span></td>
        </tr>
        <tr>
            <td>Approvals and Standards</td>
            <td><span data-field="approvals_standards_icons">{{ approvals_standards_icons }}</span></td>
        </tr>
        <tr>
            <td>Degree of mechanical protection</td>
            <td><span data-field="mechanical_protection_rating">{{ mechanical_protection_rating }}</span></td>
        </tr>
        <tr>
            <td>Degree of protection</td>
            <td><span data-field="ip_rating">{{ ip_rating }}</span></td>
        </tr>
        <tr>
            <td>UV protection</td>
            <td><span data-field="uv_protection">{{ uv_protection }}</span></td>
        </tr>
        <tr>
            <td>Finish</td>
            <td><span data-field="finish">{{ finish }}</span></td>
        </tr>
        <tr>
            <td>Application</td>
            <td><span data-field="application">{{ application }}</span></td>
        </tr>
        <tr>
            <td>Normal operating temperature range</td>
            <td>
                <span data-field="temp_range_static">Static: {{ temp_range_static }}</span><br>
                <span data-field="temp_range_dynamic">Dynamic: {{ temp_range_dynamic }}</span>
            </td>
        </tr>
        <tr>
            <td>For use with - Fitting range</td>
            <td><span data-field="fitting_range">{{ fitting_range }}</span></td>
        </tr>
        <tr>
            <td>Fire performance</td>
            <td>
                <span data-field="test_standard">{{ test_standard }}</span>
                <span data-field="performance_rating">{{ performance_rating }}</span>
            </td>
        </tr>
        <tr>
            <td>Testing data</td>
            <td><span data-field="testing_data_reference">{{ testing_data_reference }}</span></td>
        </tr>
        <tr>
            <td>Type of material</td>
            <td><span data-field="material_type">{{ material_type }}</span></td>
        </tr>
        <tr>
            <td>Image</td>
            <td><img src="placeholder_image.png" alt="Product Image" style="width: 150px; height: auto;"></td>
        </tr>
    </table>
</div>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <div>
            <h1 style="font-size: 24pt; margin: 0;">Non-Metallic Systems</h1>
            <h2 style="font-size: 18pt; margin: 0;">PFH Heavyweight Conduit</h2>
        </div>
        <div style="text-align: right;">
            <div style="font-size: 10pt;">201504</div>
            <div style="font-size: 10pt;">Page 2</div>
            <img src="placeholder_logo.png" alt="Logo" style="height: 40px;">
        </div>
    </div>

    <h3 style="font-size: 14pt; margin-top: 30px;">Technical & Dimensional Data</h3>
    
    <table style="width: 100%;">
        <thead>
            <tr>
                <th style="width: 10%;">Part No.</th>
                <th style="width: 15%;">Nominal Conduit Size</th>
                <th style="width: 10%;">NW</th>
                <th style="width: 15%;">Conduit Size</th>
                <th style="width: 10%;">Pitch</th>
                <th style="width: 15%;">Conduit (A) Outside Diameter</th>
                <th style="width: 15%;">Conduit (B) Inside Diameter</th>
                <th style="width: 10%;">Conduit (C) Min. Bend Radius</th>
                <th style="width: 10%;">Reel Length (m)</th>
                <th style="width: 10%;">Average Weight (KG/100m)</th>
            </tr>
        </thead>
        <tbody>
            {% for item in conduit_data %}
            <tr>
                <td><span data-field="conduit_data[{{ loop.index0 }}].part_no">{{ item.part_no }}</span></td>
                <td><span data-field="conduit_data[{{ loop.index0 }}].nominal_size">{{ item.nominal_size }}</span></td>
                <td><span data-field="conduit_data[{{ loop.index0 }}].nw">{{ item.nw }}</span></td>
                <td><span data-field="conduit_data[{{ loop.index0 }}].conduit_size">{{ item.conduit_size }}</span></td>
                <td><span data-field="conduit_data[{{ loop.index0 }}].pitch">{{ item.pitch }}</span></td>
                <td><span data-field="conduit_data[{{ loop.index0 }}].diameter_a">{{ item.diameter_a }}</span></td>
                <td><span data-field="conduit_data[{{ loop.index0 }}].diameter_b">{{ item.diameter_b }}</span></td>
                <td><span data-field="conduit_data[{{ loop.index0 }}].bend_radius_c">{{ item.bend_radius_c }}</span></td>
                <td><span data-field="conduit_data[{{ loop.index0 }}].reel_length">{{ item.reel_length }}</span></td>
                <td><span data-field="conduit_data[{{ loop.index0 }}].average_weight">{{ item.average_weight }}</span></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <div style="text-align: center; margin-top: 50px;">
        <p>To order quote part number, colour & reel length, e.g PFCH21/BL/50M</p>
    </div>

    <div style="text-align: center; margin-top: 50px;">
        <img src="placeholder_diagram.png" alt="Conduit Diagram" style="width: 300px; height: auto;">
        <div style="margin-top: 10px;">
            <span style="display: inline-block; width: 50px; text-align: center;">C</span>
            <span style="display: inline-block; width: 50px; text-align: center;">A</span>
            <span style="display: inline-block; width: 50px; text-align: center;">B</span>
        </div>
    </div>
</div>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <div>
            <h1 style="font-size: 24pt; margin: 0;">Non-Metallic Systems</h1>
            <h2 style="font-size: 18pt; margin: 0;">PFH Heavyweight Conduit</h2>
        </div>
        <div style="text-align: right;">
            <div style="font-size: 10pt;">201504</div>
            <div style="font-size: 10pt;">Page 3</div>
            <img src="placeholder_logo.png" alt="Logo" style="height: 40px;">
        </div>
    </div>

    <h3 style="font-size: 14pt; margin-top: 30px;">BS EN 61386 Classification</h3>

    <table style="width: 100%;">
        <thead>
            <tr>
                <th>Fitting</th>
                <th>Compression</th>
                <th>Impact</th>
                <th>Min Temp</th>
                <th>Max Temp</th>
                <th>Bending</th>
                <th>Electrical Solids</th>
                <th>IP Rating</th>
                <th>Corrosion</th>
                <th>Tensile</th>
                <th>Non-flame Propagating</th>
                <th>Suspended Load</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>PFH</td>
                <td>ATS</td>
                <td>2</td>
                <td>3</td>
                <td>5</td>
                <td>4</td>
                <td>4</td>
                <td>0</td>
                <td>6</td>
                <td>7</td>
                <td>-</td>
                <td>2</td>
                <td>1</td>
                <td>0</td>
            </tr>
        </tbody>
    </table>

    <h3 style="font-size: 14pt; margin-top: 30px;">Mechanical Properties</h3>
    <table style="width: 100%;">
        <thead>
            <tr>
                <th style="width: 20%;">Test Type</th>
                <th style="width: 30%;">Methods / Standards</th>
                <th style="width: 20%;">Requirements</th>
                <th style="width: 30%;">Value</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Crush Strength</td>
                <td>IEC61386</td>
                <td>&lt;25% crush &gt;90% recovery</td>
                <td>&gt;320N</td>
            </tr>
            <tr>
                <td>Tensile Strength</td>
                <td>IEC61386-1</td>
                <td>Pull off of fitting minimum value</td>
                <td>&gt;250N</td>
            </tr>
            <tr>
                <td>Impact Strength @-45 °C</td>
                <td>IEC61386-1</td>
                <td>No Cracks &lt;20% deformation min value</td>
                <td>&gt;2J</td>
            </tr>
            <tr>
                <td>Impact Strength @23 °C</td>
                <td>IEC61386-1</td>
                <td>No Cracks &lt;20% deformation min value</td>
                <td>&gt;20J</td>
            </tr>
            <tr>
                <td>Dynamic Bend radius @-5 °C</td>
                <td>IEC61386-23</td>
                <td>5000 cycles minimum</td>
                <td>8xOD</td>
            </tr>
        </tbody>
    </table>

    <h3 style="font-size: 14pt; margin-top: 30px;">Thermal Properties</h3>
    <table style="width: 100%;">
        <thead>
            <tr>
                <th style="width: 20%;">Test Type</th>
                <th style="width: 30%;">Methods / Standards</th>
                <th style="width: 20%;">Requirements</th>
                <th style="width: 30%;">Value</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Minimum Temp</td>
                <td>Dynamic IEC61386</td>
                <td>Dynamic 5000 cycles</td>
                <td>-45°C</td>
            </tr>
            <tr>
                <td>Maximum Short Term Temp</td>
                <td>IEC61386</td>
                <td>Static & Dynamic 3000 hours, 5000 cycles</td>
                <td>120°C</td>
            </tr>
            <tr>
                <td>Minimum Static / Dynamic Temp</td>
                <td>IEC61386</td>
                <td>Permanent Use (30,000) Hours</td>
                <td>-45°C</td>
            </tr>
            <tr>
                <td>Maximum Static / Dynamic Temp</td>
                <td>IEC61386</td>
                <td>Permanent Use (30,000) Hours</td>
                <td>105°C</td>
            </tr>
        </tbody>
    </table>

    <h3 style="font-size: 14pt; margin-top: 30px;">Chemical Resistance Chart</h3>
    <p>Key:</p>
    <table style="width: 100%;">
        <tr>
            <th style="width: 20%;">Suitable:</th>
            <td style="width: 80%;">
                {% for item in suitable_chemicals %}
                <span style="margin-right: 15px;">{{ item.name }}</span>
                {% endfor %}
            </td>
        </tr>
        <tr>
            <th style="width: 20%;">Limited Suitability:</th>
            <td style="width: 80%;">
                {% for item in limited_suitability_chemicals %}
                <span style="margin-right: 15px;">{{ item.name }}</span>
                {% endfor %}
            </td>
        </tr>
        <tr>
            <th style="width: 20%;">Unsuitable:</th>
            <td style="width: 80%;">
                {% for item in unsuitable_chemicals %}
                <span style="margin-right: 15px;">{{ item.name }}</span>
                {% endfor %}
            </td>
        </tr>
        <tr>
            <th style="width: 20%;">Not Tested:</th>
            <td style="width: 80%;">
                {% for item in not_tested_chemicals %}
                <span style="margin-right: 15px;">{{ item.name }}</span>
                {% endfor %}
            </td>
        </tr>
    </table>
</div>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <div>
            <h1 style="font-size: 24pt; margin: 0;">Non-Metallic Systems</h1>
            <h2 style="font-size: 18pt; margin: 0;">PFH Heavyweight Conduit</h2>
        </div>
        <div style="text-align: right;">
            <div style="font-size: 10pt;">201504</div>
            <div style="font-size: 10pt;">Page 4</div>
            <img src="placeholder_logo.png" alt="Logo" style="height: 40px;">
        </div>
    </div>

    <h3 style="font-size: 14pt; margin-top: 30px;">Flammability</h3>
    <table style="width: 100%;">
        <thead>
            <tr>
                <th style="width: 20%;">Test Type</th>
                <th style="width: 25%;">Method / Standard</th>
                <th style="width: 25%;">Requirement</th>
                <th style="width: 30%;">Result</th>
                <th style="width: 20%;">Unit</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Oxygen Index</td>
                <td>ISO 4589-2</td>
                <td>% Oxygen to support combustion &gt;34%</td>
                <td>28.9</td>
                <td>%</td>
            </tr>
            <tr>
                <td>Glow Wire Rating</td>
                <td>IEC 60695</td>
                <td>No Ignition to Extinguish with 30s</td>
                <td>850</td>
                <td>°C</td>
            </tr>
            <tr>
                <td>Flammability</td>
                <td>UL94</td>
                <td>Vertical (V0) or Horizontal (HB)</td>
                <td>V2</td>
                <td>HB/V0</td>
            </tr>
            <tr>
                <td>Flammability</td>
                <td>IEC 61386-1</td>
                <td>Self Extinguishing &lt;30s</td>
                <td>4s</td>
                <td>Seconds</td>
            </tr>
            <tr>
                <td>Flammability</td>
                <td>UNI CEI 11170</td>
                <td>LR3/LR4</td>
                <td></td>
                <td></td>
            </tr>
            <tr>
                <td>Ignition Rating</td>
                <td>NF F16-101/2</td>
                <td>Glow Wire & oxygen index</td>
                <td>I3</td>
                <td></td>
            </tr>
        </tbody>
    </table>

    <h3 style="font-size: 14pt; margin-top: 30px;">Smoke</h3>
    <table style="width: 100%;">
        <thead>
            <tr>
                <th style="width: 20%;">Test Type</th>
                <th style="width: 25%;">Method / Standard</th>
                <th style="width: 25%;">Requirement</th>
                <th style="width: 30%;">Result</th>
                <th style="width: 20%;">Unit</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Fume Rating</td>
                <td>NF F16-101</td>
                <td>Smoke & Toxicity</td>
                <td>F1</td>
                <td>-</td>
            </tr>
            <tr>
                <td>Smoke Density</td>
                <td>BS6853</td>
                <td>A &lt;0.02</td>
                <td>Ao</td>
                <td>-</td>
            </tr>
            <tr>
                <td>Smoke Density</td>
                <td>ASTM E-662</td>
                <td>Ds &lt;100 in both modes</td>
                <td>Ds Max</td>
                <td>-</td>
            </tr>
        </tbody>
    </table>

    <h3 style="font-size: 14pt; margin-top: 30px;">Toxicity</h3>
    <table style="width: 100%;">
        <thead>
            <tr>
                <th style="width: 20%;">Test Type</th>
                <th style="width: 25%;">Method / Standard</th>
                <th style="width: 25%;">Requirement</th>
                <th style="width: 30%;">Result</th>
                <th style="width: 20%;">Unit</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Halogen Free</td>
                <td>LUL</td>
                <td>&lt;0.5%</td>
                <td>Pass</td>
                <td>Pass/Fail</td>
            </tr>
            <tr>
                <td>Phosphorous Free</td>
                <td>LUL</td>
                <td>&lt;0.5%</td>
                <td>Pass</td>
                <td>Pass/Fail</td>
            </tr>
            <tr>
                <td>Sulphur Free</td>
                <td>LUL</td>
                <td>&lt;0.5%</td>
                <td>Pass</td>
                <td>Pass/Fail</td>
            </tr>
            <tr>
                <td>Toxicity</td>
                <td>NES713 Issue 3</td>
                <td>R23 - HL3 &lt;0.75 HL2 &lt;0.9 HL1 &lt;1.2</td>
                <td>0.78 (HL2)</td>
                <td>CIT (NLP)</td>
            </tr>
        </tbody>
    </table>

    <h3 style="font-size: 14pt; margin-top: 30px;">Fire Performance Overview</h3>
    <table style="width: 100%;">
        <thead>
            <tr>
                <th style="width: 20%;">Property</th>
                <th style="width: 20%;">Low Fire Hazard</th>
                <th style="width: 20%;">Enhanced Low Fire Hazard</th>
                <th style="width: 20%;">Super Low Fire Hazard</th>
                <th style="width: 20%;">Inherent Low Fire Hazard</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Oxygen Index ISO4589 BS6853 Smoke Density 3m³</td>
                <td>LFH: 32% &gt;0.2%</td>
                <td>EFH: 0.0005 &lt;0.02</td>
                <td>SLFH: 0.1 &lt;0.2</td>
                <td>ILFH: &lt;0.005</td>
            </tr>
            <tr>
                <td>Zero Halogen</td>
                <td>&check;</td>
                <td>&check;</td>
                <td>&check;</td>
                <td>&check;</td>
            </tr>
            <tr>
                <td>Zero Phosphorous</td>
                <td>&check;</td>
                <td>&check;</td>
                <td>&check;</td>
                <td>&check;</td>
            </tr>
            <tr>
                <td>Zero Sulphur</td>
                <td>&check;</td>
                <td>&check;</td>
                <td>&check;</td>
                <td>&check;</td>
            </tr>
            <tr>
                <td>NF F16-102 EN45545-2</td>
                <td>HL2</td>
                <td>HL3</td>
                <td>HL3</td>
                <td>HL3</td>
            </tr>
        </tbody>
    </table>

    <h3 style="font-size: 14pt; margin-top: 30px;">Pre Test Conditions</h3>
    <table style="width: 100%;">
        <tr>
            <th style="width: 25%;">Duration</th>
            <th style="width: 25%;">Standard</th>
            <th style="width: 25%;">Temperature</th>
            <th style="width: 25%;">Relative Humidity</th>
        </tr>
        <tr>
            <td>168 (Hours)</td>
            <td>IEC61386</td>
            <td>23 (°C)</td>
            <td>50 (%)</td>
        </tr>
    </table>
</div>

</body>
</html>