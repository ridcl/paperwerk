<!DOCTYPE html>
<html>
<head>
<title>Technical Data Sheet</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body { font-family: "DejaVu Sans", "Liberation Sans", Arial, Helvetica, sans-serif; }
  table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
  th, td { padding: 8px; text-align: left; border: 1px solid #ddd; }
  h1, h2, h3 { font-family: "DejaVu Serif", "Liberation Serif", Georgia, serif; }
  .header-right { text-align: right; }
</style>
</head>
<body>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <div>
      <span data-field="document_id">{{ document_id }}</span>
    </div>
    <div class="header-right">
      <span data-field="page_number">{{ page_number }}</span>
    </div>
  </div>
  <h1 style="font-size: 24pt; margin-bottom: 5px;">Non-Metallic Systems</h1>
  <h2 style="font-size: 18pt; margin-top: 0;">Adaptaseal Type FLC90</h2>
  <div style="display: flex; align-items: center; margin-top: 20px;">
    <div style="flex-grow: 1;"></div>
    <img src="placeholder_logo.png" alt="Logo" style="height: 60px;">
  </div>

  <h3 style="margin-top: 30px;">Technical Characteristics</h3>
  <table style="width: 100%;">
    <tr>
      <td style="width: 30%;">Conforms to</td>
      <td><span data-field="conformity_standard">{{ conformity_standard }}</span></td>
      <td style="width: 30%;"></td>
      <td><span data-field="directive_type">{{ directive_type }}</span></td>
    </tr>
  </table>

  <h3 style="margin-top: 30px;">Approvals and Standards</h3>
  <table style="width: 100%;">
    <tr>
      <td style="width: 30%;">Degree of mechanical protection</td>
      <td><span data-field="protection_rating_1">{{ protection_rating_1 }}</span></td>
      <td style="width: 30%;"></td>
      <td><span data-field="protection_rating_2">{{ protection_rating_2 }}</span></td>
    </tr>
    <tr>
      <td>Degree of protection</td>
      <td><span data-field="protection_rating_3">{{ protection_rating_3 }}</span></td>
      <td></td>
      <td><span data-field="protection_rating_4">{{ protection_rating_4 }}</span></td>
    </tr>
  </table>

  <h3 style="margin-top: 30px;">UV protection</h3>
  <table style="width: 100%;">
    <tr>
      <td style="width: 30%;">UV protection</td>
      <td><span data-field="uv_rating">{{ uv_rating }}</span></td>
    </tr>
  </table>

  <h3 style="margin-top: 30px;">Fitting Characteristics</h3>
  <table style="width: 100%;">
    <tr>
      <td style="width: 30%;">Fitting Characteristics</td>
      <td><span data-field="fitting_description">{{ fitting_description }}</span></td>
    </tr>
  </table>

  <h3 style="margin-top: 30px;">Application</h3>
  <table style="width: 100%;">
    <tr>
      <td style="width: 30%;">Application</td>
      <td><span data-field="application_description">{{ application_description }}</span></td>
    </tr>
  </table>

  <h3 style="margin-top: 30px;">Normal operating temperature range</h3>
  <table style="width: 100%;">
    <tr>
      <td style="width: 20%;"></td>
      <td>Application</td>
      <td>Min Temp</td>
      <td>Max Temp</td>
    </tr>
    <tr>
      <td>Static</td>
      <td><span data-field="temp_static_min">{{ temp_static_min }}</span></td>
      <td><span data-field="temp_static_max">{{ temp_static_max }}</span></td>
    </tr>
    <tr>
      <td>Dynamic</td>
      <td><span data-field="temp_dynamic_min">{{ temp_dynamic_min }}</span></td>
      <td><span data-field="temp_dynamic_max">{{ temp_dynamic_max }}</span></td>
    </tr>
  </table>

  <h3 style="margin-top: 30px;">For use with - Conduit Series</h3>
  <table style="width: 100%;">
    <tr>
      <td></td>
      <td><span data-field="conduit_series_usage">{{ conduit_series_usage }}</span></td>
    </tr>
  </table>

  <h3 style="margin-top: 30px;">Fire performance</h3>
  <table style="width: 100%;">
    <tr>
      <td style="width: 30%;">Test Standard</td>
      <td style="width: 30%;">Performance Rating</td>
      <td style="width: 40%;"></td>
    </tr>
    <tr>
      <td>BS EN 61386-1 & 23</td>
      <td>Approved</td>
      <td>Self Extinguishing Low Smoke & Halogen Free</td>
    </tr>
    <tr>
      <td>NFF16-101</td>
      <td>I4 F2</td>
      <td></td>
    </tr>
    <tr>
      <td>ISO 4589-2</td>
      <td>24%</td>
      <td></td>
    </tr>
    <tr>
      <td>BS EN 60695-2-11</td>
      <td>850°C</td>
      <td></td>
    </tr>
    <tr>
      <td>UL94</td>
      <td>V2</td>
      <td></td>
    </tr>
  </table>

  <h3 style="margin-top: 30px;">Testing data</h3>
  <table style="width: 100%;">
    <tr>
      <td>Testing data</td>
      <td>Click or See pages <span data-field="page_ref_1">{{ page_ref_1 }}</span> & <span data-field="page_ref_2">{{ page_ref_2 }}</span></td>
    </tr>
  </table>

  <h3 style="margin-top: 30px;">Type of material</h3>
  <table style="width: 100%;">
    <tr>
      <td>Type of material</td>
      <td><span data-field="material_composition">{{ material_composition }}</span></td>
    </tr>
  </table>

  <h3 style="margin-top: 30px;">Image</h3>
  <div style="text-align: center; margin-top: 20px;">
    <img src="placeholder_fitting_image.png" alt="Fitting Diagram" style="max-width: 400px;">
  </div>

  <div style="margin-top: 50px; font-size: 10pt; text-align: center;">
    The Company's policy is one of continuous improvement and reserves the right to change specifications at any time without prior notice.
  </div>
</div>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <div>
      <span data-field="document_id">{{ document_id }}</span>
    </div>
    <div class="header-right">
      <span data-field="page_number">{{ page_number }}</span>
    </div>
  </div>
  <h1 style="font-size: 24pt; margin-bottom: 5px;">Non-Metallic Systems</h1>
  <h2 style="font-size: 18pt; margin-top: 0;">Adaptaseal Type FLC90</h2>

  <h3 style="margin-top: 30px;">Dimensional Data</h3>
  <table style="width: 100%;">
    <thead>
      <tr>
        <th style="width: 15%;">Part No Black Body</th>
        <th style="width: 10%;">A</th>
        <th style="width: 10%;">B</th>
        <th style="width: 10%;">C</th>
        <th style="width: 10%;">D</th>
        <th style="width: 10%;">E</th>
        <th style="width: 10%;">F</th>
        <th style="width: 15%;">Weight in grams (Each)</th>
      </tr>
    </thead>
    <tbody>
      {% for item in dimensional_data %}
      <tr>
        <td><span data-field="dimensional_data[{{ loop.index0 }}].part_no">{{ dimensional_data[loop.index0].part_no }}</span></td>
        <td><span data-field="dimensional_data[{{ loop.index0 }}].a">{{ item.a }}</span></td>
        <td><span data-field="dimensional_data[{{ loop.index0 }}].b">{{ item.b }}</span></td>
        <td><span data-field="dimensional_data[{{ loop.index0 }}].c">{{ item.c }}</span></td>
        <td><span data-field="dimensional_data[{{ loop.index0 }}].d">{{ item.d }}</span></td>
        <td><span data-field="dimensional_data[{{ loop.index0 }}].e">{{ item.e }}</span></td>
        <td><span data-field="dimensional_data[{{ loop.index0 }}].f">{{ item.f }}</span></td>
        <td><span data-field="dimensional_data[{{ loop.index0 }}].weight">{{ item.weight }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 40px;">
    <div style="width: 50%;">
      <img src="placeholder_diagram_left.png" alt="Dimensional Diagram Left" style="max-width: 45%;">
    </div>
    <div style="width: 50%; text-align: right;">
      <img src="placeholder_diagram_right.png" alt="Dimensional Diagram Right" style="max-width: 45%;">
    </div>
  </div>

  <div style="margin-top: 50px; font-size: 10pt; text-align: center;">
    The Company's policy is one of continuous improvement and reserves the right to change specifications at any time without prior notice.
  </div>
</div>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <div>
      <span data-field="document_id">{{ document_id }}</span>
    </div>
    <div class="header-right">
      <span data-field="page_number">{{ page_number }}</span>
    </div>
  </div>
  <h1 style="font-size: 24pt; margin-bottom: 5px;">Non-Metallic Systems</h1>
  <h2 style="font-size: 18pt; margin-top: 0;">Adaptaseal Type FLC90</h2>

  <h3 style="margin-top: 30px;">BS EN 61386 Classification</h3>
  <table style="width: 100%;">
    <thead>
      <tr>
        <th>Fitting</th>
        <th>Compression</th>
        <th>Impact</th>
        <th>Min temp</th>
        <th>Max temp</th>
        <th>Bending</th>
        <th>Electrical solids</th>
        <th>IP water</th>
        <th>IP corrosion</th>
        <th>Tensile</th>
        <th>Non-flame Propagating</th>
        <th>Suspended load</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>AL</td>
        <td>N/A</td>
        <td>4</td>
        <td>2</td>
        <td>4</td>
        <td>N/A</td>
        <td>0</td>
        <td>6</td>
        <td>0</td>
        <td>1</td>
        <td>1</td>
        <td>0</td>
      </tr>
    </tbody>
  </table>

  <h3 style="margin-top: 30px;">Mechanical Properties</h3>
  <table style="width: 100%;">
    <thead>
      <tr>
        <th>Test Type</th>
        <th>Methods / Standards</th>
        <th>Requirements</th>
        <th>Value</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Tensile Strength</td>
        <td>IEC61386-1</td>
        <td>2 mins at Specified Value (PAFS21 Conduit)</td>
        <td>Class 1</td>
      </tr>
      <tr>
        <td>Tensile Strength</td>
        <td>Ultimate Pullout (PAFS21 Conduit)</td>
        <td></td>
        <td>240N</td>
      </tr>
      <tr>
        <td>Impact Strength @ -45°C</td>
        <td>IEC61386-1</td>
        <td>No visible damage</td>
        <td>Class 1</td>
      </tr>
      <tr>
        <td>Impact Strength @ -5°C</td>
        <td>IEC61386-1</td>
        <td>No visible damage</td>
        <td>Class 3</td>
      </tr>
      <tr>
        <td>Impact Strength @ 23°C</td>
        <td>IEC61386-1</td>
        <td>No visible damage</td>
        <td>Class 5</td>
      </tr>
    </tbody>
  </table>
  <p style="font-size: 10pt; margin-top: 10px;">Tensile Tests to IEC 61386 gives the minimum classification value only. Actual values will depend on the type and size of the fittings used and will always be greater than the minimum - Impact strength is the minimum classification value at the minimum temperature - actual values will depend on size and temperature. Specific values available on request.</p>

  <h3 style="margin-top: 30px;">Thermal Properties</h3>
  <table style="width: 100%;">
    <thead>
      <tr>
        <th>Test Type</th>
        <th>Methods / Standards</th>
        <th>Requirements</th>
        <th>Value</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Dynamic Applications</td>
        <td>IEC 61386-23</td>
        <td>5000 Operations at MBR 2hrs</td>
        <td>-45°C to +120°C</td>
      </tr>
      <tr>
        <td>Static Short Term Temp</td>
        <td></td>
        <td>Temporary Use (3000hrs)</td>
        <td>-50°C to +120°C</td>
      </tr>
      <tr>
        <td>Static Long Term Temp</td>
        <td></td>
        <td>Permanent Use (30,000 Hours)</td>
        <td>-45°C to +105°C</td>
      </tr>
    </tbody>
  </table>

  <div style="margin-top: 50px; font-size: 10pt; text-align: center;">
    The Company's policy is one of continuous improvement and reserves the right to change specifications at any time without prior notice.
  </div>
</div>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <div>
      <span data-field="document_id">{{ document_id }}</span>
    </div>
    <div class="header-right">
      <span data-field="page_number">{{ page_number }}</span>
    </div>
  </div>
  <h1 style="font-size: 24pt; margin-bottom: 5px;">Non-Metallic Systems</h1>
  <h2 style="font-size: 18pt; margin-top: 0;">Adaptaseal Type FLC90</h2>

  <h3 style="margin-top: 30px;">Flammability</h3>
  <table style="width: 100%;">
    <thead>
      <tr>
        <th>Test Type</th>
        <th>Method / Standard</th>
        <th>Requirement</th>
        <th>Result</th>
        <th>Unit</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Glow Wire</td>
        <td>BS EN 61386-1-12</td>
        <td>Extinguish within 30s</td>
        <td>850°C</td>
        <td>°C</td>
      </tr>
      <tr>
        <td>Flammability</td>
        <td>IEC 61386-1-12</td>
        <td>1Kw Burner Flame to Self Extinguishing</td>
        <td>Pass</td>
        <td>Pass/Fail</td>
      </tr>
      <tr>
        <td>Oxygen Index</td>
        <td>ISO 4589-2</td>
        <td></td>
        <td>24.1</td>
        <td>%</td>
      </tr>
      <tr>
        <td>Ignition Rating</td>
        <td>NF F16-101</td>
        <td>I Rating</td>
        <td>I4</td>
        <td>-</td>
      </tr>
    </tbody>
  </table>

  <h3 style="margin-top: 30px;">Smoke</h3>
  <table style="width: 100%;">
    <thead>
      <tr>
        <th>Test Type</th>
        <th>Method / Standard</th>
        <th>Requirement</th>
        <th>Result</th>
        <th>Unit</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Fume Rating</td>
        <td>NF F16-101</td>
        <td>F Rating</td>
        <td>F2</td>
        <td>-</td>
      </tr>
    </tbody>
  </table>

  <h3 style="margin-top: 30px;">Toxicity</h3>
  <table style="width: 100%;">
    <thead>
      <tr>
        <th>Test Type</th>
        <th>Method / Standard</th>
        <th>Requirement</th>
        <th>Result</th>
        <th>Unit</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Halogen Free</td>
        <td>NFX 70-100</td>
        <td>&lt; 0.5%</td>
        <td>Pass</td>
        <td>Pass/Fail</td>
      </tr>
    </tbody>
  </table>

  <h3 style="margin-top: 30px;">Pre Test Conditions</h3>
  <table style="width: 100%;">
    <thead>
      <tr>
        <th>Duration</th>
        <th>Standard</th>
        <th>Temperature</th>
        <th>Relative Humidity</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>168 (Hours)</td>
        <td>IEC61386</td>
        <td>23 (°C)</td>
        <td>50 (%)</td>
      </tr>
    </tbody>
  </table>

  <h3 style="margin-top: 30px;">Chemical Resistance Chart</h3>
  <table style="width: 100%;">
    <thead>
      <tr>
        <th style="width: 20%;">Key:</th>
        <th style="width: 20%;">Suitable:</th>
        <th style="width: 20%;">Limited Suitability:</th>
        <th style="width: 20%;">Unsuitable:</th>
        <th style="width: 20%;">Not Tested:</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="key_description">{{ key_description }}</span></td>
        <td><span data-field="suitable_list">{{ suitable_list }}</span></td>
        <td><span data-field="limited_suitability_list">{{ limited_suitability_list }}</span></td>
        <td><span data-field="unsuitable_list">{{ unsuitable_list }}</span></td>
        <td><span data-field="not_tested_list">{{ not_tested_list }}</span></td>
      </tr>
    </tbody>
  </table>
  <p style="font-size: 10pt; margin-top: 20px;">The information above is given as a guide only and is based on published technical data and experience. The chemical resistance of the above products is dependent on factors such as chemical exposure, concentration of the chemical and temperature. The above chemicals are tested for a short period of time and the results may not be representative of the long term exposure. The user should assess compatibility with their application and contact Thomas & Betts for further information.</p>
  <p style="font-size: 10pt; margin-top: 10px;">ADHERENCE TO THE CURRENT WIRING REGULATIONS BS7671 OR NEC WIRING REGULATIONS (FOR USA) IS STRONGLY ADVISED.</p>
  <p style="font-size: 10pt; margin-top: 10px;">MINIMUM BEND RADIUS FOR FLEXING IS DEPENDANT UPON TEMPERATURE, BENDING FREQUENCY AND CHEMICAL ENVIRONMENT.</p>

  <div style="margin-top: 50px; font-size: 10pt; text-align: center;">
    The Company's policy is one of continuous improvement and reserves the right to change specifications at any time without prior notice.
  </div>
</div>

</body>
</html>