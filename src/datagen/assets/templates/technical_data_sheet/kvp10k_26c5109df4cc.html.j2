<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  table { width: 100%; border-collapse: collapse; margin-top: 20px; }
  th, td { padding: 8px; text-align: left; border-bottom: 1px solid #ddd; }
  th { font-weight: bold; }
</style>
<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div style="text-align: right;">
      <h1 style="font-size: 36px; margin: 0;">ABB</h1>
    </div>
    <div style="text-align: left;">
      <span style="font-size: 12px;">1</span>
    </div>
  </div>
  <div style="margin-top: 40px;">
    <h2 style="font-size: 24px; font-weight: bold; margin-bottom: 5px;">TECHNICAL DATA SHEET</h2>
    <h1 style="font-size: 32px; font-weight: normal; margin-top: 0;">PMA FIXPLUS - BUNV-UL - Fitting</h1>
    <h2 style="font-size: 20px; font-weight: normal; margin-top: 0;">Straight, metric thread</h2>
  </div>
  <div style="margin-top: 60px;">
    <h1 style="font-size: 48px; font-weight: normal;">PMA</h1>
  </div>
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-top: 50px;">
    <div style="flex: 1; padding-right: 50px;">
      <img src="placeholder_image.png" alt="Product Diagram" style="max-width: 400px; height: auto;">
    </div>
    <div style="flex: 1; text-align: right;">
      <p style="font-size: 18px;">UL-listed polyamide fitting for flexible non-metallic conduit</p>
      <div style="margin-top: 30px;">
        <span style="font-size: 30px;">CE</span>
        <span style="font-size: 30px; margin-left: 15px;">UL Listed</span>
        <span style="font-size: 30px; margin-left: 15px;">UKCA</span>
      </div>
    </div>
  </div>
  <div style="margin-top: 60px;">
    <h3 style="font-size: 18px; font-weight: bold; margin-bottom: 10px;">Applications:</h3>
    <ul style="list-style-type: disc; padding-left: 20px;">
      <li>For cable protection systems in a wide range of applications</li>
      <li>Excellent fire characteristics allow application in public buildings like hospitals, hotels, airports, train and subway stations, shopping centres etc.</li>
      <li>For use according to National Electric Code (NEC) NFPA 70, Article 356</li>
    </ul>
  </div>
  <div style="margin-top: 30px;">
    <h3 style="font-size: 18px; font-weight: bold; margin-bottom: 10px;">Features & Benefits:</h3>
    <ul style="list-style-type: disc; padding-left: 20px;">
      <li>Extremely High Impact resistance</li>
      <li>Vibration-resistant connection to PMA conduits</li>
      <li>Easy installation</li>
      <li>High conduit pull-out strength</li>
      <li>Very good chemical properties</li>
      <li>Fits conduit profile coarse (G)</li>
    </ul>
  </div>
  <div style="margin-top: 30px;">
    <h3 style="font-size: 18px; font-weight: bold; margin-bottom: 10px;">Ingress protection:</h3>
    <p><span data-field="ingress_protection_rating">{{ ingress_protection_rating }}</span></p>
    <p><span data-field="water_impact_rating">{{ water_impact_rating }}</span></p>
  </div>
  <div style="margin-top: 30px;">
    <h3 style="font-size: 18px; font-weight: bold; margin-bottom: 10px;">Materials:</h3>
    <p><span data-field="material_description">{{ material_description }}</span></p>
  </div>
  <div style="margin-top: 60px;">
    <h3 style="font-size: 18px; font-weight: bold; margin-bottom: 10px;">Compatible with:</h3>
    <ul style="list-style-type: disc; padding-left: 20px;">
      <li>PMA FLEXPLUS conduits</li>
    </ul>
  </div>
  <div style="margin-top: 30px;">
    <h3 style="font-size: 18px; font-weight: bold; margin-bottom: 10px;">Conforms to:</h3>
    <ul style="list-style-type: disc; padding-left: 20px;">
      <li>UL 514B / CSA C22.2 No. 18.3 (UL File E174370)</li>
      <li>UL 94 (V0)</li>
    </ul>
  </div>
  <div style="margin-top: 30px;">
    <h3 style="font-size: 18px; font-weight: bold; margin-bottom: 10px;">Colour:</h3>
    <ul style="list-style-type: disc; padding-left: 20px;">
      <li>Black</li>
      <li>Grey</li>
    </ul>
  </div>
  <div style="margin-top: 30px;">
    <h3 style="font-size: 18px; font-weight: bold; margin-bottom: 10px;">Chemical properties:</h3>
    <ul style="list-style-type: disc; padding-left: 20px;">
      <li>Please refer to www.pma.ch (Technical Information / Chemical Resistance)</li>
    </ul>
  </div>
  <div style="margin-top: 30px;">
    <h3 style="font-size: 18px; font-weight: bold; margin-bottom: 10px;">Environmental properties:</h3>
    <ul style="list-style-type: disc; padding-left: 20px;">
      <li>Free from halogens and cadmium</li>
      <li>RoHS and REACH compliant</li>
    </ul>
  </div>
</div>
<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div style="text-align: left;">
      <span style="font-size: 12px;">2</span>
    </div>
    <div style="text-align: right;">
      <!-- Placeholder for page number/footer if needed -->
    </div>
  </div>
  <div style="margin-top: 40px;">
    <h3 style="font-size: 16px; font-weight: bold; margin-bottom: 10px;">Product selection:</h3>
    <table>
      <thead>
        <tr>
          <th style="width: 10%;">Part no.</th>
          <th style="width: 15%;">Thread size</th>
          <th style="width: 10%;">Conduit size</th>
          <th style="width: 10%;">Dimensions in mm (nom.)</th>
          <th style="width: 10%;">Weight</th>
          <th style="width: 15%;">Packing unit</th>
        </tr>
      </thead>
      <tbody>
        {% for item in product_selection %}
        <tr>
          <td><span data-field="product_selection[{{ loop.index0 }}].part_no">{{ item.part_no }}</span></td>
          <td><span data-field="product_selection[{{ loop.index0 }}].thread_size">{{ item.thread_size }}</span></td>
          <td><span data-field="product_selection[{{ loop.index0 }}].conduit_size">{{ item.conduit_size }}</span></td>
          <td><span data-field="product_selection[{{ loop.index0 }}].dimensions">{{ item.dimensions }}</span></td>
          <td><span data-field="product_selection[{{ loop.index0 }}].weight">{{ item.weight }}</span></td>
          <td><span data-field="product_selection[{{ loop.index0 }}].packing_unit">{{ item.packing_unit }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  <div style="margin-top: 60px; display: flex; justify-content: space-around;">
    <div style="width: 40%;">
      <h3 style="font-size: 16px; font-weight: bold; margin-bottom: 10px;">Dimensional Drawing</h3>
      <img src="placeholder_drawing.png" alt="Dimensional Drawing" style="max-width: 100%; height: auto;">
    </div>
    <div style="width: 40%;">
      <!-- Empty space or other content -->
    </div>
  </div>
  <div style="margin-top: 50px; font-size: 12px; text-align: center;">
    <p>Our customer service dept. or local distribution partner will be pleased to help you concerning product availability and lead time</p>
  </div>
</div>
<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div style="text-align: left;">
      <span style="font-size: 12px;">3</span>
    </div>
    <div style="text-align: right;">
      <!-- Placeholder for page number/footer if needed -->
    </div>
  </div>
  <div style="margin-top: 40px;">
    <h3 style="font-size: 18px; font-weight: bold; margin-bottom: 15px;">Mechanical Properties:</h3>
    <table>
      <thead>
        <tr>
          <th style="width: 40%;">Property</th>
          <th style="width: 20%;">Value</th>
          <th style="width: 20%;">Test parameters:</th>
          <th style="width: 20%;">Test method:</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Tensile modulus</td>
          <td><span data-field="mechanical_properties.tensile_modulus_value">{{ mechanical_properties.tensile_modulus_value }}</span></td>
          <td><span data-field="mechanical_properties.tensile_modulus_test_params">{{ mechanical_properties.tensile_modulus_test_params }}</span></td>
          <td><span data-field="mechanical_properties.tensile_modulus_test_method">{{ mechanical_properties.tensile_modulus_test_method }}</span></td>
        </tr>
        <tr>
          <td>Tensile strength</td>
          <td><span data-field="mechanical_properties.tensile_strength_value">{{ mechanical_properties.tensile_strength_value }}</span></td>
          <td><span data-field="mechanical_properties.tensile_strength_test_params">{{ mechanical_properties.tensile_strength_test_params }}</span></td>
          <td><span data-field="mechanical_properties.tensile_strength_test_method">{{ mechanical_properties.tensile_strength_test_method }}</span></td>
        </tr>
        <tr>
          <td>Notched bar impact test</td>
          <td><span data-field="mechanical_properties.impact_test_value">{{ mechanical_properties.impact_test_value }}</span></td>
          <td><span data-field="mechanical_properties.impact_test_params">{{ mechanical_properties.impact_test_params }}</span></td>
          <td><span data-field="mechanical_properties.impact_test_method">{{ mechanical_properties.impact_test_method }}</span></td>
        </tr>
      </tbody>
    </table>
  </div>
  <div style="margin-top: 40px;">
    <h3 style="font-size: 18px; font-weight: bold; margin-bottom: 15px;">Thermal properties:</h3>
    <table>
      <thead>
        <tr>
          <th style="width: 40%;">Property</th>
          <th style="width: 20%;">Value</th>
          <th style="width: 20%;">Test parameters:</th>
          <th style="width: 20%;">Test method:</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Continuous application temperature</td>
          <td><span data-field="thermal_properties.continuous_temp_value">{{ thermal_properties.continuous_temp_value }}</span></td>
          <td><span data-field="thermal_properties.continuous_temp_params">{{ thermal_properties.continuous_temp_params }}</span></td>
          <td><span data-field="thermal_properties.continuous_temp_method">{{ thermal_properties.continuous_temp_method }}</span></td>
        </tr>
        <tr>
          <td>Upper application temperature</td>
          <td><span data-field="thermal_properties.upper_temp_value">{{ thermal_properties.upper_temp_value }}</span></td>
          <td><span data-field="thermal_properties.upper_temp_params">{{ thermal_properties.upper_temp_params }}</span></td>
          <td><span data-field="thermal_properties.upper_temp_method">{{ thermal_properties.upper_temp_method }}</span></td>
        </tr>
        <tr>
          <td>Short-term</td>
          <td><span data-field="thermal_properties.short_term_value">{{ thermal_properties.short_term_value }}</span></td>
          <td><span data-field="thermal_properties.short_term_params">{{ thermal_properties.short_term_params }}</span></td>
          <td><span data-field="thermal_properties.short_term_method">{{ thermal_properties.short_term_method }}</span></td>
        </tr>
      </tbody>
    </table>
  </div>
  <div style="margin-top: 40px;">
    <h3 style="font-size: 18px; font-weight: bold; margin-bottom: 15px;">Fire safety properties:</h3>
    <table>
      <thead>
        <tr>
          <th style="width: 40%;">Property</th>
          <th style="width: 20%;">Value</th>
          <th style="width: 20%;">Test parameters:</th>
          <th style="width: 20%;">Test method:</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Flame class</td>
          <td><span data-field="fire_safety_properties.flame_class_value">{{ fire_safety_properties.flame_class_value }}</span></td>
          <td><span data-field="fire_safety_properties.flame_class_params">{{ fire_safety_properties.flame_class_params }}</span></td>
          <td><span data-field="fire_safety_properties.flame_class_method">{{ fire_safety_properties.flame_class_method }}</span></td>
        </tr>
        <tr>
          <td>Glowing wire test</td>
          <td><span data-field="fire_safety_properties.glowing_wire_value">{{ fire_safety_properties.glowing_wire_value }}</span></td>
          <td><span data-field="fire_safety_properties.glowing_wire_params">{{ fire_safety_properties.glowing_wire_params }}</span></td>
          <td><span data-field="fire_safety_properties.glowing_wire_method">{{ fire_safety_properties.glowing_wire_method }}</span></td>
        </tr>
        <tr>
          <td>Oxygen Index (LOI)</td>
          <td><span data-field="fire_safety_properties.loi_value">{{ fire_safety_properties.loi_value }}</span></td>
          <td></td>
          <td></td>
        </tr>
      </tbody>
    </table>
  </div>
  <div style="margin-top: 40px; display: flex; justify-content: space-between;">
    <div style="width: 48%;">
      <h3 style="font-size: 18px; font-weight: bold; margin-bottom: 10px;">Content of delivery:</h3>
      <ul style="list-style-type: disc; padding-left: 20px;">
        <li>Fitting with conduit locking clip (AUN2)</li>
        <li>Conduit gasket (NVN3)</li>
        <li>Thread gasket (SVN4)</li>
        <li>Compatible lock nut (BMN-M)</li>
      </ul>
    </div>
    <div style="width: 48%;">
      <h3 style="font-size: 18px; font-weight: bold; margin-bottom: 10px;">Assembly instructions:</h3>
      <p>Please consider the assembly instructions on <a href="http://www.pma.ch" style="color: blue;">www.pma.ch</a></p>
    </div>
  </div>
</div>
<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div style="text-align: left;">
      <!-- Footer content -->
    </div>
    <div style="text-align: right;">
      <!-- Footer content -->
    </div>
  </div>
  <div style="margin-top: 100px; display: flex; justify-content: space-between; align-items: flex-start;">
    <div style="width: 30%;">
      <h3 style="font-size: 18px; font-weight: bold; margin-bottom: 10px;">ABB Switzerland Ltd.</h3>
      <p style="font-size: 12px;">PMA Cable Protection</p>
      <p style="font-size: 12px;">Ahabstrasse 10</p>
      <p style="font-size: 12px;">8610 Uster, Switzerland</p>
      <p style="font-size: 12px;">Phone: <span data-field="contact_phone">{{ contact_phone }}</span></p>
      <p style="font-size: 12px;">Email: <span data-field="contact_email">{{ contact_email }}</span></p>
      <p style="font-size: 12px;">www.pma.ch</p>
      <p style="font-size: 12px; margin-top: 20px;">Let's write the future. Together. abb.com</p>
    </div>
