<!DOCTYPE html>
<html>
<head>
<title>Technical Data Sheet</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
  th, td { padding: 8px; text-align: left; border-bottom: 1px solid #ddd; }
  .header-title { font-size: 24pt; font-weight: bold; }
  .section-heading { font-size: 14pt; font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
  .sub-heading { font-size: 12pt; font-weight: bold; margin-top: 15px; margin-bottom: 5px; }
  .data-table-small th { width: 20%; }
</style>
</head>
<body>
<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      <div style="font-size: 10pt; color: #555;">Technical Data Sheet</div>
      <div style="font-size: 10pt; color: #555;">{{ document_number }}</div>
    </div>
    <div style="text-align: right;">
      <div style="font-size: 10pt; color: #555;">Page 1</div>
      <img src="placeholder_logo.png" alt="Logo" style="height: 40px;">
    </div>
  </div>
  <div style="margin-top: 10px;">
    <div style="font-size: 20pt; font-weight: bold;">Non-Metallic Systems</div>
    <div style="font-size: 16pt; font-weight: bold;">PK - Very High Specification Conduit</div>
  </div>

  <div class="section-heading">Technical Characteristics</div>
  <table>
    <tr>
      <th style="width: 20%;">Conforms to</th>
      <td><span data-field="conformity_standards">{{ conformity_standards }}</span></td>
    </tr>
    <tr>
      <th>Approvals and Standards</th>
      <td><img src="placeholder_cert_ce.png" alt="CE" style="height: 20px;"> <img src="placeholder_cert_nf.png" alt="NF" style="height: 20px;"></td>
    </tr>
    <tr>
      <th>Degree of mechanical protection</th>
      <td><span data-field="mechanical_protection_degree">{{ mechanical_protection_degree }}</span></td>
    </tr>
    <tr>
      <th>Degree of protection</th>
      <td><span data-field="protection_degree">{{ protection_degree }}</span></td>
    </tr>
    <tr>
      <th>UV protection</th>
      <td><span data-field="uv_protection">{{ uv_protection }}</span></td>
    </tr>
    <tr>
      <th>Finish</th>
      <td><span data-field="finish">{{ finish }}</span></td>
    </tr>
    <tr>
      <th>Application</th>
      <td><span data-field="application">{{ application }}</span></td>
    </tr>
    <tr>
      <th>Normal operating temperature range</th>
      <td>
        <table class="data-table-small">
          <tr>
            <th style="width: 30%;">Application</th>
            <th style="width: 20%;">Min Temp</th>
            <th style="width: 20%;">Max Temp</th>
          </tr>
          <tr>
            <td>Static</td>
            <td><span data-field="temp_static_min">{{ temp_static_min }}</span></td>
            <td><span data-field="temp_static_max">{{ temp_static_max }}</span></td>
          </tr>
          <tr>
            <td>Dynamic</td>
            <td><span data-field="temp_dynamic_min">{{ temp_dynamic_min }}</span></td>
            <td><span data-field="temp_dynamic_max">{{ temp_dynamic_max }}</span></td>
          </tr>
        </table>
      </td>
    </tr>
    <tr>
      <th>For use with - Fitting range</th>
      <td><span data-field="fitting_range">{{ fitting_range }}</span></td>
    </tr>
    <tr>
      <th>Fire performance</th>
      <td>
        <table class="data-table-small">
          <tr>
            <th style="width: 30%;">Test Standard</th>
            <th style="width: 20%;">Performance Rating</th>
            <th style="width: 50%;">Notes</th>
          </tr>
          <tr>
            <td><span data-field="fire_test_standard_1">{{ fire_test_standard_1 }}</span></td>
            <td><span data-field="fire_rating_1">{{ fire_rating_1 }}</span></td>
            <td><span data-field="fire_note_1">{{ fire_note_1 }}</span></td>
          </tr>
          <tr>
            <td><span data-field="fire_test_standard_2">{{ fire_test_standard_2 }}</span></td>
            <td><span data-field="fire_rating_2">{{ fire_rating_2 }}</span></td>
            <td><span data-field="fire_note_2">{{ fire_note_2 }}</span></td>
          </tr>
          <tr>
            <td><span data-field="fire_test_standard_3">{{ fire_test_standard_3 }}</span></td>
            <td><span data-field="fire_rating_3">{{ fire_rating_3 }}</span></td>
            <td><span data-field="fire_note_3">{{ fire_note_3 }}</span></td>
          </tr>
        </table>
      </td>
    </tr>
    <tr>
      <th>Testing data</th>
      <td>Click or See pages <span data-field="testing_data_page_1">{{ testing_data_page_1 }}</span> & <span data-field="testing_data_page_2">{{ testing_data_page_2 }}</span></td>
    </tr>
    <tr>
      <th>Type of material</th>
      <td><span data-field="material_type">{{ material_type }}</span></td>
    </tr>
    <tr>
      <th>Image</th>
      <td><img src="placeholder_conduit_image.png" alt="Conduit Image" style="height: 50px;"></td>
    </tr>
  </table>
</div>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      <div style="font-size: 10pt; color: #555;">Technical Data Sheet</div>
      <div style="font-size: 10pt; color: #555;">201507</div>
    </div>
    <div style="text-align: right;">
      <div style="font-size: 10pt; color: #555;">Page 2</div>
      <img src="placeholder_logo.png" alt="Logo" style="height: 40px;">
    </div>
  </div>
  <div style="margin-top: 10px;">
    <div style="font-size: 20pt; font-weight: bold;">Non-Metallic Systems</div>
    <div style="font-size: 16pt; font-weight: bold;">PK - Very High Specification Conduit</div>
  </div>

  <div class="section-heading">Technical & Dimensional Data</div>
  <table>
    <thead>
      <tr>
        <th style="width: 10%;">Part No.</th>
        <th style="width: 15%;">Nominal Conduit Size</th>
        <th style="width: 10%;">NW</th>
        <th style="width: 15%;">Conduit Size</th>
        <th style="width: 10%;">Pitch</th>
        <th style="width: 15%;">Conduit (A) Outside Diameter</th>
        <th style="width: 15%;">Conduit (B) Inside Diameter</th>
        <th style="width: 10%;">Conduit (C) Min. Bend Radius</th>
        <th style="width: 10%;">Reel Length (m)</th>
        <th style="width: 10%;">Average Weight (Kg/100m)</th>
      </tr>
    </thead>
    <tbody>
      {% for item in conduit_sizes %}
      <tr>
        <td><span data-field="conduit_sizes[{{ loop.index0 }}].part_no">{{ item.part_no }}</span></td>
        <td><span data-field="conduit_sizes[{{ loop.index0 }}].nominal_size">{{ item.nominal_size }}</span></td>
        <td><span data-field="conduit_sizes[{{ loop.index0 }}].nw">{{ item.nw }}</span></td>
        <td><span data-field="conduit_sizes[{{ loop.index0 }}].conduit_size">{{ item.conduit_size }}</span></td>
        <td><span data-field="conduit_sizes[{{ loop.index0 }}].pitch">{{ item.pitch }}</span></td>
        <td><span data-field="conduit_sizes[{{ loop.index0 }}].diameter_a">{{ item.diameter_a }}</span></td>
        <td><span data-field="conduit_sizes[{{ loop.index0 }}].diameter_b">{{ item.diameter_b }}</span></td>
        <td><span data-field="conduit_sizes[{{ loop.index0 }}].bend_radius_c">{{ item.bend_radius_c }}</span></td>
        <td><span data-field="conduit_sizes[{{ loop.index0 }}].reel_length">{{ item.reel_length }}</span></td>
        <td><span data-field="conduit_sizes[{{ loop.index0 }}].avg_weight">{{ item.avg_weight }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div style="text-align: center; margin-top: 30px;">
    <p>To order quote part number, colour & reel length, e.g. <span data-field="example_order_code">{{ example_order_code }}</span></p>
  </div>

  <div style="text-align: center; margin-top: 50px;">
    <img src="placeholder_diagram.png" alt="Conduit Diagram" style="width: 400px;">
    <div style="display: flex; justify-content: space-between; margin-top: 10px;">
        <div style="text-align: left;">C</div>
        <div style="text-align: right;">A B</div>
    </div>
  </div>
</div>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      <div style="font-size: 10pt; color: #555;">Technical Data Sheet</div>
      <div style="font-size: 10pt; color: #555;">201507</div>
    </div>
    <div style="text-align: right;">
