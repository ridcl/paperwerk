        <td><span data-field="chemical_unsubtlable_3">{{ chemical_unsubtlable_3 }}</span></td>
        <td><span data-field="chemical_not_tested_3">{{ chemical_not_tested_3 }}</span></td>
      </tr>
      <tr>
        <td><span data-field="chemical_key_4">{{ chemical_key_4 }}</span></td>
        <td><span data-field="chemical_subtlable_4">{{ chemical_subtlable_4 }}</span></td>
        <td><span data-field="chemical_unsubtlable_4">{{ chemical_unsubtlable_4 }}</span></td>
        <td><span data-field="chemical_not_tested_4">{{ chemical_not_tested_4 }}</span></td>
      </tr>
      <tr>
        <td><span data-field="chemical_key_5">{{ chemical_key_5 }}</span></td>
        <td><span data-field="chemical_subtlable_5">{{ chemical_subtlable_5 }}</span></td>
        <td><span data-field="chemical_unsubtlable_5">{{ chemical_unsubtlable_5 }}</span></td>
        <td><span data-field="chemical_not_tested_5">{{ chemical_not_tested_5 }}</span></td>
      </tr>
      <tr>
        <td><span data-field="chemical_key_6">{{ chemical_key_6 }}</span></td>
