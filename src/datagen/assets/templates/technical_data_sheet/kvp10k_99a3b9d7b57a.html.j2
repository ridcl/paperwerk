    <thead>
      <tr>
        <th>Key:</th>
        <th>Subtlable:</th>
        <th>Unsubtlable:</th>
        <th>Not Tested:</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="chemical_key_1">{{ chemical_key_1 }}</span></td>
        <td><span data-field="chemical_subtlable_1">{{ chemical_subtlable_1 }}</span></td>
        <td><span data-field="chemical_unsubtlable_1">{{ chemical_unsubtlable_1 }}</span></td>
        <td><span data-field="chemical_not_tested_1">{{ chemical_not_tested_1 }}</span></td>
      </tr>
      <tr>
        <td><span data-field="chemical_key_2">{{ chemical_key_2 }}</span></td>
        <td><span data-field="chemical_subtlable_2">{{ chemical_subtlable_2 }}</span></td>
        <td><span data-field="chemical_unsubtlable_2">{{ chemical_unsubtlable_2 }}</span></td>
        <td><span data-field="chemical_not_tested_2">{{ chemical_not_tested_2 }}</span></td>
      </tr>
      <tr>
        <td><span data-field="chemical_key_3">{{ chemical_key_3 }}</span></td>
