      </tr>
      <tr>
        <td>Dynamic Bend Radius @ -45 °C</td>
        <td>IEC61386-23</td>
        <td>5000 cycles minimum</td>
        <td>4xOD</td>
      </tr>
    </tbody>
  </table>

  <div class="sub-heading">Thermal Properties</div>
  <table>
    <thead>
      <tr>
        <th style="width: 20%;">Test Type</th>
        <th style="width: 25%;">Methods / Standards</th>
        <th style="width: 30%;">Requirements</th>
        <th style="width: 25%;">Value</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Minimum Temperature</td>
        <td></td>
        <td>Permanent Use (30,000) Hours</td>
        <td>-60°C</td>
      </tr>
      <tr>
        <td>Maximum Temperature</td>
        <td></td>
