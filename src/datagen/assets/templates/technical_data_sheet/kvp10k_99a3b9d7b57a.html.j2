        <th>Compression</th>
        <th>Impact</th>
        <th>Min Temp</th>
        <th>Max Temp</th>
        <th>Bending</th>
        <th>Electrical Solids</th>
        <th>IP Water</th>
        <th>Corrosion</th>
        <th>Tensile</th>
        <th>Non-flame Propagating</th>
        <th>Suspended Load</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>PK</td>
        <td>2</td>
        <td>4</td>
        <td>5</td>
        <td>6</td>
        <td>4</td>
        <td>2</td>
        <td>6</td>
        <td>7</td>
        <td>-</td>
        <td>1</td>
        <td>0</td>
      </tr>
    </tbody>
  </table>

  <div class="sub-heading">Mechanical Properties</div>
  <table>
    <thead>
      <tr>
        <th style="width: 20%;">Test Type</th>
        <th style="width: 25%;">Methods / Standards</th>
        <th style="width: 30%;">Requirements</th>
        <th style="width: 25%;">Value</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Crush Strength</td>
        <td>IEC61386-1</td>
