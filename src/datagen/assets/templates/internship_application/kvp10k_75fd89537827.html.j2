<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    color: #333;
  }
  h1, h2, h3 {
    font-weight: bold;
    margin-top: 0;
  }
  .header-logo {
    display: flex;
    align-items: center;
    margin-bottom: 20px;
  }
  .logo-smu {
    width: 60px;
    height: auto;
    margin-right: 15px;
  }
  .logo-text h1 {
    font-size: 24px;
    margin: 0;
    line-height: 1.1;
  }
  .section-title {
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
    border-bottom: 1px solid #ccc;
    padding-bottom: 3px;
  }
  .form-row {
    display: flex;
    margin-bottom: 15px;
    align-items: flex-start;
  }
  .form-row > div {
    flex: 1;
  }
  .form-row .label-col {
    flex-basis: 30%;
    padding-right: 20px;
  }
  .form-row .input-col {
    flex-basis: 70%;
  }
  .note {
    font-size: 0.9em;
    color: #555;
    margin-top: 10px;
    margin-bottom: 20px;
  }
  .signature-block {
    margin-top: 50px;
    padding-top: 20px;
    border-top: 1px solid #000;
  }
  .signature-line {
    margin-bottom: 30px;
  }
  .signature-line span {
    display: block;
    height: 1em;
    border-bottom: 1px solid #000;
    margin-bottom: 5px;
  }
</style>

<div class="page">
  <div class="header-logo">
    <!-- Placeholder for SMU Logo -->
    <img src="placeholder_smu_logo.png" alt="SMU Logo" class="logo-smu">
    <div class="logo-text">
      <h1>TEMERLIN<br>ADVERTISING<br>INSTITUTE</h1>
    </div>
  </div>

  <h2>INTERNSHIP FOR COURSE CREDIT APPROVAL FORM</h2>

  <p>If you're an advertising major wishing to earn SMU course credit for an internship, complete this form and submit it to the Temerlin Advertising Institute at <span data-field="institute_email">{{ institute_email }}</span>. You'll be notified of our decision within 2-3 business days. If approved you'll be given permission to enroll in the appropriate advertising internship course for the appropriate term.</p>

  <div class="note">
    NOTE: Course credit can only be earned for an internship during the term in which the internship is being completed (i.e. summer internships will require enrollment in a summer advertising internship course, etc.). Interning for course credit is not required for the B.A. in Advertising.
  </div>

  <!-- I. YOUR INFORMATION -->
  <div class="section-title">I. YOUR INFORMATION</div>
  <div class="form-row">
    <div class="label-col">NAME</div>
    <div class="input-col"><span data-field="full_name">{{ full_name }}</span></div>
  </div>
  <div class="form-row">
    <div class="label-col">SMU ID</div>
    <div class="input-col"><span data-field="student_id">{{ student_id }}</span></div>
  </div>
  <div class="form-row">
    <div class="label-col">SMU EMAIL ADDRESS</div>
    <div class="input-col"><span data-field="student_email">{{ student_email }}</span></div>
  </div>
  <div class="form-row">
    <div class="label-col">PHONE NUMBER</div>
    <div class="input-col"><span data-field="student_phone">{{ student_phone }}</span></div>
  </div>

  <!-- II. PROPOSED INTERNSHIP INFORMATION -->
  <div class="section-title">II. PROPOSED INTERNSHIP INFORMATION</div>
  <div class="form-row">
    <div class="label-col">INTERNSHIP EMPLOYER (AGENCY/COMPANY/FIRM)</div>
    <div class="input-col"><span data-field="employer.name">{{ employer.name }}</span></div>
  </div>
  <div class="form-row">
    <div class="label-col">LOCATION OF INTERNSHIP (CITY, STATE/COUNTRY)</div>
    <div class="input-col"><span data-field="employer.location">{{ employer.location }}</span></div>
  </div>
  <div class="form-row">
    <div class="label-col">SUPERVISOR'S NAME</div>
    <div class="input-col"><span data-field="supervisor.name">{{ supervisor.name }}</span></div>
  </div>
  <div class="form-row">
    <div class="label-col">SUPERVISOR'S EMAIL ADDRESS</div>
    <div class="input-col"><span data-field="supervisor.email">{{ supervisor.email }}</span></div>
  </div>
  <div class="form-row">
    <div class="label-col">INTERNSHIP TITLE (e.g., DIGITAL MEDIA INTERN)</div>
    <div class="input-col"><span data-field="internship.title">{{ internship.title }}</span></div>
  </div>
  <div class="form-row">
    <div class="label-col">HOURS A WEEK (ANTICIPATED)</div>
    <div class="input-col"><span data-field="internship.hours_per_week">{{ internship.hours_per_week }}</span></div>
  </div>
  <div class="form-row">
    <div class="label-col">DESCRIPTION OF INTERNSHIP (WHAT WILL YOU BE DOING?)</div>
    <div class="input-col"><span data-field="internship.description">{{ internship.description }}</span></div>
  </div>
  <div class="note">
    NOTE: IF YOU HAVE A PORTFOLIO DOCUMENT WITH THIS INFO FROM YOUR EMPLOYER, FEEL FREE TO SEND IT AS AN ATTACHMENT WITH THIS COMPLETED FORM.
  </div>

  <!-- III. REGISTRATION INFORMATION & ACKNOWLEDGEMENT -->
  <div class="section-title">III. REGISTRATION INFORMATION & ACKNOWLEDGEMENT</div>
  <p>PLEASE INDICATE YOUR DESIRED LEVEL OF COURSE CREDIT FOR THIS INTERNSHIP</p>

  <div class="form-row" style="margin-bottom: 10px;">
    <div class="label-col" style="flex-basis: 100%;">ADV 3150 (1 CREDIT HOUR) – MINIMUM 50 HOURS OF WORK REQUIRED</div>
    <div class="input-col" style="flex-basis: 100%;"><input type="checkbox" data-field="credit_level_adv3150" value="{{ credit_level_adv3150 }}"></div>
  </div>
  <div class="form-row" style="margin-bottom: 10px;">
    <div class="label-col" style="flex-basis: 100%;">ADV 3250 (2 CREDIT HOURS) – MINIMUM 100 HOURS OF WORKD REQUIRED</div>
    <div class="input-col" style="flex-basis: 100%;"><input type="checkbox" data-field="credit_level_adv3250" value="{{ credit_level_adv3250 }}"></div>
  </div>
  <div class="form-row" style="margin-bottom: 20px;">
    <div class="label-col" style="flex-basis: 100%;">ADV 3350 (3 CREDIT HOURS) – MINIMUM 150 HOURS OF WORK REQUIRED</div>
    <div class="input-col" style="flex-basis: 100%;"><input type="checkbox" data-field="credit_level_adv3350" value="{{ credit_level_adv3350 }}"></div>
  </div>

  <div class="form-row">
    <div class="label-col">TERM REQUESTING CREDIT FOR</div>
    <div class="input-col"><span data-field="requested_term">{{ requested_term }}</span></div>
  </div>

  <!-- SIGNATURES -->
  <div class="signature-block">
    <div class="signature-line">
      YOUR SIGNATURE
      <span></span>
      <div style="text-align: right; font-size: 0.9em; margin-top: 5px;">Date: <span data-field="signature_date">{{ signature_date }}</span></div>
    </div>

    <div class="signature-line">
      FOR TEMERLIN ADVERTISING INSTITUTE USE ONLY
      <span></span>
      <div style="text-align: right; font-size: 0.9em; margin-top: 5px;">Credit Hour(s) for Term: <span data-field="approved_credit_hours">{{ approved_credit_hours }}</span></div>
    </div>

    <div class="form-row" style="margin-top: 20px;">
      <div class="label-col" style="flex-basis: 100%;">
        <input type="checkbox" data-field="approved_for" value="{{ approved_for }}"> APPROVED FOR
      </div>
      <div class="label-col" style="flex-basis: 100%;">
        <input type="checkbox" data-field="not_approved" value="{{ not_approved }}"> NOT APPROVED
      </div>
    </div>

    <div class="signature-line">
      TAI INTERNSHIP COORDINATOR'S SIGNATURE
      <span></span>
    </div>
  </div>

  <div style="text-align: center; margin-top: 80px; font-size: 0.85em;">
    QUESTIONS ABOUT THIS FORM?
    <br>
    Contact the Temerlin Advertising Institute at <span data-field="institute_contact_email">{{ institute_contact_email }}</span> or 214.768.3090.
  </div>
</div>