<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; }
  h1, h2, h3 { text-align: center; margin-bottom: 20px; }
  .header-section { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 20px; }
  .form-row > div { width: 48%; }
  .signature-line { border-bottom: 1px solid #000; margin-top: 50px; margin-bottom: 50px; }
  .footer { margin-top: 80px; padding-top: 20px; border-top: 1px solid #000; font-size: 0.9em; }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      <h2 style="font-size: 1.2em; margin-bottom: 5px;">Office of Student Financial Services</h2>
      <p style="font-size: 0.9em;">Andrews University</p>
    </div>
    <div style="text-align: right;">
      <h1 style="font-size: 1.5em; margin: 0;">2022-2023 STATEMENT OF EDUCATIONAL PURPOSE: NOTARY</h1>
    </div>
  </div>

  <div style="margin-top: 60px;">
    <div class="form-row">
      <div>
        <p style="font-weight: bold;">NAME</p>
        <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
          <span data-field="full_name">{{ full_name }}</span>
        </div>
      </div>
      <div>
        <p style="font-weight: bold;">ID NUMBER</p>
        <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
          <span data-field="id_number">{{ id_number }}</span>
        </div>
      </div>
    </div>
  </div>

  <div style="margin-top: 40px;">
    <h2 style="font-size: 1.1em; margin-bottom: 15px;">IDENTITY</h2>
    <p style="font-size: 0.95em; line-height: 1.4;">
      If the student is unable to appear in person at <span data-field="school_name">{{ school_name }}</span> University to verify his or her identity, the student must provide a copy of the unexpired valid government-issued photo identification (ID) that is acknowledged in the notary statement below, such as but not limited to a driver's license, non-driver's identification card, other state-issued ID, or passport; and the original notarized Statement of Educational Purpose provided below. To be signed only in presence of Notary.
    </p>
  </div>

  <div style="margin-top: 50px;">
    <h2 style="font-size: 1.1em; margin-bottom: 15px;">STATEMENT OF EDUCATIONAL PURPOSE</h2>
    <p style="font-size: 0.95em; line-height: 1.4;">
      I certify that I <span data-field="certification_statement_1">{{ certification_statement_1 }}</span> am the individual signing this Statement of Educational Purpose and that the federal student financial assistance I may receive will only be used for educational purposes and to pay the cost of attending <span data-field="school_name">{{ school_name }}</span> University for <span data-field="academic_year">{{ academic_year }}</span>.
    </p>
  </div>

  <div style="margin-top: 60px;">
    <div class="form-row">
      <div>
        <p style="font-weight: bold;">Student's signature</p>
        <div class="signature-line"></div>
      </div>
      <div>
        <p style="font-weight: bold;">Date</p>
        <div class="signature-line"></div>
      </div>
    </div>
  </div>

  <div style="margin-top: 60px;">
    <h2 style="font-size: 1.1em; margin-bottom: 15px;">NOTARY'S CERTIFICATE OF ACKNOWLEDGEMENT</h2>
    <div class="form-row">
      <div>
        <p style="font-weight: bold;">State of</p>
        <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
          <span data-field="notary_state">{{ notary_state }}</span>
        </div>
      </div>
      <div>
        <p style="font-weight: bold;">City/County of</p>
        <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
          <span data-field="notary_city_county">{{ notary_city_county }}</span>
        </div>
      </div>
    </div>

    <div style="margin-top: 30px;">
      <div class="form-row">
        <div>
          <p style="font-weight: bold;">On</p>
          <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
            <span data-field="notary_date">{{ notary_date }}</span>
          </div>
          <p style="font-size: 0.8em; margin-top: 5px;">(date)</p>
        </div>
        <div>
          <p style="font-weight: bold;">before me,</p>
          <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
            <span data-field="notary_signer_name">{{ notary_signer_name }}</span>
          </div>
          <p style="font-size: 0.8em; margin-top: 5px;">(notary's name)</p>
        </div>
      </div>
    </div>

    <div style="margin-top: 30px;">
      <p style="font-size: 0.95em; line-height: 1.4;">
        <span data-field="signer_statement_1">{{ signer_statement_1 }}</span> and proved to me on basis of satisfactory evidence of identification
        <div style="border-bottom: 1px solid #000; padding-bottom: 5px; margin-top: 10px;">
          <span data-field="signer_statement_2">{{ signer_statement_2 }}</span>
        </div>
        to be the above-named person who signed the foregoing instrument.
      </p>
    </div>
  </div>

  <div style="margin-top: 50px;">
    <div class="form-row">
      <div>
        <p style="font-weight: bold;">WITNESS my hand and official seal:</p>
        <div class="signature-line"></div>
        <p style="font-size: 0.8em; margin-top: 5px;">(notary signature)</p>
      </div>
      <div>
        <p style="font-weight: bold;">My commission expires on</p>
        <div class="signature-line"></div>
        <p style="font-size: 0.8em; margin-top: 5px;">(date)</p>
      </div>
    </div>
  </div>

  <div style="margin-top: 50px;">
    <p style="font-weight: bold; text-align: center; border: 2px solid #000; padding: 10px;">DO NOT FAX OR SCAN. ORIGINAL DOCUMENTS ONLY</p>
  </div>

  <div class="footer">
    <div style="display: flex; justify-content: space-between;">
      <div>
        <p style="font-weight: bold;">Mail to:</p>
        <p><span data-field="university_name">{{ university_name }}</span></p>
        <p><span data-field="department_name">{{ department_name }}</span></p>
        <p><span data-field="address_line_1">{{ address_line_1 }}</span></p>
        <p><span data-field="address_line_2">{{ address_line_2 }}</span></p>
      </div>
      <div style="text-align: right;">
        <p style="font-weight: bold;">Phone:</p>
        <p><span data-field="phone_number">{{ phone_number }}</span></p>
        <p style="font-weight: bold;">Email:</p>
        <p><span data-field="email_address">{{ email_address }}</span></p>
        <p style="font-weight: bold;">Web:</p>
        <p><span data-field="website_url">{{ website_url }}</span></p>
      </div>
    </div>
    <div style="text-align: right; margin-top: 20px;">
      <span data-field="document_date">{{ document_date }}</span>
    </div>
  </div>
</div>