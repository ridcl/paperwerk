<!DOCTYPE html>
<html>
<head>
<title>Publications Catalog</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    margin: 0;
    padding: 0;
  }
  h1, h2, h3 {
    font-weight: bold;
  }
  .content-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    margin-top: 30px;
  }
  .book-entry {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }
  .book-image {
    width: 100%;
    height: auto;
    max-height: 200px;
    object-fit: contain;
    margin-bottom: 10px;
  }
  .book-details h3 {
    font-size: 1.2em;
    margin-bottom: 5px;
  }
  .book-details p {
    font-size: 0.9em;
    line-height: 1.4;
  }
  .contents-list {
    list-style-type: none;
    padding-left: 0;
  }
  .contents-list li {
    margin-bottom: 5px;
    font-size: 0.9em;
  }
  .page-number {
    text-align: right;
    font-size: 0.8em;
    margin-top: 20px;
  }
</style>

