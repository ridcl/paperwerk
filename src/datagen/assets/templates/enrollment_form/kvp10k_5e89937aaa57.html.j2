<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 15px;
  }
  td {
    padding: 5px;
    vertical-align: top;
  }
  .form-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 10px;
  }
  .form-label {
    font-weight: bold;
  }
  .input-field {
    border-bottom: 1px solid #000;
    padding: 0 5px;
    width: 30%;
  }
  .checkbox-group label {
    margin-right: 15px;
  }
</style>

<div class="page">
  <div style="text-align: center; margin-bottom: 30px;">
    <img src="placeholder_logo.png" alt="Logo" style="height: 60px; margin-bottom: 10px;">
    <h1 style="font-size: 18pt; margin: 0;">FLORIDA AGRICULTURAL AND MECHANICAL UNIVERSITY</h1>
    <h2 style="font-size: 14pt; margin: 5px 0 0 0;">Employee Tuition Waiver Enrollment Form</h2>
    <p style="font-size: 12pt; margin-top: 10px;">(TUITION WAIVER SHALL NOT BE APPROVED FOR THESIS, DISSERTATION, INTERNSHIP AND DIRECTED INDIVIDUAL STUDY)</p>
  </div>

  <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
    <div style="width: 45%;">
      <p class="form-label">Name:</p>
      <div class="input-field" style="width: 100%;">
        <span data-field="full_name">{{ full_name }}</span>
      </div>
    </div>
    <div style="width: 45%;">
      <p class="form-label">Employee ID Number:</p>
      <div class="input-field" style="width: 100%;">
        <span data-field="employee_id">{{ employee_id }}</span>
      </div>
    </div>
  </div>

  <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
    <div style="width: 45%;">
      <p class="form-label">Office Phone:</p>
      <div class="input-field" style="width: 100%;">
        <span data-field="office_phone">{{ office_phone }}</span>
      </div>
    </div>
    <div style="width: 45%;">
      <p class="form-label">Department:</p>
      <div class="input-field" style="width: 100%;">
        <span data-field="department">{{ department }}</span>
      </div>
    </div>
  </div>

  <div style="display: flex; justify-content: space-between; margin-bottom: 30px;">
    <div style="width: 45%;">
      <p class="form-label">Job Title:</p>
      <div class="input-field" style="width: 100%;">
        <span data-field="job_title">{{ job_title }}</span>
      </div>
    </div>
    <div style="width: 45%;">
      <p class="form-label">E-mail Address:</p>
      <div class="input-field" style="width: 100%;">
        <span data-field="email_address">{{ email_address }}</span>
      </div>
    </div>
  </div>

  <h3 style="font-size: 12pt; margin-bottom: 10px;">CHECK EMPLOYMENT CATEGORY (Must be full-time salaried employee)</h3>
  <div style="margin-bottom: 20px;">
    <div class="checkbox-group">
      <label><input type="checkbox"> Faculty</label>
      <label><input type="checkbox"> A&P</label>
      <label><input type="checkbox"> USPS</label>
    </div>
  </div>

  <h3 style="font-size: 12pt; margin-bottom: 10px;">COURSE REGISTRATION INFORMATION:</h3>
  <p style="font-size: 10pt; margin-bottom: 10px;">I am requesting a waiver for the following Semester:</p>
  <div style="display: flex; gap: 20px; margin-bottom: 20px;">
    <div>
      <label>Fall</label>
      <input type="radio" name="semester" value="Fall">
    </div>
    <div>
      <label>Spring</label>
      <input type="radio" name="semester" value="Spring">
    </div>
    <div>
      <label>Summer A&C</label>
      <input type="radio" name="semester" value="Summer A&C">
    </div>
    <div>
      <label>Summer B</label>
      <input type="radio" name="semester" value="Summer B">
    </div>
  </div>

  <p style="font-size: 10pt; margin-bottom: 10px;">List Course(s) for which you wish to enroll.</p>

  <table style="margin-bottom: 20px;">
    <thead>
      <tr>
        <th style="text-align: left; width: 40%;">Course Title</th>
        <th style="text-align: center; width: 15%;">Course Number</th>
        <th style="text-align: center; width: 15%;">Section Number</th>
        <th style="text-align: center; width: 15%;">Credit Hours</th>
        <th style="text-align: center; width: 15%;">Course Day(s) / Time</th>
      </tr>
    </thead>
    <tbody>
      {% for item in course_enrollments %}
      <tr>
        <td><span data-field="course_enrollments[{{ loop.index0 }}].title">{{ item.title }}</span></td>
        <td style="text-align: center;"><span data-field="course_enrollments[{{ loop.index0 }}].number">{{ item.number }}</span></td>
        <td style="text-align: center;"><span data-field="course_enrollments[{{ loop.index0 }}].section">{{ item.section }}</span></td>
        <td style="text-align: center;"><span data-field="course_enrollments[{{ loop.index0 }}].credits">{{ item.credits }}</span></td>
        <td style="text-align: center;"><span data-field="course_enrollments[{{ loop.index0 }}].schedule">{{ item.schedule }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <h3 style="font-size: 12pt; margin-top: 30px; margin-bottom: 10px;">LEAVE PROVISION SECTION</h3>

  <div style="margin-bottom: 20px;">
    <p style="font-size: 10pt;">1 The course(s) listed is/are taken during regularly scheduled working hours. All time taken during that period, including time taken in traveling to and from class, will be charged to annual, compensatory or leave without pay. Indicate the beginning and ending dates of the classes and the total hours in annual/compensatory leave to be used.</p>
    <table style="margin-top: 10px;">
      <tr>
        <td style="width: 30%;">Beginning Date:</td>
        <td style="width: 30%;"><span data-field="leave_start_date">{{ leave_start_date }}</span></td>
        <td style="width: 20%;">Ending Date:</td>
        <td style="width: 20%;"><span data-field="leave_end_date">{{ leave_end_date }}</span></td>
      </tr>
      <tr>
        <td style="width: 30%;">Total Hours:</td>
        <td style="width: 70%;"><span data-field="total_hours">{{ total_hours }}</span></td>
      </tr>
    </table>
  </div>

  <div style="margin-bottom: 20px;">
    <p style="font-size: 10pt;">2 The course(s) is/are required by the University as an extension of training for the current position occupied and any leave taken during working hours to attend classes will be regarded as time worked. (Attached letter of justification from supervisor).</p>
  </div>

  <h3 style="font-size: 12pt; margin-top: 30px; margin-bottom: 10px;">EMPLOYEE'S CERTIFICATION & SIGNATURE</h3>
  <p style="font-size: 10pt; margin-bottom: 20px;">I certify that I am a full-time state employee and am eligible to receive up to 6 credit hours of tuition fee courses. Further I understand that I am required to maintain a minimum grade point average of 2.0 in all courses taken. I further understand that the extension of training, and that my supervisor is not obligated to grant time and/or leave for participation in this program, and that the value of graduate level tuition fee courses is taxable under Internal Revenue Code unless tax exemption applies and is approved by the IRS. I understand that I must register only on the designated registration dates for FAMU employees otherwise I will be responsible for my tuition and fees.</p>

  <div style="display: flex; justify-content: space-between; margin-top: 50px;">
    <div style="width: 45%;">
      <p class="form-label">EMPLOYEE'S SIGNATURE</p>
      <div style="height: 50px; border-bottom: 1px solid #000;" data-field="employee_s_signature">{{ employee_s_signature }}</div>
      <p style="margin-top: 5px;"><span data-field="employee_signature_date">{{ employee_signature_date }}</span></p>
    </div>
    <div style="width: 45%;">
      <p class="form-label">DATE:</p>
      <div style="height: 50px; border-bottom: 1px solid #000;" data-field="date">{{ date }}</div>
    </div>
  </div>

  <h3 style="font-size: 12pt; margin-top: 40px; margin-bottom: 10px;">SUPERVISOR'S CERTIFICATION & SIGNATURE</h3>
  <p style="font-size: 10pt; margin-bottom: 20px;">THE SUPERVISOR certifies that the above-named employee: (Check all that apply)</p>
  <div style="margin-bottom: 20px;">
    <p style="font-size: 10pt;">[ ] is required to take annual or compensatory leave for course(s) taken during University work time.</p>
    <p style="font-size: 10pt;">[ ] is NOT required to take annual or compensatory leave for courses taken during University work time. (Justification attached)</p>
  </div>

  <div style="display: flex; justify-content: space-between; margin-top: 50px;">
    <div style="width: 45%;">
      <p class="form-label">SUPERVISOR'S SIGNATURE</p>
      <div style="height: 50px; border-bottom: 1px solid #000;" data-field="supervisor_s_signature">{{ supervisor_s_signature }}</div>
      <p style="margin-top: 5px;"><span data-field="supervisor_signature_date">{{ supervisor_signature_date }}</span></p>
    </div>
    <div style="width: 45%;">
      <p class="form-label">DATE:</p>
      <div style="height: 50px; border-bottom: 1px solid #000;" data-field="date_2">{{ date_2 }}</div>
    </div>
  </div>

  <h3 style="font-size: 12pt; margin-top: 40px; margin-bottom: 10px;">MANAGEMENT APPROVAL</h3>
  <table style="margin-bottom: 20px;">
    <thead>
      <tr>
        <th style="text-align: left; width: 30%;">DEAN/DIRECTOR/DEPARTMENT HEAD</th>
        <th style="text-align: center; width: 15%;">APPROVED</th>
        <th style="text-align: center; width: 15%;">YES</th>
        <th style="text-align: center; width: 15%;">NO</th>
        <th style="text-align: center; width: 25%;">DATE</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td></td>
        <td style="border-bottom: 1px solid #000;"></td>
        <td style="border-bottom: 1px solid #000;"></td>
        <td style="border-bottom: 1px solid #000;"></td>
        <td><span data-field="dean_approval_date">{{ dean_approval_date }}</span></td>
      </tr>
    </tbody>
  </table>

  <table style="margin-bottom: 20px;">
    <thead>
      <tr>
        <th style="text-align: left; width: 30%;">PRESIDENT/PROVOST/VICE PRESIDENT</th>
        <th style="text-align: center; width: 15%;">APPROVED</th>
        <th style="text-align: center; width: 15%;">YES</th>
        <th style="text-align: center; width: 15%;">NO</th>
        <th style="text-align: center; width: 25%;">DATE</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td></td>
        <td style="border-bottom: 1px solid #000;"></td>
        <td style="border-bottom: 1px solid #000;"></td>
        <td style="border-bottom: 1px solid #000;"></td>
        <td><span data-field="president_approval_date">{{ president_approval_date }}</span></td>
      </tr>
    </tbody>
  </table>

  <table style="margin-bottom: 20px;">
    <thead>
      <tr>
        <th style="text-align: left; width: 30%;">ASSOCIATE VICE PRESIDENT, CHIEF HR AND DIVERSITY OFFICER</th>
        <th style="text-align: center; width: 15%;">APPROVED</th>
        <th style="text-align: center; width: 15%;">YES</th>
        <th style="text-align: center; width: 15%;">NO</th>
        <th style="text-align: center; width: 25%;">DATE</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td></td>
        <td style="border-bottom: 1px solid #000;"></td>
        <td style="border-bottom: 1px solid #000;"></td>
        <td style="border-bottom: 1px solid #000;"></td>
        <td><span data-field="avp_approval_date">{{ avp_approval_date }}</span></td>
      </tr>
    </tbody>
  </table>

  <div style="margin-top: 50px; font-size: 10pt;">
    HR-LR (November 2017)
  </div>
</div>