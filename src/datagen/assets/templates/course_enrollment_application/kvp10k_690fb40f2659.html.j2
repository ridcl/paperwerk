<!-- PAGE 4 (Page 11) - Info/Contact Page -->
<div class="page">
  <div style="padding: 10px 0;">
    <div class="info-border">
      <!-- Logo / University Name -->
      <div class="info-center">
        <div class="logo-placeholder">
          <span data-field="university_logo_text">{{ university_logo_text }}</span>
          <span class="logo-sub"><span data-field="university_logo_subtext">{{ university_logo_subtext }}</span></span>
        </div>
        <div class="info-university-name"><span data-field="university_name">{{ university_name }}</span></div>
        <div class="info-subtitle"><span data-field="office_name">{{ office_name }}</span></div>
        <div class="info-subtitle"><span data-field="director_name">{{ director_name }}</span></div>
      </div>

      <!-- Office Hours -->
      <div class="info-center">
        <div class="info-section-title">Office Hours</div>
        <div class="info-hours">
          <div><span data-field="office_hours_weekday_label">{{ office_hours_weekday_label }}</span>: <span data-field="office_hours_weekday_time">{{ office_hours_weekday_time }}</span></div>
          <div><span data-field="office_hours_friday_label">{{ office_hours_friday_label }}</span>: <span data-field="office_hours_friday_time">{{ office_hours_friday_time }}</span></div>
        </div>
      </div>

      <!-- Addresses -->
      <div class="info-addresses">
        <div class="info-address-block">
          <div class="info-address-title">Physical Address</div>
          <div><span data-field="physical_address.line1">{{ physical_address.line1 }}</span></div>
          <div><span data-field="physical_address.line2">{{ physical_address.line2 }}</span></div>
          <div><span data-field="physical_address.line3">{{ physical_address.line3 }}</span></div>
        </div>
        <div class="info-address-block">
          <div class="info-address-title">Mailing Address</div>
          <div><span data-field="mailing_address.line1">{{ mailing_address.line1 }}</span></div>
          <div><span data-field="mailing_address.line2">{{ mailing_address.line2 }}</span></div>
          <div><span data-field="mailing_address.line3">{{ mailing_address.line3 }}</span></div>
          <div><span data-field="mailing_address.line4">{{ mailing_address.line4 }}</span></div>
          <div><span data-field="mailing_address.line5">{{ mailing_address.line5 }}</span></div>
        </div>
      </div>

      <!-- Phone / Fax / Email -->
      <div class="info-contact">
        <div class="info-contact-title">Phone / Fax / E-mail</div>
        <div>Phone: <span data-field="contact.phone">{{ contact.phone }}</span></div>
        <div>Fax: <span data-field="contact.fax">{{ contact.fax }}</span></div>
        <div>E-mail: <span class="info-email-link" data-field="contact.email">{{ contact.email }}</span></div>
      </div>
    </div>

    <div class="footer-disclaimer">
      <span data-field="footer_disclaimer">{{ footer_disclaimer }}</span>
    </div>
  </div>

  <div class="page-number">Page <span data-field="page11_number">{{ page11_number }}</span> of <span data-field="total_pages">{{ total_pages }}</span></div>
</div>

