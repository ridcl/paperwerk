<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  .header-info p { margin: 2px 0; font-size: 10pt; }
  .signature-block { margin-top: 50px; }
</style>

<div class="page">
  <div class="header-info">
    <p>ID: <span data-field="document_id">{{ document_id }}</span></p>
    <p>UILC: <span data-field="uilc_code">{{ uilc_code }}</span></p>
    <p>Number: <span data-field="document_number">{{ document_number }}</span></p>
    <p>Release Date: <span data-field="release_date">{{ release_date }}</span></p>
  </div>

  <div style="margin-top: 30px;">
    <p>From: <span data-field="sender_name">{{ sender_name }}</span></p>
    <p>Sent: <span data-field="sent_date">{{ sent_date }}</span></p>
    <p>To: <span data-field="recipient_name">{{ recipient_name }}</span></p>
    <p>Cc: <span data-field="cc_list">{{ cc_list }}</span></p>
    <p>Bcc: <span data-field="bcc_list">{{ bcc_list }}</span></p>
    <p>Subject: RE: Certificate of Discharge Request - Status of Buyer as "<span data-field="subject_detail">{{ subject_detail }}</span>"</p>
  </div>

  <div style="margin-top: 30px;">
    <p>
      <span data-field="body_content">{{ body_content }}</span>
    </p>
  </div>

  <div class="signature-block">
    <!-- Placeholder for signature/closing if needed, based on layout -->
  </div>
</div>