<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1, h2 { text-align: center; margin-bottom: 0.5em; }
  .header-info { text-align: center; margin-bottom: 30px; }
  .section-title { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 15px; }
  .form-label { width: 200px; text-align: left; }
  .form-input-area { flex-grow: 1; border-bottom: 1px solid #000; }
  .signature-line { margin-top: 60px; display: flex; justify-content: space-between; }
  .signature-box { width: 45%; text-align: center; }
</style>

<div class="page">
  <div class="header-info">
    <!-- Placeholder for University Logo/Name -->
    <div style="font-size: 48px; margin-bottom: 5px;">W</div>
    <div style="font-size: 24px; font-weight: bold;">WESLEYAN</div>
    <div style="font-size: 12px; margin-top: 10px;">OFFICE OF THE REGISTRAR</div>
    <div style="font-size: 12px;">{{ employer.address_line_1 }}</div>
    <div style="font-size: 12px;">{{ employer.city_state_zip }}</div>
    <div style="font-size: 12px;">Office: {{ employer.phone }}</div>
    <div style="font-size: 12px;">Fax: {{ employer.fax }}</div>
  </div>

  <h2 style="text-align: center; margin-bottom: 30px;">DEGREE VERIFICATION REQUEST</h2>

  <div style="margin-bottom: 30px;">
    <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
      <div style="width: 30%;">
        Type: <span style="border-bottom: 1px solid #000; display: inline-block; width: 150px;">{{ document_type }}</span>
      </div>
      <div style="width: 30%;">
        Certificate
      </div>
      <div style="width: 30%;">
        Official letter
      </div>
    </div>
    <div style="margin-bottom: 20px;">
      Reason for request: <span style="border-bottom: 1px solid #000; display: inline-block; width: 60%;">{{ reason_for_request }}</span>
    </div>
  </div>

  <div class="section-title">TO BE COMPLETED BY GRADUATE:</div>

  <div class="form-row">
    <div class="form-label">NAME</div>
    <div class="form-input-area">{{ full_name }}</div>
  </div>

  <div class="form-row">
    <div class="form-label">DATE OF REQUEST</div>
    <div class="form-input-area">{{ date_of_request }}</div>
  </div>

  <div class="form-row">
    <div class="form-label">SIGNATURE (required)</div>
    <div class="form-input-area" data-field="signature">{{ signature }}</div> <!-- Placeholder for signature -->
  </div>

  <div style="margin-top: 30px;">
    <div style="display: flex; justify-content: space-between; margin-bottom: 15px;">
      <div style="width: 30%;">
        Please indicate method of delivery:
        <div style="display: flex; gap: 20px; margin-top: 5px;">
          <span style="border-bottom: 1px solid #000;">US Mail</span>
          <span style="border-bottom: 1px solid #000;">Email</span>
          <span style="border-bottom: 1px solid #000;">Fax</span>
        </div>
      </div>
      <div style="width: 30%;">
        Name: <span style="border-bottom: 1px solid #000; display: inline-block; width: 150px;">{{ name_for_delivery }}</span>
      </div>
    </div>
    <div style="margin-bottom: 15px;">
      Address: <span style="border-bottom: 1px solid #000; display: inline-block; width: 300px;">{{ address_for_delivery }}</span>
    </div>
    <div style="margin-bottom: 15px;">
      Email: <span style="border-bottom: 1px solid #000; display: inline-block; width: 300px;">{{ email_for_delivery }}</span>
    </div>
    <div style="margin-bottom: 15px;">
      Fax #: <span style="border-bottom: 1px solid #000; display: inline-block; width: 300px;">{{ fax_for_delivery }}</span>
    </div>
  </div>

  <div class="section-title" style="margin-top: 40px;">Registrar Office Use Only</div>

  <div style="margin-top: 20px;">
    This is to certify the following information for the above named graduate:
  </div>

  <div class="form-row" style="margin-top: 20px;">
    <div class="form-label">Beginning Date of Attendance</div>
    <div class="form-input-area">{{ start_date }}</div>
  </div>

  <div class="form-row">
    <div class="form-label">Ending Date of Attendance</div>
    <div class="form-input-area">{{ end_date }}</div>
  </div>

  <div class="form-row" style="margin-top: 20px;">
    <div class="form-label">Graduation Date</div>
    <div class="form-input-area">{{ graduation_date }}</div>
  </div>

  <div class="form-row">
    <div class="form-label">Degree</div>
    <div class="form-input-area">{{ degree_awarded }}</div>
  </div>

  <div style="margin-top: 80px; text-align: center;">
    Respectfully submitted,
  </div>

  <div class="signature-line">
    <div class="signature-box">
      School Seal
    </div>
    <div class="signature-box">
      Registrar
    </div>
  </div>
</div>