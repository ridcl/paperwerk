<div class="page">
  <div style="margin-top: 50px;">
    <p>To: <span data-field="recipient.title">{{ recipient.title }}</span> <span data-field="recipient.name">{{ recipient.name }}</span></p>
    <p>From: <span data-field="sender.name">{{ sender.name }}</span></p>
    <p>Date: <span data-field="date">{{ date }}</span></p>
    <p>Re: Response to University-Wide Review Committee Recommendation On Promotion</p>
  </div>
  <div style="margin-top: 100px; display: flex; justify-content: space-between;">
    <div style="width: 45%;">
      <div style="border-top: 1px solid black; margin-bottom: 5px;"></div>
      <p style="margin-top: 5px;">Signature</p>
      <p style="margin-top: 20px;">Printed Name</p>
    </div>
    <div style="width: 45%; text-align: right;">
      <p style="margin-top: 5px;">Date</p>
    </div>
  </div>
  <p style="margin-top: 50px;">Use additional sheet(s) if necessary.</p>
