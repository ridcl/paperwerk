    <div class="page">
        <div style="text-align: center; margin-top: 100px;">
            <div style="font-size: 48pt; font-weight: bold; color: #003366;">TOBACCO CESSATION GUIDANCE</div>
            <div style="font-size: 18pt; color: #cc0000; margin-top: 10px;">FOR ORAL HEALTH PROFESSIONALS</div>
        </div>
        <div style="text-align: center; margin-top: 150px;">
            <div style="font-size: 10pt; color: #666;">LEADING THE WORLD TO OPTIMAL ORAL HEALTH</div>
            <div style="margin-top: 20px;">
                <!-- Placeholder for FDI Logo -->
