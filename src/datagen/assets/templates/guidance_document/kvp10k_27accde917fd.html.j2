    <div class="page">
        <div style="text-align: center; margin-top: 100px;">
            <div style="font-size: 24pt; font-weight: bold;">let's TALK!</div>
        </div>
        <div style="display: flex; justify-content: space-around; align-items: center; margin-top: 80px;">
            <!-- Placeholder for characters -->
            <div style="width: 40%;"></div>
            <div style="width: 20%; text-align: center;"></div>
            <div style="width: 40%;"></div>
        </div>
