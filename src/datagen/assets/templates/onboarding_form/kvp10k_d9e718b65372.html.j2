  </div>

  <div class="form-section">
    <p>PAY W4 - Federal</p>
    <p>If you have any questions, please contact Payroll at {{ payroll_phone }} or email <span data-field="payroll_email">{{ payroll_email }}</span>.</p>
    <p>Symbol key: <span style="color: red;">&#9888;</span> required information. <span style="color: red;">&#9888;</span> Error</p>
  </div>

  <div class="form-section">
    <div class="field-group">
      <span class="label">Form Originator</span>
      <div style="display: flex; justify-content: space-between; font-size: 10pt;">
        <div>Originated by: <span data-field="originator.name">{{ originator.name }}</span> (<span data-field="originator.id">{{ originator.id }}</span>)</div>
        <div><span data-field="originator.email">{{ originator.email }}</span></div>
      </div>
    </div>

    <div class="field-group">
      <div style="display: flex; gap: 30px;">
        <div style="flex: 1;">
          <label class="label">Are you a U.S. citizen or permanent resident?</label>
          <div class="input-container">
            <select>
              <option value="Yes">Yes</option>
              <option value="No">No</option>
            </select>
          </div>
        </div>
        <div style="flex: 1;">
          <label class="label">U.S. citizen or permanent resident?</label>
          <div class="radio-group">
            <label><input type="radio" name="citizen_status" value="Yes"> Choose Yes</label>
            <label><input type="radio" name="citizen_status" value="No"> Choose No</label>
          </div>
        </div>
      </div>
    </div>

    <div class="field-group">
      <label class="label">Claiming Exemption for withholding?</label>
      <div class="radio-group">
        <label><input type="radio" name="exemption_claim" value="Yes"> Usually No</label>
      </div>
    </div>
  </div>

  <div class="form-section">
    <p><strong>Step 1: Enter personal information</strong></p>
    <div class="field-group">
      <span class="label">Name:</span>
      <span data-field="personal_info.full_name">{{ personal_info.full_name }}</span>
    </div>
    <div class="field-group">
      <span class="label">Address:</span>
      <span data-field="personal_info.address">{{ personal_info.address }}</span>
    </div>
    <div class="field-group">
      <span class="label">City or town, state, and ZIP code:</span>
      <span data-field="personal_info.location">{{ personal_info.location }}</span>
    </div>
    <div class="field-group">
      <span class="label">Social security number:</span>
      <span data-field="personal_info.ssn_masked">{{ personal_info.ssn_masked }}</span>
    </div>
    <div class="field-group">
      <span class="label">Does your name match the name on your social security card?</span>
      <div class="radio-group">
        <label><input type="radio" name="name_match" value="Yes"> Yes</label>
        <label><input type="radio" name="name_match" value="No"> No</label>
      </div>
    </div>
    <div class="field-group">
      <span class="label">Federal filing status:</span>
      <div class="radio-group">
        <label><input type="radio" name="filing_status" value="Single"> Single or Married filing separately</label>
