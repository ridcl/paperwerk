<!DOCTYPE html>
<html>
<head>
    <title>Onboarding Forms</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, Helvetica, Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 { font-weight: bold; }
        .header-title { font-size: 36pt; }
        .section-title { font-size: 18pt; font-weight: bold; margin-top: 20px; }
        .menu-item { display: flex; align-items: center; margin-bottom: 15px; padding: 10px; border: 1px solid #ccc; border-radius: 5px; cursor: pointer; }
        .menu-item span { margin-right: 15px; font-size: 1.2em; }
        .menu-item-text { flex-grow: 1; }
        .note { font-size: 10pt; color: #555; margin-top: 10px; }
        .form-group { margin-bottom: 15px; }
        .form-group label { display: block; margin-bottom: 5px; font-weight: bold; }
        .form-group input[type="text"], .form-group input[type="date"], .form-group select { width: 100%; padding: 8px; box-sizing: border-box; border: 1px solid #ccc; }
        .two-column { display: flex; justify-content: space-between; gap: 30px; }
        .two-column > div { flex: 1; }
        .error-message { color: red; font-weight: bold; margin-top: 5px; }
        .button { padding: 10px 20px; background-color: #007bff; color: white; border: none; cursor: pointer; border-radius: 5px; }
    </style>

<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  /* Basic styling to mimic document structure */
  h1, h2, h3 {
    font-weight: bold;
    margin-top: 0;
  }
  .section-header {
    font-size: 24pt;
    font-weight: bold;
    margin-bottom: 20px;
  }
  .sub-header {
    font-size: 14pt;
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
  }
  .instruction-box {
    border: 1px solid #ccc;
    padding: 15px;
    margin-bottom: 20px;
    background-color: #f9f9f9;
  }
  .form-group {
    margin-bottom: 15px;
  }
  .form-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 10px;
  }
  .form-field-label {
    font-weight: bold;
    margin-right: 10px;
  }
  .input-field {
    border: 1px solid #ccc;
    padding: 5px;
    width: 300px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
  }
  th, td {
    border: 1px solid #ccc;
    padding: 8px;
    text-align: left;
  }
  th {
    background-color: #eee;
  }
</style>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3, h4 { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; }
  .form-section { margin-bottom: 30px; }
  .field-group { margin-bottom: 15px; }
  .label { font-weight: bold; display: block; margin-bottom: 5px; }
  .input-container { display: flex; gap: 20px; align-items: center; }
  .input-field { flex-grow: 1; }
  .radio-group label { font-weight: normal; display: inline-block; margin-right: 15px; }
  .table-container { width: 100%; border-collapse: collapse; margin-top: 15px; }
  .table-container td { padding: 8px 0; }
  .header-text { font-size: 24pt; font-weight: bold; text-align: center; margin-bottom: 10px; }
  .sub-header { font-size: 14pt; font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
  .note { font-size: 10pt; color: #555; margin-top: 10px; }
</style>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { margin-top: 0; }
  .header-title { font-size: 24pt; font-weight: bold; }
  .section-title { font-size: 14pt; font-weight: bold; margin-bottom: 10px; }
  .form-group { margin-bottom: 15px; }
  .form-group label { display: block; margin-bottom: 5px; font-weight: normal; }
  .form-group input[type="text"], .form-group input[type="email"], .form-group input[type="date"] {
    width: 100%; padding: 8px; box-sizing: border-box; border: 1px solid #ccc;
  }
  .checkbox-group label { display: inline-block; font-weight: normal; margin-right: 15px; }
  .button {
    background-color: #007bff; color: white; padding: 10px 20px; border: none; cursor: pointer; margin-top: 20px;
    font-family: inherit;
  }
  .button:hover { background-color: #0056b3; }
  .card {
    border: 1px solid #ddd; padding: 20px; margin-bottom: 20px; background-color: #f9f9f9;
  }
  .two-column-layout {
    display: flex; justify-content: space-between; gap: 40px;
  }
  .column { flex: 1; }
  .list-item { margin-bottom: 10px; }
  .list-item strong { display: inline-block; width: 150px; }
</style>
</head>
<body>

<div class="page">
    <div style="text-align: center; margin-top: 100px;">
        <div style="font-size: 48pt; font-weight: bold; color: #003366;">GRAMM</div>
        <div style="font-size: 48pt; font-weight: bold; color: #003366;">METAPH</div>
        <div style="font-size: 48pt; font-weight: bold; color: #003366;">PHILOL</div>
        <div style="font-size: 48pt; font-weight: bold; color: #003366;">LOGICA</div>
        <div style="font-size: 48pt; font-weight: bold; color: #003366;">RHETOR</div>
        <div style="font-size: 48pt; font-weight: bold; color: #003366;">MATHEM</div>
        <div style="font-size: 48pt; font-weight: bold; color: #003366;">ETHICA</div>
        <div style="font-size: 48pt; font-weight: bold; color: #003366;">PHYSICA</div>
    </div>
    <h1 class="header-title" style="text-align: center; margin-top: 50px;">Help with Onboarding Forms For New Employees</h1>
    <h2 style="text-align: center; font-size: 16pt; margin-top: 10px;">Human Resources</h2>
    <div style="text-align: center; margin-top: 80px;">
        <img src="placeholder_logo.png" alt="University of Delaware Logo" style="height: 50px;">
    </div>
</div>

<div class="page">
    <h1 style="text-align: center; font-size: 36pt;">Onboarding Forms Menu</h1>
    <div style="margin-top: 40px;">
        {% for item in menu_items %}
        <div class="menu-item">
            <span>{{ loop.index }}</span>
            <div class="menu-item-text">
                <span data-field="menu_item_title_{{ loop.index0 }}">{{ item.title }}</span>
                <div class="note">{{ item.description }}</div>
            </div>
        </div>
        {% endfor %}
    </div>
    <div style="margin-top: 50px; text-align: right;">
        <div style="border: 1px solid #ccc; padding: 10px; background-color: #f9f9f9;">
            <p style="font-weight: bold;">This form is optional.</p>
            <p>Email with a link to the I-9 after you clear the Criminal Background Check.</p>
        </div>
    </div>
</div>

<div class="page">
    <h1 style="text-align: center; font-size: 36pt;">UD Bio</h1>
    <div style="margin-top: 30px;">
        <p>Provide your personal information, so we can match you with any prior records in our systems and assign your UD ID.</p>
        <p class="note">Your UD ID is a unique 5-9 digit number that identifies you, whether you're a student, employee, UD alumnus or alumna, or former UD student. Every employee and student is assigned a UD ID. If you have questions, contact Human Resources at {{ hr_contact_info }}.</p>
    </div>

    <div style="margin-top: 40px;">
        <div class="form-group">
            <label>Full name:</label>
            <div style="display: flex; gap: 10px;">
                <div style="flex: 1;">
                    <label>First name:</label>
                    <input type="text" value="{{ full_name.first_name }}">
                </div>
                <div style="flex: 1;">
                    <label>Middle name:</label>
                    <input type="text" value="{{ full_name.middle_name }}">
                </div>
                <div style="flex: 1;">
                    <label>Last name:</label>
                    <input type="text" value="{{ full_name.last_name }}">
                </div>
            </div>
        </div>

        <div class="form-group">
            <label>Suffix:</label>
            <select>
                <option>Choose suffix</option>
                {% for suffix in available_suffixes %}
                    <option>{{ suffix }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group">
            <label>Have you ever had a name change?</label>
            <label style="display: inline-block; margin-right: 20px;"><input type="radio" name="name_change" checked> No</label>
            <label style="display: inline-block;"><input type="radio" name="name_change"> Yes</label>
        </div>

        <div class="form-group">
            <label>Identifying information</label>
            <p class="note">We understand how important your personal information, including social security number, is to you. We request your social security number on our application for a variety of identity purposes including need-based financial aid and required government reporting and assure you that we will maintain it with the utmost confidentiality and security. It will no longer be used as a student identifier on any UD material.</p>
        </div>

        <div class="form-group">
            <label>Social Security Number (SSN):</label>
            <input type="text" value="{{ ssn }}">
        </div>

        <div class="form-group">
            <label>Date of birth:</label>
            <input type="date" value="{{ dob }}">
        </div>

        <div style="text-align: center; margin-top: 30px;">
            <button class="button">Submit form</button>
        </div>
    </div>
</div>

<div class="page">
    <h1 style="text-align: center; font-size: 36pt;">My UD Settings</h1>
    <div style="margin-top: 30px;">
        <div style="border: 1px solid #ccc; padding: 15px; background-color: #e9ecef;">
            <h3 style="margin-top: 0;">MY UD SETTINGS</h3>
            <p>Account creation: <span data-field="account_creation_name">{{ account_creation_name }}</span> (<span data-field="account_creation_id">{{ account_creation_id }}</span>)</p>
            <p>Step <span data-field="step_number">{{ step_number }}</span> of <span data-field="total_steps">{{ total_steps }}</span></p>
            <p class="note">If you have questions, contact Human Resources at {{ hr_contact_info }}.</p>
        </div>

        <div style="margin-top: 30px;">
            <p>UDelNet ID is your username. You will use it with your password to log in to University of Delaware secure online services.</p>
            <p>Your UDelNet ID is also the first half of your University of Delaware email address. All official University correspondence is sent to your UD email address.</p>
        </div>

        <div class="form-group" style="margin-top: 30px;">
            <label>Choose a UDelNet ID:</label>
            <div style="display: flex; gap: 10px;">
                <input type="text" placeholder="e.g., {{ username_example }}" style="flex: 2;" data-field="choose_a_udelnet_id" value="{{ choose_a_udelnet_id }}">
                <span style="font-size: 1.2em;">@</span>
                <input type="text" value="{{ domain_name }}" style="flex: 1;">
            </div>
            <p class="error-message">3-8 lowercase letters (no spaces, numbers, or punctuation marks)</p>
        </div>

        <div style="text-align: center; margin-top: 40px;">
            <button class="button">Next step &rarr;</button>
        </div>
    </div>
</div>

<div class="page">
    <h1 style="text-align: center; font-size: 36pt;">Employee Demographic Data (EDD)</h1>
    <h2 style="text-align: center; font-size: 20pt; margin-top: 10px;">US Citizen/Permanent Resident</h2>

    <div class="two-column" style="margin-top: 30px;">
        <div>
            <div class="form-group">
                <label>Are you a US Citizen or Permanent Resident?</label>
                <label style="display: inline-block; margin-right: 20px;"><input type="radio" name="citizenship" checked> Yes</label>
                <label style="display: inline-block;"><input type="radio" name="citizenship"> No</label>
            </div>
            <p class="note">Enter your permanent address</p>

            <div class="form-group" style="margin-top: 20px;">
                <label>Addresses</label>
                <p class="note">Do not abbreviate address names</p>
                <p class="note">Spell out names like "Street, Road, North, Second", etc.</p>
            </div>

            <div class="form-group" style="margin-top: 20px;">
                <label>Permanent address (or home country address for international employees):</label>
                <div style="display: flex; gap: 10px;">
                    <div style="flex: 1;">
                        <label>Country</label>
                        <select><option>{{ country_us }}</option></select>
                    </div>
                    <div style="flex: 2;">
                        <label>Address line 1</label>
                        <input type="text" value="{{ address_line_1 }}">
                    </div>
                    <div style="flex: 2;">
                        <label>Address line 2</label>
                        <input type="text" value="{{ address_line_2 }}">
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label>City</label>
                <input type="text" value="{{ city }}">
            </div>
            <div class="form-group">
                <label>State or province</label>
                <select><option>{{ state_province }}</option></select>
            </div>
            <div class="form-group">
                <label>ZIP or postal code (required for USA only)</label>
                <input type="text" value="{{ zip_code }}">
            </div>
        </div>

        <div>
            <div class="form-group">
                <label>Addresses</label>
                <p class="note">Do not abbreviate address names</p>
                <p class="note">Spell out names like "Street, Road, North, Second", etc.</p>
            </div>
            <div class="form-group" style="margin-top: 20px;">
                <label>Are you a US Citizen or Permanent Resident?</label>
                <label style="display: inline-block; margin-right: 20px;"><input type="radio" name="citizenship" checked> Yes</label>
                <label style="display: inline-block;"><input type="radio" name="citizenship"> No</label>
            </div>
            <p class="note">Enter your permanent home country address</p>

            <div class="form-group" style="margin-top: 20px;">
                <label>Country</label>
                <select><option>{{ country_non_us }}</option></select>
            </div>
            <div class="form-group">
                <label>Address line 1</label>
                <input type="text" value="{{ address_line_1_non_us }}">
            </div>
            <div class="form-group">
                <label>Address line 2</label>
                <input type="text" value="{{ address_line_2_non_us }}">
            </div>
            <div class="form-group">
                <label>City</label>
                <input type="text" value="{{ city_non_us }}">
            </div>
            <div class="form-group">
                <label>State or province</label>
                <input type="text" value="{{ state_province_non_us }}">
            </div>
            <div class="form-group">
                <label>ZIP or postal code (required for USA only)</label>
                <input type="text" value="{{ zip_code_non_us }}">
            </div>
        </div>
    </div>
</div>

<div class="page">
    <h1 style="text-align: center; font-size: 36pt;">EDD – Contact Information</h1>
    <div style="margin-top: 30px;">
        <div style="border: 1px solid #ccc; padding: 20px; background-color: #f9f9f9;">
            <h3 style="margin-top: 0;">Contact information</h3>

            <div class="form-group">
                <label>Home phone:</label>
                <input type="text" value="{{ home_phone }}">
                <p class="note">(US use format nnn-nnn-nnnn)</p>
            </div>

            <div class="form-group">
                <label>Cell phone:</label>
                <input type="text" value="{{ cell_phone }}">
                <p class="note">(US use format nnn-nnn-nnnn)</p>
            </div>

            <div class="form-group" style="margin-top: 20px;">
                <label>Campus phone:</label>
                <input type="text" value="{{ campus_phone }}">
                <p class="note">This number will be used for directory purposes. Please provide a work number even if it is not considered a campus phone.</p>
            </div>

            <div class="form-group" style="margin-top: 20px;">
                <label>UD Directory Listing:</label>
                <select>
                    <option>Choose one</option>
                    {% for listing in directory_listings %}
                        <option>{{ listing }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="form-group" style="margin-top: 20px;">
                <label>Emergency contact name:</label>
                <div style="display: flex; gap: 10px;">
                    <input type="text" placeholder="Last Name" value="{{ emergency_contact_last_name }}">
                    <input type="text" placeholder="First Name" value="{{ emergency_contact_first_name }}">
                </div>
                <p class="note">(use format Last Name, First Name)</p>
            </div>

            <div class="form-group" style="margin-top: 20px;">
                <label>Emergency contact phone(s):</label>
                <div style="display: flex; gap: 10px;">
                    <input type="text" placeholder="Phone Number" value="{{ emergency_contact_phone_1 }}">
                    <select>
                        <option>Choose one</option>
                        {% for relationship in available_relationships %}
                            <option>{{ relationship }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <div class="form-group" style="margin-top: 20px;">
                <label>Relationship:</label>
                <select>
                    <option>Choose one</option>
                    {% for relationship in available_relationships %}
                        <option>{{ relationship }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>
    </div>
</div>

<div class="page">
    <h1 style="text-align: center; font-size: 36pt;">EDD – Education</h1>
    <div style="margin-top: 30px;">
        <p>Education</p>
        <p class="note">This section is required</p>
        <p class="note">Highest education level:</p>
        <div style="display: flex; gap: 20px; margin-bottom: 20px;">
            <div style="flex: 1;">
                <label>School type:</label>
                <select>
                    <option>Undergrad (UNG)</option>
                    {% for school_type in available_school_types %}
                        <option>{{ school_type }}</option>
                    {% endfor %}
                </select>
            </div>
            <div style="flex: 1;">
                <label>Highest education level:</label>
                <select>
                    <option>G-Bachelor's Level Degree</option>
                    {% for level in education_levels %}
                        <option>{{ level }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>

        <p class="note">Provide your earned degrees below (if applicable). If exact degree and/or major is not found, choose a degree and/or major that is similar to actual degree or major. Use the lookup to find an institution. To change an existing degree, delete the incorrect line and add a new one.</p>

        <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
            <thead>
                <tr style="border-bottom: 1px solid #000;">
                    <th style="padding: 10px; text-align: left; width: 20%;">Degree</th>
                    <th style="padding: 10px; text-align: left; width: 20%;">Major</th>
                    <th style="padding: 10px; text-align: left; width: 30%;">Institution</th>
                    <th style="padding: 10px; text-align: left; width: 15%;">Date acquired</th>
                    <th style="padding: 10px; text-align: left; width: 15%;">Action</th>
                </tr>
            </thead>
            <tbody>
                {% for degree_entry in education_history %}
                <tr style="border-bottom: 1px solid #ccc;">
                    <td style="padding: 10px;"><select><option>{{ degree_entry.degree }}</option></select></td>
                    <td style="padding: 10px;"><select><option>{{ degree_entry.major }}</option></select></td>
                    <td style="padding: 10px;"><input type="text" value="{{ degree_entry.institution }}"></td>
                    <td style="padding: 10px;"><input type="date" value="{{ degree_entry.date_acquired }}"></td>
                    <td style="padding: 10px;"><button class="button" style="padding: 5px 10px;">Lookup</button></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>

        <p class="note" style="margin-top: 30px;">Degree, Major, Institution, Date acquired</p>
        <p class="note">If you have no degrees above high school, skip this section, it is optional.</p>
    </div>
</div>


