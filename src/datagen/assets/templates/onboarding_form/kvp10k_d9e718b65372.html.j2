<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
    <div style="font-size: 24pt; font-weight: bold;">3</div>
    <div style="font-size: 24pt; font-weight: bold;">EDD – Education – Entering Degrees</div>
  </div>

  <div style="display: flex; gap: 50px;">
    <div style="flex: 1;">
      <div class="instruction-box">
        <h3 style="margin-top: 0;">Entering Degrees (optional):</h3>
        <ul>
          <li>Degree – if your specific degree is not in the list, choose the closest equivalent</li>
          <li>Major – if your exact major is not in the list, choose one that is closest to your major</li>
          <li>Institution code – use the lookup to find your institution</li>
          <li>Date acquired – if you don't have the exact date, enter your best estimate</li>
        </ul>
      </div>
    </div>

    <div style="flex: 1;">
      <div class="sub-header">Find Institution</div>
      <div class="form-group">
        <div class="form-row">
          <span class="form-field-label">Country:</span>
          <select class="input-field">
            <option>{{ country_options[0] }}</option>
            <!-- More options would be dynamically generated -->
          </select>
        </div>
      </div>
      <div class="form-group">
        <div class="form-row">
          <span class="form-field-label">State:</span>
          <select class="input-field">
