<!DOCTYPE html>
<html>
<head>
<title>Synthetic Data Generation</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  td, th {
    border: 1px solid #000;
    padding: 8px;
    text-align: left;
  }
  .header-title {
    text-align: center;
    font-weight: bold;
    margin-bottom: 20px;
  }
  .section-header {
    font-weight: bold;
    margin-top: 15px;
    margin-bottom: 10px;
  }
</style>
</head>
<body>

<div class="page">
  <div style="text-align: right; font-size: 12px;">
    <span data-field="organization.name">{{ organization.name }}</span>
  </div>
  <div style="text-align: left; font-size: 12px;">
    <span data-field="organization.department">{{ organization.department }}</span>
  </div>
  <div style="text-align: right; font-size: 12px;">
    <span data-field="organization.logo_text">{{ organization.logo_text }}</span>
  </div>
  <div style="text-align: center; margin: 20px 0;">
    <h1 style="font-size: 24px;">COVID-19 Vaccine Registration Proforma (CV-Form 01)</h1>
  </div>

  <table>
    <tr>
      <td style="width: 20%;">Serial Number</td>
      <td><span data-field="serial_number">{{ serial_number }}</span></td>
    </tr>
    <tr>
      <td>Vaccine Site Name</td>
      <td><span data-field="vaccine_site_name">{{ vaccine_site_name }}</span></td>
    </tr>
    <tr>
      <td>NIMS Registration #</td>
      <td><span data-field="nims_registration_number">{{ nims_registration_number }}</span></td>
    </tr>
    <tr>
      <td>Dated</td>
      <td><span data-field="date">{{ date }}</span></td>
    </tr>
    <tr>
      <td>Shift</td>
      <td>
        <span data-field="shift_morning">{{ shift_morning }}</span>
        <span data-field="shift_evening">{{ shift_evening }}</span>
        <span data-field="shift_night">{{ shift_night }}</span>
      </td>
    </tr>
    <tr>
      <td>Name:</td>
      <td><span data-field="full_name">{{ full_name }}</span></td>
    </tr>
    <tr>
      <td>Age</td>
      <td><span data-field="age">{{ age }}</span></td>
    </tr>
    <tr>
      <td>Gender</td>
      <td><span data-field="gender">{{ gender }}</span></td>
    </tr>
    <tr>
      <td>Contact #</td>
      <td><span data-field="contact_number">{{ contact_number }}</span></td>
    </tr>
    <tr>
      <td>NIC #</td>
      <td><span data-field="nic_number">{{ nic_number }}</span></td>
    </tr>
    <tr>
      <td>Address with Town/Taluka:</td>
      <td><span data-field="address">{{ address }}</span></td>
    </tr>
    <tr>
      <td>District of residence</td>
      <td><span data-field="district_of_residence">{{ district_of_residence }}</span></td>
    </tr>
    <tr>
      <td>Current Place of Posting (Including District)</td>
      <td><span data-field="current_place_of_posting">{{ current_place_of_posting }}</span></td>
    </tr>
    <tr>
      <td>Sector</td>
      <td><span data-field="sector">{{ sector }}</span></td>
    </tr>
    <tr>
      <td>Designation</td>
      <td><span data-field="designation">{{ designation }}</span></td>
    </tr>
  </table>

  <table>
    <thead>
      <tr>
        <th style="width: 25%;">HCW category</th>
        <th style="width: 15%;">Medics</th>
        <th style="width: 15%;">Nurse</th>
        <th style="width: 15%;">Paramedics</th>
        <th style="width: 15%;">Supportive</th>
        <th style="width: 15%;">Janitorial</th>
        <th style="width: 15%;">Other (Mention it)</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Extent of COVID – 19 Involvement</td>
        <td>Front Line</td>
        <td>Second Line</td>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
      <tr>
        <td>H/of COVID-19 Infection</td>
        <td><span data-field="h_of_covid_19_infection_yes">{{ h_of_covid_19_infection_yes }}</span></td>
        <td><span data-field="h_of_covid_19_infection_no">{{ h_of_covid_19_infection_no }}</span></td>
        <td><span data-field="h_of_covid_19_infection_dont_know">{{ h_of_covid_19_infection_dont_know }}</span></td>
      </tr>
      <tr>
        <td>If Yes Please provide details</td>
        <td>Date OR Month of Diagnosis</td>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
      <tr>
        <td>History of Hospitalization</td>
        <td><span data-field="history_of_hospitalization_yes">{{ history_of_hospitalization_yes }}</span></td>
        <td><span data-field="history_of_hospitalization_no">{{ history_of_hospitalization_no }}</span></td>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
    </tbody>
  </table>

  <p style="margin-top: 40px;">I hereby declare that all the given information are accurate</p>
  <div style="margin-top: 80px;">
    Signature
  </div>
</div>

<div class="page">
  <div style="text-align: right; font-size: 12px;">
    <span data-field="organization.name">{{ organization.name }}</span>
  </div>
  <div style="text-align: left; font-size: 12px;">
    <span data-field="organization.department">{{ organization.department }}</span>
  </div>
  <div style="text-align: right; font-size: 12px;">
    <span data-field="organization.logo_text">{{ organization.logo_text }}</span>
  </div>
  <div style="text-align: center; margin: 20px 0;">
    <h1 style="font-size: 24px;">Pre-Vaccination Evaluation Check List for COVID-19 Vaccines Recipients (CV Form 2)</h1>
  </div>

  <table>
    <thead>
      <tr>
        <th style="width: 20%;">NIC #</th>
        <th style="width: 20%;">Verification Code</th>
        <th style="width: 20%;">Town/Taluka</th>
        <th style="width: 20%;">District/Division</th>
        <th style="width: 20%;"></th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
    </tbody>
  </table>

  <div style="display: flex; justify-content: space-between; margin-top: 30px;">
    <div style="width: 45%;">
      <div class="section-header">Personal Profile</div>
      <table>
        <tr>
          <td>Full Name</td>
          <td><span data-field="full_name_cv2">{{ full_name_cv2 }}</span></td>
        </tr>
        <tr>
          <td>Age</td>
          <td><span data-field="age_cv2">{{ age_cv2 }}</span></td>
        </tr>
        <tr>
          <td>Gender</td>
          <td><span data-field="gender_cv2">{{ gender_cv2 }}</span></td>
        </tr>
        <tr>
          <td>Designation</td>
          <td><span data-field="designation_cv2">{{ designation_cv2 }}</span></td>
        </tr>
        <tr>
          <td>Contact #</td>
          <td><span data-field="contact_number_cv2">{{ contact_number_cv2 }}</span></td>
        </tr>
        <tr>
          <td>Place of Posting</td>
          <td><span data-field="place_of_posting_cv2">{{ place_of_posting_cv2 }}</span></td>
        </tr>
        <tr>
          <td>Assigned Person Name</td>
          <td><span data-field="assigned_person_name_cv2">{{ assigned_person_name_cv2 }}</span></td>
        </tr>
        <tr>
          <td>Signature</td>
          <td></td>
        </tr>
      </table>
    </div>
    <div style="width: 45%;">
      <div class="section-header">Vitals Recording</div>
      <table>
        <tr>
          <td>Temperature</td>
          <td><span data-field="temperature_cv2">{{ temperature_cv2 }}</span></td>
        </tr>
        <tr>
          <td>Pulse</td>
          <td><span data-field="pulse_cv2">{{ pulse_cv2 }}</span></td>
        </tr>
        <tr>
          <td>Blood Pressure</td>
          <td><span data-field="blood_pressure_cv2">{{ blood_pressure_cv2 }}</span></td>
        </tr>
        <tr>
          <td>Respiratory Rate</td>
          <td><span data-field="respiratory_rate_cv2">{{ respiratory_rate_cv2 }}</span></td>
        </tr>
        <tr>
          <td>Others</td>
          <td><span data-field="others_cv2">{{ others_cv2 }}</span></td>
        </tr>
        <tr>
          <td>Others</td>
          <td><span data-field="others_cv2_2">{{ others_cv2_2 }}</span></td>
        </tr>
        <tr>
          <td>Assigned Person Name</td>
          <td><span data-field="assigned_person_name_cv2_2">{{ assigned_person_name_cv2_2 }}</span></td>
        </tr>
        <tr>
          <td>Signature</td>
          <td></td>
        </tr>
      </table>
    </div>
  </div>

  <div class="section-header">Check List of Medical History</div>
  <table>
    <thead>
      <tr>
        <th style="width: 5%;">S No</th>
        <th style="width: 60%;">Question</th>
        <th style="width: 15%;">Yes</th>
        <th style="width: 15%;">No</th>
        <th style="width: 5%;">Don't Know</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>1</td>
        <td>Are you feeling sick today</td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
      <tr>
        <td>2</td>
        <td>Have you been ever vaccinated for COVID-19</td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
      <tr>
        <td>3</td>
        <td>Have you received any vaccine in last 10-14 days</td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
      <tr>
        <td>4</td>
        <td>Have you any allergy with any food product</td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
      <tr>
        <td>5</td>
        <td>Have you any allergy with any medical product</td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
      <tr>
        <td>6</td>
        <td>Have you any known disease currently</td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
      <tr>
        <td>7</td>
        <td>Have you ever positive tested for COVID-19</td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
      <tr>
        <td>8</td>
        <td>Have you received passive antibody therapy as treatment for COVID-19</td>
        <td></td>
        <td></td>
        <td></td>
      </tr>
    </tbody>
  </table>

  <div class="section-header">History of Any Chronic Illness</div>
  <table>
    <tr>
      <td style="width: 5%;">9</td>
      <td style="width: 95%;">Have you any known disease previously (If Yes tick below diseases)</td>
    </tr>
    <tr>
      <td style="width: 100%;">
        <span data-field="chronic_illness_cardiovascular">{{ chronic_illness_cardiovascular }}</span>
        <span data-field="chronic_illness_diabetes">{{ chronic_illness_diabetes }}</span>
        <span data-field="chronic_illness_hepatitis">{{ chronic_illness_hepatitis }}</span>
        <span data-field="chronic_illness_leukemia">{{ chronic_illness_leukemia }}</span>
        <span data-field="chronic_illness_cancer">{{ chronic_illness_cancer }}</span>
        <span data-field="chronic_illness_hiv">{{ chronic_illness_hiv }}</span>
        <span data-field="chronic_illness_other">{{ chronic_illness_other }}</span>
      </td>
    </tr>
  </table>

  <div class="section-header">History of Any Medication</div>
  <table>
    <tr>
      <td style="width: 5%;">10</td>
      <td style="width: 95%;">Are you on medication for any disease (If Yes Please ask and write)</td>
    </tr>
    <tr>
      <td style="width: 100%;">
        Name of Medicine: <span data-field="medication_name">{{ medication_name }}</span>
      </td>
    </tr>
  </table>

  <div class="section-header">History of any Therapy</div>
  <table>
    <tr>
      <td style="width: 5%;">11</td>
      <td style="width: 95%;">Have you any history of Surgery or organ transplantation</td>
    </tr>
    <tr>
      <td style="width: 100%;">
        Name of Surgery or Transplantation: <span data-field="surgery_transplant_name">{{ surgery_transplant_name }}</span>
      </td>
    </tr>
    <tr>
      <td style="width: 5%;">12</td>
      <td style="width: 95%;">Have you received any transfusion of blood or Blood Product in last 4 months</td>
    </tr>
  </table>

  <div class="section-header">Only For Female Recipients</div>
  <table>
    <tr>
      <td style="width: 5%;">13</td>
      <td style="width: 95%;">Are you pregnant currently (for child bearing age female group)</td>
    </tr>
    <tr>
      <td style="width: 5%;">14</td>
      <td style="width: 95%;">Are you currently breast feeding to any child/children</td>
    </tr>
  </table>

  <div class="section-header">Remarks</div>
  <div style="border: 1px solid #000; height: 100px; margin-bottom: 50px;"></div>

  <div style="display: flex; justify-content: flex-end;">
    <div style="width: 50%;">
      Signature:
    </div>
  </div>
</div>

</body>
</html>