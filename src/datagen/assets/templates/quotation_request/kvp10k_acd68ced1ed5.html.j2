  .form-row > div { flex: 1; padding-right: 20px; }
  .label { font-weight: normal; display: inline-block; width: 150px; }
  .input-field { border-bottom: 1px solid #000; min-width: 200px; }
  .table-container { width: 100%; border-collapse: collapse; margin-top: 15px; }
  .table-container th, .table-container td { border: 1px solid #000; padding: 8px; text-align: left; }
  .table-container th { background-color: #f0f0f0; }
  .declaration-box { margin-top: 40px; padding: 20px; border: 1px solid #000; }
  .signature-line { margin-top: 80px; border-top: 1px solid #000; width: 50%; }
</style>

<div class="page">
  <div class="header-info">
    <!-- Placeholder for Logo/Seal -->
    <div style="float: left; margin-right: 20px;">[Logo Placeholder]</div>
    <div>
      <h1>NATIONAL INSTITUTE OF TECHNOLOGY</h1>
      <p>TIRUCHIRAPPALLI - {{ institution_pin }}</p>
    </div>
  </div>

  <div style="text-align: right; margin-bottom: 20px;">
    <h2>Annexure – IV</h2>
  </div>

  <h2 style="text-align: center;">MANDATE FORM FOR ELECTRONIC FUND TRANSFER/RTGS TRANSFER</h2>

  <div class="form-row">
    <div>
      <span class="label">To</span>
      <div class="input-field" style="border: none;">The Director, National Institute of Technology, Tiruchirappalli – {{ city_name }} {{ state_name }}</div>
    </div>
    <div style="text-align: right;">
      <span class="label">Date:</span>
      <div class="input-field" style="width: 150px;">{{ date_field }}</div>
    </div>
  </div>

  <div class="form-row">
    <div>
      <span class="label">Sub :</span>
      <div class="input-field" style="width: 60%;">Authorization for release of payment / dues from National Institute of Technology, Tiruchirappalli through Electronic Fund Transfer/RTGS Transfer.</div>
    </div>
  </div>

  <div class="section-title">Details of the Party</div>
  <div class="form-row">
    <div>
      <span class="label">1. Name of the Party / Firm / Company / Institute :</span>
      <div class="input-field" style="width: 70%;">{{ party_name }}</div>
    </div>
  </div>

  <div class="form-row">
    <div>
      <span class="label">2. Address of the Party :</span>
      <div class="input-field" style="width: 70%;">{{ party_address }}</div>
    </div>
  </div>

  <div class="form-row">
    <div>
      <span class="label">3. City :</span>
      <div class="input-field" style="width: 30%;">{{ party_city }}</div>
      <span class="label" style="margin-left: 30px;">Pin Code :</span>
      <div class="input-field" style="width: 30%;">{{ party_pin_code }}</div>
    </div>
  </div>

  <div class="form-row">
    <div>
      <span class="label">4. E-Mail :</span>
      <div class="input-field" style="width: 70%;">{{ party_email }}</div>
    </div>
  </div>

  <div class="form-row">
    <div>
      <span class="label">5. Permanent Account Number :</span>
      <div class="input-field" style="width: 70%;">{{ pan_number }}</div>
    </div>
  </div>

  <div class="form-row">
    <div>
      <span class="label">6. Particulars of Bank:</span>
      <div style="display: flex; justify-content: space-between; width: 100%;">
        <div style="width: 48%;">
          <span class="label">Bank Name:</span>
          <div class="input-field" style="width: 100%;">{{ bank_name }}</div>
          <span class="label" style="margin-top: 10px;">PIN Code:</span>
          <div class="input-field" style="width: 100%;">{{ bank_pin_code }}</div>
          <span class="label" style="margin-top: 10px;">IFS Code:(11 digit alpha numeric code)</span>
          <div class="input-field" style="width: 100%;">{{ bank_ifsc_code }}</div>
        </div>
        <div style="width: 48%;">
          <span class="label">Branch Name:</span>
          <div class="input-field" style="width: 100%;">{{ branch_name }}</div>
          <span class="label" style="margin-top: 10px;">Branch Code:</span>
          <div class="input-field" style="width: 100%;">{{ branch_code }}</div>
        </div>
      </div>
    </div>
  </div>

  <div class="table-container">
    <table>
      <thead>
        <tr>
          <th style="width: 25%;">Account Type</th>
          <th style="width: 25%;">Savings</th>
          <th style="width: 25%;">Current</th>
          <th style="width: 25%;">Cash Credit</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Account Number:</td>
          <td colspan="3" class="input-field" style="border: none; border-bottom: 1px solid #000;">{{ account_number }}</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="declaration-box">
    <p>I hereby declare that the particulars given above are correct and complete. If any transaction delayed and not effected for reasons of incomplete or incorrect information I shall not hold Director, National Institute of Technology Tiruchirappalli responsible. I also undertake to advise any change in the particulars of my account to facilitate updating of records for purpose of credit of amount through NEFT/RTGS Transfer.</p>
    <div class="form-row" style="margin-top: 30px;">
      <div>
        <span class="label">Place:</span>
        <div class="input-field" style="width: 30%;">{{ place_of_signing }}</div>
      </div>
      <div style="text-align: right;">
        <span class="label">Date:</span>
        <div class="input-field" style="width: 30%;">{{ date_of_signing }}</div>
      </div>
    </div>
  </div>

  <div style="text-align: center; margin-top: 100px;">
    <div class="signature-line"></div>
    <p style="margin-top: 10px;">Signature & Seal of the Authorized Signatory of the Party</p>
  </div>
</div></body>
</html>