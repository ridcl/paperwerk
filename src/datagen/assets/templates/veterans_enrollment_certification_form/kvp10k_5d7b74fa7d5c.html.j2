<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1, h2, h3 { text-align: center; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 15px; }
  .label-group { display: flex; align-items: center; margin-bottom: 10px; }
  .checkbox-group label { margin-right: 15px; }
</style>

<div class="page">
    <div>
        <h1 style="text-align: center;">Widener University Commonwealth Law School</h1>
        <h2 style="text-align: center;">Registrar's Office</h2>
        <h3 style="text-align: center;">2021-2022</h3>
        <h3 style="text-align: center;">Veterans Enrollment Certification Form</h3>

        <div class="form-row">
            <div>
                Name: <span data-field="full_name">{{ full_name }}</span>
            </div>
            <div>
                Widener E-mail: <span data-field="widener_email">{{ widener_email }}</span> @widener.edu
            </div>
        </div>

        <div class="form-row">
            <div>
                Widener ID: <span data-field="widener_id">{{ widener_id }}</span>
            </div>
            <div>
                Alt E-mail: <span data-field="alt_email">{{ alt_email }}</span>
            </div>
        </div>

        <div class="form-row">
            <div>
                Year: 
                <span data-field="year_1">{{ year_1 }}</span><span data-field="year_2">{{ year_2 }}</span><span data-field="year_3">{{ year_3 }}</span><span data-field="year_4">{{ year_4 }}</span>
            </div>
            <div>
                Local Address: 
                <span data-field="local_address">{{ local_address }}</span>
            </div>
        </div>
        
        <div class="form-row">
            <div>
                1ED <span data-field="year_5">{{ year_5 }}</span>ED <span data-field="year_6">{{ year_6 }}</span>ED <span data-field="year_7">{{ year_7 }}</span>ED
            </div>
            <div>
                Cell Phone: <span data-field="cell_phone">{{ cell_phone }}</span>
            </div>
        </div>

        <h2 style="margin-top: 30px;">VA EDUCATION BENEFITS (Check one)</h2>
        
        <div class="checkbox-group">
            <label>
                <input type="checkbox"> Active Duty (Chapter 30) Montgomery GI Bill®
            </label>
            <label>
                <input type="checkbox"> Post-9/11 (Chapter 33) Montgomery GI Bill®
            </label>
            <label>
                <input type="checkbox"> Reservist or National Guard Unit (Chapter 1606)
            </label>
        </div>
        
        <p style="margin-top: 15px;">
            <span data-field="chapter_30_desc">{{ chapter_30_desc }}</span>
        </p>
        <p style="margin-top: 15px;">
            <span data-field="chapter_33_desc">{{ chapter_33_desc }}</span>
        </p>
        <p style="margin-top: 15px;">
            <span data-field="chapter_1606_desc">{{ chapter_1606_desc }}</span>
        </p>

        <div class="form-row" style="margin-top: 20px;">
            <div>
                <label>
                    <input type="checkbox"> Chapter 31 VR&E VA Education Benefits
                </label>
            </div>
            <div>
                <label>
                    <input type="radio" name="spouse_dependent"> Spouse
                </label>
                <label>
                    <input type="radio" name="spouse_dependent"> Dependent
                </label>
            </div>
        </div>

        <h2 style="margin-top: 30px;">ENROLLMENT</h2>
        <p>Please indicate the number of credits for which you want certification behind the semester(s):</p>

        <div class="form-row" style="margin-top: 15px;">
            <div>Fall 2021 credits: <span data-field="fall_2021_credits">{{ fall_2021_credits }}</span></div>
            <div>Spring 2022 credits: <span data-field="spring_2022_credits">{{ spring_2022_credits }}</span></div>
            <div>Summer 2022 credits: <span data-field="summer_2022_credits">{{ summer_2022_credits }}</span></div>
        </div>
        
        <p style="margin-top: 10px;">
            *ICW Fall 2021 credits
        </p>
        <p style="margin-top: 5px;">
            *ICW Spring 2022 credits
        </p>
        <p style="margin-top: 5px;">
            *Intensive Course Week (ICW)-classes held prior to the start of the regularly scheduled semester
        </p>

        <p style="margin-top: 30px;">I do not want certification for the following semester(s):</p>
        
        <div class="form-row" style="margin-top: 15px;">
            <div>Fall 2021: <span data-field="fall_2021_not_cert">{{ fall_2021_not_cert }}</span></div>
            <div>Spring 2022: <span data-field="spring_2022_not_cert">{{ spring_2022_not_cert }}</span></div>
            <div>Summer 2022: <span data-field="summer_2022_not_cert">{{ summer_2022_not_cert }}</span></div>
        </div>

        <p style="margin-top: 40px;">I certify that the above information is true and correct to the best of my knowledge.</p>

        <div class="form-row" style="margin-top: 50px;">
            <div>SIGNATURE: /s/ <span data-field="signature_date">{{ signature_date }}</span></div>
            <div>DATE: <span data-field="date_signed">{{ date_signed }}</span></div>
        </div>
        <p style="text-align: center; font-size: small; margin-top: 20px;">Please notify Registrar's Office if your enrollment plans change.</p>
    </div>
</div>