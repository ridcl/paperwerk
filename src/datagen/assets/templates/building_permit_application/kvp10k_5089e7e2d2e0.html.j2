<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  table { width: 100%; border-collapse: collapse; margin-top: 10px; margin-bottom: 10px; }
  td { padding: 5px 0; }
  .header { font-weight: bold; font-size: 1.2em; text-align: center; margin-bottom: 20px; }
  .section-title { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px;">
    <div>
      <img src="placeholder_logo.png" alt="FAU Logo" style="height: 80px;">
    </div>
    <div style="text-align: right;">
      <p style="margin: 0;">Office of Environmental Health and Safety</p>
      <p style="margin: 0;">Building Code Administration</p>
      <p style="margin: 0;">{{ address_line_1 }}</p>
      <p style="margin: 0;">{{ address_line_2 }}</p>
      <p style="margin: 0;">Phone: {{ phone_number }}</p>
      <p style="margin: 0;">Email: {{ email_address }}</p>
    </div>
  </div>

  <h1 class="header">BUILDING PERMIT APPLICATION</h1>
  <p style="text-align: center; margin-bottom: 30px;">To be submitted by the Project Contractor or Construction Manager</p>

  <div style="display: flex; justify-content: space-between;">
    <div style="width: 48%;">
      <p class="section-title">Applicant:</p>
      <p>Name: <span data-field="applicant.full_name">{{ applicant.full_name }}</span></p>
      <p>Street Address: <span data-field="applicant.street_address">{{ applicant.street_address }}</span></p>
      <p>Mailing Address: <span data-field="applicant.mailing_address">{{ applicant.mailing_address }}</span></p>
      <p>Phone Number: <span data-field="applicant.phone_number">{{ applicant.phone_number }}</span></p>
      <p>Contractor Type/License No.: <span data-field="applicant.contractor_license">{{ applicant.contractor_license }}</span></p>
      <p>Qualifying Agent's Names: <span data-field="applicant.qualifying_agent_names">{{ applicant.qualifying_agent_names }}</span></p>
    </div>
    <div style="width: 48%;">
      <p class="section-title">Signature & Dates:</p>
      <p>Qualifying Agent's Signature: _________________________</p>
      <p>Date: <span data-field="signature_date">{{ signature_date }}</span></p>
      <p>Email: <span data-field="agent_email">{{ agent_email }}</span></p>
      <p>Expiration Date: <span data-field="expiration_date">{{ expiration_date }}</span></p>
    </div>
  </div>

  <div style="margin-top: 30px;">
    <p class="section-title">Type of Work:</p>
    <p>New - Remodeling - Addition - Renovation - Repair - Alteration - Demo</p>
    <p>Project: <span data-field="project_name">{{ project_name }}</span></p>
    <p>Name: <span data-field="project_owner_name">{{ project_owner_name }}</span></p>
    <p>Location: <span data-field="project_location">{{ project_location }}</span></p>
    <p>$ Value/Description of Work: <span data-field="project_value_description">{{ project_value_description }}</span></p>
  </div>

  <table style="margin-top: 30px;">
    <thead>
      <tr>
        <th style="text-align: left; padding: 8px;">Occupancy Classification</th>
        <th style="text-align: left; padding: 8px;">Construction Type</th>
        <th style="text-align: left; padding: 8px;">Floor Area Gross Square Feet</th>
        <th style="text-align: left; padding: 8px;">Building Height (Feet)</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="occupancy_classification">{{ occupancy_classification }}</span></td>
        <td><span data-field="construction_type">{{ construction_type }}</span></td>
        <td><span data-field="floor_area_sqft">{{ floor_area_sqft }}</span></td>
        <td><span data-field="building_height_feet">{{ building_height_feet }}</span></td>
      </tr>
    </tbody>
  </table>

  <div style="margin-top: 30px;">
    <p class="section-title">Architect/Engineer:</p>
    <p>Name: <span data-field="architect_engineer.full_name">{{ architect_engineer.full_name }}</span></p>
    <p>Street Address: <span data-field="architect_engineer.street_address">{{ architect_engineer.street_address }}</span></p>
    <p>Mailing Address: <span data-field="architect_engineer.mailing_address">{{ architect_engineer.mailing_address }}</span></p>
    <p>Phone No.: <span data-field="architect_engineer.phone_number">{{ architect_engineer.phone_number }}</span></p>
    <p>A/E License No.: <span data-field="architect_engineer.license_number">{{ architect_engineer.license_number }}</span></p>
    <p>Email: <span data-field="architect_engineer.email">{{ architect_engineer.email }}</span></p>
    <p>Expiration Date: <span data-field="architect_engineer.expiration_date">{{ architect_engineer.expiration_date }}</span></p>
  </div>
</div>