<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic layout structure */
  h1, h2, h3 { font-family: Georgia, "Times New Roman", Times, serif; }
  .map-container { position: relative; width: 100%; height: 500px; }
  .map-grid { display: grid; grid-template-columns: repeat(13, 1fr); grid-template-rows: repeat(12, 1fr); width: 100%; height: 100%; }
  .map-cell { border: 1px solid #ccc; display: flex; align-items: center; justify-content: center; font-size: 10px; }
  .legend { margin-top: 20px; }
</style>

<div class="page">
  <h1 style="text-align: center; font-size: 24pt;">OLLI Fall 2022 Location Key:</h1>
  <h2 style="text-align: center; font-size: 18pt;">UNIVERSITY OF THE PACIFIC</h2>

  <!-- Map Area Simulation -->
  <div class="map-container">
    <div class="map-grid">
      <!-- Grid cells A-L and 1-13 -->
      {% for row_char in ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'I', 'J', 'K', 'L'] %}
        {% for col_num in range(1, 14) %}
          <div class="map-cell" style="grid-row: {{ loop.index0 + 1 }}; grid-column: {{ loop.index0 + 1 }};">
            {% if row_char == 'A' and col_num == 1 %}
              <span style="font-weight: bold;">1</span>
            {% elif row_char == 'A' and col_num == 13 %}
              <span style="font-weight: bold;">13</span>
            {% elif row_char == 'L' and col_num == 1 %}
              <span style="font-weight: bold;">A</span>
            {% elif row_char == 'L' and col_num == 13 %}
              <span style="font-weight: bold;">L</span>
            {% else %}
              <!-- Placeholder for map elements -->
            {% endif %}
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>

  <!-- Map Key/Legend Area (Simplified representation) -->
  <div style="display: flex; justify-content: space-between; margin-top: 30px;">
    <div style="width: 45%;">
      <h3 style="font-size: 14pt;">Map Legend</h3>
      <div style="display: flex; flex-direction: column; gap: 5px;">
        <div style="display: flex; align-items: center;"><span style="width: 15px; height: 15px; background-color: #ccc; margin-right: 10px;"></span><span data-field="legend_item_1">{{ legend_item_1 }}</span></div>
        <div style="display: flex; align-items: center;"><span style="width: 15px; height: 15px; background-color: #f0f0f0; margin-right: 10px;"></span><span data-field="legend_item_2">{{ legend_item_2 }}</span></div>
      </div>
    </div>
    <div style="width: 45%; text-align: right;">
      <h3 style="font-size: 14pt;">University Information</h3>
      <p>
        <span data-field="university_name">{{ university_name }}</span><br>
        <span data-field="address_line_1">{{ address_line_1 }}</span>
      </p>
      <div style="margin-top: 20px;">
        <span data-field="logo_placeholder">{{ logo_placeholder }}</span>
      </div>
    </div>
  </div>

  <!-- Team Section -->
  <div style="display: flex; justify-content: space-between; margin-top: 80px;">
    <div style="width: 45%;">
      <h2 style="font-size: 16pt;">MEET THE TEAM</h2>
      <p>
        <span data-field="team_member_1_name">{{ team_member_1_name }}</span><br>
        Program Director<br>
        Email: <span data-field="team_member_1_email">{{ team_member_1_email }}</span>
      </p>
      <p style="margin-top: 20px;">
        <span data-field="team_member_2_name">{{ team_member_2_name }}</span><br>
        Programming and Operations Coordinator<br>
        Email: <span data-field="team_member_2_email">{{ team_member_2_email }}</span>
      </p>
    </div>

    <!-- Office Location Section -->
    <div style="width: 45%; text-align: right;">
      <h2 style="font-size: 16pt;">OFFICE LOCATION</h2>
      <p>
        <span data-field="office_address_line_1">{{ office_address_line_1 }}</span>
      </p>

      <h3 style="font-size: 14pt; margin-top: 30px;">FOR MORE INFORMATION:</h3>
      <p>
        Website: <span data-field="website_url">{{ website_url }}</span><br>
        Email: <span data-field="contact_email">{{ contact_email }}</span><br>
        Phone: <span data-field="contact_phone">{{ contact_phone }}</span>
      </p>
    </div>
  </div>
</div>