<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1, h2 { font-weight: bold; }
  .header-logo { text-align: center; margin-bottom: 30px; }
  .content-section { margin-bottom: 30px; }
  .signature-block { margin-top: 50px; }
</style>

<div class="page">
  <div class="header-logo">
    <!-- Placeholder for logo image/text -->
    <span style="font-size: 40px;">UNA POLICE</span>
  </div>

  <div class="content-section">
    <h1>University of North Alabama Police Department</h1>
    <h2>Trespass Notice</h2>
  </div>

  <div class="content-section">
    <p>
      <span data-field="full_name">{{ full_name }}</span> has been trespassed from the University of North Alabama Campus and is not to be on the University Campus or participating in any University sponsored events. If you see <span data-field="full_name">{{ full_name }}</span> on campus please notify the University Police Department immediately at <span data-field="phone_number">{{ phone_number }}</span>, or Dial 911.
    </p>
    <p>
      Name: <span data-field="full_name">{{ full_name }}</span>
    </p>
    <p>
      Age: <span data-field="age">{{ age }}</span> Years
    </p>
  </div>

  <div class="content-section" style="display: flex; align-items: center; gap: 50px;">
    <!-- Image placeholder -->
    <div style="width: 200px; height: 250px; border: 1px solid #ccc; display: flex; justify-content: center; align-items: center;">
      <img src="placeholder_photo.jpg" alt="Subject Photo" style="max-width: 100%; max-height: 100%;">
    </div>

    <!-- Contact Information -->
    <div style="flex-grow: 1;">
      <p>
        UNIVERSITY POLICE DEPARTMENT<br>
        UNA Box <span data-field="mailing_box">{{ mailing_box }}</span>, #1 Harrison Plaza - Keller Hall Basement<br>
        <span data-field="city">{{ city }}</span>, <span data-field="state">{{ state }}</span> <span data-field="zip_code">{{ zip_code }}</span>
      </p>
      <p>
        Phone: <span data-field="phone_number">{{ phone_number }}</span>
      </p>
      <p>
        Website: <a href="http://<span data-field="website_domain">{{ website_domain }}</span>">{{ website_url }}</a>
      </p>
      <p>
        Email: <a href="mailto:<span data-field="email_address">{{ email_address }}</span>">{{ email_address }}</a>
      </p>
    </div>
  </div>
</div>