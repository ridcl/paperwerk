<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1 { font-size: 24pt; font-weight: bold; margin-bottom: 5px; }
  h2 { font-size: 14pt; font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
  .section-title { font-weight: bold; margin-top: 15px; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 15px; }
  .form-label { flex-basis: 30%; }
  .form-input { flex-basis: 65%; border-bottom: 1px solid #000; }
  .line-item-table { width: 100%; border-collapse: collapse; margin-top: 10px; }
  .line-item-table td { padding: 5px 0; border-bottom: 1px dotted #ccc; }
  .signature-line { margin-top: 40px; display: flex; justify-content: space-between; }
</style>

<div class="page">
  <div style="text-align: left;">
    <h1 style="font-size: 30pt; margin-bottom: 5px;">LSU</h1>
    <div style="font-size: 10pt;">
      Finance & Administrative Services<br>
      Property Management
    </div>
  </div>

  <h2 style="font-size: 14pt; margin-top: 30px;">REQUEST FOR OFF-CAMPUS/HOME STORAGE OF EQUIPMENT (PER BOP 4-2)</h2>

  <p style="font-size: 11pt; margin-top: 20px;">PLEASE PRINT OR TYPE INFORMATION-All Information Is Required</p>

  <div class="form-row">
    <div class="form-label">Department:</div>
    <div class="form-input"><span data-field="department">{{ department }}</span></div>
  </div>

  <div class="form-row">
    <div class="form-label">Account Number:</div>
    <div class="form-input"><span data-field="account_number">{{ account_number }}</span></div>
  </div>

  <div class="form-row">
    <div class="form-label">Date:</div>
    <div class="form-input"><span data-field="date">{{ date }}</span></div>
  </div>

  <div class="form-row">
    <div class="form-label">Purpose:</div>
    <div class="form-input"><span data-field="purpose">{{ purpose }}</span></div>
  </div>

  <div style="margin-top: 20px;">
    <p style="font-weight: bold;">Item Description</p>
    <p style="font-weight: bold;">LSU Inventory # & Serial #</p>
    <table class="line-item-table">
      {% for item in line_items %}
        <tr>
          <td><span data-field="line_items[{{ loop.index0 }}].description">{{ item.description }}</span></td>
          <td><span data-field="line_items[{{ loop.index0 }}].inventory_serial">{{ item.inventory_serial }}</span></td>
        </tr>
      {% endfor %}
    </table>
  </div>

  <div style="margin-top: 30px;">
    <p style="font-weight: bold;">Name of Person with Custody:</p>
    <div class="form-input" style="width: 100%; border-bottom: 1px solid #000;"><span data-field="custodian_name">{{ custodian_name }}</span></div>
  </div>

  <div style="margin-top: 15px;">
    <p style="font-weight: bold;">Signature of Person with Custody:</p>
    <div class="form-input" style="width: 100%; border-bottom: 1px solid #000;"><span data-field="custodian_signature_placeholder">{{ custodian_signature_placeholder }}</span></div>
  </div>

  <div style="margin-top: 15px;">
    <p style="font-weight: bold;">Position (Faculty, Staff or Student):</p>
    <div class="form-input" style="width: 100%; border-bottom: 1px solid #000;"><span data-field="custodian_position">{{ custodian_position }}</span></div>
  </div>

  <div style="margin-top: 15px;">
    <p style="font-weight: bold;">Residential Address:</p>
    <div class="form-input" style="width: 100%; border-bottom: 1px solid #000;"><span data-field="custodian_address">{{ custodian_address }}</span></div>
  </div>

  <div class="form-row" style="margin-top: 20px;">
    <div class="form-label">City:</div>
    <div class="form-input"><span data-field="custodian_city">{{ custodian_city }}</span></div>
  </div>

  <div class="form-row">
    <div class="form-label">State or Country:</div>
    <div class="form-input"><span data-field="custodian_state_country">{{ custodian_state_country }}</span></div>
  </div>

  <div class="form-row">
    <div class="form-label">Zip Code:</div>
    <div class="form-input"><span data-field="custodian_zip_code">{{ custodian_zip_code }}</span></div>
  </div>

  <div class="form-row" style="margin-top: 15px;">
    <div class="form-label">Electronic Mail Address:</div>
    <div class="form-input"><span data-field="custodian_email">{{ custodian_email }}</span></div>
  </div>

  <div class="form-row" style="margin-top: 15px;">
    <div class="form-label">Home or Cell Telephone Number:</div>
    <div class="form-input"><span data-field="custodian_phone">{{ custodian_phone }}</span></div>
  </div>

  <div class="form-row" style="margin-top: 15px;">
    <div class="form-label">Removal Date (MONTH/DATE/YEAR):</div>
    <div class="form-input"><span data-field="removal_date">{{ removal_date }}</span></div>
  </div>

  <div class="form-row" style="margin-top: 15px;">
    <div class="form-label">Return Date (MONTH/DATE/YEAR):</div>
    <div class="form-input"><span data-field="return_date">{{ return_date }}</span></div>
  </div>

  <div class="signature-line">
    <div>
      <p style="font-weight: bold;">Approval Signatures:</p>
      <p style="margin-top: 10px;">Dept. Property Custodian</p>
      <div class="form-input" style="width: 50%; border-bottom: 1px solid #000; margin-top: 50px;" data-field="dept_property_custodian">{{ dept_property_custodian }}</div>
      <div style="text-align: right;">Date</div>
    </div>
    <div>
      <p style="font-weight: bold;">Department Head /Chair</p>
      <div class="form-input" style="width: 50%; border-bottom: 1px solid #000; margin-top: 50px;" data-field="department_head_chair">{{ department_head_chair }}</div>
      <div style="text-align: right;">Date</div>
    </div>
  </div>

  <div style="margin-top: 30px;">
    <p style="font-weight: bold;">LSU Property Manager (or designee):</p>
    <div class="form-input" style="width: 50%; border-bottom: 1px solid #000; margin-top: 50px;" data-field="lsu_property_manager">{{ lsu_property_manager }}</div>
    <div style="text-align: right;">Date</div>
  </div>

  <div style="margin-top: 40px;">
    <p style="font-weight: bold;">Comments:</p>
    <div class="form-input" style="width: 100%; border-bottom: 1px solid #000; height: 60px; margin-top: 5px;"><span data-field="comments">{{ comments }}</span></div>
  </div>

  <div style="margin-top: 50px; font-size: 10pt; text-align: center;">
    3555 River Rd.-River Road Annex • Baton Rouge, LA • 70803 • P 225-578-6921 • Email: property@lsu.edu<br>
    http://www.fas.lsu.edu/purchasing/propmgmt.htm
  </div>
</div>