<!DOCTYPE html>
<html>
<head>
    <title>Request Form</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 { margin-top: 0; }
        .header-info { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px; }
        .logo-area { text-align: left; }
        .university-info { text-align: right; }
        .section-header { font-weight: bold; margin-top: 25px; margin-bottom: 15px; border-bottom: 1px solid #ccc; padding-bottom: 5px; }
        .form-row { display: flex; margin-bottom: 10px; }
        .form-row > div { flex: 1; padding-right: 20px; }
        .form-row .label { font-weight: normal; }
        .form-row .input-area { border-bottom: 1px solid #000; }
        .divider { border-top: 1px solid #000; margin: 30px 0; }
    </style>
</head>
<body>
    <div class="page">
        <div class="header-info">
            <div class="logo-area">
                <h1 style="font-size: 36px; margin: 0;">LSU</h1>
                <p style="font-size: 14px; margin: 0;">LOUISIANA STATE UNIVERSITY</p>
            </div>
            <div class="university-info">
                <p style="font-weight: bold;">Louisiana State University</p>
                <p>Office of Accounting Services</p>
                <p>Bursar Operations</p>
                <p>125 Thomas Boyd Hall</p>
            </div>
        </div>

        <h2 style="font-size: 18px; margin-bottom: 5px;">REQUEST FOR SALES AND SERVICES WORKDAY CUSTOMER NUMBER</h2>
        <p style="font-size: 14px; margin-bottom: 20px;">To request a Workday Customer Number, please complete this request and e-mail it to <span data-field="email_address">{{ email_address }}</span> or fax the request to 225-578-3969.</p>
        <p style="font-size: 14px; margin-bottom: 20px;">Once the customer is established, the requestor will be notified via e-mail. For any assistance with the established account, please contact Danielle Lavergene at <span data-field="contact_email">{{ contact_email }}</span>.</p>

        <div class="section-header">SECTION 1: REQUESTOR INFORMATION</div>
        <div style="border: 1px solid #000; padding: 15px;">
            <div class="form-row">
                <div style="flex: 1;">
                    <div class="label">Name</div>
                    <div class="input-area"><span data-field="full_name">{{ full_name }}</span></div>
                </div>
            </div>
            <div class="form-row">
                <div style="flex: 1;">
                    <div class="label">Department (if internal request)</div>
                    <div class="input-area"><span data-field="department">{{ department }}</span></div>
                </div>
                <div style="flex: 1;">
                    <div class="label">E-mail</div>
                    <div class="input-area"><span data-field="email_address_requestor">{{ email_address_requestor }}</span></div>
                </div>
            </div>
            <div class="form-row">
                <div style="flex: 1;">
                    <div class="label">Phone Number</div>
                    <div class="input-area"><span data-field="phone_number">{{ phone_number }}</span></div>
                </div>
                <div style="flex: 1;">
                    <div class="label">Fax Number</div>
                    <div class="input-area"><span data-field="fax_number">{{ fax_number }}</span></div>
                </div>
            </div>
            <div class="form-row">
                <div style="flex: 1;">
                    <div class="label">Reason Needed</div>
                    <div class="input-area"><span data-field="reason_needed">{{ reason_needed }}</span></div>
                </div>
            </div>
        </div>

        <div class="section-header">SECTION 2: ACCOUNT/CONTACT INFORMATION</div>
        <div style="border: 1px solid #000; padding: 15px;">
            <div class="form-row" style="margin-bottom: 20px;">
                <div style="flex: 1;">
                    <label>Student Organization</label>
                    <input type="checkbox" style="margin-right: 5px;"> Yes
                    <input type="checkbox" style="margin-right: 5px;"> No
                </div>
            </div>

            <div class="form-row">
                <div style="flex: 1;">
                    <div class="label">Company Name</div>
                    <div class="input-area"><span data-field="company_name">{{ company_name }}</span></div>
                </div>
                <div style="flex: 1;">
                    <div class="label">Phone Number</div>
                    <div class="input-area"><span data-field="company_phone">{{ company_phone }}</span></div>
                </div>
            </div>

            <div class="form-row">
                <div style="flex: 1;">
                    <div class="label">Billing Address</div>
                    <div class="input-area"><span data-field="billing_address">{{ billing_address }}</span></div>
                </div>
                <div style="flex: 1;">
                    <div class="label">Zip Code</div>
                    <div class="input-area"><span data-field="zip_code">{{ zip_code }}</span></div>
                </div>
            </div>

            <div class="form-row">
                <div style="flex: 1;">
                    <div class="label">City</div>
                    <div class="input-area"><span data-field="city">{{ city }}</span></div>
                </div>
                <div style="flex: 1;">
                    <div class="label">State</div>
                    <div class="input-area"><span data-field="state">{{ state }}</span></div>
                </div>
            </div>

            <div class="form-row" style="margin-top: 15px;">
                <div style="flex: 1;">
                    <label>Statement Delivery Preferred Method</label>
                    <input type="checkbox" style="margin-right: 5px;"> E-mail
                    <input type="checkbox" style="margin-right: 5px;"> Mail
                    <input type="checkbox" style="margin-right: 5px;"> Fax
                </div>
            </div>

            <div class="form-row">
                <div style="flex: 1;">
                    <div class="label">Contact Name</div>
                    <div class="input-area"><span data-field="contact_name">{{ contact_name }}</span></div>
                </div>
                <div style="flex: 1;">
                    <div class="label">Contact Phone Number</div>
                    <div class="input-area"><span data-field="contact_phone">{{ contact_phone }}</span></div>
                </div>
            </div>

            <div class="form-row">
                <div style="flex: 1;">
                    <div class="label">Contact E-mail</div>
                    <div class="input-area"><span data-field="contact_email_account">{{ contact_email_account }}</span></div>
                </div>
                <div style="flex: 1;">
                    <div class="label">Alternate E-mail (if needed)</div>
                    <div class="input-area"><span data-field="alternate_email">{{ alternate_email }}</span></div>
                </div>
            </div>

            <div class="form-row">
                <div style="flex: 1;">
                    <div class="label">Work Order # (Facilities Services Only)</div>
                    <div class="input-area"><span data-field="work_order_number">{{ work_order_number }}</span></div>
                </div>
            </div>
        </div>

        <div class="divider"></div>

        <p style="text-align: center; font-weight: bold; margin-bottom: 20px;">FOR ACCOUNTING SERVICES USE ONLY</p>

        <div class="form-row" style="margin-bottom: 30px;">
            <div style="flex: 1;">
                <div class="label">Customer Group</div>
                <div class="input-area"><span data-field="customer_group">{{ customer_group }}</span></div>
            </div>
            <div style="flex: 1;">
                <div class="label">Sales and Services – Control Account</div>
                <div class="input-area"><span data-field="control_account">{{ control_account }}</span></div>
            </div>
            <div style="flex: 1;">
                <div class="label">Sales and Services – Other</div>
                <div class="input-area"><span data-field="sales_other">{{ sales_other }}</span></div>
            </div>
        </div>

        <div class="form-row" style="margin-bottom: 30px;">
            <div style="flex: 1;">
                <div class="label">Workday Customer Number</div>
                <div class="input-area"><span data-field="workday_customer_number">{{ workday_customer_number }}</span></div>
            </div>
            <div style="flex: 1;">
                <div class="label">Approved by</div>
                <div class="input-area"><span data-field="approver_name">{{ approver_name }}</span></div>
            </div>
            <div style="flex: 1;">
                <div class="label">Date</div>
                <div class="input-area"><span data-field="approval_date">{{ approval_date }}</span></div>
            </div>
        </div>

        <p style="font-size: 12px; margin-top: 50px; text-align: center;">125 Thomas Boyd Hall • Baton Rouge, LA 70803 • P 225-578-3357 • F 225-578-3969 • <span data-field="website_url">{{ website_url }}</span></p>
    </div>
</body>
</html>