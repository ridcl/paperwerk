<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; }
  h1, h2, h3 { font-weight: bold; }
  table { width: 100%; border-collapse: collapse; margin-bottom: 15px; }
  td, th { padding: 5px 0; text-align: left; }
  .section-header { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px;">
    <div>
      <h1 style="font-size: 24pt; margin: 0;">SJSU</h1>
      <h2 style="font-size: 16pt; margin: 0;">FINANCE AND BUSINESS SERVICES</h2>
    </div>
    <div style="text-align: right;">
      <h2 style="font-size: 16pt; margin: 0;">Commercial Invoice</h2>
      <h3 style="font-size: 12pt; margin: 0;">Distribution & Asset Services</h3>
      <p style="font-size: 10pt; margin: 5px 0 0 0;">408-924-1558</p>
    </div>
  </div>

  <p style="font-size: 10pt; margin-bottom: 20px;">Finance – One Washington Square - San José, CA 95192-0008</p>

  <p style="font-size: 10pt; margin-bottom: 20px;">This form is required for all outgoing shipments outside the USA. Complete all sections and submit along with a completed Shipment Request form. Contact Distribution Services, at extension 4-1592, to request pick-up of completed forms, attachments (if any), and items to be shipped.</p>

  <div class="section-header">Required Information:</div>

  <table style="width: 100%;">
    <tr>
      <td style="width: 50%; padding-bottom: 10px;">Date of Exportation:</td>
      <td style="width: 50%; padding-bottom: 10px;"><span data-field="rma_number">{{ rma_number }}</span> (if applicable):</td>
    </tr>
    <tr>
      <td>Country of Export:</td>
      <td>Country of Destination:</td>
    </tr>
    <tr>
      <td>Country of Manufacture:</td>
      <td>Air Waybill Number:</td>
    </tr>
  </table>

  <div class="section-header">Shipper/Exporter (Origin)</div>
  <table style="width: 100%;">
    <tr>
      <td style="width: 50%; padding-bottom: 10px;">Sender's Name:</td>
      <td style="width: 50%; padding-bottom: 10px;"><span data-field="phone_number">{{ phone_number }}</span>:</td>
    </tr>
    <tr>
      <td>Department Name:</td>
      <td>Extended Zip:</td>
    </tr>
    <tr>
      <td>Please check all that apply:</td>
      <td></td>
    </tr>
  </table>

  <div style="margin-top: 10px;">
    <label style="margin-right: 15px;">
      <input type="checkbox"> No commercial value/promotional material
    </label>
    <label style="margin-right: 15px;">
      <input type="checkbox"> Repair
    </label>
    <label style="margin-right: 15px;">
      <input type="checkbox"> Will be returned to USA
    </label>
    <label>
      <input type="checkbox"> Other
    </label>
  </div>

  <div class="section-header">Consignee (Destination)</div>
  <table style="width: 100%;">
    <tr>
      <td style="width: 50%; padding-bottom: 10px;">Company Name:</td>
      <td style="width: 50%; padding-bottom: 10px;">Contact Name:</td>
    </tr>
    <tr>
      <td>Delivery Address:</td>
      <td>Zip:</td>
    </tr>
    <tr>
      <td>Country:</td>
      <td>Phone Number:</td>
    </tr>
  </table>

  <div class="section-header">Shipment Description:</div>
  <table>
    <thead>
      <tr>
        <th style="width: 10%;">Quantity:</th>
        <th style="width: 25%;">Unit of Measure:</th>
        <th style="width: 30%;">Detailed Description of Goods:</th>
        <th style="width: 10%;"># of Packages:</th>
        <th style="width: 10%;">Package Type:</th>
        <th style="width: 10%;">Weight:</th>
        <th style="width: 10%;">Unit Value:</th>
        <th style="width: 10%;">Total Value:</th>
      </tr>
    </thead>
    <tbody>
      {% for item in line_items %}
      <tr>
        <td><span data-field="line_items[{{ loop.index0 }}].quantity">{{ item.quantity }}</span></td>
        <td><span data-field="line_items[{{ loop.index0 }}].unit_of_measure">{{ item.unit_of_measure }}</span></td>
        <td><span data-field="line_items[{{ loop.index0 }}].description">{{ item.description }}</span></td>
        <td><span data-field="line_items[{{ loop.index0 }}].number_of_packages">{{ item.number_of_packages }}</span></td>
        <td><span data-field="line_items[{{ loop.index0 }}].package_type">{{ item.package_type }}</span></td>
        <td><span data-field="line_items[{{ loop.index0 }}].weight">{{ item.weight }}</span></td>
        <td><span data-field="line_items[{{ loop.index0 }}].unit_value">{{ item.unit_value }}</span></td>
        <td><span data-field="line_items[{{ loop.index0 }}].total_value">{{ item.total_value }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div style="display: flex; justify-content: space-between; margin-top: 10px;">
    <p>Total Number of Packages: <span data-field="total_packages">{{ total_packages }}</span></p>
    <p>Total Weight: <span data-field="total_weight">{{ total_weight }}</span></p>
    <p>Total Value: <span data-field="total_value">{{ total_value }}</span></p>
  </div>

  <div class="section-header" style="margin-top: 40px;">Authorization:</div>
  <ul style="list-style-type: disc; padding-left: 20px;">
    <li>
      <span data-field="authorization_statement_1">{{ authorization_statement_1 }}</span>
      <span data-field="authorization_statement_2">{{ authorization_statement_2 }}</span>
    </li>
    <li>
      <span data-field="authorization_statement_3">{{ authorization_statement_3 }}</span>
    </li>
    <li>
      <span data-field="authorization_statement_4">{{ authorization_statement_4 }}</span>
      <span data-field="authorization_statement_5">{{ authorization_statement_5 }}</span>
    </li>
  </ul>

  <div style="display: flex; justify-content: space-between; margin-top: 80px;">
    <div style="width: 45%;">
      Sender's Signature:
    </div>
    <div style="width: 45%; text-align: right;">
      Shipping Clerk's Signature:
    </div>
  </div>

  <p style="font-size: 10pt; text-align: right; margin-top: 50px;">06/30/2021</p>
</div>