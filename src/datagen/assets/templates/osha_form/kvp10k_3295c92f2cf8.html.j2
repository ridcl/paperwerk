<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child {
    page-break-after: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  td, th {
    padding: 8px;
    text-align: left;
  }
  .header-title {
    font-size: 18pt;
    font-weight: bold;
    text-align: center;
    margin-bottom: 5px;
  }
  .sub-header {
    font-size: 12pt;
    text-align: center;
    margin-bottom: 20px;
  }
  .section-title {
    font-size: 14pt;
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
    border-bottom: 1px solid #000;
  }
  .data-table-small td {
    padding: 4px 8px;
  }
</style>

<div class="page">
  <div style="text-align: right;">
    <div style="font-size: 14pt; font-weight: bold;">Year {{ year }}</div>
    <div style="font-size: 10pt;">U.S. Department of Labor</div>
    <div style="font-size: 10pt;">Occupational Safety and Health Administration</div>
    <div style="font-size: 9pt; margin-top: 5px;">Form approved OMB no. {{ omb_number }}</div>
  </div>
  <h1 style="font-size: 16pt; font-weight: bold; margin-top: 0;">OSHA's Form 300A (Rev. 01/2004)</h1>
  <h2 style="font-size: 14pt; font-weight: bold;">Summary of Work-Related Injuries and Illnesses</h2>

  <p style="font-size: 10pt; margin-top: 15px;">All establishments covered by Part 1904 must complete this Summary page, even if no work-related injuries or illnesses occurred during the year.
    <br>
    Remember to complete all sections of this form and return the entire form to the OSHA Area Office.
    <br>
    Using the Log, count the individual entries you made in each category. Then write the total below, making sure you've added the entries from every page of the Log. If you had no cases write "0".
    <br>
    Signatures of authorized representatives have the right to review the OSHA 300 in its entirety. They also have limited access to the OSHA Form 301 or its equivalent. See 29 CFR Part 1904.35, in OSHA's recordkeeping rule, for further details on the access provisions for these forms.
  </p>

  <div class="section-title">Number of Cases</div>
  <table>
    <thead>
      <tr>
        <th style="width: 25%;">Total number of deaths</th>
        <th style="width: 25%;">Total number of cases with days away from work</th>
        <th style="width: 25%;">Total number of cases transfer or restriction</th>
        <th style="width: 25%;">Total number of other recordable cases</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="total_deaths">{{ total_deaths }}</span> (G)</td>
        <td><span data-field="total_days_away">{{ total_days_away }}</span> (H)</td>
        <td><span data-field="total_transfer_restriction">{{ total_transfer_restriction }}</span> (I)</td>
        <td><span data-field="total_other_cases">{{ total_other_cases }}</span> (J)</td>
      </tr>
    </tbody>
  </table>

  <div class="section-title">Number of Days</div>
  <table>
    <thead>
      <tr>
        <th style="width: 25%;">Total number of days away from work</th>
        <th style="width: 25%;">Total number of days with job transfer or restriction</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="total_days_away_from_work">{{ total_days_away_from_work }}</span> (K)</td>
        <td><span data-field="total_days_transfer_restriction">{{ total_days_transfer_restriction }}</span> (L)</td>
      </tr>
    </tbody>
  </table>

  <div class="section-title">Injury and Illness Types</div>
  <table>
    <thead>
      <tr>
        <th style="width: 25%;">Total number of ... (M)</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="total_injury_illness_types">{{ total_injury_illness_types }}</span> (M)</td>
      </tr>
    </tbody>
  </table>

  <div class="section-title">Establishment Information</div>
  <table class="data-table-small">
    <tr>
      <td style="width: 20%;">Establishment name</td>
      <td><span data-field="establishment.name">{{ establishment.name }}</span></td>
    </tr>
    <tr>
      <td>City</td>
      <td><span data-field="establishment.city">{{ establishment.city }}</span></td>
    </tr>
    <tr>
      <td>State</td>
      <td><span data-field="establishment.state">{{ establishment.state }}</span></td>
    </tr>
    <tr>
      <td>Zip</td>
      <td><span data-field="establishment.zip">{{ establishment.zip }}</span></td>
    </tr>
  </table>

  <div class="section-title">Industry Description</div>
  <table class="data-table-small">
    <tr>
      <td>Industry Description</td>
      <td><span data-field="industry.description">{{ industry.description }}</span></td>
    </tr>
    <tr>
      <td>NAICS Code</td>
      <td><span data-field="industry.naics_code">{{ industry.naics_code }}</span></td>
    </tr>
  </table>

  <div class="section-title">Employment Information</div>
  <table class="data-table-small">
    <tr>
      <td>Annual average number of employees</td>
      <td><span data-field="employment.average_employees">{{ employment.average_employees }}</span></td>
    </tr>
  </table>

  <div class="section-title">Sign Here</div>
  <div style="display: flex; justify-content: space-between; margin-top: 40px;">
    <div>
      <p style="font-size: 10pt;">Company Executive</p>
      <div style="border-bottom: 1px solid #000; width: 200px; margin-top: 30px;" data-field="company_executive">{{ company_executive }}</div>
    </div>
    <div>
      <p style="font-size: 10pt;">Workers' Compensation Coordinator</p>
      <div style="border-bottom: 1px solid #000; width: 200px; margin-top: 30px;" data-field="workers_compensation_coordinator">{{ workers_compensation_coordinator }}</div>
    </div>
  </div>

  <div style="margin-top: 50px; display: flex; justify-content: space-between; font-size: 9pt;">
    <div>
      <p>Date:</p>
      <span data-field="signature_date_executive">{{ signature_date_executive }}</span>
    </div>
    <div>
      <p>Date:</p>
      <span data-field="signature_date_coordinator">{{ signature_date_coordinator }}</span>
    </div>
  </div>
</div>