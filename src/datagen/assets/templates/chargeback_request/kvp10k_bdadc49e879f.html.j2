<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic the layout structure */
  .form-row { display: flex; margin-bottom: 15px; align-items: center; }
  .form-row > div { flex: 1; margin-right: 20px; }
  .form-row .label { width: 120px; font-weight: bold; }
  .input-field { border: 1px solid #ccc; padding: 5px; width: 100%; box-sizing: border-box; }
  .full-width-field { width: 100%; min-height: 100px; border: 1px solid #ccc; padding: 10px; box-sizing: border-box; }
  .signature-line { border-bottom: 1px solid #000; margin-top: 50px; margin-bottom: 50px; }
</style>

<div class="page">
  <div style="display: flex; align-items: center; margin-bottom: 40px;">
    <div style="font-size: 48px; font-weight: bold;">AS</div>
    <div style="margin-left: 30px;">
      <h1 style="font-size: 24px; margin: 0;">A.S. Chargeback Request</h1>
      <h2 style="font-size: 18px; margin: 5px 0 0 0;">Public Safety</h2>
    </div>
  </div>

  <!-- Contact Information Section -->
  <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px;">
    <div style="display: flex; flex-direction: column;">
      <div style="margin-bottom: 5px;">Contact Name</div>
      <input type="text" class="input-field" style="width: 100%;" value="{{ contact_name }}">
    </div>
    <div style="display: flex; flex-direction: column;">
      <div style="margin-bottom: 5px;">Amount</div>
      <input type="text" class="input-field" style="width: 100%;" value="{{ amount }}">
    </div>

    <div style="display: flex; flex-direction: column;">
      <div style="margin-bottom: 5px;">Phone</div>
      <input type="text" class="input-field" style="width: 100%;" value="{{ phone }}">
    </div>
    <div style="display: flex; flex-direction: column;">
      <div style="margin-bottom: 5px;">Account</div>
      <input type="text" class="input-field" style="width: 100%;" value="{{ account }}">
    </div>

    <div style="display: flex; flex-direction: column;">
      <div style="margin-bottom: 5px;">Fax</div>
      <input type="text" class="input-field" style="width: 100%;" value="{{ fax }}">
    </div>
    <div style="display: flex; flex-direction: column;">
      <div style="margin-bottom: 5px;">Fund</div>
      <input type="text" class="input-field" style="width: 100%;" value="{{ fund }}">
    </div>

    <div style="display: flex; flex-direction: column;">
      <div style="margin-bottom: 5px;">Email</div>
      <input type="text" class="input-field" style="width: 100%;" value="{{ email }}">
    </div>
    <div style="display: flex; flex-direction: column;">
      <div style="margin-bottom: 5px;">Dept ID</div>
      <input type="text" class="input-field" style="width: 100%;" value="{{ dept_id }}">
    </div>

    <div style="display: flex; flex-direction: column;">
      <div style="margin-bottom: 5px;">Location Code</div>
      <input type="text" class="input-field" style="width: 100%;" value="{{ location_code }}">
    </div>
    <div style="display: flex; flex-direction: column;">
      <div style="margin-bottom: 5px;">complete as appropriate</div>
      <input type="text" class="input-field" style="width: 100%;" value="">
    </div>

    <div style="display: flex; flex-direction: column;">
      <div style="margin-bottom: 5px;">Dept. Name</div>
      <input type="text" class="input-field" style="width: 100%;" value="{{ dept_name }}">
    </div>
    <div style="display: flex; flex-direction: column;">
      <div style="margin-bottom: 5px;">Class</div>
      <input type="text" class="input-field" style="width: 100%;" value="{{ class_name }}">
    </div>

    <div style="display: flex; flex-direction: column;">
      <div style="margin-bottom: 5px;">Date Needed</div>
      <input type="text" class="input-field" style="width: 100%;" value="{{ date_needed }}">
    </div>
    <div style="display: flex; flex-direction: column;">
      <div style="margin-bottom: 5px;">Project</div>
      <input type="text" class="input-field" style="width: 100%;" value="{{ project_name }}">
    </div>

    <div style="display: flex; flex-direction: column;">
      <div style="margin-bottom: 5px;">Mail Drop</div>
      <input type="text" class="input-field" style="width: 100%;" value="{{ mail_drop }}">
    </div>
  </div>

  <!-- Description Section -->
  <div style="margin-bottom: 30px;">
    Describe Service Required / Additional Information
    <div class="full-width-field" style="margin-top: 10px;">
      {{ description_details }}
    </div>
  </div>

  <!-- Event Details Section -->
  <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 30px;">
    <div style="display: flex; flex-direction: column;">
      <div style="margin-bottom: 5px;">Event Name</div>
      <input type="text" class="input-field" style="width: 100%;" value="{{ event_name }}">
    </div>
    <div style="display: flex; flex-direction: column;">
      <div style="margin-bottom: 5px;">Date From</div>
      <input type="text" class="input-field" style="width: 100%;" value="{{ date_from }}">
    </div>
    <div style="display: flex; flex-direction: column;">
      <div style="margin-bottom: 5px;">Date To</div>
      <input type="text" class="input-field" style="width: 100%;" value="{{ date_to }}">
    </div>
    <div style="display: flex; flex-direction: column;">
      <div style="margin-bottom: 5px;">Shift Start Time</div>
      <input type="text" class="input-field" style="width: 100%;" value="{{ shift_start_time }}">
    </div>

    <div style="display: flex; flex-direction: column;">
      <div style="margin-bottom: 5px;">Shift End Time</div>
      <input type="text" class="input-field" style="width: 100%;" value="{{ shift_end_time }}">
    </div>
    <div style="display: flex; flex-direction: column;">
      <div style="margin-bottom: 5px;"># CSAs Required</div>
      <input type="text" class="input-field" style="width: 100%;" value="{{ num_csas_required }}">
    </div>
    <div style="display: flex; flex-direction: column;">
      <div style="margin-bottom: 5px;"># Officer's Required</div>
      <input type="text" class="input-field" style="width: 100%;" value="{{ num_officers_required }}">
    </div>
  </div>

  <!-- Signatures and Approvals -->
  <div style="display: flex; justify-content: space-between; margin-top: 80px;">
    <div style="width: 45%;">
      Advisor's Signature
      <div class="signature-line" data-field="officer_s_required">{{ officer_s_required }}</div>
    </div>
    <div style="width: 45%; text-align: right;">
      Date
      <div class="signature-line" data-field="advisor_s_signature">{{ advisor_s_signature }}</div>
    </div>
  </div>

  <!-- Accounting Office Use Only -->
  <div style="margin-top: 80px;">
    <h3 style="text-align: center; margin-bottom: 30px;">Accounting Office Use Only</h3>
    <div style="display: flex; justify-content: space-between; margin-top: 20px;">
      <div style="width: 30%;">
        Auxiliary PO#
        <div class="signature-line" style="margin-top: 10px;" data-field="accounting_office_use_only">{{ accounting_office_use_only }}</div>
      </div>
      <div style="width: 30%; text-align: center;">
        Auxiliary Signature
        <div class="signature-line" style="margin-top: 10px;" data-field="auxiliary_po">{{ auxiliary_po }}</div>
      </div>
      <div style="width: 30%; text-align: right;">
        Date Approved
        <div class="signature-line" style="margin-top: 10px;" data-field="auxiliary_signature">{{ auxiliary_signature }}</div>
      </div>
    </div>
  </div>
</div>