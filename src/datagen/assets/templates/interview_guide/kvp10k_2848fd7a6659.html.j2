  <div style="display: flex; justify-content: space-between; margin-bottom: 30px;">
    <div style="flex: 1; padding-right: 20px;">
      <p style="font-weight: bold;">Name, Credentials (PhD, CPA, RN, etc.)</p>
      <p>Title</p>
      <p>Organization</p>
