      <h2 style="font-size: 14pt; margin-top: 0;">Integral orifice flow elements</h2>
      <p style="font-size: 12pt;">1/2, 1 and 1½ inch pipe sizes</p>
    </div>
    <div style="text-align: right;">
      <!-- Placeholder for potential logo/revision info if present -->
    </div>
  </div>

  <div style="margin-top: 40px;">
    <h3 style="font-size: 14pt; font-weight: bold;">Measurement made easy</h3>
    <!-- Image placeholder -->
    <div style="margin-top: 20px;">
