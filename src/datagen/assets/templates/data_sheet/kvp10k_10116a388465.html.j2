<!DOCTYPE html>
<html>
<head>
    <title>Data Sheet</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3, h4 { font-weight: bold; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        td, th { padding: 8px; text-align: left; border: 1px solid #ddd; }
        .header-title { font-size: 24pt; font-weight: bold; }
        .section-title { font-size: 14pt; font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
        .sub-section-title { font-size: 12pt; font-weight: bold; margin-top: 15px; margin-bottom: 5px; }
        .data-table-small td { padding: 4px 8px; font-size: 10pt; }
    </style>
</head>
