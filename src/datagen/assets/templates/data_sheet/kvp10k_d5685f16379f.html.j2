            <tbody>
                <tr>
                    <td>CM-ESS.MP</td>
                    <td>24-240 V AC/DC</td>
                    <td>Push-in terminals</td>
                    <td>3-30 V, 6-60 V, 30-300 V, 60-600 V</td>
                    <td>1SVR740830R0500</td>
                </tr>
                <tr>
