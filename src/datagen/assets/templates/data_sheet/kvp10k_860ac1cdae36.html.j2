<div class="page">
  <h2 style="font-size: 16pt; margin-bottom: 15px;">Functions</h2>
  <h3 style="font-size: 14pt; margin-top: 20px; margin-bottom: 10px;">Operating controls</h3>
  <div style="display: flex; gap: 50px;">
    <div style="flex: 1;">
      <img src="placeholder_image_4.png" alt="Operating controls diagram" style="max-width: 100%; height: auto;">
      <div style="margin-top: 20px;">
