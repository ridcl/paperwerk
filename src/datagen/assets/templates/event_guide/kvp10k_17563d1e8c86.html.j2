<!DOCTYPE html>
<html>
<head>
<title>Virtual Scientific Meeting Guide</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    margin: 0;
    padding: 0;
  }
  h1, h2, h3 {
    font-weight: bold;
  }
  .header-logo {
    display: flex;
    align-items: center;
    margin-bottom: 20px;
  }
  .logo-icon {
    width: 60px;
    height: 60px;
    margin-right: 15px;
    /* Placeholder for logo visual */
    background-color: #ccc;
  }
  .logo-text h1 {
    font-size: 24px;
    margin: 0;
    line-height: 1;
  }
  .logo-text p {
    font-size: 12px;
    margin: 0;
  }
  .title-block {
    margin-top: 50px;
    text-align: left;
  }
  .title-block h2 {
    font-size: 48px;
    color: #003366; /* Dark Blue approximation */
    margin: 0;
    line-height: 1.1;
  }
  .title-block h3 {
    font-size: 32px;
    color: #003366;
    margin: 5px 0 0 0;
    line-height: 1.2;
  }
  .date-info {
    margin-top: 10px;
    font-size: 16px;
  }
  .sidebar {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100px; /* Approximate width of the vertical bar */
    padding-top: 100px; /* Adjust to align with main content start */
    text-align: center;
    font-size: 14px;
    color: #555;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    border-left: 1px solid #ddd; /* Visual separation */
  }
  .sidebar-text {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    padding: 10px 0;
    font-weight: bold;
  }
  .toc-container {
    margin-top: 40px;
  }
  .toc-header {
    text-align: center;
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 20px;
  }
  .toc-list {
    list-style: none;
    padding: 0;
  }
  .toc-list li {
    display: flex;
    justify-content: space-between;
    padding: 5px 0;
    font-size: 14px;
    border-bottom: 1px dotted #ccc;
  }
  .toc-list li:last-child {
    border-bottom: none;
  }
  .section-header {
    text-align: center;
    font-size: 28px;
    font-weight: bold;
    margin: 40px 0 20px 0;
  }
  .info-box {
    border: 2px solid #003366;
    padding: 20px;
    margin: 30px 0;
    background-color: #f0f8ff;
  }
  .info-box h3 {
    margin-top: 0;
    font-size: 20px;
  }
  .join-us-section {
    text-align: center;
    margin-top: 30px;
  }
  .join-us-section img {
    width: 100px;
    height: auto;
    margin-bottom: 15px;
  }
  .keynote-speaker-card {
    display: flex;
    margin-top: 30px;
    padding: 20px;
    border: 1px solid #ddd;
    align-items: center;
  }
  .speaker-photo {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    margin-right: 30px;
    object-fit: cover;
    background-color: #eee;
  }
  .speaker-details h2 {
    margin: 0 0 5px 0;
    font-size: 22px;
  }
  .speaker-details p {
    margin: 0;
    font-size: 16px;
  }
  .affiliation {
    font-style: italic;
    margin-top: 10px;
  }
  .abstract-list {
    margin-top: 30px;
  }
  .abstract-item {
    display: flex;
    margin-bottom: 25px;
    border-bottom: 1px solid #eee;
    padding-bottom: 15px;
  }
  .abstract-text {
    flex-grow: 1;
    padding-right: 20px;
  }
  .abstract-image {
    width: 150px;
    height: auto;
    flex-shrink: 0;
  }
  .abstract-title {
    font-weight: bold;
    font-size: 16px;
    margin-bottom: 5px;
  }
  .abstract-meta {
    font-size: 13px;
    color: #555;
  }
  .footer {
    text-align: center;
    font-size: 12px;
    margin-top: 50px;
  }
</style>

<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3, h4, h5, h6 {
    font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif;
  }
  p {
    line-height: 1.5;
    margin-bottom: 1em;
  }
  .section-title {
    font-weight: bold;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }
  .abstract {
    font-style: italic;
    margin-bottom: 1.5em;
  }
  .authors {
    margin-bottom: 1.5em;
    font-size: 0.9em;
  }
  .poster-header {
    text-align: center;
    margin-bottom: 1em;
  }
  .poster-title {
    font-size: 1.5em;
    font-weight: bold;
    margin-bottom: 0.5em;
  }
  .poster-authors {
    font-size: 1em;
    margin-bottom: 1em;
  }
  .content-section {
    margin-bottom: 1.5em;
  }
  .content-section h3 {
    font-weight: bold;
    margin-bottom: 0.5em;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1em;
  }
  td {
    padding: 0.5em;
    border: 1px solid #ccc;
  }
  .footer {
    text-align: center;
    margin-top: 2em;
    font-size: 0.8em;
  }
</style>
</head>
<body>

<div class="page">
  <div class="header-logo">
    <div class="logo-icon"></div>
    <div class="logo-text">
      <h1>MUSC</h1>
      <p>Medical University of South Carolina</p>
    </div>
  </div>

  <div class="title-block">
    <h2>DART 2020</h2>
    <h3>Summer Research Day</h3>
    <div class="date-info">Friday, {{ meeting_date }}</div>
  </div>

  <div class="sidebar">
    <div class="sidebar-text">VIRTUAL SCIENTIFIC MEETING GUIDE</div>
  </div>
</div>

<div class="page">
  <div class="toc-container">
    <div class="toc-header">TABLE OF CONTENTS</div>
    <ul class="toc-list">
      <li>General Schedule................................................................................... 3</li>
      <li>DART Keynote Speaker.............................................................................. 3</li>
      <li>Virtual Meeting Information.................................................................... 4</li>
      <li>Poster Presentations............................................................................ 5</li>
      <li>Abstracts.................................................................................................. 7-14</li>
      <li>Special Thanks & Acknowledgments......................................................... 15</li>
    </ul>
  </div>

  <div class="section-header" style="margin-top: 80px;">VIRTUAL MEETING INFO</div>
  <div class="info-box">
    <h3>JOIN US</h3>
    <p>Visit <span data-field="meeting_website">{{ meeting_website }}</span></p>
    <p>Enter the meeting number for the session or click the session title for direct meeting link</p>
    <p>Live Poster Session: <span data-field="poster_session_number">{{ poster_session_number }}</span></p>
    <p>Keynote Address: <span data-field="keynote_address">{{ keynote_address }}</span></p>
    <p>Password: GoDART!</p>
    <p>Click <a href="#" data-field="join_browser_link">{{ join_browser_link }}</a>. You may be prompted to enter the password a second time.</p>
  </div>

  <div style="text-align: center; margin-top: 50px;">
    <p>QUESTIONS? TROUBLE ACCESSING?</p>
    <p>Contact <span data-field="contact_email">{{ contact_email }}</span></p>
    <div style="margin-top: 20px;">
      <!-- Placeholder for DART logo -->
      <div style="width: 150px; height: 50px; background-color: #ccc; margin: 0 auto;"></div>
      <p style="font-size: 12px;">DRUG ABUSE RESEARCH TRAINING</p>
    </div>
  </div>
  <div class="footer">2</div>
</div>

<div class="page">
  <div class="section-header">GENERAL SCHEDULE</div>
  <div style="text-align: center; margin-bottom: 30px;">Friday, {{ general_schedule_date }}</div>

  <div style="display: flex; justify-content: space-around; margin-bottom: 40px;">
    <div style="text-align: center;">
      <p style="font-size: 18px;">10:30 a.m. – 12:30 p.m.</p>
      <p style="font-size: 16px;">|| Live, Virtual Poster Presentations</p>
    </div>
    <div style="text-align: center;">
      <p style="font-size: 18px;">2:00 p.m. – 3:00 p.m.</p>
      <p style="font-size: 16px;">|| Keynote Speech</p>
    </div>
  </div>

  <div class="section-header">KEYNOTE SPEAKER</div>
  <div class="keynote-speaker-card">
    <div class="speaker-photo"></div>
    <div class="speaker-details">
      <h2><span data-field="keynote_speaker_name">{{ keynote_speaker_name }}</span>, Ph.D.</h2>
      <p><span data-field="keynote_speaker_affiliation">{{ keynote_speaker_affiliation }}</span></p>
      <div class="affiliation">Rutgers University</div>
      <p style="margin-top: 15px;">Friday, {{ keynote_date }}</p>
      <p>2:00 PM EDT – 3:00 PM EDT</p>
      <h3>At the Crossroads: What We Know About Treating Traumatic Stress and Addictions</h3>
    </div>
  </div>

  <div style="margin-top: 40px; font-size: 14px;">
    <p>
      <span data-field="keynote_bio_summary">{{ keynote_bio_summary }}</span>
    </p>
  </div>
  <div class="footer">3</div>
</div>

<div class="page">
  <div class="section-header">POSTER PRESENTATIONS</div>

  {% for item in poster_presentations %}
  <div class="abstract-item">
    <div class="abstract-text">
      <div class="abstract-title">#{{ loop.index }} || {{ item.title }}</div>
      <div class="abstract-meta">
        Presented by <span data-field="poster_presentations[{{ loop.index0 }}].presenter_name">{{ poster_presentations[loop.index0].presenter_name }}</span>, <span data-field="poster_presentations[{{ loop.index0 }}].presenter_degree">{{ poster_presentations[loop.index0].presenter_degree }}</span><br>
        Undergraduate student from <span data-field="poster_presentations[{{ loop.index0 }}].presenter_institution">{{ poster_presentations[loop.index0].presenter_institution }}</span><br>
        Mentored by <span data-field="poster_presentations[{{ loop.index0 }}].mentor_name">{{ poster_presentations[loop.index0].mentor_name }}</span>, <span data-field="poster_presentations[{{ loop.index0 }}].mentor_degree">{{ poster_presentations[loop.index0].mentor_degree }}</span><br>
        Abstract Page {{ item.abstract_page }}
      </div>
    </div>
    <div class="abstract-image"></div>
  </div>
  {% endfor %}

  <div class="footer">4</div>
</div>

<div class="page">
  <div class="section-header">ABSTRACTS</div>

  {% for item in abstracts %}
  <div class="abstract-item">
    <div class="abstract-text">
      <div class="abstract-title">POSTER #{{ loop.index }}</div>
      <p><span data-field="abstracts[{{ loop.index0 }}].poster_number">{{ abstracts[loop.index0].poster_number }}</span></p>
      <p><span data-field="abstracts[{{ loop.index0 }}].abstract_body">{{ abstracts[loop.index0].abstract_body }}</span></p>
    </div>
    {% if item.has_image %}
    <div class="abstract-image"></div>
    {% endif %}
  </div>
  {% endfor %}

  <div class="footer">7</div>
</div>

<div class="page">
  <div class="abstract-list">
    {% for item in abstracts %}
    <div class="abstract-item">
      <div class="abstract-text">
        <div class="abstract-title">POSTER #{{ loop.index }}</div>
        <p><span data-field="abstracts[{{ loop.index0 }}].poster_number">{{ abstracts[loop.index0].poster_number }}</span></p>
        <p><span data-field="abstracts[{{ loop.index0 }}].abstract_body">{{ abstracts[loop.index0].abstract_body }}</span></p>
      </div>
      {% if item.has_image %}
      <div class="abstract-image"></div>
      {% endif %}
    </div>
    {% endfor %}
  </div>

  <div class="footer">8</div>
</div>

<div class="page">
  <div class="abstract-list">
    {% for item in abstracts %}
    <div class="abstract-item">
      <div class="abstract-text">
        <div class="abstract-title">POSTER #{{ loop.index }}</div>
        <p><span data-field="abstracts[{{ loop.index0 }}].poster_number">{{ abstracts[loop.index0].poster_number }}</span></p>
        <p><span data-field="abstracts[{{ loop.index0 }}].abstract_body">{{ abstracts[loop.index0].abstract_body }}</span></p>
