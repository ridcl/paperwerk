<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
    font-size: 10pt;
  }
  th, td {
    padding: 8px 10px;
    text-align: left;
  }
  th {
    font-weight: bold;
    border-bottom: 1px solid #ccc;
  }
  .header-title {
    font-size: 14pt;
    font-weight: bold;
    text-align: center;
    margin-bottom: 10px;
  }
  .report-info {
    display: flex;
    justify-content: space-between;
    font-size: 9pt;
    margin-bottom: 20px;
  }
</style>

<div class="page">
  <div class="report-info">
    <div>Report ID: <span data-field="report_id">{{ report_id }}</span></div>
    <div>Page No. <span data-field="page_number">{{ page_number }}</span> of <span data-field="total_pages">{{ total_pages }}</span></div>
    <div>Run Date: <span data-field="run_date">{{ run_date }}</span></div>
    <div>Run Time: <span data-field="run_time">{{ run_time }}</span></div>
  </div>
  <div style="text-align: center;">
    <div class="header-title">University of Utah</div>
    <div style="font-size: 12pt; font-weight: normal;">Schedule of Classes for Summer 2026</div>
    <div style="font-size: 12pt; font-weight: normal;">Campus: <span data-field="campus_name">{{ campus_name }}</span></div>
  </div>

  <table>
    <thead>
      <tr>
        <th>Class#</th>
        <th>Sub</th>
        <th>Cat#·Sec</th>
        <th>Cmpt Units</th>
        <th>Title</th>
        <th>Days</th>
        <th>Time</th>
        <th>Location</th>
        <th>Instructor</th>
        <th>Fees</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="class_number">{{ class_number }}</span></td>
        <td><span data-field="subject_code">{{ subject_code }}</span></td>
        <td><span data-field="category_section">{{ category_section }}</span></td>
        <td><span data-field="credit_units">{{ credit_units }}</span></td>
        <td><span data-field="course_title">{{ course_title }}</span></td>
        <td><span data-field="days">{{ days }}</span></td>
        <td><span data-field="time">{{ time }}</span></td>
        <td><span data-field="location">{{ location }}</span></td>
        <td><span data-field="instructor">{{ instructor }}</span></td>
        <td><span data-field="fees">{{ fees }}</span></td>
      </tr>
      <tr>
        <td colspan="10" style="font-size: 9pt; padding-top: 5px;">- International Requirement</td>
      </tr>
      <tr>
        <td colspan="10" style="font-size: 9pt;">International Requirement</td>
      </tr>
    </tbody>
  </table>
</div>

