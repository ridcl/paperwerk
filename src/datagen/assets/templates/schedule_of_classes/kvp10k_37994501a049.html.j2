    <div>Run Date: {{ run_date }}</div>
    <div>Run Time: {{ run_time }}</div>
  </div>
  <div class="title-section">
    <span data-field="university_name">{{ university_name }}</span>
    <h2>Schedule of Classes for Summer {{ summer_year }}</h2>
    <p>Campus: <span data-field="campus_name">{{ campus_name }}</span></p>
  </div>
  <table>
    <thead>
      <tr>
