        <td><span data-field="schedule_items[{{ loop.index0 }}].credit_units">{{ item.credit_units }}</span></td>
        <td><span data-field="schedule_items[{{ loop.index0 }}].title">{{ item.title }}</span></td>
        <td><span data-field="schedule_items[{{ loop.index0 }}].days">{{ item.days }}</span></td>
        <td><span data-field="schedule_items[{{ loop.index0 }}].time">{{ item.time }}</span></td>
        <td><span data-field="schedule_items[{{ loop.index0 }}].location">{{ item.location }}</span></td>
        <td><span data-field="schedule_items[{{ loop.index0 }}].instructor">{{ item.instructor }}</span></td>
        <td><span data-field="schedule_items[{{ loop.index0 }}].fees">{{ item.fees }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% if notes %}
  <div class="note">
    {% for note in notes %}
    <p>{{ note }}</p>
    {% endfor %}
  </div>
  {% endif %}
</div>

