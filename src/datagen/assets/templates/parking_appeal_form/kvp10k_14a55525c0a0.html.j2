<style>
    @page { size: A4; margin: 0; }
    .page {
        width: 794px; height: 1123px;
        padding: 50px 60px; box-sizing: border-box;
        overflow: hidden; page-break-after: always;
        position: relative;
        font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; /* Using serif fonts as a base */
    }
    .page:last-child { page-break-after: auto; }
    /* Basic styling to mimic form structure */
    .form-row {
        display: flex;
        margin-bottom: 15px;
        align-items: center;
    }
    .form-row > div {
        flex: 1;
    }
    .label-group {
        display: flex;
        gap: 20px;
        margin-bottom: 15px;
    }
    .signature-line {
        margin-top: 60px;
        border-top: 1px solid #000;
        width: 300px;
    }
    .checkbox-group label {
        margin-right: 15px;
    }
    .textarea-container {
        margin-top: 20px;
        border: 1px solid #000;
        padding: 10px;
        min-height: 150px;
        font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif;
        font-size: 12pt;
    }
</style>

<div class="page">
    <header style="text-align: center; margin-bottom: 30px;">
        <h1 style="font-size: 18pt; font-weight: bold;">CAMPUS PARKING SERVICES</h1>
        <h2 style="font-size: 14pt; font-weight: normal;">PARKING CITATION APPEAL FORM</h2>
    </header>

    <div style="font-size: 10pt; margin-bottom: 30px; line-height: 1.4;">
        Any person may appeal the issuance of a parking citation by filing a written appeal with the UNMC/Nebraska Medical Center Parking Services Department. Appeals may be mailed to: Parking Services, 985001 Nebraska Medical Center, Omaha, NE 68198-5001, or faxed to: (402) 559-3500.
        <br><br>
        <span style="font-weight: bold;">IMPORTANT: APPEALS WILL NOT BE CONSIDERED AFTER THAT TIME.</span> Notification of the decision of an appeal will be made in writing or by telephone. If an appeal is denied, the written appeal may then be submitted to the UNMC/Nebraska Medical Center Parking Committee within fourteen (14) calendar days of the final date. The appellant is welcome to attend the meeting to present their position and to answer questions. If you file an appeal, you DO NOT need to immediately pay the fine. If the appeal is denied, the original amount of the fine will be due within fourteen days of notification.
    </div>

    <div style="margin-bottom: 30px;">
        Any appeal form not completely filled out or missing relevant information will be grounds for immediate denial.
    </div>

    <div class="label-group">
        <div style="flex: 1;">
            <div class="form-row">
                <div style="width: 100px;">Name:</div>
                <div style="flex: 2;">(Last) <span data-field="full_name_last">{{ full_name_last }}</span> (First) <span data-field="full_name_first">{{ full_name_first }}</span> (M.I.) <span data-field="full_name_middle">{{ full_name_middle }}</span></div>
            </div>
        </div>
        <div style="flex: 1;">
            <div class="form-row">
                <div style="width: 100px;">Last 4 digits of SS #:</div>
                <div style="flex: 2;"><span data-field="ssn_last_four">{{ ssn_last_four }}</span></div>
            </div>
        </div>
    </div>

    <div class="label-group">
        <div style="flex: 1;">
            <div class="form-row">
                <div style="width: 100px;">City:</div>
                <div style="flex: 2;"><span data-field="city">{{ city }}</span></div>
            </div>
        </div>
        <div style="flex: 1;">
            <div class="form-row">
                <div style="width: 100px;">State:</div>
                <div style="flex: 2;"><span data-field="state">{{ state }}</span></div>
            </div>
        </div>
        <div style="flex: 1;">
            <div class="form-row">
                <div style="width: 100px;">Zip:</div>
                <div style="flex: 2;"><span data-field="zip_code">{{ zip_code }}</span></div>
            </div>
        </div>
        <div style="flex: 1;">
            <div class="form-row">
                <div style="width: 100px;">Contact Phone #:</div>
                <div style="flex: 2;"><span data-field="phone_number">{{ phone_number }}</span></div>
            </div>
        </div>
    </div>

    <div class="label-group">
        <div style="flex: 1;">
            <div class="form-row">
                <div style="width: 100px;">Affiliate:</div>
                <div style="flex: 2; display: flex; gap: 10px;">
                    <label><input type="checkbox" data-field="affiliate_unmc" value="{{ affiliate_unmc }}"> UNMC</label>
                    <label><input type="checkbox" data-field="affiliate_nebraska_medical_center" value="{{ affiliate_nebraska_medical_center }}"> Nebraska Medical Center</label>
                    <label><input type="checkbox" data-field="affiliate_unmc_physicians" value="{{ affiliate_unmc_physicians }}"> UNMC-Physicians</label>
                    <label><input type="checkbox" data-field="affiliate_student" value="{{ affiliate_student }}"> Student</label>
                    <label><input type="checkbox" data-field="affiliate_tenant" value="{{ affiliate_tenant }}"> Tenant</label>
                    <label><input type="checkbox" data-field="affiliate_visitor" value="{{ affiliate_visitor }}"> Visitor</label>
                </div>
            </div>
        </div>
    </div>

    <div class="label-group">
        <div style="flex: 1;">
            <div class="form-row">
                <div style="width: 100px;">Parking Citation #:</div>
                <div style="flex: 2;"><span data-field="citation_number">{{ citation_number }}</span></div>
            </div>
        </div>
        <div style="flex: 1;">
            <div class="form-row">
                <div style="width: 100px;">Date of Citation:</div>
                <div style="flex: 2;"><span data-field="citation_date">{{ citation_date }}</span></div>
            </div>
        </div>
        <div style="flex: 1;">
            <div class="form-row">
                <div style="width: 100px;">Location:</div>
                <div style="flex: 2;"><span data-field="citation_location">{{ citation_location }}</span></div>
            </div>
        </div>
    </div>

    <div class="label-group">
        <div style="flex: 1;">
            <div class="form-row">
                <div style="width: 100px;">Violation #:</div>
                <div style="flex: 2;"><span data-field="violation_number">{{ violation_number }}</span></div>
            </div>
        </div>
        <div style="flex: 1;">
            <div class="form-row">
                <div style="width: 100px;">Vehicle License #:</div>
                <div style="flex: 2;"><span data-field="license_plate_number">{{ license_plate_number }}</span></div>
            </div>
        </div>
        <div style="flex: 1;">
            <div class="form-row">
                <div style="width: 100px;">State:</div>
                <div style="flex: 2;"><span data-field="license_plate_state">{{ license_plate_state }}</span></div>
            </div>
        </div>
    </div>

    <div class="label-group">
        <div style="flex: 1;">
            <div class="form-row">
                <div style="width: 100px;">Parking Permit #(if applicable):</div>
                <div style="flex: 2;"><span data-field="permit_number">{{ permit_number }}</span></div>
            </div>
        </div>
    </div>

    <div style="margin-top: 30px;">
        State reason for appeal (please print legibly).
    </div>
    <div class="textarea-container">
        <!-- Placeholder for appeal reason -->
    </div>

    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-top: 50px;">
        <div style="flex: 1;">
            <div class="signature-line"></div>
            <div style="margin-top: 5px; font-size: 10pt;">Signature of Appellant</div>
        </div>
        <div style="flex: 1;">
            <!-- Blank space for other potential signatures/dates if needed -->
        </div>
    </div>

    <div style="margin-top: 80px; border-top: 2px solid #000; padding-top: 10px;">
        <h3 style="text-align: center; font-size: 12pt; font-weight: bold;">**FOR PARKING SERVICES OFFICE USE ONLY**</h3>
    </div>

    <div style="margin-top: 30px;">
        This appeal has been:
        <div style="margin-top: 10px;">
            <label><input type="checkbox" data-field="office_approved" value="{{ office_approved }}"> Approved</label>
            <label><input type="checkbox" data-field="office_denied" value="{{ office_denied }}"> Denied</label>
        </div>
        Comments:
    </div>
    <div class="textarea-container" style="min-height: 80px;">
        <!-- Placeholder for office comments -->
    </div>

    <div class="label-group" style="margin-top: 40px;">
        <div style="flex: 1;">
            <div class="form-row">
                <div style="width: 150px;">Date of Notification:</div>
                <div style="flex: 2;"><span data-field="notification_date">{{ notification_date }}</span></div>
            </div>
        </div>
        <div style="flex: 1;">
            <div class="form-row">
                <div style="width: 150px;">Notified via:</div>
                <div style="flex: 2; display: flex; gap: 20px;">
                    <label><input type="checkbox" data-field="notified_phone" value="{{ notified_phone }}"> Phone</label>
                    <label><input type="checkbox" data-field="notified_mail" value="{{ notified_mail }}"> Mail (sent to home/campus address)</label>
                </div>
            </div>
        </div>
        <div style="flex: 1;">
            <div class="form-row">
                <div style="width: 150px;">Person Notified:</div>
                <div style="flex: 2;"><span data-field="person_notified">{{ person_notified }}</span></div>
            </div>
        </div>
        <div style="flex: 1;">
            <div class="form-row">
                <div style="width: 150px;">Notification Completed By:</div>
                <div style="flex: 2;"><span data-field="completed_by">{{ completed_by }}</span></div>
            </div>
        </div>
    </div>
</div>