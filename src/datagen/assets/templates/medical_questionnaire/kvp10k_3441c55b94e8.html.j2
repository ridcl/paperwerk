<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Asthma History Questionnaire</title>
<style>
  @page { size: A4; margin: 0; }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: "Liberation Sans", "DejaVu Sans", Arial, Helvetica, sans-serif;
    font-size: 13px;
    color: #000;
  }

  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }

  /* Header */
  .header {
    display: flex;
    align-items: flex-start;
    margin-bottom: 18px;
  }
  .logo-block {
    display: flex;
    align-items: center;
    margin-right: 18px;
  }
  .logo-icon {
    width: 48px;
    height: 52px;
    margin-right: 8px;
    position: relative;
  }
  .logo-icon svg {
    width: 100%;
    height: 100%;
  }
  .logo-text-block {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .logo-new-paltz {
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
    font-size: 26px;
    font-weight: bold;
    letter-spacing: 0.5px;
    line-height: 1.1;
  }
  .logo-suny {
    font-size: 8px;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: bold;
    color: #333;
    margin-top: 1px;
  }
  .header-contact {
    font-size: 11px;
    line-height: 1.6;
    margin-top: 4px;
    margin-left: 4px;
  }
  .header-contact .dept {
    font-weight: bold;
  }

  /* Title */
  .title {
    text-align: center;
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
    font-size: 22px;
    font-weight: bold;
    margin: 22px 0 24px 0;
  }

  /* Form fields */
  .form-row {
    display: flex;
    align-items: flex-end;
    margin-bottom: 13px;
    gap: 10px;
  }
  .form-label {
    white-space: nowrap;
    font-size: 13px;
  }
  .form-underline {
    border-bottom: 1px solid #000;
    flex: 1;
    min-width: 40px;
    height: 18px;
    display: inline-block;
  }
  .form-underline-fixed {
    border-bottom: 1px solid #000;
    display: inline-block;
    height: 18px;
  }

  /* Triggers */
  .triggers-section {
    margin-bottom: 16px;
  }
  .triggers-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 6px;
  }
  .trigger-label {
    font-weight: bold;
    font-size: 13px;
    margin-right: 6px;
    white-space: nowrap;
  }
  .checkbox-item {
    display: flex;
    align-items: center;
    gap: 3px;
    font-size: 13px;
    white-space: nowrap;
  }
  .checkbox-box {
    width: 13px;
    height: 13px;
    border: 1px solid #000;
    display: inline-block;
    flex-shrink: 0;
  }

  /* Questions */
  .question {
    margin-bottom: 16px;
  }
  .question-title {
    font-weight: bold;
    font-size: 13px;
    margin-bottom: 4px;
  }
  .question-inline {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
  }
  .question-sub {
    margin-top: 4px;
    margin-left: 30px;
    display: flex;
    align-items: flex-end;
    gap: 6px;
    font-size: 13px;
  }

  /* Medications lines */
  .med-lines {
    margin-top: 8px;
    margin-left: 0;
  }
  .med-line {
    border-bottom: 1px solid #000;
    width: 100%;
    height: 28px;
    margin-bottom: 10px;
    display: block;
  }

  /* Comments */
  .comments-section {
    margin-bottom: 16px;
  }
  .comments-label {
    font-weight: bold;
    font-size: 13px;
    margin-bottom: 8px;
  }
  .comment-line {
    border-bottom: 1px solid #000;
    width: 100%;
    height: 28px;
    margin-bottom: 10px;
    display: block;
  }

  /* Please note */
  .please-note {
    margin-bottom: 22px;
  }
  .please-note-title {
    font-weight: bold;
    font-size: 13px;
    margin-bottom: 4px;
  }
  .please-note-body {
    font-size: 13px;
    line-height: 1.5;
  }

  /* Signature row */
  .signature-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-top: 18px;
    margin-bottom: 24px;
  }
  .sig-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 320px;
  }
  .sig-line {
    border-bottom: 1px solid #000;
    width: 100%;
    height: 22px;
    margin-bottom: 2px;
  }
  .sig-caption {
    font-size: 11px;
    text-align: center;
  }
  .date-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 180px;
  }
  .date-line {
    border-bottom: 1px solid #000;
    width: 100%;
    height: 22px;
    margin-bottom: 2px;
  }
  .date-caption {
    font-size: 11px;
    text-align: center;
  }

  /* Office use box */
  .office-box {
    border: 1.5px solid #000;
    width: 220px;
    padding: 10px 14px 12px 14px;
    margin-left: auto;
    font-size: 13px;
  }
  .office-box-title {
    font-weight: bold;
    margin-bottom: 8px;
  }
  .office-field-row {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    margin-bottom: 6px;
  }
  .office-underline {
    border-bottom: 1px solid #000;
    flex: 1;
    height: 16px;
    display: inline-block;
  }
</style>
</head>
<body>
<div class="page">

  <!-- Header -->
  <div class="header">
    <div class="logo-block">
      <!-- Stylized logo icon (arrow/mountain shape) -->
      <div class="logo-icon">
        <svg viewBox="0 0 48 52" xmlns="http://www.w3.org/2000/svg">
          <polygon points="24,2 46,50 2,50" fill="none" stroke="#000" stroke-width="3"/>
          <polygon points="24,14 38,50 10,50" fill="#000"/>
        </svg>
      </div>
      <div class="logo-text-block">
        <div class="logo-new-paltz">New Paltz</div>
        <div class="logo-suny">State University of New York</div>
      </div>
    </div>
    <div class="header-contact">
      <div class="dept">Student Health Service • Division of Student Affairs</div>
      <div><span data-field="institution.address">{{ institution.address }}</span> • <span data-field="institution.phone">{{ institution.phone }}</span> • Fax <span data-field="institution.fax">{{ institution.fax }}</span></div>
      <div><span data-field="institution.email">{{ institution.email }}</span></div>
    </div>
  </div>

  <!-- Title -->
  <div class="title">Asthma History Questionnaire</div>

  <!-- Name / DOB / Banner -->
  <div class="form-row">
    <span class="form-label">Name:</span>
    <span class="form-underline"><span data-field="patient.full_name">{{ patient.full_name }}</span></span>
    <span class="form-label" style="margin-left:10px;">Date of Birth:</span>
    <span class="form-underline-fixed" style="width:100px;"><span data-field="patient.date_of_birth">{{ patient.date_of_birth }}</span></span>
    <span class="form-label" style="margin-left:10px;">Banner #</span>
    <span class="form-underline-fixed" style="width:100px;"><span data-field="patient.banner_number">{{ patient.banner_number }}</span></span>
  </div>

  <!-- Permanent Address -->
  <div class="form-row">
    <span class="form-label">Permanent Address:</span>
    <span class="form-underline"><span data-field="patient.permanent_address">{{ patient.permanent_address }}</span></span>
  </div>

  <!-- Home / Cell phone -->
  <div class="form-row">
    <span class="form-label">Home telephone:</span>
    <span class="form-underline"><span data-field="patient.home_telephone">{{ patient.home_telephone }}</span></span>
    <span class="form-label" style="margin-left:10px;">Cell phone:</span>
    <span class="form-underline"><span data-field="patient.cell_phone">{{ patient.cell_phone }}</span></span>
  </div>

  <!-- Family Physician / Physician phone -->
  <div class="form-row">
    <span class="form-label">Family Physician:</span>
    <span class="form-underline"><span data-field="patient.family_physician">{{ patient.family_physician }}</span></span>
    <span class="form-label" style="margin-left:10px;">Physician phone #</span>
    <span class="form-underline"><span data-field="patient.physician_phone">{{ patient.physician_phone }}</span></span>
  </div>

  <!-- Triggers -->
  <div class="triggers-section" style="margin-top:8px;">
    <div class="triggers-row">
      <span class="trigger-label">Triggers:</span>
      <span class="checkbox-item"><span class="checkbox-box"></span> Weather changes</span>
      <span class="checkbox-item"><span class="checkbox-box"></span> Colds</span>
      <span class="checkbox-item"><span class="checkbox-box"></span> Exercise</span>
      <span class="checkbox-item"><span class="checkbox-box"></span> Pets</span>
      <span class="checkbox-item"><span class="checkbox-box"></span> Smoke</span>
    </div>
    <div class="triggers-row" style="margin-left:72px;">
      <span class="checkbox-item"><span class="checkbox-box"></span> Stress</span>
      <span class="checkbox-item"><span class="checkbox-box"></span> Grass</span>
      <span class="checkbox-item"><span class="checkbox-box"></span> Weeds</span>
      <span class="checkbox-item"><span class="checkbox-box"></span> Pollen</span>
      <span class="checkbox-item"><span class="checkbox-box"></span> Other:
        <span class="form-underline-fixed" style="width:120px; margin-left:4px;"><span data-field="triggers.other">{{ triggers.other }}</span></span>
      </span>
    </div>
  </div>

  <!-- Q1: Hospitalized -->
  <div class="question">
    <div class="question-inline">
      <span class="question-title">1.&nbsp; Were you ever hospitalized for asthma?</span>
      <span class="checkbox-item"><span class="checkbox-box"></span> Yes</span>
      <span class="checkbox-item"><span class="checkbox-box"></span> No</span>
    </div>
    <div class="question-sub">
      <span>If yes, location and date:</span>
      <span class="form-underline"><span data-field="hospitalization.location_and_date">{{ hospitalization.location_and_date }}</span></span>
    </div>
  </div>

  <!-- Q2: Last asthma attack -->
  <div class="question">
    <div class="question-inline">
      <span class="question-title">2.&nbsp; Last asthma attack:&nbsp; Date:</span>
      <span class="form-underline-fixed" style="width:200px;"><span data-field="last_asthma_attack_date">{{ last_asthma_attack_date }}</span></span>
    </div>
  </div>

  <!-- Q3: Medications -->
  <div class="question">
    <div class="question-title">3.&nbsp; Medications &nbsp;(eg.&nbsp; Do you use an inhaler or nebulizer?):</div>
    <div class="med-lines">
      {% for med in medications %}
      <span class="med-line"><span data-field="medications[{{ loop.index0 }}].entry">{{ med.entry }}</span></span>
      {% endfor %}
    </div>
  </div>

  <!-- Comments -->
  <div class="comments-section">
    <div class="comments-label">Comments:</div>
    {% for comment in comments %}
    <span class="comment-line"><span data-field="comments[{{ loop.index0 }}].text">{{ comment.text }}</span></span>
    {% endfor %}
  </div>

  <!-- Please Note -->
  <div class="please-note">
    <div class="please-note-title">PLEASE NOTE:</div>
    <div class="please-note-body">The Student Health Service recommends the influenza vaccine.&nbsp; This vaccine is available at SHS at no additional charge to students.</div>
  </div>

  <!-- Signature Row -->
  <div class="signature-row">
    <div class="sig-block">
      <div class="sig-line"><span data-field="patient.signature">{{ patient.signature }}</span></div>
      <div class="sig-caption">Signature</div>
    </div>
    <div class="date-block">
      <div class="date-line"><span data-field="signature_date">{{ signature_date }}</span></div>
      <div class="date-caption">Date</div>
    </div>
  </div>

  <!-- Office Use Only -->
  <div class="office-box">
    <div class="office-box-title">For office use only:</div>
    <div class="office-field-row">
      <span>Reviewed by:</span>
      <span class="office-underline"><span data-field="office.reviewed_by">{{ office.reviewed_by }}</span></span>
    </div>
    <div class="office-field-row">
      <span>Date:</span>
      <span class="office-underline"><span data-field="office.review_date">{{ office.review_date }}</span></span>
    </div>
  </div>

</div>
</body>
</html>