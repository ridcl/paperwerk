<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; line-height: 1.5; color: #000; }
  h1, h2, h3 { font-weight: bold; }
  .header-logo { float: left; }
  .footer-logo { float: right; }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px;">
    <div class="header-logo">
      <!-- Placeholder for University Logo -->
      <div style="font-size: 24px; font-weight: bold;">
        <span data-field="university_name">{{ university_name }}</span>
      </div>
    </div>
    <div class="footer-logo">
      <!-- Placeholder for Secondary Logo/Seal -->
      <div style="font-size: 40px;">[Logo Placeholder]</div>
    </div>
  </div>

  <div style="margin-bottom: 30px;">
    <p style="text-align: left;">
      <span data-field="address_line_1">{{ address_line_1 }}</span><br>
      <span data-field="city_state_zip">{{ city_state_zip }}</span><br>
      Phone: <span data-field="phone_number">{{ phone_number }}</span><br>
      Fax: <span data-field="fax_number">{{ fax_number }}</span><br>
      Email: <span data-field="email_address">{{ email_address }}</span>
    </p>
  </div>

  <h1 style="font-size: 20px; margin-bottom: 10px;">Information and Instructions for American Junior Year Application</h1>

  <h2 style="font-size: 16px; margin-top: 30px; margin-bottom: 15px;">General instructions:</h2>

  <p>
    The following materials must be received before any action can be taken on your application (email numbers 1 to 3 to <span data-field="application_email">{{ application_email }}</span>):
  </p>

  <ol style="padding-left: 20px;">
    <li>
      The completed fillable application form which includes an Information Waiver Form to list your Academic/Personal reference and a German Language reference. Please download and save prior to sending;
    </li>
    <li>
      An official transcript sent directly from all colleges or universities, that the applicant has attended;
    </li>
    <li>
      A Statement of Purpose as outlined on the second page of the application form. Be sure to put your name at the top of the paper;
    </li>
    <li>
      A non-refundable application fee of $25 (waived for affiliate schools), <a href="#" data-field="fee_waiver_link">{{ fee_waiver_link }}</a>
    </li>
  </ol>

  <div style="margin-top: 40px;">
    <p style="font-weight: bold;">Deadlines:</p>
    <table style="width: 100%; border-collapse: collapse; margin-top: 10px;">
      <tr>
        <td style="width: 50%; padding: 5px;">Full Academic Year (September to July)</td>
        <td style="width: 50%; padding: 5px;"><span data-field="deadline_full_academic">{{ deadline_full_academic }}</span></td>
      </tr>
      <tr>
        <td style="width: 50%; padding: 5px;">Fall Semester (September to December)</td>
        <td style="width: 50%; padding: 5px;"><span data-field="deadline_fall_semester">{{ deadline_fall_semester }}</span></td>
      </tr>
      <tr>
        <td style="width: 50%; padding: 5px;">Extended Fall Semester (September to February)</td>
        <td style="width: 50%; padding: 5px;"><span data-field="deadline_extended_fall">{{ deadline_extended_fall }}</span></td>
      </tr>
      <tr>
        <td style="width: 50%; padding: 5px;">Spring Semester (March to July)</td>
        <td style="width: 50%; padding: 5px;"><span data-field="deadline_spring_semester">{{ deadline_spring_semester }}</span></td>
      </tr>
    </table>
  </div>

  <div style="margin-top: 50px;">
    <p style="font-weight: bold;">Questions:</p>
    <p><span data-field="contact_email">{{ contact_email }}</span></p>
  </div>
</div>