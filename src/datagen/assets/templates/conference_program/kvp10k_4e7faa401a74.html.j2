  .presenter-header {
    display: flex;
    align-items: center;
    margin-bottom: 15px;
  }
  .presenter-photo {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    object-fit: cover;
    margin-right: 20px;
    border: 1px solid #ccc;
  }
  .presenter-info h3 {
    margin: 0;
    font-size: 1.4em;
  }
  .presenter-info p {
