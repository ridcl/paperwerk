<!DOCTYPE html>
<html>
<head>
    <title>Conference Program</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 { text-align: center; }
        .logo-container { text-align: center; margin-bottom: 20px; }
        .sponsor-section { margin-top: 30px; }
        .sponsor-row { display: flex; justify-content: space-around; align-items: center; margin-bottom: 20px; }
        .sponsor-logo { max-height: 80px; }
        .agenda-item { margin-bottom: 15px; }
        .agenda-time { font-weight: bold; display: inline-block; width: 80px; }
        .agenda-details { display: inline-block; }
        .divider { border-top: 1px solid #ccc; margin: 20px 0; }
    </style>

<style>
