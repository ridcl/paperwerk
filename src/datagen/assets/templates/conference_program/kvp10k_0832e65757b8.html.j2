<!DOCTYPE html>
<html>
<head>
<title>Conference Program</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; }
  .header-logo { text-align: center; margin-bottom: 20px; }
  .logo-image { width: 100px; height: auto; }
  .title-block { text-align: center; margin-bottom: 40px; }
  .title-block h1 { font-size: 24pt; margin-bottom: 5px; }
  .title-block h2 { font-size: 16pt; margin-top: 0; margin-bottom: 20px; }
  .event-details { text-align: center; margin-bottom: 50px; }
  .event-details p { margin: 5px 0; font-size: 12pt; }
  .host-info { text-align: center; margin-bottom: 50px; }
  .host-info p { margin: 5px 0; font-size: 12pt; }
  .footer-logo { text-align: center; margin-top: 50px; }
  .footer-logo img { width: 150px; height: auto; }
  .section-title { font-size: 14pt; font-weight: bold; margin-top: 30px; margin-bottom: 15px; border-bottom: 1px solid #ccc; padding-bottom: 5px; }
  .list-item { margin-bottom: 15px; line-height: 1.4; }
  .speaker-info { font-size: 11pt; margin-top: 5px; }
  .room-info { float: right; font-weight: bold; }
  .divider { border-top: 1px solid #000; margin: 20px 0; }
  .contact-info { margin-top: 40px; font-size: 10pt; }
  .table-header { font-weight: bold; padding: 5px 0; border-bottom: 1px solid #000; }
  .table-row td { padding: 5px 0; }
</style>

<style>
