        .time-slot { font-weight: bold; display: inline-block; width: 120px; }
        .session-details { margin-left: 150px; }
        .speaker-detail { margin-bottom: 15px; }
        .speaker-detail p { margin: 2px 0; font-size: 0.9em; }
        .footer-page-num { position: absolute; bottom: 30px; right: 60px; font-size: 0.8em; }
        .logo-bottom { text-align: center; margin-top: 50px; }
        .logo-bottom img { max-width: 150px; }
    </style>

<style>
