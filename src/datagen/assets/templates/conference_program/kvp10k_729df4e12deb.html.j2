            <td style="padding: 5px 0;">Reception and Banquet Friday, November 15 (includes Tony Martin concert)</td>
            <td style="padding: 5px 0; text-align: right;">$100</td>
          </tr>
          <tr>
            <td style="padding: 5px 0;">Transportation Fee</td>
            <td style="padding: 5px 0; text-align: right;">$25</td>
          </tr>
        </table>
        <div style="text-align: right; margin-top: 15px; font-weight: bold;">TOTAL</div>
      </div>
      <div style="width: 45%; text-align: right;">
        <div style="font-weight: bold;">NO. OF PERSONS</div>
        <div style="margin-top: 10px;">
          <p>____________________</p>
        </div>
        <div style="font-weight: bold; margin-top: 20px;">AMOUNT</div>
        <div style="margin-top: 10px;">
          <p>____________________</p>
        </div>
      </div>
    </div>
  </div>

</div>

