<!DOCTYPE html>
<html>
<head>
    <title>Conference Program</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 { text-align: center; }
        .header-title { font-size: 36pt; font-weight: bold; }
        .conference-title { font-size: 48pt; font-weight: bold; text-align: center; margin: 20px 0; }
        .sub-title { font-size: 18pt; text-align: center; margin-bottom: 10px; }
        .date-info { font-size: 14pt; text-align: center; margin-bottom: 40px; }
        .logo-container { display: flex; justify-content: space-between; align-items: flex-start; margin-top: 50px; }
        .sponsors-section { display: flex; flex-direction: column; gap: 30px; margin-top: 50px; }
        .sponsor-logo { max-width: 150px; }
        .acknowledgement { text-align: center; margin-bottom: 40px; font-size: 12pt; }
        .speaker-list { display: flex; justify-content: space-around; margin-top: 40px; }
        .speaker-column { width: 45%; }
        .speaker-entry { margin-bottom: 20px; }
        .speaker-name { font-weight: bold; }
        .speaker-title { font-size: 10pt; }
        .program-schedule { display: flex; flex-direction: column; gap: 20px; margin-top: 30px; }
        .schedule-block { display: flex; justify-content: space-between; border-bottom: 1px solid #ccc; padding-bottom: 10px; }
        .time-slot { width: 20%; font-weight: bold; }
        .event-details { width: 75%; }
        .event-title { font-weight: bold; margin-bottom: 5px; }
        .event-description { font-size: 10pt; }
        .panel-section { margin-top: 30px; }
        .panel-header { font-size: 14pt; font-weight: bold; margin-bottom: 15px; }
        .panel-content { display: flex; justify-content: space-between; gap: 40px; }
        .panel-column { flex: 1; }
        .panel-entry { margin-bottom: 15px; }
        .panel-speaker-name { font-weight: bold; }
        .panel-speaker-details { font-size: 10pt; }
        .footer-note { text-align: center; font-size: 8pt; margin-top: 50px; }
        .ad-banner { text-align: center; margin-top: 50px; padding: 20px; border: 1px solid #000; }
    </style>

<style>
