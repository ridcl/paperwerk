<div class="page">
  <!-- Page 1: Add New Account -->
  <div class="phone-frame">
    <div class="screen">
      <div class="header">
        <div>CHASE</div>
        <div><span data-field="menu_icon">{{ menu_icon }}</span></div>
      </div>
      <div class="content">
        <h2>Add New Account</h2>
        <div class="form-group">
          <label>Routing Number</label>
          <input type="text" value="{{ routing_number }}">
        </div>
        <div class="form-group">
          <label>Account Number</label>
          <input type="text" value="{{ account_number }}">
        </div>
        <div class="form-group">
          <label>Account Type</label>
          <div>
            <input type="radio" name="account_type" value="Saving" {% if account_type == 'Saving' %}checked{% endif %}> Saving
            <input type="radio" name="account_type" value="Checking" {% if account_type == 'Checking' %}checked{% endif %}> Checking
          </div>
        </div>
        <div class="form-group">
          <label>Bank Name</label>
          <input type="text" value="{{ bank_name }}">
        </div>
        <div class="form-group">
          <label>Bank Nick Name</label>
          <input type="text" value="{{ bank_nick_name }}">
        </div>
        <div class="form-group">
          <label>Default Account?</label>
          <div>
            <input type="radio" name="default_account" value="Yes" {% if is_default %}checked{% endif %}> Yes
            <input type="radio" name="default_account" value="No" {% if not is_default %}checked{% endif %}> No
          </div>
        </div>
        <div class="button-group">
          <button class="button btn-primary">Submit</button>
          <button class="button btn-secondary">Cancel</button>
        </div>
      </div>
    </div>
  </div>
  <div class="info-box">
    Recipient clicks Submit to finalize payment.
  </div>
</div>

<div class="page">
  <!-- Page 2: Confirm Details -->
  <div class="phone-frame">
    <div class="screen">
      <div class="header">
        <div>CHASE</div>
        <div><span data-field="menu_icon">{{ menu_icon }}</span></div>
      </div>
      <div class="content">
        <h2>Confirm details</h2>
        <div class="form-group">
          <label>Routing Number</label>
          <input type="text" value="{{ routing_number }}">
        </div>
        <div class="form-group">
          <label>Account Number</label>
          <input type="text" value="{{ account_number }}">
        </div>
        <div class="form-group">
          <label>Account Type</label>
          <input type="text" value="{{ account_type }}">
        </div>
        <div class="form-group">
          <label>Bank Name</label>
          <input type="text" value="{{ bank_name }}">
        </div>
        <div class="form-group">
          <label>Bank Nick Name</label>
          <input type="text" value="{{ bank_nick_name }}">
        </div>
        <div class="button-group">
          <button class="button btn-primary">Confirm and Transfer</button>
          <button class="button btn-secondary">Cancel</button>
          <button class="button btn-secondary" style="margin-left: 10px;">Change</button>
        </div>
      </div>
    </div>
  </div>
  <div class="info-box">
    Recipient confirms and the payment is sent.
  </div>
</div>

<div class="page">
  <!-- Page 3: Confirmation/Transfer Screen -->
  <div class="phone-frame">
    <div class="screen">
      <div class="header">
        <div>CHASE</div>
        <div><span data-field="menu_icon">{{ menu_icon }}</span></div>
      </div>
      <div class="content">
        <div style="text-align: center; margin-bottom: 30px;">
            <span data-field="confirmation_icon">{{ confirmation_icon }}</span>
        </div>
        <p style="font-size: 16px; margin-bottom: 20px;">The amount <span data-field="transfer_amount">{{ transfer_amount }}</span> USD will be transferred to your account</p>
        <div style="border-top: 1px solid #eee; padding-top: 20px;">
            <div class="form-group">
                <label>Account Type</label>
                <input type="text" value="{{ account_type }}">
            </div>
            <div class="form-group">
                <label>Bank Name</label>
                <input type="text" value="{{ bank_name }}">
            </div>
            <div class="form-group">
                <label>Bank Nick Name</label>
                <input type="text" value="{{ bank_nick_name }}">
            </div>
        </div>
        <div class="button-group" style="margin-top: 40px;">
          <button class="button btn-primary">Confirm and Transfer</button>
          <button class="button btn-secondary">Cancel</button>
          <button class="button btn-secondary" style="margin-left: 10px;">Change</button>
        </div>
      </div>
    </div>
  </div>
  <div class="info-box" style="top: 100px; right: 50px;">
    Payment is typically made in 1-3 business days.
  </div>
</div></body>
</html>