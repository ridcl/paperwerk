<!DOCTYPE html>
<html>
<head>
<title>Liner Sources</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, Helvetica, Arial, sans-serif;
    line-height: 1.4;
    color: #000;
  }
  h1 {
    font-size: 24pt;
    text-align: center;
    margin-bottom: 10px;
  }
  .header-meta {
    text-align: right;
    font-size: 10pt;
    margin-bottom: 40px;
  }
  .entry {
    margin-bottom: 30px;
    padding-bottom: 15px;
    border-bottom: 1px solid #eee;
  }
  .entry h2 {
    font-size: 14pt;
    font-weight: bold;
    margin-bottom: 5px;
  }
  .contact-info p {
    margin: 2px 0;
    font-size: 10pt;
  }
  .contact-info span {
    font-weight: bold;
    display: inline-block;
    width: 50px;
  }
  .product-list {
    margin-top: 10px;
    font-size: 10pt;
    line-height: 1.5;
  }
  .product-list span {
    display: inline;
    margin-right: 5px;
  }
</style>

