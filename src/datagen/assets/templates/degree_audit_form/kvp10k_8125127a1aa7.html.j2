  <div style="margin-top: 50px;">
    <p>Name of Academic Advisor (please print): <span data-field="advisor_name">{{ advisor_name }}</span></p>
    <p>Department: <span data-field="department_name">{{ department_name }}</span></p>
    <p>Phone Number: <span data-field="advisor_phone">{{ advisor_phone }}</span></p>
    <p>Signature of Academic/Admissions Advisor: _________________________ Date: <span data-field="advisor_signature_date">{{ advisor_signature_date }}</span></p>
    <p>Electronic and typed signatures are not acceptable.</p>
  </div>

  <div style="margin-top: 100px; text-align: center; font-size: small;">
    <p>Please submit your form by mail or fax.</p>
    <p>Chaminade University of Honolulu, <span data-field="address_line_1">{{ address_line_1 }}</span>, <span data-field="city_state_zip">{{ city_state_zip }}</span></p>
    <p>Email: <span data-field="email_address">{{ email_address }}</span> Web: <span data-field="website_url">{{ website_url }}</span> Phone: <span data-field="phone_number">{{ phone_number }}</span> Fax: <span data-field="fax_number">{{ fax_number }}</span></p>
  </div>
</div>