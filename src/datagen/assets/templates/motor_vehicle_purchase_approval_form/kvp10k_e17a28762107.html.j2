<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; /* Defaulting to serif for document feel */
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  h1, h2, h3 { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; }
  .form-row { display: flex; margin-bottom: 15px; }
  .form-row > div { flex: 1; }
  .section-header { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
  .signature-line { border-bottom: 1px solid #000; margin-top: 50px; margin-bottom: 5px; display: inline-block; width: 200px; }
</style>

<div class="page">
  <div style="text-align: left;">
    <h1 style="font-size: 24pt; margin-bottom: 5px;">California State University</h1>
    <h1 style="font-size: 36pt; margin-top: 0; margin-bottom: 30px;">Northridge</h1>
  </div>

  <div style="display: flex; justify-content: space-between; margin-bottom: 40px;">
    <div>
      <p>PPM TEL NO: <span data-field="ppm_tel">{{ ppm_tel }}</span></p>
      <p>FAX NO: <span data-field="ppm_fax">{{ ppm_fax }}</span></p>
      <p>MAIL DROP: <span data-field="ppm_mail_drop">{{ ppm_mail_drop }}</span></p>
    </div>
    <div style="text-align: right;">
      <h2 style="font-size: 14pt;">PHYSICAL PLANT MANAGEMENT (PPM)</h2>
      <h2 style="font-size: 18pt; margin-top: 0;">Motor Vehicle Purchase Approval Form</h2>
    </div>
  </div>

  <!-- I. REQUESTER -->
  <div class="section-header">I. REQUESTER:</div>
  <div class="form-row">
    <div style="flex: 1;">
      EXT/FAX: _________________________
    </div>
    <div style="flex: 1;">
      MAIL DROP: _________________________
    </div>
    <div style="flex: 1;">
      DEPT: _________________________
    </div>
    <div style="flex: 1;">
      EMAIL: _________________________
    </div>
  </div>

  <!-- II. DESCRIBE REQUESTED VEHICLE -->
  <div class="section-header">II. DESCRIBE REQUESTED VEHICLE:</div>
  <div style="margin-top: 15px;">
    <label style="display: block; margin-bottom: 10px;">
      <input type="radio" name="check_one" value="new" checked> New vehicle request
      <input type="radio" name="check_one" value="used"> Used vehicle request (inspection must be made by campus vehicle inspector)
    </label>
    <label style="display: block; margin-bottom: 10px;">
      <input type="radio" name="check_one" value="add"> Vehicle will be an addition to the campus vehicle inventory (Will not replace an existing vehicle)
      <input type="radio" name="check_one" value="replace"> Vehicle will replace an existing vehicle (Existing vehicle will be disposed of)
    </label>
  </div>

  <!-- III. IF THE REQUESTED VEHICLE WILL BE AN ADDITION TO THE CURRENT CAMPUS INVENTORY, DESCRIBE: -->
  <div class="section-header">III. IF THE REQUESTED VEHICLE WILL BE AN ADDITION TO THE CURRENT CAMPUS INVENTORY, DESCRIBE: (Use separate page if necessary)</div>
  <ul style="list-style-type: disc; padding-left: 20px;">
    <li>Why was an additional vehicle needed? _________________________</li>
    <li>Where the vehicle will be secured and stored: _________________________</li>
  </ul>

  <!-- IV. IF THE VEHICLE WILL REPLACE AN EXISTING VEHICLE, DESCRIBE: -->
  <div class="section-header">IV. IF THE VEHICLE WILL REPLACE AN EXISTING VEHICLE, DESCRIBE: (Use separate page if necessary)</div>
  <ul style="list-style-type: disc; padding-left: 20px;">
    <li>The vehicle to be replaced: _________________________</li>
    <li>Where the vehicle will be secured and stored: _________________________</li>
  </ul>

  <!-- V. REQUESTING DEPARTMENT/UNIT APPROVALS -->
  <div class="section-header">V. REQUESTING DEPARTMENT/UNIT APPROVALS:</div>
  <div class="form-row" style="margin-top: 20px;">
    <div style="flex: 1;">Signature: _________________________</div>
    <div style="flex: 1; text-align: right;">Title: _________________________</div>
    <div style="flex: 1; text-align: right;">Date: _________________________</div>
  </div>

  <!-- VI. CAMPUS APPROVALS – ALL VEHICLE REQUESTS -->
  <div class="section-header">VI. CAMPUS APPROVALS – ALL VEHICLE REQUESTS:</div>

  <!-- DIRECTOR OF PHYSICAL PLANT MANAGEMENT -->
  <div style="margin-top: 20px;">
    <p>DIRECTOR OF PHYSICAL PLANT MANAGEMENT:</p>
    <div class="form-row">
      <div style="flex: 1;">Signature: _________________________</div>
      <div style="flex: 1; text-align: right;">Date: _________________________</div>
    </div>
  </div>

  <!-- SAFETY APPROVAL -->
  <div style="margin-top: 20px;">
    <p>SAFETY APPROVAL*:</p>
    <div class="form-row">
      <div style="flex: 1;">Signature: _________________________</div>
      <div style="flex: 1; text-align: right;">Date: _________________________</div>
    </div>
  </div>

  <!-- DIRECTOR OF ENVIRONMENTAL HEALTH & SAFETY -->
  <div style="margin-top: 20px;">
    <p>DIRECTOR OF ENVIRONMENTAL HEALTH & SAFETY:</p>
    <div class="form-row">
      <div style="flex: 1;">Signature: _________________________</div>
      <div style="flex: 1; text-align: right;">Date: _________________________</div>
    </div>
  </div>

  <!-- VII. VICE PRESIDENT FOR ADMINISTRATION AND FINANCE -->
  <div class="section-header" style="margin-top: 40px;">VII. VICE PRESIDENT FOR ADMINISTRATION AND FINANCE:</div>
  <p style="margin-top: 15px;">I SUPPORT PURCHASE OF THE REQUESTED VEHICLE AND UNDERSTAND THE REQUESTING DEPARTMENT WILL BE OBLIGATED TO FUND OPERATIONAL AND MAINTENANCE COSTS, INCLUDING INSURANCE, VEHICLE SAFETY MODIFICATIONS, AND STORAGE EXPENSES AS NECESSARY.</p>

  <div class="form-row" style="margin-top: 40px;">
    <div style="flex: 1;">Signature: _________________________</div>
    <div style="flex: 1; text-align: right;">Date: _________________________</div>
  </div>

  <p style="font-size: 10pt; margin-top: 50px;">* (Only required for heavy machinery vehicles such as forklifts, tractors, street sweepers, etc.)</p>
</div>