<!DOCTYPE html>
<html>
<head>
    <title>Synthetic Document</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial; }
        .header-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        .logo { font-size: 40px; }
        .title { font-size: 36px; font-weight: bold; }
        .menu-bar { display: flex; gap: 20px; font-size: 14px; }
        .content-section { margin-top: 30px; }
        .bullet-list { list-style-type: disc; margin-left: 20px; }
        .table-container { margin-top: 20px; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        td { padding: 10px; border: 1px solid #ccc; text-align: left; }
        .right-aligned { text-align: right; }
        .form-group { margin-bottom: 15px; }
        .form-group label { display: block; margin-bottom: 5px; font-weight: bold; }
        .form-group input[type="text"], .form-group select { width: 100%; padding: 8px; box-sizing: border-box; border: 1px solid #ccc; }
        .button { padding: 10px 20px; background-color: #0056b3; color: white; border: none; cursor: pointer; margin-top: 10px; }
        .sidebar { float: right; width: 250px; border-left: 1px solid #eee; padding-left: 20px; }
        .sidebar h3 { margin-top: 0; }
        .sidebar ul { list-style-type: none; padding: 0; }
        .sidebar li { margin-bottom: 8px; font-size: 13px; }
        .highlight { background-color: #fff3cd; padding: 10px; border: 1px solid #ffeeba; margin-top: 15px; }
    </style>
</head>
<body>

<div class="page">
    <div class="header-bar">
        <div class="logo">UT</div>
        <div class="title">Payment Type</div>
        <div class="menu-bar">
            <span>Employee</span>
            <span>UT Community</span>
            <span>Library</span>
        </div>
    </div>

    <div style="display: flex; gap: 50px;">
