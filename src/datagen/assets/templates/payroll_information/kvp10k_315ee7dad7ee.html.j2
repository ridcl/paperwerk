<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  h1, h2, h3 {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
  }
  td, th {
    padding: 8px;
    text-align: left;
  }
  .header-bar {
    display: flex;
    align-items: center;
    border-bottom: 2px solid #003366;
    padding-bottom: 10px;
    margin-bottom: 20px;
  }
  .logo {
    width: 80px;
    height: 80px;
    margin-right: 20px;
  }
  .title-section {
    text-align: center;
    margin-bottom: 30px;
  }
  .mission-list {
    list-style-type: disc;
    padding-left: 25px;
  }
  .mission-list li {
    margin-bottom: 10px;
  }
  .contact-info-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 20px;
  }
  .contact-item strong {
    display: inline-block;
    width: 60px;
  }
  .nav-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 0;
    border-bottom: 1px solid #ccc;
    margin-bottom: 20px;
    font-family: "DejaVu Sans", "Liberation Sans", Arial, Helvetica;
  }
  .nav-links a {
    margin-left: 20px;
    text-decoration: none;
    color: #333;
    font-weight: bold;
  }
  .menu-button {
    padding: 8px 15px;
    background-color: #003366;
    color: white;
    border: none;
    cursor: pointer;
    font-family: inherit;
  }
  .content-section {
    margin-bottom: 40px;
  }
  .tab-container {
    display: flex;
    border-bottom: 2px solid #ccc;
    margin-bottom: 20px;
  }
  .tab-button {
    padding: 10px 20px;
    cursor: pointer;
    border: 1px solid transparent;
    border-bottom: none;
    background-color: #f1f1f1;
    margin-right: 5px;
    font-family: inherit;
  }
  .tab-button.active {
    background-color: white;
    border-color: #ccc;
    border-bottom: 2px solid white;
    font-weight: bold;
  }
  .tab-content {
    border: 1px solid #ccc;
    padding: 20px;
    display: none;
  }
  .tab-content.active {
    display: block;
  }
  .reminder-box {
    border: 1px solid #ddd;
    padding: 15px;
    margin-bottom: 20px;
    background-color: #f9f9f9;
  }
  .footer-links {
    display: flex;
    justify-content: space-between;
    margin-top: 30px;
  }
  .footer-links div {
    flex: 1;
    padding: 0 10px;
  }
  .sidebar-menu {
    width: 250px;
    float: left;
    padding-right: 20px;
  }
  .sidebar-menu ul {
    list-style: none;
    padding: 0;
  }
  .sidebar-menu li {
    margin-bottom: 8px;
  }
  .sidebar-menu a {
    text-decoration: none;
    color: #003366;
    font-size: 0.95em;
  }
  .main-content-area {
    margin-left: 270px;
  }
  .system-info-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 20px;
  }
  .system-box {
    border: 1px solid #ddd;
    padding: 15px;
    background-color: #fafafa;
  }
  .workplace-tools {
    grid-column: span 1;
  }
  .email-utad-account {
    grid-column: span 1;
  }
  .my-toolkit {
    grid-column: span 1;
  }
  .table-payroll {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
  }
  .table-payroll th, .table-payroll td {
    border: 1px solid #ccc;
    padding: 8px;
    text-align: center;
  }
  .table-payroll th {
    background-color: #e0e0e0;
  }
  .timecard-details {
    display: flex;
    justify-content: space-between;
    margin-bottom: 15px;
  }
  .timecard-details div {
    flex: 1;
  }
</style>

<div class="page">
  <div class="header-bar">
    <img src="" alt="UT Logo" class="logo">
    <div>
      <h1 style="margin: 0; font-size: 28px;">The University of Toledo</h1>
      <h2 style="margin: 0; font-size: 22px;">Payroll Department</h2>
    </div>
  </div>

  <div class="content-section">
    <p style="font-size: 1.1em; line-height: 1.6;">The mission of the Payroll Department of the University of Toledo is to support the teaching, research, and support efforts of the University of Toledo's faculty and staff.</p>
    <ul class="mission-list">
      <li>By providing accurate and timely compensation for services performed;</li>
      <li>Ensuring all deductions and taxes are correctly deducted and reported in a timely manner to the appropriate agency.</li>
    </ul>
  </div>
</div>

<div class="page">
