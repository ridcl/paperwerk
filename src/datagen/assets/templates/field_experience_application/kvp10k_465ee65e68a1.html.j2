<!DOCTYPE html>
<html>
<head>
    <title>Field Experience Application</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
        }
        .page:last-child { page-break-after: auto; }
        .section-header {
            font-weight: bold;
            margin-bottom: 15px;
        }
        .form-row {
            display: flex;
            margin-bottom: 10px;
            align-items: center;
        }
        .form-row > div {
            flex: 1;
        }
        .label {
            font-weight: normal;
        }
        .input-field {
            border-bottom: 1px solid #000;
            min-width: 100px;
            display: inline-block;
        }
        .checkbox-group label {
            margin-right: 15px;
        }
        .signature-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        .signature-table td {
            border: 1px solid #000;
            padding: 10px;
            text-align: center;
        }
        .full-width-line {
            border-bottom: 1px solid #000;
            width: 100%;
            margin-bottom: 10px;
        }
    </style>
</head>
<body>

<div class="page">
    <div class="section-header">APPENDIX D: LEVEL II FIELD EXPERIENCE APPLICATION</div>
    <div class="section-header">Section A: Candidate and Course Information</div>

    <div class="form-row">
        <div class="label">Last Name:</div>
        <div class="input-field"><span data-field="full_name_last">{{ full_name_last }}</span></div>
        <div class="label">First Name:</div>
        <div class="input-field"><span data-field="full_name_first">{{ full_name_first }}</span></div>
        <div class="label">MI:</div>
        <div class="input-field"><span data-field="full_name_mi">{{ full_name_mi }}</span></div>
    </div>

    <div class="form-row">
        <div class="label">NSU ID#:</div>
        <div class="input-field"><span data-field="nsu_id">{{ nsu_id }}</span></div>
        <div class="label">Major Initials (Must Match Program EVAL):</div>
        <div class="input-field"><span data-field="major_initials">{{ major_initials }}</span></div>
    </div>

    <div class="form-row">
        <div class="label">Phone #:</div>
        <div class="input-field"><span data-field="phone_number">{{ phone_number }}</span></div>
        <div class="label">NSU E-mail Address:</div>
        <div class="input-field"><span data-field="nsu_email">{{ nsu_email }}</span></div>
    </div>

    <div class="form-row">
        <div class="label">Cellphone #:</div>
        <div class="input-field"><span data-field="cellphone_number">{{ cellphone_number }}</span></div>
        <div class="label">Alternate E-mail Address:</div>
        <div class="input-field"><span data-field="alternate_email">{{ alternate_email }}</span></div>
    </div>

    <div class="form-row">
        <div class="label">Local Address:</div>
        <div class="input-field" style="flex: 3;"><span data-field="local_address">{{ local_address }}</span></div>
        <div class="label"></div>
        <div class="input-field" style="flex: 1;"><span data-field="city">{{ city }}</span></div>
        <div class="input-field" style="flex: 1;"><span data-field="state">{{ state }}</span></div>
        <div class="input-field" style="flex: 1;"><span data-field="zip_code">{{ zip_code }}</span></div>
    </div>

    <div class="form-row">
        <div class="label">Methods Course:</div>
        <div class="input-field"><span data-field="methods_course">{{ methods_course }}</span></div>
        <div class="label">Methods Course Instructor:</div>
        <div class="input-field"><span data-field="methods_instructor">{{ methods_instructor }}</span></div>
    </div>

    <div class="form-row">
        <div class="label">Gender:</div>
        <div class="checkbox-group">
            <label><input type="radio" name="gender" value="female"> Female</label>
            <label><input type="radio" name="gender" value="male"> Male</label>
            <label><input type="radio" name="gender" value="non_binary"> Non-Binary</label>
        </div>
    </div>

    <div class="form-row">
        <div class="label">Ethnicity:</div>
        <div class="checkbox-group">
            <label><input type="checkbox" name="ethnicity" value="american_indian"> American Indian</label>
            <label><input type="checkbox" name="ethnicity" value="asian"> Asian</label>
            <label><input type="checkbox" name="ethnicity" value="african_american_black"> African American/Black</label>
        </div>
    </div>

    <div class="form-row">
        <div class="label"></div>
        <div class="checkbox-group">
            <label><input type="checkbox" name="ethnicity" value="hawaiian_pacific_islander"> Hawaiian/Pacific Islander</label>
            <label><input type="checkbox" name="ethnicity" value="hispanic_latino/latinex"> Hispanic/Latino/Latinex</label>
            <label><input type="checkbox" name="ethnicity" value="multi_racial"> Multi-Racial</label>
        </div>
    </div>

    <div class="form-row">
        <div class="label"></div>
        <div class="checkbox-group">
            <label><input type="checkbox" name="ethnicity" value="white/caucasian/european_american"> White/Caucasian/European American</label>
        </div>
    </div>

    <div class="form-row">
        <div class="label">Other (Specify):</div>
        <div class="input-field" style="flex: 3;"><span data-field="other_ethnicity_specify">{{ other_ethnicity_specify }}</span></div>
    </div>

    <div class="form-row">
        <div class="label">First Generation College Student?:</div>
        <div class="input-field"><span data-field="first_gen_student">{{ first_gen_student }}</span></div>
        <div class="label">Yes</div>
        <div class="input-field"><span data-field="first_gen_student_yes">{{ first_gen_student_yes }}</span></div>
        <div class="label">No</div>
        <div class="input-field"><span data-field="first_gen_student_no">{{ first_gen_student_no }}</span></div>
    </div>

    <div class="form-row">
        <div class="label">Military Affiliation:</div>
        <div class="checkbox-group">
            <label><input type="checkbox" name="military_affiliation" value="active"> Active</label>
            <label><input type="checkbox" name="military_affiliation" value="dependent"> Dependent</label>
            <label><input type="checkbox" name="military_affiliation" value="retired"> Retired</label>
            <label><input type="checkbox" name="military_affiliation" value="none"> None</label>
        </div>
    </div>

    <div class="form-row">
        <div class="label">English Language Learner:</div>
        <div class="checkbox-group">
            <label><input type="checkbox" name="ell" value="yes"> Yes</label>
            <label><input type="checkbox" name="ell" value="no"> No</label>
        </div>
    </div>

    <div class="section-header">Section B: Employment</div>
    <div class="form-row">
        <div class="label">Are you currently employed within a school division?:</div>
        <div class="input-field"><span data-field="employed_in_school_division">{{ employed_in_school_division }}</span></div>
        <div class="label">Yes</div>
        <div class="input-field"><span data-field="employed_yes">{{ employed_yes }}</span></div>
        <div class="label">No</div>
        <div class="input-field"><span data-field="employed_no">{{ employed_no }}</span></div>
    </div>

    <div class="form-row">
        <div class="label">If yes, please list the district(s):</div>
        <div class="full-width-line" style="flex: 100%;"><span data-field="employment_district_list">{{ employment_district_list }}</span></div>
    </div>

    <div class="section-header">Section D: Placement Information</div>

    <div class="form-row">
        <div class="label">1. Public School Request (LOCAL)</div>
    </div>

    <div class="form-row">
        <div class="label">School Level Preference (check one):</div>
        <div class="checkbox-group">
            <label><input type="checkbox" name="school_level_local" value="elementary"> Elementary</label>
            <label><input type="checkbox" name="school_level_local" value="middle"> Middle</label>
            <label><input type="checkbox" name="school_level_local" value="high"> High</label>
        </div>
    </div>

    <div class="form-row">
        <div class="label">School Preference (name of school):</div>
        <div class="input-field" style="flex: 3;"><span data-field="school_preference_local">{{ school_preference_local }}</span></div>
    </div>

    <div class="form-row">
        <div class="label">School District Preference:</div>
        <div class="input-field" style="flex: 3;"><span data-field="district_preference_local">{{ district_preference_local }}</span></div>
    </div>

    <div class="form-row">
        <div class="label">Grade Level Preference:</div>
        <div class="input-field" style="flex: 3;"><span data-field="grade_level_preference_local">{{ grade_level_preference_local }}</span></div>
    </div>

    <div class="form-row">
        <div class="label">Subject/Content Area Preference:</div>
        <div class="input-field" style="flex: 3;"><span data-field="subject_area_preference_local">{{ subject_area_preference_local }}</span></div>
    </div>

    <div class="form-row">
        <div class="label">2. Public School Request (outside of HAMPTON ROADS)</div>
    </div>

    <div class="form-row">
        <div class="label">School Level Preference (check one):</div>
        <div class="checkbox-group">
            <label><input type="checkbox" name="school_level_outside" value="elementary"> Elementary</label>
            <label><input type="checkbox" name="school_level_outside" value="middle"> Middle</label>
            <label><input type="checkbox" name="school_level_outside" value="high"> High</label>
        </div>
    </div>

    <div class="form-row">
        <div class="label">School Preference (name of school):</div>
        <div class="input-field" style="flex: 3;"><span data-field="school_preference_outside">{{ school_preference_outside }}</span></div>
    </div>

    <div class="form-row">
        <div class="label">School District Preference:</div>
        <div class="input-field" style="flex: 3;"><span data-field="district_preference_outside">{{ district_preference_outside }}</span></div>
    </div>

    <div class="form-row">
        <div class="label">Grade Level Preference:</div>
        <div class="input-field" style="flex: 3;"><span data-field="grade_level_preference_outside">{{ grade_level_preference_outside }}</span></div>
    </div>

    <div class="form-row">
        <div class="label">Subject/Content Area Preference:</div>
        <div class="input-field" style="flex: 3;"><span data-field="subject_area_preference_outside">{{ subject_area_preference_outside }}</span></div>
    </div>

    <div class="form-row" style="margin-top: 40px;">
        <div class="label">Initial next to each statement after reading: (INITIALS MUST BE TYPED. SIGNATURES MUST BE HANDWRITTEN OR DOCUSIGNED) No checkmarks, please.</div>
    </div>

    <div class="form-row" style="margin-top: 20px;">
        <div class="full-width-line" style="flex: 100%;"><span data-field="statement_1_initials">{{ statement_1_initials }}</span> I have read both the OCESS Reminders and Guidelines for a field experience.</div>
    </div>

    <div class="form-row" style="margin-top: 10px;">
        <div class="full-width-line" style="flex: 100%;"><span data-field="statement_2_initials">{{ statement_2_initials }}</span> I understand that I am responsible for abiding by these guidelines throughout my entire experience.</div>
    </div>

    <div class="form-row" style="margin-top: 10px;">
        <div class="full-width-line" style="flex: 100%;"><span data-field="statement_3_initials">{{ statement_3_initials }}</span> I have attached the corresponding city form (applicable only for Virginia Beach, Norfolk, Suffolk, or Chesapeake school division requests).</div>
    </div>

    <div class="form-row" style="margin-top: 10px;">
        <div class="full-width-line" style="flex: 100%;"><span data-field="statement_4_initials">{{ statement_4_initials }}</span> I have either attached a current, negative TB test and/or a current, negative TB test is already on file with the OCESS.</div>
    </div>

    <div class="form-row" style="margin-top: 10px;">
        <div class="full-width-line" style="flex: 100%;"><span data-field="statement_5_initials">{{ statement_5_initials }}</span> I have attached the COVID-19 Acknowledgment of Risk form.</div>
    </div>

    <div class="form-row" style="margin-top: 10px;">
        <div class="full-width-line" style="flex: 100%;"><span data-field="statement_6_initials">{{ statement_6_initials }}</span> I have attached the VA HB1 waiver form.</div>
    </div>

    <div class="form-row" style="margin-top: 10px;">
        <div class="full-width-line" style="flex: 100%;"><span data-field="statement_7_initials">{{ statement_7_initials }}</span> I have attached my Level I Field Experience Record</div>
    </div>
</div>

<div class="page">
    <div class="section-header" style="text-align: center;">Background Verification Form</div>
    <div class="section-header" style="text-align: center;">Addendum to Field Experience</div>

    <div class="form-row" style="margin-top: 20px;">
        <div class="label" style="flex: 1;">Verification Form Directions: Read the 4 statements below carefully and then print your <span data-field="full_name">{{ full_name }}</span>, add your signature and <span data-field="date">{{ date }}</span> below the statement you can verify. Ensure you add only <span data-field="one">{{ one }}</span> signature and date. The form will need to be resubmitted if two signatures are noted.</div>
    </div>

    <div class="form-row" style="margin-top: 20px;">
        <div class="label" style="flex: 1;">I have not been convicted of a violation of law other than a minor traffic violation.</div>
    </div>

    <div class="form-row" style="margin-top: 10px;">
        <div class="label" style="flex: 1;">I do not have any criminal charges or proceedings pending against me.</div>
    </div>

    <div class="form-row" style="margin-top: 10px;">
        <div class="label" style="flex: 1;">I do not have a felony, misdemeanor, or other offense for drugs, sexual abuse, and/or child abuse.</div>
    </div>

    <div class="form-row" style="margin-top: 10px;">
        <div class="label" style="flex: 1;">I understand that if the above-mentioned conditions are violated, it can result in cancellation of the field experience.</div>
    </div>

    <div class="form-row" style="margin-top: 30px;">
        <div class="label" style="flex: 1;">Application Directions: Only verify ONE statement that is applicable to you regarding the 4 statements above. When submitting requests for field placements by your <span data-field="signature">{{ signature }}</span> and the <span data-field="date">{{ date }}</span> to the correct statement. The Background Verification Form will need to be redone if two signatures are noted.</div>
    </div>

    <div class="form-row" style="margin-top: 30px;">
        <div class="label" style="flex: 1;">Statement A: If you are able to verify the above statements when submitting requests for field placements, please sign and date below:</div>
    </div>

    <table class="signature-table">
        <tr>
            <td style="width: 33%;">Print Name: <span data-field="print_name_a">{{ print_name_a }}</span></td>
            <td style="width: 33%;">Signature: <span data-field="signature_a">{{ signature_a }}</span></td>
            <td style="width: 33%;">Date: <span data-field="date_a">{{ date_a }}</span></td>
        </tr>
    </table>

    <div class="form-row" style="margin-top: 40px;">
        <div class="label" style="flex: 1;">Statement B: If you are unable to verify one or more of the above statements, please give a brief explanation below and schedule a conference with the Director, OCESS. Please sign and date below text box:</div>
    </div>

    <div class="form-row" style="margin-top: 10px;">
        <div class="full-width-line" style="flex: 100%;"><span data-field="student_comments">{{ student_comments }}</span></div>
    </div>

    <table class="signature-table" style="margin-top: 50px;">
        <tr>
            <td style="width: 33%;">Print Name: <span data-field="print_name_b">{{ print_name_b }}</span></td>
            <td style="width: 33%;">Signature: <span data-field="signature_b">{{ signature_b }}</span></td>
            <td style="width: 33%;">Date: <span data-field="date_b">{{ date_b }}</span></td>
        </tr>
    </table>
</div>

</body>
</html>