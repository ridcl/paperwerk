<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1, h2, h3 { text-align: center; }
  table { width: 100%; border-collapse: collapse; margin-top: 20px; }
  th, td { border: 1px solid #ccc; padding: 8px; text-align: left; }
  .signature-line { border-bottom: 1px solid black; margin-bottom: 30px; width: 50%; }
</style>

<div class="page">
  <!-- Header/Logo Area -->
  <div style="text-align: center; margin-bottom: 40px;">
    <h1 style="font-size: 36pt; margin: 0;">Creighton</h1>
    <h2 style="font-size: 24pt; margin: 0;">UNIVERSITY</h2>
  </div>

  <!-- Title Block -->
  <div style="text-align: center; margin-bottom: 30px;">
    <h3 style="font-size: 14pt; margin-bottom: 5px;">STUDENT FELLOWSHIP/DEPARTMENTAL SCHOLARSHIP</h3>
    <h2 style="font-size: 18pt; margin-top: 0;">PAYMENT REQUEST FORM</h2>
  </div>

  <!-- Introductory Text -->
  <p style="text-align: justify; margin-bottom: 30px;">
    This form is required to make a payment to a <span data-field="institution_name">{{ institution_name }}</span> student for a fellowship or a departmental scholarship.
  </p>

  <!-- Instructions -->
  <p style="text-align: justify; margin-bottom: 20px;">
    Please complete this form accurately and in its entirety. Please allow five days for processing.
  </p>

  <!-- Data Table -->
  <table>
    <thead>
      <tr>
        <th style="width: 15%;">NET ID</th>
        <th style="width: 25%;">Last Name</th>
        <th style="width: 25%;">First Name</th>
        <th style="width: 15%;">Date of Payment</th>
        <th style="width: 10%;">Amount</th>
        <th style="width: 15%;">Fund</th>
        <th style="width: 15%;">Org</th>
      </tr>
    </thead>
    <tbody>
      <!-- Placeholder rows for data entry -->
      <tr>
        <td><span data-field="net_id_1">{{ net_id_1 }}</span></td>
        <td><span data-field="last_name_1">{{ last_name_1 }}</span></td>
        <td><span data-field="first_name_1">{{ first_name_1 }}</span></td>
        <td><span data-field="date_of_payment_1">{{ date_of_payment_1 }}</span></td>
        <td><span data-field="amount_1">{{ amount_1 }}</span></td>
        <td><span data-field="fund_1">{{ fund_1 }}</span></td>
        <td><span data-field="org_1">{{ org_1 }}</span></td>
      </tr>
      <tr>
        <td><span data-field="net_id_2">{{ net_id_2 }}</span></td>
        <td><span data-field="last_name_2">{{ last_name_2 }}</span></td>
        <td><span data-field="first_name_2">{{ first_name_2 }}</span></td>
        <td><span data-field="date_of_payment_2">{{ date_of_payment_2 }}</span></td>
        <td><span data-field="amount_2">{{ amount_2 }}</span></td>
        <td><span data-field="fund_2">{{ fund_2 }}</span></td>
        <td><span data-field="org_2">{{ org_2 }}</span></td>
      </tr>
      <tr>
        <td><span data-field="net_id_3">{{ net_id_3 }}</span></td>
        <td><span data-field="last_name_3">{{ last_name_3 }}</span></td>
        <td><span data-field="first_name_3">{{ first_name_3 }}</span></td>
        <td><span data-field="date_of_payment_3">{{ date_of_payment_3 }}</span></td>
        <td><span data-field="amount_3">{{ amount_3 }}</span></td>
        <td><span data-field="fund_3">{{ fund_3 }}</span></td>
        <td><span data-field="org_3">{{ org_3 }}</span></td>
      </tr>
      <tr>
        <td><span data-field="net_id_4">{{ net_id_4 }}</span></td>
        <td><span data-field="last_name_4">{{ last_name_4 }}</span></td>
        <td><span data-field="first_name_4">{{ first_name_4 }}</span></td>
        <td><span data-field="date_of_payment_4">{{ date_of_payment_4 }}</span></td>
        <td><span data-field="amount_4">{{ amount_4 }}</span></td>
        <td><span data-field="fund_4">{{ fund_4 }}</span></td>
        <td><span data-field="org_4">{{ org_4 }}</span></td>
      </tr>
    </tbody>
  </table>

  <!-- Funding Note -->
  <p style="margin-top: 40px; font-size: 10pt; text-align: justify;">
    If funding is from a "2 fund" please route through <span data-field="grants_accounting_email">{{ grants_accounting_email }}</span> for approval, otherwise send to <span data-field="contact_name_1">{{ contact_name_1 }}</span> and <span data-field="contact_name_2">{{ contact_name_2 }}</span>.
  </p>

  <!-- Authorization Section -->
  <div style="margin-top: 50px;">
    <p style="font-weight: bold; margin-bottom: 15px;">AUTHORIZATION OF PAYMENT. Principal Investigator's signature is required.</p>

    <table style="width: 100%;">
      <tr>
        <td style="width: 50%; padding-bottom: 10px;">Principal Investigator Signature</td>
        <td style="width: 50%; padding-bottom: 10px;">Date</td>
      </tr>
      <tr>
        <td style="padding-top: 50px;"></td>
        <td style="padding-top: 50px;"></td>
      </tr>
    </table>

    <p style="margin-top: 40px;">
      Print Name: <span data-field="pi_print_name">{{ pi_print_name }}</span>
    </p>
  </div>

  <!-- Disclaimer -->
  <p style="margin-top: 50px; font-size: 10pt; text-align: justify;">
    If student does not perform duties, the Principal Investigator is responsible for notifying the administrator.
  </p>

</div>