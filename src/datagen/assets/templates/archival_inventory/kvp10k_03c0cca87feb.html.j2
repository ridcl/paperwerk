<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1, h2, h3 { text-align: center; margin-top: 0; }
  .center-text { text-align: center; }
  .right-align { text-align: right; }
  table { width: 100%; border-collapse: collapse; margin-top: 20px; }
  th, td { padding: 8px; text-align: left; border-bottom: 1px solid #ccc; }
  .divider { border-top: 1px solid black; margin: 20px 0; }
</style>
<div class="page">
  <div class="center-text">
    <span data-field="institution_name">{{ institution_name }}</span>
    <div style="margin: 20px 0;">
      <!-- Placeholder for logo -->
      <img src="" alt="Logo" style="width: 100px; height: auto;">
    </div>
    <span data-field="archives_center_name">{{ archives_center_name }}</span>
  </div>
  <div class="center-text" style="margin-top: 50px;">
    <span data-field="guide_title">{{ guide_title }}</span>
    <span data-field="office_name">{{ office_name }}</span>
    <span data-field="record_name">{{ record_name }}</span>
    <span data-field="date_range">{{ date_range }}</span>
  </div>
  <div class="center-text" style="margin-top: 30px;">
    <span data-field="volume_size">{{ volume_size }}</span>
  </div>
  <div class="center-text" style="margin-top: 10px;">
    <span data-field="upa_number">{{ upa_number }}</span>
  </div>
</div>

<div class="page">
  <div style="text-align: left;">
    <span data-field="archives_center_name">{{ archives_center_name }}</span>
    <div style="margin-top: 10px;">
      <span data-field="street_address">{{ street_address }}</span><br>
      <span data-field="city_state_zip">{{ city_state_zip }}</span><br>
      <span data-field="phone">{{ phone }}</span><br>
      <span data-field="fax">{{ fax }}</span><br>
      <span data-field="website">{{ website }}</span><br>
      <span data-field="director_name">{{ director_name }}</span>
    </div>
  </div>
</div>

<div class="page">
  <div class="center-text">
    <span data-field="office_name">{{ office_name }}</span>
    <span data-field="upa_number">{{ upa_number }}</span>
  </div>
  <div class="center-text" style="margin-top: 20px;">
    <span data-field="scope_summary">Access is granted in accordance with the <span data-field="protocols_link">{{ scope_summary">Access is granted in accordance with the <span data-field= }}</span>.</span>
  </div>
  <div class="divider"></div>
  <div class="center-text" style="margin-top: 30px;">
    <span data-field="section_title">{{ section_title }}</span>
  </div>
  <div class="center-text" style="margin-top: 20px;">
    <span data-field="scope_description">One Hollinger box containing files of {{ record_name }}, 1951-1955, when he served concurrently as Acting Chairman of the Committee on the Organization for Civilian Defense</span>
  </div>
</div>

<div class="page">
  <div class="center-text" style="margin-top: 20px;">
    <span data-field="table_of_contents_title">{{ table_of_contents_title }}</span>
  </div>
  <table style="width: 100%; margin-top: 20px;">
    <tr>
      <td style="width: 70%;">SCOPE AND CONTENT NOTE</td>
      <td class="right-align">1</td>
    </tr>
    <tr>
      <td>INVENTORY</td>
      <td class="right-align">2</td>
    </tr>
    <tr>
      <td>INVENTORY</td>
      <td class="right-align">2</td>
    </tr>
  </table>
</div>

<div class="page">
  <div class="center-text" style="margin-top: 20px;">
    <span data-field="office_name">{{ office_name }}</span>
    <span data-field="upa_number">{{ upa_number }}</span>
  </div>
  <div class="center-text" style="margin-top: 10px;">
    <span data-field="protocols_link">{{ protocols_link }}</span>
  </div>
  <div class="divider"></div>
  <div class="center-text" style="margin-top: 30px;">
    <span data-field="section_title">{{ section_title }}</span>
  </div>
  <table>
    <thead>
      <tr>
        <th style="width: 50%;"></th>
        <th style="width: 20%;">Box</th>
        <th style="width: 30%;">Folder</th>
      </tr>
    </thead>
    <tbody>
      {% for item in inventory_items %}
      <tr>
        <td><span data-field="inventory_items[{{ loop.index0 }}].description">{{ item.description }}</span></td>
        <td><span data-field="inventory_items[{{ loop.index0 }}].box">{{ item.box }}</span></td>
        <td><span data-field="inventory_items[{{ loop.index0 }}].folder">{{ item.folder }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>