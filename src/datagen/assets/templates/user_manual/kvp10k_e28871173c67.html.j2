            <li>Quiescent Current: <span data-field="quiescent_current">{{ quiescent_current }}</span></li>
            <li>Working Current: <span data-field="working_current">{{ working_current }}</span></li>
            <li>Effective Angle: <span data-field="effective_angle">{{ effective_angle }}</span></li>
            <li>Ranging Distance: <span data-field="ranging_distance">{{ ranging_distance }}</span></li>
            <li>Resolution: <span data-field="resolution">{{ resolution }}</span></li>
            <li>Measuring Angle: <span data-field="measuring_angle">{{ measuring_angle }}</span></li>
            <li>Trigger Input Pulse width: <span data-field="trigger_pulse_width">{{ trigger_pulse_width }}</span></li>
            <li>Dimension: <span data-field="dimension">{{ dimension }}</span></li>
        </ul>
    </div>
    <div class="footer">Created by <span data-field="company_name">{{ company_name }}</span> Sdn. Bhd. – All Rights Reserved</div>
    <div class="footer" style="text-align: right;">3</div>
