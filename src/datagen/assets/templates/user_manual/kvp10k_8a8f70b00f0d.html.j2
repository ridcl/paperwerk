        <td style="text-align: center;"><input type="number" value="100" min="0" max="100"></td>
        <td style="text-align: center;"><input type="number" value="75" min="0" max="100"></td>
        <td style="text-align: center;"><input type="number" value="100" min="0" max="100"></td>
      </tr>
      <tr>
