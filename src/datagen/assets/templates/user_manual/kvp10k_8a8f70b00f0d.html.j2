<div class="page">
  <h3>9.2 Operation</h3>

  <h4 style="margin-top: 1em;">9.2.1 Torque / Force</h4>
  <div style="border: 1px solid #ccc; padding: 15px; margin-bottom: 20px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
