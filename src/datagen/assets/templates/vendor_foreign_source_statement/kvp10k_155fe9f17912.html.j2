<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1, h2 { text-align: center; margin-bottom: 0.5em; }
  .header-bar { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid #ccc; }
  .content-section { margin-bottom: 20px; }
  .label { font-weight: bold; display: inline-block; width: 150px; }
  .value { display: inline-block; }
  hr { border: 0; border-top: 1px solid #ccc; margin: 20px 0; }
</style>

<div class="page">
  <div style="text-align: center; margin-bottom: 30px;">
    <span style="font-size: 18pt; font-weight: bold;">EMORY UNIVERSITY</span>
    <span style="font-size: 10pt;">Office of International & Summer Programs Abroad</span>
  </div>

  <div class="content-section">
    <h2 style="text-align: center; margin-bottom: 10px;">VENDOR FOREIGN SOURCE STATEMENT</h2>
    <p>Office of Int'l & Summer Programs will provide goods/services to Emory University</p>
    <p>Vendor name</p>
    <p>according to the attached invoice provided by the establishment listed above.</p>
    <p>All goods/services provided to Emory will be provided/performed in <span data-field="country">{{ country }}</span></p>
  </div>

  <hr>

  <div class="content-section">
    <p>Print Name: <span data-field="full_name">{{ full_name }}</span></p>
    <p>Signature: SIGN HERE</p>
  </div>

  <div class="content-section">
    <p>Contact Email: <span data-field="contact_email">{{ contact_email }}</span></p>
    <p>Contact Phone: <span data-field="contact_phone">{{ contact_phone }}</span></p>
  </div>

  <div class="content-section">
    <p>PAYMENT DISBURSEMENT INSTRUCTIONS</p>
    <p>Please complete and provide the requested information below. Payment terms: Net 30 days</p>
    <p>Wire</p>
  </div>

  <hr>

  <div class="content-section">
    <p>Bank Name: <span data-field="bank_name">{{ bank_name }}</span></p>
    <p>Branch Name & Address: <span data-field="branch_address">{{ branch_address }}</span></p>
    <p>Bank ID & Branch ID: <span data-field="bank_id">{{ bank_id }}</span></p>
    <p>IBAN Number: <span data-field="iban_number">{{ iban_number }}</span></p>
    <p>Swift Code: <span data-field="swift_code">{{ swift_code }}</span></p>
    <p>Account Name: <span data-field="account_name">{{ account_name }}</span></p>
    <p>Bank Account Number: <span data-field="account_number">{{ account_number }}</span></p>
    <p>Currency Type: <span data-field="currency_type">{{ currency_type }}</span></p>
    <p>Amount: <span data-field="amount">{{ amount }}</span></p>
  </div>

  <div class="content-section" style="margin-top: 40px;">
    <p>Please email form: <span data-field="email">{{ email }}</span></p>
    <p>Accounting Department</p>
    <p>Office of International & Summer Programs Abroad, <span data-field="address">{{ address }}</span></p>
  </div>
</div>