<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1, h2 { font-weight: bold; }
  .form-section { margin-bottom: 20px; }
  .input-line { border-bottom: 1px solid #000; margin-bottom: 10px; }
  .checkbox-group label { margin-right: 15px; }
</style>

<div class="page">
  <header style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px;">
    <div>
      <h1 style="font-size: 24pt; margin: 0;">
        <span style="font-weight: bold;">S</span>
        <span style="font-size: 18pt;">Stanislaus</span>
      </h1>
      <p style="font-size: 10pt; margin: 2px 0;">FINANCIAL AID AND SCHOLARSHIP OFFICE</p>
    </div>
    <div style="text-align: right; font-size: 10pt;">
      <p style="margin: 0;">One University Circle, <span data-field="city">{{ city }}</span>, <span data-field="state">{{ state }}</span> <span data-field="zip">{{ zip }}</span></p>
      <p style="margin: 2px 0;">Telephone: <span data-field="phone">{{ phone }}</span> • Fax: <span data-field="fax">{{ fax }}</span></p>
    </div>
  </header>

  <h2 style="font-size: 16pt; margin-bottom: 20px;">2023-2024 Scholarship Recommendation Form</h2>

  <div class="form-section">
    <p>STUDENT INFORMATION:</p>
    <div style="display: flex; justify-content: space-between; margin-top: 15px;">
      <div style="width: 45%;">
        Student Name: <div class="input-line" style="width: 100%;" data-field="student_information">{{ student_information }}</div>
      </div>
      <div style="width: 45%; text-align: right;">
        Warrior ID#: <div class="input-line" style="width: 100%;" data-field="student_name">{{ student_name }}</div>
      </div>
    </div>
    <div style="display: flex; justify-content: space-between; margin-top: 15px;">
      <div style="width: 45%;">
        Phone #: <div class="input-line" style="width: 100%;" data-field="warrior_id">{{ warrior_id }}</div>
      </div>
      <div style="width: 45%; text-align: right;">
        Email: <div class="input-line" style="width: 100%;" data-field="phone_2">{{ phone_2 }}</div>
      </div>
    </div>
  </div>

  <div class="form-section">
    <p>RECOMMENDATION: To be completed by person providing recommendation.</p>

    <div style="margin-top: 20px;">
      <p>How long have you known the applicant? <div class="input-line" style="width: 80%;" data-field="email">{{ email }}</div></p>
      <p>In what capacity have you known this applicant? <div class="input-line" style="width: 80%;" data-field="field_1">{{ field_1 }}</div></p>
    </div>

    <div style="margin-top: 20px;">
      <p>Please indicate below, your personal rating of the applicant:</p>
      
      <div style="margin-top: 10px;">
        <p>Academic Performance:</p>
        <div class="checkbox-group" style="margin-top: 5px;">
          <label><input type="checkbox"> Outstanding</label>
          <label><input type="checkbox"> Excellent</label>
          <label><input type="checkbox"> Good</label>
          <label><input type="checkbox"> Average</label>
        </div>
      </div>

      <div style="margin-top: 15px;">
        <p>Dependability:</p>
        <div class="checkbox-group" style="margin-top: 5px;">
          <label><input type="checkbox"> Outstanding</label>
          <label><input type="checkbox"> Excellent</label>
          <label><input type="checkbox"> Good</label>
          <label><input type="checkbox"> Average</label>
        </div>
      </div>

      <div style="margin-top: 15px;">
        <p>Motivation:</p>
        <div class="checkbox-group" style="margin-top: 5px;">
          <label><input type="checkbox"> Outstanding</label>
          <label><input type="checkbox"> Excellent</label>
          <label><input type="checkbox"> Good</label>
          <label><input type="checkbox"> Average</label>
        </div>
      </div>

      <div style="margin-top: 15px;">
        <p>Leadership:</p>
        <div class="checkbox-group" style="margin-top: 5px;">
          <label><input type="checkbox"> Outstanding</label>
          <label><input type="checkbox"> Excellent</label>
          <label><input type="checkbox"> Good</label>
          <label><input type="checkbox"> Average</label>
        </div>
      </div>
    </div>

    <div style="margin-top: 20px;">
      <p>Please explain what you know about the applicant and why he/she is deserving of a scholarship.</p>
      <div style="border: 1px solid #000; height: 150px; padding: 10px;">
        <!-- Text area placeholder -->
      </div>
    </div>

    <div style="margin-top: 20px;">
      <p>Please comment on any exceptional scholastic abilities and/or other accomplishments exhibited by the student.</p>
      <div style="border: 1px solid #000; height: 150px; padding: 10px;">
        <!-- Text area placeholder -->
      </div>
    </div>
  </div>

  <div style="display: flex; justify-content: space-between; margin-top: 40px;">
    <div style="width: 45%;">
      Signature: <div class="input-line" style="width: 80%;" data-field="field_2">{{ field_2 }}</div>
      Printed Name: <div class="input-line" style="width: 80%;" data-field="signature">{{ signature }}</div>
      E-mail Address: <div class="input-line" style="width: 80%;" data-field="printed_name">{{ printed_name }}</div>
    </div>
    <div style="width: 45%; text-align: right;">
      Date: <div class="input-line" style="width: 80%;" data-field="e_mail_address">{{ e_mail_address }}</div>
      Title: <div class="input-line" style="width: 80%;" data-field="date">{{ date }}</div>
      Phone: <div class="input-line" style="width: 80%;" data-field="title">{{ title }}</div>
    </div>
  </div>

  <div style="margin-top: 50px; font-size: 10pt;">
    <p>All Scholarship Recommendation Forms must be uploaded to a student's scholarship application by <span data-field="deadline">{{ deadline }}</span> for scholarship consideration.</p>
    <p style="margin-top: 15px; font-weight: bold;">IMPORTANT: Recommenders are NOT required to complete this form and may choose to submit their recommendation on letterhead instead.</p>
  </div>
</div>