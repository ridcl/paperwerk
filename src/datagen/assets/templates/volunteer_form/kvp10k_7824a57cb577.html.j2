<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  /* Basic styling to mimic document structure */
  .header-info {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 40px;
  }
  .logo {
    /* Placeholder for logo visual */
    width: 150px;
    height: auto;
  }
  .contact-info {
    text-align: right;
    font-size: 12pt;
  }
  .form-section {
    margin-bottom: 30px;
  }
  .form-label {
    display: block;
    margin-bottom: 5px;
    font-weight: bold;
  }
  .form-field-line {
    border-bottom: 1px solid black;
    margin-top: 2px;
    margin-bottom: 15px;
    width: 100%;
  }
  .signature-area {
    margin-top: 80px;
    display: flex;
    justify-content: space-between;
    width: 100%;
  }
  .signature-line {
    border-bottom: 1px solid black;
    width: 40%;
    margin-top: 5px;
  }
</style>

<div class="page">
  <div class="header-info">
    <!-- Logo Placeholder -->
    <div class="logo">
      <!-- Visual representation of the logo -->
    </div>
    <div class="contact-info">
      <span data-field="school.name">{{ school.name }}</span><br>
      <span data-field="school.address_line1">{{ school.address_line1 }}</span><br>
      <span data-field="school.address_line2">{{ school.address_line2 }}</span><br>
      Phone: <span data-field="school.phone">{{ school.phone }}</span><br>
      Fax: <span data-field="school.fax">{{ school.fax }}</span>
    </div>
  </div>

  <h1 style="text-align: center; margin-bottom: 40px;">Community Service Volunteer Form</h1>

  <div class="form-section">
    <span class="form-label">Student Name:</span>
    <div class="form-field-line">
      <span data-field="student_name">{{ student_name }}</span>
    </div>
  </div>

  <div class="form-section">
    <span class="form-label">Community Organization:</span>
    <div class="form-field-line">
      <span data-field="community_organization">{{ community_organization }}</span>
    </div>
  </div>

  <div class="form-section">
    <span class="form-label">Address:</span>
    <div class="form-field-line">
      <span data-field="address">{{ address }}</span>
    </div>
  </div>

  <div class="form-section">
    <span class="form-label">Phone:</span>
    <div class="form-field-line">
      <span data-field="phone">{{ phone }}</span>
    </div>
  </div>

  <div class="form-section">
    <span class="form-label">Date Service was Performed:</span>
    <div class="form-field-line">
      <span data-field="date_performed">{{ date_performed }}</span>
    </div>
  </div>

  <div class="form-section">
    <span class="form-label">Hours:</span>
    <div class="form-field-line">
      <span data-field="hours">{{ hours }}</span>
    </div>
  </div>

  <div class="signature-area">
    <div>
      <span class="form-label" style="margin-bottom: 0;">Signature of Organizer (cannot be a family member)</span>
      <div class="signature-line" data-field="signature_of_organizer">{{ signature_of_organizer }}</div>
    </div>
    <div>
      <span class="form-label" style="margin-bottom: 0;">Volunteer Signature</span>
      <div class="signature-line" data-field="volunteer_signature">{{ volunteer_signature }}</div>
      <div style="margin-top: 5px;">Date</div>
      <div class="signature-line" style="width: 100%;" data-field="date">{{ date }}</div>
    </div>
  </div>
</div>