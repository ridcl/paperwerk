    </div>
    <div style="font-size: 12pt;">
      <div class="label">TEL:</div>
      <div class="value">{{ sender_phone_full }}</div>
    </div>
    <div style="font-size: 12pt;">
      <div class="label">FAX:</div>
      <div class="value">{{ sender_fax_full }}</div>
    </div>
  </div>
</div>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div style="font-size: 14pt; font-weight: bold;">Book a Flight at Delta.com</div>
    <div style="font-size: 14pt; font-weight: bold;">Work</div>
    <div style="font-size: 14pt; font-weight: bold;">Japan</div>
    <div style="font-size: 14pt; font-weight: bold;">Yamasa</div>
  </div>

  <div style="margin-top: 30px;">
    <p style="font-size: 12pt;">Your purchase is complete. Thank you for choosing Delta.</p>
  </div>

  <div class="section-title">What's Next</div>
  <ul style="font-size: 11pt; line-height: 1.5;">
    <li><span data-field="next_step_1">Your e-tickets, confirmations, receipts, and flight notifications will be emailed to you at {{ email_address }}.</span></li>
    <li><span data-field="next_step_2">{{ next_step_2 }}</span></li>
    <li><span data-field="next_step_3">{{ next_step_3 }}</span></li>
  </ul>

  <div style="margin-top: 30px;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
      <div style="font-size: 12pt;">
        <div style="font-weight: bold;">Print</div>
      </div>
      <div style="font-size: 12pt;">
        <div style="font-weight: bold;">Get Notifications</div>
        <div style="font-weight: bold;">Add to Calendar</div>
        <div style="font-weight: bold;">Add Trip Services & Activities</div>
      </div>
    </div>
  </div>

  <div class="section-title" style="margin-top: 30px;">Your Flight Selection:</div>
  <table>
    <thead>
      <tr>
        <th style="width: 15%;">Departs</th>
        <th style="width: 15%;">Arrives</th>
        <th style="width: 20%;">Stops</th>
        <th style="width: 20%;">Flight & Cabin (Class)</th>
        <th style="width: 15%;">Travel Time</th>
        <th style="width: 15%;"></th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>{{ departure_time_1 }}</td>
        <td>{{ arrival_time_1 }}</td>
        <td>{{ stops_1 }}</td>
        <td>{{ flight_cabin_1 }}</td>
        <td>{{ travel_time_1 }}</td>
        <td></td>
      </tr>
      <tr>
        <td>{{ departure_time_2 }}</td>
        <td>{{ arrival_time_2 }}</td>
        <td>{{ stops_2 }}</td>
        <td>{{ flight_cabin_2 }}</td>
        <td>{{ travel_time_2 }}</td>
        <td></td>
      </tr>
      {% for flight in flight_options %}
      <tr>
        <td>{{ flight.departure_time }}</td>
        <td>{{ flight.arrival_time }}</td>
        <td>{{ flight.stops }}</td>
        <td>{{ flight.flight_cabin }}</td>
        <td>{{ flight.travel_time }}</td>
        <td></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div style="margin-top: 30px;">
    <div style="font-size: 12pt;">
      <div class="label">Passenger Information</div>
      <div style="display: flex; justify-content: space-between; margin-top: 10px;">
        <div style="width: 50%;">
          <div class="label">From:</div>
          <div class="value">{{ passenger_from }}</div>
        </div>
        <div style="width: 50%;">
          <div class="label">To:</div>
          <div class="value">{{ passenger_to }}</div>
        </div>
      </div>
      <div style="display: flex; justify-content: space-between; margin-top: 10px;">
        <div style="width: 50%;">
          <div class="label">City, State:</div>
          <div class="value">{{ passenger_city_state }}</div>
        </div>
        <div style="width: 50%;">
          <div class="label">City, State:</div>
          <div class="value">{{ passenger_city_state_2 }}</div>
        </div>
      </div>
    </div>
  </div>

  <div class="section-title" style="margin-top: 30px;">Passenger Information</div>
  <table>
    <thead>
      <tr>
        <th style="width: 20%;">Passenger</th>
        <th style="width: 20%;">From</th>
        <th style="width: 20%;">To</th>
        <th style="width: 15%;">Seat</th>
        <th style="width: 15%;">Change Seats</th>
        <th style="width: 10%;">Add/Edit</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>{{ passenger_name_1 }}</td>
        <td>{{ passenger_from_1 }}</td>
        <td>{{ passenger_to_1 }}</td>
        <td>{{ seat_1 }}</td>
        <td><span data-field="change_seats_1">{{ change_seats_1 }}</span></td>
        <td><span data-field="add_edit_1">{{ add_edit_1 }}</span></td>
      </tr>
      {% for passenger in passengers %}
      <tr>
        <td>{{ passenger.name }}</td>
        <td>{{ passenger.from }}</td>
        <td>{{ passenger.to }}</td>
        <td>{{ passenger.seat }}</td>
        <td><span data-field="change_seats_{{ loop.index0 }}">{{ 'Change Seats' }}</span></td>
        <td><span data-field="add_edit_{{ loop.index0 }}">{{ 'Add/Edit' }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="section-title" style="margin-top: 30px;">Billing Information</div>
  <table>
    <thead>
      <tr>
        <th style="width: 20%;">Contact</th>
        <th style="width: 20%;">Billing Information</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><div class="label">Telephone number:</div> <div class="value">{{ contact_phone }}</div></td>
        <td><div class="label">Payment Type:</div> <div class="value">{{ payment_type }}</div></td>
      </tr>
    </tbody>
  </table>
</div>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div style="font-size: 12pt;"></div>
    <div style="font-size: 12pt;">Page 2 of 2</div>
  </div>

  <div class="section-title" style="margin-top: 40px;">Price per Passenger</div>
  <table>
    <thead>
      <tr>
        <th style="width: 30%;">Fare</th>
        <th style="width: 20%;">U.S. Tax(es)</th>
        <th style="width: 20%;">Base Fare</th>
        <th style="width: 20%;">Taxes/Fees</th>
        <th style="width: 10%;">Subtotal</th>
        <th style="width: 10%;"># of Pegs</th>
        <th style="width: 10%;">Total Price of Ticket(s)</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>{{ fare_amount }}</td>
        <td>{{ us_tax_amount }}</td>
        <td>{{ base_fare_amount }}</td>
        <td>{{ taxes_fees_amount }}</td>
        <td>{{ subtotal_amount }}</td>
        <td>1</td>
        <td>{{ total_price_amount }}</td>
      </tr>
    </tbody>
  </table>

  <div style="margin-top: 20px;">
    <div style="font-size: 12pt;">Total Amounts Charged:</div>
    <div style="font-size: 14pt; font-weight: bold;">{{ total_amounts_charged }}</div>
  </div>

  <div style="margin-top: 30px;">
    <div style="font-size: 12pt;">A Greener Way to Fly</div>
    <p style="font-size: 10pt;">Delta Air Lines has partnered with The Nature Conservancy® to help you offset your carbon footprint for this trip and offer you other ways to sustain our environment.</p>
    <div style="float: right; font-size: 10pt;"><a href="#" style="text-decoration: none;">Learn More</a></div>
  </div>

  <div style="margin-top: 50px; font-size: 10pt; text-align: center;">
    ©2010 Delta Air Lines, Inc.
  </div>
</div></body>
</html>