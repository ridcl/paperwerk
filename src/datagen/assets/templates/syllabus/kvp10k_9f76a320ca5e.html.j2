<!DOCTYPE html>
<html>
<head>
<title>Course Syllabus</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { margin-top: 0; }
  table { width: 100%; border-collapse: collapse; margin-top: 15px; }
  th, td { padding: 8px; text-align: left; border-bottom: 1px solid #ddd; }
  th { background-color: #f2f2f2; }
</style>
</head>
<body>
<div class="page">
  <div style="text-align: center; margin-bottom: 40px;">
    <h1 style="font-size: 24pt;">San José State University</h1>
    <h2 style="font-size: 18pt;">Animation/Illustration – Department of Design</h2>
    <h3 style="font-size: 14pt;">ANI 134, Animation Production II – Intermediate Storyboarding Sec 01, SP2022</h3>
  </div>

  <div style="display: flex; justify-content: space-between; margin-bottom: 40px;">
    <div style="width: 48%;">
      <h3 style="font-weight: bold;">Course and Contact Information</h3>
      <p>Instructor: <span data-field="instructor_name">{{ instructor_name }}</span></p>
      <p>Office Location: <span data-field="office_location">{{ office_location }}</span></p>
      <p>Telephone: <span data-field="telephone">{{ telephone }}</span></p>
      <p>Email: <span data-field="email">{{ email }}</span></p>
      <p>Office Hours: <span data-field="office_hours">{{ office_hours }}</span></p>
      <p>Class Days/Time: <span data-field="class_days_time">{{ class_days_time }}</span></p>
    </div>
    <div style="width: 48%;">
      <h3 style="font-weight: bold;">Prerequisites:</h3>
      <p><span data-field="prerequisites">{{ prerequisites }}</span></p>
      <h3 style="font-weight: bold;">Campus Police:</h3>
      <p><span data-field="campus_police_id">{{ campus_police_id }}</span></p>
      <h3 style="font-weight: bold;">Escort:</h3>
      <p><span data-field="escort_info">{{ escort_info }}</span></p>
    </div>
  </div>

  <div style="margin-bottom: 40px;">
    <h3 style="font-weight: bold;">Program Updates: <a href="{{ program_updates_url }}">{{ program_updates_url }}</a></h3>
  </div>

  <div style="margin-bottom: 40px;">
    <h3 style="font-weight: bold;">Course Description</h3>
    <p><span data-field="course_description">{{ course_description }}</span></p>
  </div>

  <div style="margin-bottom: 40px;">
    <h3 style="font-weight: bold;">Course Format</h3>
    <h4 style="font-weight: bold;">Technology</h4>
    <p><span data-field="technology_description">{{ technology_description }}</span></p>
  </div>
</div>

<div class="page">
  <div style="margin-bottom: 40px;">
    <h3 style="font-weight: bold;">Class Messaging</h3>
    <p><span data-field="class_messaging">{{ class_messaging }}</span></p>
  </div>

  <div style="margin-bottom: 40px;">
    <h3 style="font-weight: bold;">Additional Information:</h3>
    <p><span data-field="additional_info">{{ additional_info }}</span></p>
  </div>

  <div style="margin-bottom: 40px;">
    <h3 style="font-weight: bold;">Course Goals Course Learning Outcomes (CLO)</h3>
    <p>Upon successful completion of this course, students will be able to:</p>
    <ol>
      <li><span data-field="clo_1">{{ clo_1 }}</span></li>
      <li><span data-field="clo_2">{{ clo_2 }}</span></li>
      <li><span data-field="clo_3">{{ clo_3 }}</span></li>
      <li><span data-field="clo_4">{{ clo_4 }}</span></li>
    </ol>
  </div>

  <div style="margin-bottom: 40px;">
    <h3 style="font-weight: bold;">Other technology requirements / equipment / material (REQUIRED)</h3>
    <ul>
      <li><span data-field="required_tech_1">{{ required_tech_1 }}</span></li>
      <li><span data-field="required_tech_2">{{ required_tech_2 }}</span></li>
    </ul>
    <p><span data-field="required_tech_note">{{ required_tech_note }}</span></p>
  </div>

  <div style="margin-bottom: 40px;">
    <h3 style="font-weight: bold;">Students can download Adobe software here: <a href="{{ adobe_download_link }}">{{ adobe_download_link }}</a></h3>
  </div>

  <div style="margin-bottom: 40px;">
    <h3 style="font-weight: bold;">Library Liaison (Optional)</h3>
    <p>For assistance in finding library resources, you may consult:</p>
    <p><a href="{{ library_link }}">{{ library_link }}</a></p>
    <p>and/or contact <span data-field="library_contact">{{ library_contact }}</span></p>
  </div>

  <div style="margin-bottom: 40px;">
    <h3 style="font-weight: bold;">Room / Lab Rules</h3>
    <p><span data-field="room_lab_rules">{{ room_lab_rules }}</span></p>
  </div>

  <div style="margin-bottom: 40px;">
    <h3 style="font-weight: bold;">Course Requirements and Assignments</h3>
    <p><span data-field="course_requirements_summary">{{ course_requirements_summary }}</span></p>
    <p>Weekly Story Assignments: Will be done digitally.</p>
    <ul>
      <li>Story Board Project #1: <span data-field="project_1_desc">{{ project_1_desc }}</span></li>
      <li>Story Board Project #2: <span data-field="project_2_desc">{{ project_2_desc }}</span></li>
      <li>Story Board Project #3: <span data-field="project_3_desc">{{ project_3_desc }}</span></li>
      <li>IN-CLASS Exercises: <span data-field="in_class_exercises_desc">{{ in_class_exercises_desc }}</span></li>
    </ul>
  </div>

  <div style="margin-bottom: 40px;">
    <h3 style="font-weight: bold;">Final Examination or Evaluation</h3>
    <p><span data-field="final_exam_info">{{ final_exam_info }}</span></p>
  </div>

  <div style="margin-bottom: 40px;">
    <h3 style="font-weight: bold;">Grading Information (Required)</h3>
    <p><span data-field="grading_determination">{{ grading_determination }}</span></p>
    <p><span data-field="late_policy">{{ late_policy }}</span></p>
    <table>
      <thead>
        <tr>
          <th>Weight</th>
          <th>Component</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>25%</td>
          <td>Class Participation & Exercise</td>
        </tr>
        <tr>
          <td>10%</td>
          <td>Weekly Story Panel</td>
        </tr>
        <tr>
          <td>15%</td>
          <td>Project #1</td>
        </tr>
        <tr>
          <td>15%</td>
          <td>Project #2</td>
        </tr>
        <tr>
          <td>15%</td>
          <td>Project #3</td>
        </tr>
        <tr>
          <td>20%</td>
          <td>Project #4</td>
        </tr>
      </tbody>
    </table>
    <p><span data-field="further_info">{{ further_info }}</span></p>
  </div>

  <div style="margin-bottom: 40px;">
    <h3 style="font-weight: bold;">Classroom Protocol</h3>
    <ul>
      <li><span data-field="protocol_1">{{ protocol_1 }}</span></li>
      <li><span data-field="protocol_2">{{ protocol_2 }}</span></li>
      <li><span data-field="protocol_3">{{ protocol_3 }}</span></li>
    </ul>
  </div>

  <div style="margin-bottom: 40px;">
    <h3 style="font-weight: bold;">Computer Labs: Violation of rules will result in loss of lab access for the whole semester</h3>
    <ul>
      <li><span data-field="lab_rule_1">{{ lab_rule_1 }}</span></li>
      <li><span data-field="lab_rule_2">{{ lab_rule_2 }}</span></li>
      <li><span data-field="lab_rule_3">{{ lab_rule_3 }}</span></li>
    </ul>
  </div>

  <div style="margin-bottom: 40px;">
    <h3 style="font-weight: bold;">Class Online Policies</h3>
    <ul>
      <li><span data-field="online_policy_1">{{ online_policy_1 }}</span></li>
      <li><span data-field="online_policy_2">{{ online_policy_2 }}</span></li>
      <li><span data-field="online_policy_3">{{ online_policy_3 }}</span></li>
    </ul>
  </div>

  <div style="margin-bottom: 40px;">
    <h3 style="font-weight: bold;">University Policies (Required)</h3>
    <p><span data-field="university_policies_summary">{{ university_policies_summary }}</span></p>
  </div>
</div>

<div class="page">
  <div style="margin-bottom: 30px;">
    <h3 style="font-weight: bold;">ANI 134, Animation Production II – Intermediate Storyboarding, Sec 01, SP2021</h3>
  </div>

  <h3 style="font-weight: bold; margin-bottom: 15px;">Course Schedule (Subject to change)</h3>
  <table>
    <thead>
      <tr>
        <th style="width: 15%;">Week (Optional)</th>
        <th style="width: 15%;">Date</th>
        <th style="width: 70%;">Topics, Readings, Assignments, Deadlines (If appropriate, add any extra column(s) to meet your needs.)</th>
      </tr>
    </thead>
    <tbody>
      {% for week_item in schedule %}
      <tr>
        <td>{{ week_item.week }}</td>
        <td>{{ week_item.date }}</td>
        <td>
          {% if week_item.topics %}
            <ul>
              {% for topic in week_item.topics %}
                <li>{{ topic }}</li>
              {% endfor %}
            </ul>
          {% else %}
            <span data-field="schedule_placeholder">{{ week_item.topics }}</span>
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

</body>
</html>