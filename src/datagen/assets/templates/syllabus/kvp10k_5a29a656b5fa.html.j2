<!DOCTYPE html>
<html>
<head>
<title>Syllabus</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    font-weight: bold;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
    margin-bottom: 15px;
  }
  th, td {
    border: 1px solid #ccc;
    padding: 8px;
    text-align: left;
  }
  th {
    background-color: #f2f2f2;
  }
</style>
</head>
<body>

<div class="page">
  <div style="text-align: right; font-size: 10pt;">Syllabus - Page 1</div>
  <div style="margin-bottom: 30px;">
    <h1 style="font-size: 18pt;">ACCT 5301, SPRING 2018</h1>
    <h2 style="font-size: 14pt;">ACCOUNTING 5301</h2>
    <h2 style="font-size: 14pt;">FINANCIAL ACCOUNTING FOR MBAS</h2>
    <h2 style="font-size: 14pt;">COLLEGE OF BUSINESS ADMINISTRATION</h2>
    <h2 style="font-size: 14pt;">UNIVERSITY OF TEXAS AT EL PASO</h2>
    <h2 style="font-size: 14pt;">SPRING 2018</h2>
  </div>

  <div style="margin-bottom: 20px;">
    <h3 style="font-size: 12pt;">Instructor Contact Information</h3>
    <p>Instructor: <span data-field="instructor.name">{{ instructor.name }}</span></p>
    <p>Office: <span data-field="instructor.office">{{ instructor.office }}</span></p>
    <p>Telephone: <span data-field="instructor.phone">{{ instructor.phone }}</span></p>
    <p>Email: <span data-field="instructor.email">{{ instructor.email }}</span></p>
    <p>Office Hours: <span data-field="instructor.office_hours">{{ instructor.office_hours }}</span></p>
  </div>

  <div style="margin-bottom: 20px;">
    <h3 style="font-size: 12pt;">Required Course Materials</h3>
    <p>Textbook: <span data-field="textbook.title">{{ textbook.title }}</span></p>
    <p>Note: <span data-field="textbook.note">{{ textbook.note }}</span></p>
  </div>

  <div style="margin-bottom: 20px;">
    <h3 style="font-size: 12pt;">Courses:</h3>
    <p>Cases: <span data-field="cases.description">{{ cases.description }}</span></p>
    <p>Websites: <span data-field="websites.description">{{ websites.description }}</span></p>
    <p>Calculator: <span data-field="calculator.description">{{ calculator.description }}</span></p>
  </div>

  <div style="margin-bottom: 20px;">
    <h3 style="font-size: 12pt;">Course Description</h3>
    <p><span data-field="course_description">{{ course_description }}</span></p>
  </div>

  <div style="margin-bottom: 20px;">
    <h3 style="font-size: 12pt;">Course Learning Objectives</h3>
    <ul>
      <li><span data-field="objective_1">{{ objective_1 }}</span></li>
      <li><span data-field="objective_2">{{ objective_2 }}</span></li>
      <li><span data-field="objective_3">{{ objective_3 }}</span></li>
      <li><span data-field="objective_4">{{ objective_4 }}</span></li>
    </ul>
  </div>

  <div style="margin-bottom: 20px;">
    <h3 style="font-size: 12pt;">Accommodations for Students with Disabilities</h3>
    <p><span data-field="disability_accommodations">{{ disability_accommodations }}</span></p>
  </div>
</div>

<div class="page">
  <div style="text-align: right; font-size: 10pt;">Syllabus - Page 2</div>
  <div style="margin-bottom: 20px;">
    <h3 style="font-size: 12pt;">Grades</h3>
    <p><span data-field="grade_policy">{{ grade_policy }}</span></p>
    <table>
      <thead>
        <tr>
          <th style="width: 20%;">Grade Level</th>
          <th style="width: 50%;">Achievement</th>
          <th style="width: 30%;">Percentage of Points</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>A</td>
          <td>Excellent</td>
          <td>90.0 to 100.0%</td>
        </tr>
        <tr>
          <td>B</td>
          <td>Good</td>
          <td>80.0 to 89.9%</td>
        </tr>
        <tr>
          <td>C</td>
          <td>Average</td>
          <td>70.0 to 79.9%</td>
        </tr>
        <tr>
          <td>D</td>
          <td>Below Average but Passing</td>
          <td>60.0 to 69.9%</td>
        </tr>
        <tr>
          <td>F</td>
          <td>Failure</td>
          <td>&lt; 60%</td>
        </tr>
      </tbody>
    </table>
    <p><span data-field="grade_note">{{ grade_note }}</span></p>
  </div>

  <div style="margin-bottom: 20px;">
    <h3 style="font-size: 12pt;">Exams (300 points)</h3>
    <p><span data-field="exam_details">{{ exam_details }}</span></p>
  </div>

  <div style="margin-bottom: 20px;">
    <h3 style="font-size: 12pt;">Homework (50 points)</h3>
    <p><span data-field="homework_details">{{ homework_details }}</span></p>
  </div>

  <div style="margin-bottom: 20px;">
    <h3 style="font-size: 12pt;">Cases (80 points)</h3>
    <p><span data-field="cases_details">{{ cases_details }}</span></p>
  </div>

  <div style="margin-bottom: 20px;">
    <h3 style="font-size: 12pt;">Group Project</h3>
    <p><span data-field="group_project_details">{{ group_project_details }}</span></p>
  </div>
</div>

<div class="page">
  <div style="text-align: right; font-size: 10pt;">Syllabus - Page 3</div>
  <div style="margin-bottom: 20px;">
    <h3 style="font-size: 12pt;">Opportunities and Accounting Issues</h3>
    <p><span data-field="opportunities_description">{{ opportunities_description }}</span></p>
  </div>

  <div style="margin-bottom: 20px;">
    <h3 style="font-size: 12pt;">Class Participation (50 points)</h3>
    <p><span data-field="participation_details">{{ participation_details }}</span></p>
  </div>

  <div style="margin-bottom: 20px;">
    <h3 style="font-size: 12pt;">Course Calendar</h3>
    <p><span data-field="calendar_note">{{ calendar_note }}</span></p>
  </div>

  <div style="margin-bottom: 20px;">
    <h3 style="font-size: 12pt;">Plagiarism and Cheating</h3>
    <p><span data-field="plagiarism_policy">{{ plagiarism_policy }}</span></p>
  </div>

  <div style="margin-bottom: 20px;">
    <h3 style="font-size: 12pt;">Campus Carry</h3>
    <p><span data-field="campus_carry_policy">{{ campus_carry_policy }}</span></p>
  </div>

  <div style="margin-bottom: 20px;">
    <h3 style="font-size: 12pt;">Academic Standing</h3>
    <p><span data-field="academic_standing_policy">{{ academic_standing_policy }}</span></p>
    <ul>
      <li><span data-field="academic_standing_bullet_1">{{ academic_standing_bullet_1 }}</span></li>
      <li><span data-field="academic_standing_bullet_2">{{ academic_standing_bullet_2 }}</span></li>
    </ul>
  </div>

  <div style="margin-bottom: 20px;">
    <h3 style="font-size: 12pt;">Probation</h3>
    <ul>
      <li><span data-field="probation_bullet_1">{{ probation_bullet_1 }}</span></li>
    </ul>
  </div>
</div>

<div class="page">
  <div style="text-align: right; font-size: 10pt;">Syllabus - Page 4</div>
  <div style="margin-bottom: 20px;">
    <h3 style="font-size: 12pt;">Schedule</h3>
    <table>
      <thead>
        <tr>
          <th style="width: 15%;">Date Due</th>
          <th style="width: 35%;">Topic (Reading)</th>
          <th style="width: 30%;">Assignment/Quizzes (Due Before Class)</th>
          <th style="width: 20%;">Practice Problems</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Mon, 3/19</td>
          <td>Class Overview: Syllabus<br>Ch. 1</td>
          <td>Class survey on Blackboard</td>
          <td>Pr. 1.43;</td>
        </tr>
        <tr>
          <td>Thurs, 3/22</td>
          <td>The Basics of Record Keeping and Financial Statement Preparation: Balance Sheet<br>Ch. 2</td>
          <td>HW #1 on CengageNow</td>
          <td>Pr. 3-24, Pr. 3-31, Pr. 3-36, Pr. 3-37</td>
        </tr>
        <tr>
          <td>Mon, 3/26</td>
          <td>HurryDate Case</td>
          <td>HurryDate Case write-up</td>
          <td>Ex. 4-14, Ex. 4-15, Ex. 4-20, Problem 4.1 for Self-Study, Ex. 4-25, Ex. 4-21, Problem 4.2 for Self-Study</td>
        </tr>
        <tr>
          <td>Thurs, 3/29</td>
          <td>Income Statement: Reporting the Results of Operating Activities<br>Ch. 5</td>
          <td>HW #2 on CengageNow</td>
          <td>Ex. 5-11, Problem 5.1, Ex. 5-21, Pr. 3-31, Pr. 3-37</td>
        </tr>
      </tbody>
    </table>
  </div>

  <div style="margin-bottom: 20px;">
    <table>
      <thead>
        <tr>
          <th style="width: 15%;">Date Due</th>
          <th style="width: 35%;">Topic (Reading)</th>
          <th style="width: 30%;">Assignment/Quizzes (Due Before Class)</th>
          <th style="width: 20%;">Practice Problems</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Mon, 4/2</td>
          <td>Statement of Cash Flows:<br>Ch. 6</td>
          <td>Dollar General Case Write-up</td>
          <td>Pr. 6-33, Myriad Example, Pr. 6-37, Pr. 6-34</td>
        </tr>
        <tr>
          <td>Thurs, 4/5</td>
          <td>Introduction to Financial Statement Analysis: Ch. 7</td>
          <td>HW #3 on CengageNow</td>
          <td>Ford Analysis, Ex. 7-17, Pr. 7-25</td>
        </tr>
        <tr>
          <td>Mon, 4/9</td>
          <td>Form Groups for Final Project<br>Revenue Recognition, Receivables, and Advances from Customers: Ch. 8</td>
          <td>Harnischfeger Case Write-up</td>
          <td>Examples from Textbook, Ex. 8-25, Ex. 8-26, Simple Cash Flow, Pr. 8-48</td>
        </tr>
        <tr>
          <td>Thurs, 4/12</td>
          <td>Harnischfeger Case<br>Working Capital: Ch. 9</td>
          <td>HW #4 on CengageNow</td>
          <td>Ex. 9-18, Ex. 9-21, Pr. 9-38, Ex. 9-26, Ex. 9-27, Ex. 9-29, Pr. 9-45, Ex. 9-33</td>
        </tr>
        <tr>
          <td>Mon, 4/16</td>
          <td>Exam 2<br>Long-Lived Tangible and Intangible Assets: Ch. 10</td>
          <td>HW #5 on CengageNow</td>
          <td>Ex. 10-13, Ex. 10-21, Ex. 10-26, Ex. 10-28, Pr. 10-30</td>
        </tr>
        <tr>
          <td>Thurs, 4/19</td>
          <td>Work in Groups: Final Project<br>Notes, Bonds and Leases: Ch. 11</td>
          <td>Netflix Case Write-up</td>
          <td>Ex. 11-15, Debt Extinguishment Example, Pr. 11-28</td>
        </tr>
        <tr>
          <td>Mon, 4/23</td>
          <td>Shareholders' Equity: Capital Contributions and Distributions<br>Ch. 15</td>
          <td>HW #6 on CengageNow</td>
          <td>Ex. 15-12, Ex. 15-14</td>
        </tr>
        <tr>
          <td>Thurs, 4/26</td>
          <td>Group Presentations<br>Final Exam</td>
          <td>Group Project Due</td>
          <td></td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

</body>
</html>