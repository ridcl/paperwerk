<!DOCTYPE html>
<html>
<head>
    <title>Course Syllabus</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 {
            font-weight: bold;
        }
        .header-info {
            margin-bottom: 20px;
        }
        .section {
            margin-bottom: 25px;
        }
        .metadata-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        .metadata-table td {
            padding: 3px 0;
        }
        .metadata-table .label {
            font-weight: bold;
            width: 150px;
            display: inline-block;
        }
        .footer-note {
            font-size: 0.9em;
            margin-top: 30px;
        }
    </style>
</head>
<body>
    <div class="page">
        <div style="text-align: center; margin-bottom: 30px;">
            <h1 style="font-size: 1.5em;">THE UNIVERSITY OF TEXAS AT EL PASO</h1>
            <h2 style="font-size: 1.2em;">COLLEGE OF SCIENCE</h2>
            <h3 style="font-size: 1.1em;">DEPARTMENT OF MATHEMATICAL SCIENCES</h3>
        </div>

        <div class="section">
            <table class="metadata-table">
                <tr>
                    <td class="label">Course #:</td>
                    <td><span data-field="course_number">{{ course_number }}</span></td>
                </tr>
                <tr>
                    <td class="label">Course Title:</td>
                    <td><span data-field="course_title">{{ course_title }}</span></td>
                </tr>
                <tr>
                    <td class="label">Credit Hrs:</td>
                    <td><span data-field="credit_hours">{{ credit_hours }}</span></td>
                </tr>
                <tr>
                    <td class="label">Term:</td>
                    <td><span data-field="term">{{ term }}</span></td>
                </tr>
                <tr>
                    <td class="label">Course Meetings & Location:</td>
                    <td><span data-field="meeting_location">{{ meeting_location }}</span></td>
                </tr>
                <tr>
                    <td class="label">Prerequisite Courses:</td>
                    <td><span data-field="prerequisites">{{ prerequisites }}</span></td>
                </tr>
                <tr>
                    <td class="label">Course Fee:</td>
                    <td><span data-field="course_fee">{{ course_fee }}</span></td>
                </tr>
                <tr>
                    <td class="label">Instructor:</td>
                    <td><span data-field="instructor_name">{{ instructor_name }}</span></td>
                </tr>
                <tr>
                    <td class="label">Office Location:</td>
                    <td><span data-field="office_location">{{ office_location }}</span></td>
                </tr>
                <tr>
                    <td class="label">Contact Info:</td>
                    <td><span data-field="contact_info">{{ contact_info }}</span></td>
                </tr>
            </table>
        </div>

        <div class="section">
            <p><strong>Textbook(s), Materials:</strong> <span data-field="textbook_details">{{ textbook_details }}</span></p>
            <p><strong>Required:</strong> <span data-field="required_materials">{{ required_materials }}</span></p>
            <p><strong>Suggested:</strong> <span data-field="suggested_texts">{{ suggested_texts }}</span></p>
            <p><strong>TI-83 or TI-84 Calculator</strong></p>
        </div>

        <div class="section">
            <h3 style="margin-top: 20px;">Course Objectives</h3>
            <p><span data-field="course_objectives">{{ course_objectives }}</span></p>
        </div>

        <div class="section">
            <h3 style="margin-top: 20px;">Activities/Assignments</h3>
            <p><span data-field="activities_assignments">{{ activities_assignments }}</span></p>
        </div>

        <div class="section">
            <h3 style="margin-top: 20px;">Assessment of Course Objectives:</h3>
            <p><strong>Exams:</strong> <span data-field="exam_details">{{ exam_details }}</span></p>
            <p><strong>Homework:</strong> <span data-field="homework_details">{{ homework_details }}</span></p>
            <p><strong>Final Exam:</strong> <span data-field="final_exam_details">{{ final_exam_details }}</span></p>
        </div>

        <div class="section">
            <h3 style="margin-top: 20px;">Grading Policy:</h3>
            <p><span data-field="grading_policy">{{ grading_policy }}</span></p>
        </div>

        <div class="section">
            <h3 style="margin-top: 20px;">Make-up Policy:</h3>
            <p><span data-field="make_up_policy">{{ make_up_policy }}</span></p>
        </div>

        <div class="section">
            <p><strong>Academic Integrity:</strong> See <span data-field="academic_integrity_link">{{ academic_integrity_link }}</span></p>
        </div>

        <div class="section">
            <h3 style="margin-top: 20px;">Military Statement:</h3>
            <p><span data-field="military_statement">{{ military_statement }}</span></p>
        </div>
    </div>

    <div class="page">
        <div class="section">
            <h3 style="margin-top: 20px;">Attendance Policy:</h3>
            <p><span data-field="attendance_policy">{{ attendance_policy }}</span></p>
        </div>

        <div class="section">
            <h3 style="margin-top: 20px;">Disability Statement:</h3>
            <p><span data-field="disability_statement">{{ disability_statement }}</span></p>
        </div>
    </div>
</body>
</html>