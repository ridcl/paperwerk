<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  h1, h2, h3 {
    font-weight: bold;
  }
  .section-title {
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
  }
  .contact-info p {
    margin: 2px 0;
  }
  .divider {
    border-top: 1px solid #ccc;
    margin: 20px 0;
  }
</style>

<div class="page">
  <div style="text-align: center;">
    <h1>CME</h1>
    <h2>Commercial Music Ensemble</h2>
    <h3>MUSA 1137</h3>
  </div>

  <div class="contact-info" style="margin-top: 40px;">
    <p>Instructor: <span data-field="instructor_name">{{ instructor_name }}</span></p>
    <p>Office: <span data-field="office_number">{{ office_number }}</span></p>
    <p>Contact: <span data-field="instructor_email">{{ instructor_email }}</span></p>
  </div>

  <div class="contact-info" style="margin-top: 20px;">
    <p>Teaching Assistant: <span data-field="ta_name">{{ ta_name }}</span></p>
    <p>Email: <span data-field="ta_email">{{ ta_email }}</span></p>
  </div>

  <div class="contact-info" style="margin-top: 20px;">
    <p>Teaching Assistant: <span data-field="ta2_name">{{ ta2_name }}</span></p>
    <p>Email: <span data-field="ta2_email">{{ ta2_email }}</span></p>
  </div>

  <div style="margin-top: 20px;">
    <p>Class Time: <span data-field="class_time">{{ class_time }}</span></p>
    <p>Location: <span data-field="class_location">{{ class_location }}</span></p>
  </div>

  <div style="margin-top: 20px;">
    <p>Office Hours: <span data-field="office_hours">{{ office_hours }}</span></p>
  </div>

  <div class="section-title">Attendance Policy</div>
  <p>
    <span data-field="attendance_policy_text">{{ attendance_policy_text }}</span>
  </p>
</div>

<div class="page">
  <div class="section-title">Course Description</div>
  <p>
    <span data-field="course_description">{{ course_description }}</span>
  </p>

  <div class="section-title">Course Objectives</div>
  <ol>
    <li><span data-field="objective_1">{{ objective_1 }}</span></li>
    <li><span data-field="objective_2">{{ objective_2 }}</span></li>
    <li><span data-field="objective_3">{{ objective_3 }}</span></li>
  </ol>

  <div class="divider"></div>

  <div class="section-title">Performance/Service Ensemble</div>
  <p>
    <span data-field="ensemble_description">{{ ensemble_description }}</span>
  </p>

  <div class="section-title">Grading</div>
  <p>
    <span data-field="grading_policy">{{ grading_policy }}</span>
  </p>

  <div class="section-title">Important Dates:</div>
  <p><span data-field="important_dates">{{ important_dates }}</span></p>

  <div class="section-title">Statement for Accommodations and Support</div>
  <p>
    <span data-field="accommodation_statement">If you have a disability and need classroom accommodations, please contact The Center for Accommodations and Support Services (CASS) at <span data-field="cass_phone">{{ cass_phone }}</span>, or by email to <span data-field="cass_email">{{ cass_email }}</span>, or visit their office located in UTEP Union East, Room 106. For additional information, please visit the CASS website at <span data-field="cass_website">{{ cass_website }}</span>.</span>
  </p>

  <div class="section-title">Academic Honesty</div>
  <p><span data-field="academic_honesty_link">{{ academic_honesty_link }}</span></p>

  <div class="section-title">COVID-19 Precautions</div>
  <p>
    <span data-field="covid_precautions_text">Please stay home if you have been diagnosed with COVID-19 or are experiencing COVID-19 symptoms. If you are feeling unwell, please let me know as soon as possible, so that we can work on appropriate accommodations. If you have tested positive for COVID-19, you are encouraged to report your results to <span data-field="covid_reporting_email">{{ covid_reporting_email }}</span>, so that the Dean of Students Office can provide you with support and help with communication with your professors. The Student Health Center is equipped to provide COVID 19 testing.</span>
  </p>
  <p>
    <span data-field="covid_center_info">The Center for Disease Control and Prevention recommends that people in areas of substantial or high COVID-19 transmission wear face masks when indoors in groups of people. The best way that Miners can take care of Miners is to get the vaccine. If you still need the vaccine, it is widely available in the El Paso area, and will be available at no charge on campus during the first week of classes. For more information about the current rates, testing, and vaccinations, please visit <span data-field="epstrong_link">{{ epstrong_link }}</span>.</span>
  </p>
</div>

<div class="page">
  <div style="margin-top: 40px;">
    <p>
      <span data-field="note_1">{{ note_1 }}</span>
    </p>
    <p>
      <span data-field="note_2">{{ note_2 }}</span>
    </p>
  </div>
</div>