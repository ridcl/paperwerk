<!DOCTYPE html>
<html>
<head>
<title>Course Syllabus</title>
<style>
    @page { size: A4; margin: 0; }
    .page {
      width: 794px; height: 1123px;
      padding: 50px 60px; box-sizing: border-box;
      overflow: hidden; page-break-after: always;
      position: relative;
      font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    }
    .page:last-child { page-break-after: auto; }
    h1, h2, h3, h4 { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif; }
    table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
    td, th { padding: 8px; text-align: left; border-bottom: 1px solid #ccc; }
    .header-row td { padding: 10px 0; }
</style>
</head>
<body>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px;">
        <div>
            <p style="font-size: 12pt; margin: 0;">UTEP | <span data-field="semester">{{ semester }}</span> | <span data-field="course_code">{{ course_code }}</span> | CRN: <span data-field="crn">{{ crn }}</span> | <span data-field="meeting_time">{{ meeting_time }}</span></p>
        </div>
        <div>
            <p style="font-size: 12pt; margin: 0;">Instructor: <span data-field="instructor_name">{{ instructor_name }}</span></p>
        </div>
    </div>

    <h1 style="font-size: 36pt; margin-bottom: 30px;">UNIV 1301</h1>

    <h2 style="font-size: 20pt; margin-bottom: 15px;">Course Description</h2>
    <p style="line-height: 1.5;">
        <span data-field="course_description_text">{{ course_description_text }}</span>
    </p>

    <h2 style="font-size: 20pt; margin-top: 40px; margin-bottom: 15px;">Learning Outcomes:</h2>
    <ul style="line-height: 1.6; padding-left: 20px;">
        <li><span data-field="outcome_1">{{ outcome_1 }}</span></li>
        <li><span data-field="outcome_2">{{ outcome_2 }}</span></li>
        <li><span data-field="outcome_3">{{ outcome_3 }}</span></li>
        <li><span data-field="outcome_4">{{ outcome_4 }}</span></li>
        <li><span data-field="outcome_5">{{ outcome_5 }}</span></li>
    </ul>

    <div style="margin-top: 40px;">
        <h3 style="font-size: 16pt;">UTEP EDGE:</h3>
        <p style="line-height: 1.5;">
            <span data-field="utep_edge_description">{{ utep_edge_description }}</span>
        </p>
    </div>
</div>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px;">
        <div style="width: 50%;">
            <h2 style="font-size: 20pt; margin-bottom: 15px;">Campus Events</h2>
            <table style="width: 100%;">
                <thead>
                    <tr class="header-row">
                        <th style="width: 30%;">Event</th>
                        <th style="width: 30%;">Date/Time</th>
                        <th style="width: 40%;">Location</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span data-field="event_1_name">{{ event_1_name }}</span></td>
                        <td><span data-field="event_1_date">{{ event_1_date }}</span> | 9a-3p</td>
                        <td><span data-field="event_1_location">{{ event_1_location }}</span></td>
                    </tr>
                    <tr>
                        <td><span data-field="event_2_name">{{ event_2_name }}</span></td>
                        <td><span data-field="event_2_date">{{ event_2_date }}</span> | 9a-3p</td>
                        <td><span data-field="event_2_location">{{ event_2_location }}</span></td>
                    </tr>
                </tbody>
            </table>
            <p style="font-size: 10pt; margin-top: 10px;">Additional events listed on the UTEP Events page: <a href="#" style="color: blue;">https://events.utep.edu/</a></p>
        </div>
        <div style="width: 50%; text-align: right;">
            <h2 style="font-size: 20pt; margin-bottom: 15px;">Contact Information</h2>
            <table style="width: 100%;">
                <tr>
                    <td style="width: 50%;">
                        <p style="font-weight: bold;">Instructor Information:</p>
                        <p>Name: <span data-field="instructor_name_contact">{{ instructor_name_contact }}</span></p>
                        <p>Email: <span data-field="instructor_email_contact">{{ instructor_email_contact }}</span></p>
                        <p>Office hours: Tues., Thurs., and Fri.</p>
                        <p>Time: 10:30-11:30</p>
                    </td>
                    <td style="width: 50%;">
                        <p style="font-weight: bold;">Peer Leader Information:</p>
                        <p>Name: <span data-field="peer_leader_name">{{ peer_leader_name }}</span></p>
                        <p>Email: <span data-field="peer_leader_email">{{ peer_leader_email }}</span></p>
                        <p>Office Hours: Mon., Tues., and Fri.</p>
                        <p>Time: 10:30-11:30</p>
                    </td>
                </tr>
            </table>

            <h2 style="font-size: 20pt; margin-top: 30px; margin-bottom: 15px;">Technology Support:</h2>
            <table style="width: 100%;">
                <tr>
                    <td style="width: 50%;">
                        <p>UTEP Help Desk</p>
                        <p>Phone: <span data-field="help_desk_phone">{{ help_desk_phone }}</span> (HELP)</p>
                        <p>Website: <a href="#" style="color: blue;">UTEP.EDU</a></p>
                        <p>Location: LIBR 300</p>
                    </td>
                    <td style="width: 50%;">
                        <p>Helpful Campus Numbers:</p>
                        <p>Campus Police: <span data-field="police_phone">{{ police_phone }}</span></p>
                        <p>Office of Financial Aid: <span data-field="financial_aid_phone">{{ financial_aid_phone }}</span></p>
                        <p>Student Business Services: <span data-field="sbs_phone">{{ sbs_phone }}</span></p>
                        <p>UTEP Main Line: <span data-field="main_line_phone">{{ main_line_phone }}</span></p>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
        <div style="width: 50%;">
            <h2 style="font-size: 20pt; margin-bottom: 15px;">Course Point Values</h2>
            <p style="line-height: 1.5;">
                <span data-field="course_point_description">{{ course_point_description }}</span>
            </p>
            <table style="width: 100%;">
                <thead>
                    <tr class="header-row">
                        <th style="width: 50%;">Assignment</th>
                        <th style="width: 50%;">Points</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span data-field="assignment_1">{{ assignment_1 }}</span></td>
                        <td><span data-field="points_1">{{ points_1 }}</span></td>
                    </tr>
                    <tr>
                        <td><span data-field="assignment_2">{{ assignment_2 }}</span></td>
                        <td><span data-field="points_2">{{ points_2 }}</span></td>
                    </tr>
                    <tr>
                        <td><span data-field="assignment_3">{{ assignment_3 }}</span></td>
                        <td><span data-field="points_3">{{ points_3 }}</span></td>
                    </tr>
                    <tr>
                        <td><span data-field="assignment_4">{{ assignment_4 }}</span></td>
                        <td><span data-field="points_4">{{ points_4 }}</span></td>
                    </tr>
                    <tr>
                        <td><span data-field="assignment_5">{{ assignment_5 }}</span></td>
                        <td><span data-field="points_5">{{ points_5 }}</span></td>
                    </tr>
                    <tr>
                        <td><span data-field="assignment_6">{{ assignment_6 }}</span></td>
                        <td><span data-field="points_6">{{ points_6 }}</span></td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="1" style="text-align: right; font-weight: bold;">Total</td>
                        <td><span data-field="total_points">{{ total_points }}</span></td>
                    </tr>
                </tfoot>
            </table>
            <p style="font-size: 10pt; margin-top: 15px;">
                <span data-field="grading_note">{{ grading_note }}</span>
            </p>
            <table style="width: 100%;">
                <tr>
                    <td style="width: 50%;">A: <span data-field="grade_a">{{ grade_a }}</span></td>
                    <td style="width: 50%;">B: <span data-field="grade_b">{{ grade_b }}</span></td>
                </tr>
                <tr>
                    <td>C: <span data-field="grade_c">{{ grade_c }}</span></td>
                    <td>D: <span data-field="grade_d">{{ grade_d }}</span></td>
                </tr>
                <tr>
                    <td colspan="2">F: <span data-field="grade_f">{{ grade_f }}</span></td>
                </tr>
            </table>
            <p style="font-size: 10pt; margin-top: 15px;">
                <span data-field="feedback_note">{{ feedback_note }}</span>
            </p>
        </div>

        <div style="width: 50%;">
            <h2 style="font-size: 20pt; margin-bottom: 15px;">Syllabus Contents</h2>
            <table style="width: 100%;">
                <tr>
                    <td style="width: 50%;">Course Description</td>
                    <td style="width: 50%; text-align: right;"><span data-field="desc_page">{{ desc_page }}</span></td>
                </tr>
                <tr>
                    <td>Contact Information</td>
                    <td style="text-align: right;"><span data-field="contact_page">{{ contact_page }}</span></td>
                </tr>
                <tr>
                    <td>Technology Support</td>
                    <td style="text-align: right;"><span data-field="tech_page">{{ tech_page }}</span></td>
                </tr>
                <tr>
                    <td>Helpful Campus Numbers</td>
                    <td style="text-align: right;"><span data-field="campus_numbers_page">{{ campus_numbers_page }}</span></td>
                </tr>
                <tr>
                    <td>Course Assignments</td>
                    <td style="text-align: right;"><span data-field="assignments_page">{{ assignments_page }}</span></td>
                </tr>
                <tr>
                    <td>UTEP Policies</td>
                    <td style="text-align: right;"><span data-field="policies_page">{{ policies_page }}</span></td>
                </tr>
                <tr>
                    <td>UNIV 1301 Attendance Policy</td>
                    <td style="text-align: right;"><span data-field="attendance_page">{{ attendance_page }}</span></td>
                </tr>
                <tr>
                    <td>Technical Requirements</td>
                    <td style="text-align: right;"><span data-field="tech_req_page">{{ tech_req_page }}</span></td>
                </tr>
                <tr>
                    <td>Important Dates</td>
                    <td style="text-align: right;"><span data-field="dates_page">{{ dates_page }}</span></td>
                </tr>
                <tr>
                    <td>Campus Resources</td>
                    <td style="text-align: right;"><span data-field="resources_page">{{ resources_page }}</span></td>
                </tr>
            </table>

            <div style="margin-top: 40px;">
                <h3 style="font-size: 16pt;">Required Texts</h3>
                <p style="line-height: 1.5;">
                    <span data-field="required_text_1">{{ required_text_1 }}</span>
                </p>
                <p style="line-height: 1.5;">
                    <span data-field="required_text_2">{{ required_text_2 }}</span>
                </p>
                <p style="line-height: 1.5;">
                    <span data-field="required_text_3">{{ required_text_3 }}</span>
                </p>
                <p style="line-height: 1.5;">
                    <span data-field="required_text_4">{{ required_text_4 }}</span>
                </p>
                <p style="line-height: 1.5;">
                    <span data-field="required_text_5">{{ required_text_5 }}</span>
                </p>
            </div>
        </div>
    </div>
</div>

<div class="page">
    <h2 style="font-size: 20pt; margin-bottom: 20px;">UNIV 1301 Attendance Policy</h2>
    <p style="line-height: 1.5;">
        <span data-field="attendance_policy_text">{{ attendance_policy_text }}</span>
    </p>
    <ul style="line-height: 1.6; padding-left: 20px;">
        <li><span data-field="attendance_activity_1">{{ attendance_activity_1 }}</span></li>
        <li><span data-field="attendance_activity_2">{{ attendance_activity_2 }}</span></li>
        <li><span data-field="attendance_activity_3">{{ attendance_activity_3 }}</span></li>
        <li><span data-field="attendance_activity_4">{{ attendance_activity_4 }}</span></li>
    </ul>

    <h2 style="font-size: 20pt; margin-top: 40px; margin-bottom: 15px;">Course Drop / Withdrawal Policy</h2>
    <p style="line-height: 1.5;">
        <span data-field="drop_withdrawal_policy_text">{{ drop_withdrawal_policy_text }}</span>
    </p>
    <p style="line-height: 1.5;">
        <span data-field="policy_caveat">{{ policy_caveat }}</span>
    </p>

    <h2 style="font-size: 20pt; margin-top: 40px; margin-bottom: 15px;">Late Assignment Policy</h2>
    <p style="line-height: 1.5;">
        <span data-field="late_assignment_policy_text">{{ late_assignment_policy_text }}</span>
    </p>
    <p style="line-height: 1.5;">
        <span data-field="late_assignment_warning">{{ late_assignment_warning }}</span>
    </p>

    <h2 style="font-size: 20pt; margin-top: 40px; margin-bottom: 15px;">Make-Up Work</h2>
    <p style="line-height: 1.5;">
        <span data-field="make_up_work_policy">{{ make_up_work_policy }}</span>
    </p>
</div>

<div class="page">
    <h2 style="font-size: 20pt; margin-bottom: 20px;">Synchronous Blackboard Collaborate Sessions</h2>
    <p style="line-height: 1.5;">
        <span data-field="sync_session_description">{{ sync_session_description }}</span>
    </p>
    <p style="line-height: 1.5;">
        <span data-field="sync_session_expectations">{{ sync_session_expectations }}</span>
    </p>

    <h2 style="font-size: 20pt; margin-top: 40px; margin-bottom: 15px;">Course Management System</h2>
    <p style="line-height: 1.5;">
        <span data-field="cms_description">{{ cms_description }}</span>
    </p>

    <h2 style="font-size: 20pt; margin-top: 40px; margin-bottom: 15px;">Technical Requirements</h2>
    <p style="line-height: 1.5;">
        <span data-field="tech_req_1">{{ tech_req_1 }}</span>
    </p>
    <p style="line-height: 1.5;">
        <span data-field="tech_req_2">{{ tech_req_2 }}</span>
    </p>
    <p style="line-height: 1.5;">
        <span data-field="tech_req_3">{{ tech_req_3 }}</span>
    </p>
    <p style="line-height: 1.5;">
        <span data-field="tech_req_4">{{ tech_req_4 }}</span>
    </p>

    <div style="margin-top: 40px; border-top: 1px solid #ccc; padding-top: 20px;">
        <h3 style="font-size: 16pt;">Spring 2021 Important Dates</h3>
        <table style="width: 100%;">
            <thead>
                <tr class="header-row">
                    <th style="width: 50%;">Class Begins</th>
                    <th style="width: 50%;">Date</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Classes Begin</td>
                    <td>Jan 19</td>
                </tr>
                <tr>
                    <td>Spring Break</td>
                    <td>Feb 3</td>
                </tr>
                <tr>
                    <td>Mid-Term Grades Available</td>
                    <td>Mar 15-19</td>
                </tr>
                <tr>
                    <td>Career Day (No classes)</td>
                    <td>Mar 22</td>
                </tr>
                <tr>
                    <td>Course Drop Deadline</td>
                    <td>Apr 1</td>
                </tr>
                <tr>
                    <td>Spring Study Day</td>
                    <td>Apr 7</td>
                </tr>
                <tr>
                    <td>Dead Day (No classes)</td>
                    <td>May 1</td>
                </tr>
                <tr>
                    <td>Final Exams</td>
                    <td>May 10-14</td>
                </tr>
                <tr>
                    <td>Final Grades Available</td>
                    <td>May 20</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px;">
        <div style="width: 50%;">
            <h2 style="font-size: 20pt; margin-bottom: 15px;">Netiquette Guidelines</h2>
            <ul style="line-height: 1.6; padding-left: 20px;">
                <li><span data-field="netiquette_1">{{ netiquette_1 }}</span></li>
                <li><span data-field="netiquette_2">{{ netiquette_2 }}</span></li>
                <li><span data-field="netiquette_3">{{ netiquette_3 }}</span></li>
                <li><span data-field="netiquette_4">{{ netiquette_4 }}</span></li>
            </ul>
        </div>
        <div style="width: 50%;">
            <h2 style="font-size: 20pt; margin-bottom: 15px;">Helpful Campus Resources</h2>
            <table style="width: 100%;">
                <tr>
                    <td style="width: 50%;">
                        <p style="font-weight: bold;">Academic Advising Center</p>
                        <p><a href="#" style="color: blue;">https://www.utep.edu/advising/</a></p>
                    </td>
                    <td style="width: 50%;">
                        <p style="font-weight: bold;">Counseling and Psychological Services</p>
