          <div style="font-size: 14px;">increase in new proposal submissions</div>
        </div>
        <div style="display: flex; justify-content: space-between;">
          <div style="font-size: 24px; font-weight: bold;"><span data-field="growth_percent_5">{{ growth_percent_5 }}</span></div>
          <div style="font-size: 14px;">increase in proposals exceeding $1 million</div>
        </div>
      </div>
      <div style="text-align: center;">
        <img src="placeholder_logo.png" alt="Carnegie R1" style="width: 100px;">
        <div style="font-size: 16px; margin-top: 10px;">A Carnegie R1 Institution</div>
      </div>
    </div>
    <div style="width: 50%; padding-left: 20px;">
