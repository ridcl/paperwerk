          <div style="font-size: 14px;">increase in the number of doctoral degrees awarded</div>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
          <div style="font-size: 24px; font-weight: bold;"><span data-field="growth_percent_2">{{ growth_percent_2 }}</span></div>
          <div style="font-size: 14px;">increase in research expenditures</div>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
          <div style="font-size: 24px; font-weight: bold;"><span data-field="growth_percent_3">{{ growth_percent_3 }}</span></div>
          <div style="font-size: 14px;">increase in research grant awards</div>
        </div>
