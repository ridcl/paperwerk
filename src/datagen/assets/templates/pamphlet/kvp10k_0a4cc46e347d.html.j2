    <title>Violence Against Women Document</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 {
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .header-box {
            border: 2px solid #007bff;
            padding: 20px;
            text-align: center;
            margin-bottom: 30px;
        }
        .header-box h1 {
            font-size: 2.5em;
            margin: 0;
            color: #007bff;
        }
        .image-placeholder {
            text-align: center;
            margin: 40px 0;
        }
        .image-placeholder img {
            max-width: 100%;
            height: auto;
        }
        .footer-message {
            text-align: center;
            font-size: 1.2em;
            margin-top: 20px;
        }
        .section-title {
            font-size: 1.5em;
            font-weight: bold;
            margin-top: 30px;
            margin-bottom: 15px;
            border-bottom: 2px solid #ccc;
            padding-bottom: 5px;
        }
        .info-block {
            margin-bottom: 20px;
            padding: 15px;
            border: 1px solid #eee;
        }
        .contact-list {
            list-style: none;
            padding: 0;
        }
        .contact-list li {
            margin-bottom: 10px;
        }
        .contact-list a {
            color: #0056b3;
            text-decoration: none;
        }
        .contact-list a:hover {
            text-decoration: underline;
        }
        .legal-section {
            margin-top: 40px;
        }
        .legal-section h2 {
            font-size: 1.8em;
            text-align: center;
            margin-bottom: 20px;
        }
        .legal-item {
            margin-bottom: 15px;
            padding-left: 20px;
            position: relative;
        }
        .legal-item::before {
            content: '•';
            position: absolute;
            left: 0;
            color: #007bff;
        }
        .directory-section {
            margin-top: 40px;
        }
        .directory-section h2 {
            font-size: 1.8em;
            text-align: center;
            margin-bottom: 20px;
        }
        .directory-entry {
            border-bottom: 1px dashed #ccc;
            padding-bottom: 15px;
            margin-bottom: 15px;
        }
        .directory-entry h3 {
            font-size: 1.3em;
            margin-top: 0;
            margin-bottom: 5px;
        }
        .directory-entry p {
            margin: 3px 0;
            font-size: 0.95em;
        }
        .directory-entry .contact-info {
            margin-top: 10px;
            font-size: 0.9em;
        }
        .directory-entry .contact-info p {
            margin: 2px 0;
        }
    </style>
</head>
