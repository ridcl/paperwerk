<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  h1, h2, h3, h4 {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial;
  }
  .header-logo-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
  }
  .logo-left {
    display: flex;
    align-items: center;
  }
  .logo-right {
    text-align: right;
  }
  .title-section {
    text-align: center;
    margin-bottom: 40px;
  }
  .image-container {
    position: relative;
    width: 100%;
    height: 400px;
    margin-bottom: 20px;
    overflow: hidden;
  }
  .main-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .registration-bar {
    background-color: #cc0000;
    color: white;
    padding: 10px 0;
    text-align: center;
    font-weight: bold;
    margin-bottom: 40px;
  }
  .section-title {
    font-size: 1.5em;
    font-weight: bold;
    margin-top: 30px;
    margin-bottom: 15px;
    border-bottom: 1px solid #ccc;
    padding-bottom: 5px;
  }
  .speaker-info {
    margin-bottom: 20px;
  }
  .speaker-info p {
    margin: 2px 0;
  }
  .column-layout {
    display: flex;
    gap: 50px;
    margin-top: 30px;
  }
  .column {
    flex: 1;
  }
  .schedule-item {
    margin-bottom: 20px;
    border-left: 3px solid #000;
    padding-left: 15px;
  }
  .schedule-time {
    font-weight: bold;
    display: block;
    margin-bottom: 5px;
  }
  .schedule-details {
    margin-top: 5px;
  }
  .panel-details {
    margin-top: 10px;
    padding-left: 20px;
  }
  .panel-details p {
    margin: 3px 0;
    font-size: 0.95em;
  }
  .footer-section {
    margin-top: 50px;
    padding-top: 20px;
    border-top: 1px solid #ccc;
  }
  .contact-info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }
  .address-block, .travel-block {
    font-size: 0.9em;
  }
  .registration-form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 20px;
  }
  .form-section {
    margin-bottom: 30px;
  }
  .form-field-group {
    margin-bottom: 15px;
  }
  .form-field-group label {
    display: block;
    margin-bottom: 5px;
    font-weight: bold;
  }
  .form-field-group input[type="text"], .form-field-group input[type="email"], .form-field-group select {
    width: 100%;
    padding: 8px;
    box-sizing: border-box;
    border: 1px solid #ccc;
  }
  .table-container {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
  }
  .table-container th, .table-container td {
    border: 1px solid #000;
    padding: 8px;
    text-align: left;
  }
  .table-container th {
    background-color: #f0f0f0;
  }
</style>

<div class="page">
  <div class="header-logo-container">
    <div class="logo-left">
      <img src="" alt="Define Logo" style="height: 60px; margin-right: 15px;">
      <div>
        <h3 style="margin: 0; font-size: 1.2em;">Peter S. Kalikow Center for the Study of the American Presidency</h3>
        <h4 style="margin: 0; font-size: 1em;">Hofstra University School of Law</h4>
      </div>
    </div>
    <div class="logo-right">
      <div style="text-align: right;">
        <h3 style="margin: 0;">HOFSTRA UNIVERSITY.</h3>
      </div>
    </div>
  </div>

  <div class="title-section">
    <h2 style="font-size: 2.5em; margin-bottom: 10px;">President or King?</h2>
    <h1 style="font-size: 3em; margin-top: 0;">Evaluating the Expansion of Executive Power<br>From Abraham Lincoln to George W. Bush</h1>
    <p style="font-size: 1.2em; margin-top: 30px;">and the</p>
    <h3 style="font-size: 1.5em;">Hofstra Cultural Center</h3>
    <p style="font-size: 1.2em;">present</p>
    <h2 style="font-size: 2em; margin-top: 10px;">A Symposium</h2>
  </div>

  <div class="image-container">
    <img src="" alt="Symposium Image" class="main-image">
