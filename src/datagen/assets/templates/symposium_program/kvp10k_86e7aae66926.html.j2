<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    line-height: 1.5;
  }
</style>
<div class="page">
  <h1 style="text-align: center;">INDEX</h1>
  <h2 style="text-align: center; margin-top: 30px;">Student Presenters</h2>
  <div style="text-align: left; margin-top: 20px;">
    {% for item in student_presenters %}
    <div style="margin-bottom: 5px;">
      <span data-field="student_presenters[{{ loop.index0 }}].full_name">{{ item.full_name }}</span> {{ item.year }}
    </div>
    {% endfor %}
  </div>
</div>
<div class="page">
  <h1 style="text-align: center;">INDEX</h1>
  <h2 style="text-align: center; margin-top: 30px;">Faculty Advisors</h2>
  <div style="text-align: left; margin-top: 20px;">
    {% for item in faculty_advisors %}
    <div style="margin-bottom: 5px;">
      <span data-field="faculty_advisors[{{ loop.index0 }}].full_name">{{ item.full_name }}</span> {{ item.year }}
    </div>
    {% endfor %}
  </div>
</div>
<div class="page">
  <h2 style="text-align: center; margin-top: 50px;">A Special Thanks to our Honors Council Members:</h2>
  <div style="text-align: left; margin-top: 30px;">
    {% for item in honors_council_members %}
    <div style="margin-bottom: 5px;">
      <span data-field="honors_council_members[{{ loop.index0 }}].full_name">{{ item.full_name }}</span>
    </div>
    {% endfor %}
  </div>
</div>
<div class="page">
  <div style="text-align: center; margin-top: 50px;">
    <h2 style="font-size: 24pt; margin-bottom: 10px;">SUPPORT PROVIDED BY:</h2>
    <h1 style="font-size: 36pt; margin-bottom: 10px;">Andrews University</h1>
    <p style="text-align: center;">J.N. Andrews Honors Program</p>
    <p style="text-align: center;">{{ director_name }}</p>
    <p style="text-align: center;">{{ administrative_assistant_name }}</p>
    <p style="text-align: center;">{{ student_assistant_name }}</p>
    <p style="text-align: center; margin-top: 30px;">J.N. Andrews Honors Program</p>
    <p style="text-align: center;">{{ address_line_1 }}</p>
    <p style="text-align: center;">{{ address_line_2 }}</p>
    <p style="text-align: center;">{{ city_state_zip }}</p>
    <p style="text-align: center; margin-top: 20px;">Phone: {{ phone_number }}</p>
    <p style="text-align: center;">Email: {{ email_address }}</p>
    <p style="text-align: center;">URL: {{ website_url }}</p>
  </div>
  <div style="text-align: center; margin-top: 50px;">
    <img src="placeholder_logo.png" alt="Andrews Honors Program Logo" style="max-width: 200px; height: auto;">
    <p style="font-size: 14pt; margin-top: 10px;">55 Years</p>
    <p style="font-size: 12pt;">{{ start_year }}-{{ end_year }}</p>
  </div>
</div></body>
</html>