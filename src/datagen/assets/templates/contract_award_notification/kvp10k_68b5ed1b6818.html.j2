<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1, h2 { text-align: center; margin-bottom: 20px; }
  .header-logo { text-align: center; margin-bottom: 30px; }
  .footer { text-align: center; font-size: 10pt; margin-top: 50px; }
</style>

<div class="page">
  <div style="text-align: center;">
    <h1 style="font-size: 14pt; font-weight: bold;">OFFICE OF CONTRACTING AND PROCUREMENT</h1>
  </div>

  <div class="header-logo">
    <!-- Placeholder for University Logo -->
    <div style="font-size: 24pt; margin-bottom: 10px;">UNIVERSITY OF<br>DISTRICT OF<br>COLUMBIA</div>
    <div style="font-size: 10pt;">1851</div>
  </div>

  <div style="text-align: center; margin-bottom: 40px;">
    <h2 style="font-size: 12pt; font-weight: normal;">CONTRACT AWARD NOTIFICATION</h2>
  </div>

  <div style="margin-bottom: 30px;">
    <p>SOLICITATION NUMBER: <span data-field="solicitation_number">{{ solicitation_number }}</span></p>
    <p>CAPTION: <span data-field="caption">{{ caption }}</span></p>
  </div>

  <div style="margin-bottom: 30px;">
    <p>COMPANY: <span data-field="company_name">{{ company_name }}</span></p>
  </div>

  <div style="margin-bottom: 30px;">
    <p>CONTRACT AWARD DATE: <span data-field="contract_award_date">{{ contract_award_date }}</span></p>
    <p>CONTRACT AWARD AMOUNT: <span data-field="contract_award_amount">{{ contract_award_amount }}</span></p>
  </div>

  <div class="footer">
    <p>4200 CONNECTICUT AVENUE, NW • BUILDING 38, SUITE 301 • WASHINGTON, DC 20008</p>
    <p>PHONE: <span data-field="phone">{{ phone }}</span> • FAX: <span data-field="fax">{{ fax }}</span></p>
  </div>
</div>