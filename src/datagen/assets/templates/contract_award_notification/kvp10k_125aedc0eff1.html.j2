<style>
    @page { size: A4; margin: 0; }
    .page {
        width: 794px; height: 1123px;
        padding: 50px 60px; box-sizing: border-box;
        overflow: hidden; page-break-after: always;
        position: relative;
        font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
    }
    .page:last-child { page-break-after: auto; }
    h1, h2, h3 {
        font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif;
    }
    .header-logo {
        text-align: center;
        margin-bottom: 30px;
    }
    .footer {
        position: absolute;
        bottom: 50px;
        left: 60px;
        right: 60px;
        font-size: 10pt;
        text-align: center;
        font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif;
    }
    .divider {
        border-top: 1px solid #000;
        margin: 20px 0;
    }
</style>

<div class="page">
    <div style="text-align: center;">
        <h1 style="font-size: 14pt; margin-bottom: 5px;">OFFICE OF CONTRACTING AND PROCUREMENT</h1>
        <div class="header-logo">
            <!-- Placeholder for University Logo -->
            <div style="font-size: 24pt; margin-bottom: 10px;">
                <span style="font-family: Georgia, serif;">UNIVERSITY OF</span><br>
                <span style="font-family: Georgia, serif;">DISTRICT OF</span><br>
                <span style="font-family: Georgia, serif;">COLUMBIA</span>
            </div>
        </div>
        <h2 style="font-size: 12pt; margin-top: 0;">CONTRACT AWARD NOTIFICATION</h2>
    </div>

    <div style="margin-top: 40px;">
        <p>SOLICITATION NUMBER: <span data-field="solicitation_number">{{ solicitation_number }}</span></p>
        <p>CAPTION: <span data-field="caption">{{ caption }}</span></p>
        <p>COMPANY: <span data-field="company_name">{{ company_name }}</span></p>
        <p>CONTRACT AWARD DATE: <span data-field="award_date">{{ award_date }}</span></p>
        <p>CONTRACT AWARD AMOUNT: <span data-field="award_amount">{{ award_amount }}</span></p>
    </div>

    <div class="divider"></div>

    <!-- No line items or variable tables present in the source layout -->

    <div class="footer">
        <p>4200 CONNECTICUT AVENUE, NW • BUILDING 38, SUITE 301 • WASHINGTON, DC {{ zip_code }}</p>
        <p>PHONE: ({{ phone_area_code }}) {{ phone_prefix }}-{{ phone_line }} • FAX: ({{ fax_area_code }}) {{ fax_prefix }}-{{ fax_line }}</p>
    </div>
</div>