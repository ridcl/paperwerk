<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 {
    font-weight: bold;
    margin-top: 0;
  }
  .header-info {
    text-align: center;
    margin-bottom: 30px;
  }
  .contact-info {
    text-align: center;
    margin-bottom: 40px;
  }
  .section {
    margin-bottom: 30px;
  }
  .job-entry, .education-entry {
    margin-bottom: 20px;
  }
  .job-title {
    font-weight: bold;
  }
  .dates {
    float: right;
    font-style: italic;
  }
  .list-item {
    margin-bottom: 8px;
    line-height: 1.4;
  }
  .skills-list {
    list-style-type: disc;
    padding-left: 20px;
  }
  .publication-item {
    margin-bottom: 15px;
  }
  .reference-entry {
    margin-bottom: 20px;
  }
  .reference-name {
    font-weight: bold;
  }
</style>

<div class="page">
  <div class="header-info">
    <span data-field="full_name">{{ full_name }}</span>
  </div>
  <div class="contact-info">
    <p><span data-field="address_line_1">{{ address_line_1 }}</span></p>
    <p><span data-field="city_state_zip">{{ city_state_zip }}</span></p>
    <p>Phone: <span data-field="phone">{{ phone }}</span></p>
    <p>Email: <span data-field="email">{{ email }}</span></p>
  </div>

  <div class="section">
    <h2>Objective</h2>
    <p><span data-field="objective_text">{{ objective_text }}</span></p>
  </div>

  <div class="section">
    <h2>Education</h2>
    <div class="education-entry">
      <p><span data-field="university_name_1">{{ university_name_1 }}</span></p>
      <p><span data-field="degree_1">{{ degree_1 }}</span></p>
      <span class="dates">{{ date_range_1 }}</span>
    </div>
    <div class="education-entry">
      <p><span data-field="university_name_2">{{ university_name_2 }}</span></p>
      <p><span data-field="degree_2">{{ degree_2 }}</span></p>
      <span class="dates">{{ date_range_2 }}</span>
    </div>
    <div class="education-entry">
      <p><span data-field="university_name_3">{{ university_name_3 }}</span></p>
      <p><span data-field="degree_3">{{ degree_3 }}</span></p>
      <span class="dates">{{ date_range_3 }}</span>
    </div>
    <div class="education-entry">
      <p><span data-field="university_name_4">{{ university_name_4 }}</span></p>
      <p><span data-field="degree_4">{{ degree_4 }}</span></p>
      <span class="dates">{{ date_range_4 }}</span>
    </div>
    <div class="education-entry">
      <p><span data-field="university_name_5">{{ university_name_5 }}</span></p>
      <p><span data-field="degree_5">{{ degree_5 }}</span></p>
      <span class="dates">{{ date_range_5 }}</span>
    </div>
  </div>

  <div class="section">
    <h2>Professional Experience</h2>
    <div class="job-entry">
      <p><span data-field="employer_name_1">{{ employer_name_1 }}</span></p>
      <p><span data-field="job_title_1">{{ job_title_1 }}</span></p>
      <p><span data-field="description_1">{{ description_1 }}</span></p>
      <span class="dates">{{ date_range_job_1 }}</span>
    </div>
    <div class="job-entry">
      <p><span data-field="employer_name_2">{{ employer_name_2 }}</span></p>
      <p><span data-field="job_title_2">{{ job_title_2 }}</span></p>
      <p><span data-field="description_2">{{ description_2 }}</span></p>
      <span class="dates">{{ date_range_job_2 }}</span>
    </div>
    <div class="job-entry">
      <p><span data-field="employer_name_3">{{ employer_name_3 }}</span></p>
      <p><span data-field="job_title_3">{{ job_title_3 }}</span></p>
      <p><span data-field="description_3">{{ description_3 }}</span></p>
      <span class="dates">{{ date_range_job_3 }}</span>
    </div>
    <div class="job-entry">
      <p><span data-field="employer_name_4">{{ employer_name_4 }}</span></p>
      <p><span data-field="job_title_4">{{ job_title_4 }}</span></p>
      <p><span data-field="description_4">{{ description_4 }}</span></p>
      <span class="dates">{{ date_range_job_4 }}</span>
    </div>
  </div>

  <div class="section">
    <h2>Doctoral Dissertation</h2>
    <p><span data-field="dissertation_title">{{ dissertation_title }}</span></p>
    <p><span data-field="dissertation_link">{{ dissertation_link }}</span></p>
    <span class="dates">(2019)</span>
  </div>

  <div class="section">
    <h2>Masters Thesis</h2>
    <p><span data-field="thesis_title">{{ thesis_title }}</span></p>
    <p><span data-field="thesis_link">{{ thesis_link }}</span></p>
    <span class="dates">(2014)</span>
  </div>

  <div class="section">
    <h2>Skills and Strengths</h2>
    <ul class="skills-list">
      <li class="list-item"><span data-field="skill_1">{{ skill_1 }}</span></li>
      <li class="list-item"><span data-field="skill_2">{{ skill_2 }}</span></li>
      <li class="list-item"><span data-field="skill_3">{{ skill_3 }}</span></li>
      <li class="list-item"><span data-field="skill_4">{{ skill_4 }}</span></li>
      <li class="list-item"><span data-field="skill_5">{{ skill_5 }}</span></li>
      <li class="list-item"><span data-field="skill_6">{{ skill_6 }}</span></li>
      <li class="list-item"><span data-field="skill_7">{{ skill_7 }}</span></li>
      <li class="list-item"><span data-field="skill_8">{{ skill_8 }}</span></li>
      <li class="list-item"><span data-field="skill_9">{{ skill_9 }}</span></li>
      <li class="list-item"><span data-field="skill_10">{{ skill_10 }}</span></li>
    </ul>
  </div>

  <div class="section">
    <h2>Research Interests</h2>
    <div style="display: flex; justify-content: space-between;">
      <ul class="skills-list" style="width: 48%;">
        <li class="list-item"><span data-field="interest_1">{{ interest_1 }}</span></li>
        <li class="list-item"><span data-field="interest_2">{{ interest_2 }}</span></li>
        <li class="list-item"><span data-field="interest_3">{{ interest_3 }}</span></li>
        <li class="list-item"><span data-field="interest_4">{{ interest_4 }}</span></li>
        <li class="list-item"><span data-field="interest_5">{{ interest_5 }}</span></li>
        <li class="list-item"><span data-field="interest_6">{{ interest_6 }}</span></li>
      </ul>
      <ul class="skills-list" style="width: 48%;">
        <li class="list-item"><span data-field="interest_7">{{ interest_7 }}</span></li>
        <li class="list-item"><span data-field="interest_8">{{ interest_8 }}</span></li>
        <li class="list-item"><span data-field="interest_9">{{ interest_9 }}</span></li>
        <li class="list-item"><span data-field="interest_10">{{ interest_10 }}</span></li>
        <li class="list-item"><span data-field="interest_11">{{ interest_11 }}</span></li>
      </ul>
    </div>
  </div>

  <div class="section">
    <h2>Publications and Digital Collaborations</h2>
    <div class="publication-item">
      <p><span data-field="publication_title_1">{{ publication_title_1 }}</span></p>
    </div>
    <div class="publication-item">
      <p><span data-field="publication_title_2">{{ publication_title_2 }}</span> The Florida Historical Quarterly, vol.1, number 4, Spring 2017. <span data-field="publication_type">{{ publication_type }}</span></p>
    </div>
    <div class="publication-item">
      <p><span data-field="publication_title_3">{{ publication_title_3 }}</span> 2012-2015. University of Central Florida. <span data-field="publication_link">{{ publication_link }}</span></p>
    </div>
  </div>

  <div class="section">
    <h2>Conference Attendance and Presentations</h2>
    <div class="conference-entry">
      <p><span data-field="conference_title_1">{{ conference_title_1 }}</span> 2017-2019. University of Central Florida</p>
      <p><span data-field="conference_location_1">{{ conference_location_1 }}</span></p>
      <span class="dates">Mar 2023</span>
    </div>
    <div class="conference-entry">
      <p><span data-field="conference_title_2">{{ conference_title_2 }}</span></p>
      <p><span data-field="conference_presentation_2">{{ conference_presentation_2 }}</span></p>
      <span class="dates">Sept 2022</span>
    </div>
    <div class="conference-entry">
      <p><span data-field="conference_title_3">{{ conference_title_3 }}</span></p>
      <p><span data-field="conference_presentation_3">{{ conference_presentation_3 }}</span></p>
      <span class="dates">Feb 2015, 2016, 2017, 2020</span>
    </div>
    <div class="conference-entry">
      <p><span data-field="conference_title_4">{{ conference_title_4 }}</span></p>
      <p><span data-field="conference_presentation_4">{{ conference_presentation_4 }}</span></p>
      <span class="dates">July 2019</span>
    </div>
    <div class="conference-entry">
      <p><span data-field="conference_title_5">{{ conference_title_5 }}</span></p>
      <p><span data-field="conference_presentation_5">{{ conference_presentation_5 }}</span></p>
      <p><span data-field="conference_presentation_6">{{ conference_presentation_6 }}</span></p>
      <span class="dates">Nov 2017</span>
    </div>
    <div class="conference-entry">
      <p><span data-field="conference_title_6">{{ conference_title_6 }}</span></p>
      <p><span data-field="conference_presentation_7">{{ conference_presentation_7 }}</span></p>
      <span class="dates">April 2015</span>
    </div>
    <div class="conference-entry">
      <p><span data-field="conference_title_7">{{ conference_title_7 }}</span></p>
      <p><span data-field="conference_presentation_8">{{ conference_presentation_8 }}</span></p>
      <span class="dates">April 2014</span>
    </div>
    <div class="conference-entry">
      <p><span data-field="conference_title_8">{{ conference_title_8 }}</span></p>
      <p><span data-field="conference_presentation_9">{{ conference_presentation_9 }}</span></p>
      <span class="dates">April 2014</span>
    </div>
    <div class="conference-entry">
      <p><span data-field="conference_title_9">{{ conference_title_9 }}</span></p>
      <span class="dates">Jan 2012</span>
    </div>
  </div>

  <div class="section">
    <h2>Awards</h2>
    <ul class="skills-list">
      <li class="list-item"><span data-field="award_1">{{ award_1 }}</span></li>
      <li class="list-item"><span data-field="award_2">{{ award_2 }}</span></li>
      <li class="list-item"><span data-field="award_3">{{ award_3 }}</span></li>
    </ul>
