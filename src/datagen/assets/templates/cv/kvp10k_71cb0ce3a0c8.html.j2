  <div class="section">
    <h2>Certifications</h2>
    <ul class="skills-list">
      <li class="list-item"><span data-field="certification_1">{{ certification_1 }}</span></li>
      <li class="list-item"><span data-field="certification_2">{{ certification_2 }}</span></li>
      <li class="list-item"><span data-field="certification_3">{{ certification_3 }}</span></li>
    </ul>
  </div>

  <div class="section">
    <h2>Projects and Service</h2>
    <ul class="skills-list">
      <li class="list-item"><span data-field="project_1">{{ project_1 }}</span></li>
      <li class="list-item"><span data-field="project_2">{{ project_2 }}</span></li>
      <li class="list-item"><span data-field="project_3">{{ project_3 }}</span></li>
      <li class="list-item"><span data-field="project_4">{{ project_4 }}</span></li>
      <li class="list-item"><span data-field="project_5">{{ project_5 }}</span></li>
      <li class="list-item"><span data-field="project_6">{{ project_6 }}</span></li>
    </ul>
  </div>

  <div class="section">
    <h2>Affiliations</h2>
    <ul class="skills-list">
      <li class="list-item"><span data-field="affiliation_1">{{ affiliation_1 }}</span></li>
      <li class="list-item"><span data-field="affiliation_2">{{ affiliation_2 }}</span></li>
      <li class="list-item"><span data-field="affiliation_3">{{ affiliation_3 }}</span></li>
