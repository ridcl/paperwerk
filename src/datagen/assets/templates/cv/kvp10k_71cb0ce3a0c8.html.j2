      <p><span data-field="ref_department_1">{{ ref_department_1 }}</span></p>
      <p><span data-field="ref_university_1">{{ ref_university_1 }}</span></p>
      <p><span data-field="ref_email_1">{{ ref_email_1 }}</span></p>
      <p><span data-field="ref_phone_1">{{ ref_phone_1 }}</span></p>
      <p><span data-field="ref_affiliation_1">{{ ref_affiliation_1 }}</span></p>
      <p><span data-field="ref_affiliation_2">{{ ref_affiliation_2 }}</span></p>
      <p><span data-field="ref_website_1">{{ ref_website_1 }}</span></p>
