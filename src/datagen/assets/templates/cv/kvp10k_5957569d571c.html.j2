<body>
<div class="page">
  <h1 style="text-align: center;">{{ full_name }}, MPA, PhD</h1>

  <div class="section-title">Education</div>
  <div class="entry">
    <span class="date">{{ education_dates[0] }}</span>
    <span class="description">{{ education_institution_1 }}</span>
    <p>{{ education_degree_1 }}</p>
    <p>{{ education_focus_1 }}</p>
    <p>{{ education_dissertation_1 }}</p>
  </div>
