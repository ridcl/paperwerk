    <p>{{ education_focus_3 }}</p>
  </div>

  <div class="section-title">Memberships</div>
  <ul>
    <li>{{ membership_1 }}</li>
    <li>{{ membership_2 }}</li>
  </ul>

  <div class="section-title">Research experience</div>
  <table>
    <thead>
      <tr>
        <td style="width: 10%;"></td>
        <td style="width: 40%;"></td>
        <td style="width: 50%;"></td>
      </tr>
    </thead>
    <tbody>
      {% for item in research_experience %}
      <tr>
        <td><span data-field="research_experience[{{ loop.index0 }}].dates">{{ item.dates }}</span></td>
        <td><span data-field="research_experience[{{ loop.index0 }}].role">{{ item.role }}</span></td>
        <td><span data-field="research_experience[{{ loop.index0 }}].institution">{{ item.institution }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

