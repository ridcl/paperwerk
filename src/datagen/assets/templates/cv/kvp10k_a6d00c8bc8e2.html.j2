<!DOCTYPE html>
<html>
<head>
<title>Synthetic Document</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .header-title {
    font-size: 18pt;
    font-weight: bold;
  }
  .header-subtitle {
    font-size: 14pt;
    font-weight: bold;
  }
  .section-heading {
    font-size: 12pt;
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
  }
  .contact-info p {
    margin: 2px 0;
  }
  .metadata-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 10px;
  }
  .metadata-label {
    font-weight: bold;
  }
  .metadata-value {
    text-align: right;
  }
  .education-entry, .experience-entry {
    margin-bottom: 15px;
  }
  .education-entry .date {
    font-weight: bold;
    display: inline-block;
    width: 80px;
  }
  .education-entry .details {
    display: inline-block;
    width: calc(100% - 80px);
  }
  .experience-entry .date {
    font-weight: bold;
    display: inline-block;
    width: 80px;
  }
  .experience-entry .details {
    display: inline-block;
    width: calc(100% - 80px);
  }
  .table-container {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
  }
  .table-container th, .table-container td {
    border: 1px solid #ccc;
    padding: 8px;
    text-align: left;
    font-size: 10pt;
  }
  .table-container th {
    background-color: #f2f2f2;
    font-weight: bold;
  }
  .publication-entry {
    margin-bottom: 15px;
    font-size: 10pt;
  }
  .publication-entry strong {
    font-weight: bold;
  }
  .footer {
    text-align: center;
    position: absolute;
    bottom: 20px;
    width: 100%;
    font-size: 9pt;
  }
</style>

<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child {
    page-break-after: auto;
  }
  h1, h2, h3 {
    font-weight: bold;
    margin-top: 0;
  }
  .section-title {
    font-weight: bold;
    margin-bottom: 15px;
  }
  .list-item {
    margin-bottom: 10px;
    line-height: 1.4;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
  }
  td {
    padding: 8px 0;
    vertical-align: top;
  }
  .centered {
    text-align: center;
  }
</style>
</head>
<body>
<div class="page">
  <div style="text-align: center; margin-bottom: 30px;">
    <div class="header-title">UNIVERSITY OF WYOMING</div>
    <div class="header-subtitle">COLLEGE OF BUSINESS STANDARD VITA</div>
    <div style="font-size: 10pt;">Last Revision: <span data-field="revision_date">{{ revision_date }}</span></div>
  </div>

  <div style="display: flex; justify-content: space-between; margin-bottom: 30px;">
    <div>
      <div style="font-weight: bold;">NAME</div>
      <div style="font-size: 12pt;"><span data-field="full_name">{{ full_name }}</span></div>
    </div>
    <div class="contact-info">
      <div style="font-weight: bold;">CONTACT INFORMATION</div>
      <p>Department of Economics</p>
      <p><span data-field="employer.name">{{ employer.name }}</span></p>
      <p><span data-field="employer.address_line_1">{{ employer.address_line_1 }}</span></p>
      <p><span data-field="employer.city_state_zip">{{ employer.city_state_zip }}</span></p>
      <div style="margin-top: 10px;">
        <p>work: <span data-field="phone_work">{{ phone_work }}</span> department</p>
        <p>direct: <span data-field="phone_direct">{{ phone_direct }}</span> land line</p>
        <p>fax: <span data-field="phone_fax">{{ phone_fax }}</span> cell</p>
        <p>e-mail: <span data-field="email">{{ email }}</span></p>
      </div>
    </div>
  </div>

  <div class="section-heading">EDUCATION</div>
  <div class="education-entry">
    <span class="date">{{ 1975 }}</span>
    <span class="details">{{ education_details_1 }}</span>
  </div>
  <div class="education-entry">
    <span class="date">{{ 1980 }}</span>
    <span class="details">{{ education_details_2 }}</span>
  </div>
  <div class="education-entry">
    <span class="date">{{ 1985 }}</span>
    <span class="details">{{ education_details_3 }}</span>
  </div>
  <div class="education-entry">
    <span class="date">{{ 1979 }}</span>
    <span class="details">{{ education_details_4 }}</span>
  </div>

  <div class="section-heading">ACADEMIC POSITIONS</div>
  <div class="experience-entry">
    <span class="date">{{ 2019 }}</span>
    <span class="details">{{ academic_position_1 }}</span>
  </div>
  <div class="experience-entry">
    <span class="date">{{ 1995 }}</span>
    <span class="details">{{ academic_position_2 }}</span>
  </div>
  <div class="experience-entry">
    <span class="date">{{ 2016 }}</span>
    <span class="details">{{ academic_position_3 }}</span>
  </div>
  <div class="experience-entry">
    <span class="date">{{ 2010 }}</span>
    <span class="details">{{ academic_position_4 }}</span>
  </div>
  <div class="experience-entry">
    <span class="date">{{ 2005 }}</span>
    <span class="details">{{ academic_position_5 }}</span>
  </div>
  <div class="experience-entry">
    <span class="date">{{ 1999 }}</span>
    <span class="details">{{ academic_position_6 }}</span>
  </div>
  <div class="experience-entry">
    <span class="date">{{ 1988 }}</span>
    <span class="details">{{ academic_position_7 }}</span>
  </div>
  <div class="experience-entry">
    <span class="date">{{ 1985 }}</span>
    <span class="details">{{ academic_position_8 }}</span>
  </div>

  <div class="section-heading">OTHER EXPERIENCE</div>
  <div class="experience-entry">
    <span class="date">{{ 2017 }}</span>
    <span class="details">{{ other_experience_1 }}</span>
  </div>
  <div class="experience-entry">
    <span class="date">{{ 2006 }}</span>
    <span class="details">{{ other_experience_2 }}</span>
  </div>
  <div class="experience-entry">
    <span class="date">{{ 1988 }}</span>
    <span class="details">{{ other_experience_3 }}</span>
  </div>
  <div class="experience-entry">
    <span class="date">{{ 1988 }}</span>
    <span class="details">{{ other_experience_4 }}</span>
  </div>

  <div class="section-heading">TEACHING</div>
  <div class="table-container">
    <thead>
      <tr>
        <th>Year</th>
        <th>Semester</th>
        <th>Course Number & Title</th>
        <th>Cr. Hrs.</th>
        <th>Enrollment</th>
      </tr>
    </thead>
    <tbody>
      {% for item in teaching_courses %}
      <tr>
        <td><span data-field="teaching_courses[{{ loop.index0 }}].year">{{ item.year }}</span></td>
        <td><span data-field="teaching_courses[{{ loop.index0 }}].semester">{{ item.semester }}</span></td>
        <td><span data-field="teaching_courses[{{ loop.index0 }}].course_title">{{ item.course_title }}</span></td>
        <td><span data-field="teaching_courses[{{ loop.index0 }}].credits">{{ item.credits }}</span></td>
        <td><span data-field="teaching_courses[{{ loop.index0 }}].enrollment">{{ item.enrollment }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </div>

  <div class="section-heading">PUBLICATIONS</div>
  <div class="publication-entry">
    <strong>Books:</strong>
    {% for book in publications.books %}
    <div style="margin-left: 20px;">
      <span data-field="publication_books[{{ loop.index0 }}].authors">{{ book.authors }}</span>, <span data-field="publication_books[{{ loop.index0 }}].year">{{ book.year }}</span>, <em><span data-field="publication_books[{{ loop.index0 }}].title">{{ book.title }}</span></em>. <span data-field="publication_books[{{ loop.index0 }}].publisher_info">{{ book.publisher_info }}</span>.
    </div>
    {% endfor %}
  </div>

  <div class="section-heading">REFEREED JOURNAL ARTICLES</div>
  {% for article in publications.articles %}
  <div class="publication-entry">
    <span data-field="publication_articles[{{ loop.index0 }}].authors">{{ article.authors }}</span>, <span data-field="publication_articles[{{ loop.index0 }}].year">{{ article.year }}</span>, <em><span data-field="publication_articles[{{ loop.index0 }}].title">{{ article.title }}</span></em>. <span data-field="publication_articles[{{ loop.index0 }}].journal_info">{{ article.journal_info }}</span>.
  </div>
  {% endfor %}

  <div class="footer">
    <span data-field="page_number">{{ page_number }}</span>
  </div>
</div>
<div class="page">
  <div class="footer">
    <span data-field="page_number">{{ page_number }}</span>
  </div>
</div>
