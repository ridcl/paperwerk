<body>
<div class="page">
  <header>
    <h1 style="text-align: center;">{{ full_name }}</h1>
    <p style="text-align: center; margin-top: 5px;">{{ employer.department }}</p>
    <p style="text-align: center;">{{ employer.address_line_1 }}, {{ employer.city }}, {{ employer.state }} {{ employer.zip_code }}</p>
    <p style="text-align: center;">{{ employer.phone }} | E-mail: {{ employer.email }}</p>
    <p style="text-align: center;">SSRN Author Page: {{ employer.ssrn_url }}</p>
    <p style="text-align: center;">Home Page: {{ employer.homepage }}</p>
  </header>

  <div class="section-title">Main Employment</div>
