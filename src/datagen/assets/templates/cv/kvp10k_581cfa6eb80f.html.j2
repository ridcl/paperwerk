  h1, h2, h3, h4 { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif; }
  p, td, span { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif; }
  ul { list-style-type: disc; padding-left: 20px; }
  li { margin-bottom: 5px; }
</style>
<style>
