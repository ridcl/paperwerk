<div class="page">
  <p><span data-field="full_name">{{ full_name }}</span></p>
  <p><span data-field="contact_info">{{ contact_info }}</span></p>

  <h2>Education</h2>
  <ul>
    <li><span data-field="education_entry.degree">{{ education_entry.degree }}</span>, <span data-field="education_entry.major">{{ education_entry.major }}</span>, <span data-field="education_entry.institution">{{ education_entry.institution }}</span>, <span data-field="education_entry.years">{{ education_entry.years }}</span>.</li>
  </ul>

  <h2>Experience</h2>
  <h3>Professional Experience</h3>
  <ul>
    {% for job in professional_experience %}
    <li>
      <strong>{{ job.title }}</strong>, <span data-field="job.employer">{{ job.employer }}</span>, <span data-field="job.years">{{ job.years }}</span>.
      <ul style="margin-top: 5px;">
        {% for duty in job.duties %}
        <li>{{ duty }}</li>
        {% endfor %}
      </ul>
    </li>
    {% endfor %}
  </ul>

  <h3>Teaching Experience</h3>
  <ul>
    {% for teaching_entry in teaching_experience %}
    <li><span data-field="teaching_entry.role">{{ teaching_entry.role }}</span> at <span data-field="teaching_entry.institution">{{ teaching_entry.institution }}</span>, <span data-field="teaching_entry.years">{{ teaching_entry.years }}</span>.</li>
    {% endfor %}
  </ul>

  <h3>Research & Publications</h3>
  <h4>Publications</h4>
  <ul>
    {% for publication in publications %}
    <li><span data-field="publication.title">{{ publication.title }}</span>, <span data-field="publication.journal">{{ publication.journal }}</span>, <span data-field="publication.years">{{ publication.years }}</span>.</li>
    {% endfor %}
  </ul>

  <h4>Presentations</h4>
  <ul>
    {% for presentation in presentations %}
    <li><span data-field="presentation.title">{{ presentation.title }}</span> at <span data-field="presentation.conference">{{ presentation.conference }}</span>, <span data-field="presentation.years">{{ presentation.years }}</span>.</li>
    {% endfor %}
  </ul>

</div>

<div class="page">
  <h2>Skills</h2>
  <ul>
