    <li><span data-field="skills[{{ loop.index0 }}]">{{ skill }}</span></li>
    {% endfor %}
  </ul>

  <h2>Awards and Honors</h2>
  <ul>
    {% for award in awards %}
    <li><span data-field="award.name">{{ award.name }}</span>, <span data-field="award.institution">{{ award.institution }}</span>, <span data-field="award.years">{{ award.years }}</span>.</li>
    {% endfor %}
  </ul>

  <h2>Service</h2>
  <h3>Professional Service</h3>
