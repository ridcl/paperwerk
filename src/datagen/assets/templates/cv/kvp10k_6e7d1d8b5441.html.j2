<!DOCTYPE html>
<html>
<head>
<title>CV Template</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { font-weight: bold; }
  .section-title { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
  .contact-info p { margin: 2px 0; }
  .job-entry, .education-entry { margin-bottom: 15px; }
  .job-entry h3, .education-entry h3 { margin: 0; font-weight: bold; }
  .job-entry p, .education-entry p { margin: 2px 0; font-size: 0.9em; }
  ul { list-style-type: disc; padding-left: 20px; margin-top: 5px; margin-bottom: 5px; }
  li { margin-bottom: 5px; }
</style>

<style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
        }
        .page:last-child { page-break-after: auto; }
        body {
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
            line-height: 1.5;
            color: #000;
        }
        h1, h2, h3 {
            font-weight: bold;
        }
        ul {
            list-style-type: disc;
            margin-left: 20px;
        }
        li {
            margin-bottom: 10px;
        }
    </style>
</head>
<body>
<div class="page">
  <header>
    <h1 style="font-size: 24pt; margin-bottom: 5px;"><span data-field="full_name">{{ full_name }}</span></h1>
    <p style="font-size: 12pt; margin-top: 0;">Assistant Professor</p>
    <p style="font-size: 12pt; margin-top: 0;">Kennesaw State University</p>
    <p style="font-size: 12pt; margin-top: 0;">Department of Physics</p>
    <div class="contact-info" style="margin-top: 10px;">
      <p>1100 S Marietta Pkwy, Marietta, GA, <span data-field="zip_code">{{ zip_code }}</span></p>
      <p>Academic building H260 F</p>
      <p>Email: <a href="mailto:{{ email }}"><span data-field="email">{{ email }}</span></a></p>
      <p>Google Scholar: <a href="{{ google_scholar_link }}"><span data-field="google_scholar_link">{{ google_scholar_link }}</span></a></p>
      <p>Faculty Webpage: <a href="{{ faculty_webpage_link }}"><span data-field="faculty_webpage_link">{{ faculty_webpage_link }}</span></a></p>
      <p>Ph: <span data-field="phone_number">{{ phone_number }}</span></p>
    </div>
  </header>

  <section style="margin-top: 30px;">
    <h2 class="section-title">Research Interests</h2>
    <ul>
      <li><span data-field="research_interest_1">{{ research_interest_1 }}</span></li>
      <li><span data-field="research_interest_2">{{ research_interest_2 }}</span></li>
    </ul>
  </section>

  <section style="margin-top: 30px;">
    <h2 class="section-title">Education</h2>
    <div class="education-entry">
      <h3><span data-field="education_degree_1">{{ education_degree_1 }}</span></h3>
      <p><span data-field="education_institution_1">{{ education_institution_1 }}</span>, <span data-field="education_location_1">{{ education_location_1 }}</span></p>
      <p>Supervisor: (Dr. <span data-field="supervisor_name_1">{{ supervisor_name_1 }}</span>)</p>
    </div>
    <div class="education-entry">
      <h3><span data-field="education_degree_2">{{ education_degree_2 }}</span></h3>
      <p><span data-field="education_institution_2">{{ education_institution_2 }}</span>, <span data-field="education_location_2">{{ education_location_2 }}</span></p>
      <p>Supervisor: (<span data-field="supervisor_name_2">{{ supervisor_name_2 }}</span>)</p>
    </div>
  </section>

  <section style="margin-top: 30px;">
    <h2 class="section-title">Appointments</h2>
    <div class="job-entry">
      <h3><span data-field="appointment_title_1">{{ appointment_title_1 }}</span></h3>
      <p><span data-field="appointment_institution_1">{{ appointment_institution_1 }}</span> (<span data-field="appointment_location_1">{{ appointment_location_1 }}</span>)</p>
      <p><span data-field="appointment_dates_1">{{ appointment_dates_1 }}</span></p>
    </div>
    <div class="job-entry">
      <h3><span data-field="appointment_title_2">{{ appointment_title_2 }}</span></h3>
      <p><span data-field="appointment_institution_2">{{ appointment_institution_2 }}</span> (<span data-field="appointment_location_2">{{ appointment_location_2 }}</span>)</p>
      <p><span data-field="appointment_dates_2">{{ appointment_dates_2 }}</span></p>
    </div>
    <div class="job-entry">
      <h3><span data-field="appointment_title_3">{{ appointment_title_3 }}</span></h3>
      <p><span data-field="appointment_institution_3">{{ appointment_institution_3 }}</span> (<span data-field="appointment_location_3">{{ appointment_location_3 }}</span>)</p>
      <p><span data-field="appointment_dates_3">{{ appointment_dates_3 }}</span></p>
    </div>
  </section>

  <div style="display: flex; margin-top: 40px;">
    <div style="width: 50%;">
      <section style="margin-bottom: 30px;">
        <h2 class="section-title">Teaching and mentoring Experience</h2>
        <ul>
          {% for entry in teaching_experience %}
          <li>
            <span data-field="teaching_entry_institution">{{ entry.institution }}</span>
            <ul>
              {% for detail in entry.details %}
              <li><span data-field="teaching_detail">{{ detail }}</span></li>
              {% endfor %}
            </ul>
          </li>
          {% endfor %}
        </ul>
      </section>

      <section style="margin-bottom: 30px;">
        <h2 class="section-title">Service</h2>
        <ul>
          {% for service in service_items %}
          <li><span data-field="service_item">{{ service }}</span></li>
          {% endfor %}
        </ul>
      </section>
    </div>

    <div style="width: 50%;">
      <section style="margin-bottom: 30px;">
        <h2 class="section-title">Awards & Honors</h2>
        <ul>
          {% for award in awards %}
          <li><span data-field="award_item">{{ award }}</span></li>
          {% endfor %}
        </ul>
      </section>

      <section style="margin-bottom: 30px;">
        <h2 class="section-title">Publications</h2>
        <ol>
          {% for pub in publications %}
          <li>
            <span data-field="publication_item">{{ pub }}</span>
          </li>
          {% endfor %}
        </ol>
      </section>

      <section style="margin-bottom: 30px;">
        <h2 class="section-title">Technical Skills</h2>
        <ul>
          {% for skill in technical_skills %}
          <li><span data-field="skill_item">{{ skill }}</span></li>
          {% endfor %}
        </ul>
      </section>
    </div>
  </div>
</div>


    <div class="page">
        <ul>
            <li><span data-field="expertise_1">{{ expertise_1 }}</span></li>
            <li><span data-field="expertise_2">{{ expertise_2 }}</span></li>
            <li><span data-field="software_1">{{ software_1 }}</span></li>
            <li><span data-field="microscopy">{{ microscopy }}</span></li>
        </ul>
        <p><span data-field="short_term_visit">{{ short_term_visit }}</span></p>
        <ul>
            <li><span data-field="facility_1">{{ facility_1 }}</span></li>
            <li><span data-field="facility_2">{{ facility_2 }}</span></li>
            <li><span data-field="facility_3">{{ facility_3 }}</span></li>
            <li><span data-field="facility_4">{{ facility_4 }}</span></li>
            <li><span data-field="facility_5">{{ facility_5 }}</span></li>
            <li><span data-field="facility_6">{{ facility_6 }}</span></li>
            <li><span data-field="facility_7">{{ facility_7 }}</span></li>
            <li><span data-field="facility_8">{{ facility_8 }}</span></li>
        </ul>

        <h2 style="margin-top: 30px;"><span data-field="funding_applications">{{ funding_applications }}</span></h2>
        <ul>
            <li><span data-field="funding_1">{{ funding_1 }}</span><span data-field="funding_1_details">{{ funding_1_details }}</span></li>
            <li><span data-field="funding_2">{{ funding_2 }}</span><span data-field="funding_2_details">{{ funding_2_details }}</span></li>
            <li><span data-field="funding_3">{{ funding_3 }}</span><span data-field="funding_3_details">{{ funding_3_details }}</span></li>
            <li><span data-field="funding_4">{{ funding_4 }}</span><span data-field="funding_4_details">{{ funding_4_details }}</span></li>
            <li><span data-field="funding_5">{{ funding_5 }}</span><span data-field="funding_5_details">{{ funding_5_details }}</span></li>
            <li><span data-field="funding_6">{{ funding_6 }}</span><span data-field="funding_6_details">{{ funding_6_details }}</span></li>
        </ul>
    </div>

    <div class="page">
        <ul>
            <li><span data-field="internal_i3">{{ internal_i3 }}</span><span data-field="internal_i3_details">{{ internal_i3_details }}</span></li>
        </ul>

        <h2 style="margin-top: 30px;"><span data-field="list_of_mentored_undergraduate_students">{{ list_of_mentored_undergraduate_students }}</span></h2>
        <ul>
            {% for student in mentored_students %}
            <li><span data-field="mentored_students[{{ loop.index0 }}].name">{{ student.name }}</span> ({{ student.ksu }}) ({{ student.term }})</li>
            {% endfor %}
        </ul>
    </div>
</body>
</html>