<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3, h4 {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial;
    margin-top: 0;
  }
  .section-title {
    font-weight: bold;
    text-transform: uppercase;
    margin-top: 20px;
    margin-bottom: 10px;
  }
  .reference-item {
    margin-bottom: 10px;
    line-height: 1.4;
  }
</style>

<div class="page">
  <header>
    <h1>VITA</h1>
    <h2>{{ full_name }}</h2>
    <p>{{ employer.title }}, {{ employer.institution }}</p>
  </header>

  <section>
    <h3 class="section-title">Office Address:</h3>
    <p>{{ office_address.street }}</p>
    <p>{{ office_address.city }}</p>
    <p>{{ office_address.state }} {{ office_address.zip }}</p>
    <p>Office Tel.: {{ office_phone }}</p>
    <p>Email: {{ office_email }}</p>
  </section>

  <section>
    <h3 class="section-title">Home Address:</h3>
    <p>{{ home_address.street }}</p>
    <p>{{ home_address.city }}</p>
    <p>{{ home_address.state }} {{ home_address.zip }}</p>
    <p>Home Tel.: {{ home_phone }}</p>
  </section>

  <section>
    <h3 class="section-title">Date of Birth:</h3>
    <p>{{ date_of_birth }}</p>
    <p>Citizenship: {{ citizenship }}</p>
  </section>

  <section>
    <h3 class="section-title">Major Fields:</h3>
    <p>{{ major_fields }}</p>
    <h3 class="section-title">Other Fields:</h3>
    <p>{{ other_fields }}</p>
  </section>
</div>

<div class="page">
  <section>
    <h3 class="section-title">REFERENCES:</h3>
    <div class="reference-item">
      <span data-field="reference_1">{{ reference_1 }}</span>
    </div>
    <div class="reference-item">
      <span data-field="reference_2">{{ reference_2 }}</span>
    </div>
    <div class="reference-item">
      <span data-field="reference_3">{{ reference_3 }}</span>
    </div>
    <div class="reference-item">
      <span data-field="reference_4">{{ reference_4 }}</span>
    </div>
    <div class="reference-item">
      <span data-field="reference_5">{{ reference_5 }}</span>
    </div>
    <div class="reference-item">
      <span data-field="reference_6">{{ reference_6 }}</span>
    </div>
  </section>

  <section>
    <h3 class="section-title">EDUCATION:</h3>
    <ul class="education-list">
      {% for edu in education %}
        <li>
          <span data-field="education[{{ loop.index0 }}].degree">{{ edu.degree }}</span>,
          <span data-field="education[{{ loop.index0 }}].institution">{{ edu.institution }}</span>,
          {{ edu.year }}
        </li>
      {% endfor %}
    </ul>
  </section>

  <section>
    <h3 class="section-title">TEACHING EXPERIENCE:</h3>
    <ul class="teaching-list">
      {% for job in teaching_experience %}
        <li>
          <span data-field="teaching_experience[{{ loop.index0 }}].title">{{ job.title }}</span>,
          <span data-field="teaching_experience[{{ loop.index0 }}].institution">{{ job.institution }}</span>,
          {{ job.years }}
        </li>
      {% endfor %}
    </ul>
  </section>
</div>

<div class="page">
  <section>
    <h3 class="section-title">Other Teaching Assignments:</h3>
    <ul class="other-teaching-list">
      {% for assignment in other_teaching_assignments %}
        <li>
          <span data-field="other_teaching_assignments[{{ loop.index0 }}].description">{{ assignment.description }}</span>,
          {{ assignment.date }}
        </li>
      {% endfor %}
    </ul>
  </section>

  <section>
    <h3 class="section-title">Courses taught (* denotes lecture course; + denotes winter term):</h3>
    <ul class="courses-taught-list">
      {% for course in courses_taught %}
        <li>
          <span data-field="courses_taught[{{ loop.index0 }}]">{{ course }}</span>
        </li>
      {% endfor %}
    </ul>
  </section>

  <section>
    <h3 class="section-title">FELLOWSHIPS, GRANTS AND HONORS:</h3>
    <ul class="fellowships-list">
      {% for award in fellowships_and_grants %}
        <li>
          <span data-field="fellowships_and_grants[{{ loop.index0 }}].award">{{ award.award }}</span>,
          {{ award.details }}
        </li>
      {% endfor %}
    </ul>
  </section>
</div>

<div class="page">
  <section>
    <h3 class="section-title">PROFESSIONAL SERVICE:</h3>
    <ul class="service-list">
      {% for service in professional_service %}
        <li>
          <span data-field="professional_service[{{ loop.index0 }}].role">{{ service.role }}</span>,
          <span data-field="professional_service[{{ loop.index0 }}].institution">{{ service.institution }}</span>,
          {{ service.years }}
        </li>
      {% endfor %}
    </ul>
  </section>

  <section>
    <h3 class="section-title">Outside Middlebury College:</h3>
    <ul class="outside-service-list">
      {% for outside_service in outside_middlebury_college %}
        <li>
          <span data-field="outside_middlebury_college[{{ loop.index0 }}].role">{{ outside_service.role }}</span>,
          <span data-field="outside_middlebury_college[{{ loop.index0 }}].institution">{{ outside_service.institution }}</span>,
          {{ outside_service.years }}
        </li>
      {% endfor %}
    </ul>
  </section>
</div>

<div class="page">
  <section>
    <h3 class="section-title">PUBLICATIONS:</h3>
    <h4 style="margin-top: 15px;">Books:</h4>
    <ul class="books-list">
      {% for book in publications.books %}
        <li class="reference-item">
          <span data-field="publications.books[{{ loop.index0 }}].title">{{ book.title }}</span>,
          {{ book.details }}
        </li>
      {% endfor %}
    </ul>

    <h4 style="margin-top: 15px;">Articles:</h4>
    <ul class="articles-list">
      {% for article in publications.articles %}
        <li class="reference-item">
          <span data-field="publications.articles[{{ loop.index0 }}].title">{{ article.title }}</span>,
          {{ article.details }}
        </li>
      {% endfor %}
    </ul>
  </section>
</div>

<div class="page">
  <section>
    <h3 class="section-title">BOOK REVIEWS:</h3>
    <ul class="book-reviews-list">
      {% for review in book_reviews %}
        <li class="reference-item">
          <span data-field="book_reviews[{{ loop.index0 }}].title">{{ review.title }}</span>,
          {{ review.details }}
        </li>
      {% endfor %}
    </ul>
  </section>
</div>

