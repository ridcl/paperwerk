<!DOCTYPE html>
<html>
<head>
    <title>Document</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
        }
        .page:last-child { page-break-after: auto; }
        body {
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
            line-height: 1.5;
            color: #000;
        }
        h1, h2, h3 {
            font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif;
            font-weight: bold;
        }
        .header-info {
            text-align: right;
            font-size: 0.9em;
            margin-bottom: 20px;
        }
        .section-title {
            font-size: 1.2em;
            font-weight: bold;
            margin-top: 20px;
            margin-bottom: 10px;
        }
        .entry {
            margin-bottom: 15px;
        }
        .entry-header {
            font-weight: bold;
        }
        .metadata {
            font-size: 0.9em;
            color: #555;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }
        td {
            padding: 5px 0;
        }
        .publication-list li {
            margin-bottom: 10px;
        }
        .article-title {
            font-weight: bold;
        }
    </style>

