        {% for book in books %}
        <li>
            <div class="entry-header">{{ book.year }}</div>
            <div class="metadata">
                <span class="article-title">{{ book.title }}</span>. {{ book.publisher_info }}
            </div>
        </li>
        {% endfor %}
    </ul>

    <div class="section-title">Edited Works: Books, Special Journal Issues, Colloquiums</div>
