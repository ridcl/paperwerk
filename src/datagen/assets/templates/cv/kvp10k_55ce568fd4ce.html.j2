    </div>

    <div class="section-title">PROFESSIONAL EMPLOYMENT</div>

    {% for job in employment_history %}
    <div class="entry">
        <div class="metadata">
            {{ job.start_year }}-{{ job.end_year }} | {{ job.title }}
        </div>
        <div class="metadata">
            {{ job.institution }}
        </div>
    </div>
    {% endfor %}

</div>

<div class="page">
    <div class="header-info">
        <span>Goldstein p. 2 of 32</span>
    </div>

    <div class="section-title">PUBLICATIONS</div>

    <div class="section-title">Books</div>
