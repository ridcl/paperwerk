<body>

<div class="page">
    <div class="header-info">
        <span>Goldstein (Updated {{ current_date }})</span>
    </div>

    <div class="entry">
        <span class="entry-header">DONNA M. GOLDSTEIN</span>
        <div class="metadata">
            Department of Anthropology<br>
            {{ address_line_1 }}<br>
            {{ address_line_2 }}<br>
            {{ city_state_zip }}<br>
            Phone: {{ phone }} (office)<br>
            Fax: {{ fax }}
        </div>
        <div class="metadata">
            E-mail: <a href="mailto:{{ email }}">{{ email }}</a><br>
            Webpage: <a href="{{ webpage_url }}">{{ webpage_url }}</a><br>
            LASC webpage: <a href="{{ lasc_url }}">{{ lasc_url }}</a>
        </div>
    </div>

    <div class="section-title">FORMAL EDUCATION</div>

    <div class="entry">
        <div class="metadata">
            {{ year_1 }} | {{ degree_1 }} | {{ institution_1 }}
        </div>
        <div class="metadata">
            Dissertation Title: "{{ dissertation_title_1 }}"
        </div>
    </div>

    <div class="entry">
        <div class="metadata">
            {{ year_2 }} | {{ degree_2 }} | {{ institution_2 }}
        </div>
