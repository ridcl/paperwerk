<!DOCTYPE html>
<html>
<head>
<title>CV Template</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .header-info {
    font-family: "DejaVu Sans", "Liberation Sans", Helvetica, Arial, sans-serif;
  }
  .section-title {
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .job-entry, .education-entry {
    margin-bottom: 15px;
  }
  .job-title, .degree-name {
    font-weight: bold;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .dates {
    float: right;
    font-style: italic;
    font-family: "DejaVu Sans", "Liberation Sans", Helvetica, Arial, sans-serif;
  }
  .bullet-point {
    margin-left: 20px;
    margin-bottom: 5px;
    font-family: "DejaVu Sans", "Liberation Sans", Helvetica, Arial, sans-serif;
  }
  .reference-list li {
    margin-bottom: 8px;
    font-family: "DejaVu Sans", "Liberation Sans", Helvetica, Arial, sans-serif;
  }
</style>

<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3, h4, h5, h6 {
    font-family: "DejaVu Sans", "Liberation Sans", Arial, Helvetica, sans-serif;
  }
  p {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
    line-height: 1.5;
  }
  .citation-entry {
    margin-bottom: 15px;
    text-indent: -20px;
    padding-left: 20px;
  }
  .citation-entry strong {
    font-weight: bold;
  }
  .list-item {
    margin-bottom: 10px;
  }
</style>
<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  h1, h2, h3, h4, h5, h6 {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial;
    margin-top: 1em;
    margin-bottom: 0.5em;
  }
  p, td, span {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
    font-size: 10pt;
    line-height: 1.4;
  }
  .section-title {
    font-weight: bold;
    text-transform: uppercase;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }
  .list-item {
    margin-bottom: 0.5em;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1em;
  }
  tr, td {
    border-bottom: 1px solid #ccc;
    padding: 5px 0;
  }
  .centered {
    text-align: center;
  }
</style>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
