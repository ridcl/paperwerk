  }
  .entry {
    margin-bottom: 10px;
  }
  .role {
    font-weight: bold;
  }
  .dates {
    font-style: italic;
    float: right;
  }
  .divider {
    border-top: 1px solid #ccc;
    margin: 20px 0;
  }
</style>
</head>
<body>

<div class="page">
  <h1 style="text-align: center; font-size: 24pt; margin-bottom: 5px;">{{ full_name }}</h1>
  <div class="header-info" style="text-align: center; font-size: 10pt; margin-bottom: 30px;">
    <p>Home: {{ contact.home }}</p>
    <p>Telephone: {{ contact.phone }}</p>
    <p>Email: {{ contact.email }}</p>
    <p>Office: {{ contact.office }}</p>
    <p>College of Arts and Sciences</p>
    <p>{{ contact.university }}</p>
    <p>{{ contact.address_line_1 }}</p>
    <p>{{ contact.city_state_zip }}</p>
    <p>Telephone: {{ contact.phone_2 }}</p>
    <p>Email: {{ contact.email_2 }}</p>
    <p>FAX: {{ contact.fax }}</p>
  </div>

  <div class="section-title">PROFESSIONAL PREPARATION:</div>
  <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">
    <span data-field="prep.degree_1">{{ prep.degree_1 }}</span>
    <span data-field="prep.minor_1">{{ prep.minor_1 }}</span>
  </div>
  <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">
    <span data-field="prep.degree_2">{{ prep.degree_2 }}</span>
    <span data-field="prep.minor_2">{{ prep.minor_2 }}</span>
  </div>
  <div style="display: flex; justify-content: space-between; margin-bottom: 5px;">
    <span data-field="prep.degree_3">{{ prep.degree_3 }}</span>
    <span data-field="prep.minor_3">{{ prep.minor_3 }}</span>
  </div>

  <div class="section-title">PROFESSIONAL EXPERIENCE:</div>
  {% for job in professional_experience %}
  <div class="job-entry">
    <div style="display: flex; justify-content: space-between;">
      <span data-field="professional_experience[{{ loop.index0 }}].dates">{{ job.dates }}</span>
      <span data-field="professional_experience[{{ loop.index0 }}].title">{{ job.title }}</span>
    </div>
    {% if job.description %}
    {% for item in job.description %}
    <div class="bullet-point">{{ item }}</div>
    {% endfor %}
    {% endif %}
  </div>
  {% endfor %}

  <div class="section-title">TEACHING EXPERIENCE:</div>
  {% for teaching in teaching_experience %}
  <div class="job-entry">
    <div style="display: flex; justify-content: space-between;">
      <span data-field="teaching_experience[{{ loop.index0 }}].dates">{{ teaching.dates }}</span>
      <span data-field="teaching_experience[{{ loop.index0 }}].institution">{{ teaching.institution }}</span>
    </div>
    {% if teaching.details %}
    {% for detail in teaching.details %}
    <div class="bullet-point">{{ detail }}</div>
    {% endfor %}
    {% endif %}
  </div>
  {% endfor %}

  <div class="section-title">RESEARCH PUBLICATIONS (refereed journals):</div>
  <ol class="reference-list">
    {% for pub in research_publications %}
    <li>
      <span data-field="research_publications[{{ loop.index0 }}].citation">{{ pub.citation }}</span>
    </li>
    {% endfor %}
  </ol>

  <div class="section-title">MANUSCRIPTS IN REVIEW</div>
  <ol class="reference-list">
    {% for manuscript in manuscripts_in_review %}
    <li>
      <span data-field="manuscripts_in_review[{{ loop.index0 }}].citation">{{ manuscript.citation }}</span>
    </li>
    {% endfor %}
  </ol>

  <div class="section-title">BOOK CHAPTERS:</div>
  <ol class="reference-list">
    {% for chapter in book_chapters %}
    <li>
      <span data-field="book_chapters[{{ loop.index0 }}].citation">{{ chapter.citation }}</span>
    </li>
    {% endfor %}
  </ol>

  <div style="text-align: center; margin-top: 50px; font-size: 10pt;">
    <span data-field="page_number">{{ page_number }}</span>
  </div>
</div>

<div class="page">
  <div style="text-align: center; margin-top: 50px; font-size: 10pt;">
    <span data-field="page_number">{{ page_number }}</span>
  </div>
</div>

<div class="page">
  <div style="text-align: center; margin-top: 50px; font-size: 10pt;">
    <span data-field="page_number">{{ page_number }}</span>
  </div>
</div>

<div class="page">
