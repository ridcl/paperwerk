<!DOCTYPE html>
<html>
<head>
<title>Curriculum Vitae</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { font-weight: bold; }
  .header-info { margin-bottom: 20px; }
  .contact-info p { margin: 2px 0; font-size: 12pt; }
  .section-title { font-size: 14pt; font-weight: bold; margin-top: 20px; margin-bottom: 10px; border-bottom: 1px solid #ccc; padding-bottom: 3px; }
  .entry { margin-bottom: 15px; }
  .entry-header { font-weight: bold; }
  .entry-details { font-size: 11pt; }
  .publication-list li { margin-bottom: 10px; line-height: 1.4; }
  .publication-list a { text-decoration: none; color: #000; }
  .publication-list strong { font-weight: bold; }
  .sub-section-title { font-size: 12pt; font-weight: bold; margin-top: 15px; margin-bottom: 5px; }
  .footer { position: absolute; bottom: 20px; right: 60px; font-size: 10pt; }
</style>

<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { font-weight: bold; }
  .section-title { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
  .entry { margin-bottom: 15px; }
  .date-info { font-weight: bold; display: inline-block; width: 100px; }
  .description-text { display: inline-block; }
  table { width: 100%; border-collapse: collapse; margin-top: 10px; }
  td { padding: 5px 0; }
</style>
</head>
<body>

<div class="page">
  <div style="text-align: right; font-size: 12pt;">{{ author_name }}</div>
  <div class="header-info">
    <h1 style="font-size: 16pt; margin: 0;">COMPREHENSIVE CURRICULUM VITAE PROMOTION AND TENURE</h1>
  </div>
  <div class="contact-info">
    <p><strong>{{ full_name }}</strong></p>
    <p>{{ employer.address }}</p>
    <p>{{ employer.city_state_zip }}</p>
    <p>Phone: {{ employer.phone }}</p>
    <p>Email: {{ employer.email }}</p>
  </div>

  <div class="section-title">Education</div>
  <div class="entry">
    <div class="entry-header">2014</div>
    <div class="entry-details">
      <span data-field="education.degree_1">{{ education.degree_1 }}</span>, <span data-field="education.institution_1">{{ education.institution_1 }}</span>, <span data-field="education.location_1">{{ education.location_1 }}</span>
    </div>
  </div>
  <div class="entry">
    <div class="entry-header">2014</div>
    <div class="entry-details">
      <span data-field="education.degree_2">{{ education.degree_2 }}</span>, <span data-field="education.institution_2">{{ education.institution_2 }}</span>, <span data-field="education.location_2">{{ education.location_2 }}</span>
    </div>
  </div>
  <div class="entry">
    <div class="entry-header">2010</div>
    <div class="entry-details">
      <span data-field="education.degree_3">{{ education.degree_3 }}</span>, <span data-field="education.institution_3">{{ education.institution_3 }}</span>, <span data-field="education.location_3">{{ education.location_3 }}</span>
    </div>
  </div>
  <div class="entry">
    <div class="entry-header">1986</div>
    <div class="entry-details">
      <span data-field="education.degree_4">{{ education.degree_4 }}</span>, <span data-field="education.institution_4">{{ education.institution_4 }}</span>, <span data-field="education.location_4">{{ education.location_4 }}</span>
    </div>
  </div>
</div>

<div class="page">
  <div style="text-align: right; font-size: 12pt;">{{ author_name }}</div>
  <div class="section-title">Scholarship/Research/Creative Activity</div>

  <div class="sub-section-title">Publications in Print –</div>
  <ul class="publication-list">
    {% for pub in publications_in_print %}
    <li>
      <strong>{{ pub.authors }}</strong>, ({{ pub.year }}). <span data-field="pub_title">{{ pub.title }}</span>. <span data-field="pub_journal">{{ pub.journal }}</span>. <span data-field="pub_doi">{{ pub.doi }}</span>.
      {% if pub.link %}
      <br><a href="{{ pub.link }}">Link</a>
      {% endif %}
    </li>
    {% endfor %}
  </ul>

  <div class="sub-section-title">Book chapters</div>
  <ul class="publication-list">
    {% for chap in book_chapters %}
    <li>
      <strong>{{ chap.authors }}</strong>, ({{ chap.year }}). <span data-field="chap_title">{{ chap.title }}</span>. In <span data-field="chap_book">{{ chap.book_title }}</span>. <span data-field="chap_publisher">{{ chap.publisher }}</span>.
    </li>
    {% endfor %}
  </ul>

  <div class="sub-section-title">Works in Press</div>
  <ul class="publication-list">
    {% for press in works_in_press %}
    <li>
      <strong>{{ press.authors }}</strong>, ({{ press.year }}). <span data-field="press_title">{{ press.title }}</span>. <span data-field="press_journal">{{ press.journal }}</span>.
    </li>
    {% endfor %}
  </ul>

  <div class="sub-section-title">Books</div>
  <ul class="publication-list">
    {% for book in books %}
    <li>
      <strong>{{ book.authors }}</strong>, ({{ book.year }}). <span data-field="book_title">{{ book.title }}</span>. <span data-field="book_publisher">{{ book.publisher }}</span>.
    </li>
    {% endfor %}
  </ul>

  <div class="sub-section-title">Encyclopedia articles</div>
  <ul class="publication-list">
    {% for enc in encyclopedia_articles %}
    <li>
      <strong>{{ enc.authors }}</strong>, ({{ enc.year }}). <span data-field="enc_title">{{ enc.title }}</span>. In <span data-field="enc_book">{{ enc.book_title }}</span>.
    </li>
    {% endfor %}
  </ul>
</div>

<div class="page">
  <div style="text-align: right; font-size: 12pt;">{{ author_name }}</div>
  <div class="section-title">Works currently under review</div>
  <ul class="publication-list">
    {% for review in works_under_review %}
    <li>
      <strong>{{ review.authors }}</strong>, ({{ review.year }}). <span data-field="review_title">{{ review.title }}</span>. <span data-field="review_journal">{{ review.journal }}</span>.
    </li>
    {% endfor %}
  </ul>

  <div class="sub-section-title">Referenced Presentations and Proceedings</div>
  <ul class="publication-list">
    {% for presentation in presentations_and_proceedings %}
    <li>
      <strong>{{ presentation.authors }}</strong>, ({{ presentation.year }}). <span data-field="pres_title">{{ presentation.title }}</span>. Presented at <span data-field="pres_venue">{{ presentation.venue }}</span>.
    </li>
    {% endfor %}
  </ul>

  <div class="sub-section-title">Regional/Local</div>
  <ul class="publication-list">
    {% for regional in regional_local %}
    <li>
      <strong>{{ regional.authors }}</strong>, ({{ regional.year }}). <span data-field="reg_title">{{ regional.title }}</span>.
    </li>
    {% endfor %}
  </ul>

  <div class="sub-section-title">Non-Refereed Publications, Presentations and Proceedings</div>
  <div class="sub-section-title">Publications</div>
  <ul class="publication-list">
    {% for non_ref in non_refereed_publications %}
    <li>
      <strong>{{ non_ref.authors }}</strong>, ({{ non_ref.year }}). <span data-field="non_ref_title">{{ non_ref.title }}</span>.
    </li>
    {% endfor %}
  </ul>

  <div class="sub-section-title">Other</div>
  <ul class="publication-list">
    {% for other in other_publications %}
    <li>
      <strong>{{ other.authors }}</strong>, ({{ other.year }}). <span data-field="other_title">{{ other.title }}</span>.
    </li>
    {% endfor %}
  </ul>

  <div class="sub-section-title">Presentations</div>
  <ul class="publication-list">
    {% for present in presentations %}
    <li>
      <strong>{{ present.authors }}</strong>, ({{ present.year }}). <span data-field="present_title">{{ present.title }}</span>.
    </li>
    {% endfor %}
  </ul>

  <div class="sub-section-title">Creative Activities and Achievements</div>
  <div class="sub-section-title">Projects</div>
  <ul class="publication-list">
    {% for project in projects %}
    <li>
      <strong>{{ project.title }}</strong>. <span data-field="project_description">{{ project.description }}</span>.
    </li>
    {% endfor %}
  </ul>
</div>




<div class="page">
  <div style="text-align: right;">Barakat CV</div>
  <div class="section-title"></div>
  <ul>
    <li>A total of <span data-field="number_of_faculty_members">{{ number_of_faculty_members }}</span> faculty members from Educational Leadership and Research Methodology (ELRM) and Curriculum Culture and Educational Inquiry (CCEI) departments represented FAU in multiple functions in <span data-field="location">{{ location }}</span>, <span data-field="location_detail">{{ location_detail }}</span>.</li>
    <li>Partnership team members reflected and presented on the partnership at three National conferences.</li>
    <li>Over <span data-field="number_of_educators">{{ number_of_educators }}</span> Egyptian public-school teachers and administrators received professional development through a teacher of teacher model.</li>
    <li>A digital portal for Egyptian educators' professional development is being developed in collaboration with Vodafone (an international communications company that operates in <span data-field="country">{{ country }}</span>).</li>
  </ul>
  <div style="margin-top: 30px;">- Other</div>
  <div class="section-title">Journal of Cases in Educational Leadership. (UCEA). (2016). JCEL December 2016 Spotlight</div>
  <div class="entry">
    <p>
      <span data-field="publication_name">{{ publication_name }}</span>. Available from <a href="{{ publication_url }}"></span>.
    </p>
  </div>
  <div class="section-title"></div>
  <div class="entry">
    <p>
      <span data-field="name">{{ name }}</span>, <span data-field="year">{{ year }}</span>. Interview with Dr. <span data-field="name_two">{{ name_two }}</span>. <span data-field="description_two">{{ description_two }}</span>. <span data-field="url_two">{{ url_two }}</span>.
    </p>
  </div>
</div>

