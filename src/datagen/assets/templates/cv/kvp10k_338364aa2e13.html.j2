<!DOCTYPE html>
<html>
<head>
<title>CV Template</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3, h4 { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; }
  .section-title { font-weight: bold; margin-top: 15px; margin-bottom: 5px; }
  .contact-info p { margin: 2px 0; }
  .two-column { display: flex; justify-content: space-between; }
  .two-column > div { width: 48%; }
  ul { list-style-type: disc; padding-left: 20px; margin-top: 5px; margin-bottom: 5px; }
  li { margin-bottom: 3px; }
</style>
</head>
<body>

<div class="page">
  <div style="text-align: right;">
    <span data-field="full_name">{{ full_name }}</span>
  </div>

  <div class="two-column">
    <div>
      <div class="section-title">CONTACT INFORMATION</div>
      <div class="contact-info">
        <p>Email: <span data-field="contact.email">{{ contact.email }}</span></p>
        <p>Phone: <span data-field="contact.phone">{{ contact.phone }}</span></p>
        <p>Address: <span data-field="contact.address">{{ contact.address }}</span></p>
      </div>
    </div>
    <div>
      <div class="section-title">EDUCATION</div>
      <p>
        <span data-field="education.degree">{{ education.degree }}</span>, <span data-field="education.major">{{ education.major }}</span>
        <br>
        <span data-field="education.institution">{{ education.institution }}</span>, <span data-field="education.location">{{ education.location }}</span>
        <br>
        <span data-field="education.dates">{{ education.dates }}</span>
      </p>
    </div>
  </div>
</div>

<div class="page">
  <div class="section-title">RESEARCH INTERESTS</div>
  <ul>
    {% for interest in research_interests %}
      <li><span data-field="research_interests[{{ loop.index0 }}]">{{ interest }}</span></li>
    {% endfor %}
  </ul>

  <div class="section-title">WORKING PAPERS</div>
  <ul>
    {% for paper in working_papers %}
      <li><span data-field="working_papers[{{ loop.index0 }}].title">{{ paper.title }}</span> ({{ paper.year }})</li>
    {% endfor %}
  </ul>

  <div class="section-title">DO COMMISSIONS CAUSE INVESTMENT ADVISER MISCONDUCT? (Job Market Paper)</div>
  <p>
    <span data-field="paper_abstract_1">{{ paper_abstract_1 }}</span>
  </p>
  <p>
    <span data-field="paper_abstract_2">{{ paper_abstract_2 }}</span>
  </p>
  <p>
    <span data-field="paper_abstract_3">{{ paper_abstract_3 }}</span>
  </p>
  <p>
    <span data-field="paper_abstract_4">{{ paper_abstract_4 }}</span>
  </p>

  <div class="section-title">POLITICAL ALIGNMENT, PARTISANSHIP, AND M&A (with Ran Duchin, Karim Farroukh, and Jarrad Harford)</div>
  <p>
    <span data-field="paper_abstract_5">{{ paper_abstract_5 }}</span>
  </p>

  <div class="section-title">INSTITUTIONAL PARTICIPATION AND IPO UNDERPRICING: EVIDENCE FROM MLPs</div>
  <p>
    <span data-field="paper_abstract_6">{{ paper_abstract_6 }}</span>
  </p>
</div>

<div class="page">
  <div class="section-title">CONFERENCE AND INVITED PRESENTATIONS</div>
  <table style="width: 100%; border-collapse: collapse;">
    <thead>
      <tr style="border-bottom: 1px solid #ccc;">
        <th style="text-align: left; padding: 5px;"></th>
        <th style="text-align: left; padding: 5px;">2020</th>
        <th style="text-align: left; padding: 5px;">2019</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td style="padding: 5px;">
          <span data-field="presentation_1.title">{{ presentation_1.title }}</span>
        </td>
        <td style="padding: 5px;">
          <span data-field="presentation_1.year">{{ presentation_1.year }}</span>
        </td>
        <td style="padding: 5px;">
          <span data-field="presentation_1.year">{{ presentation_1.year }}</span>
        </td>
      </tr>
    </tbody>
  </table>

  <div class="section-title">TEACHING EXPERIENCE</div>
  <table style="width: 100%; border-collapse: collapse;">
    <thead>
      <tr style="border-bottom: 1px solid #ccc;">
        <th style="text-align: left; padding: 5px;">Position</th>
        <th style="text-align: left; padding: 5px;">Institution</th>
        <th style="text-align: left; padding: 5px;">Dates</th>
        <th style="text-align: right; padding: 5px;">Avg Course Rating</th>
      </tr>
    </thead>
    <tbody>
      {% for teaching_exp in teaching_experiences %}
      <tr>
        <td style="padding: 5px;">
          <span data-field="teaching_experiences[{{ loop.index0 }}].position">{{ teaching_exp.position }}</span>
        </td>
        <td style="padding: 5px;">
          <span data-field="teaching_experiences[{{ loop.index0 }}].institution">{{ teaching_exp.institution }}</span>
        </td>
        <td style="padding: 5px;">
          <span data-field="teaching_experiences[{{ loop.index0 }}].dates">{{ teaching_exp.dates }}</span>
        </td>
        <td style="padding: 5px; text-align: right;">
          <span data-field="teaching_experiences[{{ loop.index0 }}].rating">{{ teaching_exp.rating }}</span>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

<div class="page">
  <div class="section-title">OTHER WORK EXPERIENCE</div>
  <table style="width: 100%; border-collapse: collapse;">
    <thead>
      <tr style="border-bottom: 1px solid #ccc;">
        <th style="text-align: left; padding: 5px;">Position</th>
        <th style="text-align: left; padding: 5px;">Company</th>
        <th style="text-align: left; padding: 5px;">Dates</th>
      </tr>
    </thead>
    <tbody>
      {% for work_exp in other_work_experiences %}
      <tr>
        <td style="padding: 5px;"><span data-field="other_work_experiences[{{ loop.index0 }}].position">{{ work_exp.position }}</span></td>
        <td style="padding: 5px;"><span data-field="other_work_experiences[{{ loop.index0 }}].company">{{ work_exp.company }}</span></td>
        <td style="padding: 5px;"><span data-field="other_work_experiences[{{ loop.index0 }}].dates">{{ work_exp.dates }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="section-title">AWARDS AND HONORS</div>
  <ul>
    {% for award in awards_and_honors %}
      <li><span data-field="awards_and_honors[{{ loop.index0 }}]">{{ award }}</span></li>
    {% endfor %}
  </ul>

  <div class="section-title">PROFESSIONAL MEMBERSHIPS</div>
  <ul>
    {% for membership in professional_memberships %}
      <li><span data-field="professional_memberships[{{ loop.index0 }}]">{{ membership }}</span></li>
    {% endfor %}
  </ul>

  <div class="section-title">COMMUNITY INVOLVEMENT</div>
  <ul>
    {% for involvement in community_involvement %}
      <li><span data-field="community_involvement[{{ loop.index0 }}].description">{{ involvement.description }}</span> ({{ involvement.dates }})</li>
    {% endfor %}
  </ul>
</div>

</body>
</html>