<body>
<div class="page">
  <div style="text-align: right;">
    <span data-field="full_name">{{ full_name }}</span>
  </div>
  <div class="contact-info" style="margin-top: 5px;">
    <p>{{ address_line_1 }}</p>
    <p>{{ city_state_zip }}</p>
    <p>Phone: {{ phone }}</p>
    <p>E-mail: {{ email }}</p>
  </div>

  <div class="section-title">EDUCATION</div>

  {% for edu in education %}
  <div class="entry">
    <div class="entry-header">{{ edu.degree }} ({{ edu.year }})</div>
    <div class="entry-details">{{ edu.institution }}</div>
  </div>
  {% endfor %}

  <div class="section-title">EMPLOYMENT</div>

  {% for job in work_experience %}
  <div class="entry">
    <div class="entry-header">{{ job.title }} - {{ job.start_year }}-{{ job.end_year }}</div>
    <div class="entry-details">{{ job.employer }}</div>
    <div class="entry-details">{{ job.description }}</div>
  </div>
  {% endfor %}

  <div class="section-title">I. PROFESSIONAL RECOGNITION</div>

  {% for recognition in recognitions %}
  <div class="entry">
    <div class="entry-header">{{ recognition.year }}</div>
    <div class="entry-details">{{ recognition.description }}</div>
  </div>
  {% endfor %}

  <div class="section-title">PROFESSIONAL MEMBERSHIP</div>

  <ul>
    {% for member in memberships %}
    <li>{{ member.name }}</li>
    {% endfor %}
  </ul>

  <div class="section-title">PUBLICATIONS</div>

  {% for pub in publications %}
  <div class="entry">
    <div class="entry-header">{{ pub.year }}</div>
    <div class="entry-details">{{ pub.description }}</div>
  </div>
  {% endfor %}

  <div class="section-title">BOOKS</div>

  {% for book in books %}
  <div class="entry">
    <div class="entry-header">{{ book.year }}</div>
    <div class="entry-details">{{ book.description }}</div>
  </div>
  {% endfor %}

  <div class="section-title">REFEREED BOOK CHAPTERS</div>

  {% for chapter in book_chapters %}
  <div class="entry">
    <div class="entry-header">{{ chapter.year }}</div>
    <div class="entry-details">{{ chapter.description }}</div>
  </div>
  {% endfor %}

  <div class="section-title">ENCYCLOPEDIA ENTRIES</div>

  {% for entry in encyclopedia_entries %}
  <div class="entry">
    <div class="entry-header">{{ entry.year }}</div>
    <div class="entry-details">{{ entry.description }}</div>
  </div>
  {% endfor %}

  <div class="section-title">BOOK REVIEWS</div>

  {% for review in book_reviews %}
  <div class="entry">
    <div class="entry-header">{{ review.year }}</div>
    <div class="entry-details">{{ review.description }}</div>
  </div>
  {% endfor %}

  <div class="section-title">MAPS</div>

  {% for map in maps %}
  <div class="entry">
    <div class="entry-header">{{ map.year }}</div>
    <div class="entry-details">{{ map.description }}</div>
  </div>
  {% endfor %}

  <div class="section-title">PRESS INTERVIEWS</div>

  {% for interview in press_interviews %}
  <div class="entry">
    <div class="entry-header">{{ interview.year }}</div>
    <div class="entry-details">{{ interview.description }}</div>
  </div>
  {% endfor %}

  <div class="section-title">PROFESSIONAL PRESENTATIONS</div>

  <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
    <div style="width: 50%;">
      <div class="entry">
        <div class="entry-header">{{ presentation.year }}</div>
        <div class="entry-details">{{ presentation.description }}</div>
      </div>
    </div>
    <div style="width: 50%;">
      <div class="entry">
        <div class="entry-header">{{ presentation.year }}</div>
        <div class="entry-details">{{ presentation.description }}</div>
      </div>
    </div>
  </div>

  <div class="section-title">INVITED LECTURES</div>

  {% for lecture in invited_lectures %}
  <div class="entry">
    <div class="entry-header">{{ lecture.year }}</div>
    <div class="entry-details">{{ lecture.description }}</div>
  </div>
  {% endfor %}

  <div class="page">
    <div style="text-align: center; margin-top: 50px;">
      <span data-field="page_number">{{ page_number }}</span>
    </div>
  </div>
</div>

