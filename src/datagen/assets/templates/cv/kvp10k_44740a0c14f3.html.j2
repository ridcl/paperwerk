<title>Resume</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 {
    font-weight: bold;
    margin-top: 0;
  }
  .header-info {
    text-align: center;
    margin-bottom: 30px;
  }
  .contact-info {
    text-align: center;
    font-size: 0.9em;
  }
  .section-title {
    font-size: 1.2em;
    margin-top: 20px;
    margin-bottom: 10px;
    border-bottom: 1px solid #ccc;
    padding-bottom: 3px;
  }
  .entry {
    margin-bottom: 15px;
  }
  .entry-header {
    display: flex;
    justify-content: space-between;
    font-weight: bold;
  }
  .entry-details {
    margin-top: 3px;
    font-size: 0.95em;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
  }
  td {
    padding: 5px 0;
    vertical-align: top;
  }
  .two-column-layout {
    display: flex;
    gap: 40px;
  }
  .column {
    flex: 1;
  }
</style>

