<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  h1, h2, h3, h4 {
    font-weight: bold;
    margin-top: 0;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  td, th {
    padding: 5px 0;
    text-align: left;
  }
  .section-title {
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
  }
</style>

<div class="page">
  <div>
    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
      <div>
        <div style="font-weight: bold;">Name:</div>
        <div style="font-weight: bold;">Office Address:</div>
        <div style="font-weight: bold;">Phone (Cellular):</div>
        <div style="font-weight: bold;">Email:</div>
        <div style="font-weight: bold;">Secondary email:</div>
        <div style="font-weight: bold;">Place of Birth:</div>
      </div>
      <div style="text-align: right;">
        <div style="font-size: 1.2em; font-weight: bold;">{{ full_name }}</div>
        <div>{{ address }}</div>
        <div>{{ phone }}</div>
        <div>{{ email }}</div>
        <div>{{ secondary_email }}</div>
        <div>{{ place_of_birth }}</div>
      </div>
    </div>

    <div class="section-title">Education</div>
    <table>
      <thead>
        <tr>
          <th style="width: 15%;">Years</th>
          <th style="width: 25%;">Degree</th>
          <th style="width: 60%;">Institution</th>
        </tr>
      </thead>
      <tbody>
        {% for edu in education %}
        <tr>
          <td>{{ edu.years }}</td>
          <td>{{ edu.degree }}</td>
          <td>{{ edu.institution }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <div class="section-title">Postdoctoral Training</div>
    <table>
      <thead>
        <tr>
          <th style="width: 20%;">Period</th>
          <th style="width: 30%;">Role</th>
          <th style="width: 50%;">Institution</th>
        </tr>
      </thead>
      <tbody>
        {% for postdoc in postdoctoral_training %}
        <tr>
          <td>{{ postdoc.period }}</td>
          <td>{{ postdoc.role }}</td>
          <td>{{ postdoc.institution }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <div class="section-title">Faculty Academic Appointments</div>
    <table>
      <thead>
        <tr>
          <th style="width: 20%;">Years</th>
          <th style="width: 30%;">Title</th>
          <th style="width: 50%;">Institution</th>
        </tr>
      </thead>
      <tbody>
        {% for appt in faculty_appointments %}
        <tr>
          <td>{{ appt.years }}</td>
          <td>{{ appt.title }}</td>
          <td>{{ appt.institution }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <div class="section-title">Committee Service</div>
    <table>
      <thead>
        <tr>
          <th style="width: 20%;">Years</th>
          <th style="width: 40%;">Service</th>
          <th style="width: 40%;">Role</th>
        </tr>
      </thead>
      <tbody>
        {% for service in committee_service %}
        <tr>
          <td>{{ service.years }}</td>
          <td>{{ service.description }}</td>
          <td>{{ service.role }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <div class="section-title">Professional Societies</div>
    <table>
      <thead>
        <tr>
          <th style="width: 20%;">Years</th>
          <th style="width: 50%;">Society</th>
          <th style="width: 30%;">Role</th>
        </tr>
      </thead>
      <tbody>
        {% for society in professional_societies %}
        <tr>
          <td>{{ society.years }}</td>
          <td>{{ society.name }}</td>
          <td>{{ society.role }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

<div class="page">
  <div>
    <div class="section-title">Report of Local Teaching and Training</div>
    <table>
      <thead>
        <tr>
          <th style="width: 20%;">Years</th>
          <th style="width: 50%;">Activity</th>
          <th style="width: 30%;">Institution</th>
        </tr>
      </thead>
      <tbody>
        {% for teaching in teaching_activities %}
        <tr>
          <td>{{ teaching.years }}</td>
          <td>{{ teaching.description }}</td>
          <td>{{ teaching.institution }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <div class="section-title">Formal Teaching of Residents, Clinical Fellows and Research Fellows (post-docs)</div>
    <table>
      <thead>
        <tr>
          <th style="width: 20%;">Years</th>
          <th style="width: 50%;">Activity</th>
          <th style="width: 30%;">Publication Status</th>
        </tr>
      </thead>
      <tbody>
        {% for formal_teaching in formal_teaching_activities %}
        <tr>
          <td>{{ formal_teaching.years }}</td>
          <td>{{ formal_teaching.description }}</td>
          <td>{{ formal_teaching.publication_status }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <div class="section-title">Clinical Supervisory and Training Responsibilities</div>
    <table>
      <thead>
        <tr>
          <th style="width: 20%;">Years</th>
          <th style="width: 50%;">Activity</th>
          <th style="width: 30%;">Institution</th>
        </tr>
      </thead>
      <tbody>
        {% for clinical_supervision in clinical_supervision_activities %}
        <tr>
          <td>{{ clinical_supervision.years }}</td>
          <td>{{ clinical_supervision.description }}</td>
          <td>{{ clinical_supervision.institution }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <div class="section-title">Laboratory and Other Research Supervisory and Training Responsibilities</div>
    <table>
      <thead>
        <tr>
          <th style="width: 20%;">Years</th>
          <th style="width: 50%;">Activity</th>
          <th style="width: 30%;">Institution</th>
        </tr>
      </thead>
      <tbody>
        {% for lab_research in lab_research_activities %}
        <tr>
          <td>{{ lab_research.years }}</td>
          <td>{{ lab_research.description }}</td>
          <td>{{ lab_research.institution }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

<div class="page">
  <div>
    <div class="section-title">Report of Regional, National and International Invited Teaching and Presentations</div>
    <div style="font-weight: bold; margin-top: 15px;">Invited Presentations and Courses</div>
    <table>
      <thead>
        <tr>
          <th style="width: 15%;">Year</th>
          <th style="width: 60%;">Presentation Details</th>
          <th style="width: 25%;">Location/Context</th>
        </tr>
      </thead>
      <tbody>
        {% for presentation in invited_presentations %}
        <tr>
          <td>{{ presentation.year }}</td>
          <td>{{ presentation.description }}</td>
          <td>{{ presentation.location }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

<div class="page">
  <div>
    <div class="section-title">Report of Clinical Activities and Innovations</div>
    <div style="font-weight: bold; margin-top: 15px;">Current Licensure and Certification</div>
    <table>
      <thead>
        <tr>
          <th style="width: 20%;">Year</th>
          <th style="width: 50%;">Certification/License</th>
          <th style="width: 30%;">Details</th>
        </tr>
      </thead>
      <tbody>
        {% for license in licenses %}
        <tr>
          <td>{{ license.year }}</td>
          <td>{{ license.description }}</td>
          <td>{{ license.details }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <div class="section-title">Practice Activities and Global Health</div>
    <table>
      <thead>
        <tr>
          <th style="width: 20%;">Year</th>
          <th style="width: 50%;">Activity</th>
          <th style="width: 30%;">Location/Context</th>
        </tr>
      </thead>
      <tbody>
        {% for practice in practice_activities %}
        <tr>
          <td>{{ practice.year }}</td>
          <td>{{ practice.description }}</td>
          <td>{{ practice.location }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

<div class="page">
  <div>
    <div class="section-title">Report of Scholarship</div>
    <div style="font-weight: bold; margin-top: 15px;">Peer Reviewed Publications</div>
    <table>
      <thead>
        <tr>
          <th style="width: 15%;">Year</th>
          <th style="width: 70%;">Publication Details</th>
          <th style="width: 15%;">Journal</th>
        </tr>
      </thead>
      <tbody>
        {% for publication in publications %}
        <tr>
          <td>{{ publication.year }}</td>
          <td>{{ publication.description }}</td>
          <td>{{ publication.journal }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <div style="margin-top: 30px;">
      <div style="font-weight: bold;">Unpublished manuscripts currently under peer review</div>
      <ul>
        {% for manuscript in manuscripts %}
        <li>{{ manuscript.description }}</li>
        {% endfor %}
      </ul>
    </div>

    <div style="margin-top: 30px;">
      <div style="font-weight: bold;">Professional educational materials or reports, in print or other media</div>
      <ul>
        {% for material in educational_materials %}
        <li>{{ material.description }}</li>
        {% endfor %}
      </ul>
    </div>

    <div style="margin-top: 30px;">
      <div style="font-weight: bold;">Abstracts, Awards, Poster Presentations and Exhibits Presented at Professional Meetings</div>
      <ul>
        {% for abstract in abstracts %}
        <li>{{ abstract.description }}</li>
        {% endfor %}
      </ul>
    </div>
  </div>
</div>

<div class="page">
  <div>
    <div style="font-weight: bold; margin-top: 20px;">Teaching Awards</div>
    <table>
      <thead>
        <tr>
          <th style="width: 20%;">Year</th>
          <th style="width: 50%;">Award Type</th>
          <th style="width: 30%;">Institution</th>
        </tr>
      </thead>
      <tbody>
        {% for award in teaching_awards %}
        <tr>
          <td>{{ award.year }}</td>
          <td>{{ award.description }}</td>
          <td>{{ award.institution }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>