      <li><span data-field="publications.books[{{ 11 }}].title">{{ publications.books[11].title }}</span></li>
      <li><span data-field="publications.books[{{ 12 }}].title">{{ publications.books[12].title }}</span></li>
      <li><span data-field="publications.books[{{ 13 }}].title">{{ publications.books[13].title }}</span></li>
    </ul>
  </div>

  <div class="section-content">
    <h2>Chapters in Edited Volumes</h2>
    <ul class="publication-list">
      <li><span data-field="publications.chapters[{{ 0 }}].title">{{ publications.chapters[0].title }}</span></li>
      <li><span data-field="publications.chapters[{{ 1 }}].title">{{ publications.chapters[1].title }}</span></li>
      <li><span data-field="publications.chapters[{{ 2 }}].title">{{ publications.chapters[2].title }}</span></li>
      <li><span data-field="publications.chapters[{{ 3 }}].title">{{ publications.chapters[3].title }}</span></li>
    </ul>
  </div>

  <div class="section-content">
    <h2>Working Papers</h2>
    <ul class="publication-list">
