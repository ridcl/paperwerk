  h1, h2, h3 {
    font-weight: bold;
  }
  .header-info {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 20px;
  }
  .author-name {
    font-weight: bold;
  }
  .page-number {
    font-size: 0.9em;
  }
  .year-heading {
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
    font-size: 1.1em;
