<!DOCTYPE html>
<html>
<head>
<title>CV Template</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    line-height: 1.5;
    color: #333;
  }
  h1, h2, h3 {
    font-weight: bold;
    margin-top: 0.5em;
    margin-bottom: 0.5em;
  }
  h1 { font-size: 24pt; }
  h2 { font-size: 16pt; border-bottom: 1px solid #ccc; padding-bottom: 3px; margin-top: 1.5em; }
  h3 { font-size: 14pt; margin-top: 1em; }
  .contact-info {
    display: flex;
    justify-content: space-between;
    margin-bottom: 20px;
    font-size: 11pt;
  }
  .contact-info div {
    display: flex;
    flex-direction: column;
  }
  .section-content {
    margin-bottom: 1.5em;
  }
  .entry {
    margin-bottom: 1em;
  }
  .entry h3 {
    font-size: 12pt;
    font-weight: bold;
    margin-bottom: 2px;
  }
  .entry p {
    margin: 0;
    font-size: 10pt;
  }
  .publication-list li {
    margin-bottom: 0.5em;
    font-size: 10pt;
  }
  .job-title {
    font-weight: bold;
  }
</style>

<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
