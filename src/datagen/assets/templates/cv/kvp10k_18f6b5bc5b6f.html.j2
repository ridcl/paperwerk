  .publication-entry {
    margin-bottom: 15px;
    text-align: justify;
  }
  .publication-entry p {
    margin: 0;
  }
</style>
</head>
<body>

<div class="page">
  <h1><span data-field="full_name">{{ full_name }}</span></h1>
  <div class="contact-info">
    <div>
      <div>Phone: {{ contact.phone }}</div>
      <div>Fax: {{ contact.fax }}</div>
    </div>
    <div>
      <div>Email: {{ contact.email }}</div>
      <div>Homepage: {{ contact.homepage }}</div>
    </div>
  </div>

  <div class="section-content">
    <h2>Education</h2>
    <div class="entry">
      <p><span data-field="education.degree_1">{{ education.degree_1 }}</span></p>
      <p><span data-field="education.degree_2">{{ education.degree_2 }}</span></p>
    </div>
  </div>

  <div class="section-content">
    <h2>Academic Appointments</h2>
    {% for appointment in academic_appointments %}
    <div class="entry">
      <p><span data-field="academic_appointments[{{ loop.index0 }}].title">{{ appointment.title }}</span>, {{ appointment.institution }}</p>
      <p><span data-field="academic_appointments[{{ loop.index0 }}].dates">{{ appointment.dates }}</span></p>
    </div>
    {% endfor %}
  </div>

  <div class="section-content">
    <h2>Publications</h2>
    <h3>Books</h3>
    <ul class="publication-list">
      <li><span data-field="publications.books[{{ 0 }}].title">{{ publications.books[0].title }}</span></li>
      <li><span data-field="publications.books[{{ 1 }}].title">{{ publications.books[1].title }}</span></li>
      <li><span data-field="publications.books[{{ 2 }}].title">{{ publications.books[2].title }}</span></li>
      <li><span data-field="publications.books[{{ 3 }}].title">{{ publications.books[3].title }}</span></li>
      <li><span data-field="publications.books[{{ 4 }}].title">{{ publications.books[4].title }}</span></li>
      <li><span data-field="publications.books[{{ 5 }}].title">{{ publications.books[5].title }}</span></li>
      <li><span data-field="publications.books[{{ 6 }}].title">{{ publications.books[6].title }}</span></li>
      <li><span data-field="publications.books[{{ 7 }}].title">{{ publications.books[7].title }}</span></li>
