<!DOCTYPE html>
<html>
<head>
<title>CV Template</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { font-weight: bold; }
  .contact-info { margin-bottom: 20px; }
  .section-title { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
  .entry { margin-bottom: 15px; }
  .entry-title { font-weight: bold; }
  .entry-details { font-style: italic; font-size: 0.9em; }
  table { width: 100%; border-collapse: collapse; margin-top: 10px; }
  td { padding: 5px 0; }
</style>

<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3, h4 { font-weight: bold; }
  table { width: 100%; border-collapse: collapse; }
  td, th { padding: 5px 0; }
</style>
</head>
<body>

<div class="page">
  <div style="text-align: center;">
    <span data-field="full_name" style="font-size: 1.5em; font-weight: bold;">{{ full_name }}</span>
    <div class="contact-info">
      <span data-field="department">{{ department }}</span>, <span data-field="university">{{ university }}</span><br>
      <span data-field="address">{{ address }}</span><br>
      Office: <span data-field="office_phone">{{ office_phone }}</span> | Fax: <span data-field="fax_phone">{{ fax_phone }}</span><br>
      <span data-field="email">{{ email }}</span>
    </div>
  </div>

  <div class="section-title">Education</div>
  {% for edu in education %}
  <div class="entry">
    <span data-field="edu.year">{{ edu.year }}</span> - <span data-field="edu.degree">{{ edu.degree }}</span>, <span data-field="edu.major">{{ edu.major }}</span>, <span data-field="edu.institution">{{ edu.institution }}</span>
  </div>
  {% endfor %}

  <div class="section-title">Teaching and Professional Appointments</div>
  {% for appt in appointments %}
  <div class="entry">
    <span data-field="appt.year_start">{{ appt.year_start }}</span>-<span data-field="appt.year_end">{{ appt.year_end }}</span> - <span data-field="appt.title">{{ appt.title }}</span>, <span data-field="appt.institution">{{ appt.institution }}</span>
  </div>
  {% endfor %}

  <div class="section-title">Research and Publications</div>

  <div class="section-title">Books (Peer Reviewed)</div>
  {% for book in books %}
  <div class="entry">
    <span data-field="book.title">{{ book.title }}</span>, <span data-field="book.publisher">{{ book.publisher }}</span>, <span data-field="book.year">{{ book.year }}</span>
  </div>
  {% endfor %}

  <div class="section-title">Edited Books (Peer Reviewed)</div>
  {% for edited_book in edited_books %}
  <div class="entry">
    <span data-field="edited_book.title">{{ edited_book.title }}</span>, <span data-field="edited_book.publisher">{{ edited_book.publisher }}</span>, <span data-field="edited_book.year">{{ edited_book.year }}</span>
  </div>
  {% endfor %}

  <div class="section-title">Journal Articles (Peer Reviewed)</div>
  {% for journal in journal_articles %}
  <div class="entry">
    <span data-field="journal.title">{{ journal.title }}</span>, <span data-field="journal.publication">{{ journal.publication }}</span>, <span data-field="journal.year">{{ journal.year }}</span>
  </div>
  {% endfor %}

  <div class="section-title">Works in Edited Collections (Peer Reviewed)</div>
  {% for collection_work in collection_works %}
  <div class="entry">
    <span data-field="collection_work.title">{{ collection_work.title }}</span>, in <span data-field="collection_work.collection">{{ collection_work.collection }}</span>, <span data-field="collection_work.publisher">{{ collection_work.publisher }}</span>, <span data-field="collection_work.year">{{ collection_work.year }}</span>
  </div>
  {% endfor %}

  <div class="section-title">Other Published Articles (Not Refereed)</div>
  {% for other_article in other_articles %}
  <div class="entry">
    <span data-field="other_article.title">{{ other_article.title }}</span>, <span data-field="other_article.publication">{{ other_article.publication }}</span>, <span data-field="other_article.year">{{ other_article.year }}</span>
  </div>
  {% endfor %}

</div>

<div class="page">
  <div class="section-title">Museum Exhibits</div>
  {% for exhibit in museum_exhibits %}
  <div class="entry">
    <span data-field="exhibit.title">{{ exhibit.title }}</span>, <span data-field="exhibit.role">{{ exhibit.role }}</span>, <span data-field="exhibit.year">{{ exhibit.year }}</span>
  </div>
  {% endfor %}

  <div class="section-title">Encyclopedia Entries</div>
  {% for encyclopedia in encyclopedia_entries %}
  <div class="entry">
    <span data-field="encyclopedia.title">{{ encyclopedia.title }}</span>, <span data-field="encyclopedia.source">{{ encyclopedia.source }}</span>, <span data-field="encyclopedia.year">{{ encyclopedia.year }}</span>
  </div>
  {% endfor %}

  <div class="section-title">Research Grants, Funding and Awards</div>
  <div class="section-title">Awards</div>
  {% for award in awards %}
  <div class="entry">
    <span data-field="award.name">{{ award.name }}</span>, <span data-field="award.description">{{ award.description }}</span>, <span data-field="award.year">{{ award.year }}</span>
  </div>
  {% endfor %}

  <div class="section-title">Conference Papers and Presentations</div>
  <div class="section-title">International</div>
  {% for international_conf in international_conferences %}
  <div class="entry">
    <span data-field="international_conf.title">{{ international_conf.title }}</span>, <span data-field="international_conf.conference">{{ international_conf.conference }}</span>, <span data-field="international_conf.year">{{ international_conf.year }}</span>
  </div>
  {% endfor %}

  <div class="section-title">National</div>
  {% for national_conf in national_conferences %}
  <div class="entry">
    <span data-field="national_conf.title">{{ national_conf.title }}</span>, <span data-field="national_conf.conference">{{ national_conf.conference }}</span>, <span data-field="national_conf.year">{{ national_conf.year }}</span>
  </div>
  {% endfor %}

  <div class="section-title">Regional</div>
  {% for regional_conf in regional_conferences %}
  <div class="entry">
    <span data-field="regional_conf.title">{{ regional_conf.title }}</span>, <span data-field="regional_conf.conference">{{ regional_conf.conference }}</span>, <span data-field="regional_conf.year">{{ regional_conf.year }}</span>
  </div>
  {% endfor %}

  <div class="section-title">Film Screenings & Festivals</div>
  {% for film_fest in film_festivals %}
  <div class="entry">
    <span data-field="film_fest.title">{{ film_fest.title }}</span>, <span data-field="film_fest.year">{{ film_fest.year }}</span>
  </div>
  {% endfor %}

</div>


