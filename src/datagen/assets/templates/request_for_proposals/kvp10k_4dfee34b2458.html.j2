<!DOCTYPE html>
<html>
<head>
    <title>Proposal Request</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3, h4 { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif; }
        .header-logo { float: left; margin-right: 40px; }
        .title-block { margin-bottom: 30px; }
        .section-title { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
        .list-item { margin-bottom: 8px; }
        .table-container { width: 100%; border-collapse: collapse; margin-top: 15px; }
        .table-container th, .table-container td { border: 1px solid #ccc; padding: 8px; text-align: left; }
        .table-container th { background-color: #f2f2f2; }
    </style>

<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
