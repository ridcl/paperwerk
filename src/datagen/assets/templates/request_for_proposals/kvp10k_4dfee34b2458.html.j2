    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
  }
  ul {
    margin-top: 10px;
    margin-bottom: 10px;
    padding-left: 20px;
  }
  li {
    margin-bottom: 5px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
