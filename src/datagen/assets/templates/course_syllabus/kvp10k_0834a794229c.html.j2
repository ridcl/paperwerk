            <p>Course Meetings & TR: <span data-field="meeting_time">{{ meeting_time }}</span></p>
            <p>Location: <span data-field="location">{{ location }}</span></p>
            <p>Prerequisite Courses: <span data-field="prerequisites">{{ prerequisites }}</span></p>
            <p>Course Fee: <span data-field="course_fee">{{ course_fee }}</span></p>
            <p>Instructor: <span data-field="instructor_name">{{ instructor_name }}</span></p>
            <p>Office Location: <span data-field="office_location">{{ office_location }}</span></p>
