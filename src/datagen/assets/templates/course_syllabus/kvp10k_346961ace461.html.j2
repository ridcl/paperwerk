<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child {
    page-break-after: auto;
  }
  h1, h2, h3, h4, h5, h6 {
    font-family: "DejaVu Sans", "Liberation Sans", Arial, Helvetica, sans-serif;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
    margin-bottom: 15px;
  }
  td, th {
    padding: 8px;
    text-align: left;
  }
  .section-title {
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
    font-family: "DejaVu Sans", "Liberation Sans", Arial, Helvetica, sans-serif;
  }
</style>

<div class="page">
  <header>
    <h1 style="font-size: 24pt; font-weight: bold; margin-bottom: 5px;">{{ course_code }} - {{ course_name }}</h1>
    <h2 style="font-size: 14pt; font-weight: normal; margin-top: 0;">{{ semester_year }}</h2>
  </header>

  <div style="margin-top: 30px;">
    <h3 style="font-size: 12pt; font-weight: bold;">Instructor Contact Information</h3>
    <p>Name: <span data-field="instructor.full_name">{{ instructor.full_name }}</span></p>
    <p>Office Hours: <span data-field="instructor.office_hours">{{ instructor.office_hours }}</span></p>
    <p>Email: <span data-field="instructor.email">{{ instructor.email }}</span></p>
  </div>

  <div class="section-title">Instructor Introduction</div>
  <p><span data-field="instructor_bio">{{ instructor_bio }}</span></p>

  <div class="section-title">Course Description</div>
  <p><span data-field="course_description">{{ course_description }}</span></p>

  <div class="section-title">Course Goals and Objectives</div>
  <p><span data-field="goals_objectives">{{ goals_objectives }}</span></p>

  <div class="section-title">Course Outcomes</div>
  <p><span data-field="course_outcomes">{{ course_outcomes }}</span></p>

  <div class="section-title">Assignments</div>
  <p><span data-field="assignments_description">{{ assignments_description }}</span></p>
</div>

