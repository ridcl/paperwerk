<style>
    @page { size: A4; margin: 0; }
    .page {
        width: 794px; height: 1123px;
        padding: 50px 60px; box-sizing: border-box;
        overflow: hidden; page-break-after: always;
        position: relative;
        font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
    }
    .page:last-child { page-break-after: auto; }
    h1, h2, h3 { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; }
    table { width: 100%; border-collapse: collapse; margin-top: 15px; }
    td, th { padding: 5px 0; text-align: left; }
</style>

<div class="page">
    <div style="text-align: center; margin-bottom: 30px;">
        <h1 style="font-size: 24pt; margin-bottom: 5px;">THE UNIVERSITY OF TEXAS AT EL PASO</h1>
        <h2 style="font-size: 18pt; margin-top: 0;">COLLEGE OF SCIENCE</h2>
        <h3 style="font-size: 14pt; margin-top: 0;">DEPARTMENT OF MATHEMATICAL SCIENCES</h3>
    </div>

    <table style="width: 100%;">
        <tr>
            <td style="width: 50%;">
                Course #: <span data-field="course_number">{{ course_number }}</span>, CRN <span data-field="crn">{{ crn }}</span>
                <br>
                Course Title: <span data-field="course_title">{{ course_title }}</span>
                <br>
                Credit Hrs: <span data-field="credit_hours">{{ credit_hours }}</span>
                <br>
                Term: <span data-field="term">{{ term }}</span>
                <br>
                Course Meetings & Location: <span data-field="meeting_location">{{ meeting_location }}</span>
                <br>
                Prerequisite Courses: <span data-field="prerequisites">{{ prerequisites }}</span>
                <br>
                Course Fee: (if applicable) <span data-field="course_fee">{{ course_fee }}</span>
            </td>
            <td style="width: 50%; text-align: right;">
                Phone #: <span data-field="phone_number">{{ phone_number }}</span><br>
                E-mail address: <span data-field="email_address">{{ email_address }}</span><br>
                Fax #: <span data-field="fax_number">{{ fax_number }}</span><br>
                Emergency Contact: <span data-field="emergency_contact">{{ emergency_contact }}</span>
            </td>
        </tr>
    </table>

    <table style="width: 100%; margin-top: 20px;">
        <tr>
            <td style="width: 50%;">
                Instructor: <span data-field="instructor_name">{{ instructor_name }}</span><br>
                Office Location: <span data-field="office_location">{{ office_location }}</span><br>
                Contact Info: <span data-field="contact_info">{{ contact_info }}</span>
            </td>
            <td style="width: 50%;">
                Office Hrs: <span data-field="office_hours">{{ office_hours }}</span>
            </td>
        </tr>
    </table>

    <div style="margin-top: 30px;">
        <p>Textbook(s): <span data-field="textbook_details">{{ textbook_details }}</span>; Materials: <span data-field="materials_details">{{ materials_details }}</span>; Required: <span data-field="required_details">{{ required_details }}</span></p>
    </div>

    <div style="margin-top: 30px;">
        <h3 style="font-size: 14pt;">WebAssign Class Key</h3>
        <p>YOU WILL NEED TO BUY YOUR OWN TEXTBOOK IF YOU ONLY BUY THE HOMEWORK ACCESS!</p>
        <p>
            <span data-field="webassign_key">{{ webassign_key }}</span>
        </p>
        <p>
            <span data-field="disclaimer_text">{{ disclaimer_text }}</span>
        </p>
    </div>
</div>

<div class="page">
    <table style="width: 100%;">
        <tr>
            <td style="width: 50%;">
                <p>Drop Date: <span data-field="drop_date">{{ drop_date }}</span></p>
                <p>Other Date: <span data-field="other_date">{{ other_date }}</span></p>
                <p>Course Objectives (Learning Outcomes): <span data-field="course_objectives">{{ course_objectives }}</span></p>
                <p>Activities/Assignments: <span data-field="activities_assignments">{{ activities_assignments }}</span></p>
                <p>Assessment of Course Objectives: <span data-field="assessment_objectives">{{ assessment_objectives }}</span></p>
                <p>Course Schedule: <span data-field="course_schedule">{{ course_schedule }}</span></p>
            </td>
            <td style="width: 50%;">
                <p>After the drop date, you can be dropped only with an F. No exceptions. The instructor will not grant a W after the drop date.</p>
                <p>Course: <span data-field="course_code">{{ course_code }}</span></p>
                <p>Date: <span data-field="course_date">{{ course_date }}</span></p>
            </td>
        </tr>
    </table>

    <div style="margin-top: 30px;">
        <p>
            <span data-field="objective_detail_1">{{ objective_detail_1 }}</span>
        </p>
    </div>
</div>

<div class="page">
    <table style="width: 100%;">
        <tr>
            <td style="width: 50%;">
                <p>
                    <span data-field="grading_policy">{{ grading_policy }}</span>
                </p>
                <p>
                    Make-up Policy: <span data-field="make_up_policy">{{ make_up_policy }}</span>
                </p>
                <p>
                    Attendance Policy: <span data-field="attendance_policy">{{ attendance_policy }}</span>
                </p>
                <p>
                    Academic Integrity Policy: <span data-field="academic_integrity_policy">{{ academic_integrity_policy }}</span>
                </p>
                <p>
                    Civility Statement: <span data-field="civility_statement">{{ civility_statement }}</span>
                </p>
                <p>
                    Disability Statement: <span data-field="disability_statement">{{ disability_statement }}</span>
                </p>
                <p>
                    Military Statement: <span data-field="military_statement">{{ military_statement }}</span>
                </p>
            </td>
            <td style="width: 50%;">
                <!-- This column is mostly empty in the source layout for this section -->
            </td>
        </tr>
    </table>
</div>