                <li><span data-field="clo_4">{{ clo_4 }}</span></li>
                <li><span data-field="clo_5">{{ clo_5 }}</span></li>
            </ul>
        </div>

        <div style="margin-top: 40px;">
            <h3 class="section-title">Required Textbook</h3>
