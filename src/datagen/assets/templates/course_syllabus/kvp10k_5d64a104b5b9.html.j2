            <p>Office Hours: <span data-field="office_hours">{{ office_hours }}</span></p>
            <p>Class Days/Time: <span data-field="class_days_time">{{ class_days_time }}</span></p>
            <p>Classroom: <span data-field="classroom">{{ classroom }}</span></p>
        </div>

        <div style="margin-top: 30px;">
            <h3 class="section-title">Course Description</h3>
            <p><span data-field="course_description_text">{{ course_description_text }}</span></p>
        </div>

        <div style="margin-top: 30px;">
            <h3 class="section-title">Course Format: Online Course</h3>
            <p><span data-field="course_format_details">{{ course_format_details }}</span></p>
            <p>See <a href="http://www.sjsu.edu/policy/F13-2.pdf">University Policy F13-2</a> at http://www.sjsu.edu/policy/F13-2.pdf for more details.</p>
        </div>

        <div style="margin-top: 30px;">
