<div class="page">
  <div style="text-align: center;">
    <div class="header-title">University of Texas at El Paso</div>
    <div class="header-subtitle">Department of Criminal Justice</div>
    <div style="font-size: 16pt; margin-top: 10px;">Spring {{ current_year }}</div>
  </div>

  <div style="margin-top: 40px;">
