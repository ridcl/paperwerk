<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1, h2 { text-align: center; margin-bottom: 5px; }
  .header-section { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px; }
  .form-section { margin-bottom: 30px; }
  .field-row { display: flex; margin-bottom: 10px; }
  .field-row label { width: 150px; font-weight: bold; }
  .field-row input[type="text"] { flex-grow: 1; border-bottom: 1px solid #000; }
  .checkbox-group { display: flex; gap: 20px; margin-top: 10px; }
  .checkbox-group label { font-weight: normal; display: flex; align-items: center; gap: 5px; }
  .signature-area { display: flex; justify-content: space-between; margin-top: 50px; }
  .signature-box { width: 30%; text-align: center; border-top: 1px solid #000; padding-top: 5px; }
  .table-container { width: 100%; border-collapse: collapse; margin-top: 20px; }
  .table-container td { padding: 5px 0; border-bottom: 1px dotted #ccc; }
  .table-header { font-weight: bold; }
</style>

<div class="page">
  <div style="text-align: center;">
    <h1 style="font-size: 24pt;">LSU Health Sciences Center</h1>
    <h2 style="font-size: 18pt;">Parking Payroll Deduction Form</h2>
    <h3 style="font-size: 16pt; margin-top: 10px;">Downtown Campus</h3>
  </div>

  <div class="header-section" style="margin-top: 40px;">
    <div style="flex-grow: 1;">
      <p>Complete and sign with ink.</p>
      <p>Return to the Parking Office (RCB, 433 Bolivar Street, Room 158) email to <span data-field="return_email">{{ return_email }}</span> or fax to 568-2116</p>
    </div>
    <div style="width: 30%;">
      <!-- Placeholder for image -->
      <img src="placeholder_image.png" alt="Campus Image" style="width: 100%; height: auto;">
    </div>
  </div>

  <div class="form-section">
    <div class="field-row">
      <label>Name:</label>
      <span data-field="full_name" style="flex-grow: 1; border-bottom: 1px solid #000;">{{ full_name }}</span>
    </div>
    <div class="field-row">
      <label>Employee ID #:</label>
      <span data-field="employee_id" style="flex-grow: 1; border-bottom: 1px solid #000;">{{ employee_id }}</span>
    </div>
    <div class="field-row">
      <label>Department:</label>
      <span data-field="department" style="flex-grow: 1; border-bottom: 1px solid #000;">{{ department }}</span>
      <label style="margin-left: 30px;">Phone Number:</label>
      <span data-field="phone_number" style="flex-grow: 1; border-bottom: 1px solid #000;">{{ phone_number }}</span>
    </div>
  </div>

  <div class="form-section">
    <p>Employment Status:
      <label><input type="checkbox"> Full-time</label>
      <label><input type="checkbox"> Part-time (&lt; 20 hours)</label>
      <label><input type="checkbox"> Bi-monthly</label>
    </p>
    <p>Payroll Status:
      <label><input type="checkbox"> Monthly</label>
      <label><input type="checkbox"> Bi-weekly</label>
    </p>
    <p>I hereby authorize LSU Health Sciences Center to deduct from my payroll check the appropriate amount per pay period, in the <span data-field="total_yearly_amount">{{ total_yearly_amount }}</span> yearly amount of $ <span data-field="deduction_amount">{{ deduction_amount }}</span>.</p>
    <p>Employee's parking deduction will be updated accordingly with position changes or percent effort changes.</p>
  </div>

  <div class="form-section">
    <p>Parking Fees:</p>
    <div class="checkbox-group">
      <label><input type="checkbox"> Full-Time Faculty and Staff ..................................... $290</label>
      <label><input type="checkbox"> Part-Time Faculty and Staff - 50% or Less ..................... $100</label>
      <label><input type="checkbox"> House Officers / Fellows ......................................... $220</label>
      <label><input type="checkbox"> Reserved (Space Already Assigned) ................................. $523</label>
    </div>
  </div>

  <div class="form-section" style="text-align: center; border: 1px solid #000; padding: 10px;">
    <p>This deduction is taxable. (Deduct Code - GEN019)</p>
  </div>

  <div class="signature-area">
    <div style="width: 30%;">
      <div style="text-align: center;">
        <p>Email Form</p>
        <div style="height: 50px; border-bottom: 1px solid #000; margin-top: 20px;" data-field="email_form">{{ email_form }}</div>
      </div>
    </div>
    <div style="width: 30%;">
      <div style="text-align: center;">
        <p>Print Form</p>
        <div style="height: 50px; border-bottom: 1px solid #000; margin-top: 20px;" data-field="print_form">{{ print_form }}</div>
      </div>
    </div>
    <div style="width: 30%;">
      <div style="text-align: center;">
        <p>Signature</p>
        <div style="height: 50px; border-bottom: 1px solid #000; margin-top: 20px;" data-field="signature">{{ signature }}</div>
      </div>
    </div>
  </div>

  <div style="display: flex; justify-content: space-between; margin-top: 50px;">
    <div style="width: 45%;">
      <p>Effective Date</p>
      <div style="height: 30px; border-bottom: 1px solid #000; margin-top: 5px;" data-field="effective_date">{{ effective_date }}</div>
    </div>
    <div style="width: 45%;">
      <p>Parking Office Approval</p>
      <div style="height: 30px; border-bottom: 1px solid #000; margin-top: 5px;" data-field="parking_office_approval">{{ parking_office_approval }}</div>
    </div>
  </div>

  <div class="form-section" style="margin-top: 50px;">
    <p style="font-size: 10pt;">Agreement to Comply with Rules and Regulations of LSUHSC Campus Parking</p>
    <p style="font-size: 10pt;">As a condition of receiving parking privileges from the LSU Health Sciences Center, I agree it is my responsibility to understand and comply with all rules and requirements contained in the parking regulations, a copy of which I acknowledge receipt of with my vehicle registration forms. I understand that non-compliance can result in my receipt of a notice of violation citation with a monetary penalty assessed in accordance with the schedule of violation fees which is part of the parking regulations.</p>
    <p style="font-size: 10pt;">I further acknowledge, agree, and authorize the LSU Health Sciences Center - New Orleans to deduct delinquent violation assessments from my payroll, as described in the parking regulations. I understand that this deduction is made in accordance with the requirements of the parking regulations.</p>
  </div>
</div>