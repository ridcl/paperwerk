<!DOCTYPE html>
<html>
<head>
<title>Information Directory</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child { page-break-after: auto; }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 10px;
  }
  td, th {
    padding: 4px 0;
    text-align: left;
  }
  .header {
    font-weight: bold;
    font-size: 14pt;
    margin-bottom: 15px;
  }
  .sub-header {
    font-weight: bold;
    font-size: 12pt;
    margin-top: 15px;
    margin-bottom: 5px;
  }
  .section-title {
    font-size: 14pt;
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
  }
  .two-column-layout {
    display: flex;
    justify-content: space-between;
  }
  .column {
    width: 48%;
  }
  .contact-info {
    margin-top: 20px;
  }
</style>
</head>
