      <p><span data-field="sender.address_line_1">{{ sender.address_line_1 }}</span></p>
      <p><span data-field="sender.city">{{ sender.city }}</span>, <span data-field="sender.postal_code">{{ sender.postal_code }}</span></p>
      <p><span data-field="sender.country">{{ sender.country }}</span></p>
    </div>
  </div>

  <h3 style="margin-bottom: 15px;">Description of Services/Goods</h3>

  <table>
    <thead>
      <tr>
        <th style="width: 50%;">Description</th>
        <th style="width: 20%; text-align: right;">Quantity</th>
        <th style="width: 15%; text-align: right;">Unit Price</th>
        <th style="width: 15%; text-align: right;">Amount</th>
      </tr>
    </thead>
    <tbody>
      {% for item in line_items %}
      <tr>
        <td><span data-field="line_items[{{ loop.index0 }}].description">{{ item.description }}</span></td>
        <td style="text-align: right;"><span data-field="line_items[{{ loop.index0 }}].quantity">{{ item.quantity }}</span></td>
        <td style="text-align: right;"><span data-field="line_items[{{ loop.index0 }}].unit_price">{{ item.unit_price }}</span></td>
        <td style="text-align: right;"><span data-field="line_items[{{ loop.index0 }}].amount">{{ item.amount }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <div style="margin-top: 40px; text-align: right;">
    <table style="width: 40%;">
