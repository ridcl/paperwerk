<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "Liberation Serif", Georgia, serif; }
  h1, h2 { font-weight: bold; }
  .form-row { margin-bottom: 15px; }
  .input-line { border-bottom: 1px solid #000; display: inline-block; width: calc(100% - 20px); }
  .section-title { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px;">
    <div>
      <img src="" alt="Logo" style="height: 60px;"/>
      <h1 style="font-size: 24px; margin-top: 5px;">LSU Health</h1>
      <p style="font-size: 14px;">Office of the Registrar</p>
      <p style="font-size: 12px;">
        <span data-field="street_address">{{ street_address }}</span><br>
        <span data-field="city_state_zip">{{ city_state_zip }}</span><br>
        Office: <span data-field="office_phone">{{ office_phone }}</span><br>
        Fax: <span data-field="fax_number">{{ fax_number }}</span><br>
        Email: <span data-field="registrar_email">{{ registrar_email }}</span>
      </p>
    </div>
    <div style="text-align: right;">
      <h2 style="font-size: 20px;">CHANGE OF LEGAL ADDRESS</h2>
    </div>
  </div>

  <div class="form-row">
    <p>1. Name _________________________ Student ID # <span data-field="student_id">{{ student_id }}</span> on back of ID Card</p>
  </div>

  <div class="form-row">
    <p>2. Social Security # _________________________</p>
  </div>

  <div class="form-row">
    <p>3. Other Names that May Appear on Academic Records</p>
    <div style="margin-top: 5px;">
      <p>Last, First, Maiden or Middle _________________________</p>
      <p>Last, First, Maiden or Middle _________________________</p>
    </div>
  </div>

  <div class="form-row">
    <p>4. Contact Information ( ) Daytime phone ( ) Evening phone Email</p>
  </div>

  <div class="form-row">
    <p>5. School Attended</p>
    <div style="display: flex; gap: 20px;">
      <div>
        <input type="checkbox"> Allied Health Professions
        <input type="checkbox"> Dentistry
        <input type="checkbox"> Graduate Studies
      </div>
      <div>
        <input type="checkbox"> Medicine
        <input type="checkbox"> Nursing
        <input type="checkbox"> Public Health
      </div>
    </div>
  </div>

  <div style="margin-top: 40px;">
    <h3 style="text-align: center;">Old Address</h3>
    <div style="border: 1px solid #000; padding: 10px;">
      <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
        <div style="width: 50%;">
          <p>Street _________________________</p>
        </div>
        <div style="width: 25%;">
          <p>State _________ Zip _________</p>
        </div>
      </div>
      <div style="display: flex; justify-content: space-between;">
        <div style="width: 50%;">
          <p>City _________________________</p>
        </div>
        <!-- State and Zip are handled above for layout consistency -->
      </div>
    </div>
  </div>

  <div style="margin-top: 40px;">
    <h3 style="text-align: center;">Current (New) Address</h3>
    <div style="border: 1px solid #000; padding: 10px;">
      <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
        <div style="width: 50%;">
          <p>Street _________________________</p>
        </div>
        <div style="width: 25%;">
          <p>State _________ Zip _________</p>
        </div>
      </div>
      <div style="display: flex; justify-content: space-between;">
        <div style="width: 50%;">
          <p>City _________________________</p>
        </div>
        <!-- State and Zip are handled above for layout consistency -->
      </div>
    </div>
  </div>

  <div style="margin-top: 80px; text-align: center;">
    <p>
      &gt;&gt;&gt;&gt; Your Signature Is Required. &lt;&lt;&lt;&lt;
    </p>
    <div style="display: flex; justify-content: space-between; margin-top: 50px;">
      <div style="width: 45%;">
        <p>Signature _________________________</p>
      </div>
      <div style="width: 45%;">
        <p>Effective Date _________________________</p>
      </div>
    </div>
  </div>

  <div style="margin-top: 100px; display: flex; justify-content: space-between; font-size: 12px;">
    <p>Change_of_Legal_Address</p>
    <p>Page 1 of 1</p>
    <p>Revised 07/01/2015</p>
  </div>
</div>