        <label><input type="radio" name="reason" value="extension"> Program Extension</label>
        <label><input type="radio" name="reason" value="change_edu"> Change of Educational Level/Program</label>
        <label><input type="radio" name="reason" value="reinstatement"> Reinstatement of Status</label>
