<div class="page">
  <h1 style="text-align: center;">Workshop on Globalizing Engineering Education:</h1>
  <h2 style="text-align: center;">Lessons Learned from African and USA Partnerships</h2>
  <h3 style="text-align: center;">{{ location }}</h3>
  <h3 style="text-align: center;">{{ date_range }}</h3>
  <p style="text-align: center; margin-top: 30px;">Funded by the <span data-field="funder_name">{{ funder_name }}</span></p>
  <p style="text-align: center;">Organized by <span data-field="organizers">{{ organizers }}</span></p>

