    <p>
      <span data-field="prepared_by.name_1">{{ prepared_by.name_1 }}</span>, <span data-field="prepared_by.title_1">{{ prepared_by.title_1 }}</span><br>
      <span data-field="prepared_by.name_2">{{ prepared_by.name_2 }}</span>, <span data-field="prepared_by.title_2">{{ prepared_by.title_2 }}</span><br>
      <span data-field="prepared_by.name_3">{{ prepared_by.name_3 }}</span>, <span data-field="prepared_by.title_3">{{ prepared_by.title_3 }}</span>
