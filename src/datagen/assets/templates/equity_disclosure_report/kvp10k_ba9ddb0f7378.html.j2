      </div>
    </div>
    <div class="logo-text">
      <h1 style="font-size: 18pt; margin: 0;">DONALD P. KENNEDY</h1>
      <h2 style="font-size: 14pt; margin: 0;">INTERCOLLEGIATE</h2>
      <h2 style="font-size: 14pt; margin: 0;">ATHLETICS PROGRAM</h2>
    </div>
  </div>

  <h2 style="text-align: center; font-size: 20pt; margin-bottom: 10px;">EQUITY IN ATHLETICS</h2>
  <h2 style="text-align: center; font-size: 20pt; margin-top: 0;">DISCLOSURE ACT</h2>
  <h2 style="text-align: center; font-size: 16pt; margin-bottom: 50px;">(EADA)</h2>

  <h2 style="text-align: center; font-size: 18pt; margin-bottom: 10px;">REPORT OF DATA</h2>
