<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
    margin-bottom: 15px;
  }
  th, td {
    padding: 8px;
    text-align: left;
  }
  .header {
    font-weight: bold;
    text-align: center;
  }
</style>

<div class="page">
  <div style="text-align: center; margin-bottom: 20px;">
    <h1 style="font-size: 24pt; margin: 0;">The Home Depot Tax Exempt Registration</h1>
  </div>
  <p style="margin-bottom: 20px;">Thank you for registering for tax exempt purchasing with The Home Depot.</p>

  <div style="margin-bottom: 30px;">
    <p>Your Home Depot Tax ID Number is : <span data-field="tax_id">{{ tax_id }}</span></p>
  </div>

  <h2 style="font-size: 14pt; border-bottom: 1px solid #000; padding-bottom: 5px; margin-bottom: 20px;">Registration Information</h2>

  <table style="width: 100%;">
    <tr>
      <td style="width: 20%; vertical-align: top;">Home Depot Tax ID Number :</td>
      <td style="width: 80%;"><span data-field="tax_id_registered">{{ tax_id_registered }}</span></td>
    </tr>
    <tr>
      <td style="vertical-align: top;">Issued to Seller :</td>
      <td><span data-field="seller_name">{{ seller_name }}</span></td>
    </tr>
    <tr>
      <td style="vertical-align: top;">Address :</td>
      <td><span data-field="seller_address">{{ seller_address }}</span></td>
    </tr>
    <tr>
      <td style="vertical-align: top;">Name of Firm (Buyer) :</td>
      <td><span data-field="buyer_name">{{ buyer_name }}</span></td>
    </tr>
    <tr>
      <td style="vertical-align: top;">Address :</td>
      <td><span data-field="buyer_address">{{ buyer_address }}</span></td>
    </tr>
    <tr>
      <td style="vertical-align: top;">Business Phone Number :</td>
      <td><span data-field="business_phone">{{ business_phone }}</span></td>
    </tr>
    <tr>
      <td style="vertical-align: top;">Description of Business :</td>
      <td><span data-field="business_description">{{ business_description }}</span></td>
    </tr>
    <tr>
      <td style="vertical-align: top;">Authorized Signature :</td>
      <td><span data-field="authorized_signature">{{ authorized_signature }}</span></td>
    </tr>
    <tr>
      <td style="vertical-align: top;">General description of tangible property or taxable services to be purchased from the seller:</td>
      <td><span data-field="property_description">{{ property_description }}</span></td>
    </tr>
  </table>

  <h2 style="font-size: 14pt; border-bottom: 1px solid #000; padding-bottom: 5px; margin-top: 40px; margin-bottom: 20px;">Jurisdiction Information</h2>

  <table style="width: 100%;">
    <thead>
      <tr>
        <th style="width: 10%;">Abbrev.</th>
        <th style="width: 30%;">Jurisdiction Name</th>
        <th style="width: 30%;">State Registration, Seller's Permit, or ID Number of Purchaser</th>
        <th style="width: 30%;">Reason for Tax Exemption</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>LA</td>
        <td>LOUISIANA</td>
        <td><span data-field="jurisdiction_id">{{ jurisdiction_id }}</span></td>
        <td>DIRECT PAY</td>
      </tr>
    </tbody>
  </table>

  <p style="margin-top: 30px; margin-bottom: 10px;">Please clip your card below and use for your store tax exempt purchases.</p>

  <div style="text-align: center; margin-bottom: 30px;">
    <p>Your Home Depot Tax ID Card</p>
    <div style="border: 1px solid #000; padding: 10px; display: inline-block;">
      <div style="text-align: center;">
        <p>5511616</p>
      </div>
    </div>
    <p style="margin-top: 10px; font-size: 10pt;">Please present this card to the cashier each time you make a tax exempt purchase</p>
  </div>

  <p style="margin-bottom: 20px;">If you have any questions about Home Depot Tax Exemption, please call The Home Depot Tax Department at <span data-field="tax_dept_phone">{{ tax_dept_phone }}</span> Option 4, Option 6.</p>

  <table style="width: 100%;">
    <tr>
      <td style="width: 50%; vertical-align: top;">Mailing Address:</td>
      <td style="width: 50%; vertical-align: top;">Fax number: (<span data-field="fax_number">{{ fax_number }}</span>)</td>
    </tr>
    <tr>
      <td style="padding-left: 50px;">PO BOX 105799<br>ATLANTA, GA 30348-5799</td>
      <td style="padding-left: 50px;"></td>
    </tr>
  </table>

  <p style="margin-top: 50px; font-size: 10pt;">Home Depot Tax Id: <span data-field="tax_id_footer">{{ tax_id_footer }}</span> Aug 9, 2018</p>
</div>