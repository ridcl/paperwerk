<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif; }
  h1, h2 { text-align: center; margin-bottom: 10px; }
  .header-section { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px; }
  .logo-area img { max-width: 100px; height: auto; }
  .form-section { margin-bottom: 25px; }
  .form-row { display: flex; margin-bottom: 15px; }
  .form-row > div { flex: 1; padding-right: 20px; }
  .form-row > div:last-child { padding-right: 0; }
  .label-col { flex: 1; font-weight: bold; }
  .input-col { flex: 2; border-bottom: 1px solid #000; }
  table { width: 100%; border-collapse: collapse; margin-top: 15px; }
  th, td { border: 1px solid #000; padding: 8px; text-align: left; }
  th { background-color: #f0f0f0; }
  .signature-line { margin-top: 50px; display: flex; justify-content: space-between; }
  .signature-block { width: 45%; }
  .signature-block p { margin-top: 50px; border-top: 1px solid #000; padding-top: 5px; }
</style>
<div class="page">
  <div class="header-section">
    <div class="logo-area">
      <!-- Placeholder for University Seal/Logo -->
      <img src="" alt="University Seal">
    </div>
    <div>
      <h1>VIRGINIA STATE UNIVERSITY</h1>
      <h2>GUEST ACCOUNT REQUEST FORM</h2>
    </div>
  </div>

  <div class="form-section">
    <h3>APPLICANT INFORMATION (PRINT CLEARLY)</h3>
    <p style="font-size: small;">Instructions available at <a href="http://www.vsu.edu/technology-services/forms.php">http://www.vsu.edu/technology-services/forms.php</a></p>

    <div class="form-row">
      <div class="label-col">Full Name (Last, First, Middle Initial)</div>
      <div class="input-col"><span data-field="full_name">{{ full_name }}</span></div>
    </div>

    <div class="form-row">
      <div class="label-col">Email Address</div>
      <div class="input-col"><span data-field="email_address">{{ email_address }}</span></div>
    </div>

    <div class="form-row">
      <div class="label-col">Company Name</div>
      <div class="input-col"><span data-field="company_name">{{ company_name }}</span></div>
    </div>

    <div class="form-row">
      <div class="label-col">Telephone Number</div>
      <div class="input-col"><span data-field="phone_number">{{ phone_number }}</span></div>
    </div>

    <div class="form-row">
      <div class="label-col">Company Location</div>
      <div class="input-col"><span data-field="company_location">{{ company_location }}</span></div>
    </div>

    <div class="form-row">
      <div class="label-col">Duration of Access (REQUIRED):</div>
      <div style="display: flex; flex-direction: column; flex: 2;">
        <div style="margin-bottom: 10px;">Start Date: <span data-field="duration_start_date">{{ duration_start_date }}</span></div>
        <div>End Date: <span data-field="duration_end_date">{{ duration_end_date }}</span></div>
      </div>
    </div>

    <div class="form-row">
      <div class="label-col">Reason for Access:</div>
      <div class="input-col" style="border-bottom: 1px solid #000; height: 50px;" data-field="reason_for_access">{{ reason_for_access }}</div>
    </div>
  </div>

  <div class="form-section">
    <h3>ACCOUNT(S) REQUESTED</h3>
    <table>
      <thead>
        <tr>
          <th style="width: 20%;">Type of Account</th>
          <th style="width: 15%;">New</th>
          <th style="width: 15%;">Modify</th>
          <th style="width: 50%;">Additional Information</th>
        </tr>
      </thead>
      <tbody>
        <!-- Example row structure, assuming this section might have multiple entries if the layout implied it, but based on the image, it looks like a single entry template -->
        <tr>
          <td><span data-field="account_type">{{ account_type }}</span> (AD)</td>
          <td><input type="checkbox"></td>
          <td><input type="checkbox"></td>
          <td><span data-field="account_details">{{ account_details }}</span></td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="form-section">
    <h3>AUTHORIZATION</h3>
    <p style="font-size: small;">By signing this form, you agree to comply with the VSU Password Management Policy (6320), Acceptable Use Policy (6115), IT Security Policy (6110) and all other related University and Commonwealth policies. VSU Policies are available on the VSU website (http://www.vsu.edu). If this form is not fully completed with all approval authorizations, this will delay processing of your account request until the form is fully completed.</p>
    <p style="font-size: small;">Vendors are required to provide proof of a recent successful background investigation.</p>

    <div class="signature-line">
      <div class="signature-block">
        Applicant Signature: _________________________
        <p>Date: <span data-field="applicant_signature_date">{{ applicant_signature_date }}</span></p>
      </div>
      <div class="signature-block">
        VSU Department Manager Name (PRINT): <span data-field="dept_manager_name">{{ dept_manager_name }}</span>
        <p>Date: <span data-field="dept_manager_date">{{ dept_manager_date }}</span></p>
      </div>
    </div>

    <div class="signature-line" style="margin-top: 30px;">
      <div class="signature-block">
        VSU Department Manager Signature: _________________________
        <p>Date: <span data-field="dept_manager_signature_date">{{ dept_manager_signature_date }}</span></p>
      </div>
      <div class="signature-block">
        System Owner Name (PRINT): <span data-field="system_owner_name">{{ system_owner_name }}</span>
        <p>Date: <span data-field="system_owner_date">{{ system_owner_date }}</span></p>
      </div>
    </div>

    <div class="signature-line" style="margin-top: 30px;">
      <div class="signature-block">
        System Owner Signature: _________________________
        <p>Date: <span data-field="system_owner_signature_date">{{ system_owner_signature_date }}</span></p>
      </div>
      <!-- Empty space or continuation -->
    </div>

    <p style="font-size: small; margin-top: 50px;">Completed form may be faxed to 524-5228, mailed to Box 9090, hand-delivered to Room B45 in Johnston Memorial Library, or emailed to <span data-field="submission_email">{{ submission_email }}</span>.</p>
  </div>

  <div style="text-align: right; margin-top: 50px; font-size: small;">
    Virginia State University &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Revised 03/2015
  </div>
</div>