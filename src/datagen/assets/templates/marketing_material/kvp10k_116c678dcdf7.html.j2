<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic layout structure */
  body { font-family: "Liberation Sans", "DejaVu Sans", Arial, sans-serif; }
  h1, h2, h3 { margin-top: 0; }
  .header-logo { float: left; }
  .header-info { float: right; text-align: right; }
  .content-section { margin-top: 30px; }
  .contact-info { margin-top: 20px; }
</style>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
        <div class="header-logo">
            <!-- Placeholder for Loyola University Chicago Logo -->
            <img src="" alt="Logo" style="height: 60px;">
            <p style="font-size: 10px; margin-top: 5px;">Preparing people to lead extraordinary lives</p>
        </div>
        <div class="header-info">
            <span style="font-weight: bold;">TRANSAMERICA</span>
        </div>
    </div>

    <div class="content-section" style="margin-top: 40px;">
        <h1 style="font-size: 24px; font-weight: bold;">Schedule a FREE Phone Meeting to discuss your retirement plan.</h1>
    </div>

    <div class="content-section" style="display: flex; align-items: center; margin-top: 40px;">
        <div style="margin-right: 30px;">
            <!-- Placeholder for Profile Picture -->
            <img src="" alt="Profile" style="width: 120px; height: 120px; border-radius: 5px;">
        </div>
        <div>
            <h2 style="font-size: 20px; font-weight: bold;">{{ full_name }}</h2>
            <p style="font-size: 16px; margin: 5px 0;">Retirement Planning Consultant (RPC)</p>
        </div>
    </div>

    <div class="contact-info" style="margin-top: 30px;">
        <p>EMAIL: <span data-field="email">{{ email }}</span></p>
        <p>CALL: <span data-field="phone">{{ phone }}</span></p>
    </div>

    <div class="content-section" style="display: flex; margin-top: 40px;">
        <div style="flex: 1; padding-right: 40px;">
            <h3 style="font-size: 16px; font-weight: bold;">SCHEDULE FROM YOUR PHONE:</h3>
            <p style="font-size: 14px;">To make an appointment, scan the QR code using your phone's camera or scanning app.</p>
        </div>
        <div style="flex-shrink: 0;">
            <!-- Placeholder for QR Code -->
            <img src="" alt="QR Code" style="width: 150px; height: 150px;">
        </div>
    </div>

    <div class="content-section" style="margin-top: 50px; font-size: 12px; line-height: 1.5;">
        <p>Retirement planning consultants are registered representatives of <span data-field="employer.name">{{ employer.name }}</span>, member FINRA, 440 Mainstreet Avenue, Houston, TX 77002.</p>
        <p>Investment advisory services are offered through <span data-field="employer.advisory_name">{{ employer.advisory_name }}</span>, registered investment advisor.</p>
    </div>
</div>