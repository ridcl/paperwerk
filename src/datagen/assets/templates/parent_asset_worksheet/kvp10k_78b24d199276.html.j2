<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif; }
  h1, h2 { font-weight: bold; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 10px; }
  .form-label { flex-basis: 30%; }
  .form-input { flex-basis: 65%; border-bottom: 1px solid #000; }
  .section-header { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
  .line-item-table { width: 100%; border-collapse: collapse; margin-top: 10px; }
  .line-item-table td { padding: 5px 0; }
  .signature-line { margin-top: 50px; display: flex; justify-content: space-between; }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px;">
    <div>
      <h1 style="font-size: 24pt; margin: 0;">Office of Student Financial Assistance</h1>
      <h2 style="font-size: 18pt; margin-top: 5px;">PARENT ASSET WORKSHEET</h2>
      <h3 style="font-size: 16pt; margin-top: 5px;">DEPENDENT</h3>
    </div>
    <div style="text-align: right;">
      <h2 style="font-size: 18pt; margin: 0;">ACADEMIC YEAR</h2>
      <h1 style="font-size: 24pt; margin: 0;">2020-2021</h1>
    </div>
  </div>

  <div style="margin-bottom: 30px;">
    <div class="form-row">
      <div class="form-label">Student's Name:</div>
      <div class="form-input"><span data-field="student_name">{{ student_name }}</span></div>
    </div>
    <div class="form-row">
      <div class="form-label">Address:</div>
      <div class="form-input"><span data-field="student_address">{{ student_address }}</span></div>
    </div>
    <div class="form-row">
      <div class="form-label">City:</div>
      <div class="form-input"><span data-field="student_city">{{ student_city }}</span></div>
    </div>
    <div class="form-row">
      <div class="form-label">Parent's Name(s):</div>
      <div class="form-input"><span data-field="parent_names">{{ parent_names }}</span></div>
    </div>
  </div>

  <div style="margin-bottom: 30px; font-size: 11pt;">
    <p>Complete every question in this worksheet to report the value and debt of assets as of the <span data-field="date_of_assessment">{{ date_of_assessment }}</span> you first completed the FAFSA. Do not leave any answer blank. If the tax return indicates the existence of an asset such as interest, dividends, capital gains, rental real estate, partnerships, and S corporations, and you report a $0 value, please provide a written explanation below.</p>
  </div>

  <!-- CASH, SAVINGS, AND CHECKING ACCOUNTS -->
  <div class="section-header">CASH, SAVINGS, AND CHECKING ACCOUNTS:</div>
  <div class="form-row" style="margin-top: 5px;">
    <div class="form-label" style="flex-basis: 20%;">VALUE</div>
    <div class="form-input" style="flex-basis: 20%; text-align: right;"><span data-field="cash_savings_value">{{ cash_savings_value }}</span></div>
    <div class="form-label" style="flex-basis: 20%;">DEBT</div>
    <div class="form-input" style="flex-basis: 20%; text-align: right;"><span data-field="cash_savings_debt">{{ cash_savings_debt }}</span></div>
  </div>

  <!-- REAL ESTATE -->
  <div class="section-header" style="margin-top: 30px;">REAL ESTATE:</div>
  <div class="form-row" style="margin-top: 5px;">
    <div class="form-label" style="flex-basis: 20%;">Value:</div>
    <div class="form-input" style="flex-basis: 20%; text-align: right;"><span data-field="real_estate_value">{{ real_estate_value }}</span></div>
    <div class="form-label" style="flex-basis: 20%;">Debt:</div>
    <div class="form-input" style="flex-basis: 20%; text-align: right;"><span data-field="real_estate_debt">{{ real_estate_debt }}</span></div>
  </div>

  <div style="margin-top: 15px; font-size: 10pt;">
    <p> (Ex: land, rental property, second and summer homes. DO NOT INCLUDE THE HOME YOU LIVE IN)</p>
    <div class="form-row" style="margin-top: 10px;">
      <div class="form-label" style="flex-basis: 50%;">Was rental property sold/foreclosed?</div>
      <div style="flex-basis: 50%; display: flex; gap: 20px;">
        <label><input type="radio" name="sold_foreclosed" value="yes"> Yes</label>
        <label><input type="radio" name="sold_foreclosed" value="no"> No</label>
      </div>
    </div>
  </div>

  <div style="margin-top: 20px;">
    <div class="form-row">
      <div class="form-label" style="flex-basis: 50%;">Was the rental property(s) listed on your parent's Schedule E?</div>
      <div style="flex-basis: 50%; display: flex; gap: 20px;">
        <label><input type="radio" name="schedule_e" value="yes"> Yes</label>
        <label><input type="radio" name="schedule_e" value="no"> No</label>
      </div>
    </div>
    <div class="form-row">
      <div class="form-label" style="flex-basis: 50%;">When?</div>
      <div class="form-input" style="flex-basis: 50%;"><span data-field="rental_property_date">{{ rental_property_date }}</span></div>
    </div>
  </div>

  <!-- INVESTMENTS -->
  <div class="section-header" style="margin-top: 30px;">INVESTMENTS:</div>
  <div class="form-row" style="margin-top: 5px;">
    <div class="form-label" style="flex-basis: 20%;">Value:</div>
    <div class="form-input" style="flex-basis: 20%; text-align: right;"><span data-field="investments_value">{{ investments_value }}</span></div>
    <div class="form-label" style="flex-basis: 20%;">Debt:</div>
    <div class="form-input" style="flex-basis: 20%; text-align: right;"><span data-field="investments_debt">{{ investments_debt }}</span></div>
  </div>
  <div style="font-size: 10pt; margin-top: 5px;">
    <p>(Ex: Qualified tuition plans such as Florida Prepaid and 529s, CDs, trusts, mutual funds, stocks, bonds, Education IRAs, S corporations, partnerships, etc.)</p>
  </div>

  <!-- BUSINESS -->
  <div class="section-header" style="margin-top: 30px;">BUSINESS:</div>
  <div class="form-row" style="margin-top: 5px;">
    <div class="form-label" style="flex-basis: 20%;">Value:</div>
    <div class="form-input" style="flex-basis: 20%; text-align: right;"><span data-field="business_value">{{ business_value }}</span></div>
    <div class="form-label" style="flex-basis: 20%;">Debt:</div>
    <div class="form-input" style="flex-basis: 20%; text-align: right;"><span data-field="business_debt">{{ business_debt }}</span></div>
  </div>
  <div style="font-size: 10pt; margin-top: 5px;">
    <p>(Ex: land, buildings, inventories, equipment, machinery, etc. Note: Do not report small businesses that you or your parent(s) own and control that has 100 or fewer full time or full time equivalent employees.)</p>
  </div>

  <!-- FARM INVESTMENT -->
  <div class="section-header" style="margin-top: 30px;">FARM INVESTMENT:</div>
  <div class="form-row" style="margin-top: 5px;">
    <div class="form-label" style="flex-basis: 20%;">Value:</div>
    <div class="form-input" style="flex-basis: 20%; text-align: right;"><span data-field="farm_investment_value">{{ farm_investment_value }}</span></div>
    <div class="form-label" style="flex-basis: 20%;">Debt:</div>
    <div class="form-input" style="flex-basis: 20%; text-align: right;"><span data-field="farm_investment_debt">{{ farm_investment_debt }}</span></div>
  </div>
  <div style="font-size: 10pt; margin-top: 5px;">
    <p>(Ex: livestock, machinery, land, buildings, equipment, etc.)</p>
    <div class="form-row" style="margin-top: 10px;">
      <div class="form-label" style="flex-basis: 50%;">Does the family live on a farm?</div>
      <div style="flex-basis: 50%; display: flex; gap: 20px;">
        <label><input type="radio" name="farm_residence" value="yes"> Yes</label>
        <label><input type="radio" name="farm_residence" value="no"> No</label>
      </div>
    </div>
  </div>

  <!-- EXPLANATION -->
  <div class="section-header" style="margin-top: 30px;">Explanation</div>
  <div style="border: 1px solid #000; height: 150px; margin-top: 10px; padding: 10px;">
    <div class="form-input" style="height: 100%; border: none; width: 100%; resize: none;">
      <span data-field="explanation_text">{{ explanation_text }}</span>
    </div>
  </div>

  <!-- SIGNATURES -->
  <div class="signature-line">
    <div>
      <div style="font-weight: bold;">Parent 1 (father, mother, stepparent)</div>
      <div style="margin-top: 50px; border-top: 1px solid #000; width: 200px; text-align: center;"><span data-field="parent1_signature_line">{{ parent1_signature_line }}</span></div>
      <div style="margin-top: 10px;">Date: <span data-field="parent1_date">{{ parent1_date }}</span></div>
    </div>
    <div>
      <div style="font-weight: bold;">Parent 2 (father, mother, stepparent)</div>
      <div style="margin-top: 50px; border-top: 1px solid #000; width: 200px; text-align: center;"><span data-field="parent2_signature_line">{{ parent2_signature_line }}</span></div>
      <div style="margin-top: 10px;">Date: <span data-field="parent2_date">{{ parent2_date }}</span></div>
    </div>
  </div>

  <!-- FOOTER -->
  <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 20px 60px; font-size: 9pt; text-align: center;">
    <p style="margin: 0;">Office of Student Financial Assistance • Millican Hall, Room 107 • Orlando, FL 32816-0113</p>
    <p style="margin: 5px 0 0 0;">Phone: <span data-field="phone_number">{{ phone_number }}</span> • Fax: <span data-field="fax_number">{{ fax_number }}</span> • Web: <span data-field="website_url">{{ website_url }}</span> | a division of Student Development and Enrollment Services</p>
    <p style="margin-top: 10px;">An Equal Opportunity and Affirmative Action Institution</p>
  </div>
</div>