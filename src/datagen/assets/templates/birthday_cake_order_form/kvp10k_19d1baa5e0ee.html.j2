<style>
    @page { size: A4; margin: 0; }
    .page {
        width: 794px; height: 1123px;
        padding: 50px 60px; box-sizing: border-box;
        overflow: hidden; page-break-after: always;
        position: relative;
        font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
    }
    .page:last-child { page-break-after: auto; }
    .form-row { display: flex; justify-content: space-between; margin-bottom: 15px; }
    .form-group { display: flex; flex-direction: column; }
    .label { font-weight: bold; margin-bottom: 5px; }
    .input-line { border-bottom: 1px solid #000; padding-bottom: 2px; }
    .section-header { font-weight: bold; margin-top: 20px; margin-bottom: 10px; border-bottom: 1px solid #000; padding-bottom: 5px; }
    .divider { border-top: 1px solid #000; margin: 20px 0; }
</style>
<div class="page">
    <div style="text-align: center; margin-bottom: 30px;">
        <h1>RHA</h1>
        <h2>Birthday Cake Order Form</h2>
    </div>

    <div class="form-row" style="margin-bottom: 30px;">
        <div style="width: 50%;">
            <div class="form-group">
                <div class="label">Today's Date:</div>
                <div class="input-line" data-field="today_s_date">{{ today_s_date }}</div>
            </div>
        </div>
        <div style="width: 50%; text-align: right;">
            <div class="form-group">
                <div class="label">Price per Cake: $26.50</div>
                <div class="input-line" style="width: 200px; margin-left: auto;">(Use 1 sheet per order)</div>
            </div>
        </div>
    </div>

    <div class="section-header">Person Placing Order Information</div>
    <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
        <div style="width: 48%;">
            <div class="form-group">
                <div class="label">Person Placing Order:</div>
                <div class="input-line" data-field="person_placing_order">{{ person_placing_order }}</div>
            </div>
        </div>
        <div style="width: 48%;">
            <div class="form-group">
                <div class="label">Contact Number:</div>
                <div class="input-line" data-field="contact_number">{{ contact_number }}</div>
            </div>
        </div>
    </div>

    <div class="section-header">Student Information</div>
    <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
        <div style="width: 48%;">
            <div class="form-group">
                <div class="label">Student Name:</div>
                <div class="input-line" data-field="student_name">{{ student_name }}</div>
            </div>
        </div>
        <div style="width: 48%;">
            <div class="form-group">
                <div class="label">Contact Number:</div>
                <div class="input-line" data-field="contact_number_2">{{ contact_number_2 }}</div>
            </div>
        </div>
    </div>

    <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
        <div style="width: 48%;">
            <div class="form-group">
                <div class="label">Birthdate:</div>
                <div class="input-line" data-field="birthdate">{{ birthdate }}</div>
            </div>
        </div>
        <div style="width: 48%;">
            <div class="form-group">
                <div class="label">Date to be Delivered:</div>
                <div class="input-line" data-field="date_to_be_delivered">{{ date_to_be_delivered }}</div>
            </div>
        </div>
    </div>

    <div style="display: flex; justify-content: space-between; margin-bottom: 30px;">
        <div style="width: 48%;">
            <div class="form-group">
                <div class="label">Residence Hall:</div>
                <div class="input-line" data-field="residence_hall">{{ residence_hall }}</div>
            </div>
        </div>
        <div style="width: 48%;">
            <div class="form-group">
                <div class="label">Room Number:</div>
                <div class="input-line" data-field="room_number">{{ room_number }}</div>
            </div>
        </div>
    </div>

    <div class="section-header">Cake Information</div>
    <div style="margin-bottom: 20px;">
        <div class="form-group" style="margin-bottom: 15px;">
            <div class="label">Message on Cake:</div>
            <div class="input-line" style="width: 80%;" data-field="message_on_cake">{{ message_on_cake }}</div>
        </div>
    </div>

    <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
        <div style="width: 48%;">
            <div class="form-group">
                <div class="label">Type of Cake: (please check one box)</div>
                <div style="display: flex; align-items: center; margin-top: 5px;">
                    <label style="margin-right: 15px;">Chocolate</label>
                    <input type="checkbox" style="margin-right: 5px;">
                    <label style="margin-right: 15px;">Swirl</label>
                    <input type="checkbox" style="margin-right: 5px;">
                </div>
            </div>
        </div>
        <div style="width: 48%;">
            <div class="form-group">
                <div class="label">Additional Information: (optional)</div>
                <div class="input-line" style="width: 80%;" data-field="additional_information">{{ additional_information }}</div>
            </div>
        </div>
    </div>

    <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
        <div style="width: 48%;">
            <div class="form-group">
                <div class="label">Type of Icing: (please check one box)</div>
                <div style="display: flex; align-items: center; margin-top: 5px;">
                    <label style="margin-right: 15px;">Vanilla</label>
                    <input type="checkbox" style="margin-right: 5px;">
                    <label style="margin-right: 15px;">Chocolate</label>
                    <input type="checkbox" style="margin-right: 5px;">
                </div>
            </div>
        </div>
        <div style="width: 48%;">
            <div class="form-group">
                <div class="label"></div>
                <div class="input-line" style="width: 80%;" data-field="chocolate">{{ chocolate }}</div>
            </div>
        </div>
    </div>

    <div style="display: flex; justify-content: space-between; margin-bottom: 30px;">
        <div style="width: 48%;">
            <div class="form-group">
                <div class="label">Type of Writing: (please check one box)</div>
                <div style="display: flex; align-items: center; margin-top: 5px;">
                    <label style="margin-right: 15px;">Vanilla</label>
                    <input type="checkbox" style="margin-right: 5px;">
                    <label style="margin-right: 15px;">Chocolate</label>
                    <input type="checkbox" style="margin-right: 5px;">
                </div>
            </div>
        </div>
        <div style="width: 48%; text-align: right;">
            <div style="display: flex; justify-content: flex-end; margin-top: 20px;">
                <button style="padding: 10px 20px; border: 1px solid #000; background-color: #eee;">Submit</button>
            </div>
        </div>
    </div>

    <div class="divider"></div>

    <div class="section-header">RHA Information</div>
    <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
        <div style="width: 48%;">
            <div class="form-group">
                <div class="label">Order Submitted By:</div>
                <div class="input-line" data-field="order_submitted_by">{{ order_submitted_by }}</div>
            </div>
        </div>
        <div style="width: 48%; text-align: right;">
            <div class="form-group">
                <div class="label">Date:</div>
                <div class="input-line" data-field="date">{{ date }}</div>
            </div>
        </div>
    </div>

    <div style="display: flex; justify-content: space-between; margin-bottom: 30px;">
        <div style="width: 48%;">
            <div class="form-group">
                <div class="label">Name</div>
                <div class="input-line" data-field="name">{{ name }}</div>
            </div>
        </div>
        <div style="width: 48%;">
            <!-- Placeholder for potential second column content if needed, currently empty -->
        </div>
    </div>
</div>

<div class="page">
    <div style="text-align: center; margin-bottom: 30px;">
        <h2>Placed Order to Bakery:</h2>
    </div>
    <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
        <div style="width: 48%;">
            <div class="form-group">
                <div class="label">Name</div>
                <div class="input-line" data-field="name_2">{{ name_2 }}</div>
            </div>
        </div>
        <div style="width: 48%; text-align: right;">
            <div class="form-group">
                <div class="label">Date:</div>
                <div class="input-line" data-field="date_2">{{ date_2 }}</div>
            </div>
        </div>
    </div>

    <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
        <div style="width: 48%;">
            <div class="form-group">
                <div class="label">Order Picked Up By:</div>
                <div class="input-line" data-field="order_picked_up_by">{{ order_picked_up_by }}</div>
            </div>
        </div>
        <div style="width: 48%; text-align: right;">
            <div class="form-group">
                <div class="label">Date:</div>
                <div class="input-line" data-field="date_3">{{ date_3 }}</div>
            </div>
        </div>
    </div>

    <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
        <div style="width: 48%;">
            <div class="form-group">
                <div class="label">Order Delivered By:</div>
                <div class="input-line" data-field="order_delivered_by">{{ order_delivered_by }}</div>
            </div>
        </div>
        <div style="width: 48%; text-align: right;">
            <div class="form-group">
                <div class="label">Date Delivered:</div>
                <div class="input-line" data-field="date_delivered">{{ date_delivered }}</div>
            </div>
        </div>
    </div>

    <div style="display: flex; justify-content: space-between; margin-bottom: 30px;">
        <div style="width: 48%;">
            <div class="form-group">
                <div class="label">Name</div>
                <div class="input-line" data-field="name_3">{{ name_3 }}</div>
            </div>
        </div>
        <div style="width: 48%; text-align: right;">
            <div class="form-group">
                <div class="label">Payment Received</div>
                <div class="input-line" data-field="payment_received">{{ payment_received }}</div>
            </div>
        </div>
    </div>

    <div style="margin-top: 40px; font-size: 0.9em;">
        <p>Please make all checks made payable to RHA (note on memo: Birthday Cake and Student's Name)</p>
        <p>Mail to Methodist University, Housing Residence Life, 5400 Ramsey St., Fayetteville, NC 28311-1498</p>
    </div>
</div>