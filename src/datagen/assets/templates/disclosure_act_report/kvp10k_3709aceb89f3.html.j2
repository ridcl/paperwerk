      </tr>
      <tr>
        <td>14 Grand Total Revenues (Lines 12+13)</td>
        <td style="text-align: right;"><span data-field="summary_grand_total_revenues_men">{{ summary_grand_total_revenues_men }}</span></td>
        <td style="text-align: right;"><span data-field="summary_grand_total_revenues_women">{{ summary_grand_total_revenues_women }}</span></td>
        <td style="text-align: right;"><span data-field="summary_grand_total_revenues_total">{{ summary_grand_total_revenues_total }}</span></td>
      </tr>
      <tr>
        <td>15 Total Revenues for Teams Minus Total Expenses for Teams (Line 12 - Line 8)</td>
        <td style="text-align: right;"><span data-field="summary_net_revenue_men">{{ summary_net_revenue_men }}</span></td>
        <td style="text-align: right;"><span data-field="summary_net_revenue_women">{{ summary_net_revenue_women }}</span></td>
        <td style="text-align: right;"><span data-field="summary_net_revenue_total">{{ summary_net_revenue_total }}</span></td>
