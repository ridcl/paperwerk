  </table>
  <div style="margin-top: 50px;">
    <p style="font-size: 0.8em;">To return to a data entry screen, click on the link in the <span data-field="navigation_menu_link">{{ navigation_menu_link }}</span>.</p>
    <p style="font-size: 0.8em;">To proceed to the Supplemental Information screen, click on the <span data-field="next_button_link">{{ next_button_link }}</span> on this screen.</p>
  </div>
</div>

<div class="page">
  <div class="header">Supplemental Information (optional)</div>
  <p style="font-size: 0.9em; margin-bottom: 20px;">
    This screen may be used to help the reader better understand the data you have provided, or to help a prospective
    student-athlete make an informed choice of an athletic program. Please do not include the names of individuals or write
    messages to the help desk.
  </p>
  <p style="font-size: 0.9em; margin-bottom: 20px;">
    To explain specific data entered on a previous screen, please use the caveat box on that screen.
  </p>
  <div style="height: 150px; border: 1px solid #ccc; padding: 10px; margin-top: 20px;">
    <!-- Text area placeholder -->
  </div>
</div>

<div class="page">
  <div class="header">Identification</div>
  <p style="font-size: 0.9em; margin-bottom: 20px;">
    *Please enter/review all applicable information. Required fields are indicated with asterisks (*).
  </p>
  <table style="width: 100%;">
    <tr>
      <td style="width: 20%; vertical-align: top;">General Information</td>
      <td style="width: 80%;"></td>
    </tr>
    <tr>
      <td style="width: 20%; vertical-align: top;">Institution Name *</td>
      <td style="width: 80%;"><span data-field="institution_name_input">{{ institution_name_input }}</span></td>
    </tr>
    <tr>
      <td style="width: 20%; vertical-align: top;">Address 1 *</td>
      <td style="width: 80%;"><span data-field="address1_input">{{ address1_input }}</span></td>
    </tr>
    <tr>
      <td style="width: 20%; vertical-align: top;">Address 2</td>
      <td style="width: 80%;"><span data-field="address2_input">{{ address2_input }}</span></td>
    </tr>
    <tr>
      <td style="width: 20%; vertical-align: top;">City</td>
      <td style="width: 80%;"><span data-field="city_input">{{ city_input }}</span></td>
    </tr>
    <tr>
      <td style="width: 20%; vertical-align: top;">State *</td>
      <td style="width: 80%;"><span data-field="state_input">{{ state_input }}</span></td>
    </tr>
    <tr>
      <td style="width: 20%; vertical-align: top;">ZIP Code *</td>
      <td style="width: 80%;"><span data-field="zip_code_input">{{ zip_code_input }}</span></td>
    </tr>
    <tr>
      <td style="width: 20%; vertical-align: top;">Telephone *</td>
      <td style="width: 80%;"><span data-field="telephone_input">{{ telephone_input }}</span></td>
    </tr>
  </table>

  <table style="width: 100%; margin-top: 30px;">
    <tr>
      <td style="width: 20%; vertical-align: top;">Athletic Department</td>
      <td style="width: 80%;"></td>
    </tr>
    <tr>
      <td style="width: 20%; vertical-align: top;">Athletic Director Name *</td>
      <td style="width: 80%;"><span data-field="athletic_director_name_input">{{ athletic_director_name_input }}</span></td>
    </tr>
    <tr>
      <td style="width: 20%; vertical-align: top;">Address 1 *</td>
      <td style="width: 80%;"><span data-field="athletic_address1_input">{{ athletic_address1_input }}</span></td>
    </tr>
    <tr>
      <td style="width: 20%; vertical-align: top;">Address 2</td>
      <td style="width: 80%;"><span data-field="athletic_address2_input">{{ athletic_address2_input }}</span></td>
    </tr>
    <tr>
      <td style="width: 20%; vertical-align: top;">City</td>
      <td style="width: 80%;"><span data-field="athletic_city_input">{{ athletic_city_input }}</span></td>
    </tr>
    <tr>
      <td style="width: 20%; vertical-align: top;">State *</td>
      <td style="width: 80%;"><span data-field="athletic_state_input">{{ athletic_state_input }}</span></td>
    </tr>
    <tr>
      <td style="width: 20%; vertical-align: top;">ZIP Code *</td>
      <td style="width: 80%;"><span data-field="athletic_zip_code_input">{{ athletic_zip_code_input }}</span></td>
    </tr>
    <tr>
      <td style="width: 20%; vertical-align: top;">Telephone *</td>
      <td style="width: 80%;"><span data-field="athletic_telephone_input">{{ athletic_telephone_input }}</span></td>
    </tr>
  </table>

  <table style="width: 100%; margin-top: 30px;">
    <tr>
      <td style="width: 20%; vertical-align: top;">Chief Administrative Officer</td>
      <td style="width: 80%;"></td>
    </tr>
    <tr>
      <td style="width: 20%; vertical-align: top;">Chief Administrative Officer's Name *</td>
      <td style="width: 80%;"><span data-field="cao_name_input">{{ cao_name_input }}</span></td>
    </tr>
    <tr>
      <td style="width: 20%; vertical-align: top;">Title</td>
      <td style="width: 80%;"><span data-field="cao_title_input">{{ cao_title_input }}</span></td>
    </tr>
    <tr>
      <td style="width: 20%; vertical-align: top;">Telephone *</td>
      <td style="width: 80%;"><span data-field="cao_telephone_input">{{ cao_telephone_input }}</span></td>
    </tr>
    <tr>
      <td style="width: 20%; vertical-align: top;">Fax</td>
      <td style="width: 80%;"><span data-field="cao_fax_input">{{ cao_fax_input }}</span></td>
    </tr>
    <tr>
      <td style="width: 20%; vertical-align: top;">E-mail Address *</td>
      <td style="width: 80%;"><span data-field="cao_email_input">{{ cao_email_input }}</span></td>
    </tr>
  </table>
</div>

<div class="page">
  <div class="header">EADA General</div>
  <p style="font-size: 0.9em; margin-bottom: 20px;">
    Designated Reporting Year
    <br>
    Note: The reporting period must be 12 months. The dates for the reporting year should be consistent from year to year.
    <br>
    Note: All data entered by graduates by gender must be entered in the numbers below were reported on your institution's 2016-17 IPEDS Survey and should not be changed unless they were reported incorrectly to IPEDS. If the numbers are incorrect, please call the EADA Help Desk to correct them.
  </p>
  <table style="width: 100%;">
    <tr>
      <td style="width: 20%; vertical-align: top;">Begins: (MM/DD)</td>
      <td style="width: 20%;"><span data-field="reporting_start_month">{{ reporting_start_month }}</span>/<span data-field="reporting_start_day">{{ reporting_start_day }}</span></td>
      <td style="width: 20%; vertical-align: top;">Ends: (MM/DD)</td>
      <td style="width: 20%;"><span data-field="reporting_end_month">{{ reporting_end_month }}</span>/<span data-field="reporting_end_day">{{ reporting_end_day }}</span></td>
    </tr>
  </table>

  <table style="width: 100%; margin-top: 30px;">
    <thead>
      <tr>
        <th style="width: 50%;">Category</th>
        <th style="width: 25%; text-align: right;">Number</th>
        <th style="width: 25%; text-align: right;">Percent</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Male full-time undergraduates</td>
        <td style="text-align: right;"><span data-field="male_undergrad_count">{{ male_undergrad_count }}</span></td>
        <td style="text-align: right;"><span data-field="male_undergrad_percent">{{ male_undergrad_percent }}</span></td>
      </tr>
      <tr>
        <td>Female full-time undergraduates</td>
        <td style="text-align: right;"><span data-field="female_undergrad_count">{{ female_undergrad_count }}</span></td>
        <td style="text-align: right;"><span data-field="female_undergrad_percent">{{ female_undergrad_percent }}</span></td>
      </tr>
      <tr>
        <td>Total full-time undergraduates</td>
        <td style="text-align: right;"><span data-field="total_undergrad_count">{{ total_undergrad_count }}</span></td>
        <td style="text-align: right;"><span data-field="total_undergrad_percent">{{ total_undergrad_percent }}</span></td>
      </tr>
    </tbody>
  </table>

  <table style="width: 100%; margin-top: 30px;">
    <thead>
      <tr>
        <th style="width: 50%;">Athletic Sanctioning Body for the designated reporting year (select one): *</th>
        <th style="width: 25%; text-align: center;"></th>
        <th style="width: 25%; text-align: center;"></th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>NCAA Division I-FBS</td>
        <td style="text-align: center;"><input type="radio" name="sanctioning_body" value="ncaa_i_fbs"></td>
        <td style="text-align: center;"><input type="radio" name="sanctioning_body" value="naia_i"></td>
      </tr>
      <tr>
        <td>NCAA Division I-FCS</td>
        <td style="text-align: center;"><input type="radio" name="sanctioning_body" value="ncaa_i_fcs"></td>
        <td style="text-align: center;"><input type="radio" name="sanctioning_body" value="naia_ii"></td>
      </tr>
      <tr>
        <td>NCAA Division I without football</td>
        <td style="text-align: center;"><input type="radio" name="sanctioning_body" value="ncaa_i_no_fb"></td>
        <td style="text-align: center;"><input type="radio" name="sanctioning_body" value="njcaa_i"></td>
      </tr>
      <tr>
        <td>NCAA Division II with football</td>
        <td style="text-align: center;"><input type="radio" name="sanctioning_body" value="ncaa_ii_fb"></td>
        <td style="text-align: center;"><input type="radio" name="sanctioning_body" value="njcaa_ii"></td>
      </tr>
      <tr>
        <td>NCAA Division II without football</td>
        <td style="text-align: center;"><input type="radio" name="sanctioning_body" value="ncaa_ii_no_fb"></td>
        <td style="text-align: center;"><input type="radio" name="sanctioning_body" value="njcaa_iii"></td>
      </tr>
      <tr>
        <td>NCAA Division III with football</td>
        <td style="text-align: center;"><input type="radio" name="sanctioning_body" value="ncaa_iii_fb"></td>
        <td style="text-align: center;"><input type="radio" name="sanctioning_body" value="nccaa_i"></td>
      </tr>
      <tr>
        <td>NCAA Division III without football</td>
        <td style="text-align: center;"><input type="radio" name="sanctioning_body" value="ncaa_iii_no_fb"></td>
        <td style="text-align: center;"><input type="radio" name="sanctioning_body" value="nccaa_ii"></td>
      </tr>
      <tr>
        <td>CCCAA</td>
        <td style="text-align: center;"><input type="radio" name="sanctioning_body" value="cccaa"></td>
        <td style="text-align: center;"><input type="radio" name="sanctioning_body" value="nwcac"></td>
      </tr>
      <tr>
        <td>Independent</td>
        <td style="text-align: center;"><input type="radio" name="sanctioning_body" value="independent"></td>
        <td style="text-align: center;"><input type="radio" name="sanctioning_body" value="uscaa"></td>
      </tr>
      <tr>
        <td>Other</td>
        <td style="text-align: center;"><input type="radio" name="sanctioning_body" value="other"></td>
        <td style="text-align: center;"></td>
      </tr>
    </tbody>
  </table>

  <div style="margin-top: 30px;">
    <label for="other_description">Other Description:</label>
    <div style="height: 80px; border: 1px solid #ccc; padding: 10px; margin-top: 5px;"></div>
  </div>

  <table style="width: 100%; margin-top: 40px;">
    <tr>
      <td style="width: 20%; vertical-align: top;">Update Status</td>
      <td style="width: 80%;"><span data-field="update_status_value">{{ update_status_value }}</span></td>
    </tr>
  </table>
</div></body>
</html>