<style>
  @page { size: A4; margin: 0; }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; font-size: 12pt; color: #000; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }

  /* Page 1 - CV cover */
  .center-mid {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
  }
  .center-mid h1 {
    font-size: 22pt;
    font-weight: bold;
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
  }

  /* Page 2 - External Review Letters */
  .center-mid-block {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
  }
  .center-mid-block .section-label {
    font-size: 20pt;
    font-weight: bold;
    font-style: italic;
    text-align: center;
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
    max-width: 560px;
    line-height: 1.4;
  }
  .section-label .letter-prefix {
    font-style: italic;
    font-weight: bold;
  }

  /* Page 3 - Unit Peer Committee Recommendation */
  .center-mid-plain {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
  }
  .center-mid-plain h2 {
    font-size: 20pt;
    font-weight: bold;
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
  }

  /* Page 4 - Candidate Response to Unit-Peer */
  .promotion-label {
    font-style: italic;
    font-weight: bold;
    font-size: 11pt;
    margin-bottom: 0;
  }
  .candidate-response-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: calc(100% - 30px);
    text-align: center;
  }
  .candidate-response-block .cr-title {
    font-size: 18pt;
    font-weight: bold;
    font-style: italic;
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
    line-height: 1.5;
  }
  .candidate-response-block .cr-to {
    font-size: 18pt;
    font-weight: bold;
    font-style: italic;
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
    line-height: 1.5;
  }
  .candidate-response-block .cr-subtitle {
    font-size: 18pt;
    font-weight: bold;
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
    line-height: 1.5;
  }

  /* Page 5 - Response Letter Template (Unit-Peer) */
  .warning-box-yellow {
    background-color: #ffff00;
    text-align: center;
    padding: 6px 10px;
    margin-bottom: 8px;
  }
  .warning-box-yellow .warn-title {
    font-size: 14pt;
    font-weight: bold;
    font-family: "Liberation Sans", "DejaVu Sans", Arial, Helvetica, sans-serif;
    text-decoration: underline;
  }
  .warning-box-yellow .warn-sub {
    font-size: 12pt;
    font-weight: bold;
    font-style: italic;
    font-family: "Liberation Sans", "DejaVu Sans", Arial, Helvetica, sans-serif;
    margin-top: 4px;
  }
  .warning-italic-yellow {
    background-color: #ffff00;
    text-align: center;
    padding: 4px 10px;
    margin-bottom: 18px;
  }
  .warning-italic-yellow .warn-italic {
    font-size: 11pt;
    font-weight: bold;
    font-style: italic;
    font-family: "Liberation Sans", "DejaVu Sans", Arial, Helvetica, sans-serif;
  }
  .letter-fields {
    margin-top: 20px;
  }
  .letter-fields .field-row {
    display: flex;
    margin-bottom: 22px;
    font-size: 11pt;
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
  }
  .letter-fields .field-label {
    min-width: 60px;
    font-weight: normal;
  }
  .letter-fields .field-value {
    font-weight: normal;
  }
  .signature-section {
    position: absolute;
    bottom: 90px;
    left: 60px;
    right: 60px;
  }
  .sig-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 18px;
  }
  .sig-block {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .sig-line {
    border-top: 1px solid #000;
    width: 240px;
    margin-bottom: 4px;
  }
  .sig-line-short {
    border-top: 1px solid #000;
    width: 140px;
    margin-bottom: 4px;
  }
  .sig-label {
    font-style: italic;
    font-weight: bold;
    font-size: 11pt;
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
  }
  .sig-name-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 4px;
  }
  .sig-name-line {
    border-top: 1px solid #000;
    width: 240px;
    margin-bottom: 4px;
  }
  .footer-note {
    font-style: italic;
    font-size: 11pt;
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
    margin-top: 8px;
  }
</style>
<style>
  @page { size: A4; margin: 0; }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    background: #fff;
  }
  .page:last-child { page-break-after: auto; }

  /* Cover page styles */
  .cover-center {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
  }
  .cover-title {
    font-size: 26px;
    font-weight: bold;
    text-align: center;
    line-height: 1.4;
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
  }

  /* Section divider page styles */
  .section-label {
    font-style: italic;
    font-weight: bold;
    font-size: 13px;
    margin-bottom: 0;
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
  }
  .section-center {
    display: flex;
    align-items: center;
    justify-content: center;
    height: calc(100% - 30px);
  }
  .section-heading {
    text-align: center;
    font-size: 20px;
    font-weight: bold;
    font-style: italic;
    line-height: 1.5;
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
  }
  .section-heading .to-word {
    font-style: italic;
    font-weight: bold;
    font-size: 20px;
  }
  .section-heading .upper {
    font-style: normal;
    font-weight: bold;
    font-size: 20px;
  }

  /* Instruction page styles */
  .instruction-banner {
    text-align: center;
    font-weight: bold;
    font-size: 16px;
    background-color: #ffff00;
    color: #000;
    margin-bottom: 10px;
    padding: 2px 0;
    font-family: "Liberation Sans", "DejaVu Sans", Arial, Helvetica, sans-serif;
  }
  .instruction-sub {
    text-align: center;
    font-weight: bold;
    font-style: italic;
    font-size: 14px;
    background-color: #ffff00;
    color: #000;
    margin-bottom: 10px;
    padding: 2px 0;
    font-family: "Liberation Sans", "DejaVu Sans", Arial, Helvetica, sans-serif;
  }
  .memo-block {
    margin-top: 36px;
    font-size: 13px;
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
  }
  .memo-row {
    display: flex;
    margin-bottom: 28px;
    align-items: flex-start;
  }
  .memo-label {
    min-width: 60px;
    font-weight: normal;
  }
  .memo-value {
    flex: 1;
  }
  .signature-section {
    position: absolute;
    bottom: 100px;
    left: 60px;
    right: 60px;
  }
  .sig-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 10px;
  }
  .sig-block {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .sig-line {
    border-top: 1px solid #000;
    width: 240px;
    margin-bottom: 4px;
  }
  .sig-line-short {
    border-top: 1px solid #000;
    width: 130px;
    margin-bottom: 4px;
  }
  .sig-label {
    font-weight: bold;
    font-style: italic;
    font-size: 13px;
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
  }
  .printed-name-block {
    margin-top: 18px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .printed-name-line {
    border-top: 1px solid #000;
    width: 240px;
    margin-bottom: 4px;
  }
  .additional-note {
    font-style: italic;
    font-size: 13px;
    margin-top: 10px;
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
  }
</style>
</head>
<body>

<!-- PAGE 1: Cover Page -->
<div class="page">
  <div class="cover-title">
    Full Name: <span data-field="full_name">{{ full_name }}</span>
  </div>

  <hr class="cover-divider">

  <div class="cover-fields">
    <div class="cover-field-line">
      <span>Faculty Title:</span>
      <span class="cover-underline"><span data-field="faculty_title">{{ faculty_title }}</span></span>
    </div>
    <div class="cover-field-line">
      <span>Unit:</span>
      <span class="cover-underline"><span data-field="unit">{{ unit }}</span></span>
    </div>
    <div class="cover-field-line">
      <span>Department:</span>
      <span class="cover-underline"><span data-field="department">{{ department }}</span></span>
    </div>
    <div class="cover-field-line">
      <span>Year:</span>
      <span class="cover-underline"><span data-field="year">{{ year }}</span></span>
    </div>
    <div class="cover-review-type">
      Review Type: <strong>Promotion</strong>
    </div>
  </div>
</div>

<!-- PAGE 2: Materials Checklist -->
<div class="page">
  <div class="checklist-title">PROMOTION</div>
  <div class="checklist-subtitle">Materials Checklist</div>

  <div class="checklist-header-row">
    <div>
      <span class="field-label">Name:</span>&nbsp;
      <span class="checklist-header-underline"><span data-field="checklist_name">{{ checklist_name }}</span></span>
    </div>
    <div>
      <span class="field-label">Department:</span>&nbsp;
      <span class="checklist-header-underline-dept"><span data-field="checklist_department">{{ checklist_department }}</span></span>
    </div>
  </div>

  <div class="sections-label"><em>Sections</em>:</div>

  <!-- Item 1 -->
  <div class="checklist-item">
    <span class="checklist-blank"></span>
    <span class="checklist-num">1.</span>
    <span class="checklist-text">Promotion Checklist Form</span>
  </div>

  <!-- Item 2 -->
  <div class="checklist-item">
    <span class="checklist-blank"></span>
    <span class="checklist-num">2.</span>
    <span class="checklist-text">Summary of Recommendation Form</span>
  </div>

  <!-- Item 3 -->
  <div class="checklist-item">
    <span class="checklist-blank"></span>
    <span class="checklist-num">3.</span>
    <span class="checklist-text">Faculty Senate <span style="text-decoration:underline;">Approved</span> Special Unit Criteria (<em>if applicable)</em></span>
  </div>

  <!-- Item 4 -->
  <div class="checklist-item">
    <span class="checklist-blank"></span>
    <span class="checklist-num">4.</span>
    <span class="checklist-text">Promotion/Tenure Comprehensive Activities Report</span>
  </div>

  <!-- Item 5 -->
  <div class="checklist-item">
    <span class="checklist-blank"></span>
    <span class="checklist-num">5.</span>
    <span class="checklist-text">Self-Evaluation</span>
  </div>

  <!-- Item 6 -->
  <div class="checklist-item">
    <span class="checklist-blank"></span>
    <span class="checklist-num">6.</span>
    <span class="checklist-text">
      Peer, Student and External Evaluations (use cover pages and/or bookmarks)
      <div class="checklist-sub">
        <div class="checklist-sub-item">
          <span class="checklist-sub-blank"></span>
          <span class="checklist-sub-text">Past evaluations. <em>*If applicable, include the MOA from SWLER &amp; UNAC that granted extension to any request for delay/extensions of 4<sup>th</sup> year/pre-tenure, or Promotion.</em></span>
        </div>
        <div class="checklist-sub-item">
          <span class="checklist-sub-blank"></span>
          <span class="checklist-sub-text">Copies of workloads for period of review.</span>
        </div>
        <div class="checklist-sub-item">
          <span class="checklist-sub-blank"></span>
          <span class="checklist-sub-text">Student evaluation (IAS&amp; eXplorance Blue) summaries.</span>
        </div>
        <div class="checklist-sub-item">
          <span class="checklist-sub-blank"></span>
          <span class="checklist-sub-text">Peer evaluation of teaching, if available.</span>
        </div>
        <div class="checklist-sub-item">
          <span class="checklist-sub-blank"></span>
          <span class="checklist-sub-text">Examples of course syllabi.</span>
        </div>
        <div class="checklist-sub-item">
          <span class="checklist-sub-blank"></span>
          <span class="checklist-sub-text">Examples/evidence of research/creative activities.</span>
        </div>
        <div class="checklist-sub-item">
          <span class="checklist-sub-blank"></span>
          <span class="checklist-sub-text">Letters or other external evaluations you have received concerning your service activities</span>
        </div>
        <div class="checklist-sub-item">
          <span class="checklist-sub-blank"></span>
          <span class="checklist-sub-text">Honors, citations and any other letters concerning your performance as a faculty member that you would like to include.&nbsp; Do <span style="text-decoration:underline;">not</span> include here the letters requested by your dean or director; those go in Section 7.</span>
        </div>
        <div class="checklist-sub-item">
          <span class="checklist-sub-blank"></span>
          <span class="checklist-sub-text">Letters of support; miscellaneous.</span>
        </div>
      </div>
    </span>
  </div>

  <!-- Item 7 -->
  <div class="checklist-item">
    <span class="checklist-blank"></span>
    <span class="checklist-num">7.</span>
    <span class="checklist-text">
      a) Curriculum Vitae
    </span>
  </div>
  <div class="checklist-item" style="margin-top:-4px;">
    <span class="checklist-blank"></span>
    <span class="checklist-num"></span>
    <span class="checklist-text">
      b) External Review Letters <em>(if requested by your dean, director or designee for review)</em>
    </span>
  </div>

  <!-- Item 8 -->
  <div class="checklist-item">
    <span class="checklist-blank"></span>
    <span class="checklist-num">8.</span>
    <span class="checklist-text">Unit Peer Committee Recommendation</span>
  </div>

  <!-- Item 9 -->
  <div class="checklist-item">
    <span class="checklist-blank"></span>
    <span class="checklist-num">9.</span>
    <span class="checklist-text">Dean/Director Recommendation</span>
  </div>

  <!-- Item 10 -->
  <div class="checklist-item">
    <span class="checklist-blank"></span>
    <span class="checklist-num">10.</span>
    <span class="checklist-text">University-wide Faculty Review Committee Recommendation</span>
  </div>

  <!-- Item 11 -->
  <div class="checklist-item">
    <span class="checklist-blank"></span>
    <span class="checklist-num">11.</span>
    <span class="checklist-text">Provost Recommendation</span>
  </div>

  <!-- Item 12 -->
  <div class="checklist-item">
    <span class="checklist-blank"></span>
    <span class="checklist-num">12.</span>
    <span class="checklist-text">Chancellor Decision</span>
  </div>
</div>

<!-- PAGE 3: Summary of Recommendation Form -->
<div class="page">
  <div class="section-cover">
    <div class="section-cover-title">Summary of Recommendation Form</div>
  </div>
</div>

<!-- PAGE 4: Faculty Senate Approved Special Unit Criteria -->
<div class="page">
  <div class="section-cover">
    <div class="section-cover-title" style="text-align:center; width:100%;">
      Faculty Senate <span class="section-cover-title-underline">Approved</span> Special Unit<br>Criteria (<em>if applicable)</em>
    </div>
  </div>
</div>

<!-- PAGE 5: Promotion Comprehensive Activities Report -->
<div class="page">
  <div class="section-cover">
    <div class="section-cover-title" style="text-align:center; width:100%;">
      Promotion Comprehensive Activities<br>Report
    </div>
  </div>
</div>

<!-- PAGE 6: Self-Evaluation -->
<div class="page">
  <div class="section-cover">
    <div class="section-cover-title">Self-Evaluation</div>
  </div>
</div>

<!-- PAGE 7: Peer, Student and External Evaluations -->
<div class="page">
  <div class="section-cover">
    <div class="section-cover-title">Peer, Student and External Evaluations</div>
  </div>
</div>

<!-- PAGE 8: Past Evaluations -->
<div class="page">
  <div class="section-cover">
    <div class="section-cover-title">Past Evaluations</div>
  </div>
</div>




  <!-- Page 1: Copies of Workloads for Period of Review -->
  <div class="page">
    <div class="page-center">
      <div class="title-block-left">
        <div class="section-title-left">
          <span data-field="section_titles[0]">{{ section_titles[0] }}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Page 2: Student Evaluation Summaries -->
  <div class="page">
    <div class="page-center">
      <div class="title-block">
        <div class="section-title">
          <span data-field="section_titles[1]">{{ section_titles[1] }}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Page 3: Peer Evaluation of Teaching -->
  <div class="page">
    <div class="page-center">
      <div class="title-block-left">
        <div class="section-title-left">
          <span data-field="section_titles[2]">{{ section_titles[2] }}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Page 4: Examples of Course Syllabi -->
  <div class="page">
    <div class="page-center">
      <div class="title-block-left">
        <div class="section-title-left">
          <span data-field="section_titles[3]">{{ section_titles[3] }}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Page 5: Examples/Evidence of Research/Creative Activities -->
  <div class="page">
    <div class="page-center">
      <div class="title-block">
        <div class="section-title">
          <span data-field="section_titles[4]">{{ section_titles[4] }}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Page 6: Letters or Other External Evaluations -->
  <div class="page">
    <div class="page-center">
      <div class="title-block">
        <div class="section-title">
          <span data-field="section_titles[5]">{{ section_titles[5] }}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Page 7: Honors, Citations and Any Other Letters -->
  <div class="page">
    <div class="page-center" style="align-items: flex-start; padding-top: 80px;">
      <div class="title-block">
        <div class="section-title">
          <span data-field="section_titles[6]">{{ section_titles[6] }}</span>
        </div>
        <div class="honors-note">
          Do <u>not</u> include here the letters requested by your dean or director; those go in Section <span data-field="honors_section_reference">{{ honors_section_reference }}</span>.
        </div>
      </div>
    </div>
  </div>

  <!-- Page 8: Letters of Support; Miscellaneous -->
  <div class="page">
    <div class="page-center">
      <div class="title-block-left">
        <div class="section-title-left">
          <span data-field="section_titles[7]">{{ section_titles[7] }}</span>
        </div>
      </div>
    </div>
  </div>




<!-- PAGE 1: Curriculum Vitae Cover -->
<div class="page">
  <div class="center-mid">
    <h1>a)&nbsp; Curriculum Vitae</h1>
  </div>
</div>

<!-- PAGE 2: External Review Letters Cover -->
<div class="page">
  <div class="center-mid-block">
    <div class="section-label">
      <span class="letter-prefix">b)&nbsp; External Review Letters <em>(if requested by your dean, director or designee for review)</em></span>
    </div>
  </div>
</div>

<!-- PAGE 3: Unit Peer Committee Recommendation Cover -->
<div class="page">
  <div class="center-mid-plain">
    <h2>Unit Peer Committee Recommendation</h2>
  </div>
</div>

<!-- PAGE 4: Candidate Response to Unit-Peer Committee Recommendation Cover -->
<div class="page">
  <div class="promotion-label">Promotion</div>
  <div class="candidate-response-block">
    <div class="cr-title">CANDIDATE RESPONSE</div>
    <div class="cr-to">to</div>
    <div class="cr-subtitle">UNIT-PEER COMMITTEE RECOMMENDATION</div>
  </div>
</div>

<!-- PAGE 5: Response Letter Template (Unit-Peer) -->
<div class="page">
  <div class="promotion-label">Promotion</div>

  <div style="margin-top: 16px;">
    <div class="warning-box-yellow">
      <div class="warn-title">DELETE THIS PAGE BEFORE FINALIZING YOUR FILE</div>
      <div class="warn-sub">USE THIS RESPONSE LETTER TEMPLATE IF NOT CREATING YOUR OWN</div>
    </div>
    <div class="warning-italic-yellow">
      <div class="warn-italic">MAKE SURE TO REMOVE HIGHLIGHTED SECTIONS BEFORE FINALIZING YOUR RESPONSE LETTER.</div>
    </div>
  </div>

  <div class="letter-fields">
    <div class="field-row">
      <div class="field-label">To:</div>
      <div class="field-value">Dean and/or Director</div>
    </div>
    <div class="field-row">
      <div class="field-label">From:</div>
      <div class="field-value"><span data-field="unit_peer_from_name">{{ unit_peer_from_name }}</span></div>
    </div>
    <div class="field-row">
      <div class="field-label">Date:</div>
      <div class="field-value"><span data-field="unit_peer_date">{{ unit_peer_date }}</span></div>
    </div>
    <div class="field-row">
      <div class="field-label">Re:</div>
      <div class="field-value">Response to Unit-Peer Committee Recommendation On Promotion</div>
    </div>
  </div>

  <div class="signature-section">
    <div class="sig-row">
      <div class="sig-block">
        <div class="sig-line"></div>
        <div class="sig-label">Signature</div>
      </div>
      <div class="sig-block" style="margin-right: 60px;">
        <div class="sig-line-short"></div>
        <div class="sig-label">Date</div>
      </div>
    </div>
    <div class="sig-name-block" style="align-items: flex-start;">
      <div class="sig-name-line"></div>
      <div class="sig-label">Printed Name</div>
    </div>
    <div class="footer-note" style="margin-top: 14px;">Provide additional documents regarding publications if needed.</div>
  </div>
</div>

