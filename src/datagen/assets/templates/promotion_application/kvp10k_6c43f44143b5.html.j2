<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Promotion Review Document</title>
<style>
  @page { size: A4; margin: 0; }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
    font-size: 12pt;
    color: #000;
  }

  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }

  /* Page 1 - Cover */
  .cover-title {
    text-align: center;
    font-size: 24pt;
    font-weight: bold;
    margin-top: 220px;
    margin-bottom: 40px;
  }

  .cover-divider {
    border: none;
    border-top: 1.5px solid #000;
    margin: 0 30px 30px 30px;
  }

  .cover-fields {
    text-align: center;
    line-height: 2.2;
    font-size: 12pt;
  }

  .cover-field-line {
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 6px;
  }

  .cover-underline {
    display: inline-block;
    border-bottom: 1px solid #000;
    min-width: 160px;
  }

  .cover-review-type {
    text-align: center;
    margin-top: 4px;
  }

  /* Page 2 - Checklist */
  .checklist-title {
    text-align: center;
    font-size: 13pt;
    font-weight: bold;
    margin-top: 30px;
    margin-bottom: 6px;
    letter-spacing: 0.5px;
  }

  .checklist-subtitle {
    text-align: center;
    font-size: 13pt;
    font-weight: bold;
    margin-bottom: 28px;
  }

  .checklist-header-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 20px;
    font-size: 12pt;
  }

  .checklist-header-row .field-label {
    font-weight: bold;
  }

  .checklist-header-underline {
    display: inline-block;
    border-bottom: 1px solid #000;
    min-width: 200px;
  }

  .checklist-header-underline-dept {
    display: inline-block;
    border-bottom: 1px solid #000;
    min-width: 160px;
  }

  .sections-label {
    font-style: italic;
    margin-bottom: 14px;
    font-size: 12pt;
  }

  .checklist-item {
    display: flex;
    align-items: flex-start;
    margin-bottom: 10px;
    font-size: 11.5pt;
  }

  .checklist-blank {
    display: inline-block;
    width: 36px;
    border-bottom: 1px solid #000;
    margin-right: 10px;
    flex-shrink: 0;
    margin-top: 3px;
  }

  .checklist-num {
    width: 26px;
    flex-shrink: 0;
    font-size: 11.5pt;
  }

  .checklist-text {
    flex: 1;
    line-height: 1.5;
  }

  .checklist-sub {
    margin-top: 6px;
    margin-left: 0;
  }

  .checklist-sub-item {
    display: flex;
    align-items: flex-start;
    margin-bottom: 5px;
    font-size: 11pt;
  }

  .checklist-sub-blank {
    display: inline-block;
    width: 36px;
    border-bottom: 1px solid #000;
    margin-right: 8px;
    flex-shrink: 0;
    margin-top: 3px;
  }

  .checklist-sub-text {
    flex: 1;
    line-height: 1.5;
  }

  .italic-note {
    font-style: italic;
    font-size: 10.5pt;
  }

  /* Section cover pages */
  .section-cover {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    height: 100%;
  }

  .section-cover-title {
    font-size: 20pt;
    font-weight: bold;
    margin-top: -200px;
    margin-left: 0;
  }

  .section-cover-title-underline {
    text-decoration: underline;
  }
</style>

<style>
    @page { size: A4; margin: 0; }

