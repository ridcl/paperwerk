<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1, h2 { font-weight: bold; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 15px; }
  .form-group { display: flex; align-items: center; }
  .label { font-weight: normal; }
  .input-line { border-bottom: 1px solid #000; flex-grow: 1; margin-left: 10px; }
  .checkbox-group { display: flex; align-items: center; margin-top: 10px; }
  .signature-line { border-bottom: 1px solid #000; margin-top: 50px; margin-bottom: 50px; width: 45%; }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px;">
    <div>
      <h1 style="font-size: 24px; margin: 0;">University of New Hampshire</h1>
      <p style="margin: 0;">Housing</p>
    </div>
    <div>
      <h1 style="font-size: 24px; margin: 0;">Mid-Year Apartment Request/Change Form</h1>
    </div>
  </div>

  <p style="margin-bottom: 20px;">
    Please return this <span data-field="completion_status">{{ completion_status }}</span> form to the <span data-field="housing_office_name">{{ housing_office_name }}</span> or email <span data-field="housing_email">{{ housing_email }}</span> no later than <span data-field="deadline_date">{{ deadline_date }}</span>.
  </p>

  <div style="border: 1px solid #000; padding: 20px; margin-bottom: 30px;">
    <div class="form-row">
      <div style="width: 20%;">
        <div class="form-group">
          <span class="label">Name:</span>
          <div class="input-line" data-field="name">{{ name }}</div>
        </div>
      </div>
      <div style="width: 20%;">
        <div class="form-group">
          <span class="label">Student I.D. #</span>
          <div class="input-line" style="width: 80%;" data-field="student_i_d">{{ student_i_d }}</div>
        </div>
      </div>
      <div style="width: 20%;">
        <div class="form-group">
          <span class="label">Date of Birth:</span>
          <div class="input-line" style="width: 80%;" data-field="date_of_birth">{{ date_of_birth }}</div>
        </div>
      </div>
    </div>

    <div class="form-row">
      <div style="width: 20%;">
        <div class="form-group">
          <span class="label">Sex:</span>
          <div class="input-line" style="width: 80%;" data-field="sex">{{ sex }}</div>
        </div>
      </div>
      <div style="width: 30%;">
        <div class="form-group">
          <span class="label">E-mail Address:</span>
          <div class="input-line" data-field="e_mail_address">{{ e_mail_address }}</div>
        </div>
      </div>
      <div style="width: 30%;">
        <div class="form-group">
          <span class="label">Cell Phone Number:</span>
          <div class="input-line" data-field="cell_phone_number">{{ cell_phone_number }}</div>
        </div>
      </div>
    </div>

    <div class="form-row">
      <div style="width: 33%;">
        <div class="form-group">
          <span class="label">Current Assignment (if residence hall, fill in building and room only):</span>
          <div class="input-line" data-field="cell_phone_number_2">{{ cell_phone_number_2 }}</div>
        </div>
      </div>
      <div style="width: 33%;">
        <div class="form-group">
          <span class="label">Complex</span>
          <div class="input-line" style="width: 80%;" data-field="complex">{{ complex }}</div>
        </div>
      </div>
      <div style="width: 34%;">
        <div class="form-group">
          <span class="label">Building</span>
          <div class="input-line" style="width: 80%;" data-field="building">{{ building }}</div>
        </div>
      </div>
    </div>

    <div class="form-row" style="margin-top: 15px;">
      <div style="width: 33%;">
        <div class="form-group">
          <span class="label">Apt#</span>
          <div class="input-line" style="width: 80%;" data-field="apt">{{ apt }}</div>
        </div>
      </div>
      <div style="width: 33%;">
        <div class="form-group">
          <span class="label">Room</span>
          <div class="input-line" style="width: 80%;" data-field="room">{{ room }}</div>
        </div>
      </div>
    </div>

    <div class="checkbox-group" style="margin-top: 25px;">
      <input type="checkbox" id="request_change">
      <label for="request_change" style="margin-left: 10px;">I am requesting that the Housing Office randomly assign/re-assign me to an apartment space.</label>
    </div>

    <div class="form-row" style="margin-top: 20px;">
      <div style="width: 30%;">
        <div class="form-group">
          <span class="label">I would prefer a space at:</span>
          <div class="input-line" style="width: 50%;" data-field="i_would_prefer_a_space_at">{{ i_would_prefer_a_space_at }}</div>
        </div>
      </div>
      <div style="width: 30%;">
        <div class="form-group">
          <span class="label">The Gables</span>
          <div class="input-line" style="width: 50%;" data-field="the_gables">{{ the_gables }}</div>
        </div>
      </div>
      <div style="width: 30%;">
        <div class="form-group">
          <span class="label">Woodside</span>
          <div class="input-line" style="width: 50%;" data-field="woodside">{{ woodside }}</div>
        </div>
      </div>
    </div>

    <div class="form-row" style="margin-top: 20px;">
      <div style="width: 33%;">
        <div class="form-group">
          <span class="label">My room-type preferences are (single or double):</span>
          <div class="input-line" style="width: 50%;" data-field="my_room_type_preferences_are">{{ my_room_type_preferences_are }}</div>
        </div>
      </div>
      <div style="width: 33%;">
        <div class="form-group">
          <span class="label">1<sup>st</sup> Choice:</span>
          <div class="input-line" style="width: 50%;" data-field="choice">{{ choice }}</div>
        </div>
      </div>
      <div style="width: 34%;">
        <div class="form-group">
          <span class="label">2<sup>nd</sup> Choice:</span>
          <div class="input-line" style="width: 50%;" data-field="choice_2">{{ choice_2 }}</div>
        </div>
      </div>
    </div>

    <p style="margin-top: 40px; font-size: 12px;">
      My signature below indicates my understanding that I am/continue to be legally and financially bound to the terms and conditions of the University of New Hampshire Room and Board Agreement for the <span data-field="academic_year">{{ academic_year }}</span> academic year. I also acknowledge that this application, if approved, will result in the cancellation and release of my current housing assignment.
    </p>

    <div style="display: flex; justify-content: space-between; margin-top: 80px;">
      <div style="width: 45%;">
        <span class="label">Signature</span>
        <div class="signature-line" data-field="signature">{{ signature }}</div>
      </div>
      <div style="width: 45%;">
        <span class="label">Date</span>
        <div class="signature-line" data-field="date">{{ date }}</div>
      </div>
    </div>
  </div>

  <p style="font-size: 12px; text-align: center;">
    **Please Note: If you and a friend would like to be reassigned together, please staple your forms together prior to submission.
  </p>

  <div style="display: flex; justify-content: space-between; margin-top: 30px; border-top: 1px solid #000; padding-top: 10px;">
    <div style="width: 30%;">
      <span class="label">Housing Office Use Only</span>
      <div class="input-line" style="width: 100%;" data-field="housing_office_use_only">{{ housing_office_use_only }}</div>
    </div>
    <div style="width: 30%;">
      <span class="label">Assignment:</span>
      <div class="input-line" style="width: 100%;" data-field="assignment">{{ assignment }}</div>
    </div>
    <div style="width: 30%;">
      <span class="label">Staff Initials & Date:</span>
      <div class="input-line" style="width: 100%;" data-field="staff_initials_date">{{ staff_initials_date }}</div>
    </div>
  </div>
</div>