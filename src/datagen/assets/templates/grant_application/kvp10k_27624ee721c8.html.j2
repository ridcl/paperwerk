<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif; }
  h1 { font-size: 18pt; font-weight: bold; margin-bottom: 20px; }
  .form-section { margin-bottom: 30px; }
  .form-row { display: flex; margin-bottom: 15px; align-items: flex-start; }
  .form-label { width: 150px; font-weight: normal; }
  .form-input-group { flex-grow: 1; border-bottom: 1px solid #ccc; }
  .form-input-group input[type="text"], .form-input-group select { border: none; outline: none; width: 100%; border-bottom: 1px solid #ccc; }
  .signature-line { border-bottom: 1px solid #000; margin-top: 50px; margin-bottom: 5px; }
</style>

<div class="page">
  <h1>Classroom Mini-Grant Application Form</h1>

  <div class="form-section">
    <p><strong>Applicant Information:</strong></p>
    
    <div class="form-row">
      <div class="form-label">Name:</div>
      <div class="form-input-group"><span data-field="full_name">{{ full_name }}</span></div>
    </div>

    <div class="form-row">
      <div class="form-label">Position:</div>
      <div class="form-input-group"><span data-field="position">{{ position }}</span></div>
    </div>

    <div class="form-row">
      <div class="form-label">Department:</div>
      <div class="form-input-group"><span data-field="department">{{ department }}</span></div>
    </div>

    <div class="form-row">
      <div class="form-label">School/College:</div>
      <div class="form-input-group"><span data-field="school_college">{{ school_college }}</span></div>
      <div class="form-label" style="margin-left: 300px;">Email:</div>
      <div class="form-input-group" style="margin-left: 300px;"><span data-field="email">{{ email }}</span></div>
    </div>

    <div class="form-row">
      <div class="form-label">Campus Phone:</div>
      <div class="form-input-group"><span data-field="campus_phone">{{ campus_phone }}</span></div>
    </div>

    <p style="margin-top: 20px;">Please attach name and contact information for additional grant members, if applicable.</p>
  </div>

  <div class="form-section">
    <p><strong>Grant Request Information:</strong></p>
    
    <div class="form-row">
      <div class="form-label">Grant Title:</div>
      <div class="form-input-group"><span data-field="grant_title">{{ grant_title }}</span></div>
    </div>

    <div class="form-row">
      <div class="form-label">Amount Requested (limit $300.00):</div>
      <div class="form-input-group"><span data-field="amount_requested">{{ amount_requested }}</span></div>
    </div>

    <div class="form-row">
      <div class="form-label">Course Name, Number, Section:</div>
      <div class="form-input-group"><span data-field="course_details">{{ course_details }}</span></div>
    </div>

    <div class="form-row" style="align-items: center;">
      <div class="form-label" style="width: 100px;">Semester of implementation:</div>
      <div style="display: flex; gap: 20px; flex-grow: 1;">
        <label><input type="checkbox"> Fall</label>
        <label><input type="checkbox"> Spring</label>
        <label><input type="checkbox"> Summer</label>
      </div>
    </div>

    <div class="form-row">
      <div class="form-label">Number of students that this project will impact:</div>
      <div class="form-input-group"><span data-field="number_of_students">{{ number_of_students }}</span></div>
    </div>

    <div class="form-row" style="margin-top: 20px;">
      <div class="form-label" style="width: 100%;">Request Summary: Describe the proposed grant request, including the overall goals and how the requested funds will be used in the classroom.</div>
      <div class="form-input-group" style="flex-grow: 1; border-bottom: 1px solid #ccc; padding-top: 5px;"><span data-field="request_summary">{{ request_summary }}</span></div>
    </div>
  </div>

  <div class="form-section">
    <p><strong>Budget:</strong> Provide an itemized budget. Include specific budget items, amount, and justification.</p>
    
    <!-- Since the budget items are variable, we use a loop structure, though the source only shows the header -->
    <table style="width: 100%; border-collapse: collapse; margin-top: 15px;">
      <thead>
        <tr style="border-bottom: 1px solid #000;">
          <th style="padding: 8px; text-align: left; width: 50%;">Description</th>
          <th style="padding: 8px; text-align: left; width: 25%;">Amount</th>
          <th style="padding: 8px; text-align: left; width: 25%;">Justification</th>
        </tr>
      </thead>
      <tbody>
        {% for item in line_items %}
        <tr style="border-bottom: 1px dotted #ccc;">
          <td style="padding: 8px;"><span data-field="line_items[{{ loop.index0 }}].description">{{ item.description }}</span></td>
          <td style="padding: 8px;"><span data-field="line_items[{{ loop.index0 }}].amount">{{ item.amount }}</span></td>
          <td style="padding: 8px;"><span data-field="line_items[{{ loop.index0 }}].justification">{{ item.justification }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="form-section" style="margin-top: 50px;">
    <p>Applicant Signature and Date:</p>
    <div class="signature-line" data-field="applicant_signature_and_date">{{ applicant_signature_and_date }}</div>
    <p style="margin-top: 5px;">Date:</p>
    <div class="signature-line" style="width: 200px;" data-field="date">{{ date }}</div>
  </div>

  <div class="form-section" style="margin-top: 30px;">
    <p>Application Attachments: Course syllabus (required)</p>
  </div>
</div>