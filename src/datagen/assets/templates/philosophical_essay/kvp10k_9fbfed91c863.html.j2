<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child {
    page-break-after: auto;
  }
  h1, h2, h3 {
    font-family: "DejaVu Sans", "Liberation Sans", Arial, Helvetica, sans-serif;
  }
  p {
    text-align: justify;
    line-height: 1.6;
  }
  .notes-section {
    margin-top: 30px;
  }
  .notes-section h3 {
    font-size: 14pt;
    text-align: center;
    margin-bottom: 15px;
  }
  .note-list {
    list-style-type: none;
    padding-left: 0;
  }
  .note-list li {
    margin-bottom: 10px;
    font-size: 10pt;
    text-align: justify;
  }
  .footer {
    position: absolute;
    bottom: 50px;
    width: 100%;
    display: flex;
    justify-content: space-between;
    font-size: 10pt;
    color: #555;
  }
</style>

<div class="page">
  <p>
    <span data-field="paragraph_text_1">{{ paragraph_text_1 }}</span>
  </p>
  <p>
    <span data-field="paragraph_text_2">{{ paragraph_text_2 }}</span>
  </p>
  <p>
    <span data-field="paragraph_text_3">{{ paragraph_text_3 }}</span>
  </p>
  <p>
    <span data-field="paragraph_text_4">{{ paragraph_text_4 }}</span>
  </p>
  <p>
    <span data-field="paragraph_text_5">{{ paragraph_text_5 }}</span>
  </p>
  <p>
    <span data-field="paragraph_text_6">{{ paragraph_text_6 }}</span>
  </p>
  <p>
    <span data-field="paragraph_text_7">{{ paragraph_text_7 }}</span>
</div>

<div class="page">
  <div style="text-align: center; margin-bottom: 50px;">
    <h1 style="font-size: 24pt; margin: 0;">Columbia University</h1>
  </div>

  <div class="notes-section">
    <h3>NOTES</h3>
    <ol class="note-list">
      {% for i in range(1, 22) %}
      <li>
        <span data-field="note_content_{{ i }}">{{ "Content of note " + str(i) }}</span>
      </li>
      {% endfor %}
    </ol>
  </div>

  <div class="footer">
    <div>
      <span data-field="page_number_bottom_left">{{ page_number_bottom_left }}</span>
    </div>
    <div>
      <span data-field="running_header_right">{{ running_header_right }}</span>
    </div>
  </div>
</div>

<div class="page">
  <div style="text-align: center; margin-bottom: 50px;">
    <img src="placeholder_logo.png" alt="Wilson Web Logo" style="max-width: 200px; height: auto;">
  </div>

  <div style="border: 1px solid #ccc; padding: 20px; margin-bottom: 50px;">
    <h2 style="font-family: 'DejaVu Sans', sans-serif; font-size: 14pt; margin-top: 0;">COPYRIGHT INFORMATION</h2>
    <p style="font-size: 10pt;">
      TITLE: <span data-field="copyright_title">{{ "Title Placeholder" }}</span>
    </p>
    <p style="font-size: 10pt;">
      SOURCE: <span data-field="copyright_source">{{ "Source Placeholder" }}</span>
    </p>
    <p style="font-size: 10pt;">
      WN: <span data-field="copyright_wn">{{ "WN Placeholder" }}</span>
    </p>
    <p style="font-size: 10pt;">
      The magazine publisher is the copyright holder of this article and it is reproduced with permission. Further reproduction of this article in violation of the copyright is prohibited.
    </p>
  </div>

  <p style="text-align: center; font-size: 10pt;">
    Copyright <span data-field="copyright_year_start">{{ copyright_year_start }}</span>-<span data-field="copyright_year_end">{{ copyright_year_end }}</span> The H.W. Wilson Company. All rights reserved.
  </p>

  <div class="footer">
    <div>
      <span data-field="page_number_bottom_left">{{ page_number_bottom_left }}</span>
    </div>
    <div>
      <span data-field="running_header_right">{{ running_header_right }}</span>
    </div>
  </div>
</div></body>
</html>