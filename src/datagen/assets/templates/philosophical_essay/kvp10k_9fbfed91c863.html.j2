    <span data-field="paragraph_10">{{ paragraph_10 }}</span>
  </div>

  <div class="text-block">
    <span data-field="paragraph_11">{{ paragraph_11 }}</span>
  </div>

  <div class="text-block">
    <span data-field="paragraph_12">{{ paragraph_12 }}</span>
  </div>

  <div class="text-block">
