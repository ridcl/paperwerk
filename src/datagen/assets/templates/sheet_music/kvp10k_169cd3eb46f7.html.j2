<!DOCTYPE html>
<html>
<head>
    <title>Music Sheet Template</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        .title { text-align: center; margin-bottom: 20px; }
        .subtitle { text-align: center; margin-top: 10px; }
        .logo-container { text-align: center; margin-top: 50px; }
        .footer { text-align: center; margin-top: 50px; font-size: 10pt; }
        .music-notation { margin-bottom: 40px; }
        .tone-header { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
        .key-label { font-style: italic; font-size: 10pt; }
        .score-group { margin-bottom: 30px; }
        .score-title { font-weight: bold; margin-bottom: 5px; }
        .copyright { font-size: 8pt; text-align: right; margin-top: 5px; }
    </style>

