    margin-top: 15px;
  }
  .grid-3col {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 15px;
  }
  .table-container {
    margin-top: 15px;
    width: 100%;
    border-collapse: collapse;
  }
  .table-container th, .table-container td {
    border: 1px solid #000;
    padding: 8px;
    text-align: left;
    font-size: 10pt;
  }
  .table-container th {
    background-color: #f0f0f0;
  }
  .checkbox-group label {
    font-weight: normal;
    margin-right: 15px;
  }
  .signature-line {
    margin-top: 50px;
    display: flex;
    justify-content: space-between;
    width: 100%;
  }
  .signature-box {
    width: 30%;
    text-align: center;
  }
  .signature-box div {
    border-bottom: 1px solid #000;
    padding-bottom: 5px;
    margin-bottom: 5px;
