<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  /* Basic styling to mimic document structure */
  h1, h2, h3 {
    font-weight: bold;
    margin-bottom: 10px;
  }
  .section-title {
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 5px;
  }
  .form-row {
    margin-bottom: 15px;
  }
  .form-row label {
    display: inline-block;
    width: 100px; /* Adjust as needed for alignment */
    font-weight: normal;
  }
  .form-row input[type="text"], .form-row textarea {
    border-bottom: 1px solid #000;
    display: inline-block;
    width: calc(100% - 110px);
    padding: 2px 0;
  }
  .two-column {
    display: flex;
    justify-content: space-between;
    margin-top: 20px;
  }
  .two-column > div {
    width: 48%;
  }
  .radio-group label {
    font-weight: normal;
    display: inline-block;
    margin-right: 15px;
  }
</style>

<div class="page">
  <h1>Research Maintenance Form</h1>
  <p>Please fill out all information for the record that you need changes to be made to.</p>

  <div class="section-title">Study Information</div>
  <p>This entire section needs to be filled out</p>

  <div class="form-row">
    IRB Approval #: <span data-field="irb_approval_number">{{ irb_approval_number }}</span>
  </div>

  <div class="form-row">
    Department:
    <div class="radio-group">
      <label><input type="radio" name="department" value="AIR"> AIR</label>
      <label><input type="radio" name="department" value="Anesthesiology"> Anesthesiology</label>
      <label><input type="radio" name="department" value="Cancer Center"> Cancer Center</label>
      <label><input type="radio" name="department" value="Cardiology"> Cardiology</label>
      <label><input type="radio" name="department" value="Dermatology"> Dermatology</label>
      <label><input type="radio" name="department" value="Family Medicine"> Family Medicine</label>
      <label><input type="radio" name="department" value="Gastroenterology"> Gastroenterology</label>
      <label><input type="radio" name="department" value="Infectious Disease"> Infectious Disease</label>
      <label><input type="radio" name="department" value="Nephrology"> Nephrology</label>
      <label><input type="radio" name="department" value="Neurology"> Neurology</label>
      <label><input type="radio" name="department" value="Neurosurgery"> Neurosurgery</label>
      <label><input type="radio" name="department" value="OBGYN"> OBGYN</label>
      <label><input type="radio" name="department" value="Ophthalmology"> Ophthalmology</label>
      <label><input type="radio" name="department" value="Orthopaedics"> Orthopaedics</label>
      <label><input type="radio" name="department" value="Otolaryngology"> Otolaryngology</label>
      <label><input type="radio" name="department" value="Pathology"> Pathology</label>
      <label><input type="radio" name="department" value="Pediatrics"> Pediatrics</label>
      <label><input type="radio" name="department" value="Psychiatry"> Psychiatry</label>
      <label><input type="radio" name="department" value="Pulmonary"> Pulmonary</label>
      <label><input type="radio" name="department" value="Radiation Oncology"> Radiation Oncology</label>
      <label><input type="radio" name="department" value="Surgery"> Surgery</label>
      <label><input type="radio" name="department" value="Urology"> Urology</label>
    </div>
  </div>

  <div class="form-row">
    Epic Study Code: <span data-field="epic_study_code">{{ epic_study_code }}</span>
  </div>
</div>

<div class="page">
  <div class="section-title">Users and Providers</div>

  <div class="two-column">
    <div>
      <div class="section-title">Original PI</div>
      <div class="form-row">
        Last Name: <span data-field="original_pi.last_name">{{ original_pi.last_name }}</span>
      </div>
      <div class="form-row">
        First Name: <span data-field="original_pi.first_name">{{ original_pi.first_name }}</span>
      </div>
      <div class="form-row">
        Phone: <span data-field="original_pi.phone">{{ original_pi.phone }}</span>
      </div>
      <div class="form-row">
        Email: <span data-field="original_pi.email">{{ original_pi.email }}</span>
      </div>
    </div>
    <div>
      <div class="section-title">New PI</div>
      <div class="form-row">
        Last Name: <span data-field="new_pi.last_name">{{ new_pi.last_name }}</span>
      </div>
      <div class="form-row">
        First Name: <span data-field="new_pi.first_name">{{ new_pi.first_name }}</span>
      </div>
      <div class="form-row">
        Phone: <span data-field="new_pi.phone">{{ new_pi.phone }}</span>
      </div>
      <div class="form-row">
        Email: <span data-field="new_pi.email">{{ new_pi.email }}</span>
      </div>
    </div>
  </div>

  <div class="two-column">
    <div>
      <div class="section-title">Original Study Coordinator (SC)</div>
      <div class="form-row">
        Last Name: <span data-field="original_sc.last_name">{{ original_sc.last_name }}</span>
      </div>
      <div class="form-row">
        First Name: <span data-field="original_sc.first_name">{{ original_sc.first_name }}</span>
      </div>
      <div class="form-row">
        Phone: <span data-field="original_sc.phone">{{ original_sc.phone }}</span>
      </div>
      <div class="form-row">
        Email: <span data-field="original_sc.email">{{ original_sc.email }}</span>
      </div>
    </div>
    <div>
      <div class="section-title">New Study Coordinator (SC)</div>
      <div class="form-row">
        Last Name: <span data-field="new_sc.last_name">{{ new_sc.last_name }}</span>
      </div>
      <div class="form-row">
        First Name: <span data-field="new_sc.first_name">{{ new_sc.first_name }}</span>
      </div>
      <div class="form-row">
        Phone: <span data-field="new_sc.phone">{{ new_sc.phone }}</span>
      </div>
      <div class="form-row">
        Email: <span data-field="new_sc.email">{{ new_sc.email }}</span>
      </div>
    </div>
  </div>

  <div class="two-column">
    <div>
      <div class="section-title">Original Alternate Study Coordinator (ASC)</div>
      <div class="form-row">
        Last Name: <span data-field="original_asc.last_name">{{ original_asc.last_name }}</span>
      </div>
      <div class="form-row">
        First Name: <span data-field="original_asc.first_name">{{ original_asc.first_name }}</span>
      </div>
      <div class="form-row">
        Phone: <span data-field="original_asc.phone">{{ original_asc.phone }}</span>
      </div>
      <div class="form-row">
        Email: <span data-field="original_asc.email">{{ original_asc.email }}</span>
      </div>
    </div>
    <div>
      <div class="section-title">New Alternate Study Coordinator (ASC)</div>
      <div class="form-row">
        Last Name: <span data-field="new_asc.last_name">{{ new_asc.last_name }}</span>
      </div>
      <div class="form-row">
        First Name: <span data-field="new_asc.first_name">{{ new_asc.first_name }}</span>
      </div>
      <div class="form-row">
        Phone: <span data-field="new_asc.phone">{{ new_asc.phone }}</span>
      </div>
      <div class="form-row">
        Email: <span data-field="new_asc.email">{{ new_asc.email }}</span>
      </div>
    </div>
  </div>

  <div class="two-column">
    <div>
      <div class="section-title">Original Billing Contact (BC)</div>
      <p>This person will be responsible for processing journal entries for study specific charges for sponsor costs.</p>
      <div class="form-row">
        Last Name: <span data-field="original_bc.last_name">{{ original_bc.last_name }}</span>
      </div>
      <div class="form-row">
        First Name: <span data-field="original_bc.first_name">{{ original_bc.first_name }}</span>
      </div>
      <div class="form-row">
        Phone: <span data-field="original_bc.phone">{{ original_bc.phone }}</span>
      </div>
      <div class="form-row">
        Email: <span data-field="original_bc.email">{{ original_bc.email }}</span>
      </div>
      <div class="form-row">
        P.O. Box: <span data-field="original_bc.po_box">{{ original_bc.po_box }}</span>
      </div>
    </div>
    <div>
      <div class="section-title">New Billing Contact (BC)</div>
      <div class="form-row">
        Last Name: <span data-field="new_bc.last_name">{{ new_bc.last_name }}</span>
      </div>
      <div class="form-row">
        First Name: <span data-field="new_bc.first_name">{{ new_bc.first_name }}</span>
      </div>
      <div class="form-row">
        Phone: <span data-field="new_bc.phone">{{ new_bc.phone }}</span>
      </div>
      <div class="form-row">
        Email: <span data-field="new_bc.email">{{ new_bc.email }}</span>
      </div>
      <div class="form-row">
        P.O. Box: <span data-field="new_bc.po_box">{{ new_bc.po_box }}</span>
      </div>
    </div>
  </div>

  <div class="two-column">
    <div>
      <div class="section-title">Original Billing Plan Expert (BPE)</div>
      <p>This person will be responsible for charge review in place of the Study Coordinator (SC) or Alternate Study Coordinator (ASC) if need be.</p>
      <div class="form-row">
        Last Name: <span data-field="original_bpe.last_name">{{ original_bpe.last_name }}</span>
      </div>
      <div class="form-row">
        First Name: <span data-field="original_bpe.first_name">{{ original_bpe.first_name }}</span>
      </div>
      <div class="form-row">
        Phone: <span data-field="original_bpe.phone">{{ original_bpe.phone }}</span>
      </div>
      <div class="form-row">
        Email: <span data-field="original_bpe.email">{{ original_bpe.email }}</span>
      </div>
    </div>
    <div>
      <div class="section-title">New Billing Plan Expert (BPE)</div>
      <div class="form-row">
        Last Name: <span data-field="new_bpe.last_name">{{ new_bpe.last_name }}</span>
      </div>
      <div class="form-row">
        First Name: <span data-field="new_bpe.first_name">{{ new_bpe.first_name }}</span>
      </div>
      <div class="form-row">
        Phone: <span data-field="new_bpe.phone">{{ new_bpe.phone }}</span>
      </div>
      <div class="form-row">
        Email: <span data-field="new_bpe.email">{{ new_bpe.email }}</span>
      </div>
    </div>
  </div>

  <div class="two-column">
    <div>
      <div class="section-title">Original Administrator</div>
      <div class="form-row">
        Last Name: <span data-field="original_admin.last_name">{{ original_admin.last_name }}</span>
      </div>
      <div class="form-row">
        First Name: <span data-field="original_admin.first_name">{{ original_admin.first_name }}</span>
      </div>
      <div class="form-row">
        Phone: <span data-field="original_admin.phone">{{ original_admin.phone }}</span>
      </div>
      <div class="form-row">
        Email: <span data-field="original_admin.email">{{ original_admin.email }}</span>
      </div>
      <div class="form-row">
        Comments:
        <textarea data-field="original_admin.comments">{{ original_admin.comments }}</textarea>
      </div>
    </div>
    <div>
      <div class="section-title">New Administrator</div>
      <div class="form-row">
        Last Name: <span data-field="new_admin.last_name">{{ new_admin.last_name }}</span>
      </div>
      <div class="form-row">
        First Name: <span data-field="new_admin.first_name">{{ new_admin.first_name }}</span>
      </div>
      <div class="form-row">
        Phone: <span data-field="new_admin.phone">{{ new_admin.phone }}</span>
      </div>
      <div class="form-row">
        Email: <span data-field="new_admin.email">{{ new_admin.email }}</span>
      </div>
    </div>
  </div>

  <p style="margin-top: 50px;">Please email the completed form to <span data-field="email_address">{{ email_address }}</span></p>

  <div style="display: flex; justify-content: space-between; margin-top: 50px; font-size: small;">
    <span data-field="version_date">{{ version_date }}</span>
    <span>Confidential</span>
  </div>
</div>