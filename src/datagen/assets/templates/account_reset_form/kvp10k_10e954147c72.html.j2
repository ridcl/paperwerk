<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; /* Defaulting to serif for document feel */
  }
  .page:last-child {
    page-break-after: auto;
  }
  /* Basic styling to mimic document structure */
  h1, h2, h3 {
    font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif;
    font-weight: bold;
  }
  .form-group {
    margin-bottom: 15px;
  }
  label {
    display: block;
    margin-bottom: 5px;
    font-weight: normal;
  }
  input[type="text"], input[type="password"] {
    width: 100%;
    padding: 8px;
    box-sizing: border-box;
    border: 1px solid #ccc;
  }
  .button-group button {
    padding: 8px 15px;
    margin-right: 10px;
    cursor: pointer;
  }
</style>

<div class="page">
  <div style="text-align: center; margin-bottom: 30px;">
    <img src="placeholder_logo.png" alt="Library Logo" style="max-width: 200px; height: auto;">
    <h1 style="font-size: 24pt; margin-top: 10px;">DR. C.C. & MABEL L. CRISS LIBRARY</h1>
  </div>

  <div style="text-align: center; margin-bottom: 40px;">
    <h2 style="font-size: 18pt;">Create Your Account with Criss Library for Access to</h2>
    <h3 style="font-size: 16pt;">Journal Article Databases and Electronic Books</h3>
  </div>

  <p style="text-align: justify; margin-bottom: 20px;">
    Point your Internet browser to the Criss Library website at <span data-field="library_url">{{ library_url }}</span> and click the account login link in the upper right corner of the homepage:
  </p>

  <!-- Find Items Section -->
  <div style="border: 1px solid #ccc; padding: 20px; margin-bottom: 30px;">
    <h3 style="font-size: 14pt; margin-top: 0;">Find Items at UNO Criss Library and beyond</h3>
    <form style="display: flex; gap: 10px; align-items: flex-end;">
      <div style="flex-grow: 1;">
        <label for="search_query">Search Query:</label>
        <input type="text" id="search_query" placeholder="Enter search terms..." data-field="search_query" value="{{ search_query }}">
      </div>
      <div style="width: 200px;">
        <label for="scope">Scope:</label>
        <select id="scope">
          <option value="library">University of Nebraska Omaha</option>
          <option value="external">External Databases</option>
        </select>
      </div>
      <div style="display: flex; flex-direction: column; justify-content: flex-end;">
        <button type="submit" style="background-color: #0056b3; color: white; border: none; padding: 10px 20px; cursor: pointer;">Go</button>
        <a href="#" style="font-size: 10pt; margin-top: 5px; display: block;">Advanced Search</a>
      </div>
    </form>
  </div>

  <p style="text-align: justify; margin-bottom: 20px;">
    Click the link to set/reset your Library account password:
  </p>

  <!-- Sign In Section -->
  <div style="border: 1px solid #ccc; padding: 20px; margin-bottom: 30px;">
    <h3 style="font-size: 14pt;">Sign In</h3>
    <form>
      <div class="form-group">
        <label for="nu_id">NU ID Number:</label>
        <input type="text" id="nu_id" placeholder="Enter NU ID" data-field="nu_id_number" value="{{ nu_id_number }}">
      </div>
      <div class="form-group">
        <label for="password">Password:</label>
        <input type="password" id="password" placeholder="Enter Password" data-field="password" value="{{ password }}">
      </div>
      <div class="button-group" style="margin-top: 15px;">
        <button type="submit" style="background-color: #28a745; color: white; border: none;">Sign In</button>
        <button type="button" style="background-color: #6c757d; color: white; border: none;">Cancel</button>
      </div>
      <div style="text-align: center; margin-top: 15px;">
        <a href="#" style="font-size: 10pt;">Forgot Password?</a>
      </div>
    </form>
  </div>

  <p style="text-align: justify; margin-bottom: 20px;">
    Follow the instructions to set/reset your Library account password:
  </p>

  <!-- Password Reset Section -->
  <div style="border: 1px solid #ccc; padding: 20px; margin-bottom: 30px;">
    <p style="font-size: 10pt; margin-bottom: 15px;">
      To reset your password, enter your NU ID Number below. An email message will be sent to the email account listed in your Library patron record which will contain a new password. Once your password is reset, your current password will no longer be accepted.
    </p>
    <form>
      <div class="form-group">
        <label for="nu_id_reset">NU ID Number:</label>
        <input type="text" id="nu_id_reset" placeholder="Enter NU ID" data-field="nu_id_number_2" value="{{ nu_id_number_2 }}">
      </div>
      <div style="text-align: center; margin-top: 20px;">
        <button type="submit" style="background-color: #ffc107; color: black; border: none; padding: 10px 25px; cursor: pointer;">Request new password</button>
      </div>
    </form>
  </div>

  <!-- Email Account Section -->
  <div style="margin-bottom: 30px;">
    <p style="font-size: 10pt; margin-bottom: 15px;">
      The e-mail account listed in your Library patron record is your UNO e-mail available at <span data-field="uno_email_domain">{{ uno_email_domain }}</span>. Once you open the e-mail, click the provided link to retrieve the change password template. The username for your library account is your NU ID Number.
    </p>
  </div>

  <!-- Change Password Form -->
  <div style="border: 1px solid #ccc; padding: 20px;">
    <h3 style="font-size: 14pt;">Change Password</h3>
    <p style="font-size: 10pt; margin-bottom: 15px;">
      Your password will be case-sensitive, and must be six characters or more, with at least one uppercase character, one lowercase character, one number, and one special character (!, @, #, $, %, ^, &, *).
    </p>
    <form>
      <div class="form-group">
        <label for="user_name">User Name:</label>
        <input type="text" id="user_name" placeholder="Enter Username" data-field="user_name" value="{{ user_name }}">
      </div>
      <div class="form-group">
        <label for="new_password">New Password:</label>
        <input type="password" id="new_password" placeholder="Enter New Password" data-field="new_password" value="{{ new_password }}">
      </div>
      <div class="form-group">
        <label for="confirm_password">Confirm New Password:</label>
        <input type="password" id="confirm_password" placeholder="Confirm New Password" data-field="confirm_new_password" value="{{ confirm_new_password }}">
      </div>
      <div style="text-align: center; margin-top: 20px;">
        <button type="submit" style="background-color: #007bff; color: white; border: none; padding: 10px 20px; cursor: pointer;">Change Password</button>
      </div>
    </form>
  </div>

  <p style="text-align: center; margin-top: 50px; font-size: 10pt;">
    If you need help with your Library account, please call the Circulation Desk at <span data-field="phone_number">{{ phone_number }}</span>.
  </p>
</div>