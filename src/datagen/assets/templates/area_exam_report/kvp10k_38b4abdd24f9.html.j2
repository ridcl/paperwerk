<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
  th, td { border: 1px solid #000; padding: 8px; text-align: left; }
  .header { text-align: center; margin-bottom: 30px; }
  .section-title { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
</style>

<div class="page">
  <div class="header">
    <p>Department Of Computer Science</p>
    <p>UNIVERSITY OF COLORADO AT BOULDER</p>
    <p>AREA EXAM REPORT</p>
  </div>

