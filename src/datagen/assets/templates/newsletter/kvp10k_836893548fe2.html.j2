                <span data-field="ayitou_bio_paragraph_2">{{ ayitou_bio_paragraph_2 }}</span>
                <span data-field="ayitou_bio_paragraph_3">{{ ayitou_bio_paragraph_3 }}</span>
                <span data-field="ayitou_bio_paragraph_4">{{ ayitou_bio_paragraph_4 }}</span>
            </div>
        </div>
        <div style="width: 70%;">
