                <span data-field="minh_bio_paragraph_3">{{ minh_bio_paragraph_3 }}</span>
                <span data-field="minh_bio_paragraph_4">{{ minh_bio_paragraph_4 }}</span>
            </div>
            <div style="text-align: center; margin-top: 20px;">
                <img src="placeholder_image.jpg" alt="Molecular structure" style="max-width: 100%; height: auto;">
                <div style="font-size: 9pt; margin-top: 5px;">Differences in electron density around a small organic ligand bound to a protein (DN1 in the protein data bank)</div>
            </div>
        </div>
        <div style="width: 50%;">
            <div class="text-block">
                <span data-field="minh_research_paragraph_1">{{ minh_research_paragraph_1 }}</span>
                <span data-field="minh_research_paragraph_2">{{ minh_research_paragraph_2 }}</span>
                <span data-field="minh_research_paragraph_3">{{ minh_research_paragraph_3 }}</span>
                <span data-field="minh_research_paragraph_4">{{ minh_research_paragraph_4 }}</span>
            </div>
            <div class="text-block" style="margin-top: 40px;">
                <span data-field="column_text_paragraph_1">{{ column_text_paragraph_1 }}</span>
                <span data-field="column_text_paragraph_2">{{ column_text_paragraph_2 }}</span>
            </div>
        </div>
    </div>
</div>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
