<!DOCTYPE html>
<html>
<head>
    <title>Chemistry Elements</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif; }
        .header-logo { font-size: 12pt; font-weight: bold; }
        .main-title { font-size: 60pt; font-weight: bold; line-height: 1.1; }
        .subtitle { font-size: 14pt; margin-top: 10px; }
        .section-title { font-size: 20pt; font-weight: bold; margin-bottom: 20px; }
        .byline { font-size: 12pt; margin-bottom: 30px; }
        .text-block { font-size: 11pt; line-height: 1.6; margin-bottom: 20px; }
        .column-layout { display: flex; justify-content: space-between; }
        .column { width: 48%; }
        .signature-block { margin-top: 40px; }
        .signature-name { font-weight: bold; font-size: 12pt; }
        .signature-title { font-size: 10pt; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        td { padding: 8px 0; }
        .award-item { margin-bottom: 20px; }
        .award-title { font-weight: bold; font-size: 12pt; }
        .award-details { font-size: 10pt; }
        .footer-text { font-size: 9pt; text-align: center; margin-top: 50px; }
    </style>
</head>
<body>

<div class="page">
    <div style="text-align: left; margin-bottom: 50px;">
        <div class="header-logo">ILLINOIS INSTITUTE OF TECHNOLOGY</div>
    </div>
    <div style="text-align: center; margin-top: 100px;">
        <div class="main-title">CHEMISTRY</div>
        <div class="main-title" style="font-size: 70pt;">ELEMENTS</div>
        <div class="subtitle">A Publication of the Department of Chemistry at Illinois Tech</div>
    </div>
    <!-- Placeholder for the large image -->
    <div style="height: 700px; background-color: #111; margin-top: 50px; display: flex; align-items: center; justify-content: center; color: #aaa;">
        [Large Molecular Structure Image Placeholder]
    </div>
    <div style="position: absolute; bottom: 60px; right: 60px; font-size: 10pt; color: #555;">Fall {{ current_year }}</div>
</div>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
        <div style="width: 50%;">
            <div class="section-title">Letter from the Chair</div>
            <div class="text-block">
                <span data-field="letter_content_paragraph_1">{{ letter_content_paragraph_1 }}</span>
                <span data-field="letter_content_paragraph_2">{{ letter_content_paragraph_2 }}</span>
                <span data-field="letter_content_paragraph_3">{{ letter_content_paragraph_3 }}</span>
                <span data-field="letter_content_paragraph_4">{{ letter_content_paragraph_4 }}</span>
                <span data-field="letter_content_paragraph_5">{{ letter_content_paragraph_5 }}</span>
            </div>
            <div class="signature-block">
                <div class="signature-name">{{ chair_name }}</div>
                <div class="signature-title">Professor and Chair</div>
                <div class="signature-title">Department of Chemistry</div>
                <div style="margin-top: 5px;">December 2020</div>
            </div>
        </div>
        <div style="width: 50%;">
            <div class="text-block">
                <span data-field="column_text_paragraph_1">{{ column_text_paragraph_1 }}</span>
                <span data-field="column_text_paragraph_2">{{ column_text_paragraph_2 }}</span>
                <span data-field="column_text_paragraph_3">{{ column_text_paragraph_3 }}</span>
            </div>
            <div class="signature-block">
                <div class="signature-name">{{ other_person_name }}</div>
                <div class="signature-title">Professor and Chair</div>
                <div class="signature-title">Department of Chemistry</div>
            </div>
        </div>
    </div>
</div>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
        <div style="width: 50%;">
