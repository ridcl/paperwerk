<!DOCTYPE html>
<html>
<head>
    <title>Document</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; }
        .header-logo { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; }
        .section-title { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; font-weight: bold; }
        .content-text { font-family: "DejaVu Serif", "Liberation Serif", Georgia, serif; }
        .highlight-box { border: 1px solid #ccc; padding: 20px; margin-top: 20px; }
