        <span data-field="graduate.full_name">{{ graduate.full_name_1 }}</span> (Masters of Urban Planning (MUP))
      </div>
      <div class="list-item">
        <span data-field="graduate.full_name">{{ graduate.full_name_2 }}</span>
      </div>
      <div class="list-item">
        <span data-field="graduate.full_name">{{ graduate.full_name_3 }}</span>
      </div>
      <div class="list-item">
        <span data-field="graduate.full_name">{{ graduate.full_name_4 }}</span>
      </div>
      <div class="list-item">
        <span data-field="graduate.full_name">{{ graduate.full_name_5 }}</span>
      </div>
      <div class="list-item">
        <span data-field="graduate.full_name">{{ graduate.full_name_6 }}</span>
      </div>
      <div class="list-item">
        <span data-field="graduate.full_name">{{ graduate.full_name_7 }}</span>
      </div>
      <div class="list-item">
        <span data-field="graduate.full_name">{{ graduate.full_name_8 }}</span>
