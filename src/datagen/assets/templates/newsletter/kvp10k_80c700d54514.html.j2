        <p><span data-field="goodbye_kelsey_1">{{ goodbye_kelsey_1 }}</span></p>
        <p><span data-field="goodbye_kelsey_2">{{ goodbye_kelsey_2 }}</span></p>
        <p><span data-field="goodbye_kelsey_3">{{ goodbye_kelsey_3 }}</span></p>
        <p><span data-field="goodbye_kelsey_4">{{ goodbye_kelsey_4 }}</span></p>
      </div>
    </div>
  </div>

  <div style="margin-top: 50px;">
    <h3 class="section-title">Making Moves:</h3>
    <div class="column-layout">
      <div class="column" style="width: 50%;">
        <h4 style="font-size: 18px; margin-bottom: 10px;">SAC Faculty News Roundup</h4>
        <ul style="list-style: none; padding: 0;">
          {% for news in sac_faculty_news %}
          <li style="margin-bottom: 8px;"><span data-field="sac_faculty_news[{{ loop.index0 }}].title">{{ sac_faculty_news[loop.index0].title }}</span></li>
          {% endfor %}
        </ul>
      </div>
      <div class="column" style="width: 50%;">
        <h4 style="font-size: 18px; margin-bottom: 10px;">Music program director hitting all the right notes</h4>
        <p><span data-field="music_director_1">{{ music_director_1 }}</span></p>
        <p><span data-field="music_director_2">{{ music_director_2 }}</span></p>
        <p><span data-field="music_director_3">{{ music_director_3 }}</span></p>
        <p><span data-field="music_director_4">{{ music_director_4 }}</span></p>
        <p><span data-field="music_director_5">{{ music_director_5 }}</span></p>
