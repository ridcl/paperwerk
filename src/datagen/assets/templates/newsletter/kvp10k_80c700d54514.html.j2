<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px;">
    <div>
      <div class="header-logo" style="font-size: 24px; font-weight: bold;">Florida Institute of Technology</div>
      <div style="font-size: 14px;">High Tech with a Human Touch™</div>
    </div>
    <div style="text-align: right;">
      <img src="placeholder_flag.png" alt="Netherlands Flag" style="width: 100px; height: auto;">
    </div>
  </div>
  <h1 style="font-size: 48px; margin-bottom: 10px;">STUDY ABROAD</h1>
  <h2 style="font-size: 40px; margin-top: 0;">NETHERLANDS</h2>
  <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 30px;">
    <div style="text-align: left;">
      <h3 style="font-size: 28px;">All Majors Welcome</h3>
      <img src="placeholder_image_1.jpg" alt="Study Abroad Image" style="width: 40%; height: auto; float: left; margin-right: 20px;">
    </div>
    <div style="text-align: right;">
      <h3 style="font-size: 32px;">Summer {{ summer_year }}</h3>
      <img src="placeholder_image_2.jpg" alt="University Image" style="width: 55%; height: auto; float: right; margin-left: 20px;">
    </div>
  </div>
  <div style="clear: both;"></div>

  <div style="margin-top: 40px;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
      <div style="width: 50%;">
        <h3 class="section-title" style="font-size: 22px;">May 4–June 4</h3>
        <p style="font-size: 16px;">On-campus classes</p>
        <div style="margin-top: 20px;">
          <h4 style="font-size: 18px;">SCHOLARSHIP</h4>
          <p style="font-size: 14px;">for those taking any two courses during any Summer {{ summer_year }} Session and participating in Study Abroad Netherlands</p>
          <p style="font-size: 14px;">Undergraduate students: <span data-field="scholarship_undergrad_amount">{{ scholarship_undergrad_amount }}</span></p>
          <p style="font-size: 14px;">Graduate students: <span data-field="scholarship_grad_amount">{{ scholarship_grad_amount }}</span></p>
        </div>
        <div style="margin-top: 20px;">
          <h4 style="font-size: 18px;">TUITION</h4>
          <p style="font-size: 14px;">(Due May 4): Full tuition for one course</p>
        </div>
        <div style="margin-top: 20px;">
          <h4 style="font-size: 18px;">COURSES OFFERED</h4>
          <ul style="list-style-type: disc; padding-left: 20px; font-size: 14px;">
            {% for course in courses %}
              <li>
                <span data-field="course.code">{{ course.code }}</span> - <span data-field="course.name">{{ course.name }}</span>
                <span style="float: right;">{{ course.time }}</span>
              </li>
            {% endfor %}
          </ul>
        </div>
        <div style="margin-top: 20px;">
          <h4 style="font-size: 18px;">QUESTIONS?</h4>
          <p style="font-size: 14px;">Contact <span data-field="contact_email">{{ contact_email }}</span></p>
        </div>
      </div>
      <div style="width: 50%; padding-left: 40px;">
        <h3 class="section-title" style="font-size: 22px;">June 5–19</h3>
        <p style="font-size: 16px;">Study-abroad segment</p>
        <div style="margin-top: 20px;">
          <h4 style="font-size: 18px;">TRAVEL ABROAD COST</h4>
          <p style="font-size: 14px;">(except airfare): <span data-field="travel_cost">{{ travel_cost }}</span></p>
          <p style="font-size: 14px;">($350 nonrefundable deposit due by Feb. 20)</p>
        </div>
        <div style="margin-top: 20px;">
          <h4 style="font-size: 18px;">Travel abroad cost includes:</h4>
          <ul style="list-style-type: disc; padding-left: 20px; font-size: 14px;">
            <li>Day trips to Amsterdam, Belgium and Germany</li>
