<!DOCTYPE html>
<html>
<head>
<title>Document Conversion</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    line-height: 1.4;
    color: #333;
  }
  h1, h2, h3, h4 {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    margin-top: 0;
  }
  .header-logo {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 20px;
  }
  .logo-title {
    font-size: 60px;
    font-weight: bold;
    line-height: 0.9;
  }
  .logo-subtitle {
    font-size: 12px;
    text-align: right;
  }
  .section-title {
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 15px;
  }
  .article-title {
    font-size: 36px;
    font-weight: bold;
    line-height: 1.1;
    margin-bottom: 10px;
  }
  .byline {
    font-size: 14px;
    margin-bottom: 30px;
  }
  .pull-quote {
    border-left: 4px solid #ccc;
    padding-left: 20px;
    margin: 20px 0;
    font-style: italic;
    font-size: 16px;
  }
  .column-layout {
    display: flex;
    gap: 40px;
    margin-top: 30px;
  }
  .column {
    flex: 1;
  }
  .table-container {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
  }
  .table-container th, .table-container td {
    border: 1px solid #ddd;
    padding: 8px;
    text-align: left;
  }
  .table-container th {
    background-color: #f2f2f2;
  }
  .footer {
    margin-top: 50px;
    text-align: center;
    font-size: 12px;
    color: #777;
  }
</style>

<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3, h4 { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; }
  .header-logo { font-family: "DejaVu Serif", "Liberation Serif", Georgia, serif; }
  .section-title { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; font-weight: bold; }
  .byline { font-size: 0.9em; color: #555; }
  .quote { font-style: italic; margin: 20px 0; border-left: 3px solid #ccc; padding-left: 15px; }
  table { width: 100%; border-collapse: collapse; margin-top: 15px; }
  td { padding: 8px 0; }
  .form-group { margin-bottom: 15px; }
  .form-group label { display: block; margin-bottom: 5px; font-weight: bold; }
  .form-group input[type="text"], .form-group input[type="email"], .form-group textarea { width: 100%; padding: 8px; border: 1px solid #ccc; box-sizing: border-box; }
  .two-column { display: flex; justify-content: space-between; }
  .two-column > div { width: 48%; }
</style>
</head>
<body>

<div class="page">
  <div class="header-logo">
    <div class="logo-title">The<br>COMMUNICATOR</div>
    <div class="logo-subtitle">The newsletter of the School of Arts and Communication</div>
  </div>

  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px;">
    <div style="width: 40%;">
      <h3 style="font-size: 18px; margin-bottom: 5px;">Spring 2015</h3>
      <h2 style="font-size: 24px; font-weight: normal; margin-top: 0;">IN THIS ISSUE</h2>
      <ul style="list-style: none; padding: 0; margin-top: 15px;">
        <li style="margin-bottom: 10px;"><a href="#" style="text-decoration: none; color: #333;">Perdigao relishes research award</a> <span style="float: right;">4</span></li>
        <li style="margin-bottom: 10px;"><a href="#" style="text-decoration: none; color: #333;">SAC music director hits high notes</a> <span style="float: right;">7</span></li>
        <li style="margin-bottom: 10px;"><a href="#" style="text-decoration: none; color: #333;">Caza causes commotion in motion</a> <span style="float: right;">8</span></li>
        <li style="margin-bottom: 10px;"><a href="#" style="text-decoration: none; color: #333;">Strahan cherishes roots as career soars</a> <span style="float: right;">10</span></li>
      </ul>
    </div>
    <div style="width: 60%; text-align: right;">
      <h2 class="article-title">School of Arts and<br>Communication takes flight</h2>
      <div class="byline">By <span data-field="author_name">{{ author_name }}</span><br>The Communicator</div>
    </div>
  </div>

  <div class="column-layout">
    <div class="column" style="width: 55%;">
      <img src="placeholder_image.jpg" alt="Article Image" style="width: 100%; height: auto; margin-bottom: 20px;">
      <p>
        <span data-field="article_body_1">{{ article_body_1 }}</span>
      </p>
      <p>
        <span data-field="article_body_2">{{ article_body_2 }}</span>
      </p>
      <p>
        <span data-field="article_body_3">{{ article_body_3 }}</span>
      </p>
      <p>
        <span data-field="article_body_4">{{ article_body_4 }}</span>
      </p>
      <p>
        <span data-field="article_body_5">{{ article_body_5 }}</span>
      </p>
      <p>
        <span data-field="article_body_6">{{ article_body_6 }}</span>
      </p>
    </div>
    <div class="column" style="width: 45%;">
      <img src="placeholder_image_2.jpg" alt="Article Image 2" style="width: 100%; height: auto; margin-bottom: 20px;">
      <p>
        <span data-field="article_body_7">{{ article_body_7 }}</span>
      </p>
      <p>
        <span data-field="article_body_8">{{ article_body_8 }}</span>
      </p>
      <p>
        <span data-field="article_body_9">{{ article_body_9 }}</span>
      </p>
    </div>
  </div>

  <div style="margin-top: 50px;">
    <h3 class="section-title">Save the Date:</h3>
    <div class="table-container">
      <thead>
        <tr>
          <th style="width: 50%;">Event</th>
          <th style="width: 50%;">Details</th>
        </tr>
      </thead>
      <tbody>
        {% for item in calendar_events %}
        <tr>
          <td><span data-field="calendar_events[{{ loop.index0 }}].event_name">{{ calendar_events[loop.index0].event_name }}</span></td>
          <td><span data-field="calendar_events[{{ loop.index0 }}].date_time">{{ calendar_events[loop.index0].date_time }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </div>
  </div>

  <div style="margin-top: 50px;">
    <h3 class="section-title">FACULTY</h3>
    <div class="column-layout">
      <div class="column" style="width: 50%;">
        <h4 style="font-size: 18px; margin-bottom: 10px;">Professors</h4>
        <ul style="list-style: none; padding: 0;">
          {% for prof in faculty_professors %}
          <li style="margin-bottom: 8px;"><span data-field="faculty_professors[{{ loop.index0 }}].name">{{ faculty_professors[loop.index0].name }}</span>, <span data-field="faculty_professors[{{ loop.index0 }}].title">{{ faculty_professors[loop.index0].title }}</span></li>
          {% endfor %}
        </ul>
      </div>
      <div class="column" style="width: 50%;">
        <h4 style="font-size: 18px; margin-bottom: 10px;">Instructors</h4>
        <ul style="list-style: none; padding: 0;">
          {% for instr in faculty_instructors %}
          <li style="margin-bottom: 8px;"><span data-field="faculty_instructors[{{ loop.index0 }}].name">{{ faculty_instructors[loop.index0].name }}</span>, <span data-field="faculty_instructors[{{ loop.index0 }}].title">{{ faculty_instructors[loop.index0].title }}</span></li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>

  <div style="margin-top: 50px;">
    <h3 class="section-title">SCHOOL OF ARTS AND COMMUNICATION FACULTY AND STAFF 2014-2015</h3>
    <div class="column-layout">
      <div class="column" style="width: 50%;">
        <h4 style="font-size: 18px; margin-bottom: 10px;">Associate Professors</h4>
        <ul style="list-style: none; padding: 0;">
          {% for assoc_prof in faculty_associate_professors %}
          <li style="margin-bottom: 8px;"><span data-field="faculty_associate_professors[{{ loop.index0 }}].name">{{ faculty_associate_professors[loop.index0].name }}</span>, <span data-field="faculty_associate_professors[{{ loop.index0 }}].title">{{ faculty_associate_professors[loop.index0].title }}</span></li>
          {% endfor %}
        </ul>
      </div>
      <div class="column" style="width: 50%;">
        <h4 style="font-size: 18px; margin-bottom: 10px;">Visiting Instructors</h4>
        <ul style="list-style: none; padding: 0;">
          {% for visiting_instr in faculty_visiting_instructors %}
          <li style="margin-bottom: 8px;"><span data-field="faculty_visiting_instructors[{{ loop.index0 }}].name">{{ faculty_visiting_instructors[loop.index0].name }}</span>, <span data-field="faculty_visiting_instructors[{{ loop.index0 }}].title">{{ faculty_visiting_instructors[loop.index0].title }}</span></li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>

  <div style="margin-top: 50px;">
    <h3 class="section-title">From the Chair:</h3>
    <p><span data-field="chair_message_1">{{ chair_message_1 }}</span></p>
    <p><span data-field="chair_message_2">{{ chair_message_2 }}</span></p>
    <p><span data-field="chair_message_3">{{ chair_message_3 }}</span></p>
    <p><span data-field="chair_message_4">{{ chair_message_4 }}</span></p>
    <p style="text-align: right;"><span data-field="chair_signature">{{ chair_signature }}</span></p>
  </div>

  <div style="margin-top: 50px;">
    <h3 class="section-title">Education is Our Profession</h3>
    <p><span data-field="education_article_1">{{ education_article_1 }}</span></p>
    <p><span data-field="education_article_2">{{ education_article_2 }}</span></p>
    <p><span data-field="education_article_3">{{ education_article_3 }}</span></p>
    <p><span data-field="education_article_4">{{ education_article_4 }}</span></p>
    <p><span data-field="education_article_5">{{ education_article_5 }}</span></p>
    <p><span data-field="education_article_6">{{ education_article_6 }}</span></p>
    <p><span data-field="education_article_7">{{ education_article_7 }}</span></p>
    <p><span data-field="education_article_8">{{ education_article_8 }}</span></p>
  </div>

  <div style="margin-top: 50px;">
    <h3 class="section-title">FACULTY EXCELLENCE IN RESEARCH AWARD WINNER CONTINUES MOMENTUM</h3>
    <div class="column-layout">
      <div class="column" style="width: 50%;">
        <p><span data-field="research_award_1">{{ research_award_1 }}</span></p>
        <p><span data-field="research_award_2">{{ research_award_2 }}</span></p>
        <p><span data-field="research_award_3">{{ research_award_3 }}</span></p>
        <p><span data-field="research_award_4">{{ research_award_4 }}</span></p>
        <p><span data-field="research_award_5">{{ research_award_5 }}</span></p>
      </div>
      <div class="column" style="width: 50%;">
        <p><span data-field="research_award_6">{{ research_award_6 }}</span></p>
        <p><span data-field="research_award_7">{{ research_award_7 }}</span></p>
        <p><span data-field="research_award_8">{{ research_award_8 }}</span></p>
        <p><span data-field="research_award_9">{{ research_award_9 }}</span></p>
        <p><span data-field="research_award_10">{{ research_award_10 }}</span></p>
      </div>
    </div>
  </div>

  <div style="margin-top: 50px;">
    <h3 class="section-title">Taylor and Ruane's Outstanding European Experience</h3>
    <p><span data-field="taylor_ruane_1">{{ taylor_ruane_1 }}</span></p>
    <p><span data-field="taylor_ruane_2">{{ taylor_ruane_2 }}</span></p>
    <p><span data-field="taylor_ruane_3">{{ taylor_ruane_3 }}</span></p>
    <p><span data-field="taylor_ruane_4">{{ taylor_ruane_4 }}</span></p>
    <p><span data-field="taylor_ruane_5">{{ taylor_ruane_5 }}</span></p>
    <p><span data-field="taylor_ruane_6">{{ taylor_ruane_6 }}</span></p>
  </div>

  <div style="margin-top: 50px;">
    <h3 class="section-title">The Communicator</h3>
    <p><span data-field="communicator_info_1">{{ communicator_info_1 }}</span></p>
    <p><span data-field="communicator_info_2">{{ communicator_info_2 }}</span></p>
  </div>

  <div style="margin-top: 50px;">
    <h3 class="section-title">SCHOOL OF ARTS AND COMMUNICATION TAKES FLIGHT</h3>
    <p><span data-field="flight_article_1">{{ flight_article_1 }}</span></p>
    <p><span data-field="flight_article_2">{{ flight_article_2 }}</span></p>
    <p><span data-field="flight_article_3">{{ flight_article_3 }}</span></p>
    <p><span data-field="flight_article_4">{{ flight_article_4 }}</span></p>
    <p><span data-field="flight_article_5">{{ flight_article_5 }}</span></p>
    <p><span data-field="flight_article_6">{{ flight_article_6 }}</span></p>
  </div>

  <div style="margin-top: 50px;">
    <h3 class="section-title">GOODBYE KATE AND KELSEY! FOR NOW</h3>
    <div class="column-layout">
      <div class="column" style="width: 50%;">
        <img src="placeholder_image_3.jpg" alt="Article Image 3" style="width: 100%; height: auto; margin-bottom: 20px;">
        <p><span data-field="goodbye_kate_1">{{ goodbye_kate_1 }}</span></p>
        <p><span data-field="goodbye_kate_2">{{ goodbye_kate_2 }}</span></p>
        <p><span data-field="goodbye_kate_3">{{ goodbye_kate_3 }}</span></p>
        <p><span data-field="goodbye_kate_4">{{ goodbye_kate_4 }}</span></p>
