<!DOCTYPE html>
<html>
<head>
<title>Newsletter</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    line-height: 1.4;
    color: #333;
  }
  h1, h2, h3 {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    font-weight: bold;
  }
  .header-title {
    font-size: 24pt;
    text-align: center;
    margin-bottom: 10px;
  }
  .header-subtitle {
    font-size: 14pt;
    text-align: center;
    margin-bottom: 40px;
  }
  .section-heading {
    font-size: 14pt;
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
  }
  .column-content {
    display: flex;
    gap: 40px;
    margin-top: 20px;
  }
  .column {
    flex: 1;
    font-size: 10pt;
  }
  .signature-block {
    margin-top: 30px;
    text-align: left;
  }
  .signature-name {
    font-weight: bold;
    font-size: 11pt;
  }
  .signature-title {
    font-size: 9pt;
    font-style: italic;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
    font-size: 10pt;
  }
  th, td {
    padding: 8px;
    text-align: left;
    border-bottom: 1px solid #ddd;
  }
  .center-text {
    text-align: center;
  }
  .footer-text {
    font-size: 8pt;
    text-align: center;
    margin-top: 50px;
  }
</style>
</head>
<body>

<div class="page">
  <div class="header-title">THE CATTLE CALL</div>
  <div class="header-subtitle">Newsletter for Alumni of the TCU Ranch Management Program</div>
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      <div class="section-heading">From the President</div>
      <div class="signature-block">
        <div class="signature-name">{{ president_name }}</div>
        <div class="signature-title">{{ president_title }}</div>
      </div>
      <p style="margin-top: 15px;">{{ president_message }}</p>
    </div>
    <div style="width: 30%;">
      <div class="center-text" style="margin-bottom: 10px;">Spring 2009</div>
      <div style="text-align: center;">
        <img src="placeholder_image.png" alt="Logo" style="width: 100px; height: auto;">
        <p style="font-size: 9pt; margin-top: 5px;">{{ contact_info_1 }}</p>
        <p style="font-size: 9pt;">{{ contact_info_2 }}</p>
      </div>
    </div>
  </div>
</div>

<div class="page">
  <div class="column-content">
    <div class="column">
      <div class="section-heading">{{ section_title_1 }}</div>
      <p>{{ content_1_paragraph_1 }}</p>
      <p>{{ content_1_paragraph_2 }}</p>
      <p>{{ content_1_paragraph_3 }}</p>
      <p>{{ content_1_paragraph_4 }}</p>
    </div>
    <div class="column">
      <div class="section-heading">{{ section_title_2 }}</div>
      <p>{{ content_2_paragraph_1 }}</p>
      <p>{{ content_2_paragraph_2 }}</p>
      <p>{{ content_2_paragraph_3 }}</p>
      <p>{{ content_2_paragraph_4 }}</p>
    </div>
  </div>
</div>

<div class="page">
  <div class="column-content">
    <div class="column">
      <div class="section-heading">{{ section_title_3 }}</div>
      <p>{{ content_3_paragraph_1 }}</p>
      <p>{{ content_3_paragraph_2 }}</p>
      <p>{{ content_3_paragraph_3 }}</p>
    </div>
    <div class="column">
      <div class="section-heading">Unique Design</div>
      <p>{{ unique_design_paragraph_1 }}</p>
      <p>{{ unique_design_paragraph_2 }}</p>
      <p>{{ unique_design_paragraph_3 }}</p>
    </div>
  </div>
</div>

<div class="page">
  <div class="center-text" style="margin-bottom: 30px;">ROUNDUP 2009 SPONSORS</div>
  <p style="text-align: center; font-size: 10pt;">Thanks to our sponsors and their generous contributions for helping to make our evening such a big success.</p>

  <div style="margin-top: 40px;">
    <h3 style="text-align: center; font-size: 12pt;">Wrangler Level</h3>
    <ul style="list-style-type: none; padding: 0; text-align: center;">
      {% for sponsor in wrangler_sponsors %}
        <li style="margin-bottom: 5px;">{{ sponsor.name }}</li>
      {% endfor %}
    </ul>
  </div>

  <div style="margin-top: 40px;">
    <h3 style="text-align: center; font-size: 12pt;">Cowboy Level</h3>
    <ul style="list-style-type: none; padding: 0; text-align: center;">
      {% for sponsor in cowboy_sponsors %}
        <li style="margin-bottom: 5px;">{{ sponsor.name }}</li>
      {% endfor %}
    </ul>
  </div>
</div>

