<div class="page">
  <div style="display: flex; gap: 50px;">
    <div style="flex: 1;">
      <h3 style="font-size: 16pt; margin-bottom: 10px;">Exploring Nature</h3>
      <p style="font-size: 11pt; line-height: 1.5;">
        <p style="font-size: 11pt; line-height: 1.5;">Susan Ansara</p>
