<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3, h4 { margin-top: 0; }
  .center { text-align: center; }
  .right { text-align: right; }
</style>

<div class="page">
  <div class="center">
    <span style="font-size: 18pt; font-weight: bold;">University of Pennsylvania</span>
    <div style="margin: 20px 0;">
      <!-- Placeholder for University Logo -->
      <img src="" alt="University Logo" style="width: 100px; height: auto;">
    </div>
    <span style="font-size: 14pt;">The University Archives and Records Center</span>
  </div>
  <div class="center" style="margin-top: 50px;">
    <span style="font-size: 16pt;">A Guide to the</span>
    <span style="font-size: 16pt;">College of Arts and Sciences.</span>
    <span style="font-size: 16pt;">Student Records (Grade Sheets)</span>
    <span style="font-size: 16pt;">1884-1913</span>
  </div>
  <div class="center" style="margin-top: 50px;">
    <span style="font-size: 12pt;">9.0 Cubic feet</span>
    <br>
    <span style="font-size: 12pt;">UPB 1.71</span>
  </div>
</div>

<div class="page">
  <div style="text-align: left;">
    <span style="font-size: 12pt;">The University Archives and Records Center</span>
    <br>
    <span style="font-size: 12pt;">{{ address_line_1 }}</span>
    <span style="font-size: 12pt;">{{ city_state_zip }}</span>
    <br>
    <span style="font-size: 12pt;">{{ phone_number }}</span>
    <span style="font-size: 12pt;">Fax: {{ fax_number }}</span>
    <br>
    <span style="font-size: 12pt;">{{ website_url }}</span>
    <br>
    <span style="font-size: 12pt;">{{ director_name }}, Director</span>
  </div>
</div>

<div class="page">
  <div class="center" style="margin-bottom: 30px;">
    <span style="font-size: 14pt;">College of Arts and Sciences. Student Records (Grade Sheets)</span>
    <span style="font-size: 12pt;">UPB 1.71</span>
  </div>
  <div class="center" style="margin-bottom: 30px;">
    <span style="font-size: 12pt;">TABLE OF CONTENTS</span>
  </div>
  <table style="width: 100%; border-collapse: collapse;">
    <tr>
      <td style="padding-bottom: 5px;"><span data-field="toc_arrangement">{{ toc_arrangement }}</span></td>
      <td style="width: 100px;">&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;</td>
      <td style="width: 30px; text-align: right;">1</td>
    </tr>
    <tr>
      <td style="padding-bottom: 5px;"><span data-field="toc_scope_note">{{ toc_scope_note }}</span></td>
      <td style="width: 100px;">&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;</td>
      <td style="width: 30px; text-align: right;">1</td>
    </tr>
    <tr>
      <td style="padding-bottom: 5px;"><span data-field="toc_inventory">{{ toc_inventory }}</span></td>
      <td style="width: 100px;">&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;</td>
      <td style="width: 30px; text-align: right;">2</td>
    </tr>
    <tr>
      <td style="padding-bottom: 5px;"><span data-field="toc_inventory_repeat">{{ toc_inventory_repeat }}</span></td>
      <td style="width: 100px;">&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;&mdash;</td>
      <td style="width: 30px; text-align: right;">2</td>
    </tr>
  </table>
</div>

<div class="page">
  <div class="center" style="margin-bottom: 30px;">
    <span style="font-size: 12pt;">College of Arts and Sciences. Student Records (Grade Sheets)</span>
    <span style="font-size: 12pt;">UPB 1.71</span>
  </div>
  <div class="center" style="margin-bottom: 30px;">
    <span style="font-size: 16pt;">Guide to the</span>
    <span style="font-size: 16pt;">College of Arts and Sciences. Student Records (Grade Sheets)</span>
    <span style="font-size: 16pt;">1884-1913</span>
  </div>
  <div class="center" style="margin-top: 30px;">
    <span style="font-size: 12pt;">UPB 1.71</span>
    <br>
    <span style="font-size: 12pt;">9.0 Cubic feet</span>
  </div>
  <div style="margin-top: 50px; text-align: justify;">
    Access is granted in accordance with the <a href="#" style="text-decoration: underline;">Protocols for the University Archives and Records Center</a>.
  </div>
  <div class="center" style="margin-top: 50px;">
    <span style="font-size: 14pt;">ARRANGEMENT</span>
  </div>
  <div style="text-align: justify; margin-top: 20px;">
    This collection has not been fully processed. The following preliminary inventory is available.
  </div>
  <div class="center" style="margin-top: 50px;">
    <span style="font-size: 14pt;">SCOPE AND CONTENT NOTE</span>
  </div>
  <div style="text-align: justify; margin-top: 20px;">
    Courses not given in the college, but taken by College students may be found under their alphabetical listing, under their school, alphabetically listed, or at the end of a school year.
  </div>
</div>

<div class="page">
  <div class="center" style="margin-bottom: 30px;">
    <span style="font-size: 12pt;">College of Arts and Sciences. Student Records (Grade Sheets)</span>
    <span style="font-size: 12pt;">UPB 1.71</span>
  </div>
  <div class="center" style="margin-bottom: 30px;">
    <span style="font-size: 16pt;">College of Arts and Sciences. Student Records (Grade Sheets)</span>
    <span style="font-size: 16pt;">1884-1913</span>
  </div>
  <div class="center" style="margin-top: 30px;">
    <span style="font-size: 12pt;">UPB 1.71</span>
  </div>
  <div style="text-align: justify; margin-top: 50px;">
    Access is granted in accordance with the <a href="#" style="text-decoration: underline;">Protocols for the University Archives and Records Center</a>.
  </div>
  <div class="center" style="margin-top: 50px;">
    <span style="font-size: 14pt;">INVENTORY</span>
  </div>
  <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
    <thead>
      <tr>
        <th style="text-align: left; padding: 8px; border-bottom: 1px solid #000;"></th>
        <th style="text-align: center; padding: 8px; border-bottom: 1px solid #000;">Box</th>
        <th style="text-align: center; padding: 8px; border-bottom: 1px solid #000;">Folder</th>
      </tr>
    </thead>
    <tbody>
      {% for item in inventory_items %}
      <tr>
        <td style="padding: 8px; border-bottom: 1px solid #ddd;">{{ item.description }}</td>
        <td style="text-align: center; padding: 8px; border-bottom: 1px solid #ddd;">{{ item.box }}</td>
        <td style="text-align: center; padding: 8px; border-bottom: 1px solid #ddd;">{{ item.folder }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

<div class="page">
  <div class="center" style="margin-bottom: 30px;">
    <span style="font-size: 12pt;">College of Arts and Sciences. Student Records (Grade Sheets)</span>
    <span style="font-size: 12pt;">UPB 1.71</span>
  </div>
  <div class="center" style="margin-bottom: 30px;">
    <span style="font-size: 14pt;">CCT 1911/1912, 1912/1913</span>
    <span style="font-size: 12pt;">7</span>
  </div>
  <div class="center" style="margin-bottom: 30px;">
    <span style="font-size: 14pt;">Summer Session 1912, 1913</span>
    <span style="font-size: 12pt;">7</span>
  </div>
  <div class="center" style="margin-bottom: 30px;">
    <span style="font-size: 14pt;">1912/1913</span>
    <span style="font-size: 12pt;">7</span>
  </div>
  <div class="center" style="margin-bottom: 30px;">
    <span style="font-size: 14pt;">Record of examinations includes Faculty of Arts and Towne Departments. Lists name, class, and grades. Multicolored cardboard cover and black vinyl spine.</span>
    <span style="font-size: 12pt;">8</span>
  </div>
  <div class="center" style="margin-bottom: 30px;">
    <span style="font-size: 14pt;">Record of examinations includes Faculty of Arts, Towne and Wharton Departments. Lists name, class, and grades. Multicolored cardboard cover and black vinyl spine.</span>
    <span style="font-size: 12pt;">9</span>
  </div>
</div>