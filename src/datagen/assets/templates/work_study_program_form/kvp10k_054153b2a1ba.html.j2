<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  .header { text-align: center; margin-bottom: 30px; }
  .form-section { margin-bottom: 25px; }
  .line-item-row { display: flex; justify-content: space-between; margin-bottom: 10px; }
  .signature-line { border-bottom: 1px solid #000; margin-top: 50px; margin-bottom: 50px; }
</style>

<div class="page">
  <div class="header">
    <div style="text-align: center;">
      <!-- Placeholder for logo/initials -->
      <div style="font-size: 40px; line-height: 1;">N</div>
      <h1 style="font-size: 16px; margin-top: 10px;">OFF-CAMPUS FEDERAL WORK-STUDY PROGRAM</h1>
      <h2 style="font-size: 14px;">REIMBURSEMENT REQUEST FORM</h2>
    </div>
  </div>

  <div class="form-section">
    <p>For period covering <span data-field="period_start">{{ period_start }}</span> to <span data-field="period_end">{{ period_end }}</span></p>
    <p>Total amount of reimbursement (for all students) $ <span data-field="total_reimbursement_amount">{{ total_reimbursement_amount }}</span></p>
  </div>

  <!-- Student 1 Section -->
  <div class="form-section">
    <p>Student Name: <span data-field="student_1_name">{{ student_1_name }}</span></p>
    <p>Number Hours Worked During Period: <span data-field="student_1_hours_worked">{{ student_1_hours_worked }}</span></p>
    <div class="line-item-row">
      <span>Total Wages Earned $</span>
      <span><span data-field="student_1_wages_earned">{{ student_1_wages_earned }}</span></span>
    </div>
    <div class="line-item-row">
      <span>Reimbursement Due $</span>
      <span><span data-field="student_1_reimbursement_due">{{ student_1_reimbursement_due }}</span></span>
    </div>
  </div>

  <!-- Student 2 Section -->
  <div class="form-section">
    <p>Student Name: <span data-field="student_2_name">{{ student_2_name }}</span></p>
    <p>Number Hours Worked During Period: <span data-field="student_2_hours_worked">{{ student_2_hours_worked }}</span></p>
    <div class="line-item-row">
      <span>Total Wages Earned $</span>
      <span><span data-field="student_2_wages_earned">{{ student_2_wages_earned }}</span></span>
    </div>
    <div class="line-item-row">
      <span>Reimbursement Due $</span>
      <span><span data-field="student_2_reimbursement_due">{{ student_2_reimbursement_due }}</span></span>
    </div>
  </div>

  <!-- Student 3 Section -->
  <div class="form-section">
    <p>Student Name: <span data-field="student_3_name">{{ student_3_name }}</span></p>
    <p>Number Hours Worked During Period: <span data-field="student_3_hours_worked">{{ student_3_hours_worked }}</span></p>
    <div class="line-item-row">
      <span>Total Wages Earned $</span>
      <span><span data-field="student_3_wages_earned">{{ student_3_wages_earned }}</span></span>
    </div>
    <div class="line-item-row">
      <span>Reimbursement Due $</span>
      <span><span data-field="student_3_reimbursement_due">{{ student_3_reimbursement_due }}</span></span>
    </div>
  </div>

  <!-- Coordinator Signature Section -->
  <div class="form-section" style="margin-top: 60px;">
    <p>Coordinator Signature: <span data-field="coordinator_signature_placeholder">{{ coordinator_signature_placeholder }}</span></p>
    <p>Date: <span data-field="submission_date">{{ submission_date }}</span></p>
  </div>

  <div class="form-section" style="margin-top: 40px;">
    <p style="font-size: 12px;">(Please attach time sheets for each student with student name, hourly wage, date/hours worked, student signature, and supervisor/coordinator signature.)</p>
  </div>

  <!-- Footer/Contact Info -->
  <div style="margin-top: 80px; font-size: 10px;">
    <p>Send to: <span data-field="contact_email">{{ contact_email }}</span> OR</p>
    <p><span data-field="contact_name">{{ contact_name }}</span></p>
    <p><span data-field="contact_organization">{{ contact_organization }}</span></p>
    <p><span data-field="contact_address_line_1">{{ contact_address_line_1 }}</span></p>
    <p><span data-field="contact_city_state_zip">{{ contact_city_state_zip }}</span></p>
  </div>
</div>