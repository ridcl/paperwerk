<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1, h2 { font-weight: bold; }
  .header-info { display: flex; justify-content: space-between; margin-bottom: 30px; }
  .form-section { margin-bottom: 20px; }
  .field-row { display: flex; margin-bottom: 10px; }
  .field-row > div { flex: 1; }
  .checkbox-group label { margin-right: 15px; }
  .signature-line { border-bottom: 1px solid #000; margin-top: 50px; width: 50%; }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
      <h1 style="font-size: 36px; margin: 0;">U</h1>
      <h1 style="font-size: 36px; margin: 0;">M</h1>
      <h1 style="font-size: 36px; margin: 0;">M</h1 >
      <div style="font-size: 18px; margin-top: -10px;">THE UNIVERSITY OF MEMPHIS.</div>
    </div>
    <div style="text-align: right;">
      <h2 style="font-size: 18px; margin-bottom: 5px;">CHEMICAL HYGIENE PERMIT</h2>
      <p style="font-size: 12px; margin: 0;">For additional assistance or to submit completed form, please contact:</p>
      <p style="font-size: 12px; margin: 0;">Hazardous Materials Specialist</p>
      <p style="font-size: 12px; margin: 0;">Environmental Health & Safety, <span data-field="address">{{ address }}</span></p>
      <p style="font-size: 12px; margin: 0;">PH: <span data-field="phone">{{ phone }}</span> FAX: <span data-field="fax">{{ fax }}</span></p>
    </div>
  </div>

  <div style="margin-top: 30px; font-size: 12px;">
    This Chemical Hygiene Permit is required for any laboratory activities considered to be hazardous in nature.
  </div>

  <div style="margin-top: 20px; font-size: 12px;">
    Hazardous Laboratory Activities may not commence until the permit has been completed, signed, and submitted to Environmental Health and Safety (EHS). This permit is only valid for the days specified, and it must be kept on site during the hazardous laboratory activity.
  </div>

  <div class="form-section">
    <div class="field-row">
      <div style="width: 30%;">Building/Location:</div>
      <div style="width: 70%;"><span data-field="building_location">{{ building_location }}</span></div>
    </div>
    <div class="field-row">
      <div style="width: 30%;">Requesting Person:</div>
      <div style="width: 70%;"><span data-field="requesting_person">{{ requesting_person }}</span></div>
    </div>
    <div class="field-row">
      <div style="width: 30%;">Job Title:</div>
      <div style="width: 70%;"><span data-field="job_title">{{ job_title }}</span></div>
    </div>
    <div class="field-row">
      <div style="width: 30%;">Date of Request:</div>
      <div style="width: 70%;"><span data-field="date_of_request">{{ date_of_request }}</span></div>
    </div>
  </div>

  <div class="form-section">
    <div class="field-row">
      <div style="width: 30%;">Reason for Request (check all that apply):</div>
      <div style="width: 70%;" class="checkbox-group">
        <label><input type="checkbox"> Off-hours work</label>
        <label><input type="checkbox"> Sole occupancy of building</label>
        <label><input type="checkbox"> Hazardous Work</label>
        <label><input type="checkbox"> Unattended Operations</label>
        <label><input type="checkbox"> Other (specify):</label>
      </div>
    </div>
  </div>

  <div class="form-section">
    <div style="margin-bottom: 10px;">Description of activity:</div>
    <div style="border: 1px solid #000; height: 100px; padding: 10px;">
      <span data-field="description_of_activity">{{ description_of_activity }}</span>
    </div>
  </div>

  <div class="form-section">
    <div style="margin-bottom: 10px;">Hazards associated with the activity:</div>
    <div style="border: 1px solid #000; height: 100px; padding: 10px;">
      <span data-field="hazards_associated_with_activity">{{ hazards_associated_with_activity }}</span>
    </div>
  </div>

  <div class="form-section">
    <div style="margin-bottom: 10px;">Special precautions to be implemented:</div>
    <div style="border: 1px solid #000; height: 100px; padding: 10px;">
      <span data-field="special_precautions_to_be_implemented">{{ special_precautions_to_be_implemented }}</span>
    </div>
  </div>

  <div style="margin-top: 40px;">
    <div style="display: flex; align-items: center; margin-bottom: 30px;">
      <span style="font-size: 24px; margin-right: 10px;">&#9679;</span>
      <span style="font-size: 20px; font-weight: bold;">Approved</span>
      <span style="margin-left: 50px; font-size: 24px; margin-right: 10px;">&#9679;</span>
      <span style="font-size: 20px; font-weight: bold;">Rejected</span>
    </div>
  </div>

  <div style="display: flex; justify-content: space-between; margin-top: 50px;">
    <div>
      Lab Supervisor's Signature:
      <div class="signature-line"></div>
      <div style="margin-top: 5px;">Date: <span data-field="date_supervisor_signature">{{ date_supervisor_signature }}</span></div>
    </div>
    <div>
      Dept. Chair's Signature:
      <div class="signature-line"></div>
      <div style="margin-top: 5px;">Date: <span data-field="date_chair_signature">{{ date_chair_signature }}</span></div>
    </div>
  </div>

  <div style="display: flex; justify-content: space-between; margin-top: 50px;">
    <div>
      Permit Issue Date: <span data-field="permit_issue_date">{{ permit_issue_date }}</span>
    </div>
    <div>
      Permit Expiration Date: <span data-field="permit_expiration_date">{{ permit_expiration_date }}</span>
    </div>
  </div>

  <div style="margin-top: 100px; font-size: 10px; text-align: right;">
    Chemical Hygiene Permit &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Updated September 2015
  </div>
</div>