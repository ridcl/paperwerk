    <thead>
      <tr>
        <td style="width: 30%;">Dates</td>
        <td style="width: 70%;">Position/Institution</td>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="positions[0].dates">{{ positions[0].dates }}</span></td>
        <td><span data-field="positions[0].description">{{ positions[0].description }}</span></td>
      </tr>
