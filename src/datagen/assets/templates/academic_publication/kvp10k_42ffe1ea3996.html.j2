<!DOCTYPE html>
<html>
<head>
<title>Document</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    line-height: 1.5;
    color: #000;
  }
  h1, h2, h3, h4 {
    font-weight: bold;
    margin-top: 0.5em;
    margin-bottom: 0.5em;
  }
  .contact-info p {
    margin: 2px 0;
  }
  .section-title {
    font-weight: bold;
    margin-top: 1em;
    margin-bottom: 0.5em;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1em;
  }
  td {
    padding: 5px 0;
  }
  .list-item {
    margin-bottom: 0.5em;
  }
</style>

<style>
  @page { size: A4; margin: 0; }
