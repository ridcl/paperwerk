    <p>Work Address: <span data-field="work_address">{{ work_address }}</span></p>
    <p>Email: <span data-field="email">{{ email }}</span></p>
    <p>Phone: <span data-field="phone">{{ phone }}</span></p>
    <p>Fax: <span data-field="fax">{{ fax }}</span></p>
    <p>Website: <span data-field="website">{{ website }}</span></p>
  </div>

  <div class="section-title">Current Academic and Research Positions:</div>
