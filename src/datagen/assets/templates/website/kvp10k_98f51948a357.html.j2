<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  /* Basic styling to mimic layout structure */
  h1, h2, h3 {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial;
  }
  .header-nav a {
    font-family: "DejaVu Sans", "Liberation Sans", Arial, "Helvetica";
  }
  .content-section {
    margin-bottom: 30px;
  }
  .sidebar {
    width: 30%; /* Approximate width for sidebar content */
    float: left;
    padding-right: 20px;
  }
  .main-content {
    width: 68%; /* Approximate width for main content */
    float: right;
  }
  .form-group {
    margin-bottom: 15px;
  }
  .form-group label {
    display: block;
    margin-bottom: 5px;
    font-weight: bold;
  }
  .form-group input[type="text"], .form-group input[type="password"] {
    width: 100%;
    padding: 8px;
    box-sizing: border-box;
    border: 1px solid #ccc;
  }
  .button {
    padding: 10px 20px;
    background-color: #0056b3;
    color: white;
    border: none;
    cursor: pointer;
    font-family: "DejaVu Sans", "Liberation Sans", Arial, "Helvetica";
  }
  .table-container {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
  }
  .table-container th, .table-container td {
    border: 1px solid #ddd;
    padding: 8px;
    text-align: left;
  }
  .table-container th {
    background-color: #f2f2f2;
  }
</style>

<div class="page">
  <div style="text-align: center; margin-bottom: 50px;">
    <h1>Internet Resources</h1>
    <p>Go to: <span data-field="website_url">{{ website_url }}</span></p>
  </div>
  <!-- Mocking the visual structure of the first image -->
  <div style="display: flex; height: 400px; border: 1px solid #ccc;">
    <div style="width: 30%; background-color: #f9f9f9; padding: 20px; border-right: 1px solid #ccc;">
      <h3 style="text-align: center;">Apply Today!</h3>
      <div style="margin-top: 20px;">
        <p>Prospective Students</p>
        <p>Adult Learners</p>
        <p>Graduate Students</p>
        <p>International Students</p>
        <p>Parents & Guardians</p>
        <p>Padres y Guardianes</p>
      </div>
    </div>
    <div style="width: 70%; background-color: #e0e0e0; padding: 20px;">
      <!-- Content area for the main visual -->
      <p>Visual content placeholder...</p>
      <div style="margin-top: 30px;">
        <p>Legendary Novelist Tom Robbins to Lecture at Doane</p>
        <p>First Students Begin New RN to BSN Program</p>
        <p>Fifteen-Year-Old Doane Student Wins Year From Biochemistry Degree</p>
        <p>Doane, CAMC Create Athletic Training Outreach Program</p>
        <p>Fulbright Scholar in Residence Lends Insight to Arab Culture</p>
      </div>
      <div style="margin-top: 40px;">
        <p>Class Cancellations Will Be Posted HERE!</p>
        <h4 style="text-align: center;">EVENTS</h4>
        <table class="table-container">
          <thead>
            <tr>
              <th>Date</th>
              <th>Event</th>
            </tr>
          </thead>
          <tbody>
            {% for event in events %}
            <tr>
              <td>{{ event.date }}</td>
              <td>{{ event.description }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

