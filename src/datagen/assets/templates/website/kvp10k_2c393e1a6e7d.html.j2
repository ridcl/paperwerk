<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <div style="width: 50%;">
      <h3 class="section-title">Update Direct Deposit Allocation</h3>
      <p>RELEASE: {{ release_version }}</p>
    </div>
    <div style="width: 45%; text-align: right;">
      <div style="border: 1px solid #ccc; padding: 10px; background-color: #f9f9f9;">
        <p>RETURN TO MENU | SITE MAP | HELP | EXIT</p>
      </div>
    </div>
  </div>

  <div style="margin-top: 30px;">
    <p>14. If your pay is currently direct deposited and you wish to make changes, click 'Update Direct Deposit Allocation' on the 'View Direct Deposit Information' screen. To make changes, repeat steps 10-13 above.</p>
  </div>

  <div style="margin-top: 30px;">
    <h3 class="section-title">View Direct Deposit Information</h3>
    <p>The following accounts are listed in the order in which your pay will be distributed.</p>
    <table>
      <thead>
        <tr>
          <th>Bank Name</th>
          <th>Routing Number</th>
          <th>Account Number</th>
          <th>Type</th>
          <th>Priority</th>
          <th>Amount or Percent</th>
          <th>Net Pay Distribution</th>
        </tr>
      </thead>
      <tbody>
        {% for item in direct_deposit_allocations %}
        <tr>
          <td><span data-field="direct_deposit_allocations[{{ loop.index0 }}].bank_name">{{ item.bank_name }}</span></td>
          <td><span data-field="direct_deposit_allocations[{{ loop.index0 }}].routing_number">{{ item.routing_number }}</span></td>
          <td><span data-field="direct_deposit_allocations[{{ loop.index0 }}].account_number">{{ item.account_number }}</span></td>
          <td><span data-field="direct_deposit_allocations[{{ loop.index0 }}].account_type">{{ item.account_type }}</span></td>
          <td><span data-field="direct_deposit_allocations[{{ loop.index0 }}].priority">{{ item.priority }}</span></td>
          <td><span data-field="direct_deposit_allocations[{{ loop.index0 }}].amount_or_percent">{{ item.amount_or_percent }}</span></td>
          <td><span data-field="direct_deposit_allocations[{{ loop.index0 }}].net_pay_distribution">{{ item.net_pay_distribution }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    <div style="text-align: right; margin-top: 20px;">
      <button>Update Direct Deposit Allocation</button>
    </div>
  </div>
</div>

