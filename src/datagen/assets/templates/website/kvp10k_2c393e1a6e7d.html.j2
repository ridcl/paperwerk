<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  td, th {
    padding: 8px;
    text-align: left;
  }
  .header {
    font-weight: bold;
    font-size: 1.2em;
    margin-bottom: 15px;
  }
  .section-title {
    font-weight: bold;
    margin-top: 20px;
    margin-bottom: 10px;
  }
  .input-group {
    margin-bottom: 15px;
  }
  .input-group label {
    display: block;
    margin-bottom: 5px;
    font-weight: normal;
  }
  .input-group input[type="text"], .input-group select {
    width: 100%;
    padding: 8px;
    box-sizing: border-box;
    border: 1px solid #ccc;
  }
  .button-bar button {
    padding: 10px 20px;
    margin-right: 10px;
    cursor: pointer;
    border: 1px solid #ccc;
    background-color: #f0f0f0;
  }
  .alert {
    padding: 15px;
    border: 1px solid #ffc107;
    background-color: #fff3cd;
    margin-bottom: 20px;
  }
</style>

<div class="page">
  <div style="text-align: center; margin-bottom: 40px;">
    <h1 style="font-size: 2em;">{{ institution_name }}</h1>
    <p>Connect in a community committed to student success.</p>
  </div>

  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px;">
    <div style="width: 60%;">
      <h2 class="header">Welcome to the {{ campus_name }} campus</h2>
      <p>You will need to use at least {{ required_browser_version }} to browse this web.</p>
      <p>Please do not use Internet Explorer ver. 7 with Banner until further notice.</p>
      <p>You must have cookies enabled on your browser.</p>
    </div>
    <div style="width: 35%; text-align: right;">
      <div style="border: 1px solid #ccc; padding: 10px; background-color: #f9f9f9;">
        <p>Students thrive in a responsive, friendly environment with academic and peer mentoring, caring staff, approachable administration, and an extensive network of student clubs and activities.</p>
        <button style="margin-top: 10px;">NEXT</button>
      </div>
    </div>
  </div>

  <div style="display: flex; justify-content: space-between; margin-bottom: 40px;">
    <div style="width: 45%;">
      <h3 class="section-title">Contact Information:</h3>
      <p>Human Resources</p>
      <p>{{ contact_phone }}</p>
    </div>
    <div style="width: 45%; text-align: right;">
      <h3 class="section-title">BPR Website:</h3>
      <p><a href="{{ bpr_website_url }}">{{ bpr_website_url }}</a></p>
    </div>
  </div>
</div>

<div class="page">
  <div style="text-align: center; margin-bottom: 30px;">
    <h2 class="header">User Login</h2>
  </div>

  <div class="input-group">
    <label for="user_id">User ID:</label>
    <input type="text" id="user_id" value="{{ user_id }}">
  </div>

  <div class="input-group">
    <label for="pin">PIN:</label>
    <input type="password" id="pin" value="{{ pin }}">
  </div>

  <div style="display: flex; justify-content: space-between; margin-top: 20px;">
    <button>Login</button>
    <button>Forgot PIN?</button>
  </div>

  <div style="margin-top: 40px; font-size: 0.9em;">
    <p>RELEASE: {{ release_version }}</p>
    <p style="text-align: right;">POWERED BY SUNGARD HIGHER EDUCATION</p>
  </div>
</div>

