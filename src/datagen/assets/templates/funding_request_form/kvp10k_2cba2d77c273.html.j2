<style>
    @page { size: A4; margin: 0; }
    .page {
        width: 794px; height: 1123px;
        padding: 50px 60px; box-sizing: border-box;
        overflow: hidden; page-break-after: always;
        position: relative;
        font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
    }
    .page:last-child { page-break-after: auto; }
    table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
    td { padding: 5px 0; }
    .header { font-weight: bold; }
</style>
<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px;">
        <div>
            <div style="font-size: 10px; margin-bottom: 5px;">IFR #</div>
            <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
                <span data-field="ifr_number">{{ ifr_number }}</span>
            </div>
            <div style="font-size: 10px; margin-top: 5px;">(Finance Office Only)</div>
        </div>
        <div style="text-align: right;">
            <img src="placeholder_seal.png" alt="Seal" style="width: 100px; height: auto;">
        </div>
    </div>

    <h1 style="text-align: center; margin-bottom: 5px;">Graziadio School of Business and Management</h1>
    <h2 style="text-align: center; margin-top: 0; margin-bottom: 20px;">Incremental Funding Request Form</h2>
    <p style="text-align: center; font-size: 12px; margin-bottom: 30px;">EXISTING POSITION MODIFICATION - NON-EXEMPT EMPLOYEE</p>

    <div style="display: flex; justify-content: space-between; margin-bottom: 30px;">
        <div style="width: 30%;">
            <p>Requester Name</p>
            <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
                <span data-field="requester_name">{{ requester_name }}</span>
            </div>
        </div>
        <div style="width: 30%;">
            <p>Signature Level <span style="font-size: 10px;">(Finance Office Only)</span></p>
            <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
                <span data-field="signature_level">{{ signature_level }}</span>
            </div>
        </div>
        <div style="width: 30%;">
            <p>Fiscal Year</p>
            <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
                <span data-field="fiscal_year">{{ fiscal_year }}</span>
            </div>
        </div>
    </div>

    <div style="display: flex; justify-content: space-between; margin-bottom: 20px;">
        <div style="width: 30%;">
            <p>Department ID</p>
            <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
                <span data-field="department_id">{{ department_id }}</span>
            </div>
        </div>
        <div style="width: 30%;">
            <p>Department Name</p>
            <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
                <span data-field="department_name">{{ department_name }}</span>
            </div>
        </div>
    </div>

    <table style="margin-bottom: 30px;">
        <tr>
            <td style="width: 25%;">Salary-Change $</td>
            <td style="width: 25%;">Non-Salary*</td>
            <td style="width: 25%;">Equip. Allowance <span style="font-size: 10px;">(Finance Office Only)</span></td>
            <td style="width: 25%;">Burden <span style="font-size: 10px;">(Finance Office Only)</span></td>
        </tr>
        <tr>
            <td colspan="4" style="border-bottom: 1px solid #000;">
                <span style="font-size: 10px;">*Other non-salary forms of compensation (i.e. relocation allowance, tuition assistance, etc.)</span>
            </td>
        </tr>
        <tr>
            <td colspan="4" style="padding-top: 10px;">
                <p>Name of Incumbent</p>
                <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
                    <span data-field="incumbent_name">{{ incumbent_name }}</span>
                </div>
            </td>
        </tr>
    </table>

    <div style="display: flex; justify-content: space-between; margin-bottom: 30px;">
        <div style="width: 48%;">
            <p>Current Position Title</p>
            <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
                <span data-field="current_position_title">{{ current_position_title }}</span>
            </div>
            <p>Current Hourly Rate</p>
            <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
                <span data-field="current_hourly_rate">{{ current_hourly_rate }}</span>
            </div>
            <p>Change - $</p>
            <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
                <span data-field="change_amount">{{ change_amount }}</span>
            </div>
            <p>Current Annualized Salary excluding burden</p>
            <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
                <span data-field="current_annualized_salary">{{ current_annualized_salary }}</span>
            </div>
            <p>Short Description (300 Characters Max)</p>
            <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
                <span data-field="short_description">{{ short_description }}</span>
            </div>
        </div>
        <div style="width: 48%;">
            <p>Proposed Position Title</p>
            <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
                <span data-field="proposed_position_title">{{ proposed_position_title }}</span>
            </div>
            <p>Proposed Hourly Rate</p>
            <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
                <span data-field="proposed_hourly_rate">{{ proposed_hourly_rate }}</span>
            </div>
            <p>Change - % 0.00%</p>
            <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
                <span data-field="change_percentage">{{ change_percentage }}</span>
            </div>
            <p>Proposed Annualized Salary excluding burden</p>
            <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
                <span data-field="proposed_annualized_salary">{{ proposed_annualized_salary }}</span>
            </div>
        </div>
    </div>

    <div style="margin-bottom: 30px;">
        <p>Strategic Rationale: (Choose One)</p>
        <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
            <span data-field="strategic_rationale">{{ strategic_rationale }}</span>
        </div>
    </div>

    <div style="margin-bottom: 30px;">
        <p>Why are you pursuing this action?</p>
        <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
            <span data-field="reason_for_action">{{ reason_for_action }}</span>
        </div>
    </div>

    <p style="margin-bottom: 30px;">Please substantiate the requested amount.</p>
</div>

<div class="page">
    <h2 style="text-align: center; margin-bottom: 40px;">SUPPLEMENTAL QUESTIONS</h2>

    <div style="margin-bottom: 30px;">
        <p>Office Space</p>
        <p>Will this position modification result in a change of office assignments? <span data-field="office_space_change_yes">{{ office_space_change_yes }}</span></p>
        <p>If "Yes," please indicate a preferred campus location:</p>
        <div style="border: 1px solid #000; height: 150px; padding: 10px; margin-top: 10px;">
            <span data-field="office_space_considerations">{{ office_space_considerations }}</span>
        </div>
        <p>Campus Location:</p>
        <div style="border-bottom: 1px solid #000; padding-bottom: 5px;">
            <span data-field="campus_location">{{ campus_location }}</span>
        </div>
    </div>

    <div style="margin-bottom: 30px;">
        <p>Cellphone Allowance</p>
        <p>Will you be requesting a cellphone allowance for this position? <span data-field="cellphone_allowance_yes">{{ cellphone_allowance_yes }}</span></p>
    </div>
</div>