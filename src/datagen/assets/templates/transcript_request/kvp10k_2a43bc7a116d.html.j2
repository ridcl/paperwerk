<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif; }
  h1, h2 { font-weight: bold; }
  .form-row { display: flex; margin-bottom: 10px; }
  .form-row > div { flex: 1; padding-right: 20px; }
  .label { font-weight: normal; }
  .input-line { border-bottom: 1px solid #000; display: inline-block; width: 100%; }
</style>

<div class="page">
  <header>
    <h1>Request for Official Lambuth Transcript</h1>
    <p>
      <span data-field="institution_name_1">{{ institution_name_1 }}</span>, <span data-field="institution_address">{{ institution_address }}</span><br>
      Phone: <span data-field="phone_number">{{ phone_number }}</span> / Fax: <span data-field="fax_number">{{ fax_number }}</span>
    </p>
  </header>

  <section style="margin-top: 30px;">
    <p>
      Processing – Complete the Student Information and Recipient Information sections (print or type into the form), sign the form, and send it to the address above. Please allow up to 2 weeks to process your request(s). Any transcript released directly to you will have ISSUED TO STUDENT stamped or printed on it.
    </p>
  </section>

  <section style="margin-top: 30px;">
    <h2>Student Information:</h2>
    <div class="form-row">
      <div style="width: 25%;">
        <span class="label">Name:</span> <span class="input-line">&nbsp;</span>
      </div>
      <div style="width: 25%;">
        <span class="label">Last:</span> <span class="input-line">&nbsp;</span>
      </div>
      <div style="width: 25%;">
        <span class="label">First:</span> <span class="input-line">&nbsp;</span>
      </div>
      <div style="width: 25%;">
        <span class="label">Middle:</span> <span class="input-line">&nbsp;</span>
      </div>
    </div>

    <div class="form-row">
      <div style="width: 30%;">
        <span class="label">Lambuth Student ID:</span> <span class="input-line">&nbsp;</span>
      </div>
      <div style="width: 10%;">
        <span class="label">or</span>
      </div>
      <div style="width: 60%;">
        <span class="label">Last 4 Digits of SSN:</span> <span class="input-line">&nbsp;</span>
      </div>
    </div>

    <div class="form-row">
      <div style="width: 25%;">
        <span class="label">Contact Info:</span> <span class="input-line">&nbsp;</span>
      </div>
      <div style="width: 25%;">
        <span class="label">Street Address:</span> <span class="input-line">&nbsp;</span>
      </div>
    </div>

    <div class="form-row">
      <div style="width: 25%;">
        <span class="label">City:</span> <span class="input-line">&nbsp;</span>
      </div>
      <div style="width: 25%;">
        <span class="label">State:</span> <span class="input-line">&nbsp;</span>
      </div>
      <div style="width: 25%;">
        <span class="label">Zip:</span> <span class="input-line">&nbsp;</span>
      </div>
    </div>

    <div class="form-row">
      <div style="width: 25%;">
        <span class="label">E-mail:</span> <span class="input-line">&nbsp;</span>
      </div>
      <div style="width: 25%;">
        <span class="label">Ph: ( &nbsp; ) &nbsp; - &nbsp; &nbsp;</span> <span class="input-line">&nbsp;</span>
      </div>
    </div>

    <div class="form-row">
      <div style="width: 25%;">
        <span class="label">Birth Date:</span> <span class="input-line">MM-DD-YY:</span>
      </div>
    </div>

    <div class="form-row" style="margin-top: 15px;">
      <div style="width: 100%;">
        <span class="label">List ALL Former Names:</span> <span class="input-line" style="width: 100%;" data-field="list_all_former_names">{{ list_all_former_names }}</span>
      </div>
    </div>

    <div class="form-row" style="margin-top: 20px;">
      <div style="width: 100%;">
        <span class="label">Date of Graduation or Last Year Attended:</span> <span class="input-line" style="width: 50%;" data-field="list_all_former_names_2">{{ list_all_former_names_2 }}</span>
      </div>
    </div>
  </section>

  <section style="margin-top: 40px;">
    <h2>Recipient Information:</h2>
    <div style="border: 1px solid #000; padding: 10px; margin-bottom: 20px;">
      <div style="height: 100px; border-bottom: 1px solid #000;" data-field="recipient_information">{{ recipient_information }}</div>
      <div style="height: 100px; border-bottom: 1px solid #000;" data-field="recipient_information_2">{{ recipient_information_2 }}</div>
      <div style="height: 100px; border-bottom: 1px solid #000;" data-field="recipient_information_3">{{ recipient_information_3 }}</div>
      <div style="height: 100px; border-bottom: 1px solid #000;" data-field="recipient_information_4">{{ recipient_information_4 }}</div>
      <div style="height: 100px; border-bottom: 1px solid #000;" data-field="field_1">{{ field_1 }}</div>
      <div style="height: 100px; border-bottom: 1px solid #000;" data-field="field_2">{{ field_2 }}</div>
      <div style="float: right; margin-top: 10px;">[ <span data-field="recipient_count">{{ recipient_count }}</span> ]</div>
    </div>

    <div style="border: 1px solid #000; padding: 10px; margin-bottom: 20px;">
      <div style="height: 100px; border-bottom: 1px solid #000;" data-field="field_3">{{ field_3 }}</div>
      <div style="height: 100px; border-bottom: 1px solid #000;" data-field="field_4">{{ field_4 }}</div>
      <div style="height: 100px; border-bottom: 1px solid #000;" data-field="field_5">{{ field_5 }}</div>
      <div style="height: 100px; border-bottom: 1px solid #000;" data-field="field_6">{{ field_6 }}</div>
      <div style="height: 100px; border-bottom: 1px solid #000;" data-field="field_7">{{ field_7 }}</div>
      <div style="height: 100px; border-bottom: 1px solid #000;" data-field="field_8">{{ field_8 }}</div>
      <div style="float: right; margin-top: 10px;">[ <span data-field="recipient_count_2">{{ recipient_count_2 }}</span> ]</div>
    </div>

    <div style="margin-top: 20px;">
      <p style="font-style: italic;">(Attach additional addresses if necessary.)</p>
    </div>
  </section>

  <footer style="margin-top: 50px;">
    <div class="form-row">
      <div style="width: 50%;">
        <span class="label">Signature (Required):</span> <span class="input-line">&nbsp;</span>
      </div>
      <div style="width: 50%; text-align: right;">
        <span class="label">Date:</span> <span class="input-line">&nbsp;</span>
      </div>
    </div>

    <div style="margin-top: 40px;">
      <p><strong>For Office Use Only:</strong></p>
      <div class="form-row">
        <div style="width: 50%;">
          Processed by: <span class="input-line">&nbsp;</span>
        </div>
        <div style="width: 50%;">
          Sent: <span class="input-line">&nbsp;</span>
        </div>
      </div>
    </div>
    <p style="text-align: center; margin-top: 50px; font-size: small;">An Equal Opportunity/Affirmative Action University</p>
  </footer>
</div>