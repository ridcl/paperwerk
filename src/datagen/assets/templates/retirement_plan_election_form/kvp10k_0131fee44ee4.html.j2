<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1 { text-align: center; font-size: 24pt; margin-bottom: 5px; }
  h2 { font-size: 14pt; margin-top: 20px; margin-bottom: 10px; }
  table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
  td { padding: 5px 0; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 10px; }
  .label { width: 30%; }
  .input-area { width: 65%; }
  .signature-line { border-bottom: 1px solid black; margin-top: 50px; }
</style>

<div class="page">
  <h1>Augustana College</h1>
  <h2>RETIREMENT PLAN ELECTION FORM</h2>

  <table>
    <tr>
      <td style="width: 30%;">Employee Information</td>
      <td style="width: 70%;"></td>
    </tr>
    <tr>
      <td>Date Requested:</td>
      <td><span data-field="date_requested">{{ date_requested }}</span></td>
    </tr>
    <tr>
      <td>Employee Name:</td>
      <td><span data-field="full_name">{{ full_name }}</span></td>
    </tr>
    <tr>
      <td>Department:</td>
      <td><span data-field="department">{{ department }}</span></td>
    </tr>
    <tr>
      <td>Employee ID:</td>
