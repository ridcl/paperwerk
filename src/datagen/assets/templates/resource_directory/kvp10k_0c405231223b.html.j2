<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Addiction Resources</title>
<style>
  @page { size: A4; margin: 0; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: "Liberation Sans", "DejaVu Sans", Arial, Helvetica, sans-serif; font-size: 13px; color: #222; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }

  h1.doc-title {
    text-align: center;
    font-size: 22px;
    font-weight: bold;
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
    margin-bottom: 8px;
  }
  .disclaimer {
    text-align: center;
    font-style: italic;
    font-size: 11.5px;
    color: #333;
    line-height: 1.5;
    margin-bottom: 18px;
  }
  .city-heading {
    text-align: center;
    font-size: 18px;
    font-weight: bold;
    color: #1a8fa0;
    margin-bottom: 18px;
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
  }
  .city-heading .subtitle {
    font-size: 14px;
    font-weight: normal;
    color: #1a8fa0;
  }
  .two-col {
    display: flex;
    gap: 30px;
  }
  .col {
    flex: 1;
  }
  .resource-entry {
    margin-bottom: 18px;
  }
  .resource-name {
    font-weight: bold;
    color: #1a8fa0;
    font-size: 13px;
    margin-bottom: 2px;
    line-height: 1.4;
  }
  .resource-detail {
    font-size: 13px;
    color: #222;
    line-height: 1.6;
  }
  .page-footer {
    position: absolute;
    bottom: 30px;
    left: 0; right: 0;
    text-align: center;
    font-size: 11.5px;
    color: #444;
    line-height: 1.6;
  }
</style>

<style>
