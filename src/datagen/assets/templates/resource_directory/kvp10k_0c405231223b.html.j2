  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: "Liberation Sans", "DejaVu Sans", Arial, Helvetica, sans-serif; font-size: 13px; color: #222; }
  .page {
    width: 794px; height: 1123px;
