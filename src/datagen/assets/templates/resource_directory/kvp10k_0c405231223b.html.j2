    font-size: 20px;
    font-weight: bold;
    color: #1a7fa0;
    margin-bottom: 22px;
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
  }
  .city-heading-left {
    font-size: 20px;
    font-weight: bold;
    color: #1a7fa0;
    margin-bottom: 14px;
    font-family: "Liberation Serif", "DejaVu Serif", Georgia, serif;
  }
  .two-col {
    display: flex;
    gap: 0;
  }
  .col {
    flex: 1;
    padding-right: 20px;
  }
  .col:last-child { padding-right: 0; }

  .resource-block {
    margin-bottom: 20px;
  }
  .resource-name {
    font-weight: bold;
    color: #1a7fa0;
    font-size: 13px;
    margin-bottom: 2px;
    line-height: 1.4;
  }
  .resource-detail {
    font-size: 13px;
    line-height: 1.6;
    color: #222;
  }

  .footer {
    position: absolute;
    bottom: 40px;
    left: 0; right: 0;
    text-align: center;
    font-size: 12px;
    color: #333;
    line-height: 1.6;
  }

  .city-heading-small {
    font-size: 14px;
    font-weight: normal;
    color: #1a7fa0;
  }
</style>
</head>
<body>

{# ===================== PAGE 1 ===================== #}
<div class="page">
  <h1 class="doc-title">Addiction Resources</h1>
  <p class="disclaimer">
    These resources are provided for informational purposes only. They do not constitute an endorsement or approval by the<br>
    New Mexico Health Care Authority for any of the services or opinions of the corporation or organization.
  </p>

  <div class="city-heading">
    <span data-field="pages[0].city_heading">{{ pages[0].city_heading }}</span>
  </div>

  <div class="two-col">
    <div class="col">
      {% for entry in pages[0].left_entries %}
      <div class="resource-entry">
        <div class="resource-name"><span data-field="pages[0].left_entries[{{ loop.index0 }}].name">{{ entry.name }}</span></div>
        <div class="resource-detail">
          {% if entry.website %}<span data-field="pages[0].left_entries[{{ loop.index0 }}].website">{{ entry.website }}</span><br>{% endif %}
          {% if entry.address %}<span data-field="pages[0].left_entries[{{ loop.index0 }}].address">{{ entry.address }}</span><br>{% endif %}
          {% if entry.phone %}<span data-field="pages[0].left_entries[{{ loop.index0 }}].phone">{{ entry.phone }}</span>{% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
    <div class="col">
      {% for entry in pages[0].right_entries %}
      <div class="resource-entry">
        <div class="resource-name"><span data-field="pages[0].right_entries[{{ loop.index0 }}].name">{{ entry.name }}</span></div>
        <div class="resource-detail">
          {% if entry.website %}<span data-field="pages[0].right_entries[{{ loop.index0 }}].website">{{ entry.website }}</span><br>{% endif %}
          {% if entry.address %}<span data-field="pages[0].right_entries[{{ loop.index0 }}].address">{{ entry.address }}</span><br>{% endif %}
          {% if entry.phone %}<span data-field="pages[0].right_entries[{{ loop.index0 }}].phone">{{ entry.phone }}</span>{% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>

  <div class="page-footer">
    <span data-field="footer.program">{{ footer.program }}</span><br>
    <span data-field="footer.department">{{ footer.department }}</span><br>
    <span data-field="footer.date">{{ footer.date }}</span>
  </div>
</div>

