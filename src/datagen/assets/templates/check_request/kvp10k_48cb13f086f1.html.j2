<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1, h2, h3 { text-align: center; margin-bottom: 20px; }
  .header-info { display: flex; justify-content: space-between; margin-bottom: 40px; }
  .address-block { text-align: center; }
  .section-title { font-weight: bold; margin-bottom: 10px; }
  .form-row { display: flex; justify-content: space-between; margin-bottom: 15px; }
  .form-label { width: 30%; }
  .form-input { width: 65%; border-bottom: 1px solid #000; }
  .divider { border-top: 1px solid #000; margin: 20px 0; }
  .signature-area { margin-top: 50px; }
  .signature-line { display: flex; justify-content: space-between; margin-bottom: 50px; }
  .signature-box { width: 45%; text-align: center; }
  .small-text { font-size: 0.8em; margin-top: 20px; }
</style>
<body>
  <div class="page">
    <div class="address-block">
      <span data-field="organization.name">{{ organization.name }}</span>
      <div style="text-align: center;">
        <span data-field="organization.street_address">{{ organization.street_address }}</span><br>
        <span data-field="organization.city_state_zip">{{ organization.city_state_zip }}</span>
      </div>
    </div>

    <div class="header-info">
      <div>
        <div class="section-title">PURCHASING DEPARTMENT</div>
        <div class="form-row">
          <div class="form-label">TELEPHONE #:</div>
          <div class="form-input">{{ purchasing_phone }}</div>
        </div>
        <div class="form-row">
          <div class="form-label">FAX #:</div>
          <div class="form-input">{{ purchasing_fax }}</div>
        </div>
      </div>
      <div>
        <div class="section-title">ACCOUNTS PAYABLE DEPARTMENT</div>
        <div class="form-row">
          <div class="form-label">TELEPHONE #:</div>
          <div class="form-input">{{ ap_phone }}</div>
        </div>
        <div class="form-row">
          <div class="form-label">FAX #:</div>
          <div class="form-input">{{ ap_fax }}</div>
        </div>
      </div>
    </div>

    <h1 style="text-align: center; margin-top: 50px;">CHECK REQUEST</h1>

    <div class="form-row" style="margin-top: 40px;">
      <div style="width: 30%;">ORGANIZATION NAME:</div>
      <div style="width: 65%; border-bottom: 1px solid #000;">
        <span data-field="organization_name_input">{{ organization_name_input }}</span>
        <span style="font-size: 0.9em;">(If Applicable, Student Organizations Only)</span>
      </div>
    </div>

    <div class="form-row">
      <div style="width: 30%;">ID#:</div>
      <div style="width: 65%; border-bottom: 1px solid #000;">
        <span data-field="id_number">{{ id_number }}</span>
      </div>
    </div>

    <div class="form-row">
      <div style="width: 30%;">PAYABLE TO:</div>
      <div style="width: 65%; border-bottom: 1px solid #000;">
        <span data-field="payee_name">{{ payee_name }}</span>
      </div>
    </div>

    <div class="form-row">
      <div style="width: 30%;">DATE NEEDED:</div>
      <div style="width: 65%; border-bottom: 1px solid #000;">
        <span data-field="date_needed">{{ date_needed }}</span>
      </div>
    </div>

    <div class="form-row">
      <div style="width: 30%;">DESCRIPTION:</div>
      <div style="width: 65%; border-bottom: 1px solid #000;">
        <span data-field="description_line_1">{{ description_line_1 }}</span>
      </div>
    </div>

    <div class="divider"></div>

    <div class="form-row" style="margin-top: 20px;">
      <div style="width: 30%;">Total</div>
      <div style="width: 65%; text-align: right;">$ <span data-field="total_amount">{{ total_amount }}</span></div>
    </div>

    <div class="form-row" style="margin-top: 30px;">
      <div style="width: 30%;">REQUESTED BY:</div>
      <div style="width: 65%; border-bottom: 1px solid #000;">
        <span data-field="requested_by_name">{{ requested_by_name }}</span>
      </div>
    </div>

    <div class="form-row">
      <div style="width: 30%;">APPROVED BY:</div>
      <div style="width: 65%; border-bottom: 1px solid #000;">
        <span data-field="approved_by_name">{{ approved_by_name }}</span>
      </div>
    </div>

    <div class="form-row" style="margin-top: 20px;">
      <div style="width: 30%;">RETURN CHECK TO:</div>
      <div style="width: 65%; border-bottom: 1px solid #000;">
        <span data-field="return_address">{{ return_address }}</span>
      </div>
    </div>

    <div style="text-align: center; margin-top: 30px;">
      <span style="font-size: 0.9em;">******** APPROVAL SIGNATURES ********</span>
    </div>

    <div class="signature-area">
      <div class="signature-line">
        <div class="signature-box">
          <div style="border-top: 1px solid #000; margin-bottom: 5px;"></div>
          <div style="font-size: 0.9em;">DEAN</div>
        </div>
        <div class="signature-box">
          <div style="border-top: 1px solid #000; margin-bottom: 5px;"></div>
          <div style="font-size: 0.9em;">DIRECTOR OF SPONSORED PROGRAMS</div>
        </div>
      </div>

      <div class="signature-line">
        <div class="signature-box">
          <div style="border-top: 1px solid #000; margin-bottom: 5px;"></div>
          <div style="font-size: 0.9em;">ASSOCIATE VICE PRESIDENT</div>
        </div>
        <div class="signature-box">
          <div style="border-top: 1px solid #000; margin-bottom: 5px;"></div>
          <div style="font-size: 0.9em;">DATE</div>
        </div>
      </div>

      <div class="signature-line">
        <div class="signature-box">
          <div style="border-top: 1px solid #000; margin-bottom: 5px;"></div>
          <div style="font-size: 0.9em;">VICE PRESIDENT/PROVOST</div>
        </div>
        <div class="signature-box">
          <div style="border-top: 1px solid #000; margin-bottom: 5px;"></div>
          <div style="font-size: 0.9em;">DATE</div>
        </div>
      </div>

      <div class="signature-line">
        <div class="signature-box">
          <div style="border-top: 1px solid #000; margin-bottom: 5px;"></div>
          <div style="font-size: 0.9em;">ASSOCIATE VICE PRESIDENT/CONTROLLER</div>
        </div>
        <div class="signature-box">
          <div style="border-top: 1px solid #000; margin-bottom: 5px;"></div>
          <div style="font-size: 0.9em;">PRESIDENT (IF APPLICABLE)</div>
        </div>
      </div>

      <div class="signature-line">
        <div class="signature-box">
          <div style="border-top: 1px solid #000; margin-bottom: 5px;"></div>
          <div style="font-size: 0.9em;">VICE PRESIDENT/BUSINESS AND FINANCE</div>
        </div>
        <div class="signature-box">
          <div style="border-top: 1px solid #000; margin-bottom: 5px;"></div>
          <div style="font-size: 0.9em;">DATE</div>
        </div>
      </div>
    </div>

    <div class="small-text" style="margin-top: 60px;">
      <p>PLEASE SUBMIT REQUEST TO THE PURCHASING DEPARTMENT FORTY(14) DAYS BEFORE CHECK IS NEEDED; ATTACH SUPPORTING DOCUMENTATION. AN EXPENSE REPORT MUST BE SUBMITTED TO THE CONTROLLER'S OFFICE WITHIN FIVE (5) DAYS FOR RECEIPT OF CASH ADVANCE.</p>
      <p>Revised February {{ revision_date }}</p>
      <p>Business and Finance - DO NOT RECREATE THIS FORM</p>
    </div>
  </div>
</body>