        <td class="text-right"><span data-field="pb_26_prior">{{ pb_26_prior }}</span></td>
      </tr>
      <tr>
        <td>27</td>
        <td>Construction in progress</td>
        <td class="text-right"><span data-field="pb_27_ending">{{ pb_27_ending }}</span></td>
        <td class="text-right"><span data-field="pb_27_prior">{{ pb_27_prior }}</span></td>
      </tr>
      <tr>
        <td>28</td>
        <td>Total for Plant, Property and Equipment (CV=A21+A22+A23+A26+A27)</td>
