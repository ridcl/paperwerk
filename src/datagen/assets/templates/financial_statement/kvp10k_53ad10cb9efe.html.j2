<div class="page">
  <h3 style="font-size: 14pt; margin-top: 0;">Part E - Scholarships and Fellowships</h3>
  <p>Fiscal Year: <span data-field="fiscal_year_e">{{ fiscal_year_e }}</span> - <span data-field="fiscal_year_e_end">{{ fiscal_year_e_end }}</span></p>
  <p>DO NOT REPORT FEDERAL DIRECT STUDENT LOANS (FDSL) ANYWHERE IN THIS SECTION</p>

  <table>
    <thead>
      <tr>
        <th style="width: 10%;">Line No.</th>
        <th style="width: 30%;">Source</th>
        <th class="text-right" style="width: 20%;">Current year amount</th>
        <th class="text-right" style="width: 20%;">Prior year amount</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>01</td>
        <td>Pell grants (federal)</td>
