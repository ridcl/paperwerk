      {% for item in core_revenues %}
      <tr>
        <td><span data-field="core_revenues[{{ loop.index0 }}].source">{{ item.source }}</span></td>
        <td style="text-align: right;"><span data-field="core_revenues[{{ loop.index0 }}].reported_value">{{ item.reported_value }}</span></td>
        <td style="text-align: right;"><span data-field="core_revenues[{{ loop.index0 }}].percent_of_total">{{ item.percent_of_total }}</span></td>
        <td style="text-align: right;"><span data-field="core_revenues[{{ loop.index0 }}].per_fte">{{ item.per_fte }}</span></td>
      </tr>
      {% endfor %}
      <tr>
        <td>Total core revenues</td>
        <td style="text-align: right;"><span data-field="total_core_revenues_reported_value">{{ total_core_revenues_reported_value }}</span></td>
        <td style="text-align: right;"><span data-field="total_core_revenues_percent_of_total">{{ total_core_revenues_percent_of_total }}</span></td>
        <td style="text-align: right;"><span data-field="total_core_revenues_per_fte">{{ total_core_revenues_per_fte }}</span></td>
      </tr>
    </tbody>
  </table>

  <p style="font-size: 10pt; margin-top: 20px;">Total revenues</p>
  <table class="data-table">
    <thead>
      <tr>
        <th style="width: 40%;"></th>
        <th style="width: 20%; text-align: right;"></th>
        <th style="width: 20%; text-align: right;"></th>
        <th style="width: 20%; text-align: right;"></th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Total revenues</td>
        <td style="text-align: right;"><span data-field="total_revenues_reported_value">{{ total_revenues_reported_value }}</span></td>
        <td></td>
        <td style="text-align: right;"><span data-field="total_revenues_per_fte">{{ total_revenues_per_fte }}</span></td>
      </tr>
    </tbody>
  </table>

  <p style="font-size: 10pt; margin-top: 20px;">Core revenues include tuition and fees; government appropriations (federal, state, and local); government grants and contracts; private gifts, grants, and contracts; investment income; other operating and nonoperating sources; and other revenues. Core revenues exclude revenues from auxiliary enterprises (e.g., bookstores, dormitories), hospitals, and independent operations.</p>
</div>

<div class="page">
  <h2 class="sub-header">Core Expenses</h2>
  <table class="data-table">
    <thead>
      <tr>
        <th style="width: 40%;">Expense function</th>
        <th style="width: 20%; text-align: right;">Reported values</th>
        <th style="width: 20%; text-align: right;">Percent of total core expenses</th>
        <th style="width: 20%; text-align: right;">Core expenses per FTE enrollment</th>
      </tr>
    </thead>
    <tbody>
      {% for item in core_expenses %}
      <tr>
        <td><span data-field="core_expenses[{{ loop.index0 }}].function">{{ item.function }}</span></td>
        <td style="text-align: right;"><span data-field="core_expenses[{{ loop.index0 }}].reported_value">{{ item.reported_value }}</span></td>
        <td style="text-align: right;"><span data-field="core_expenses[{{ loop.index0 }}].percent_of_total">{{ item.percent_of_total }}</span></td>
        <td style="text-align: right;"><span data-field="core_expenses[{{ loop.index0 }}].per_fte">{{ item.per_fte }}</span></td>
      </tr>
      {% endfor %}
      <tr>
        <td>Total core expenses</td>
        <td style="text-align: right;"><span data-field="total_core_expenses_reported_value">{{ total_core_expenses_reported_value }}</span></td>
        <td style="text-align: right;"><span data-field="total_core_expenses_percent_of_total">{{ total_core_expenses_percent_of_total }}</span></td>
        <td style="text-align: right;"><span data-field="total_core_expenses_per_fte">{{ total_core_expenses_per_fte }}</span></td>
      </tr>
    </tbody>
  </table>

  <p style="font-size: 10pt; margin-top: 20px;">Core expenses include expenses for instruction, research, public service, academic support, institutional support, student services, operation and maintenance of plant, depreciation, scholarships and fellowships expenses, other expenses, and nonoperating expenses.</p>

  <div style="margin-top: 50px;">
    <h3 style="font-size: 12pt; font-weight: bold;">Calculated value</h3>
    <table class="data-table">
      <tr>
        <td style="width: 30%;">FTE enrollment</td>
        <td style="text-align: right;"><span data-field="fte_enrollment_value">{{ fte_enrollment_value }}</span></td>
      </tr>
    </table>
    <p style="font-size: 10pt; margin-top: 20px;">The full-time equivalent (FTE) enrollment used in this report is the sum of the institution's FTE undergraduate enrollment and graduate enrollment. FTE is calculated as (credit hours taught / 3) for undergraduate students and (credit hours taught / 2) for graduate students.</p>
  </div>
</div></body>
</html>