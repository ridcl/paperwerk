      </table>
    </div>
  </div>

  <div class="grid-container" style="margin-top: 40px;">
    <div class="column">
      <h3 class="section-title">Unterputz-Medialverteiler</h3>
      <table>
        <thead>
          <tr>
            <th style="width: 10%;">Artikel</th>
