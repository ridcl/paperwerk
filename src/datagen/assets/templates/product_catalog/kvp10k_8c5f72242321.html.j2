        <thead>
          <tr>
            <th style="width: 10%;">Artikel</th>
            <th style="width: 15%;">Maße</th>
            <th style="width: 15%;">Typ</th>
            <th style="width: 25%;">Bestellnummer</th>
          </tr>
        </thead>
        <tbody>
