                    <td><span data-field="lamp_table.esb24_fluorescent_elec">{{ lamp_table.esb24_fluorescent_elec }}</span></td>
                    <td><span data-field="lamp_table.esb40_fluorescent_elec">{{ lamp_table.esb40_fluorescent_elec }}</span></td>
