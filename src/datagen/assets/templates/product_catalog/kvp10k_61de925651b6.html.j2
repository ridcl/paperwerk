    <div class="page">
        <div style="display: flex; justify-content: space-between; margin-bottom: 40px;">
            <div style="width: 50%;">
                <div class="image-container"><img src="placeholder_image_5.png" alt="Image 4" style="max-width: 100%; height: auto;"></div>
            </div>
            <div style="width: 50%;">
