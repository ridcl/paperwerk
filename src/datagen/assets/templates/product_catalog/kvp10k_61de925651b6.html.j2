                    <th style="width: 20%;">Lamp types</th>
                    <th style="width: 15%;">ESB20/EN20</th>
                    <th style="width: 15%;">ESB24/EN24</th>
                    <th style="width: 15%;">ESB40/EN40</th>
                    <th style="width: 15%;">ESB63</th>
                </tr>
