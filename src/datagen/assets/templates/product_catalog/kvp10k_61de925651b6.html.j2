                    <td><span data-field="ordering_accessories[{{ loop.index0 }}].pcs">{{ item.pcs }}</span></td>
                    <td><span data-field="ordering_accessories[{{ loop.index0 }}].weight">{{ item.weight }}</span></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>

        <p style="font-size: 12px; margin-top: 20px;">* Mounting onto ESB/EN 20 not possible.</p>
