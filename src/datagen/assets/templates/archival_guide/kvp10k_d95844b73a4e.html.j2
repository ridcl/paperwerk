<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    line-height: 1.5;
  }
  h1, h2, h3 {
    font-weight: bold;
  }
  .center {
    text-align: center;
  }
  .right {
    text-align: right;
  }
  .left {
    text-align: left;
  }
  .divider {
    border-top: 1px solid #000;
    margin: 10px 0;
  }
</style>
<body>
  <div class="page">
    <div class="center">
      <span style="font-size: 1.5em;">University of Pennsylvania</span>
      <div style="margin: 20px 0;">
        <!-- Placeholder for University Logo -->
        <img src="" alt="Logo" style="width: 100px; height: auto;">
      </div>
      <span style="font-size: 1.2em;">The University Archives</span>
      <span style="font-size: 1.2em;">and Records Center</span>
    </div>
    <div class="center" style="margin-top: 50px;">
      <span style="font-size: 1.5em;">A Guide to the</span>
      <span style="font-size: 1.5em;">Department of Romance Languages Records</span>
      <span style="font-size: 1.2em;">{{ date_range }}</span>
      <div style="margin-top: 20px;">
        <span style="font-size: 1.2em;">{{ cubic_footage }}</span>
      </div>
      <span style="font-size: 1.1em; margin-top: 10px;">UPB 1.9RL</span>
    </div>
  </div>

  <div class="page">
    <div class="left">
      <span data-field="center.name">{{ center.name }}</span>
