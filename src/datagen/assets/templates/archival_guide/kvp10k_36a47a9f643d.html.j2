<!DOCTYPE html>
<html>
<head>
<title>Document</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    line-height: 1.5;
    color: #000;
  }
  h1, h2, h3 {
    font-weight: bold;
  }
  .center {
    text-align: center;
  }
  .right {
    text-align: right;
  }
  .left {
    text-align: left;
  }
  .divider {
    border-top: 1px solid #000;
    margin: 10px 0;
  }
</style>

<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    margin: 0;
    padding: 0;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 10px;
  }
  td {
    padding: 4px 0;
    vertical-align: top;
  }
</style>
</head>
<body>

<div class="page">
  <div class="center">
    <span style="font-size: 1.5em;">University of Pennsylvania</span>
    <div style="margin: 20px 0;">
      <!-- Placeholder for University Seal Image -->
      <div style="width: 100px; height: 100px; background-color: #ccc; margin: 0 auto;"></div>
    </div>
    <span style="font-size: 1.2em;">The University Archives</span>
    <span style="font-size: 1.2em;">and Records Center</span>
  </div>
  <div class="center" style="margin-top: 50px;">
    <span style="font-size: 1.5em;">A Guide to the</span>
    <span style="font-size: 1.8em;">School of Allied Medical Professions Records</span>
    <span style="font-size: 1.5em;">1950-1981</span>
    <div style="margin-top: 20px;">
      <span data-field="cubic_feet">{{ cubic_feet }}</span>
    </div>
    <div style="margin-top: 10px;">
      <span data-field="upc">{{ upc }}</span>
    </div>
  </div>
</div>

<div class="page">
  <div class="left">
    <span data-field="center_name">{{ center_name }}</span>
    <div style="margin-top: 10px;">
      <span data-field="address_line_1">{{ address_line_1 }}</span>, <span data-field="address_line_2">{{ address_line_2 }}</span>
      <br>
      <span data-field="city">{{ city }}</span>, <span data-field="state">{{ state }}</span> <span data-field="zip_code">{{ zip_code }}</span>
    </div>
    <div style="margin-top: 10px;">
      Phone: <span data-field="phone">{{ phone }}</span><br>
      Fax: <span data-field="fax">{{ fax }}</span><br>
      Web: <span data-field="website">{{ website }}</span>
    </div>
    <div style="margin-top: 20px;">
      <span data-field="director_name">{{ director_name }}</span>, Director
    </div>
  </div>
</div>

<div class="page">
