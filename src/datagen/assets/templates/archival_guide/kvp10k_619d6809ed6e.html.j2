<!DOCTYPE html>
<html>
<head>
<title>Document</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  body {
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
    line-height: 1.5;
    color: #000;
  }
  h1, h2, h3 {
    font-weight: bold;
  }
  .center {
    text-align: center;
  }
  .right {
    text-align: right;
  }
  .left {
    text-align: left;
  }
  .divider {
    border-top: 1px solid #000;
    margin: 10px 0;
  }
</style>

<style>
    @page { size: A4; margin: 0; }
    .page {
        width: 794px; height: 1123px;
