    </div>

    <div class="content-list">
        <div class="list-item">
            <div>Preliminary Submission for University of <span data-field="organization_name">{{ organization_name }}</span> Office of Planning and Design. Project No. <span data-field="project_number">{{ project_number }}</span></div>
