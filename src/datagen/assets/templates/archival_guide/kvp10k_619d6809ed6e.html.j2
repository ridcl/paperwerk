  </div>
  <div class="center" style="margin-top: 50px;">
    <span style="font-size: 14pt;">INVENTORY</span>
  </div>
  <table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
    <thead>
      <tr style="border-bottom: 1px solid #000;">
        <th style="text-align: left; padding: 8px; width: 70%;"></th>
        <th style="text-align: center; padding: 8px; width: 15%;">Box</th>
        <th style="text-align: center; padding: 8px; width: 15%;">Folder</th>
      </tr>
    </thead>
    <tbody>
      {% for item in inventory_items %}
      <tr style="border-bottom: 1px dotted #ccc;">
        <td style="padding: 8px;"><span data-field="inventory_items[{{ loop.index0 }}].description">{{ item.description }}</span></td>
        <td style="text-align: center; padding: 8px;"><span data-field="inventory_items[{{ loop.index0 }}].box">{{ item.box }}</span></td>
        <td style="text-align: center; padding: 8px;"><span data-field="inventory_items[{{ loop.index0 }}].folder">{{ item.folder }}</span></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

