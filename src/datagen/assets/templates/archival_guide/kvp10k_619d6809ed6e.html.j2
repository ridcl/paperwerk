    /* Basic styling to mimic document structure */
    .header-info {
        display: flex;
        justify-content: space-between;
        margin-bottom: 30px;
        font-size: 12pt;
    }
    .content-list {
        line-height: 1.6;
    }
    .list-item {
        margin-bottom: 15px;
        display: flex;
        justify-content: space-between;
    }
    .page-footer {
        position: absolute;
        bottom: 50px;
        left: 60px;
        font-size: 10pt;
        color: #555;
    }
</style>
</head>
<body>

<div class="page">
  <div class="center">
    <span style="font-size: 18pt;">University of Pennsylvania</span>
    <div style="margin: 20px 0;">
      <!-- Placeholder for University Logo -->
      <img src="placeholder_logo.png" alt="University Logo" style="width: 100px; height: auto;">
    </div>
    <span style="font-size: 14pt;">The University Archives</span>
    <span style="font-size: 14pt;">and Records Center</span>
  </div>
  <div class="center" style="margin-top: 50px;">
    <span style="font-size: 16pt;">A Guide to the</span>
    <span style="font-size: 16pt;">Vice President for Coordinated</span>
    <span style="font-size: 16pt;">Planning Publication Records</span>
    <span style="font-size: 16pt;">{{ publication_years }}</span>
    <div style="margin-top: 20px;">
      <span style="font-size: 12pt;">{{ cubic_footage }}</span>
    </div>
    <div style="margin-top: 10px;">
      <span style="font-size: 12pt;">UPB {{ report_number }}</span>
    </div>
  </div>
</div>

<div class="page">
  <div class="left">
    <span style="font-size: 12pt;">The University Archives and Records Center</span>
    <div style="font-size: 12pt;">
      <span data-field="address_line_1">{{ address_line_1 }}</span><br>
      <span data-field="address_line_2">{{ address_line_2 }}</span><br>
      <span data-field="city_state_zip">{{ city_state_zip }}</span><br>
      <span data-field="phone">{{ phone }}</span><br>
      <span data-field="fax">{{ fax }}</span><br>
      <span data-field="website">{{ website }}</span><br>
      <span data-field="director_name">{{ director_name }}</span>, Director
    </div>
  </div>
</div>

<div class="page">
  <div class="center" style="margin-top: 100px;">
    <span style="font-size: 14pt;">Vice President for Coordinated Planning Publication Records</span>
    <div style="margin-top: 10px;">
      <span style="font-size: 12pt;">UPB {{ report_number }}</span>
    </div>
  </div>
  <div class="center" style="margin-top: 30px;">
    <span style="font-size: 16pt;">{{ guide_title }}</span>
    <div style="margin-top: 10px;">
      <span style="font-size: 12pt;">UPB {{ report_number }}</span>
    </div>
    <div style="margin-top: 20px;">
      <span style="font-size: 12pt;">{{ cubic_footage }}</span>
    </div>
  </div>
  <div class="center" style="margin-top: 50px;">
    <span style="font-size: 12pt;">Access is granted in accordance with the <a href="#" data-field="protocols_link">{{ protocols_link }}</a>.</span>
  </div>
  <div class="center" style="margin-top: 100px;">
    <span style="font-size: 14pt;">ARRANGEMENT</span>
    <div class="divider" style="width: 50%;"></div>
  </div>
  <div class="center" style="margin-top: 20px;">
    <span style="font-size: 12pt;">This collection has not been fully processed. The following preliminary inventory is available.</span>
  </div>
</div>

<div class="page">
  <div class="center" style="margin-top: 50px;">
    <span style="font-size: 14pt;">VICE PRESIDENT FOR COORDINATED PLANNING PUBLICATION RECORDS</span>
