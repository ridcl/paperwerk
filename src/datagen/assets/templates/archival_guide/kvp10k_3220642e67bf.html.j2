<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  h1, h2, h3, h4 {
    font-weight: bold;
  }
  .center {
    text-align: center;
  }
  .right {
    text-align: right;
  }
  .left {
    text-align: left;
  }
  .divider {
    border-top: 1px solid #000;
    margin: 10px 0;
  }
</style>

<div class="page">
  <div class="center">
    <span data-field="institution_name">{{ institution_name }}</span>
    <div style="margin: 20px 0;">
      <!-- Placeholder for logo image -->
    </div>
    <span data-field="department_name">{{ department_name }}</span>
  </div>
  <div class="center" style="margin-top: 50px;">
    <span data-field="document_title">{{ document_title }}</span>
    <div style="margin-top: 10px;">
      <span data-field="date_range">{{ date_range }}</span>
    </div>
    <div style="margin-top: 30px;">
      <span data-field="volume_size">{{ volume_size }}</span>
    </div>
    <div style="margin-top: 50px;">
      <span data-field="document_code">{{ document_code }}</span>
    </div>
  </div>
</div>

<div class="page">
  <div class="left">
    <span data-field="center_name">{{ center_name }}</span>
    <div style="margin-top: 10px;">
      <span data-field="address_line_1">{{ address_line_1 }}</span><br>
      <span data-field="city_state_zip">{{ city_state_zip }}</span><br>
      <span data-field="phone">{{ phone }}</span><br>
      <span data-field="fax">{{ fax }}</span><br>
      <span data-field="website">{{ website }}</span><br>
      <span data-field="director_name">{{ director_name }}</span>
    </div>
  </div>
</div>

<div class="page">
  <div class="center" style="margin-bottom: 40px;">
    <span data-field="document_title_toc">{{ document_title_toc }}</span>
    <div style="margin-top: 5px;">
      <span data-field="document_code_toc">{{ document_code_toc }}</span>
    </div>
  </div>
  <div class="center" style="margin-bottom: 30px;">
    <span data-field="document_title_guide">{{ document_title_guide }}</span>
    <div style="margin-top: 5px;">
      <span data-field="date_range_guide">{{ date_range_guide }}</span>
    </div>
    <div style="margin-top: 10px;">
      <span data-field="volume_size_guide">{{ volume_size_guide }}</span>
    </div>
    <div style="margin-top: 50px;">
      <span data-field="document_code_guide">{{ document_code_guide }}</span>
    </div>
  </div>
  <div class="center" style="margin-top: 50px;">
    <span data-field="access_statement">Access is granted in accordance with the <span data-field="protocols_link">{{ access_statement">Access is granted in accordance with the <span data-field= }}</span>.</span>
  </div>
  <div class="center" style="margin-top: 60px;">
    <span data-field="section_heading">{{ section_heading }}</span>
  </div>
  <div class="center" style="margin-top: 20px;">
    <span data-field="arrangement_summary">{{ arrangement_summary }}</span>
  </div>
</div>

<div class="page">
  <div class="center" style="margin-bottom: 40px;">
    <span data-field="document_title_inv">{{ document_title_inv }}</span>
    <div style="margin-top: 5px;">
      <span data-field="date_range_inv">{{ date_range_inv }}</span>
    </div>
    <div style="margin-top: 10px;">
      <span data-field="volume_size_inv">{{ volume_size_inv }}</span>
    </div>
    <div style="margin-top: 50px;">
      <span data-field="document_code_inv">{{ document_code_inv }}</span>
    </div>
  </div>
  <div class="center" style="margin-top: 50px;">
    <span data-field="section_heading_inv">{{ section_heading_inv }}</span>
  </div>
  <div class="center" style="margin-top: 30px;">
    <table style="width: 100%; border-collapse: collapse;">
      <thead>
        <tr>
          <th style="border: 1px solid #000; padding: 8px; text-align: left;">INVENTORY</th>
          <th style="border: 1px solid #000; padding: 8px; text-align: center;">Box</th>
          <th style="border: 1px solid #000; padding: 8px; text-align: center;">Folder</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td style="border: 1px solid #000; padding: 8px;"><span data-field="inventory_description">{{ inventory_description }}</span></td>
          <td style="border: 1px solid #000; padding: 8px; text-align: center;"><span data-field="inventory_box">{{ inventory_box }}</span></td>
          <td style="border: 1px solid #000; padding: 8px; text-align: center;"></td>
        </tr>
      </tbody>
    </table>
  </div>
</div>