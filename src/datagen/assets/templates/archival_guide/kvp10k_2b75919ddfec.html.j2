<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif;
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; }
  table { width: 100%; border-collapse: collapse; margin-top: 20px; }
  td, th { padding: 8px 0; text-align: left; }
  .center-text { text-align: center; }
</style>
<div>
  <div class="page">
    <div class="center-text">
      <span style="font-size: 24pt;">University of Pennsylvania</span>
      <img src="placeholder_logo.png" alt="University Logo" style="width: 100px; height: auto; margin: 20px 0;">
      <span style="font-size: 16pt;">The University Archives and Records Center</span>
    </div>
    <div class="center-text" style="margin-top: 50px;">
      <span style="font-size: 14pt;">A Guide to the</span>
      <span style="font-size: 18pt;">University of Pennsylvania Libraries. Botany-Zoology. John Bartram Memorial Library Minutes 1896-1926</span>
      <div style="margin-top: 20px;">
        <span style="font-size: 12pt;">1.0 Cubic feet</span>
        <div style="margin-top: 5px;">
          <span style="font-size: 12pt;">UPB 503</span>
        </div>
      </div>
    </div>
  </div>
  <div class="page">
    <div style="font-family: Arial, sans-serif;">
      <p>The University Archives and Records Center</p>
      <p><span data-field="address_line_1">{{ address_line_1 }}</span></p>
      <p><span data-field="city_state_zip">{{ city_state_zip }}</span></p>
      <p>Phone: <span data-field="phone_number">{{ phone_number }}</span></p>
      <p>Fax: <span data-field="fax_number">{{ fax_number }}</span></p>
      <p>Website: <span data-field="website_url">{{ website_url }}</span></p>
      <p>Mark Frazier Lloyd, Director</p>
    </div>
  </div>
  <div class="page">
    <div class="center-text">
      <span style="font-size: 16pt;">University of Pennsylvania Libraries. Botany-Zoology. John Bartram Memorial Library Minutes</span>
      <div style="margin-top: 10px;">
        <span style="font-size: 12pt;">UPB 503</span>
      </div>
    </div>
    <div class="center-text" style="margin-top: 40px;">
      <span style="font-size: 12pt;">Guide to the</span>
      <span style="font-size: 14pt;">University of Pennsylvania Libraries. Botany-Zoology. John Bartram Memorial Minutes 1896-1926</span>
      <div style="margin-top: 20px;">
        <span style="font-size: 12pt;">UPB 503</span>
        <div style="margin-top: 5px;">
          <span style="font-size: 12pt;">1.0 Cubic feet</span>
        </div>
      </div>
    </div>
    <div class="center-text" style="margin-top: 50px;">
      <span style="font-size: 10pt;">Access is granted in accordance with the <a href="#" style="text-decoration: underline;">Protocols for the University Archives and Records Center.</a></span>
    </div>
    <div class="center-text" style="margin-top: 80px;">
      <span style="font-size: 14pt;">ARRANGEMENT</span>
    </div>
    <div class="center-text" style="margin-top: 20px;">
      <span style="font-size: 12pt;">This collection has not been fully processed. The following preliminary inventory is available.</span>
    </div>
  </div>
  <div class="page">
    <div class="center-text" style="margin-top: 50px;">
      <span style="font-size: 14pt;">University of Pennsylvania Libraries. Botany-Zoology. John Bartram Memorial Library Minutes</span>
      <div style="margin-top: 10px;">
        <span style="font-size: 12pt;">UPB 503</span>
      </div>
    </div>
    <div class="center-text" style="margin-top: 40px;">
      <span style="font-size: 12pt;">Access is granted in accordance with the <a href="#" style="text-decoration: underline;">Protocols for the University Archives and Records Center.</a></span>
    </div>
    <div class="center-text" style="margin-top: 80px;">
      <span style="font-size: 14pt;">INVENTORY</span>
    </div>
    <table>
      <thead>
        <tr>
          <th style="width: 70%;"></th>
          <th style="width: 15%;">Box</th>
          <th style="width: 15%;">Folder</th>
        </tr>
      </thead>
      <tbody>
        {% for item in inventory_items %}
        <tr>
          <td><span data-field="inventory_items[{{ loop.index0 }}].description">{{ item.description }}</span></td>
          <td><span data-field="inventory_items[{{ loop.index0 }}].box">{{ item.box }}</span></td>
          <td><span data-field="inventory_items[{{ loop.index0 }}].folder">{{ item.folder }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>