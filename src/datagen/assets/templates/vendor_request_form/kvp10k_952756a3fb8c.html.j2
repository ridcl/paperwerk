<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
  }
  .page:last-child { page-break-after: auto; }
  /* Basic styling to mimic document structure */
  body { font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; }
  h1, h2, h3 { text-align: center; }
  .section-header { font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
  .form-row { display: flex; margin-bottom: 15px; align-items: flex-start; }
  .form-label { width: 150px; font-weight: normal; }
  .form-input-group { flex-grow: 1; }
  .input-field { border-bottom: 1px solid #000; min-width: 100%; }
  .two-column-table { width: 100%; border-collapse: collapse; margin-top: 20px; }
  .two-column-table td { padding: 5px 0; border-bottom: 1px solid #000; }
  .signature-line { border-bottom: 1px solid #000; margin-top: 50px; display: inline-block; width: 40%; }
</style>

<div class="page">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px;">
    <div>
      <p>DATE: <span data-field="date_issued">{{ date_issued }}</span></p>
    </div>
    <div style="text-align: right;">
      <h3 style="text-align: right;">PURCHASING USE ONLY</h3>
      <table class="two-column-table" style="width: 400px;">
        <tr>
          <td style="width: 50%;">Notes (Date/Comment):</td>
          <td style="width: 50%;"></td>
        </tr>
        <tr>
          <td>Notes (Date/Comment):</td>
          <td></td>
        </tr>
        <tr>
          <td>Purchasing Approval</td>
          <td></td>
        </tr>
      </table>
    </div>
  </div>

  <h2 style="text-align: center; margin-top: 40px;">UCA REQUEST FOR VENDOR ADDRESS/NAME CHANGE:</h2>

  <p>BEFORE ENTERING YOUR REQUISITION, provide information to CHANGE an existing address and email (<span data-field="purchasing_email">{{ purchasing_email }}</span>) this form to the Purchasing Department. You MUST provide the <span data-field="vendor_id">{{ vendor_id }}</span>. Purchasing will enter the change of address and note the assigned address number (which may be a change in the sequence number). If you have any questions or need assistance, please call 450-3173.</p>

  <div class="section-header">FOR PURCHASING USE ONLY</div>
  <div class="form-row" style="margin-top: 10px;">
    <div class="form-label">Date Entered</div>
    <div class="form-input-group"><div class="input-field" style="border-bottom: 1px solid #000;">{{ date_entered }}</div></div>
  </div>
  <div class="form-row">
    <div class="form-label">Initials</div>
    <div class="form-input-group"><div class="input-field" style="border-bottom: 1px solid #000;">{{ initials }}</div></div>
  </div>

  <div class="section-header" style="margin-top: 30px;">From:</div>
  <div class="form-row">
    <div class="form-label"></div>
    <div class="form-input-group" style="flex-basis: 30%;">
      <div class="input-field" style="border-bottom: 1px solid #000;">{{ department_name }}</div>
    </div>
    <div class="form-label"></div>
    <div class="form-input-group" style="flex-basis: 30%;">
      <div class="input-field" style="border-bottom: 1px solid #000;">{{ department_phone }}</div>
    </div>
    <div class="form-label"></div>
    <div class="form-input-group" style="flex-basis: 30%;">
      <div class="input-field" style="border-bottom: 1px solid #000;">{{ department_email }}</div>
    </div>
  </div>

  <div class="section-header">ACTION REQUESTED:</div>
  <div class="form-row" style="margin-top: 10px;">
    <div class="form-label" style="width: 150px;"></div>
    <div class="form-input-group" style="flex-basis: 20%;">
      <div class="input-field" style="border-bottom: 1px solid #000;">Additional Address</div>
    </div>
    <div class="form-input-group" style="flex-basis: 20%;">
      <div class="input-field" style="border-bottom: 1px solid #000;">Change Existing Address</div>
    </div>
    <div class="form-input-group" style="flex-basis: 40%;">
      <div class="input-field" style="border-bottom: 1px solid #000;">Vendor Name Change (requires W-9)</div>
    </div>
  </div>

  <div class="section-header" style="margin-top: 30px;">Vendor Information</div>
  <table class="two-column-table" style="width: 100%;">
    <tr>
      <td style="width: 50%; padding-bottom: 5px;">Name of Individual or Sole Proprietor</td>
      <td style="width: 50%; padding-bottom: 5px;"><div class="input-field" style="border-bottom: 1px solid #000; width: 100%;">{{ vendor_name }}</div></td>
    </tr>
    <tr>
      <td>Street Address</td>
      <td></td>
    </tr>
    <tr>
      <td>P.O. Box</td>
      <td></td>
    </tr>
    <tr>
      <td>City, State, Zip</td>
      <td></td>
    </tr>
    <tr>
      <td>Telephone Number</td>
      <td></td>
    </tr>
    <tr>
      <td>Fax Number</td>
      <td></td>
    </tr>
    <tr>
      <td>Email Address</td>
      <td></td>
    </tr>
  </table>

  <div class="form-row" style="margin-top: 40px;">
    <div class="form-label" style="width: 150px;">Requested By:</div>
    <div class="form-input-group" style="flex-grow: 1;"><div class="signature-line" data-field="requested_by">{{ requested_by }}</div></div>
    <div class="form-label" style="width: 150px; text-align: right;">Approved By:</div>
    <div class="form-input-group" style="flex-grow: 1; text-align: right;"><div class="signature-line" data-field="approved_by">{{ approved_by }}</div></div>
  </div>

  <div style="display: flex; justify-content: space-between; margin-top: 50px;">
    <div>
      <div class="signature-line" data-field="approved_by_2">{{ approved_by_2 }}</div>
      <div style="margin-top: 5px;">(Signature)</div>
    </div>
    <div>
      <div class="signature-line" data-field="approved_by_3">{{ approved_by_3 }}</div>
      <div style="margin-top: 5px;">(Signature of Immediate Supervisor)</div>
    </div>
  </div>
</div>