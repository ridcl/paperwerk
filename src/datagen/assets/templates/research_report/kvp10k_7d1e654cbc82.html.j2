<!DOCTYPE html>
<html>
<head>
    <title>Synthetic Document</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Times New Roman", serif; /* Defaulting to serif for formality */
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3, h4 { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; margin-bottom: 15px; }
        td, th { padding: 8px; text-align: left; border-bottom: 1px solid #ddd; }
        .header-box {
            border: 1px solid #000;
            padding: 10px 0;
            text-align: center;
            margin-bottom: 20px;
        }
        .footer {
            position: absolute;
            bottom: 50px;
            right: 60px;
            font-size: 10pt;
            text-align: right;
        }
        .header-info {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 30px;
        }
        .logo-area {
            display: flex;
            align-items: center;
        }
        .logo {
            width: 50px;
            height: 50px;
            margin-right: 15px;
        }
    </style>

<style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
