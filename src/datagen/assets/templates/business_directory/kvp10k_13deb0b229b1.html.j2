</style>
<style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3, h4, h5, h6 {
            font-weight: bold;
            margin-top: 0;
        }
        .header-section {
            display: flex;
            justify-content: space-between;
            margin-bottom: 30px;
        }
        .contact-info {
            text-align: left;
        }
        .address-block {
            margin-bottom: 15px;
        }
        .address-block p {
            margin: 2px 0;
            font-size: 12pt;
        }
        .phone-line {
            margin-top: 5px;
            font-size: 12pt;
        }
        .section-title {
            font-size: 14pt;
            font-weight: bold;
            margin-top: 20px;
            margin-bottom: 10px;
        }
        .list-item {
            margin-bottom: 10px;
            font-size: 12pt;
        }
        .two-column-layout {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
        }
        .column {
            width: 48%;
        }
        .footer-note {
            margin-top: 50px;
            font-size: 10pt;
            text-align: center;
        }
    </style>
</head>
<body>
<div class="page">
  <div class="header-title">TRAVELS FOR SHIRPUR</div>

  <div class="section-title">1. SRS Travels</div>
  <div class="contact-info">
    <div class="address-block">
      <p>Bangalore Branch</p>
      <p><span data-field="address.street">{{ address.street }}</span>, <span data-field="address.city">{{ address.city }}</span>, <span data-field="address.state">{{ address.state }}</span>, Pin: <span data-field="address.pin">{{ address.pin }}</span></p>
      <p>Phone: <span data-field="phone">{{ phone }}</span></p>
      <p>Email: <span data-field="email">{{ email }}</span></p>
      <p><span data-field="website">{{ website }}</span></p>
    </div>
  </div>

  <div class="section-title">All Our Branches</div>
  <div class="column-container">
    <div class="column">
      {% for branch in branches %}
      <div class="entry-block">
        <div class="entry-header">{{ branch.name }}</div>
        <div class="entry-details">
          <p><span data-field="branch_address.street">{{ branch.address.street }}</span>, <span data-field="branch_address.city">{{ branch.address.city }}</span>, <span data-field="branch_address.state">{{ branch.address.state }}</span>, Pin: <span data-field="branch_address.pin">{{ branch.address.pin }}</span></p>
          <p>Phone: <span data-field="branch_phone">{{ branch.phone }}</span></p>
          <p>Email: <span data-field="branch_email">{{ branch.email }}</span></p>
        </div>
      </div>
      {% endfor %}
    </div>
    <div class="column">
      {% for branch in branches %}
      <div class="entry-block">
        <div class="entry-header">{{ branch.name }}</div>
        <div class="entry-details">
          <p><span data-field="branch_address.street">{{ branch.address.street }}</span>, <span data-field="branch_address.city">{{ branch.address.city }}</span>, <span data-field="branch_address.state">{{ branch.address.state }}</span>, Pin: <span data-field="branch_address.pin">{{ branch.address.pin }}</span></p>
          <p>Phone: <span data-field="branch_phone">{{ branch.phone }}</span></p>
          <p>Email: <span data-field="branch_email">{{ branch.email }}</span></p>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>



