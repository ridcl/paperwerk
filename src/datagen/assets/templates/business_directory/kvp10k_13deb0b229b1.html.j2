<!DOCTYPE html>
<html>
<head>
<title>Travels for Shirpur</title>
<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { margin-top: 0; }
  .header-title { font-size: 24pt; text-align: center; margin-bottom: 30px; }
  .section-title { font-size: 14pt; font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
  .contact-info p { margin: 2px 0; font-size: 10pt; }
  .address-block { margin-bottom: 15px; font-size: 10pt; }
  .column-container { display: flex; justify-content: space-between; }
  .column { width: 48%; }
  .entry-block { margin-bottom: 15px; border-bottom: 1px solid #ccc; padding-bottom: 10px; }
  .entry-header { font-weight: bold; font-size: 10pt; margin-bottom: 5px; }
  .entry-details { font-size: 9pt; }
</style>

<style>
