<style>
  @page { size: A4; margin: 0; }
  .page {
    width: 794px; height: 1123px;
    padding: 50px 60px; box-sizing: border-box;
    overflow: hidden; page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child { page-break-after: auto; }
  h1, h2, h3 { margin-top: 0; }
  .header-logo { text-align: center; margin-bottom: 20px; }
  .divider { border-top: 1px solid #000; margin-top: 10px; margin-bottom: 10px; }
  .form-group { margin-bottom: 15px; }
  .inline-options label { margin-right: 15px; }
</style>

<div class="page">
  <div class="header-logo">
    <img src="placeholder_logo.png" alt="Lafayette College Logo" style="width: 100px; height: auto;">
    <h1 style="text-align: center; font-size: 24pt; margin-top: 10px;">LAFAYETTE COLLEGE</h1>
  </div>

  <h2 style="text-align: center; font-size: 18pt; margin-top: 40px;">CAMPUS SUSTAINABILITY PROJECT IDEA</h2>

  <div style="text-align: center; margin-top: 30px;">
    <img src="placeholder_icon.png" alt="Sustainability Icon" style="width: 80px; height: auto;">
    <p style="margin-top: 15px;">Do you have an idea for a project that would make our Campus more sustainable?</p>
    <p>Please fill out the form below and help us document your ideas so that we can share them with the rest of the Campus Community!</p>
  </div>

  <h3 style="margin-top: 40px;">Submitter Information:</h3>
  <div class="form-group">
    <label for="name">Name:</label><br>
    <div style="border-bottom: 1px solid #000; width: 100%; padding-bottom: 5px;"><span data-field="full_name">{{ full_name }}</span></div>
  </div>

  <div class="form-group">
    <label for="position">Position:</label><br>
    <div style="border-bottom: 1px solid #000; width: 100%; padding-bottom: 5px;">
      <label><input type="radio" name="position" value="Student"> Student</label>
      <label><input type="radio" name="position" value="Staff"> Staff</label>
      <label><input type="radio" name="position" value="Faculty"> Faculty</label>
    </div>
  </div>

  <div class="form-group">
    <label for="title">Title:</label><br>
    <div style="border-bottom: 1px solid #000; width: 100%; padding-bottom: 5px;"><span data-field="title">{{ title }}</span></div>
  </div>

  <div class="form-group">
    <label for="email">Email:</label>
    <div style="width: 50%; display: inline-block; margin-right: 2%;">
      <div style="border-bottom: 1px solid #000; width: 100%; padding-bottom: 5px;"><span data-field="email">{{ email }}</span></div>
    </div>
    <label for="phone">Phone Number:</label>
    <div style="width: 50%; display: inline-block;">
      <div style="border-bottom: 1px solid #000; width: 100%; padding-bottom: 5px;"><span data-field="phone_number">{{ phone_number }}</span></div>
    </div>
  </div>

  <h3 style="margin-top: 30px;">Time You Can Commit:</h3>
  <div class="inline-options" style="margin-bottom: 20px;">
    <label><input type="checkbox" name="time_commit" value="< 1 Hour"> &lt; 1 Hour</label>
    <label><input type="checkbox" name="time_commit" value="1-2 Hours"> 1-2 Hours</label>
    <label><input type="checkbox" name="time_commit" value="3-4 Hours"> 3-4 Hours</label>
    <label><input type="checkbox" name="time_commit" value="5+ Hours"> 5+ Hours</label>
  </div>

  <h3 style="margin-top: 30px;">Role on Project:</h3>
  <p>Select "Leader" if you are willing to play a key role and lead the team. Select "Contributor" if you are willing to participate but not available to lead the project. Select "Advisor" if you are not able to participate in the project but would be willing to answer questions.</p>
  <div class="inline-options" style="margin-bottom: 40px;">
    <label><input type="checkbox" name="role" value="Leader"> Leader</label>
    <label><input type="checkbox" name="role" value="Contributor"> Contributor</label>
    <label><input type="checkbox" name="role" value="Advisor"> Advisor</label>
  </div>

  <p style="text-align: center; font-size: 10pt;">Please continue the form on the next page ... <span style="font-size: 12pt;">&#8681;</span></p>
</div>

<div class="page">
  <h3 style="margin-top: 0;">Project Information:</h3>

  <div class="form-group">
    <label>Project Title: (Please keep it short – 10 words or less)</label><br>
    <div style="border-bottom: 1px solid #000; width: 100%; padding-bottom: 5px;"><span data-field="project_title">{{ project_title }}</span></div>
  </div>

  <div class="form-group">
    <label>Project Description: (Provide an overview of the project and its goals – 200 words or less)</label><br>
    <div style="border-bottom: 1px solid #000; width: 100%; padding-bottom: 5px;"><span data-field="project_description">{{ project_description }}</span></div>
  </div>

  <div class="form-group">
    <label>Summary of Existing Research or Resources: (Describe any progress that has been made or research that has been done at Lafayette College or in other communities)</label><br>
    <div style="border-bottom: 1px solid #000; width: 100%; padding-bottom: 5px;"><span data-field="research_summary">{{ research_summary }}</span></div>
  </div>

  <div class="form-group">
    <label>Web Links to Related Resources:</label><br>
    <div style="border-bottom: 1px solid #000; width: 100%; padding-bottom: 5px;"><span data-field="web_links">{{ web_links }}</span></div>
  </div>

  <div class="form-group">
    <label>Student Roles: (Describe the potential tasks and responsibilities that students would have)</label><br>
    <div style="border-bottom: 1px solid #000; width: 100%; padding-bottom: 5px;"><span data-field="student_roles">{{ student_roles }}</span></div>
  </div>

  <div class="form-group">
    <label>Funding Needs: (Address the potential costs of the project and include any potential sources)</label><br>
    <div style="border-bottom: 1px solid #000; width: 100%; padding-bottom: 5px;"><span data-field="funding_needs">{{ funding_needs }}</span></div>
  </div>

  <div class="form-group">
    <label>Anticipated Monetary Return on Investment:</label><br>
    <div style="border-bottom: 1px solid #000; width: 100%; padding-bottom: 5px;"><span data-field="monetary_return">{{ monetary_return }}</span></div>
  </div>

  <p style="margin-top: 40px; font-size: 10pt;">After you have completed this form, please save it on your hard drive and send as an attachment to: <span data-field="submission_email">{{ submission_email }}</span> or mail to Rosemary Huggan, Lafayette College, 9 North Campus Lane, Easton, PA 18042.</p>

  <div style="text-align: center; margin-top: 50px;">
    <img src="placeholder_icon.png" alt="Sustainability Icon" style="width: 80px; height: auto;">
    <h2 style="margin-top: 15px;">Thank you!</h2>
  </div>
</div>