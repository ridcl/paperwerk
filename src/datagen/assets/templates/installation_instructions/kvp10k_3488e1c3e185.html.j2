<!DOCTYPE html>
<html>
<head>
    <title>Synthetic Data Generation</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 { font-family: "DejaVu Sans", "Liberation Sans", Arial, sans-serif; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        td, th { padding: 8px; text-align: left; border: 1px solid #ccc; }
        .header-section { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
        .logo { font-size: 30px; font-weight: bold; }
        .section-title { font-size: 18px; font-weight: bold; margin-bottom: 15px; }
        .instruction-block { margin-bottom: 20px; }
        .two-column { display: flex; justify-content: space-between; gap: 40px; }
        .column { flex: 1; }
        .diagram-container { text-align: center; margin: 20px 0; }
    </style>
</head>
<body>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
        <div style="flex-grow: 1;">
            <h1 style="font-size: 24px; font-weight: bold;">SAFETY INSTRUCTIONS</h1>
            <h2 style="font-size: 20px; font-weight: bold;">AFS09...96(Z), CAL4, LDC4</h2>
            <h3 style="font-size: 16px; font-weight: normal;">Contactors AFS and accessories</h3>
        </div>
        <div class="logo">ABB</div>
    </div>

    <div class="two-column" style="margin-top: 50px;">
        <div class="column">
            <div class="instruction-block">
                <p><strong>ar</strong></p>
                <p><span data-field="safety_instruction_ar">{{ safety_instruction_ar }}</span></p>
            </div>
            <div class="instruction-block">
                <p><strong>en</strong></p>
                <p><span data-field="safety_instruction_en">{{ safety_instruction_en }}</span></p>
            </div>
            <div class="instruction-block">
                <p><strong>fr</strong></p>
                <p><span data-field="safety_instruction_fr">{{ safety_instruction_fr }}</span></p>
            </div>
            <div class="instruction-block">
                <p><strong>de</strong></p>
                <p><span data-field="safety_instruction_de">{{ safety_instruction_de }}</span></p>
            </div>
        </div>
        <div class="column">
            <div class="instruction-block">
                <p><strong>Attention:</strong></p>
                <p><span data-field="attention_note_1">{{ attention_note_1 }}</span></p>
            </div>
            <div class="instruction-block">
                <p><strong>¡Importante!</strong></p>
                <p><span data-field="attention_note_2">{{ attention_note_2 }}</span></p>
            </div>
            <div class="instruction-block">
                <p><strong>Warnung:</strong></p>
                <p><span data-field="attention_note_3">{{ attention_note_3 }}</span></p>
            </div>
            <div class="instruction-block">
                <p><strong>Advertencia:</strong></p>
                <p><span data-field="attention_note_4">{{ attention_note_4 }}</span></p>
            </div>
        </div>
    </div>
</div>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
        <div style="font-size: 14px;">
            <p>INSTALLATION INSTRUCTIONS</p>
            <h1 style="font-size: 24px; font-weight: bold;">AFS09...96(Z), CAL4, LDC4</h1>
            <h2 style="font-size: 18px; font-weight: normal;">Contactors AFS and accessories</h2>
        </div>
        <div style="font-size: 12px;">
            <p>Page 2/4</p>
        </div>
    </div>

    <div class="section-title">Product Overview</div>
    <div class="diagram-container">
        <!-- Placeholder for product diagrams -->
        <img src="placeholder_diagram_1.png" alt="Product Diagram 1" style="max-width: 300px; height: auto;">
        <img src="placeholder_diagram_2.png" alt="Product Diagram 2" style="max-width: 300px; height: auto;">
        <img src="placeholder_diagram_3.png" alt="Product Diagram 3" style="max-width: 300px; height: auto;">
        <img src="placeholder_diagram_4.png" alt="Product Diagram 4" style="max-width: 300px; height: auto;">
    </div>

    <div class="section-title" style="margin-top: 40px;">Technical Data</div>
    <table>
        <thead>
            <tr>
                <th>Model</th>
                <th>Voltage (V)</th>
                <th>Current (A)</th>
                <th>Dimensions (mm)</th>
            </tr>
        </thead>
        <tbody>
            {% for item in product_models %}
            <tr>
                <td><span data-field="product_models[{{ loop.index0 }}].model_name">{{ item.model_name }}</span></td>
                <td><span data-field="product_models[{{ loop.index0 }}].voltage">{{ item.voltage }}</span></td>
                <td><span data-field="product_models[{{ loop.index0 }}].current">{{ item.current }}</span></td>
                <td><span data-field="product_models[{{ loop.index0 }}].dimensions">{{ item.dimensions }}</span></td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <div class="section-title" style="margin-top: 40px;">Wiring Diagrams</div>
    <div class="diagram-container">
        <!-- Placeholder for wiring diagrams -->
        <img src="placeholder_wiring_diagram_1.png" alt="Wiring Diagram 1" style="max-width: 45%; height: auto;">
        <img src="placeholder_wiring_diagram_2.png" alt="Wiring Diagram 2" style="max-width: 45%; height: auto;">
    </div>
</div>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
        <div style="font-size: 14px;">
            <p>INSTALLATION INSTRUCTIONS</p>
            <h1 style="font-size: 24px; font-weight: bold;">AFS09...96(Z), CAL4, LDC4</h1>
            <h2 style="font-size: 18px; font-weight: normal;">Contactors AFS and accessories</h2>
        </div>
        <div style="font-size: 12px;">
            <p>Page 3/4</p>
        </div>
    </div>

    <div class="section-title">Assembly Instructions</div>
    <div class="diagram-container">
        <!-- Placeholder for assembly diagrams -->
        <img src="placeholder_assembly_diagram_1.png" alt="Assembly Diagram 1" style="max-width: 45%; height: auto;">
        <img src="placeholder_assembly_diagram_2.png" alt="Assembly Diagram 2" style="max-width: 45%; height: auto;">
    </div>

    <div class="section-title" style="margin-top: 40px;">Disassembly Instructions</div>
    <div class="diagram-container">
        <!-- Placeholder for disassembly diagrams -->
        <img src="placeholder_disassembly_diagram_1.png" alt="Disassembly Diagram 1" style="max-width: 45%; height: auto;">
        <img src="placeholder_disassembly_diagram_2.png" alt="Disassembly Diagram 2" style="max-width: 45%; height: auto;">
    </div>

    <div style="margin-top: 60px; display: flex; justify-content: space-between; font-size: 12px;">
        <div style="text-align: left;">
            <p>ABB France</p>
            <p>11, rue d'Arsonval</p>
            <p>69680 Chassieu</p>
            <p>France</p>
            <p>www.abb.com/lowvoltage</p>
        </div>
        <div style="text-align: right;">
            <p>Revision A</p>
            <p>Revision date: <span data-field="revision_date">{{ revision_date }}</span></p>
            <p>Document number: <span data-field="document_number">{{ document_number }}</span></p>
            <p>Copyright 2021 ABB. All rights reserved. Specifications subject to change without notice.</p>
        </div>
    </div>
</div>

<div class="page">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
        <div style="font-size: 14px;">
            <p>ABB</p>
            <h1 style="font-size: 24px; font-weight: bold;">AFS09...96(Z), CAL4, LDC4</h1>
            <h2 style="font-size: 18px; font-weight: normal;">Contactors AFS and accessories</h2>
        </div>
        <div style="font-size: 12px;">
            <p>Page 4/4</p>
        </div>
    </div>

    <div style="margin-top: 50px; text-align: center;">
        <p>End of Document</p>
    </div>
</div>

</body>
</html>