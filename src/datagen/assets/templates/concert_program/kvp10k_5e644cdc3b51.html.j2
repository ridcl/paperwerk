<!DOCTYPE html>
<html>
<head>
    <title>Concert Program</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, sans-serif;
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3 { font-weight: bold; }
        .title-large { font-size: 72pt; line-height: 0.9; }
        .subtitle { font-size: 24pt; margin-top: 10px; }
        .header-text { font-size: 12pt; text-align: center; margin-bottom: 30px; }
        .section-title { font-size: 18pt; margin-top: 30px; margin-bottom: 15px; }
        .program-list { display: flex; justify-content: space-between; margin-top: 20px; }
        .program-column { flex: 1; padding: 0 15px; }
        .program-item { margin-bottom: 15px; }
        .program-item span { display: block; }
        .composer-info { font-size: 10pt; color: #555; }
        .footer { position: absolute; bottom: 50px; width: 100%; text-align: center; font-size: 10pt; }
        .divider { border-top: 1px solid #000; margin: 40px 0; }
    </style>
</head>
<body>

<div class="page">
    <div class="header-text">Department of Music Presents</div>
    <div style="text-align: center; margin: 50px 0;">
        <div class="title-large" style="font-family: 'Brush Script MT', cursive; color: #a52a2a;">A Season of Renewal</div>
    </div>
    <div style="text-align: center;">
        <div class="subtitle">College-Community Chorale Concert Choir</div>
        <div class="subtitle">Studley Theatre</div>
        <div style="margin-top: 20px;">Tuesday, <span data-field="performance_date">{{ performance_date }}</span><br>7:30 p.m.</div>
    </div>
    <div style="position: absolute; bottom: 0; left: 0; width: 100%; height: 100%; pointer-events: none;">
        <!-- Placeholder for visual element -->
    </div>
    <div style="position: absolute; bottom: 20px; left: 0; width: 100%; text-align: center; font-size: 12pt; letter-spacing: 20px;">
        P R O G R A M
    </div>
</div>

<div class="page">
    <div class="header-text" style="text-align: left;">The Department of Music at the State University of New York at New Paltz proudly presents</div>
    <div style="text-align: center; margin-top: 30px;">
        <div class="section-title">College-Community Chorale & Concert Choir</div>
        <div style="font-size: 12pt;">
            <span data-field="chorale_director">{{ chorale_director }}</span>, director<br>
            <span data-field="pianist_name">{{ pianist_name }}</span>, collaborative pianist
        </div>
    </div>

    <div class="section-title">College-Community Chorale</div>
    <div class="program-list">
        <div class="program-column">
            <div class="program-item">
                <span data-field="chorale_piece_1_title">{{ chorale_piece_1_title }}</span>
                <div class="composer-info">W. A. Mozart (1756-1791)</div>
            </div>
            <div class="program-item">
                <span data-field="chorale_piece_2_title">{{ chorale_piece_2_title }}</span>
                <div class="composer-info">Mozart</div>
            </div>
            <div class="program-item">
                <span data-field="chorale_piece_3_title">{{ chorale_piece_3_title }}</span>
                <div class="composer-info">Ralph Vaughan Williams (1872-1958), arr. Arthur Somerville</div>
            </div>
            <div class="program-item">
                <span data-field="chorale_piece_4_title">{{ chorale_piece_4_title }}</span>
                <div class="composer-info">Healey Willan (1880-1968)</div>
            </div>
            <div class="program-item">
                <span data-field="chorale_piece_5_title">{{ chorale_piece_5_title }}</span>
                <div class="composer-info">Spiritual, arr. Alice Parker and Robert Shaw</div>
            </div>
        </div>
        <div class="program-column">
            <!-- Empty column for layout mirroring -->
        </div>
    </div>

    <div class="footer">
        Fall <span data-field="season_year">{{ season_year }}</span>
    </div>
</div>

