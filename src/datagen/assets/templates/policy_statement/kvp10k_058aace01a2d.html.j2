<!DOCTYPE html>
<html>
<head>
    <title>Document Conversion</title>
    <style>
        @page { size: A4; margin: 0; }
        .page {
            width: 794px; height: 1123px;
            padding: 50px 60px; box-sizing: border-box;
            overflow: hidden; page-break-after: always;
            position: relative;
            font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
        }
        .page:last-child { page-break-after: auto; }
        h1, h2, h3, h4, h5, h6 {
            font-weight: bold;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
            margin-bottom: 15px;
        }
        td, th {
            padding: 8px;
            text-align: left;
            border: 1px solid #ccc;
        }
        .header-section {
            text-align: center;
            margin-bottom: 30px;
        }
        .footer {
            position: absolute;
            bottom: 20px;
            width: 100%;
            text-align: right;
            font-size: 0.8em;
        }
    </style>
</head>
<body>
    <div class="page">
        <div class="header-section">
            <h1>LSUE</h1>
            <h2>POLICY STATEMENT 31</h2>
            <h3>PROPERTY CONTROL</h3>
        </div>

        <p><strong>POLICY DIGEST</strong></p>
        <p>Initially Issued: <span data-field="issue_date_initial">{{ issue_date_initial }}</span></p>
        <p>Last Revised: <span data-field="issue_date_revised">{{ issue_date_revised }}</span></p>

        <p><strong>I. AUTHORITY</strong></p>
        <p><span data-field="authority_text">{{ authority_text }}</span></p>

        <p><strong>II. DEFINITION</strong></p>
        <p><span data-field="definition_text">{{ definition_text }}</span></p>

        <p><strong>III. PROPERTY CUSTODIANS</strong></p>
        <p><span data-field="custodian_text">{{ custodian_text }}</span></p>

        <p><strong>IV. USE OF UNIVERSITY PROPERTY AND/OR EQUIPMENT</strong></p>
        <p><span data-field="use_text">{{ use_text }}</span></p>

        <p><strong>V. IDENTIFICATION AND TAGGING</strong></p>
        <p><span data-field="tagging_text">{{ tagging_text }}</span></p>

        <p><strong>VI. UTILIZATION OF EQUIPMENT</strong></p>
        <p><span data-field="utilization_text">{{ utilization_text }}</span></p>

        <p><strong>VII. DISPOSITION OF EQUIPMENT</strong></p>
        <p><span data-field="disposition_text">{{ disposition_text }}</span></p>

        <p><strong>VIII. ANNUAL PHYSICAL INVENTORY OF EQUIPMENT</strong></p>
        <p><span data-field="inventory_text">{{ inventory_text }}</span></p>

        <p><strong>IX. CHANGES/UPDATES IN UNIVERSITY EQUIPMENT RECORDS (ERI)</strong></p>
        <p><span data-field="eri_text">{{ eri_text }}</span></p>

        <p><strong>X. SOURCE</strong></p>
        <p><span data-field="source_reference">{{ source_reference }}</span></p>

        <div class="footer">
            <span data-field="page_number">{{ page_number }}</span>
        </div>
    </div>

    <div class="page">
        <div class="header-section">
            <h1>LSU</h1>
            <h2>Finance & Administrative Services</h2>
            <h3>Property Management</h3>
        </div>

        <p><strong>REQUEST FOR OFF-CAMPUS/HOME STORAGE OF EQUIPMENT (PER BOP 4-2)</strong></p>
        <p>PLEASE PRINT OR TYPE INFORMATION-All Information Is Required</p>

        <p>Department: <span data-field="department_name">{{ department_name }}</span> Account Number: <span data-field="account_number">{{ account_number }}</span></p>
        <p>Date: <span data-field="request_date">{{ request_date }}</span> Purpose: <span data-field="purpose">{{ purpose }}</span></p>

        <table>
            <thead>
                <tr>
                    <th>Item Description</th>
                    <th>LSUE Inventory # & Serial #</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>1.</td>
                    <td></td>
                </tr>
                <tr>
                    <td>2.</td>
                    <td></td>
                </tr>
                <tr>
                    <td>3.</td>
                    <td></td>
                </tr>
            </tbody>
        </table>

        <p>Name of Person with Custody: <span data-field="custodian_name">{{ custodian_name }}</span></p>
        <p>Signature of Person with Custody: _________________________</p>
        <p>Position (Faculty, Staff or Student): <span data-field="custodian_position">{{ custodian_position }}</span></p>
        <p>Residential Address: <span data-field="residential_address">{{ residential_address }}</span></p>

        <p>City: <span data-field="city">{{ city }}</span> State or Country: <span data-field="state_country">{{ state_country }}</span> Zip Code: <span data-field="zip_code">{{ zip_code }}</span> Electronic</p>
        <p>Mail Address: <span data-field="mail_address">{{ mail_address }}</span> Home or Removal</p>
        <p>Cell Telephone Number: (<span data-field="cell_area_code">{{ cell_area_code }}</span>) <span data-field="cell_number">{{ cell_number }}</span> Date: (MONTH/DATE/YEAR) Return Date: (MONTH/DATE/YEAR)</p>

        <p>Approval Signatures:</p>
        <p>Dept. Property Custodian _________________________ Date: _________________________</p>
        <p>Department Head /Chair _________________________ Date: _________________________</p>
        <p>LSUE Property Manager(or designee) _________________________ Date: _________________________</p>
        <p>VC for Business Affairs</p>

        <p>Comments: ____________________________________________________________________________________</p>

        <p>3555 River Rd.-River Road Annex • Baton Rouge, LA 70803 • P 225-578-6921 • Email: <span data-field="contact_email">{{ contact_email }}</span></p>
        <p><span data-field="website_url">{{ website_url }}</span></p>

        <div class="footer">
            <span data-field="page_number">{{ page_number }}</span>
        </div>
    </div>

    <div class="page">
        <div class="header-section">
            <h1>LSU</h1>
            <h2>Property Management</h2>
            <h3>Asset Request Form</h3>
        </div>

        <p>3555 River Road, Baton Rouge, LA 70803 Phone: 225.578.6921</p>
        <p>Email: <span data-field="property_management_email">{{ property_management_email }}</span></p>

        <p>REQUEST TYPE (REQUIRED): ONLY ONE (1) PER FORM</p>

        <table>
            <thead>
                <tr>
                    <th>SURPLUS (Pick Up\*)</th>
                    <th>SURPLUS (Will Deliver)</th>
                    <th>SCRAP</th>
                    <th>DISMANTLE</th>
                    <th>OTHER</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><input type="checkbox"></td>
                    <td><input type="checkbox"></td>
                    <td><input type="checkbox"></td>
                    <td><input type="checkbox"></td>
                    <td><input type="checkbox"></td>
                </tr>
            </tbody>
        </table>

        <p>MARK ALL THAT APPLY:</p>
        <p>TAGGED <input type="checkbox"> NON-TAG (List by qty) DATA SANITIZATION FORM REQ (Y/N)</p>

        <table>
            <thead>
                <tr>
                    <th>BUILDING & ROOM #</th>
                    <th>SCHEDULED PICKUP DATE:</th>
                    <th>FOR PROPERTY MANAGEMENT USE:</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>CONTACT NAME:</td>
                    <td>APPROVALS IN WORKDAY COMPLETE?</td>
                </tr>
                <tr>
                    <td>PHONE #:</td>
                    <td></td>
                </tr>
                <tr>
                    <td>EMAIL:</td>
                    <td></td>
                </tr>
            </tbody>
        </table>

        <p>TRANSACTIONS INVOLVING TAGGED (INVENTORIED) ASSETS MUST BE APPROVED IN WORKDAY BY COST CENTER MANAGER</p>
        <p><span data-field="transaction_note">{{ transaction_note }}</span></p>

        <table>
            <thead>
                <tr>
                    <th>QTY</th>
                    <th>INVENTORY NUMBER (LSU TAG#)</th>
                    <th>SERIAL NUMBER</th>
                    <th>EQUIPMENT DESCRIPTION</th>
                    <th>DATA SANITIZATION FORM REQ (Y/N)</th>
                </tr>
            </thead>
            <tbody>
                {% for item in line_items %}
                <tr>
                    <td><span data-field="line_items[{{ loop.index0 }}].qty">{{ item.qty }}</span></td>
                    <td><span data-field="line_items[{{ loop.index0 }}].inventory_number">{{ item.inventory_number }}</span></td>
                    <td><span data-field="line_items[{{ loop.index0 }}].serial_number">{{ item.serial_number }}</span></td>
                    <td><span data-field="line_items[{{ loop.index0 }}].description">{{ item.description }}</span></td>
                    <td><span data-field="line_items[{{ loop.index0 }}].data_sanitization_req">{{ item.data_sanitization_req }}</span></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>

        <p>ASSET CUST/COST CENTER MGR SIGNATURE/DATE</p>
        <p>PROPERTY MANAGEMENT RECEIPT SIGNATURE/DATE</p>

        <div class="footer">
            <span data-field="page_number">{{ page_number }}</span>
        </div>
    </div>