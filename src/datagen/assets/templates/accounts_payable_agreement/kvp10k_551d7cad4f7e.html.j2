<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 20px;
  }
  td, th {
    padding: 8px;
    text-align: left;
  }
</style>

<div class="page">
  <div style="text-align: center; margin-bottom: 30px;">
    <img src="placeholder_logo.png" alt="Logo" style="max-width: 150px; height: auto;">
    <h1 style="font-size: 24pt; margin: 5px 0;">LINDSEY</h1>
    <h2 style="font-size: 20pt; margin: 0;">WILSON</h2>
    <h3 style="font-size: 16pt; margin: 0;">COLLEGE</h3>
  </div>

  <h2 style="font-size: 14pt; margin-bottom: 20px;">Accounts Payable Authorization Agreement For Direct Deposit</h2>

  <table style="margin-bottom: 30px;">
    <tr>
      <td style="width: 20%;">
        <input type="checkbox"> New Enrollment
      </td>
      <td style="width: 20%;">
        <input type="checkbox"> Account Change
      </td>
    </tr>
    <tr>
      <td style="width: 20%;">
        <input type="checkbox"> Savings Account
      </td>
      <td style="width: 20%;">
        <input type="checkbox"> Checking Account
      </td>
    </tr>
  </table>

  <div style="border: 1px solid #ccc; padding: 20px; margin-bottom: 30px;">
    <p>Staple a voided check from your account here.</p>
    <p>Important Note: We cannot take action without a voided check attached. If you wish to have your reimbursement/payment deposited into a savings account, please provide confirmation from your financial institution of the correct routing/transit number and savings account number.</p>
  </div>

  <table style="width: 100%;">
    <thead>
      <tr>
        <th style="width: 33%;">Name of Financial Institution</th>
        <th style="width: 33%;">Bank Routing Transit Number</th>
        <th style="width: 33%;">Account Number</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span data-field="financial_institution_name">{{ financial_institution_name }}</span></td>
        <td><span data-field="routing_transit_number">{{ routing_transit_number }}</span></td>
        <td><span data-field="account_number">{{ account_number }}</span></td>
      </tr>
    </tbody>
  </table>

  <h3 style="margin-top: 40px; margin-bottom: 15px;">Authorization:</h3>
  <p>I hereby authorize <span data-field="institution_name">{{ institution_name }}</span> and the financial institution listed above to initiate electronic credit entries and, if necessary, debit entries and adjustments for any credit entries in error to my above listed account.</p>

  <table style="width: 100%; margin-top: 50px;">
    <tr>
      <td style="width: 33%; padding-bottom: 50px;">Printed Name</td>
      <td style="width: 33%; padding-bottom: 50px;">Signature</td>
      <td style="width: 33%; padding-bottom: 50px;">Date</td>
    </tr>
  </table>

  <div style="margin-top: 80px; font-size: 10pt;">
    <p>Tax ID/SSN/LWC ID: <span data-field="tax_id">{{ tax_id }}</span></p>
    <p>
      <span data-field="address_line_1">{{ address_line_1 }}</span><br>
      <span data-field="city_state_zip">{{ city_state_zip }}</span>
    </p>
    <p>Office: <span data-field="office_phone">{{ office_phone }}</span> | Fax: <span data-field="fax_number">{{ fax_number }}</span></p>
    <p>www.<span data-field="website">{{ website }}</span></p>
    <p style="margin-top: 20px;">E-mail (for direct deposit notification): <span data-field="email">{{ email }}</span></p>
  </div>
</div>