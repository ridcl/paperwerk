<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  h1 {
    font-size: 24pt;
    font-weight: bold;
    margin-bottom: 20px;
  }
  h2 {
    font-size: 14pt;
    font-weight: bold;
    margin-top: 30px;
    margin-bottom: 15px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
  }
  th, td {
    border: 1px solid #ccc;
    padding: 10px;
    text-align: left;
  }
  th {
    background-color: #f2f2f2;
    font-weight: bold;
  }
  ul {
    list-style-type: disc;
    margin-left: 20px;
    padding-left: 0;
  }
  li {
    margin-bottom: 5px;
  }
</style>

<div class="page">
  <h1>Multimedia Podium with Cabinet, Side Drawer, Keyboard Tray & Wheels – Cherry</h1>

  <!-- Image Placeholder (Visual element, no data field needed) -->
  <div style="text-align: center; margin: 30px 0;">
    <!-- Placeholder for the product image -->
    <img src="placeholder_image.jpg" alt="Product Image" style="max-width: 100%; height: auto;">
  </div>

  <div style="margin-top: 40px;">
    <p>Vendor: <span data-field="vendor_url">{{ vendor_url }}</span></p>
    <p>Catalog Number: <span data-field="catalog_number">{{ catalog_number }}</span></p>
    <p>Price: <span data-field="price">{{ price }}</span></p>

    <h3>Features</h3>
    <ul>
      <li>Locking cabinet and keyboard drawer</li>
      <li><span data-field="feature_list[{{ 0 }}]">{{ feature_list[0] }}</span></li>
      <li>Brushed nickel handles</li>
      <li>Cable ports throughout</li>
    </ul>
  </div>
</div>

<div class="page">
  <h2>Specifications</h2>

  <table>
    <thead>
      <tr>
        <th></th>
        <th>SKU</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>GTIN</td>
        <td><span data-field="gtin">{{ gtin }}</span></td>
        <td></td>
      </tr>
      <tr>
        <td>Overall Width x Height x Depth</td>
        <td><span data-field="overall_width_height_depth">{{ overall_width_height_depth }}</span></td>
        <td></td>
      </tr>
      <tr>
        <td>Cabinet Width x Height x Depth</td>
        <td><span data-field="cabinet_width_height_depth">{{ cabinet_width_height_depth }}</span></td>
        <td></td>
      </tr>
      <tr>
        <td>Weight</td>
        <td><span data-field="weight">{{ weight }}</span></td>
        <td></td>
      </tr>
      <tr>
        <td>Material</td>
        <td><span data-field="material">{{ material }}</span></td>
        <td></td>
      </tr>
      <tr>
        <td>Color</td>
        <td><span data-field="color">{{ color }}</span></td>
        <td></td>
      </tr>
      <tr>
        <td>Placement Style</td>
        <td><span data-field="placement_style">{{ placement_style }}</span></td>
        <td></td>
      </tr>
      <tr>
        <td>Features</td>
        <td><span data-field="features">{{ features }}</span></td>
        <td></td>
      </tr>
      <tr>
        <td>Top Surface Width x Depth</td>
        <td><span data-field="top_surface_width_depth">{{ top_surface_width_depth }}</span></td>
        <td></td>
      </tr>
      <tr>
        <td>Drawer Width x Height x Depth</td>
        <td><span data-field="drawer_width_height_depth">{{ drawer_width_height_depth }}</span></td>
        <td></td>
      </tr>
      <tr>
        <td>Pull Out Shelf Width x Depth</td>
        <td><span data-field="pull_out_shelf_width_depth">{{ pull_out_shelf_width_depth }}</span></td>
        <td></td>
      </tr>
    </tbody>
  </table>
</div>