<style>
  @page {
    size: A4;
    margin: 0;
  }
  .page {
    width: 794px;
    height: 1123px;
    padding: 50px 60px;
    box-sizing: border-box;
    overflow: hidden;
    page-break-after: always;
    position: relative;
    font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
  }
  .page:last-child {
    page-break-after: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
  }
  td {
    padding: 8px;
    text-align: left;
  }
  .header-row td {
    font-weight: bold;
  }
</style>

<div class="page">
  <div style="text-align: center; margin-bottom: 40px;">
    <h1 style="font-size: 24pt; margin: 0;">SARDAR PATEL UNIVERSITY</h1>
    <p style="font-size: 10pt; margin: 5px 0;">UNIVERSITY ROAD, P. B. NO. 10</p>
    <p style="font-size: 10pt; margin: 5px 0;">VALLABH VIDYANAGAR - 388 (GUJARAT) INDIA</p>
    <p style="font-size: 10pt; margin: 5px 0;">NAAC Re-Accreditation: Grade 'A', CCPA-3.25</p>
  </div>

  <div style="display: flex; justify-content: space-between; margin-bottom: 30px;">
    <div style="width: 60%;">
      <h2 style="font-size: 14pt; margin-bottom: 10px;">SEATING ARRANGEMENT FOR THE UNIVERSITY EXAM NOVEMBER - 2022</h2>
      <p style="font-size: 10pt; margin: 0;">PROGRAMME: <span data-field="programme">{{ programme }}</span> - 3rd & 5th SEMESTER</p>
      <p style="font-size: 10pt; margin: 5px 0;">EXAMINATION COMMENCEMENT DATE: <span data-field="exam_date">{{ exam_date }}</span></p>
    </div>
    <div style="width: 35%; text-align: right; font-size: 10pt;">
      <p>Phone: <span data-field="phone">{{ phone }}</span></p>
      <p>Fax No: <span data-field="fax">{{ fax }}</span></p>
      <p>E-mail: <span data-field="email">{{ email }}</span></p>
      <p>Website: <span data-field="website">{{ website }}</span></p>
    </div>
  </div>

  <table>
    <thead>
      <tr class="header-row">
        <td style="width: 10%;">Sr. No</td>
        <td style="width: 25%;">Student (City)</td>
        <td style="width: 30%;">Exam Centre & Co-ordinator</td>
        <td style="width: 15%;">B.Sc.(CA & IT) - 3 Sem</td>
        <td style="width: 15%;">B.Sc.(CA & IT) - 5 Sem</td>
      </tr>
    </thead>
    <tbody>
      {% for item in seating_arrangement %}
      <tr>
        <td>{{ loop.index }}</td>
        <td><span data-field="seating_arrangement[{{ loop.index0 }}].student_name">{{ item.student_name }}</span>, <span data-field="seating_arrangement[{{ loop.index0 }}].city">{{ item.city }}</span></td>
        <td><span data-field="seating_arrangement[{{ loop.index0 }}].exam_centre">{{ item.exam_centre }}</span></td>
        <td>{{ item.bsc_3sem_approx }}</td>
        <td>{{ item.bsc_5sem_approx }}</td>
      </tr>
      {% endfor %}
      <tr>
        <td colspan="2" style="text-align: right; font-weight: bold;">Total</td>
        <td colspan="2" style="text-align: right; font-weight: bold;">{{ total_bsc_3sem }}</td>
        <td style="text-align: right; font-weight: bold;">{{ total_bsc_5sem }}</td>
      </tr>
    </tbody>
  </table>

  <div style="margin-top: 60px; font-size: 10pt;">
    <p style="text-align: justify;">(નોંધ : ઉપરોક્ત પરીક્ષા બેઠક અને તે કોલેજના આયોજક શ્રી-ઓડિટર રહેશે તથા દરેક કોલેજ પરીક્ષા બેઠક અંગેની સમિતિ પણ દ્રશ-3 માં પરીક્ષા વિભાગને મોકલી આપવાનું રહેશે. અચળ આપને રવિકાર છે તેમ માહને આગાહીની કાર્યવાહી કરવામાં આવશે જે આપની જાણ સાઆ.)</p>
  </div>

  <div style="display: flex; justify-content: space-between; margin-top: 80px;">
    <div style="text-align: left;">
      <p>No.: <span data-field="document_number">{{ document_number }}</span></p>
      <p>Date: <span data-field="document_date">{{ document_date }}</span></p>
      <p>Vallabh Vidyanagar</p>
    </div>
    <div style="text-align: right;">
      <div style="text-align: center;">
        <img src="placeholder_signature.png" alt="Signature" style="width: 150px; height: auto; margin-bottom: 5px;">
        <p style="margin: 0;">Deputy Registrar</p>
        <p style="margin: 0;">(Examination Section)</p>
      </div>
    </div>
  </div>
</div>