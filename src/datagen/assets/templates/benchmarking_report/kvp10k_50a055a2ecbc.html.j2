      </div>
      <div style="text-align: center;">
        <div style="width: 40px; height: 176px; background-color: #34568B; margin: 0 auto; position: relative;">
          <span style="position: absolute; top: -20px; left: 50%; transform: translateX(-50%); font-size: 10pt; font-weight: bold;">{{ bar_2029 }}%</span>
