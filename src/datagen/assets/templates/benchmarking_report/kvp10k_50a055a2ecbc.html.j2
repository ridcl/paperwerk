          </tr>
          <tr>
            <td style="text-align: center;">{{ ibex_midwest_2016 }}</td>
            <td style="text-align: center;">{{ ibex_northeast_2016 }}</td>
            <td style="text-align: center;">{{ ibex_south_2016 }}</td>
            <td style="text-align: center;">{{ ibex_west_2016 }}</td>
            <td style="text-align: center;">{{ ibex_overall_2016 }}</td>
          </tr>
          <tr>
