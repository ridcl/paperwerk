<style>
    @page { size: A4; margin: 0; }
    .page {
        width: 794px; height: 1123px;
        padding: 50px 60px; box-sizing: border-box;
        overflow: hidden; page-break-after: always;
        position: relative;
        font-family: "DejaVu Serif", "Liberation Serif", Georgia, "Helvetica", Arial, "DejaVu Sans", "Liberation Sans";
    }
    .page:last-child { page-break-after: auto; }
    table { width: 100%; border-collapse: collapse; margin-top: 15px; }
    th, td { padding: 8px; text-align: left; }
    .header-title { font-size: 24pt; font-weight: bold; text-align: center; margin-bottom: 10px; }
    .sub-header { font-size: 14pt; font-weight: bold; margin-top: 30px; margin-bottom: 15px; }
    .section-title { font-size: 16pt; font-weight: bold; margin-top: 20px; margin-bottom: 10px; }
    .text-block { font-size: 10pt; line-height: 1.5; margin-bottom: 15px; }
    .two-column { display: flex; justify-content: space-between; }
    .two-column > div { width: 48%; }
    .footer { position: absolute; bottom: 50px; width: 100%; font-size: 8pt; color: #555; }
</style>
